---
const title = 'WAYS LABEL MANAGER';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <style is:global>
    :root{color-scheme:dark;--bg:#08090a;--panel:#101215;--panel2:#0c0e10;--line:#2e3339;--text:#f2f3ee;--muted:#8b929b;--accent:#efff3d;--ok:#78f29d;--warn:#ffd36a;--bad:#ff7e87;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,textarea{font:inherit}button{cursor:pointer}.hide{display:none!important}.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #25292f;background:#090a0ce8;backdrop-filter:blur(10px)}.brand{font-weight:950;letter-spacing:.04em;margin-right:auto}.brand b{color:var(--accent)}.btn{border:1px solid #373d45;background:#15181c;color:#fff;border-radius:9px;padding:9px 11px;font-weight:850;font-size:11px;text-decoration:none}.btn.primary{background:var(--accent);border-color:var(--accent);color:#111}.shell{display:grid;grid-template-columns:320px 1fr;min-height:calc(100vh - 55px)}.side{border-right:1px solid #25292f;padding:18px;background:#0b0d0f}.ey{font-size:9px;font-weight:950;letter-spacing:.15em;color:var(--accent)}.side h1{font-size:30px;line-height:1;margin:8px 0 10px}.side p{font-size:11px;line-height:1.65;color:var(--muted);margin:0 0 16px}.search{width:100%;padding:10px 11px;border:1px solid var(--line);border-radius:9px;background:#090a0c;color:#fff;outline:none;margin-bottom:10px}.search:focus{border-color:var(--accent)}.list{display:grid;gap:7px;max-height:calc(100vh - 220px);overflow:auto;padding-right:3px}.labelrow{width:100%;text-align:left;border:1px solid var(--line);border-radius:10px;background:#121418;color:#ddd;padding:11px}.labelrow.on{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent);background:#181b0f}.labelrow b{display:block;font-size:12px}.labelrow small{display:block;color:#777e87;font-size:9px;margin-top:5px}.labelrow.on b{color:var(--accent)}.edit{padding:32px}.card{max-width:820px;margin:auto;border:1px solid var(--line);border-radius:17px;background:var(--panel);padding:22px}.cardhead{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:18px}.cardhead h2{font-size:24px;margin:5px 0 0}.count{border:1px solid #424951;border-radius:999px;padding:6px 9px;color:#a7adb6;font-size:9px;font-weight:900;white-space:nowrap}.fields{display:grid;gap:15px}.field{display:grid;gap:7px}.field label{font-size:10px;font-weight:900;letter-spacing:.06em}.field input,.field textarea{width:100%;border:1px solid #343a42;border-radius:10px;background:#090a0c;color:#fff;padding:11px 12px;outline:none}.field textarea{min-height:150px;resize:vertical;line-height:1.65}.field input:focus,.field textarea:focus{border-color:var(--accent)}.hint{font-size:9px;line-height:1.55;color:#777e87}.keybox{padding:10px 11px;border:1px solid #292d33;border-radius:9px;background:#0b0c0f;color:#747b84;font:9px/1.5 ui-monospace,monospace;word-break:break-all}.actions{display:flex;align-items:center;gap:10px;margin-top:19px;padding-top:16px;border-top:1px solid var(--line)}.status{font-size:10px;color:var(--muted);margin-left:auto}.status.ok{color:var(--ok)}.status.warn{color:var(--warn)}.status.bad{color:var(--bad)}.empty{max-width:820px;margin:auto;color:var(--muted);border:1px dashed #30353c;border-radius:16px;padding:28px;line-height:1.7}.login{position:fixed;inset:0;z-index:50;display:grid;place-items:center;background:#08090af2;padding:20px}.loginbox{width:min(430px,100%);border:1px solid var(--line);border-radius:17px;background:#111318;padding:23px}.loginbox h2{margin:7px 0 10px;font-size:27px}.loginbox p{color:var(--muted);font-size:11px;line-height:1.65}.loginbox input{width:100%;padding:11px;border:1px solid #3a4048;border-radius:9px;background:#090a0c;color:#fff;margin:8px 0 10px}.previewnote{display:none;padding:10px 12px;border:1px solid #665c2a;border-radius:10px;background:#171408;color:#d9c47a;font-size:10px;line-height:1.55;margin-bottom:15px}.previewnote.on{display:block}@media(max-width:760px){.shell{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid #25292f}.list{max-height:260px}.edit{padding:18px 14px}.card{padding:17px}.top{flex-wrap:wrap}.actions{align-items:stretch;flex-direction:column}.status{margin:0}}
  </style>
</head>
<body>
  <header class="top"><div class="brand">WAYS <b>LABEL</b> MANAGER</div><a class="btn" href="/playback-editor/">← WAYS EDITOR</a><a class="btn" href="/" target="_blank" rel="noreferrer">WAYS ↗</a></header>
  <main class="shell">
    <aside class="side"><div class="ey">CURATION / LABELS</div><h1>LABELを整える。</h1><p>作品への割り当てはWAYS Editor、ここではLABELそのものの名称と説明を編集します。</p><input id="search" class="search" placeholder="LABELを検索"><div id="list" class="list"></div></aside>
    <section class="edit"><div id="previewNote" class="previewnote">Previewでは保存操作を試せますが、本番のLABEL情報は書き換えません。</div><div id="empty" class="empty">左からLABELを選択してください。</div><section id="card" class="card hide"><div class="cardhead"><div><div class="ey">WAYS / LABEL</div><h2 id="heading">LABEL</h2></div><span id="count" class="count">0 GAMES</span></div><div class="fields"><div class="field"><label>名称</label><input id="name" maxlength="40"><div class="hint">読者側に表示される名前です。作品との内部紐付けキーは変更しません。</div></div><div class="field"><label>詳細</label><textarea id="description" maxlength="800" placeholder="どんな作品を集めたLABELなのか、読者向けに短く説明します。"></textarea><div class="hint">WAYSのLABEL一覧にも表示できます。</div></div><div class="field"><label>内部キー</label><div id="keyBox" class="keybox"></div></div></div><div class="actions"><button id="save" class="btn primary" type="button">LABELを保存</button><span id="status" class="status"></span></div></section></section>
  </main>
  <div id="login" class="login hide"><form id="loginForm" class="loginbox"><div class="ey">HARF-WAY / PRIVATE CMS</div><h2>LABEL MANAGER</h2><p>WAYS Editorと同じ管理キーで開けます。</p><input id="loginKey" type="password" placeholder="管理キー"><button class="btn primary" style="width:100%" type="submit">開く</button><p id="loginMsg"></p></form></div>
<script is:inline>
(()=>{
  const STORAGE='hw-playback-editor-admin-key';
  let adminKey=sessionStorage.getItem(STORAGE)||'';
  let labels=[];
  let selectedKey='';
  const $=q=>document.querySelector(q);
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[c]));
  function setStatus(text,kind=''){const el=$('#status');el.textContent=text;el.className='status'+(kind?' '+kind:'')}
  async function auth(key){const r=await fetch('/api/playback-editor-proxy?target=auth',{method:'POST',cache:'no-store',headers:{'x-showcase-admin-key':key}});if(!r.ok)throw Error('管理キーが無効です')}
  function showLogin(msg=''){const box=$('#login');box.classList.remove('hide');$('#loginMsg').textContent=msg}
  function current(){return labels.find(x=>x.key===selectedKey)||null}
  function renderList(){const q=$('#search').value.trim().toLowerCase();const rows=labels.filter(x=>!q||x.name.toLowerCase().includes(q)||x.key.toLowerCase().includes(q));$('#list').innerHTML=rows.length?rows.map(x=>`<button class="labelrow ${x.key===selectedKey?'on':''}" data-key="${encodeURIComponent(x.key)}"><b>${esc(x.name)}</b><small>${Number(x.count||0)} GAMES${x.description?' · 詳細あり':''}</small></button>`).join(''):'<p style="color:#777;font-size:10px">該当するLABELがありません。</p>';$('#list').querySelectorAll('[data-key]').forEach(btn=>btn.onclick=()=>{selectedKey=decodeURIComponent(btn.dataset.key||'');render()})}
  function renderEditor(){const item=current();if(!item){$('#card').classList.add('hide');$('#empty').classList.remove('hide');return}$('#empty').classList.add('hide');$('#card').classList.remove('hide');$('#heading').textContent=item.name;$('#count').textContent=`${Number(item.count||0)} GAMES`;$('#name').value=item.name;$('#description').value=item.description||'';$('#keyBox').textContent=item.key;setStatus(item.managed?'Coreに詳細保存済み':'名称は作品データ由来 / 詳細未設定')}
  function render(){renderList();renderEditor()}
  async function load(){setStatus('読込中…');const r=await fetch('/api/ways-labels',{cache:'no-store'});const j=await r.json().catch(()=>({}));if(!r.ok||!j.ok)throw Error(j.error||`HTTP ${r.status}`);labels=Array.isArray(j.labels)?j.labels.map(x=>({key:String(x.key||x.name||''),name:String(x.name||x.key||''),description:String(x.description||''),count:Number(x.count||0),managed:Boolean(x.managed)})).filter(x=>x.key&&x.name):[];if(!selectedKey||!labels.some(x=>x.key===selectedKey))selectedKey=labels[0]?.key||'';render()}
  async function save(){const item=current();if(!item)return;const name=$('#name').value.trim().replace(/\s+/g,' ').slice(0,40);const description=$('#description').value.trim().slice(0,800);if(!name){setStatus('名称を入力してください','bad');return}const btn=$('#save');btn.disabled=true;setStatus('保存中…');try{const r=await fetch('/api/ways-label-admin',{method:'POST',headers:{'content-type':'application/json','x-showcase-admin-key':adminKey},body:JSON.stringify({key:item.key,name,description})});const j=await r.json().catch(()=>({}));if(r.status===401){sessionStorage.removeItem(STORAGE);adminKey='';showLogin('管理キーを再入力してください。');throw Error('認証が切れました')}if(!r.ok)throw Error(j.error==='label_name_exists'?'同じ名称のLABELがすでにあります':(j.error||`HTTP ${r.status}`));item.name=name;item.description=description;item.managed=!j.preview;render();if(j.preview){$('#previewNote').classList.add('on');setStatus('Preview保存シミュレーション完了','warn')}else setStatus('保存しました','ok')}catch(e){setStatus(e.message||'保存に失敗しました','bad')}finally{btn.disabled=false}}
  $('#search').addEventListener('input',renderList);$('#save').addEventListener('click',save);$('#loginForm').addEventListener('submit',async e=>{e.preventDefault();const key=$('#loginKey').value.trim();if(!key)return;try{await auth(key);adminKey=key;sessionStorage.setItem(STORAGE,key);$('#login').classList.add('hide');await load()}catch(err){showLogin(err.message)}});
  (async()=>{if(!adminKey){showLogin();return}try{await auth(adminKey);await load()}catch(e){sessionStorage.removeItem(STORAGE);adminKey='';showLogin(e.message)}})();
})();
</script>
</body>
</html>
