---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="HARF-WAYで紹介したゲームのうち、現在Steamでセール中の作品を編集部目線でまとめています。" />
  <title>HARF-WAY SALE PICKS</title>
  <style>
    :root{--ink:#11120f;--paper:#f0eee5;--paper2:#e5e1d5;--line:#c8c4b7;--muted:#6b6a63;--acid:#eaff36;--black:#0b0c0a;--white:#f8f7f1;--green:#205b3d;--pink:#a62f61;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink)}a{color:inherit}.shell{max-width:1420px;margin:auto;padding:0 24px 80px}
    .mast{position:sticky;top:0;z-index:30;margin:0 -24px;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:rgba(240,238,229,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.brand{font-size:12px;font-weight:950;letter-spacing:.12em}.mast nav{display:flex;gap:7px;flex-wrap:wrap}.mast a{font-size:10px;font-weight:850;text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:7px 10px;background:#f7f5ed}.mast a:hover{border-color:var(--ink)}
    .hero{display:grid;grid-template-columns:1.35fr .65fr;gap:42px;padding:74px 0 56px;border-bottom:1px solid var(--ink)}.ey{font-size:10px;letter-spacing:.18em;font-weight:950}.hero h1{font-size:clamp(54px,9.8vw,138px);line-height:.78;letter-spacing:-.07em;margin:18px 0 28px}.hero h1 span{display:block;color:transparent;-webkit-text-stroke:2px var(--ink)}.lead{font-size:clamp(18px,2vw,28px);line-height:1.5;font-weight:800;max-width:850px}.heroSide{align-self:end;border-left:1px solid var(--ink);padding-left:24px}.heroSide p{margin:0;font-size:12px;line-height:1.85;color:#4e4e49}.meta{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:20px}.metaItem{border-top:1px solid var(--ink);padding-top:8px}.metaItem small{display:block;font-size:8px;letter-spacing:.08em;color:var(--muted)}.metaItem b{display:block;font-size:26px;margin-top:3px}
    .section{padding:54px 0;border-bottom:1px solid var(--ink)}.sectionHead{display:flex;align-items:flex-end;justify-content:space-between;gap:22px;margin-bottom:20px}.kicker{font-size:9px;letter-spacing:.14em;font-weight:950}.sectionHead h2{font-size:clamp(28px,4.2vw,58px);line-height:.95;letter-spacing:-.045em;margin:7px 0 0}.sectionHead p{margin:0;max-width:520px;font-size:11px;line-height:1.75;color:var(--muted)}
    .featureGrid{display:grid;grid-template-columns:1.55fr .75fr .75fr;gap:12px}.feature{background:var(--black);color:var(--white);min-width:0;overflow:hidden}.featureMedia{aspect-ratio:16/10;background:#1b1b18;overflow:hidden}.feature:first-child .featureMedia{aspect-ratio:16/9}.featureMedia img{width:100%;height:100%;display:block;object-fit:cover}.featureBody{padding:17px}.feature:first-child .featureBody{padding:23px}.sourceTags{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:13px}.sourceTag{display:inline-flex;align-items:center;border:1px solid #ffffff2f;border-radius:999px;padding:5px 7px;font-size:8px;font-weight:900}.sourceTag.article{color:#ff9bc5}.sourceTag.playlist{color:#8ddbd6}.sourceTag.ways{color:var(--acid)}.sourceTag.yorimichi{color:#ffc87d}.reason{font-size:11px;line-height:1.75;color:#c8c9c2;margin:13px 0 16px;padding-left:11px;border-left:2px solid var(--acid)}
    .infoGrid{display:grid;border-top:1px solid var(--line)}.infoRow{display:grid;grid-template-columns:112px minmax(0,1fr);gap:12px;align-items:start;padding:10px 0;border-bottom:1px solid var(--line)}.infoLabel{font-size:9px;line-height:1.45;color:var(--muted);font-weight:900;letter-spacing:.04em}.infoValue{min-width:0;font-size:12px;line-height:1.55;font-weight:750;overflow-wrap:anywhere}.infoValue.game{font-size:18px;font-weight:950;line-height:1.25}.infoValue.sale{font-size:22px;font-weight:950;color:var(--green)}.infoValue.price strong{font-size:21px;margin-right:8px}.infoValue.price del{font-size:10px;color:var(--muted)}.infoLinks{display:flex;gap:7px;flex-wrap:wrap}.infoLinks a{display:inline-flex;align-items:center;min-height:31px;padding:6px 9px;border:1px solid var(--line);background:transparent;text-decoration:none;font-size:9px;font-weight:900}.infoLinks a.store{background:var(--ink);border-color:var(--ink);color:var(--white)}
    .feature .infoGrid{border-color:#363934}.feature .infoRow{border-color:#363934}.feature .infoLabel{color:#8d9189}.feature .infoValue.sale{color:var(--acid)}.feature .infoLinks a{border-color:#464941}.feature .infoLinks a.store{background:var(--acid);border-color:var(--acid);color:var(--black)}.feature .infoValue.price del{color:#858880}
    .shelf{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.deal{min-width:0;background:#f8f6ef;border:1px solid var(--line);display:flex;flex-direction:column}.dealImg{aspect-ratio:16/9;overflow:hidden;background:#d7d2c5}.dealImg img{width:100%;height:100%;object-fit:cover;display:block}.dealBody{padding:13px}.deal .infoRow{grid-template-columns:88px minmax(0,1fr);padding:8px 0}.deal .infoValue.game{font-size:16px}.deal .infoValue.sale{font-size:18px}.deal .infoValue.price strong{font-size:18px}.deal .infoLinks a{padding:5px 7px;font-size:8px}
    .allSection{padding-top:54px}.toolbar{display:grid;grid-template-columns:minmax(240px,1fr) repeat(3,minmax(140px,190px));gap:8px;padding:12px;background:var(--black);margin-bottom:16px}.toolbar input,.toolbar select{min-height:44px;border:1px solid #373933;background:#171815;color:#fff;border-radius:0;padding:9px 10px;font:inherit;font-size:11px}.progress{display:flex;align-items:center;gap:10px;margin-bottom:16px;font-size:9px;color:var(--muted)}.bar{height:3px;flex:1;background:#d9d5ca;overflow:hidden}.bar i{display:block;width:0;height:100%;background:var(--ink);transition:width .2s}
    .catalogGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.catalogCard{background:#f8f6ef;border:1px solid var(--line);overflow:hidden}.catalogImg{aspect-ratio:16/9;background:#d8d4c8;overflow:hidden}.catalogImg img{width:100%;height:100%;object-fit:cover;display:block}.catalogBody{padding:13px}.catalogCard .infoRow{grid-template-columns:96px minmax(0,1fr);padding:8px 0}.catalogCard .infoValue.game{font-size:17px}.catalogCard .infoValue.sale{font-size:19px}.empty{grid-column:1/-1;padding:62px 18px;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);text-align:center;color:var(--muted);line-height:1.8}.foot{margin-top:34px;font-size:9px;line-height:1.8;color:var(--muted)}
    @media(max-width:1050px){.featureGrid{grid-template-columns:1fr 1fr}.feature:first-child{grid-column:1/-1}.shelf,.catalogGrid{grid-template-columns:repeat(2,1fr)}.hero{grid-template-columns:1fr}.heroSide{border-left:0;border-top:1px solid var(--ink);padding:20px 0 0}.toolbar{grid-template-columns:1fr 1fr}}
    @media(max-width:680px){.shell{padding:0 13px 50px}.mast{margin:0 -13px;padding:10px 13px}.mast nav a:nth-child(-n+3){display:none}.hero{padding:44px 0 36px}.hero h1{font-size:70px}.lead{font-size:17px}.section{padding:40px 0}.sectionHead{display:block}.sectionHead p{margin-top:12px}.featureGrid,.shelf,.catalogGrid{grid-template-columns:1fr}.feature:first-child{grid-column:auto}.toolbar{grid-template-columns:1fr}.meta{grid-template-columns:repeat(4,1fr)}.metaItem b{font-size:18px}.infoRow,.deal .infoRow,.catalogCard .infoRow{grid-template-columns:92px minmax(0,1fr)}}
  </style>
</head>
<body>
<div class="shell">
  <header class="mast"><div class="brand">HARF-WAY / SALE PICKS</div><nav><a href="#today">今日の3本</a><a href="#under500">500円以下</a><a href="#half">半額以上</a><a href="#all">全部見る</a></nav></header>

  <section class="hero">
    <div><div class="ey">HARF-WAY / DATABASE SALE DIG</div><h1>SALE<span>PICKS</span></h1><div class="lead">安くなったから、もう一度出会う。HARF-WAYで紹介したゲームの中から、いま手を伸ばしやすい作品だけを拾います。</div></div>
    <div class="heroSide"><p>Steamのセール一覧そのものではなく、WAYS・プレイリスト・記事・ヨリミチで一度紹介した作品を入口にした「再発見」のページです。価格は日本向けSteam情報を自動確認しています。</p><div class="meta"><div class="metaItem"><small>DB GAMES</small><b id="statTotal">—</b></div><div class="metaItem"><small>ON SALE</small><b id="statSale">—</b></div><div class="metaItem"><small>UNDER ¥500</small><b id="statCheap">—</b></div><div class="metaItem"><small>50%+ OFF</small><b id="statHalf">—</b></div></div></div>
  </section>

  <section class="section" id="today"><div class="sectionHead"><div><div class="kicker">EDITOR'S FRONT</div><h2>今日の3本</h2></div><p>割引率だけではなく、HARF-WAY内で複数の場所から紹介されている作品や、価格の手頃さも含めて上に出しています。</p></div><div id="featured" class="featureGrid"><div class="empty">セール作品を探しています…</div></div></section>

  <section class="section" id="under500"><div class="sectionHead"><div><div class="kicker">SMALL PRICE, GOOD DETOUR</div><h2>500円以下で寄り道</h2></div><p>ワンコイン前後なら、知らない作品にも手を伸ばしやすい。価格の低い順にピックアップします。</p></div><div id="cheapShelf" class="shelf"><div class="empty">読み込み中…</div></div></section>

  <section class="section" id="half"><div class="sectionHead"><div><div class="kicker">BIG DROP</div><h2>半額以上の大きな値下げ</h2></div><p>50%以上OFFになっているものだけ。前に気になっていた作品を思い出す棚です。</p></div><div id="halfShelf" class="shelf"><div class="empty">読み込み中…</div></div></section>

  <section class="allSection" id="all"><div class="sectionHead"><div><div class="kicker">FULL INDEX</div><h2>全部のセールを見る</h2></div><p>ここから先は検索・紹介元・価格条件・並び順で絞り込めます。</p></div>
    <div class="toolbar"><input id="search" placeholder="作品名 / タグで検索"/><select id="source"><option value="all">紹介元：すべて</option><option value="article">記事</option><option value="playlist">プレイリスト</option><option value="ways">WAYS</option><option value="yorimichi">ヨリミチ</option></select><select id="filter"><option value="all">セール中すべて</option><option value="under500">500円以下</option><option value="half">50%以上OFF</option></select><select id="sort"><option value="discount">割引率が高い順</option><option value="price">価格が安い順</option><option value="title">作品名順</option></select></div>
    <div class="progress"><span id="progressText">準備中…</span><div class="bar"><i id="progressBar"></i></div></div>
    <div id="list" class="catalogGrid"><div class="empty">データベースを確認しています…</div></div>
  </section>
  <div class="foot">価格・割引率はSteamストアの日本向け情報をもとに表示しています。取得に失敗した作品があっても取得できたものから表示します。購入前にSteamストアで最終価格をご確認ください。</div>
</div>
<script>
const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let catalog=[],games=[],totalPrice=0,donePrice=0,priceErrors=0,loading=true,catalogSummary={};
const sourceLabel={article:'記事',playlist:'PLAYLIST',ways:'WAYS',yorimichi:'ヨリミチ'};
function chunks(a,n){const out=[];for(let i=0;i<a.length;i+=n)out.push(a.slice(i,i+n));return out}
async function pool(items,limit,fn){let next=0;async function worker(){while(next<items.length){const i=next++;await fn(items[i],i)}}await Promise.all(Array.from({length:Math.min(limit,items.length)},worker))}
function mergeCandidate(map,row){if(!row.appid)return;const id=String(row.appid),prev=map.get(id);if(!prev){map.set(id,{...row,appid:id,sources:[...new Set(row.sources||[])],tags:[...new Set(row.tags||[])],playlists:[...new Set(row.playlists||[])]});return}prev.sources=[...new Set([...(prev.sources||[]),...(row.sources||[])])];prev.tags=[...new Set([...(prev.tags||[]),...(row.tags||[])])];prev.playlists=[...new Set([...(prev.playlists||[]),...(row.playlists||[])])];if(!prev.articleUrl&&row.articleUrl)prev.articleUrl=row.articleUrl;if(!prev.thumbnail&&row.thumbnail)prev.thumbnail=row.thumbnail;if(!prev.category&&row.category)prev.category=row.category}
async function resolveArticles(rows){const unresolved=rows.filter(r=>!r.appid&&r.articleUrl&&(r.sources||[]).includes('article'));const groups=chunks(unresolved,4);await pool(groups,2,async group=>{const q=new URLSearchParams();group.forEach(r=>q.append('u',r.articleUrl));try{const res=await fetch('/api/article-steam-public?'+q.toString()),j=await res.json();if(!res.ok||!j.ok)return;const byUrl=new Map((j.rows||[]).map(x=>[x.url,x]));group.forEach(r=>{const hit=byUrl.get(r.articleUrl);if(hit?.appid){r.appid=String(hit.appid);r.steamUrl=hit.steamUrl}})}catch{}})}
function saleGames(){return games.filter(g=>g.price?.ok&&g.price?.onSale)}
function imageOf(r){return r.price?.headerImage||r.thumbnail||`https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${r.appid}/header.jpg`}
function sourceTags(r){return (r.sources||[]).filter(x=>sourceLabel[x]).map(x=>`<span class="sourceTag ${esc(x)}">${esc(sourceLabel[x])}</span>`).join('')}
function sourceText(r){return (r.sources||[]).map(x=>sourceLabel[x]).filter(Boolean).join(' + ')||'HARF-WAY'}
function reason(r){const p=r.price||{},src=sourceText(r),multi=(r.sources||[]).length>1;return `${multi?'HARF-WAY内で何度か紹介してきた':'HARF-WAYで紹介した'}${src}の作品。いま${Number(p.discountPercent||0)}%OFFで${p.finalFormatted||''}${Number.isFinite(p.finalYen)&&p.finalYen<=500?'。ワンコイン前後で試しやすい価格です。':'。気になっていたなら見直しどきです。'}`}
function editorialScore(r){const p=r.price||{};return Number(p.discountPercent||0)+(r.sources||[]).length*14+(Number.isFinite(p.finalYen)&&p.finalYen<=500?22:0)+(r.articleUrl?6:0)}
function steamUrl(r){return r.steamUrl||`https://store.steampowered.com/app/${r.appid}/`}
function playlistUrl(code){const m=String(code||'').match(/(?:vol|vo)?0*(\d+)/i);return m?`https://harf-way.com/weekly/digames_playlist/vo${Number(m[1])}/`:''}
function contentLinks(r){const links=[];const add=(label,url)=>{if(url&&!links.some(x=>x.url===url&&x.label===label))links.push({label,url})};if(r.articleUrl)add('紹介記事',r.articleUrl);for(const code of r.playlists||[]){const url=playlistUrl(code);if(url)add(`PLAYLIST ${String(code).replace(/^vol/i,'VOL.')}`,url)}if((r.sources||[]).includes('ways'))add('WAYS','https://harfway-playback.vercel.app/');if((r.sources||[]).includes('yorimichi'))add('ヨリミチ','https://harf-way.com/yorimichi/');return links}
function infoPanel(r){const p=r.price||{},name=r.title||p.steamName||'タイトルなし';const hw=contentLinks(r);return `<div class="infoGrid"><div class="infoRow"><div class="infoLabel">ゲーム名</div><div class="infoValue game">${esc(name)}</div></div><div class="infoRow"><div class="infoLabel">セール率</div><div class="infoValue sale">-${Number(p.discountPercent||0)}%</div></div><div class="infoRow"><div class="infoLabel">値段</div><div class="infoValue price"><strong>${esc(p.finalFormatted||'')}</strong><del>${esc(p.initialFormatted||'')}</del></div></div><div class="infoRow"><div class="infoLabel">ストアページ</div><div class="infoValue"><div class="infoLinks"><a class="store" href="${esc(steamUrl(r))}" target="_blank" rel="noopener">Steamで見る ↗</a></div></div></div><div class="infoRow"><div class="infoLabel">HARF-WAYコンテンツ</div><div class="infoValue"><div class="infoLinks">${hw.length?hw.map(x=>`<a href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.label)} ↗</a>`).join(''):'<span>紹介元データのみ</span>'}</div></div></div></div>`}
function progress(){const pct=totalPrice?Math.round(donePrice/totalPrice*100):(loading?0:100);$('#progressBar').style.width=pct+'%';$('#progressText').textContent=loading?`Steam価格を確認中 ${donePrice}/${totalPrice}${priceErrors?` ・取得失敗 ${priceErrors}`:''}`:`確認完了 ${donePrice}/${totalPrice}${priceErrors?` ・取得失敗 ${priceErrors}`:''}`}
function renderStats(){const s=saleGames();$('#statTotal').textContent=Number(catalogSummary.total||catalog.length||0);$('#statSale').textContent=s.length;$('#statCheap').textContent=s.filter(r=>Number.isFinite(r.price?.finalYen)&&r.price.finalYen<=500).length;$('#statHalf').textContent=s.filter(r=>Number(r.price?.discountPercent||0)>=50).length}
function renderFeatured(){const picks=saleGames().slice().sort((a,b)=>editorialScore(b)-editorialScore(a)).slice(0,3);if(!picks.length){$('#featured').innerHTML='<div class="empty">セール作品を探しています…</div>';return}$('#featured').innerHTML=picks.map(r=>`<article class="feature"><div class="featureMedia"><img src="${esc(imageOf(r))}" alt="${esc(r.title)}" loading="lazy"></div><div class="featureBody"><div class="sourceTags">${sourceTags(r)}</div>${infoPanel(r)}<div class="reason">${esc(reason(r))}</div></div></article>`).join('')}
function shelfCard(r){return `<article class="deal"><div class="dealImg"><img src="${esc(imageOf(r))}" alt="${esc(r.title)}" loading="lazy"></div><div class="dealBody">${infoPanel(r)}</div></article>`}
function renderShelves(){const s=saleGames();const cheap=s.filter(r=>Number.isFinite(r.price?.finalYen)&&r.price.finalYen<=500).sort((a,b)=>a.price.finalYen-b.price.finalYen||b.price.discountPercent-a.price.discountPercent).slice(0,8);const half=s.filter(r=>Number(r.price?.discountPercent||0)>=50).sort((a,b)=>b.price.discountPercent-a.price.discountPercent||a.price.finalYen-b.price.finalYen).slice(0,8);$('#cheapShelf').innerHTML=cheap.length?cheap.map(shelfCard).join(''):'<div class="empty">現在500円以下の作品はありません。</div>';$('#halfShelf').innerHTML=half.length?half.map(shelfCard).join(''):'<div class="empty">現在50%以上OFFの作品はありません。</div>'}
function filtered(){const q=$('#search').value.trim().toLowerCase(),source=$('#source').value,f=$('#filter').value,s=$('#sort').value;const out=saleGames().filter(r=>{const p=r.price||{};if(source!=='all'&&!(r.sources||[]).includes(source))return false;if(f==='under500'&&!(Number.isFinite(p.finalYen)&&p.finalYen<=500))return false;if(f==='half'&&Number(p.discountPercent||0)<50)return false;if(q&&!([r.title,r.category,...(r.tags||[]),...(r.playlists||[])].join(' ').toLowerCase().includes(q)))return false;return true});out.sort((a,b)=>{if(s==='price')return Number(a.price?.finalYen??Infinity)-Number(b.price?.finalYen??Infinity);if(s==='title')return a.title.localeCompare(b.title,'ja');return Number(b.price?.discountPercent||0)-Number(a.price?.discountPercent||0)||Number(a.price?.finalYen??Infinity)-Number(b.price?.finalYen??Infinity)});return out}
function renderList(){const out=filtered();if(!out.length){$('#list').innerHTML=`<div class="empty">${loading?'セール作品を探しています…':'条件に合うセール作品はありません。'}</div>`;return}$('#list').innerHTML=out.map(r=>`<article class="catalogCard"><div class="catalogImg"><img src="${esc(imageOf(r))}" alt="${esc(r.title)}" loading="lazy"></div><div class="catalogBody">${infoPanel(r)}</div></article>`).join('')}
function render(){renderStats();renderFeatured();renderShelves();renderList();progress()}
async function load(){try{const res=await fetch('/api/sales-catalog'),j=await res.json();if(!res.ok||!j.ok)throw Error('catalog');catalog=j.rows||[];catalogSummary=j.summary||{};render();await resolveArticles(catalog);const map=new Map();catalog.forEach(r=>mergeCandidate(map,r));games=[...map.values()];totalPrice=games.length;render();const groups=chunks(games,8);await pool(groups,3,async group=>{const ids=group.map(x=>x.appid);try{const r=await fetch('/api/steam-prices-public?appids='+encodeURIComponent(ids.join(','))),jj=await r.json();if(!r.ok||!jj.ok)throw Error('price');for(const game of group){game.price=jj.prices?.[game.appid]||{ok:false,error:'price_missing'};if(game.price?.ok===false)priceErrors++}}catch{for(const game of group){game.price={ok:false,error:'chunk_failed'};priceErrors++}}donePrice+=group.length;render()});loading=false;render()}catch(e){loading=false;$('#progressText').textContent='DBの読み込みに失敗しました';['featured','cheapShelf','halfShelf','list'].forEach(id=>$('#'+id).innerHTML='<div class="empty">セール情報を読み込めませんでした。</div>')}}
['search','source','filter','sort'].forEach(id=>$('#'+id).addEventListener(id==='search'?'input':'change',renderList));load();
</script>
</body>
</html>
