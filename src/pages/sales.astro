---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="HARF-WAYで紹介したゲームの現在のSteamセール情報を検索・絞り込みできるページです。" />
  <title>HARF-WAY SALE WATCH</title>
  <style is:global>
    :root{
      color-scheme:dark;
      --bg:#090a0c;
      --panel:#111318;
      --panel2:#16191f;
      --line:#2b3038;
      --line2:#3b424d;
      --text:#f4f5f0;
      --muted:#8d96a3;
      --lime:#eaff35;
      --green:#77e99a;
      --amber:#ffd06d;
      --blue:#83c4ff;
      --pink:#f39ac5;
      font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--text)}
    a{color:inherit}
    button,input,select{font:inherit}
    .app{max-width:1360px;margin:auto;padding:0 22px 72px}
    .topbar{position:sticky;top:0;z-index:40;margin:0 -22px;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px;background:rgba(9,10,12,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .brand{font-weight:950;letter-spacing:.08em;font-size:12px}.brand small{display:block;color:var(--muted);font-size:8px;letter-spacing:.04em;margin-top:3px}.toplink{font-size:9px;font-weight:900;text-decoration:none;border:1px solid var(--line2);border-radius:8px;padding:8px 10px;background:#15181d}
    .intro{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding:42px 0 24px}.intro h1{margin:0;font-size:clamp(38px,6vw,72px);line-height:.9;letter-spacing:-.055em}.intro p{margin:0;max-width:570px;color:#b2b8c0;font-size:11px;line-height:1.8}.ey{font-size:9px;font-weight:950;letter-spacing:.15em;color:var(--lime);margin-bottom:10px}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:15px}.stat{border:1px solid var(--line);border-radius:13px;background:var(--panel);padding:13px 14px}.stat small{display:block;color:var(--muted);font-size:8px;font-weight:850}.stat b{display:block;font-size:27px;margin-top:5px;letter-spacing:-.04em}.stat.sale b{color:var(--lime)}
    .controls{position:sticky;top:58px;z-index:30;border:1px solid var(--line);border-radius:15px;background:rgba(17,19,24,.95);backdrop-filter:blur(14px);padding:11px;margin-bottom:13px}.controlMain{display:grid;grid-template-columns:minmax(260px,1fr) repeat(3,minmax(140px,190px));gap:8px}.controlMain input,.controlMain select{width:100%;min-height:42px;border:1px solid var(--line2);border-radius:9px;background:#0d0f13;color:#fff;padding:8px 10px;font-size:10px}.quick{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.quick button{appearance:none;border:1px solid var(--line2);border-radius:999px;background:#13161b;color:#d9dde3;padding:7px 10px;font-size:9px;font-weight:900;cursor:pointer}.quick button.active{background:var(--lime);border-color:var(--lime);color:#090a0c}
    .resultbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:10px 1px 14px;font-size:9px;color:var(--muted)}.resultbar b{color:#fff}.progress{display:flex;align-items:center;gap:9px;min-width:240px}.track{width:150px;height:3px;background:#242933;border-radius:999px;overflow:hidden}.track i{display:block;height:100%;width:0;background:var(--lime);transition:width .2s ease}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.card{min-width:0;border:1px solid var(--line);border-radius:14px;background:var(--panel);overflow:hidden;display:flex;flex-direction:column}.media{position:relative;aspect-ratio:16/9;background:#171a20;overflow:hidden}.media img{width:100%;height:100%;display:block;object-fit:cover}.saleBadge{position:absolute;top:10px;left:10px;display:inline-flex;align-items:center;justify-content:center;min-width:58px;padding:7px 9px;border-radius:999px;background:var(--lime);color:#0a0b0d;font-size:12px;font-weight:950;box-shadow:0 4px 18px rgba(0,0,0,.26)}
    .cardBody{padding:0 13px 13px;display:flex;flex-direction:column;flex:1}.kv{display:grid}.kvRow{display:grid;grid-template-columns:118px minmax(0,1fr);gap:12px;align-items:start;padding:10px 0;border-bottom:1px solid var(--line)}.kvLabel{color:var(--muted);font-size:9px;font-weight:900;line-height:1.45}.kvValue{min-width:0;font-size:11px;line-height:1.55;font-weight:750;overflow-wrap:anywhere}.kvValue.game{font-size:17px;font-weight:950;line-height:1.3}.kvValue.sale{font-size:18px;font-weight:950;color:var(--lime)}.priceNow{font-size:19px;font-weight:950;margin-right:8px}.priceOld{font-size:9px;color:var(--muted)}
    .links{display:flex;gap:6px;flex-wrap:wrap}.action{display:inline-flex;align-items:center;justify-content:center;min-height:31px;padding:6px 9px;border:1px solid var(--line2);border-radius:7px;background:#15181d;text-decoration:none;font-size:9px;font-weight:900}.action.store{background:var(--lime);border-color:var(--lime);color:#08090b}.action.article{color:var(--pink)}.action.playlist{color:#8de2de}.action.ways{color:var(--lime)}.action.yorimichi{color:var(--amber)}.nothing{color:#69727e;font-size:9px}
    .cardMeta{display:flex;gap:5px;flex-wrap:wrap;padding-top:9px}.tag{border:1px solid #343a44;border-radius:999px;padding:4px 6px;color:#9ca5b1;font-size:8px}
    .empty{grid-column:1/-1;border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:64px 20px;text-align:center;color:var(--muted);font-size:11px;line-height:1.8}.foot{margin-top:24px;padding-top:15px;border-top:1px solid var(--line);color:#717a86;font-size:9px;line-height:1.8}
    @media(max-width:1000px){.grid{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.controlMain{grid-template-columns:1fr 1fr}.intro{display:block}.intro p{margin-top:18px}}
    @media(max-width:640px){.app{padding:0 12px 48px}.topbar{margin:0 -12px;padding:10px 12px}.controls{position:relative;top:auto}.controlMain{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.intro{padding:30px 0 18px}.intro h1{font-size:44px}.kvRow{grid-template-columns:104px minmax(0,1fr)}.resultbar{align-items:flex-start;flex-direction:column}.progress{width:100%}.track{flex:1;width:auto}}
  </style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">HARF-WAY / SALE WATCH<small>HARF-WAY紹介済みゲームのSteamセール検索</small></div>
    <a class="toplink" href="https://harf-way.com/" target="_blank" rel="noopener">HARF-WAY ↗</a>
  </header>

  <section class="intro">
    <div><div class="ey">STEAM SALE DATABASE</div><h1>SALE<br>WATCH</h1></div>
    <p>HARF-WAYで過去に紹介したゲームだけを対象に、現在のSteamセールを横断検索できます。作品名、紹介元、価格条件、割引率で絞り込んでください。</p>
  </section>

  <section class="stats">
    <div class="stat"><small>紹介ゲーム</small><b id="statTotal">—</b></div>
    <div class="stat"><small>Steam紐付け</small><b id="statLinked">—</b></div>
    <div class="stat sale"><small>現在セール中</small><b id="statSale">—</b></div>
    <div class="stat"><small>500円以下</small><b id="statCheap">—</b></div>
  </section>

  <section class="controls">
    <div class="controlMain">
      <input id="search" placeholder="ゲーム名 / タグ / プレイリスト名で検索" />
      <select id="source">
        <option value="all">紹介元：すべて</option>
        <option value="article">記事</option>
        <option value="playlist">プレイリスト</option>
        <option value="ways">WAYS</option>
        <option value="yorimichi">ヨリミチ</option>
      </select>
      <select id="filter">
        <option value="all">価格条件：すべて</option>
        <option value="under500">500円以下</option>
        <option value="half">50%以上OFF</option>
        <option value="deep">70%以上OFF</option>
      </select>
      <select id="sort">
        <option value="discount">割引率が高い順</option>
        <option value="price">価格が安い順</option>
        <option value="title">ゲーム名順</option>
      </select>
    </div>
    <div class="quick">
      <button class="active" data-quick="all">すべて</button>
      <button data-quick="under500">500円以下</button>
      <button data-quick="half">50%以上OFF</button>
      <button data-quick="article">記事あり</button>
      <button data-quick="playlist">プレイリスト</button>
    </div>
  </section>

  <div class="resultbar">
    <div><b id="resultCount">0件</b> を表示</div>
    <div class="progress"><span id="progressText">準備中…</span><div class="track"><i id="progressBar"></i></div></div>
  </div>

  <main id="grid" class="grid"><div class="empty">セール情報を読み込んでいます…</div></main>
  <div class="foot">価格・割引率はSteamストアの日本向け情報をもとに表示しています。購入前にSteamストアで最終価格をご確認ください。Steam価格が取得できない作品はこの公開一覧には表示しません。</div>
</div>

<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let catalog=[],games=[],totalPrice=0,donePrice=0,priceErrors=0,loading=true,catalogSummary={};
const sourceLabel={article:'記事',playlist:'PLAYLIST',ways:'WAYS',yorimichi:'ヨリミチ'};

function chunks(a,n){const out=[];for(let i=0;i<a.length;i+=n)out.push(a.slice(i,i+n));return out}
async function pool(items,limit,fn){let next=0;async function worker(){while(next<items.length){const i=next++;await fn(items[i],i)}}await Promise.all(Array.from({length:Math.min(limit,items.length)},worker))}
function mergeCandidate(map,row){
  if(!row.appid)return;
  const id=String(row.appid),prev=map.get(id);
  if(!prev){map.set(id,{...row,appid:id,sources:[...new Set(row.sources||[])],tags:[...new Set(row.tags||[])],playlists:[...new Set(row.playlists||[])]});return}
  prev.sources=[...new Set([...(prev.sources||[]),...(row.sources||[])])];
  prev.tags=[...new Set([...(prev.tags||[]),...(row.tags||[])])];
  prev.playlists=[...new Set([...(prev.playlists||[]),...(row.playlists||[])])];
  if(!prev.articleUrl&&row.articleUrl)prev.articleUrl=row.articleUrl;
  if(!prev.thumbnail&&row.thumbnail)prev.thumbnail=row.thumbnail;
  if(!prev.category&&row.category)prev.category=row.category;
  if(!prev.steamUrl&&row.steamUrl)prev.steamUrl=row.steamUrl;
}
async function resolveArticles(rows){
  const unresolved=rows.filter(r=>!r.appid&&r.articleUrl&&(r.sources||[]).includes('article'));
  const groups=chunks(unresolved,4);
  await pool(groups,2,async group=>{
    const q=new URLSearchParams();group.forEach(r=>q.append('u',r.articleUrl));
    try{
      const res=await fetch('/api/article-steam-public?'+q.toString()),j=await res.json();
      if(!res.ok||!j.ok)return;
      const byUrl=new Map((j.rows||[]).map(x=>[x.url,x]));
      group.forEach(r=>{const hit=byUrl.get(r.articleUrl);if(hit?.appid){r.appid=String(hit.appid);r.steamUrl=hit.steamUrl}})
    }catch{}
  })
}
function saleGames(){return games.filter(g=>g.price?.ok&&g.price?.onSale)}
function imageOf(r){return r.price?.headerImage||r.thumbnail||`https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${r.appid}/header.jpg`}
function steamUrl(r){return r.steamUrl||`https://store.steampowered.com/app/${r.appid}/`}
function playlistUrl(v){const m=String(v||'').match(/(\d+)/);return m?`https://harf-way.com/weekly/digames_playlist/vo${Number(m[1])}/`:''}
function contentLinks(r){
  const links=[];
  if(r.articleUrl)links.push({label:'紹介記事',url:r.articleUrl,kind:'article'});
  for(const v of r.playlists||[]){const url=playlistUrl(v);if(url)links.push({label:`PLAYLIST ${String(v).replace(/^vol/i,'VOL.')}`,url,kind:'playlist'})}
  if((r.sources||[]).includes('ways'))links.push({label:'WAYS',url:'https://harfway-playback.vercel.app/',kind:'ways'});
  if((r.sources||[]).includes('yorimichi'))links.push({label:'ヨリミチ',url:'https://harf-way.com/yorimichi/',kind:'yorimichi'});
  const seen=new Set();
  return links.filter(x=>{const k=x.label+'|'+x.url;if(seen.has(k))return false;seen.add(k);return true})
}
function filtered(){
  const q=$('#search').value.trim().toLowerCase(),source=$('#source').value,f=$('#filter').value,s=$('#sort').value;
  const out=saleGames().filter(r=>{
    const p=r.price||{};
    if(source!=='all'&&!(r.sources||[]).includes(source))return false;
    if(f==='under500'&&!(Number.isFinite(p.finalYen)&&p.finalYen<=500))return false;
    if(f==='half'&&Number(p.discountPercent||0)<50)return false;
    if(f==='deep'&&Number(p.discountPercent||0)<70)return false;
    if(q&&!([r.title,r.category,...(r.tags||[]),...(r.playlists||[]),...(r.sources||[])].join(' ').toLowerCase().includes(q)))return false;
    return true;
  });
  out.sort((a,b)=>{
    if(s==='price')return Number(a.price?.finalYen??Infinity)-Number(b.price?.finalYen??Infinity);
    if(s==='title')return String(a.title||'').localeCompare(String(b.title||''),'ja');
    return Number(b.price?.discountPercent||0)-Number(a.price?.discountPercent||0)||Number(a.price?.finalYen??Infinity)-Number(b.price?.finalYen??Infinity)
  });
  return out
}
function renderStats(){
  const s=saleGames();
  $('#statTotal').textContent=Number(catalogSummary.total||catalog.length||0).toLocaleString('ja-JP');
  $('#statLinked').textContent=games.length.toLocaleString('ja-JP');
  $('#statSale').textContent=s.length.toLocaleString('ja-JP');
  $('#statCheap').textContent=s.filter(r=>Number.isFinite(r.price?.finalYen)&&r.price.finalYen<=500).length.toLocaleString('ja-JP')
}
function progress(){
  const pct=totalPrice?Math.round(donePrice/totalPrice*100):(loading?0:100);
  $('#progressBar').style.width=pct+'%';
  $('#progressText').textContent=loading?`価格確認 ${donePrice}/${totalPrice}`:`更新完了${priceErrors?` / 未取得 ${priceErrors}`:''}`
}
function card(r){
  const p=r.price||{},hw=contentLinks(r),tags=(r.tags||[]).slice(0,4);
  const hwHtml=hw.length?hw.map(x=>`<a class="action ${esc(x.kind)}" href="${esc(x.url)}" target="_blank" rel="noopener">${esc(x.label)} ↗</a>`).join(''):'<span class="nothing">関連リンクなし</span>';
  return `<article class="card">
    <div class="media"><img src="${esc(imageOf(r))}" alt="${esc(r.title||p.steamName||'')}" loading="lazy" onerror="this.style.opacity='.18'"><div class="saleBadge">-${Number(p.discountPercent||0)}%</div></div>
    <div class="cardBody">
      <div class="kv">
        <div class="kvRow"><div class="kvLabel">ゲーム名</div><div class="kvValue game">${esc(r.title||p.steamName||'タイトルなし')}</div></div>
        <div class="kvRow"><div class="kvLabel">セール率</div><div class="kvValue sale">-${Number(p.discountPercent||0)}%</div></div>
        <div class="kvRow"><div class="kvLabel">値段</div><div class="kvValue"><span class="priceNow">${esc(p.finalFormatted||'')}</span>${p.initialFormatted?`<del class="priceOld">${esc(p.initialFormatted)}</del>`:''}</div></div>
        <div class="kvRow"><div class="kvLabel">ストアページ</div><div class="kvValue links"><a class="action store" href="${esc(steamUrl(r))}" target="_blank" rel="noopener">Steamで見る ↗</a></div></div>
        <div class="kvRow"><div class="kvLabel">HARF-WAYコンテンツ</div><div class="kvValue links">${hwHtml}</div></div>
      </div>
      ${tags.length?`<div class="cardMeta">${tags.map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div>`:''}
    </div>
  </article>`
}
function render(){
  renderStats();progress();
  const out=filtered();
  $('#resultCount').textContent=`${out.length}件`;
  if(!out.length){$('#grid').innerHTML=`<div class="empty">${loading?'セール作品を確認しています…':'条件に合うセール作品はありません。'}</div>`;return}
  $('#grid').innerHTML=out.map(card).join('')
}
function syncQuick(){
  document.querySelectorAll('[data-quick]').forEach(b=>b.classList.remove('active'));
  const source=$('#source').value,f=$('#filter').value;
  let key='all';
  if(f==='under500')key='under500';else if(f==='half')key='half';else if(source==='article')key='article';else if(source==='playlist')key='playlist';
  document.querySelector(`[data-quick="${key}"]`)?.classList.add('active')
}
async function load(){
  try{
    const res=await fetch('/api/sales-catalog'),j=await res.json();
    if(!res.ok||!j.ok)throw Error('catalog');
    catalog=j.rows||[];catalogSummary=j.summary||{};render();
    await resolveArticles(catalog);
    const map=new Map();catalog.forEach(r=>mergeCandidate(map,r));games=[...map.values()];totalPrice=games.length;render();
    const groups=chunks(games,8);
    await pool(groups,3,async group=>{
      const ids=group.map(x=>x.appid);
      try{
        const r=await fetch('/api/steam-prices-public?appids='+encodeURIComponent(ids.join(','))),jj=await r.json();
        if(!r.ok||!jj.ok)throw Error('price');
        for(const game of group){game.price=jj.prices?.[game.appid]||{ok:false,error:'price_missing'};if(game.price?.ok===false)priceErrors++}
      }catch{for(const game of group){game.price={ok:false,error:'chunk_failed'};priceErrors++}}
      donePrice+=group.length;render()
    });
    loading=false;render()
  }catch(e){
    loading=false;$('#progressText').textContent='DBの読み込みに失敗しました';$('#grid').innerHTML='<div class="empty">セール情報を読み込めませんでした。</div>'
  }
}
['search','source','filter','sort'].forEach(id=>$('#'+id).addEventListener(id==='search'?'input':'change',()=>{syncQuick();render()}));
document.querySelectorAll('[data-quick]').forEach(btn=>btn.addEventListener('click',()=>{
  const q=btn.dataset.quick;$('#source').value='all';$('#filter').value='all';
  if(q==='under500')$('#filter').value='under500';
  if(q==='half')$('#filter').value='half';
  if(q==='article')$('#source').value='article';
  if(q==='playlist')$('#source').value='playlist';
  syncQuick();render()
}));
load();
</script>
</body>
</html>
