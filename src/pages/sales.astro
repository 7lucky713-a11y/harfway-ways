---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="HARF-WAYで紹介したゲームのうち、現在Steamでセール中の作品をまとめています。" />
  <title>HARF-WAY SALE PICKS</title>
  <style>
    :root{color-scheme:dark;--bg:#090a09;--panel:#121312;--panel2:#171917;--line:#30332e;--muted:#92968f;--acid:#dfff3f;--pink:#f06b98;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f5f4ed}a{color:inherit}.wrap{max-width:1280px;margin:auto;padding:28px 20px 64px}.hero{padding:38px 0 28px;border-bottom:1px solid var(--line);margin-bottom:20px}.eyebrow{font-size:10px;letter-spacing:.2em;color:var(--acid);font-weight:900}.hero h1{font-size:clamp(48px,9vw,104px);line-height:.82;margin:13px 0 22px;letter-spacing:-.06em}.hero p{max-width:760px;color:#b7bab4;line-height:1.85;margin:0}.statusline{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.statuschip{border:1px solid var(--line);border-radius:999px;padding:7px 10px;color:var(--muted);font-size:10px}.statuschip b{color:#fff}.statuschip.live{border-color:#5c692a;color:var(--acid)}
    .toolbar{position:sticky;top:0;z-index:10;display:grid;grid-template-columns:minmax(220px,1fr) auto auto auto;gap:9px;margin-bottom:17px;padding:11px;border:1px solid var(--line);border-radius:15px;background:#0d0e0deb;backdrop-filter:blur(12px)}.toolbar input,.toolbar select{min-height:43px;border:1px solid var(--line);border-radius:10px;background:#171917;color:#fff;padding:9px 11px;font:inherit;font-size:12px}.progress{margin:0 0 15px;color:var(--muted);font-size:11px;display:flex;align-items:center;gap:10px}.bar{height:4px;flex:1;border-radius:999px;background:#1d201c;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--acid);transition:width .2s ease}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:17px;overflow:hidden;background:var(--panel);display:flex;flex-direction:column;min-height:100%}.thumb{aspect-ratio:460/215;background:#191b18;overflow:hidden;position:relative}.thumb img{width:100%;height:100%;object-fit:cover;display:block}.sourceflags{position:absolute;left:10px;top:10px;display:flex;gap:5px;flex-wrap:wrap}.flag{padding:5px 7px;border-radius:999px;background:#090a09dc;border:1px solid #ffffff2b;font-size:8px;font-weight:900;letter-spacing:.08em}.flag.article{color:#ff9dbd}.flag.playlist{color:#8ce8e2}.flag.ways{color:var(--acid)}.flag.yorimichi{color:#ffc782}.body{padding:16px;display:grid;gap:11px}.title{font-size:20px;line-height:1.25;font-weight:900}.context{font-size:10px;color:var(--muted);min-height:14px}.tags{display:flex;gap:5px;flex-wrap:wrap}.pill{display:inline-block;border:1px solid #3b3f39;border-radius:999px;padding:4px 7px;font-size:9px;color:#babdb7}.pricebox{display:flex;align-items:flex-end;gap:10px;padding-top:3px}.discount{font-size:31px;line-height:.9;font-weight:950;color:var(--acid)}.prices{display:grid;gap:2px}.prices del{font-size:10px;color:#777b75}.prices b{font-size:20px}.links{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;border-radius:10px;padding:9px 12px;text-decoration:none;font-size:11px;font-weight:900;border:1px solid var(--line);background:#1a1c19}.btn.primary{background:var(--acid);color:#10110f;border-color:transparent}.empty{grid-column:1/-1;padding:66px 18px;border:1px solid var(--line);border-radius:17px;text-align:center;color:var(--muted);line-height:1.9}.foot{margin-top:25px;padding-top:18px;border-top:1px solid var(--line);font-size:10px;line-height:1.8;color:#777c74}
    @media(max-width:760px){.wrap{padding:18px 12px 48px}.hero{padding-top:24px}.toolbar{position:relative;grid-template-columns:1fr}.toolbar input,.toolbar select{width:100%}.grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
<main class="wrap">
  <section class="hero">
    <div class="eyebrow">HARF-WAY / DATABASE SALE DIG</div>
    <h1>SALE<br>PICKS</h1>
    <p>WAYSだけではなく、プレイリスト、記事、ヨリミチなどHARF-WAYのデータベース全体から、いまSteamでセール中の作品を掘り起こします。</p>
    <div id="statusline" class="statusline"><span class="statuschip live">DBを読み込み中…</span></div>
  </section>

  <div class="toolbar">
    <input id="search" placeholder="作品名 / タグで検索" />
    <select id="source"><option value="all">紹介元：すべて</option><option value="article">記事</option><option value="playlist">プレイリスト</option><option value="ways">WAYS</option><option value="yorimichi">ヨリミチ</option></select>
    <select id="filter"><option value="all">セール中すべて</option><option value="under500">500円以下</option><option value="half">50%以上OFF</option></select>
    <select id="sort"><option value="discount">割引率が高い順</option><option value="price">価格が安い順</option><option value="title">作品名順</option></select>
  </div>
  <div class="progress"><span id="progressText">準備中…</span><div class="bar"><i id="progressBar"></i></div></div>
  <section id="grid" class="grid"><div class="empty">データベースを確認しています…</div></section>
  <div class="foot">価格・割引率はSteamストアの日本向け情報をもとに表示しています。記事にSteam URLが保存されていない場合はHARF-WAY記事内のSteamリンクも確認します。取得に失敗した作品があっても、取得できた作品はそのまま表示します。購入前にSteamストアで最終価格をご確認ください。</div>
</main>
<script>
const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let catalog=[];let games=[];let totalPrice=0;let donePrice=0;let priceErrors=0;let loading=true;let catalogSummary={};
const sourceLabel={article:'記事',playlist:'PLAYLIST',ways:'WAYS',yorimichi:'ヨリミチ'};
function chunks(a,n){const out=[];for(let i=0;i<a.length;i+=n)out.push(a.slice(i,i+n));return out}
async function pool(items,limit,fn){let next=0;async function worker(){while(next<items.length){const i=next++;await fn(items[i],i)}}await Promise.all(Array.from({length:Math.min(limit,items.length)},worker))}
function mergeCandidate(map,row){if(!row.appid)return;const id=String(row.appid);const prev=map.get(id);if(!prev){map.set(id,{...row,appid:id,sources:[...new Set(row.sources||[])],tags:[...new Set(row.tags||[])],playlists:[...new Set(row.playlists||[])]});return}prev.sources=[...new Set([...(prev.sources||[]),...(row.sources||[])])];prev.tags=[...new Set([...(prev.tags||[]),...(row.tags||[])])];prev.playlists=[...new Set([...(prev.playlists||[]),...(row.playlists||[])])];if(!prev.articleUrl&&row.articleUrl)prev.articleUrl=row.articleUrl;if(!prev.thumbnail&&row.thumbnail)prev.thumbnail=row.thumbnail;if(!prev.category&&row.category)prev.category=row.category}
async function resolveArticles(rows){const unresolved=rows.filter(r=>!r.appid&&r.articleUrl&&(r.sources||[]).includes('article'));const groups=chunks(unresolved,4);await pool(groups,2,async group=>{const q=new URLSearchParams();group.forEach(r=>q.append('u',r.articleUrl));try{const res=await fetch('/api/article-steam-public?'+q.toString());const j=await res.json();if(!res.ok||!j.ok)return;const byUrl=new Map((j.rows||[]).map(x=>[x.url,x]));group.forEach(r=>{const hit=byUrl.get(r.articleUrl);if(hit?.appid){r.appid=String(hit.appid);r.steamUrl=hit.steamUrl}})}catch{}})}
function status(){const sales=games.filter(g=>g.price?.onSale).length;const sc=catalogSummary.sourceCounts||{};$('#statusline').innerHTML=[`<span class="statuschip"><b>${Number(catalogSummary.total||0)}</b> DB作品</span>`,`<span class="statuschip"><b>${games.length}</b> Steam紐付け</span>`,`<span class="statuschip live"><b>${sales}</b> セール中</span>`,sc.article?`<span class="statuschip">記事 <b>${sc.article}</b></span>`:'',sc.playlist?`<span class="statuschip">PLAYLIST <b>${sc.playlist}</b></span>`:'',sc.ways?`<span class="statuschip">WAYS <b>${sc.ways}</b></span>`:''].filter(Boolean).join('')}
function progress(){const p=totalPrice?Math.round(donePrice/totalPrice*100):(loading?0:100);$('#progressBar').style.width=p+'%';$('#progressText').textContent=loading?`Steam価格を確認中 ${donePrice}/${totalPrice}${priceErrors?` ・取得失敗 ${priceErrors}`:''}`:`確認完了 ${donePrice}/${totalPrice}${priceErrors?` ・取得失敗 ${priceErrors}`:''}`}
function filtered(){const q=$('#search').value.trim().toLowerCase(),source=$('#source').value,f=$('#filter').value,s=$('#sort').value;const out=games.filter(r=>{const p=r.price||{};if(!p.onSale)return false;if(source!=='all'&&!(r.sources||[]).includes(source))return false;if(f==='under500'&&!(Number.isFinite(p.finalYen)&&p.finalYen<=500))return false;if(f==='half'&&Number(p.discountPercent||0)<50)return false;if(q&&!([r.title,r.category,...(r.tags||[]),...(r.playlists||[])].join(' ').toLowerCase().includes(q)))return false;return true});out.sort((a,b)=>{if(s==='price')return Number(a.price?.finalYen??Infinity)-Number(b.price?.finalYen??Infinity);if(s==='title')return a.title.localeCompare(b.title,'ja');return Number(b.price?.discountPercent||0)-Number(a.price?.discountPercent||0)||Number(a.price?.finalYen??Infinity)-Number(b.price?.finalYen??Infinity)});return out}
function render(){status();progress();const out=filtered();if(!out.length){$('#grid').innerHTML=`<div class="empty">${loading?'セール作品を探しています。取得できた作品から順に表示します…':'現在、条件に合うセール作品はありません。'}</div>`;return}$('#grid').innerHTML=out.map(r=>{const p=r.price||{};const img=p.headerImage||r.thumbnail||'';const flags=(r.sources||[]).filter(x=>sourceLabel[x]).map(x=>`<span class="flag ${esc(x)}">${esc(sourceLabel[x])}</span>`).join('');const context=(r.playlists||[]).length?`PLAYLIST ${r.playlists.map(x=>x.replace(/^vol/i,'VOL.')).join(' / ')}`:'';return `<article class="card"><div class="thumb">${img?`<img src="${esc(img)}" alt="" loading="lazy">`:''}<div class="sourceflags">${flags}</div></div><div class="body"><div class="title">${esc(r.title||p.steamName||'タイトルなし')}</div><div class="context">${esc(context)}</div><div class="tags">${(r.tags||[]).slice(0,4).map(t=>`<span class="pill">${esc(t)}</span>`).join('')}</div><div class="pricebox"><div class="discount">-${Number(p.discountPercent||0)}%</div><div class="prices"><del>${esc(p.initialFormatted||'')}</del><b>${esc(p.finalFormatted||'')}</b></div></div><div class="links"><a class="btn primary" href="${esc(r.steamUrl||`https://store.steampowered.com/app/${r.appid}/`)}" target="_blank" rel="noopener">Steamで見る</a>${r.articleUrl?`<a class="btn" href="${esc(r.articleUrl)}" target="_blank" rel="noopener">HARF-WAYの記事</a>`:''}</div></div></article>`}).join('')}
async function load(){try{const res=await fetch('/api/sales-catalog');const j=await res.json();if(!res.ok||!j.ok)throw Error('catalog');catalog=j.rows||[];catalogSummary=j.summary||{};render();await resolveArticles(catalog);const map=new Map();catalog.forEach(r=>mergeCandidate(map,r));games=[...map.values()];totalPrice=games.length;render();const groups=chunks(games,8);await pool(groups,3,async group=>{const ids=group.map(x=>x.appid);try{const r=await fetch('/api/steam-prices-public?appids='+encodeURIComponent(ids.join(',')));const j=await r.json();if(!r.ok||!j.ok)throw Error('price');for(const game of group){game.price=j.prices?.[game.appid]||{ok:false,error:'price_missing'};if(game.price?.ok===false)priceErrors++}}catch{for(const game of group){game.price={ok:false,error:'chunk_failed'};priceErrors++}}donePrice+=group.length;render()});loading=false;render()}catch(e){loading=false;$('#progressText').textContent='DBの読み込みに失敗しました';$('#grid').innerHTML='<div class="empty">セール情報を読み込めませんでした。Previewの接続状態を確認してください。</div>'}}
['search','source','filter','sort'].forEach(id=>$('#'+id).addEventListener(id==='search'?'input':'change',render));load();
</script>
</body>
</html>
