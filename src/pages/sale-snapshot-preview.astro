---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SALE SNAPSHOT PREVIEW / HARF-WAY</title>
  <style>
    :root { color-scheme: light; font-family: -apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif; background:#f8f6f0; color:#181818; }
    * { box-sizing:border-box; }
    body { margin:0; padding:32px 16px 64px; }
    main { width:min(960px,100%); margin:auto; }
    .eyebrow { font:800 10px/1.2 ui-monospace,monospace; letter-spacing:.15em; color:#77736b; }
    .title { margin:10px 0 4px; font-size:clamp(30px,5vw,50px); font-weight:800; letter-spacing:-.05em; }
    .note { color:#77736b; font-size:12px; line-height:1.8; }
    .meter { margin:22px 0; padding:12px 14px; border:1px solid #d6d0c5; background:#fffefa; font:700 11px/1.6 ui-monospace,monospace; }
    .grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
    .card { border:1px solid #d6d0c5; background:#fffefa; overflow:hidden; }
    .image { position:relative; aspect-ratio:460/215; background:#ddd; }
    .image img { width:100%; height:100%; display:block; object-fit:cover; }
    .discount { position:absolute; left:9px; top:9px; padding:6px 8px; border:1px solid #111; background:#e8ff48; font:900 12px ui-monospace,monospace; }
    .body { padding:12px; }
    .card-title { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:15px; font-weight:700; }
    .price { margin-top:10px; display:flex; gap:8px; align-items:baseline; }
    .price strong { font-size:20px; }
    .price del { color:#77736b; font-size:10px; }
    button { margin-top:18px; border:1px solid #181818; background:#fffefa; padding:10px 12px; cursor:pointer; font-weight:800; }
    @media(max-width:680px){ .grid{grid-template-columns:1fr;} }
  </style>
</head>
<body>
<main>
  <div class="eyebrow">HARF-WAY / SALE SNAPSHOT PREVIEW</div>
  <div class="title" role="heading" aria-level="1">先に作ったセール一覧から、3本だけ。</div>
  <p class="note">この画面ではSteamへ価格確認をしません。完成済みのスナップショットJSONを1回読むだけです。</p>
  <div class="meter" data-meter>読み込み中…</div>
  <div class="grid" data-grid></div>
  <button type="button" data-shuffle disabled>↻ 3本を入れ替える</button>
</main>
<script is:inline>
(() => {
  const grid = document.querySelector('[data-grid]');
  const meter = document.querySelector('[data-meter]');
  const button = document.querySelector('[data-shuffle]');
  let pool = [];
  let previous = [];
  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const shuffle = (list) => {
    const a = [...list];
    for (let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
    return a;
  };
  function render(){
    let candidates = pool.filter(x => !previous.includes(String(x.appid)));
    if (candidates.length < 3) candidates = pool;
    const selected = shuffle(candidates).slice(0,3);
    previous = selected.map(x => String(x.appid));
    grid.innerHTML = selected.map(item => `
      <article class="card">
        <div class="image"><img src="${esc(item.image)}" alt="${esc(item.title)}"><span class="discount">-${Number(item.discount||0)}%</span></div>
        <div class="body"><div class="card-title">${esc(item.title)}</div><div class="price"><strong>${esc(item.final)}</strong><del>${esc(item.initial)}</del></div></div>
      </article>`).join('');
  }
  async function init(){
    const start = performance.now();
    try {
      const res = await fetch('/api/sales-snapshot-public?preview=1', { cache:'no-store' });
      const data = await res.json();
      const elapsed = Math.round(performance.now()-start);
      pool = Array.isArray(data.items) ? data.items : [];
      meter.textContent = `snapshot fetch: ${elapsed}ms / 候補 ${pool.length}件 / source: ${data.source || '-'}`;
      if (!pool.length) throw new Error('empty');
      render();
      button.disabled = pool.length < 4;
    } catch (e) {
      meter.textContent = 'スナップショットを取得できませんでした。';
    }
  }
  button.addEventListener('click', render);
  init();
})();
</script>
</body>
</html>
