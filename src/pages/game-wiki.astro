<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>HARF-WAY GAME WIKI</title>
  <meta name="description" content="HARF-WAYが実際に遊びながら蓄積したゲーム用語と知識を読む、小さなゲームWiki。" />
  <style>
    :root{--bg:#f2f1e9;--paper:#fbfaf4;--ink:#171a16;--muted:#6b7168;--line:#d6d7ce;--accent:#bfd52f;--deep:#26310f;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif;color-scheme:light}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink)}button,input,select{font:inherit}.wrap{max-width:1180px;margin:auto;padding:28px 24px 90px}.mast{display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--line);padding-bottom:20px}.brand{font-size:13px;letter-spacing:.17em;font-weight:900}.brand span{color:#728018}.harf{color:var(--muted);text-decoration:none;font-size:13px}.harf:hover{color:var(--ink)}.hero{padding:68px 0 48px;display:grid;grid-template-columns:minmax(0,760px) 1fr;gap:40px;align-items:end}.hero small{font-size:11px;letter-spacing:.18em;font-weight:900;color:#667516}.hero h1{font-size:clamp(48px,8vw,94px);line-height:.9;letter-spacing:-.065em;margin:12px 0 20px}.hero p{font-family:Georgia,"Yu Mincho",serif;font-size:17px;line-height:2;margin:0;color:#50574e}.count{text-align:right;color:var(--muted);font-size:12px}.count b{display:block;color:var(--ink);font-size:42px;line-height:1}.tools{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:10px;margin-bottom:30px}.tools input,.tools select{width:100%;border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:4px;padding:14px 15px;font-size:16px;outline:none}.tools input:focus,.tools select:focus{border-color:#98a91f}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.term-card{background:var(--paper);border:1px solid var(--line);padding:24px;min-height:310px;display:flex;flex-direction:column;cursor:pointer;transition:transform .15s,border-color .15s}.term-card:hover,.term-card:focus{transform:translateY(-2px);border-color:#a9b45c;outline:none}.term-meta{font-size:10px;letter-spacing:.08em;color:#71776e;text-transform:uppercase}.term-card h2{font-family:Georgia,"Yu Mincho",serif;font-size:30px;line-height:1.25;margin:18px 0 14px}.term-card p{margin:0;color:#4d544c;line-height:1.9;font-size:14px;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}.term-related{display:flex;gap:5px;flex-wrap:wrap;margin-top:18px}.term-related span{font-size:10px;border:1px solid var(--line);padding:4px 6px;border-radius:999px;color:#687066}.read-more{margin-top:auto;padding-top:24px;font-size:12px;font-weight:800;color:#6b751c}.empty{grid-column:1/-1;border:1px dashed #c6c8bd;padding:70px 20px;text-align:center;color:var(--muted);background:rgba(255,255,255,.25)}.empty b{display:block;color:var(--ink);font-size:22px;margin-bottom:8px}.detail{display:none}.detail.show{display:block}.wiki-list.detail-mode{display:none}.detail-back{border:0;background:transparent;padding:20px 0;color:#656d63;cursor:pointer}.entry-article{max-width:850px;margin:40px auto 0;background:var(--paper);border-top:5px solid var(--accent);padding:clamp(28px,6vw,70px)}.article-meta{display:flex;gap:10px;flex-wrap:wrap;font-size:10px;letter-spacing:.1em;color:#71786f}.article-meta span+span:before{content:"/";margin-right:10px}.entry-article h1{font-family:Georgia,"Yu Mincho",serif;font-size:clamp(42px,7vw,72px);line-height:1.05;letter-spacing:-.04em;margin:26px 0 34px}.article-copy{white-space:pre-wrap;font-family:Georgia,"Yu Mincho",serif;font-size:18px;line-height:2.15;color:#333933}.connections{border-top:1px solid var(--line);margin-top:54px;padding-top:24px}.connections small{display:block;font-size:10px;letter-spacing:.15em;color:#71786f;margin-bottom:12px}.connections div{display:flex;gap:8px;flex-wrap:wrap}.related{display:inline-flex;border:1px solid var(--line);background:transparent;color:#60675d;border-radius:999px;padding:7px 10px;font-size:12px}.related.linked{cursor:pointer;color:#4e5b0b;border-color:#afb967;background:#f5f5de}.related.linked:hover{background:#eaefbd}.footer{margin-top:70px;border-top:1px solid var(--line);padding-top:20px;color:#777d75;font-size:11px;line-height:1.8}.footer b{color:#4e554d}
    @media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{grid-template-columns:1fr}.count{text-align:left}.tools{grid-template-columns:1fr}}
    @media(max-width:620px){.wrap{padding:20px 14px 70px}.mast{align-items:flex-start}.brand{font-size:11px}.hero{padding:48px 0 36px}.hero h1{font-size:54px}.count{display:none}.grid{grid-template-columns:1fr}.term-card{min-height:0}.entry-article{margin-top:18px;padding:28px 20px}.entry-article h1{font-size:44px}.article-copy{font-size:17px}.tools input,.tools select{font-size:16px}}
  </style>
</head>
<body>
  <main class="wrap">
    <header class="mast">
      <div class="brand"><span>HARF-WAY</span> / GAME WIKI</div>
      <a class="harf" href="https://harf-way.com/" target="_blank" rel="noopener">HARF-WAYへ ↗</a>
    </header>

    <section class="wiki-list" id="wiki-list">
      <div class="hero">
        <div><small>PLAYED KNOWLEDGE</small><h1>GAME<br>WIKI</h1><p>攻略情報を網羅するためではなく、実際に遊んで理解した言葉を少しずつ繋いでいく。HARF-WAYのゲーム知識帳。</p></div>
        <div class="count"><b id="entry-count">0</b> PUBLISHED TERMS</div>
      </div>
      <section class="tools"><input id="search" type="search" autocomplete="off" placeholder="用語・説明・関連語から探す" /><select id="game-filter"><option value="all">すべてのゲーム</option></select></section>
      <section class="grid" id="entry-grid"></section>
    </section>

    <section class="detail" id="detail"></section>

    <footer class="footer"><b>HARF-WAY GAME WIKI</b><br>Private Game Notebookで蓄積した知識のうち、公開を選んだ項目だけを掲載しています。</footer>
  </main>
  <script is:inline src="/game-wiki/wiki.js"></script>
</body>
</html>
