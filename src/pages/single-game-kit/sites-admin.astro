<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>SINGLE GAME KIT — Sites CMS</title><style is:global>:root{--bg:#101310;--panel:#181d19;--panel2:#212722;--text:#e6ece5;--muted:#9ba69d;--line:#354037;--accent:#a7c28f}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.wrap{max-width:1280px;margin:auto;padding:24px}.top{border-bottom:1px solid var(--line);background:#101310ef;position:sticky;top:0;z-index:4}.topin{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:16px}.top h1{font-size:20px;margin:0}.top p{margin:2px 0 0;color:var(--muted);font-size:12px}.layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(340px,.95fr);gap:20px;padding-top:22px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}h2{margin:0 0 16px;font-size:18px}.notice{color:var(--muted);font-size:13px;line-height:1.7}.form{display:grid;gap:14px}.field{display:grid;gap:6px}.field label{font-size:12px;font-weight:800;color:#c6d0c6}input,textarea{width:100%;border:1px solid #465148;background:#111512;color:var(--text);border-radius:9px;padding:10px 11px;font:inherit}textarea{min-height:110px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.three{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.category-row{display:grid;grid-template-columns:1fr 1.4fr .8fr;gap:8px;margin-top:7px}.category-row input{font-size:13px}.actions{display:flex;gap:9px;flex-wrap:wrap}.btn{border:1px solid #4b584d;background:var(--panel2);color:var(--text);border-radius:9px;padding:10px 13px;font-weight:800;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:#111}.sites{display:grid;gap:10px}.site{border:1px solid var(--line);background:var(--panel2);border-radius:12px;padding:14px}.site h3{margin:0;font-size:18px}.site p{margin:5px 0 10px;color:var(--muted);font-size:12px}.links{display:flex;gap:8px;flex-wrap:wrap}.links a,.links button{font-size:12px}.badge{display:inline-block;border:1px solid #526054;border-radius:999px;padding:4px 8px;color:#b9c5ba;font-size:11px}.status{min-height:20px;color:var(--muted);font-size:12px;margin-top:8px}.status.good{color:#b9d8a7}.empty{padding:24px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:12px}@media(max-width:900px){.layout{grid-template-columns:1fr}.two,.three{grid-template-columns:1fr}.category-row{grid-template-columns:1fr}}</style></head><body><header class="top"><div class="wrap topin"><div><h1>SINGLE GAME KIT / SITES CMS</h1><p>ゲームサイト追加をデプロイから分離する</p></div><a href="/single-game-kit/">一覧を見る</a></div></header><main class="wrap layout"><section class="panel"><h2>ゲームサイトを追加 / 編集</h2><p class="notice">ここで保存した設定はNeonへ入ります。エンジン本体を変更しない限り、サイト追加・文言・カテゴリ・色変更でVercelデプロイは発生しません。</p><form id="siteForm" class="form"><div class="two"><div class="field"><label for="gameName">ゲーム名</label><input id="gameName" required placeholder="Balatro"></div><div class="field"><label for="slug">URL slug</label><input id="slug" required pattern="[a-z0-9][a-z0-9-]{1,59}" placeholder="balatro"></div></div><div class="two"><div class="field"><label for="siteName">サイト名</label><input id="siteName" required placeholder="RUN LOG"></div><div class="field"><label for="badge">小見出し</label><input id="badge" placeholder="Balatro / run archive"></div></div><div class="three"><div class="field"><label for="hero1">Hero 1</label><input id="hero1" value="PLAY."></div><div class="field"><label for="hero2">Hero 2</label><input id="hero2" value="NOTE."></div><div class="field"><label for="hero3">Hero 3</label><input id="hero3" value="REMEMBER."></div></div><div class="field"><label for="description">説明</label><textarea id="description" required></textarea></div><div class="field"><label>カテゴリ（ID / 表示名 / 短縮）</label><div id="categories"></div></div><div class="two"><div class="field"><label for="subjectLabel">固有項目1 ラベル</label><input id="subjectLabel" value="対象"></div><div class="field"><label for="subjectPlaceholder">固有項目1 例</label><input id="subjectPlaceholder" value="キャラ / 武器 / デッキなど"></div></div><div class="two"><div class="field"><label for="roleLabel">固有項目2 ラベル</label><input id="roleLabel" value="状況"></div><div class="field"><label for="rolePlaceholder">固有項目2 例</label><input id="rolePlaceholder" value="クラス / 難易度 / ステージなど"></div></div><div class="two"><div class="field"><label for="accent">Accent</label><input id="accent" type="color" value="#93ad82"></div><div class="field"><label for="accent2">Accent 2</label><input id="accent2" type="color" value="#c2b58e"></div></div><div class="actions"><button class="btn primary" id="saveSite" type="submit">サイトを保存</button><button class="btn" id="clearSite" type="button">新規入力に戻す</button></div><div id="status" class="status"></div></form></section><aside class="panel"><h2>登録済みサイト</h2><div id="storage" class="notice">DB確認中…</div><div id="sites" class="sites"><div class="empty">読み込み中…</div></div></aside></main><script is:inline src="/single-game-kit/sites-admin.js"></script></body></html>
