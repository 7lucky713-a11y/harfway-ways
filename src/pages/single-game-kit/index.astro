---
import { SINGLE_GAME_KIT_VERSION, singleGameConfigs } from '../../lib/single-game-kit/configs.js';

const configJson = JSON.stringify(singleGameConfigs).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>HARF-WAY SINGLE GAME KIT — Preview</title></head>
<body style="margin:0;background:#101210;color:#e8ece7;font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Yu Gothic',Meiryo,sans-serif">
  <main style="max-width:980px;margin:auto;padding:48px 22px">
    <p style="color:#93ad82;font-weight:900">HARF-WAY SINGLE GAME KIT / v{SINGLE_GAME_KIT_VERSION}</p>
    <h1 style="font-size:clamp(48px,8vw,92px);line-height:.92;margin:12px 0 22px">ゲームを差し替えて<br>専門サイトを増やす。</h1>
    <p style="max-width:760px;color:#a7b0a7;line-height:1.9">共通CRUD・Neon Preview DB・R2画像/動画アップロードまでCONFIG駆動にした統合Previewです。MewgenicsとBalatroはDB source / ID prefix / R2 namespaceまで分離されています。</p>
    <div id="games" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-top:30px"></div>
  </main>
  <script id="kitConfigs" type="application/json" set:html={configJson}></script>
  <script is:inline>
    const configs=JSON.parse(document.getElementById('kitConfigs').textContent||'[]');
    document.getElementById('games').innerHTML=configs.map((c)=>`<section style="border:1px solid #303730;background:#171a17;border-radius:16px;padding:20px"><small style="color:#8f998f">${c.data.source}</small><h2 style="font-size:28px;margin:8px 0">${c.siteName}</h2><p style="color:#a7b0a7">${c.gameName} / ${c.categories.map(x=>x.label).join('・')}</p><div style="display:flex;gap:8px;flex-wrap:wrap"><a style="color:#101210;background:#e1e8df;padding:9px 12px;border-radius:9px;text-decoration:none;font-weight:900" href="/single-game-kit/${c.id}/">公開ページ</a><a style="color:#e1e8df;border:1px solid #4a554b;padding:9px 12px;border-radius:9px;text-decoration:none;font-weight:900" href="/single-game-kit/${c.id}/admin/">管理画面</a></div></section>`).join('');
  </script>
</body>
</html>
