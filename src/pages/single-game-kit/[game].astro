---
import { singleGameConfigs } from '../../lib/single-game-kit/configs.js';

export function getStaticPaths() {
  return singleGameConfigs.map((config) => ({ params: { game: config.id }, props: { config } }));
}

const { config } = Astro.props;
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
const vars = Object.entries(config.theme).map(([k,v]) => `--${k}:${v}`).join(';');
const hero = config.hero.map((line, index) => index === config.hero.length - 1 ? `<em>${line}</em>` : line).join('<br>');
const parts = config.siteName.split(' ');
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content={config.description} />
  <title>{config.siteName} — {config.gameName}</title>
  <link rel="stylesheet" href="/single-game-kit/style.css" />
</head>
<body style={vars}>
  <header class="top"><div class="wrap row"><div class="brand">{parts[0]} <b>{parts.slice(1).join(' ') || 'LOG'}</b></div><a href={`/single-game-kit/${config.id}/admin/`}>＋記録 / 編集</a></div></header>
  <main>
    <section class="wrap hero">
      <span class="stamp">{config.badge}</span>
      <h1 set:html={hero}></h1>
      <p>{config.description}</p>
      <div class="nav"><button class="on" data-filter="all">ALL</button>{config.categories.map((c)=><button data-filter={c.id}>{c.label}</button>)}</div>
      <div class="stats" id="stats"></div>
    </section>
    <section class="wrap grid" id="grid"><div class="empty">記録を読み込んでいます…</div></section>
  </main>
  <footer class="wrap footer">{config.siteName} / HARF-WAY — <span id="storageLabel">checking storage…</span></footer>
  <script id="gameConfig" type="application/json" set:html={configJson}></script>
  <script is:inline>window.__SINGLE_GAME_KIT__ = JSON.parse(document.getElementById('gameConfig').textContent || '{}');</script>
  <script src="/single-game-kit/runtime.js"></script>
</body>
</html>
