<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>WAYS WEEKLY EDITOR v5</title>
<style>
:root{--bg:#090909;--panel:#111214;--line:#2d3035;--text:#f4f4ee;--muted:#80858d;--acid:#efff35}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}button,input,textarea,select{font:inherit}.wwe5-app{height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 440px;overflow:hidden}.wwe5-library{height:100vh;overflow:auto;padding:18px 22px 28px;border-right:1px solid var(--line);background:#0a0b0c;min-width:0}.wwe5-editor{height:100vh;overflow:auto;padding:18px;background:#0d0e0f}.wwe5-brand{font-size:9px;letter-spacing:.18em;color:var(--acid);font-weight:900}.wwe5-top{position:sticky;top:-18px;z-index:20;background:#0a0b0cf3;backdrop-filter:blur(14px);padding:18px 0 12px;border-bottom:1px solid #202226}.wwe5-head{display:flex;align-items:end;justify-content:space-between;gap:16px}.wwe5-head h1{margin:4px 0 0;font-size:30px;line-height:.95;letter-spacing:-.04em}.wwe5-meta{font:9px ui-monospace,monospace;color:#747982}.wwe5-searchrow{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:12px}.wwe5-search{width:100%;background:#111316;color:#fff;border:1px solid #383c43;border-radius:10px;padding:11px 13px}.wwe5-reset,.wwe5-chip,.wwe5-tab,.wwe5-mini,.wwe5-btn{border:1px solid #383c42;background:#15171a;color:#e8e9e5;cursor:pointer}.wwe5-reset{border-radius:10px;padding:0 12px;font-size:9px}.wwe5-quick{display:flex;gap:6px;align-items:center;overflow-x:auto;padding:9px 0 2px;scrollbar-width:none}.wwe5-quick::-webkit-scrollbar{display:none}.wwe5-quicklabel{font-size:8px;color:#666c74;letter-spacing:.12em;white-space:nowrap}.wwe5-chip,.wwe5-tab{border-radius:999px;padding:6px 9px;font-size:8px;white-space:nowrap}.wwe5-chip.on,.wwe5-tab.on,.wwe5-mini.primary,.wwe5-btn.primary{background:var(--acid);border-color:var(--acid);color:#111;font-weight:900}.wwe5-filters{display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));gap:7px;margin-top:9px}.wwe5-filter{display:grid;gap:4px}.wwe5-filter label{font-size:7px;color:#666c74;letter-spacing:.1em}.wwe5-filter select{width:100%;background:#111316;color:#eaeae5;border:1px solid #30343a;border-radius:8px;padding:7px 8px;font-size:9px}.wwe5-state{display:flex;align-items:center;gap:6px;margin-top:9px}.wwe5-spacer{flex:1}.wwe5-mini{border-radius:7px;padding:7px 9px;font-size:8px}.wwe5-stats{display:flex;gap:9px;margin:12px 0 9px;font:8px ui-monospace,monospace;color:#70757d}.wwe5-stats b{color:#e8e9e5}
.wwe5-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:10px;align-items:start}.wwelib-card{height:214px!important;min-height:214px!important;max-height:214px!important;display:flex!important;flex-direction:column!important;position:relative!important;overflow:hidden!important;border:1px solid #292c31!important;background:#111214!important;border-radius:11px!important;cursor:pointer!important;min-width:0!important}.wwelib-card:hover{border-color:#565b64!important;transform:translateY(-2px)}.wwelib-card.is-selected{border-color:var(--acid)!important;box-shadow:0 0 0 1px #efff3524!important}.wwelib-media{position:relative!important;display:block!important;flex:0 0 106px!important;width:100%!important;height:106px!important;min-height:106px!important;max-height:106px!important;overflow:hidden!important;background:#050505!important}.wwelib-img{position:absolute!important;inset:0!important;display:block!important;width:100%!important;height:106px!important;min-width:100%!important;max-width:100%!important;min-height:106px!important;max-height:106px!important;object-fit:cover!important;object-position:center!important;margin:0!important;padding:0!important;border:0!important}.wwelib-noimg{position:absolute;inset:0;display:grid;place-items:center;color:#555;font-size:8px}.wwelib-add{position:absolute!important;z-index:5!important;right:7px!important;top:7px!important;width:28px!important;height:28px!important;border-radius:50%!important;border:1px solid #ffffff45!important;background:#08090acc!important;color:#fff!important;cursor:pointer!important;font-weight:900!important}.wwelib-card.is-selected .wwelib-add{background:var(--acid)!important;border-color:var(--acid)!important;color:#111!important}.wwelib-use{position:absolute;z-index:4;left:7px;top:7px;background:#08090acc;border:1px solid #ffffff2b;color:#ddd;border-radius:999px;padding:4px 6px;font-size:7px}.wwelib-use.fresh{color:var(--acid);border-color:#a8b62d80}.wwelib-body{height:108px!important;min-height:108px!important;max-height:108px!important;overflow:hidden!important;padding:9px!important;display:flex!important;flex-direction:column!important}.wwelib-name{font-size:11px!important;font-weight:900!important;line-height:1.28!important;height:29px!important;overflow:hidden!important;display:-webkit-box!important;-webkit-line-clamp:2!important;-webkit-box-orient:vertical!important}.wwelib-cat{font-size:7px!important;color:#70757d!important;margin-top:5px!important;height:11px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}.wwelib-badges{display:flex!important;gap:4px!important;flex-wrap:wrap!important;margin-top:auto!important;padding-top:7px!important;height:25px!important;overflow:hidden!important}.wwelib-badge{font-size:6px!important;line-height:1!important;border:1px solid #35383e!important;color:#8c9199!important;border-radius:999px!important;padding:4px 5px!important;white-space:nowrap!important}.wwe5-empty{padding:30px 18px;border:1px dashed #383b41;border-radius:12px;text-align:center;color:#70757e;font-size:10px;grid-column:1/-1}
.wwe5-editorhead{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:12px}.wwe5-editorhead h2{font-size:26px;line-height:.96;letter-spacing:-.04em;margin:4px 0 0}.wwe5-count{font:8px ui-monospace,monospace;color:#7b8088}.wwe5-panel{border:1px solid var(--line);background:var(--panel);border-radius:11px;padding:12px;margin-bottom:10px}.wwe5-paneltitle{font-size:8px;letter-spacing:.13em;color:var(--acid);font-weight:900;margin-bottom:9px}.wwe5-grid2{display:grid;grid-template-columns:88px 1fr;gap:8px}.wwe5-field{display:grid;gap:4px;margin-bottom:7px}.wwe5-field label{font-size:7px;letter-spacing:.09em;color:#737880}.wwe5-field input,.wwe5-field textarea,.wwe5-field select{width:100%;background:#0d0e10;color:#fff;border:1px solid #33363c;border-radius:7px;padding:8px;font-size:9px}.wwe5-field textarea{min-height:50px;resize:vertical;line-height:1.5}.wwe5-toolbar{display:flex;gap:6px;flex-wrap:wrap}.wwe5-btn{border-radius:7px;padding:8px 10px;font-size:8px}.wwe5-btn.danger{color:#ffb9b9}.wwe5-saved{display:grid;grid-template-columns:1fr auto;gap:6px}.wwe5-selected{display:grid;gap:7px;max-height:38vh;overflow:auto}.wwe5-selrow{display:grid;grid-template-columns:18px 72px minmax(0,1fr) auto;gap:7px;align-items:center;border:1px solid #2b2e33;background:#121417;border-radius:9px;padding:7px}.wwe5-grab{cursor:grab;text-align:center;color:#6f747d;font-size:16px}.wwe5-selimg{display:block!important;width:72px!important;height:46px!important;min-width:72px!important;max-width:72px!important;min-height:46px!important;max-height:46px!important;object-fit:cover!important;border-radius:5px!important;margin:0!important}.wwe5-selname{font-size:9px;font-weight:850;line-height:1.25;margin-bottom:4px}.wwe5-comment{width:100%;min-height:42px;background:#0b0c0e;color:#fff;border:1px solid #33363c;border-radius:6px;padding:6px;resize:vertical;font-size:8px}.wwe5-rowactions{display:flex;flex-direction:column;gap:4px}.wwe5-rowactions .wwe5-mini{padding:5px 6px;font-size:7px;white-space:nowrap}.wwe5-rowactions .pick.on{background:var(--acid);border-color:var(--acid);color:#111}.wwe5-previewhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}.wwe5-previewactions{display:flex;gap:4px;flex-wrap:wrap}.wwe5-framewrap{height:220px;border:1px solid #34373d;border-radius:8px;overflow:hidden;background:#fff}.wwe5-frame{width:100%;height:100%;border:0}.wwe5-status{font-size:8px;color:#797e86;min-height:13px;margin-top:6px}.wwe5-note{font-size:7px;color:#6e737b;line-height:1.55;margin-top:7px}@media(max-width:1250px){.wwe5-app{grid-template-columns:minmax(0,1fr) 390px}.wwe5-grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}.wwe5-filters{grid-template-columns:repeat(3,1fr)}}@media(max-width:860px){.wwe5-app{display:block;height:auto;overflow:visible}.wwe5-library,.wwe5-editor{height:auto;overflow:visible;border-right:0}.wwe5-top{position:relative;top:auto}.wwe5-filters{grid-template-columns:1fr 1fr}.wwe5-grid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}.wwe5-selected{max-height:none}}@media(max-width:520px){.wwe5-library,.wwe5-editor{padding:14px}.wwe5-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.wwe5-searchrow{grid-template-columns:1fr}.wwe5-filters{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="wwe5-app">
<section class="wwe5-library">
<div class="wwe5-top">
<div class="wwe5-head"><div><div class="wwe5-brand">HARF-WAY / WAYS LIBRARY</div><h1>棚から選ぶ</h1></div><div class="wwe5-meta" id="resultCount">読み込み中</div></div>
<div class="wwe5-searchrow"><input class="wwe5-search" id="query" placeholder="作品名 / カテゴリ / タグ / URLで横断検索"><button class="wwe5-reset" id="clearFilters">RESET</button></div>
<div class="wwe5-quick"><span class="wwe5-quicklabel">QUICK INDEX</span><button class="wwe5-chip on" data-quick="all">ALL</button><button class="wwe5-chip" data-quick="unused">未使用</button><button class="wwe5-chip" data-quick="demo">体験版</button><button class="wwe5-chip" data-quick="portrait">縦動画</button><span id="quickCats" style="display:contents"></span></div>
<div class="wwe5-filters"><div class="wwe5-filter"><label>カテゴリ</label><select id="categoryFilter"><option value="">すべて</option></select></div><div class="wwe5-filter"><label>配信先</label><select id="platformFilter"><option value="">すべて</option><option value="steam">Steam</option><option value="itch">itch.io</option><option value="freem">ふりーむ</option><option value="other">その他</option></select></div><div class="wwe5-filter"><label>動画 / 状態</label><select id="mediaFilter"><option value="">すべて</option><option value="landscape">横動画</option><option value="portrait">縦動画</option><option value="demo">体験版</option><option value="sponsored">Sponsored</option></select></div><div class="wwe5-filter"><label>使用履歴</label><select id="usageFilter"><option value="">すべて</option><option value="unused">未使用のみ</option><option value="used">使用済み</option></select></div><div class="wwe5-filter"><label>並び順</label><select id="sortFilter"><option value="ways">WAYS順</option><option value="unused">使用回数が少ない順</option><option value="title">作品名順</option><option value="duration">短い動画順</option></select></div></div>
<div class="wwe5-state" id="stateTabs"><button class="wwe5-tab on" data-state="all">すべて</button><button class="wwe5-tab" data-state="unselected">未選択</button><button class="wwe5-tab" data-state="selected">選択中</button><span class="wwe5-spacer"></span><button class="wwe5-mini primary" id="addVisible">表示中を追加</button></div>
</div>
<div class="wwe5-stats"><span>WAYS <b id="kpiAll">--</b></span><span>未使用 <b id="kpiUnused">--</b></span><span>選択中 <b id="kpiSelected">0</b></span><span>LOCAL HISTORY</span></div>
<div id="games" class="wwe5-grid"><div class="wwe5-empty">WAYSを読み込み中…</div></div>
</section>
<aside class="wwe5-editor">
<div class="wwe5-editorhead"><div><div class="wwe5-brand">CURATION BOARD</div><h2>今週の棚</h2></div><div class="wwe5-count"><span id="count">0</span> SELECTED</div></div>
<section class="wwe5-panel"><div class="wwe5-paneltitle">ISSUE</div><div class="wwe5-grid2"><div class="wwe5-field"><label>VOL.</label><input id="vol" value="001"></div><div class="wwe5-field"><label>今週のテーマ</label><input id="theme" placeholder="例：操作がなんか変なゲーム"></div></div><div class="wwe5-field"><label>導入文</label><textarea id="intro" placeholder="今週の棚をひとことで案内"></textarea></div><div class="wwe5-field"><label>あとがき</label><textarea id="outro" placeholder="総括コメント"></textarea></div><div class="wwe5-toolbar"><button class="wwe5-btn primary" id="saveBtn">号を保存</button><button class="wwe5-btn" id="newBtn">新規</button><button class="wwe5-btn" id="exportBtn">JSON</button></div><div class="wwe5-field" style="margin-top:8px"><label>保存済み</label><div class="wwe5-saved"><select id="savedIssues"><option value="">保存済みなし</option></select><button class="wwe5-mini" id="loadIssue">開く</button></div></div></section>
<section class="wwe5-panel"><div class="wwe5-paneltitle">SELECTED / DRAG TO REORDER</div><div id="selected" class="wwe5-selected"><div class="wwe5-empty">左のカードから作品を選んでください。</div></div><div class="wwe5-toolbar" style="margin-top:8px"><button class="wwe5-btn danger" id="clearSelected">すべて外す</button></div></section>
<section class="wwe5-panel"><div class="wwe5-previewhead"><div class="wwe5-paneltitle" style="margin:0">WORDPRESS PREVIEW</div><div class="wwe5-previewactions"><button class="wwe5-mini primary" id="copyBundle">WP一括コピー</button><button class="wwe5-mini" id="copyHtml">HTML</button><button class="wwe5-mini" id="copyCss">CSS</button></div></div><div class="wwe5-framewrap"><iframe id="previewFrame" class="wwe5-frame"></iframe></div><div class="wwe5-note">小さい確認窓。出力はWordPress用HTML / CSSと同じです。</div></section>
<div class="wwe5-status" id="saveStatus">Preview / ローカル保存方式</div>
</aside>
</div>
<script is:inline>
const API='https://harfway-playback.vercel.app/api/games-live',KEY='harfway_ways_weekly_issues_v2';let items=[],selectedIds=[],comments={},pickId='',dragId='',stateFilter='all',visibleIds=[];const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),norm=s=>String(s??'').toLowerCase().normalize('NFKC');function store(){try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch{return{}}}function issue(){return{vol:$('#vol').value.trim(),theme:$('#theme').value.trim(),intro:$('#intro').value.trim(),outro:$('#outro').value.trim(),selectedIds:[...selectedIds],comments:{...comments},pickId,updatedAt:new Date().toISOString()}}function game(id){return items.find(x=>x.id===id)}function cats(x){return String(x.category||'').split('/').map(v=>v.trim()).filter(Boolean)}function platform(x){const u=String(x.storeUrl||'').toLowerCase();if(u.includes('steampowered.com'))return'steam';if(u.includes('itch.io'))return'itch';if(u.includes('freem.ne.jp'))return'freem';return'other'}function orient(x){return x.videoOrientation||(Number(x.videoHeight)>Number(x.videoWidth)?'portrait':'landscape')}function usage(){const m={};Object.values(store()).forEach(v=>(v?.selectedIds||[]).forEach(id=>m[id]=(m[id]||0)+1));return m}function refreshCats(){const list=[...new Set(items.flatMap(cats))].sort((a,b)=>a.localeCompare(b,'ja')),sel=$('#categoryFilter');sel.innerHTML='<option value="">すべて</option>'+list.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');const count={};items.flatMap(cats).forEach(c=>count[c]=(count[c]||0)+1);$('#quickCats').innerHTML=Object.keys(count).sort((a,b)=>count[b]-count[a]).slice(0,7).map(c=>`<button class="wwe5-chip" data-catquick="${esc(c)}">${esc(c)} ${count[c]}</button>`).join('')}function filtered(){const q=norm($('#query').value),cat=$('#categoryFilter').value,plat=$('#platformFilter').value,media=$('#mediaFilter').value,use=$('#usageFilter').value,u=usage();let list=items.filter(x=>{const chosen=selectedIds.includes(x.id);if(stateFilter==='selected'&&!chosen)return false;if(stateFilter==='unselected'&&chosen)return false;if(q&&!norm([x.title,x.category,(x.tags||[]).join(' '),x.storeUrl].join(' ')).includes(q))return false;if(cat&&!cats(x).includes(cat))return false;if(plat&&platform(x)!==plat)return false;if(media==='portrait'&&orient(x)!=='portrait')return false;if(media==='landscape'&&orient(x)!=='landscape')return false;if(media==='demo'&&!String(x.title||'').includes('体験版'))return false;if(media==='sponsored'&&!x.sponsored)return false;const n=u[x.id]||0;if(use==='unused'&&n!==0)return false;if(use==='used'&&n===0)return false;return true});const sort=$('#sortFilter').value;if(sort==='unused')list.sort((a,b)=>(u[a.id]||0)-(u[b.id]||0));if(sort==='title')list.sort((a,b)=>String(a.title).localeCompare(String(b.title),'ja'));if(sort==='duration')list.sort((a,b)=>(+a.videoDuration||9999)-(+b.videoDuration||9999));return list}function renderGames(){const list=filtered(),u=usage();visibleIds=list.map(x=>x.id);$('#resultCount').textContent=`${list.length} / ${items.length} GAMES`;$('#games').innerHTML=list.map(x=>{const chosen=selectedIds.includes(x.id),n=u[x.id]||0,p=platform(x),img=x.thumbnailUrl?`<img class="wwelib-img" style="position:absolute!important;inset:0!important;width:100%!important;height:106px!important;min-height:106px!important;max-height:106px!important;object-fit:cover!important;display:block!important;margin:0!important" src="${esc(x.thumbnailUrl)}" alt="" loading="lazy">`:'<div class="wwelib-noimg">NO IMAGE</div>';return `<article class="wwelib-card ${chosen?'is-selected':''}" style="height:214px!important;min-height:214px!important;max-height:214px!important;overflow:hidden!important" data-card="${esc(x.id)}"><div class="wwelib-media" style="height:106px!important;min-height:106px!important;max-height:106px!important;overflow:hidden!important;position:relative!important">${img}<span class="wwelib-use ${n===0?'fresh':''}">${n===0?'未使用':`${n}回`}</span><button class="wwelib-add" data-add="${esc(x.id)}">${chosen?'✓':'＋'}</button></div><div class="wwelib-body"><div class="wwelib-name">${esc(x.title)}</div><div class="wwelib-cat">${esc(cats(x).join(' / ')||'未分類')}</div><div class="wwelib-badges"><span class="wwelib-badge">${p==='steam'?'STEAM':p==='itch'?'ITCH':p==='freem'?'ふりーむ':'OTHER'}</span>${orient(x)==='portrait'?'<span class="wwelib-badge">縦</span>':''}${+x.videoDuration?`<span class="wwelib-badge">${Math.round(+x.videoDuration)}s</span>`:''}</div></div></article>`}).join('')||'<div class="wwe5-empty">該当作品なし</div>';renderKpis()}function renderKpis(){const u=usage();$('#kpiAll').textContent=items.length;$('#kpiUnused').textContent=items.filter(x=>(u[x.id]||0)===0).length;$('#kpiSelected').textContent=selectedIds.length;$('#count').textContent=selectedIds.length}function toggle(id){selectedIds=selectedIds.includes(id)?selectedIds.filter(v=>v!==id):[...selectedIds,id];if(pickId&&!selectedIds.includes(pickId))pickId='';renderAll()}function renderSelected(){if(!selectedIds.length){$('#selected').innerHTML='<div class="wwe5-empty">左のカードから作品を選んでください。</div>';return}$('#selected').innerHTML=selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';return `<div class="wwe5-selrow" draggable="true" data-drag="${esc(id)}"><div class="wwe5-grab">⋮</div><img class="wwe5-selimg" src="${esc(x.thumbnailUrl||'')}" alt=""><div><div class="wwe5-selname">${String(i+1).padStart(2,'0')} / ${esc(x.title)}</div><textarea class="wwe5-comment" data-comment="${esc(id)}">${esc(comments[id]||'')}</textarea></div><div class="wwe5-rowactions"><button class="wwe5-mini pick ${pickId===id?'on':''}" data-pick="${esc(id)}">PICK</button><button class="wwe5-mini" data-remove="${esc(id)}">外す</button></div></div>`}).join('')}const wpCSS=`.ways-weekly{max-width:920px;margin:0 auto;color:#141414;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.ways-weekly__kicker{font-size:12px;font-weight:900;letter-spacing:.14em}.ways-weekly__title{font-size:clamp(34px,6vw,62px);font-weight:900;line-height:1.03;margin:10px 0 22px}.ways-weekly__intro,.ways-weekly__outro{font-size:16px;line-height:1.95}.ways-weekly__item{margin:0 0 54px}.ways-weekly__media{position:relative;background:#000;overflow:hidden}.ways-weekly__media video,.ways-weekly__media img{display:block;width:100%!important;height:auto!important}.ways-weekly__num{position:absolute;left:12px;top:12px;background:#111;color:#fff;padding:6px 8px;font-size:11px}.ways-weekly__pick{display:inline-block;margin-top:12px;background:#d9ef23;color:#111;padding:6px 9px;font-size:10px;font-weight:900}.ways-weekly__game-title{font-size:28px;font-weight:900;margin-top:12px}.ways-weekly__comment{font-size:15px;line-height:1.85}.ways-weekly__store{display:inline-block;margin-top:12px;padding:9px 13px;background:#111;color:#fff!important;text-decoration:none!important;font-weight:900}.ways-weekly__more{margin-top:28px}`;function contentHTML(){const d=issue();return `<div class="ways-weekly"><div class="ways-weekly__kicker">WAYS WEEKLY / VOL.${esc(d.vol)}</div><div class="ways-weekly__title">${esc(d.theme||'今週のWAYS')}</div>${d.intro?`<p class="ways-weekly__intro">${esc(d.intro).replace(/\n/g,'<br>')}</p>`:''}${d.selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';return `<section class="ways-weekly__item"><div class="ways-weekly__media"><video controls muted playsinline preload="metadata" poster="${esc(x.thumbnailUrl||'')}" src="${esc(x.video||'')}"></video><span class="ways-weekly__num">${String(i+1).padStart(2,'0')}</span></div>${d.pickId===id?'<div class="ways-weekly__pick">EDITOR\'S PICK</div>':''}<div class="ways-weekly__game-title">${esc(x.title)}</div>${d.comments[id]?`<p class="ways-weekly__comment">${esc(d.comments[id]).replace(/\n/g,'<br>')}</p>`:''}${x.storeUrl?`<a class="ways-weekly__store" href="${esc(x.storeUrl)}" target="_blank" rel="noopener">ゲームを見る ↗</a>`:''}</section>`}).join('')}${d.outro?`<p class="ways-weekly__outro">${esc(d.outro).replace(/\n/g,'<br>')}</p>`:''}<p class="ways-weekly__more"><a href="https://harfway-playback.vercel.app/">もっとWAYSを掘る →</a></p></div>`}function renderPreview(){$('#previewFrame').srcdoc=`<!doctype html><style>body{margin:0;padding:18px 14px;background:#fff;color:#111}${wpCSS}</style>${contentHTML()}`}function refreshSaved(){const a=store(),s=$('#savedIssues'),keys=Object.keys(a).sort().reverse();s.innerHTML=keys.length?'<option value="">保存済みを選択</option>'+keys.map(k=>`<option value="${esc(k)}">VOL.${esc(k)} / ${esc(a[k]?.theme||'無題')}</option>`).join(''):'<option value="">保存済みなし</option>'}function renderAll(){renderGames();renderSelected();renderPreview();refreshSaved()}function status(t){$('#saveStatus').textContent=t;setTimeout(()=>$('#saveStatus').textContent='Preview / ローカル保存方式',1800)}function clearFilters(){stateFilter='all';$('#query').value='';$('#categoryFilter').value='';$('#platformFilter').value='';$('#mediaFilter').value='';$('#usageFilter').value='';$('#sortFilter').value='ways';document.querySelectorAll('[data-state]').forEach(b=>b.classList.toggle('on',b.dataset.state==='all'));document.querySelectorAll('.wwe5-chip').forEach(b=>b.classList.remove('on'));document.querySelector('[data-quick="all"]')?.classList.add('on');renderGames()}$('#games').onclick=e=>{const b=e.target.closest('[data-add]'),c=e.target.closest('[data-card]');if(b){e.stopPropagation();toggle(b.dataset.add)}else if(c)toggle(c.dataset.card)};$('#stateTabs').onclick=e=>{const b=e.target.closest('[data-state]');if(!b)return;stateFilter=b.dataset.state;document.querySelectorAll('[data-state]').forEach(x=>x.classList.toggle('on',x===b));renderGames()};$('.wwe5-quick').onclick=e=>{const q=e.target.closest('[data-quick]'),c=e.target.closest('[data-catquick]');if(q){clearFilters();document.querySelectorAll('.wwe5-chip').forEach(x=>x.classList.remove('on'));q.classList.add('on');if(q.dataset.quick==='unused')$('#usageFilter').value='unused';if(q.dataset.quick==='demo')$('#mediaFilter').value='demo';if(q.dataset.quick==='portrait')$('#mediaFilter').value='portrait';renderGames()}else if(c){$('#categoryFilter').value=c.dataset.catquick;renderGames()}};['query','categoryFilter','platformFilter','mediaFilter','usageFilter','sortFilter'].forEach(id=>$('#'+id).addEventListener(id==='query'?'input':'change',renderGames));$('#clearFilters').onclick=clearFilters;$('#addVisible').onclick=()=>{selectedIds=[...new Set([...selectedIds,...visibleIds])];renderAll()};$('#selected').oninput=e=>{const t=e.target.closest('[data-comment]');if(t){comments[t.dataset.comment]=t.value;renderPreview()}};$('#selected').onclick=e=>{const r=e.target.closest('[data-remove]');if(r){selectedIds=selectedIds.filter(id=>id!==r.dataset.remove);renderAll();return}const p=e.target.closest('[data-pick]');if(p){pickId=pickId===p.dataset.pick?'':p.dataset.pick;renderAll()}};$('#selected').addEventListener('dragstart',e=>{const x=e.target.closest('[data-drag]');if(x)dragId=x.dataset.drag});$('#selected').addEventListener('dragover',e=>e.preventDefault());$('#selected').addEventListener('drop',e=>{e.preventDefault();const x=e.target.closest('[data-drag]');if(!x||!dragId||x.dataset.drag===dragId)return;const a=selectedIds.indexOf(dragId),b=selectedIds.indexOf(x.dataset.drag);selectedIds.splice(a,1);selectedIds.splice(b,0,dragId);renderAll()});['vol','theme','intro','outro'].forEach(id=>$('#'+id).addEventListener('input',renderPreview));$('#saveBtn').onclick=()=>{const a=store(),d=issue();a[d.vol||'draft']=d;localStorage.setItem(KEY,JSON.stringify(a));renderAll();status('保存しました')};$('#newBtn').onclick=()=>{selectedIds=[];comments={};pickId='';$('#theme').value='';$('#intro').value='';$('#outro').value='';renderAll()};$('#loadIssue').onclick=()=>{const d=store()[$('#savedIssues').value];if(!d)return;$('#vol').value=d.vol||'';$('#theme').value=d.theme||'';$('#intro').value=d.intro||'';$('#outro').value=d.outro||'';selectedIds=d.selectedIds||[];comments=d.comments||{};pickId=d.pickId||'';renderAll()};$('#clearSelected').onclick=()=>{selectedIds=[];comments={};pickId='';renderAll()};async function copy(t,m){await navigator.clipboard.writeText(t);status(m)}$('#copyBundle').onclick=()=>copy(`<style>${wpCSS}</style>${contentHTML()}`,'WP一括コピーしました');$('#copyHtml').onclick=()=>copy(contentHTML(),'HTMLコピーしました');$('#copyCss').onclick=()=>copy(wpCSS,'CSSコピーしました');$('#exportBtn').onclick=()=>{const b=new Blob([JSON.stringify(issue(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=`ways-weekly-${issue().vol||'draft'}.json`;a.click()};fetch(API,{cache:'no-store'}).then(r=>r.json()).then(d=>{items=(d.entries||[]).filter(x=>x.video);refreshCats();renderAll()}).catch(()=>$('#games').innerHTML='<div class="wwe5-empty">WAYSの読み込みに失敗しました。</div>');
</script>
