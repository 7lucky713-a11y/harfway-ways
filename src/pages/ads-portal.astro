---
const portalSrc = '/api/ads-portal-proxy?path=%2F';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>HARF-WAY ADS｜広告主ポータル</title>
    <style>
      html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#f4f1e9}
      iframe{display:block;width:100%;height:100%;border:0;background:#f4f1e9}
      .fallback{position:fixed;inset:0;display:grid;place-items:center;font:700 14px/1.6 system-ui,sans-serif;color:#222;pointer-events:none}
    </style>
  </head>
  <body>
    <div class="fallback">HARF-WAY ADS を読み込み中…</div>
    <iframe src={portalSrc} title="HARF-WAY ADS 広告主ポータル" referrerpolicy="same-origin"></iframe>
  </body>
</html>
