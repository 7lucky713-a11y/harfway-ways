<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>WAYS WEEKLY EDITOR v8</title>
<style>html,body{margin:0;background:#090a0c;color:#fff;font-family:system-ui,-apple-system,"Noto Sans JP",sans-serif}.loading{height:100vh;display:grid;place-items:center;color:#8f98a5;font-size:13px}</style>
</head>
<body>
<div class="loading">WAYS WEEKLY EDITOR を読み込み中…</div>
<script is:inline>
(async()=>{
  const html=await fetch('/weekly-editor-v7/',{cache:'no-store'}).then(r=>r.text());
  const overrides=`<style is:global>
  .kicker{font-size:10px!important}.meta{font-size:9px!important}.search{font-size:12px!important}.reset{font-size:9px!important}.quicklabel{font-size:8px!important}.chip,.tab{font-size:9px!important;padding:7px 10px!important}.filter label,.field label{font-size:8px!important}.filter select{font-size:10px!important;height:35px!important}.mini{font-size:9px!important}.stat{font-size:8px!important;padding:6px 8px!important}.game-card{height:232px!important}.media{flex-basis:110px!important;height:110px!important}.body{height:122px!important;padding:11px!important}.name{font-size:13px!important;line-height:1.34!important;height:36px!important}.cat{font-size:9px!important;height:15px!important;margin-top:6px!important}.badges{height:29px!important;padding-top:7px!important}.badge{font-size:7px!important;min-height:18px!important;padding:4px 6px!important}.use{font-size:8px!important;padding:5px 7px!important}.paneltitle{font-size:9px!important}.field input,.field select{font-size:10px!important;height:37px!important}.field textarea{font-size:10px!important;min-height:58px!important}.btn{font-size:9px!important;padding:9px 11px!important}.selname{font-size:10px!important}.comment{font-size:9px!important}.rowactions .mini{font-size:8px!important}.note,.status{font-size:8px!important}.empty{font-size:11px!important}
  @media(max-width:520px){.name{font-size:12px!important}.cat{font-size:8px!important}.filter label,.field label{font-size:8px!important}}
  </style>`;
  const out=html.replace('<title>WAYS WEEKLY EDITOR v7</title>','<title>WAYS WEEKLY EDITOR v8</title>').replace('</head>',overrides+'</head>');
  document.open();document.write(out);document.close();
})();
</script>
</body>
</html>