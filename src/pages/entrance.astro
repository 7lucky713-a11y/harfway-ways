---
const doors = [
  {
    eyebrow: 'WATCH / RANDOM',
    title: '動画から出会う',
    name: 'WAYS',
    copy: '短い動画をザッピング。何を見るか決めずに、偶然からゲームに出会う。',
    href: 'https://harfway-playback.vercel.app/',
    tone: 'video',
    icon: '▶'
  },
  {
    eyebrow: 'THEME / CURATION',
    title: 'テーマから選ぶ',
    name: 'PLAYLIST',
    copy: 'ひとつのテーマから、いくつものゲームへ。編集された棚をめくるように探す。',
    href: 'https://harfway-playlist-tv.vercel.app/',
    tone: 'playlist',
    icon: '◎'
  },
  {
    eyebrow: 'NOTES / FRAGMENTS',
    title: '断片からたどる',
    name: 'SCRAPS',
    copy: '短い感想、動画、あとから残った記録。ひとつの断片から、気になったゲームをたどる。',
    href: 'https://harf-way-game-scrapbook.vercel.app/',
    tone: 'scraps',
    icon: '✂'
  }
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HARF-WAY ENTRANCE</title>
    <meta name="description" content="HARF-WAYの公開コンテンツを、気分から選ぶための入口。" />
    <style>
      :root {
        --ink: #161616;
        --paper: #f3efe5;
        --line: rgba(22,22,22,.2);
        --muted: #716d64;
        --acid: #f0ff57;
        --red: #ff684f;
        --blue: #91b9ff;
      }
      * { box-sizing: border-box; }
      html { background: var(--paper); scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background:
          linear-gradient(rgba(22,22,22,.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(22,22,22,.035) 1px, transparent 1px),
          var(--paper);
        background-size: 32px 32px;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1440px, calc(100% - 32px)); margin: 0 auto; }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 74px;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
        letter-spacing: .08em;
      }
      .brand { font-weight: 900; font-size: 14px; }
      .brand span { font-weight: 500; color: var(--muted); margin-left: 8px; }
      .back { border-bottom: 1px solid currentColor; }
      .hero {
        padding: clamp(56px, 8vw, 118px) 0 42px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 24px;
        align-items: end;
      }
      .kicker {
        font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .18em;
        margin-bottom: 20px;
      }
      h1 {
        margin: 0;
        max-width: 1050px;
        font-size: clamp(48px, 8.4vw, 132px);
        line-height: .88;
        letter-spacing: -.075em;
        font-weight: 950;
      }
      h1 em { font-style: normal; background: var(--acid); padding: 0 .08em .06em; }
      .hero-note {
        width: 235px;
        font-size: 13px;
        line-height: 1.75;
        color: var(--muted);
        padding-bottom: 8px;
      }
      .section-label {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 44px 0 16px;
        font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .13em;
      }
      .section-label::after { content: ''; height: 1px; background: var(--line); flex: 1; }
      .doors { display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; }
      .door {
        position: relative;
        grid-column: span 4;
        min-height: 490px;
        padding: 24px;
        border: 1.5px solid var(--ink);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform .22s ease, box-shadow .22s ease;
      }
      .door:hover { transform: translateY(-7px) rotate(-.25deg); box-shadow: 10px 10px 0 var(--ink); }
      .door:nth-child(2):hover { transform: translateY(-7px) rotate(.25deg); }
      .door.video { background: #171717; color: white; }
      .door.playlist { background: var(--red); }
      .door.scraps { background: var(--blue); }
      .door-top { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; }
      .door .eyebrow { font: 700 10px/1 ui-monospace, monospace; letter-spacing: .14em; opacity: .72; }
      .icon { font-size: 30px; line-height: 1; }
      .visual {
        position: absolute;
        inset: 72px 24px 148px;
        display:flex;
        align-items:center;
        justify-content:center;
        pointer-events:none;
      }
      .screen {
        width: 100%;
        aspect-ratio: 16/10;
        border: 1px solid rgba(255,255,255,.55);
        background: repeating-linear-gradient(0deg, #111 0 6px, #222 7px 8px);
        box-shadow: inset 0 0 50px #000;
        position:relative;
      }
      .screen::after {
        content:'RANDOM PLAY';
        position:absolute;
        left:14px;
        bottom:12px;
        font:700 9px/1 monospace;
        letter-spacing:.13em;
      }
      .record {
        width:min(240px, 72%);
        aspect-ratio:1;
        border-radius:50%;
        background: repeating-radial-gradient(circle, #191919 0 8px, #282828 9px 10px);
        display:grid;
        place-items:center;
        animation: spin 12s linear infinite;
        box-shadow: 0 18px 35px rgba(0,0,0,.24);
      }
      .record::before {
        content:'PLAY';
        display:grid;
        place-items:center;
        width:34%;
        aspect-ratio:1;
        border-radius:50%;
        background:var(--paper);
        font:900 12px/1 monospace;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .paper-stack { width: 78%; height: 72%; position: relative; }
      .paper-stack span {
        position:absolute;
        inset: 8% 7%;
        border:2px solid var(--ink);
        background:var(--paper);
        box-shadow:7px 7px 0 var(--ink);
      }
      .paper-stack span:nth-child(1) { transform:rotate(-8deg) translate(-10px, 8px); }
      .paper-stack span:nth-child(2) { transform:rotate(6deg) translate(12px, -3px); }
      .paper-stack span:nth-child(3) { transform:rotate(-1deg); padding:22px 18px; }
      .paper-stack span:nth-child(3)::before {
        content:'PLAY / NOTE / MEMORY';
        display:block;
        font:900 10px/1 monospace;
        letter-spacing:.08em;
        border-bottom:2px solid var(--ink);
        padding-bottom:12px;
      }
      .paper-stack span:nth-child(3)::after {
        content:'短い記録から、もう一度ゲームへ。';
        display:block;
        margin-top:16px;
        font-size:13px;
        line-height:1.5;
        font-weight:800;
      }
      .door-copy { position:relative; z-index:2; }
      .door h2 { margin:0 0 6px; font-size: clamp(31px, 3.2vw, 52px); letter-spacing:-.055em; line-height:.95; }
      .door-name { font:800 12px/1 monospace; letter-spacing:.14em; margin-bottom:14px; }
      .door p { margin:0; max-width:34em; font-size:13px; line-height:1.7; opacity:.8; }
      .note-strip {
        margin: 66px 0 18px;
        padding: 19px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:24px;
      }
      .note-strip strong { font-size:13px; letter-spacing:-.01em; }
      .note-strip span { color:var(--muted); font-size:11px; line-height:1.6; text-align:right; }
      .manifesto {
        margin: 44px 0 36px;
        padding: 48px 0;
        display:grid;
        grid-template-columns: 1fr 2fr;
        gap:32px;
      }
      .manifesto small { font:700 10px/1 monospace; letter-spacing:.14em; }
      .manifesto p { margin:0; font-size:clamp(22px,3vw,43px); line-height:1.35; letter-spacing:-.04em; font-weight:800; }
      footer {
        border-top:1px solid var(--line);
        min-height:100px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        color:var(--muted);
        font-size:11px;
      }
      @media (max-width: 900px) {
        .hero { grid-template-columns:1fr; }
        .hero-note { width:auto; max-width:500px; }
        .door { grid-column:span 12; min-height:420px; }
        .manifesto { grid-template-columns:1fr; }
      }
      @media (max-width: 560px) {
        .wrap { width:min(100% - 20px, 1440px); }
        header { min-height:60px; }
        .brand span { display:none; }
        .hero { padding-top:42px; }
        h1 { font-size:clamp(45px,16vw,74px); }
        .doors { gap:9px; }
        .door { padding:18px; min-height:380px; }
        .visual { inset:64px 18px 138px; }
        .note-strip { align-items:flex-start; flex-direction:column; }
        .note-strip span { text-align:left; }
        footer { align-items:flex-start; flex-direction:column; justify-content:center; gap:8px; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { scroll-behavior:auto !important; }
        .record { animation:none; }
        .door { transition:none; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="https://harf-way.com/">HARF-WAY <span>/ ENTRANCE</span></a>
        <a class="back" href="https://harf-way.com/">HARF-WAY.COM ↗</a>
      </header>

      <main>
        <section class="hero">
          <div>
            <div class="kicker">THREE WAYS TO FIND THE NEXT GAME</div>
            <h1>今日は、どこから<br/><em>ゲームに出会う？</em></h1>
          </div>
          <p class="hero-note">いまは、HARF-WAYの中でも広告配信に対応している3つの公開コンテンツを入口にしています。</p>
        </section>

        <div class="section-label">CHOOSE AN ENTRANCE / 01</div>
        <section class="doors" aria-label="公開コンテンツへの入口">
          {doors.map((door) => (
            <a class={`door ${door.tone}`} href={door.href} target="_blank" rel="noreferrer">
              <div class="door-top">
                <span class="eyebrow">{door.eyebrow}</span>
                <span class="icon">{door.icon}</span>
              </div>

              <div class="visual" aria-hidden="true">
                {door.tone === 'video' && <div class="screen"></div>}
                {door.tone === 'playlist' && <div class="record"></div>}
                {door.tone === 'scraps' && <div class="paper-stack"><span></span><span></span><span></span></div>}
              </div>

              <div class="door-copy">
                <h2>{door.title}</h2>
                <div class="door-name">{door.name} ↗</div>
                <p>{door.copy}</p>
              </div>
            </a>
          ))}
        </section>

        <div class="note-strip">
          <strong>WAYS / PLAYLIST / SCRAPS</strong>
          <span>この3つを、読者の入口と広告の配信面を兼ねる<br/>HARF-WAYの公開コンテンツ群として育てていきます。</span>
        </div>

        <section class="manifesto">
          <small>ABOUT THIS PLACE</small>
          <p>見る、選ぶ、たどる。同じゲームでも、入口が変われば出会い方も変わる。</p>
        </section>
      </main>

      <footer>
        <span>HARF-WAY / GAMES, NOTES & DETOURS</span>
        <span>ENTRANCE — 2026</span>
      </footer>
    </div>
  </body>
</html>
