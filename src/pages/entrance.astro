---
const doors = [
  {
    index: '01',
    label: 'WATCH',
    title: 'WAYS',
    jp: '動画から探す',
    copy: '短い動画を眺めながら、偶然の一本に出会う。',
    href: '/',
  },
  {
    index: '02',
    label: 'CURATION',
    title: 'PLAYLIST',
    jp: 'テーマから探す',
    copy: 'ひとつのテーマを入口に、編集されたゲームの棚をめくる。',
    href: 'https://harfway-playlist-tv.vercel.app/',
  },
  {
    index: '03',
    label: 'NOTES',
    title: 'SCRAPS',
    jp: '断片から探す',
    copy: '短い感想や記録を手がかりに、過去のゲームを掘り起こす。',
    href: 'https://harf-way-game-scrapbook.vercel.app/',
  },
  {
    index: '04',
    label: 'PRICE',
    title: 'SALE WATCH',
    jp: 'セールから探す',
    copy: 'HARF-WAYで紹介したゲームの、いまのSteamセールを眺める。',
    href: '/sales',
  },
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="HARF-WAYのゲーム発見コンテンツへの入口。" />
  <title>HARF-WAY / ENTRANCE</title>
  <style>
    :root{--bg:#f4f1e9;--ink:#171717;--muted:#78756f;--line:#cbc7bc;--accent:#eaff35}
    *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;color:var(--ink);background:var(--bg);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Hiragino Sans","Yu Gothic",sans-serif}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    header{height:64px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;font-size:10px;letter-spacing:.1em}.brand{font-weight:950}.back{color:var(--muted)}
    .hero{padding:88px 0 56px;max-width:820px}.kicker{font:800 9px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.18em;color:var(--muted);margin-bottom:20px}.hero h1{margin:0;font-size:clamp(42px,6.6vw,82px);line-height:1.02;letter-spacing:-.06em;font-weight:900}.hero p{margin:24px 0 0;max-width:560px;font-size:13px;line-height:1.9;color:var(--muted)}
    .home{display:grid;grid-template-columns:72px minmax(170px,.8fr) minmax(200px,1.15fr) 28px;gap:24px;align-items:center;min-height:124px;margin-bottom:34px;padding:0 18px;background:var(--ink);color:var(--bg);transition:transform .15s ease}.home:hover{transform:translateY(-2px)}.home .num{color:#aaa}.home .name small{color:#aaa}.home .desc span{color:#c7c3ba}.home .badge{display:inline-block;background:var(--accent);color:var(--ink);padding:4px 7px;font:900 8px/1 ui-monospace,monospace;letter-spacing:.08em;margin-left:8px;vertical-align:middle}
    .section-title{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:12px;color:var(--muted);font:800 9px/1 ui-monospace,monospace;letter-spacing:.14em}.section-title:after{content:"";height:1px;background:var(--line);flex:1}
    .list{border-top:1px solid var(--line)}.door{display:grid;grid-template-columns:72px minmax(170px,.8fr) minmax(200px,1.15fr) 28px;gap:24px;align-items:center;min-height:144px;border-bottom:1px solid var(--line);transition:background .15s ease,padding .15s ease}.door:hover{background:#ebe7dc;padding-left:14px;padding-right:14px}.num{font:700 10px/1 ui-monospace,monospace;color:var(--muted)}.name small{display:block;font:800 8px/1 ui-monospace,monospace;letter-spacing:.18em;color:var(--muted);margin-bottom:9px}.name strong{font-size:clamp(28px,4vw,48px);letter-spacing:-.045em;line-height:1}.desc b{display:block;font-size:13px;margin-bottom:8px}.desc span{display:block;color:var(--muted);font-size:11px;line-height:1.75;max-width:470px}.arrow{font-size:20px;text-align:right}.door:hover .arrow{transform:translateX(3px)}
    .note{margin:74px 0 44px;padding-top:20px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:30px;color:var(--muted);font-size:10px;line-height:1.7}.note b{color:var(--ink);font-weight:800}.admark{display:inline-block;background:var(--accent);color:var(--ink);padding:3px 6px;font:900 8px/1 ui-monospace,monospace;letter-spacing:.08em;margin-right:8px}
    footer{height:84px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:9px;letter-spacing:.08em}
    @media(max-width:720px){.wrap{width:calc(100% - 24px)}header{height:56px}.hero{padding:58px 0 42px}.hero h1{font-size:clamp(40px,12vw,64px)}.home,.door{grid-template-columns:38px 1fr 22px;gap:12px;padding:22px 0;min-height:0}.home{padding:22px 12px;margin-bottom:28px}.home .desc,.door .desc{grid-column:2/4}.name strong{font-size:31px}.door:hover{padding-left:8px;padding-right:8px}.note{display:block}.note div+div{margin-top:10px}footer{height:72px;display:block;padding:20px 0}footer span{display:block;margin-bottom:5px}}
    @media(prefers-reduced-motion:reduce){.door,.home{transition:none}}
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <a class="brand" href="https://harf-way.com/">HARF-WAY / ENTRANCE</a>
      <a class="back" href="https://harf-way.com/">HARF-WAY.COM ↗</a>
    </header>

    <main>
      <section class="hero">
        <div class="kicker">GAME DISCOVERY / HARF-WAY</div>
        <h1>今日は、どこから<br />ゲームを見つける？</h1>
        <p>HARF-WAY本体と、動画・テーマ・短い記録・セールの4つの入口からゲームを探せます。</p>
      </section>

      <a class="home" href="https://harf-way.com/">
        <div class="num">00</div>
        <div class="name"><small>MAIN SITE</small><strong>HARF-WAY</strong><span class="badge">HOME</span></div>
        <div class="desc"><b>本体サイトを見る</b><span>記事、週刊コンテンツ、日々の更新。HARF-WAYの母艦はこちら。</span></div>
        <div class="arrow">→</div>
      </a>

      <div class="section-title">DISCOVERY ENTRANCES / AD READY</div>
      <section class="list" aria-label="HARF-WAYの公開コンテンツ">
        {doors.map((door) => (
          <a class="door" href={door.href} target={door.href.startsWith('http') ? '_blank' : undefined} rel={door.href.startsWith('http') ? 'noreferrer' : undefined}>
            <div class="num">{door.index}</div>
            <div class="name"><small>{door.label}</small><strong>{door.title}</strong></div>
            <div class="desc"><b>{door.jp}</b><span>{door.copy}</span></div>
            <div class="arrow">→</div>
          </a>
        ))}
      </section>

      <section class="note">
        <div><span class="admark">AD READY</span><b>WAYS / PLAYLIST / SCRAPS / SALE WATCH は広告配信対応済みです。</b></div>
        <div>HARF-WAY本体は、この4つとは別のメインサイトとして配置しています。</div>
      </section>
    </main>

    <footer>
      <span>HARF-WAY / GAME DISCOVERY</span>
      <span>HOME · WAYS · PLAYLIST · SCRAPS · SALE WATCH</span>
    </footer>
  </div>
</body>
</html>
