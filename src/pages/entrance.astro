---
const doors = [
  {
    eyebrow: 'WATCH / RANDOM',
    title: '眺める',
    name: 'WAYS',
    copy: '短い動画をザッピング。何を見るか決めずに、偶然からゲームに出会う。',
    href: 'https://harfway-playback.vercel.app/',
    tone: 'video',
    icon: '▶'
  },
  {
    eyebrow: 'THEME / CURATION',
    title: '選んでもらう',
    name: 'PLAYLIST',
    copy: 'ひとつのテーマから、いくつものゲームへ。編集された棚をめくるように探す。',
    href: 'https://harfway-playlist-tv.vercel.app/',
    tone: 'playlist',
    icon: '◎'
  },
  {
    eyebrow: 'WALK / STREET',
    title: '寄り道する',
    name: 'ヨリミチストリート',
    copy: '喫茶店、夜ふかし、菓子屋。ジャンルではなく、店と気分からゲームを見つける。',
    href: 'https://harf-way.com/yorimichi/',
    tone: 'street',
    icon: '↗'
  }
];

const shelves = [
  {
    title: '切れ端を読む',
    label: 'SCRAPS',
    copy: '短い感想、記録、あとから残った断片。',
    href: 'https://harf-way-game-scrapbook.vercel.app/'
  },
  {
    title: '持ち込みを見る',
    label: 'SHOWCASE',
    copy: '作り手から届いた「いま見てほしい30秒」。',
    href: 'https://harfway-showcase-ui-v4.vercel.app/'
  },
  {
    title: '一本だけ選ぶ',
    label: 'TONIGHT',
    copy: '今夜の気分に、一本だけ。',
    href: 'https://harf-way.com/tonight/'
  },
  {
    title: '文章から探す',
    label: 'ARTICLES',
    copy: 'レビューではなく、遊んだあとに残った話。',
    href: 'https://harf-way.com/'
  }
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HARF-WAY ENTRANCE</title>
    <meta name="description" content="HARF-WAYの公開コンテンツを、気分から選ぶための入口。" />
    <style>
      :root {
        --ink: #161616;
        --paper: #f3efe5;
        --line: rgba(22,22,22,.2);
        --muted: #716d64;
        --acid: #f0ff57;
        --red: #ff684f;
        --blue: #91b9ff;
      }
      * { box-sizing: border-box; }
      html { background: var(--paper); scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background:
          linear-gradient(rgba(22,22,22,.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(22,22,22,.035) 1px, transparent 1px),
          var(--paper);
        background-size: 32px 32px;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
      }
      a { color: inherit; text-decoration: none; }
      .wrap { width: min(1440px, calc(100% - 32px)); margin: 0 auto; }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 74px;
        border-bottom: 1px solid var(--line);
        font-size: 12px;
        letter-spacing: .08em;
      }
      .brand { font-weight: 900; font-size: 14px; }
      .brand span { font-weight: 500; color: var(--muted); margin-left: 8px; }
      .back { border-bottom: 1px solid currentColor; }
      .hero {
        padding: clamp(56px, 8vw, 120px) 0 44px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 24px;
        align-items: end;
      }
      .kicker { font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .18em; margin-bottom: 20px; }
      h1 {
        margin: 0;
        max-width: 1050px;
        font-size: clamp(48px, 8.4vw, 132px);
        line-height: .88;
        letter-spacing: -.075em;
        font-weight: 950;
      }
      h1 em { font-style: normal; background: var(--acid); padding: 0 .08em .06em; }
      .hero-note {
        width: 220px;
        font-size: 13px;
        line-height: 1.75;
        color: var(--muted);
        padding-bottom: 8px;
      }
      .section-label {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 44px 0 16px;
        font: 700 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        letter-spacing: .13em;
      }
      .section-label::after { content: ''; height: 1px; background: var(--line); flex: 1; }
      .doors { display: grid; grid-template-columns: repeat(12, 1fr); gap: 12px; }
      .door {
        position: relative;
        grid-column: span 4;
        min-height: 470px;
        padding: 24px;
        border: 1.5px solid var(--ink);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform .22s ease, box-shadow .22s ease;
      }
      .door:hover { transform: translateY(-7px) rotate(-.25deg); box-shadow: 10px 10px 0 var(--ink); }
      .door:nth-child(2):hover { transform: translateY(-7px) rotate(.25deg); }
      .door.video { background: #171717; color: white; }
      .door.playlist { background: var(--red); }
      .door.street { background: var(--blue); }
      .door-top { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; }
      .door .eyebrow { font: 700 10px/1 ui-monospace, monospace; letter-spacing: .14em; opacity: .72; }
      .icon { font-size: 30px; line-height: 1; }
      .visual { position: absolute; inset: 72px 24px 140px; display:flex; align-items:center; justify-content:center; pointer-events:none; }
      .screen {
        width: 100%; aspect-ratio: 16/10; border: 1px solid rgba(255,255,255,.55); background: repeating-linear-gradient(0deg, #111 0 6px, #222 7px 8px); box-shadow: inset 0 0 50px #000;
        position:relative;
      }
      .screen::after { content:'RANDOM PLAY'; position:absolute; left:14px; bottom:12px; font:700 9px/1 monospace; letter-spacing:.13em; }
      .record { width:min(240px, 72%); aspect-ratio:1; border-radius:50%; background: repeating-radial-gradient(circle, #191919 0 8px, #282828 9px 10px); display:grid; place-items:center; animation: spin 12s linear infinite; box-shadow: 0 18px 35px rgba(0,0,0,.24); }
      .record::before { content:'PLAY'; display:grid; place-items:center; width:34%; aspect-ratio:1; border-radius:50%; background:var(--paper); font:900 12px/1 monospace; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .signs { width:100%; display:flex; flex-wrap:wrap; justify-content:center; gap:8px; transform:rotate(-2deg); }
      .signs span { border:2px solid var(--ink); padding:9px 12px; background:var(--paper); font-weight:900; font-size:13px; box-shadow:4px 4px 0 var(--ink); }
      .signs span:nth-child(2n){ transform:translateY(12px) rotate(3deg); }
      .door-copy { position:relative; z-index:2; }
      .door h2 { margin:0 0 6px; font-size: clamp(31px, 3.2vw, 52px); letter-spacing:-.055em; line-height:.95; }
      .door-name { font:800 12px/1 monospace; letter-spacing:.14em; margin-bottom:14px; }
      .door p { margin:0; max-width:34em; font-size:13px; line-height:1.7; opacity:.8; }
      .shelves { display:grid; grid-template-columns:repeat(4,1fr); border-top:1.5px solid var(--ink); border-left:1.5px solid var(--ink); }
      .shelf { min-height:190px; padding:22px; border-right:1.5px solid var(--ink); border-bottom:1.5px solid var(--ink); transition:background .18s ease; display:flex; flex-direction:column; justify-content:space-between; }
      .shelf:hover { background:var(--acid); }
      .shelf-label { font:700 10px/1 monospace; letter-spacing:.14em; color:var(--muted); }
      .shelf h3 { margin:0 0 8px; font-size:22px; letter-spacing:-.035em; }
      .shelf p { margin:0; font-size:12px; line-height:1.65; color:var(--muted); }
      .shelf-arrow { align-self:flex-end; font-size:22px; }
      .manifesto {
        margin: 80px 0 36px;
        padding: 48px 0;
        border-top: 1px solid var(--line);
        display:grid;
        grid-template-columns: 1fr 2fr;
        gap:32px;
      }
      .manifesto small { font:700 10px/1 monospace; letter-spacing:.14em; }
      .manifesto p { margin:0; font-size:clamp(22px,3vw,43px); line-height:1.35; letter-spacing:-.04em; font-weight:800; }
      footer { border-top:1px solid var(--line); min-height:100px; display:flex; align-items:center; justify-content:space-between; color:var(--muted); font-size:11px; }
      @media (max-width: 900px) {
        .hero { grid-template-columns:1fr; }
        .hero-note { width:auto; max-width:480px; }
        .door { grid-column:span 12; min-height:410px; }
        .shelves { grid-template-columns:1fr 1fr; }
        .manifesto { grid-template-columns:1fr; }
      }
      @media (max-width: 560px) {
        .wrap { width:min(100% - 20px, 1440px); }
        header { min-height:60px; }
        .brand span { display:none; }
        .hero { padding-top:42px; }
        h1 { font-size:clamp(45px,16vw,74px); }
        .doors { gap:9px; }
        .door { padding:18px; min-height:370px; }
        .visual { inset:64px 18px 130px; }
        .shelves { grid-template-columns:1fr; }
        .shelf { min-height:150px; }
        footer { align-items:flex-start; flex-direction:column; justify-content:center; gap:8px; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { scroll-behavior:auto !important; }
        .record { animation:none; }
        .door { transition:none; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <a class="brand" href="https://harf-way.com/">HARF-WAY <span>/ ENTRANCE</span></a>
        <a class="back" href="https://harf-way.com/">HARF-WAY.COM ↗</a>
      </header>

      <main>
        <section class="hero">
          <div>
            <div class="kicker">A SMALL ENTRANCE FOR FINDING GAMES</div>
            <h1>今日は、どうやって<br/><em>ゲームを見つける？</em></h1>
          </div>
          <p class="hero-note">タイトルを知っていなくても大丈夫。動画、テーマ、街、断片。いまの気分に近い入口からどうぞ。</p>
        </section>

        <div class="section-label">START FROM YOUR MOOD / 01</div>
        <section class="doors" aria-label="メインの入口">
          {doors.map((door) => (
            <a class={`door ${door.tone}`} href={door.href} target="_blank" rel="noreferrer">
              <div class="door-top">
                <span class="eyebrow">{door.eyebrow}</span>
                <span class="icon">{door.icon}</span>
              </div>

              <div class="visual" aria-hidden="true">
                {door.tone === 'video' && <div class="screen"></div>}
                {door.tone === 'playlist' && <div class="record"></div>}
                {door.tone === 'street' && <div class="signs"><span>喫茶</span><span>夜ふかし</span><span>菓子</span><span>庭</span><span>ネオン</span></div>}
              </div>

              <div class="door-copy">
                <h2>{door.title}</h2>
                <div class="door-name">{door.name} ↗</div>
                <p>{door.copy}</p>
              </div>
            </a>
          ))}
        </section>

        <div class="section-label">MORE WAYS IN / 02</div>
        <section class="shelves" aria-label="その他の入口">
          {shelves.map((item) => (
            <a class="shelf" href={item.href} target="_blank" rel="noreferrer">
              <div class="shelf-label">{item.label}</div>
              <div>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </div>
              <div class="shelf-arrow">↗</div>
            </a>
          ))}
        </section>

        <section class="manifesto">
          <small>ABOUT THIS PLACE</small>
          <p>HARF-WAYは、ゲームを「正しく選ぶ」場所というより、知らなかった一本に寄り道するための場所です。</p>
        </section>
      </main>

      <footer>
        <span>HARF-WAY / GAMES, NOTES & DETOURS</span>
        <span>ENTRANCE — 2026</span>
      </footer>
    </div>
  </body>
</html>
