<style is:global>
:root{--bg:#090a0c;--panel:#111318;--panel2:#0d1014;--line:#2a3038;--text:#f4f4ef;--muted:#8f98a5;--lime:#efff35}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}button,input,textarea,select{font:inherit}button{appearance:none}.app{height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 440px;overflow:hidden}.library{height:100vh;overflow:auto;padding:18px 22px 32px;border-right:1px solid var(--line);background:#090a0c}.editor{height:100vh;overflow:auto;padding:18px;background:#0c0e11}.top{position:sticky;top:-18px;z-index:20;padding:18px 0 14px;margin-bottom:12px;background:rgba(9,10,12,.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px}.kicker{font:950 9px/1 ui-monospace,monospace;letter-spacing:.15em;color:var(--lime)}h1,h2{margin:5px 0 0;letter-spacing:-.045em}h1{font-size:31px;line-height:.95}h2{font-size:27px;line-height:.96}.meta{font:800 8px/1.5 ui-monospace,monospace;color:var(--muted)}.searchpanel,.panel{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,#12151a,#0e1014);box-shadow:0 10px 28px rgba(0,0,0,.12)}.searchpanel{margin-top:13px;padding:10px}.searchrow{display:grid;grid-template-columns:1fr auto;gap:8px}.search{height:42px;width:100%;border:1px solid #38414c;border-radius:10px;background:#090b0e;color:#fff;padding:0 13px;font-size:11px;outline:none}.reset,.chip,.tab,.mini,.btn{border:1px solid #343b45;background:#15181e;color:#e9edf2;font-weight:850;cursor:pointer}.reset{border-radius:10px;padding:0 12px;font-size:8px}.quick{display:flex;gap:6px;align-items:center;overflow-x:auto;padding:9px 1px 1px}.quicklabel{font:850 7px/1 ui-monospace,monospace;color:#66707c;letter-spacing:.13em;white-space:nowrap}.chip,.tab{border-radius:999px;padding:6px 9px;font-size:8px;white-space:nowrap}.chip.on,.tab.on,.mini.primary,.btn.primary{background:var(--lime);border-color:var(--lime);color:#08090a}.filters{display:grid;grid-template-columns:repeat(5,minmax(110px,1fr));gap:7px;margin-top:9px;padding-top:9px;border-top:1px solid #232932}.filter{display:grid;gap:4px}.filter label,.field label{font-size:7px;color:#737d89;letter-spacing:.09em}.filter select,.field input,.field textarea,.field select{width:100%;border:1px solid #303741;border-radius:8px;background:#0b0d11;color:#eef1f5;outline:none}.filter select{height:33px;padding:0 8px;font-size:9px}.state{display:flex;align-items:center;gap:6px;margin-top:9px}.spacer{flex:1}.mini{border-radius:8px;padding:7px 9px;font-size:8px}.stats{display:flex;gap:6px;margin:0 0 10px}.stat{display:inline-flex;gap:5px;align-items:center;border:1px solid #282f38;border-radius:999px;background:#0e1014;padding:5px 7px;font:750 7px/1 ui-monospace,monospace;color:#69727e}.stat b{color:#dfe4e8}.games{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:10px;align-items:start}.game-card{height:218px;display:flex;flex-direction:column;position:relative;overflow:hidden;border:1px solid #2b323b;border-radius:13px;background:#101318;cursor:pointer;box-shadow:0 8px 22px rgba(0,0,0,.12);transition:.14s}.game-card:hover{transform:translateY(-2px);border-color:#525e6c;box-shadow:0 12px 30px rgba(0,0,0,.24)}.game-card.selected{border-color:#758322;box-shadow:0 0 0 1px rgba(239,255,53,.13),0 12px 30px rgba(0,0,0,.22)}.media{position:relative;flex:0 0 108px;width:100%;height:108px;overflow:hidden;background:#050607}.media:after{content:"";position:absolute;inset:auto 0 0;height:42%;background:linear-gradient(transparent,rgba(0,0,0,.45));z-index:2;pointer-events:none}.thumb{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;display:block}.noimg{position:absolute;inset:0;display:grid;place-items:center;color:#59616b;font:800 8px ui-monospace,monospace}.use{position:absolute;left:8px;top:8px;z-index:4;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:rgba(7,8,10,.8);padding:4px 6px;font:850 7px/1 ui-monospace,monospace;color:#d5dae0}.use.fresh{color:var(--lime);border-color:#6d7a28}.add{position:absolute;right:8px;top:8px;z-index:5;width:28px;height:28px;border:1px solid rgba(255,255,255,.25);border-radius:50%;background:rgba(7,8,10,.84);color:#fff;font-weight:950;cursor:pointer}.game-card.selected .add{background:var(--lime);border-color:var(--lime);color:#08090a}.body{height:110px;display:flex;flex-direction:column;padding:10px;overflow:hidden}.name{height:31px;overflow:hidden;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:11px;font-weight:950;line-height:1.34}.cat{margin-top:5px;height:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:7px;color:#8d97a3}.badges{display:flex;gap:4px;flex-wrap:wrap;margin-top:auto;padding-top:7px;height:26px;overflow:hidden}.badge{display:inline-flex;align-items:center;min-height:17px;border:1px solid #333c47;border-radius:999px;background:#0c0e12;padding:3px 5px;font:800 6px/1 ui-monospace,monospace;color:#8d97a3}.empty{grid-column:1/-1;border:1px dashed #333c47;border-radius:14px;background:#0d1014;padding:34px 18px;text-align:center;color:#77818d;font-size:10px}.editorhead{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-bottom:13px}.panel{position:relative;padding:13px;margin-bottom:11px}.paneltitle{display:flex;align-items:center;gap:7px;margin-bottom:10px;font:900 8px/1 ui-monospace,monospace;letter-spacing:.13em;color:var(--lime)}.paneltitle:before{content:"";width:6px;height:6px;border-radius:2px;background:var(--lime)}.grid2{display:grid;grid-template-columns:88px 1fr;gap:8px}.field{display:grid;gap:4px;margin-bottom:8px}.field input,.field select{height:35px;padding:0 9px;font-size:9px}.field textarea{min-height:55px;padding:8px;font-size:9px;line-height:1.5;resize:vertical}.toolbar{display:flex;gap:6px;flex-wrap:wrap}.btn{border-radius:8px;padding:8px 10px;font-size:8px}.btn.danger{color:#ffb4b4}.saved{display:grid;grid-template-columns:1fr auto;gap:6px}.selectedlist{display:grid;gap:7px;max-height:36vh;overflow:auto}.selrow{display:grid;grid-template-columns:17px 70px minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid #2d343e;border-radius:10px;background:#0d1014;padding:7px}.grab{cursor:grab;color:#69737f;text-align:center;font-size:15px}.selimg{width:70px;height:44px;object-fit:cover;border-radius:6px;display:block}.selname{margin-bottom:4px;font-size:9px;font-weight:900;line-height:1.3}.comment{width:100%;min-height:40px;border:1px solid #303741;border-radius:6px;background:#080a0d;color:#fff;padding:6px;font-size:8px;resize:vertical}.rowactions{display:flex;flex-direction:column;gap:4px}.rowactions .mini{padding:5px 6px;font-size:7px}.rowactions .pick.on{background:var(--lime);border-color:var(--lime);color:#08090a}.previewhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:9px}.previewactions{display:flex;gap:4px}.framewrap{height:205px;overflow:hidden;border:1px solid #39414b;border-radius:9px;background:#fff}.frame{width:100%;height:100%;border:0}.note,.status{font-size:7px;line-height:1.55;color:#6f7985}.note{margin-top:7px}.status{margin:6px 2px 0;min-height:12px}@media(max-width:1250px){.app{grid-template-columns:minmax(0,1fr) 390px}.games{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}.filters{grid-template-columns:repeat(3,1fr)}}@media(max-width:860px){.app{display:block;height:auto;overflow:visible}.library,.editor{height:auto;overflow:visible;border-right:0}.top{position:relative;top:auto}.filters{grid-template-columns:1fr 1fr}.games{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}.selectedlist{max-height:none}}@media(max-width:520px){.library,.editor{padding:14px}.games{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.searchrow{grid-template-columns:1fr}.filters{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:74px 1fr}}
</style>
</head>
<body>
<div class="app">
<section class="library">
<div class="top"><div class="head"><div><div class="kicker">HARF-WAY / WAYS LIBRARY</div><h1>棚から選ぶ</h1></div><div class="meta" id="resultCount">読み込み中</div></div><div class="searchpanel"><div class="searchrow"><input class="search" id="query" placeholder="作品名 / カテゴリ / タグ / URLで横断検索"><button class="reset" id="clearFilters">RESET</button></div><div class="quick"><span class="quicklabel">QUICK INDEX</span><button class="chip on" data-quick="all">ALL</button><button class="chip" data-quick="unused">未使用</button><button class="chip" data-quick="demo">体験版</button><button class="chip" data-quick="portrait">縦動画</button><span id="quickCats" style="display:contents"></span></div><div class="filters"><div class="filter"><label>カテゴリ</label><select id="categoryFilter"><option value="">すべて</option></select></div><div class="filter"><label>配信先</label><select id="platformFilter"><option value="">すべて</option><option value="steam">Steam</option><option value="itch">itch.io</option><option value="freem">ふりーむ</option><option value="other">その他</option></select></div><div class="filter"><label>動画 / 状態</label><select id="mediaFilter"><option value="">すべて</option><option value="landscape">横動画</option><option value="portrait">縦動画</option><option value="demo">体験版</option></select></div><div class="filter"><label>使用履歴</label><select id="usageFilter"><option value="">すべて</option><option value="unused">未使用のみ</option><option value="used">使用済み</option></select></div><div class="filter"><label>並び順</label><select id="sortFilter"><option value="ways">WAYS順</option><option value="unused">使用回数が少ない順</option><option value="title">作品名順</option><option value="duration">短い動画順</option></select></div></div><div class="state" id="stateTabs"><button class="tab on" data-state="all">すべて</button><button class="tab" data-state="unselected">未選択</button><button class="tab" data-state="selected">選択中</button><span class="spacer"></span><button class="mini primary" id="addVisible">表示中を追加</button></div></div></div>
<div class="stats"><span class="stat">WAYS <b id="kpiAll">--</b></span><span class="stat">未使用 <b id="kpiUnused">--</b></span><span class="stat">選択中 <b id="kpiSelected">0</b></span></div><div id="games" class="games"><div class="empty">WAYSを読み込み中…</div></div>
</section>
<aside class="editor"><div class="editorhead"><div><div class="kicker">CURATION BOARD</div><h2>今週の棚</h2></div><div class="meta"><span id="count">0</span> SELECTED</div></div><section class="panel"><div class="paneltitle">ISSUE</div><div class="grid2"><div class="field"><label>VOL.</label><input id="vol" value="001"></div><div class="field"><label>今週のテーマ</label><input id="theme" placeholder="例：操作がなんか変なゲーム"></div></div><div class="field"><label>導入文</label><textarea id="intro" placeholder="今週の棚をひとことで案内"></textarea></div><div class="field"><label>あとがき</label><textarea id="outro" placeholder="総括コメント"></textarea></div><div class="toolbar"><button class="btn primary" id="saveBtn">号を保存</button><button class="btn" id="newBtn">新規</button><button class="btn" id="exportBtn">JSON</button></div><div class="field" style="margin-top:8px"><label>保存済み</label><div class="saved"><select id="savedIssues"><option value="">保存済みなし</option></select><button class="mini" id="loadIssue">開く</button></div></div></section><section class="panel"><div class="paneltitle">SELECTED / DRAG TO REORDER</div><div id="selected" class="selectedlist"><div class="empty">左のカードから作品を選んでください。</div></div><div class="toolbar" style="margin-top:8px"><button class="btn danger" id="clearSelected">すべて外す</button></div></section><section class="panel"><div class="previewhead"><div class="paneltitle" style="margin:0">WORDPRESS PREVIEW</div><div class="previewactions"><button class="mini primary" id="copyBundle">WP一括コピー</button><button class="mini" id="copyHtml">HTML</button><button class="mini" id="copyCss">CSS</button></div></div><div class="framewrap"><iframe id="previewFrame" class="frame"></iframe></div><div class="note">小さい確認窓。WordPress出力と同じHTML/CSSです。</div></section><div class="status" id="saveStatus">Preview / ローカル保存方式</div></aside>
</div>
<script is:inline>
const API='https://harfway-playback.vercel.app/api/games-live',KEY='harfway_ways_weekly_issues_v2';let items=[],selectedIds=[],comments={},pickId='',dragId='',stateFilter='all',visibleIds=[];const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),norm=s=>String(s??'').toLowerCase().normalize('NFKC');function store(){try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch{return{}}}function issue(){return{vol:$('#vol').value.trim(),theme:$('#theme').value.trim(),intro:$('#intro').value.trim(),outro:$('#outro').value.trim(),selectedIds:[...selectedIds],comments:{...comments},pickId,updatedAt:new Date().toISOString()}}function game(id){return items.find(x=>x.id===id)}function cats(x){return String(x.category||'').split('/').map(v=>v.trim()).filter(Boolean)}function platform(x){const u=String(x.storeUrl||'').toLowerCase();if(u.includes('steampowered.com'))return'steam';if(u.includes('itch.io'))return'itch';if(u.includes('freem.ne.jp'))return'freem';return'other'}function orient(x){return x.videoOrientation||(Number(x.videoHeight)>Number(x.videoWidth)?'portrait':'landscape')}function usage(){const m={};Object.values(store()).forEach(v=>(v?.selectedIds||[]).forEach(id=>m[id]=(m[id]||0)+1));return m}function refreshCats(){const list=[...new Set(items.flatMap(cats))].sort((a,b)=>a.localeCompare(b,'ja')),sel=$('#categoryFilter');sel.innerHTML='<option value="">すべて</option>'+list.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');const count={};items.flatMap(cats).forEach(c=>count[c]=(count[c]||0)+1);$('#quickCats').innerHTML=Object.keys(count).sort((a,b)=>count[b]-count[a]).slice(0,7).map(c=>`<button class="chip" data-catquick="${esc(c)}">${esc(c)} ${count[c]}</button>`).join('')}function filtered(){const q=norm($('#query').value),cat=$('#categoryFilter').value,plat=$('#platformFilter').value,media=$('#mediaFilter').value,use=$('#usageFilter').value,u=usage();let list=items.filter(x=>{const chosen=selectedIds.includes(x.id);if(stateFilter==='selected'&&!chosen)return false;if(stateFilter==='unselected'&&chosen)return false;if(q&&!norm([x.title,x.category,(x.tags||[]).join(' '),x.storeUrl].join(' ')).includes(q))return false;if(cat&&!cats(x).includes(cat))return false;if(plat&&platform(x)!==plat)return false;if(media==='portrait'&&orient(x)!=='portrait')return false;if(media==='landscape'&&orient(x)!=='landscape')return false;if(media==='demo'&&!String(x.title||'').includes('体験版'))return false;const n=u[x.id]||0;if(use==='unused'&&n!==0)return false;if(use==='used'&&n===0)return false;return true});const sort=$('#sortFilter').value;if(sort==='unused')list.sort((a,b)=>(u[a.id]||0)-(u[b.id]||0));if(sort==='title')list.sort((a,b)=>String(a.title).localeCompare(String(b.title),'ja'));if(sort==='duration')list.sort((a,b)=>(+a.videoDuration||9999)-(+b.videoDuration||9999));return list}function renderGames(){const list=filtered(),u=usage();visibleIds=list.map(x=>x.id);$('#resultCount').textContent=`${list.length} / ${items.length} GAMES`;$('#games').innerHTML=list.map(x=>{const chosen=selectedIds.includes(x.id),n=u[x.id]||0,p=platform(x),img=x.thumbnailUrl?`<img class="thumb" src="${esc(x.thumbnailUrl)}" alt="" loading="lazy">`:'<div class="noimg">NO IMAGE</div>';return `<article class="game-card ${chosen?'selected':''}" data-card="${esc(x.id)}"><div class="media">${img}<span class="use ${n===0?'fresh':''}">${n===0?'未使用':`${n}回使用`}</span><button class="add" data-add="${esc(x.id)}">${chosen?'✓':'＋'}</button></div><div class="body"><div class="name">${esc(x.title)}</div><div class="cat">${esc(cats(x).join(' / ')||'未分類')}</div><div class="badges"><span class="badge">${p==='steam'?'STEAM':p==='itch'?'ITCH':p==='freem'?'ふりーむ':'OTHER'}</span>${orient(x)==='portrait'?'<span class="badge">縦</span>':''}${String(x.title||'').includes('体験版')?'<span class="badge">体験版</span>':''}${+x.videoDuration?`<span class="badge">${Math.round(+x.videoDuration)}s</span>`:''}</div></div></article>`}).join('')||'<div class="empty">この条件に一致する作品はありません。</div>';renderKpis()}function renderKpis(){const u=usage();$('#kpiAll').textContent=items.length;$('#kpiUnused').textContent=items.filter(x=>(u[x.id]||0)===0).length;$('#kpiSelected').textContent=selectedIds.length;$('#count').textContent=selectedIds.length}function toggle(id){selectedIds=selectedIds.includes(id)?selectedIds.filter(v=>v!==id):[...selectedIds,id];if(pickId&&!selectedIds.includes(pickId))pickId='';renderAll()}function renderSelected(){if(!selectedIds.length){$('#selected').innerHTML='<div class="empty">左のカードから作品を選んでください。</div>';return}$('#selected').innerHTML=selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';return `<div class="selrow" draggable="true" data-drag="${esc(id)}"><div class="grab">⋮</div>${x.thumbnailUrl?`<img class="selimg" src="${esc(x.thumbnailUrl)}" alt="">`:'<div style="width:70px;height:44px;background:#050607;border-radius:6px"></div>'}<div><div class="selname">${String(i+1).padStart(2,'0')} / ${esc(x.title)}</div><textarea class="comment" data-comment="${esc(id)}" placeholder="この作品への一言">${esc(comments[id]||'')}</textarea></div><div class="rowactions"><button class="mini pick ${pickId===id?'on':''}" data-pick="${esc(id)}">PICK</button><button class="mini" data-remove="${esc(id)}">外す</button></div></div>`}).join('')}const wpCSS=`.ways-weekly{max-width:920px;margin:0 auto;color:#141414;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.ways-weekly__kicker{font-size:12px;font-weight:900;letter-spacing:.14em}.ways-weekly__title{font-size:clamp(34px,6vw,62px);font-weight:900;line-height:1.03;margin:10px 0 22px}.ways-weekly__intro,.ways-weekly__outro{font-size:16px;line-height:1.95}.ways-weekly__item{margin:0 0 54px}.ways-weekly__media{position:relative;background:#000;overflow:hidden}.ways-weekly__media video{display:block;width:100%!important;height:auto!important}.ways-weekly__num{position:absolute;left:12px;top:12px;background:#111;color:#fff;padding:6px 8px;font-size:11px}.ways-weekly__pick{display:inline-block;margin-top:12px;background:#d9ef23;color:#111;padding:6px 9px;font-size:10px;font-weight:900}.ways-weekly__game-title{font-size:28px;font-weight:900;margin-top:12px}.ways-weekly__comment{font-size:15px;line-height:1.85}.ways-weekly__store{display:inline-block;margin-top:12px;padding:9px 13px;background:#111;color:#fff!important;text-decoration:none!important;font-weight:900}.ways-weekly__more{margin-top:28px}`;function contentHTML(){const d=issue();return `<div class="ways-weekly"><div class="ways-weekly__kicker">WAYS WEEKLY / VOL.${esc(d.vol)}</div><div class="ways-weekly__title">${esc(d.theme||'今週のWAYS')}</div>${d.intro?`<p class="ways-weekly__intro">${esc(d.intro).replace(/\n/g,'<br>')}</p>`:''}${d.selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';return `<section class="ways-weekly__item"><div class="ways-weekly__media"><video controls muted playsinline preload="metadata" poster="${esc(x.thumbnailUrl||'')}" src="${esc(x.video||'')}"></video><span class="ways-weekly__num">${String(i+1).padStart(2,'0')}</span></div>${d.pickId===id?'<div class="ways-weekly__pick">EDITOR\'S PICK</div>':''}<div class="ways-weekly__game-title">${esc(x.title)}</div>${d.comments[id]?`<p class="ways-weekly__comment">${esc(d.comments[id]).replace(/\n/g,'<br>')}</p>`:''}${x.storeUrl?`<a class="ways-weekly__store" href="${esc(x.storeUrl)}" target="_blank" rel="noopener">ゲームを見る ↗</a>`:''}</section>`}).join('')}${d.outro?`<p class="ways-weekly__outro">${esc(d.outro).replace(/\n/g,'<br>')}</p>`:''}<p class="ways-weekly__more"><a href="https://harfway-playback.vercel.app/">もっとWAYSを掘る →</a></p></div>`}function renderPreview(){$('#previewFrame').srcdoc=`<!doctype html><style>body{margin:0;padding:18px 14px;background:#fff;color:#111}${wpCSS}</style>${contentHTML()}`}function refreshSaved(){const a=store(),s=$('#savedIssues'),keys=Object.keys(a).sort().reverse();s.innerHTML=keys.length?'<option value="">保存済みを選択</option>'+keys.map(k=>`<option value="${esc(k)}">VOL.${esc(k)} / ${esc(a[k]?.theme||'無題')}</option>`).join(''):'<option value="">保存済みなし</option>'}function renderAll(){renderGames();renderSelected();renderPreview();refreshSaved()}function status(t){$('#saveStatus').textContent=t;setTimeout(()=>$('#saveStatus').textContent='Preview / ローカル保存方式',1600)}function clearFilters(){stateFilter='all';$('#query').value='';$('#categoryFilter').value='';$('#platformFilter').value='';$('#mediaFilter').value='';$('#usageFilter').value='';$('#sortFilter').value='ways';document.querySelectorAll('[data-state]').forEach(b=>b.classList.toggle('on',b.dataset.state==='all'));document.querySelectorAll('.chip').forEach(b=>b.classList.remove('on'));document.querySelector('[data-quick="all"]')?.classList.add('on');renderGames()}$('#games').onclick=e=>{const b=e.target.closest('[data-add]'),c=e.target.closest('[data-card]');if(b){e.stopPropagation();toggle(b.dataset.add)}else if(c)toggle(c.dataset.card)};$('#stateTabs').onclick=e=>{const b=e.target.closest('[data-state]');if(!b)return;stateFilter=b.dataset.state;document.querySelectorAll('[data-state]').forEach(x=>x.classList.toggle('on',x===b));renderGames()};$('.quick').onclick=e=>{const q=e.target.closest('[data-quick]'),c=e.target.closest('[data-catquick]');if(q){clearFilters();document.querySelectorAll('.chip').forEach(x=>x.classList.remove('on'));q.classList.add('on');if(q.dataset.quick==='unused')$('#usageFilter').value='unused';if(q.dataset.quick==='demo')$('#mediaFilter').value='demo';if(q.dataset.quick==='portrait')$('#mediaFilter').value='portrait';renderGames()}else if(c){$('#categoryFilter').value=c.dataset.catquick;renderGames()}};['query','categoryFilter','platformFilter','mediaFilter','usageFilter','sortFilter'].forEach(id=>$('#'+id).addEventListener(id==='query'?'input':'change',renderGames));$('#clearFilters').onclick=clearFilters;$('#addVisible').onclick=()=>{selectedIds=[...new Set([...selectedIds,...visibleIds])];renderAll()};$('#selected').oninput=e=>{const t=e.target.closest('[data-comment]');if(t){comments[t.dataset.comment]=t.value;renderPreview()}};$('#selected').onclick=e=>{const r=e.target.closest('[data-remove]');if(r){selectedIds=selectedIds.filter(id=>id!==r.dataset.remove);renderAll();return}const p=e.target.closest('[data-pick]');if(p){pickId=pickId===p.dataset.pick?'':p.dataset.pick;renderAll()}};$('#selected').addEventListener('dragstart',e=>{const x=e.target.closest('[data-drag]');if(x)dragId=x.dataset.drag});$('#selected').addEventListener('dragover',e=>e.preventDefault());$('#selected').addEventListener('drop',e=>{e.preventDefault();const x=e.target.closest('[data-drag]');if(!x||!dragId||x.dataset.drag===dragId)return;const a=selectedIds.indexOf(dragId),b=selectedIds.indexOf(x.dataset.drag);selectedIds.splice(a,1);selectedIds.splice(b,0,dragId);renderAll()});['vol','theme','intro','outro'].forEach(id=>$('#'+id).addEventListener('input',renderPreview));$('#saveBtn').onclick=()=>{const a=store(),d=issue();a[d.vol||'draft']=d;localStorage.setItem(KEY,JSON.stringify(a));renderAll();status('保存しました')};$('#newBtn').onclick=()=>{selectedIds=[];comments={};pickId='';$('#theme').value='';$('#intro').value='';$('#outro').value='';renderAll()};$('#loadIssue').onclick=()=>{const d=store()[$('#savedIssues').value];if(!d)return;$('#vol').value=d.vol||'';$('#theme').value=d.theme||'';$('#intro').value=d.intro||'';$('#outro').value=d.outro||'';selectedIds=d.selectedIds||[];comments=d.comments||{};pickId=d.pickId||'';renderAll()};$('#clearSelected').onclick=()=>{selectedIds=[];comments={};pickId='';renderAll()};async function copy(t,m){await navigator.clipboard.writeText(t);status(m)}$('#copyBundle').onclick=()=>copy(`<style>${wpCSS}</style>${contentHTML()}`,'WP一括コピーしました');$('#copyHtml').onclick=()=>copy(contentHTML(),'HTMLコピーしました');$('#copyCss').onclick=()=>copy(wpCSS,'CSSコピーしました');$('#exportBtn').onclick=()=>{const b=new Blob([JSON.stringify(issue(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=`ways-weekly-${issue().vol||'draft'}.json`;a.click()};fetch(API,{cache:'no-store'}).then(r=>r.json()).then(d=>{items=(d.entries||[]).filter(x=>x.video);refreshCats();renderAll()}).catch(()=>$('#games').innerHTML='<div class="empty">WAYSの読み込みに失敗しました。</div>');
</script>
