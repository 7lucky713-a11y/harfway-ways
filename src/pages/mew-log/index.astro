---
const title = 'MEW LOG — Mewgenics Play Archive';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <style is:global>
    :root{
      --bg:#171b18;
      --panel:#202621;
      --panel-2:#272e28;
      --text:#e1e8df;
      --muted:#a8b2a7;
      --accent:#93ad82;
      --accent-2:#c2b58e;
      --line:#3c463d;
      --shadow:#0d100e;
    }
    *{box-sizing:border-box}
    html{background:var(--bg)}
    body{
      margin:0;
      color:var(--text);
      font-family:Georgia,'Noto Serif JP',serif;
      font-size:16px;
      line-height:1.8;
      background:
        radial-gradient(circle at 85% 0,#91aa7d10 0,transparent 32%),
        repeating-linear-gradient(0deg,#ffffff05 0 1px,transparent 1px 6px),
        var(--bg);
    }
    button,a{font:inherit;color:inherit}
    .wrap{max-width:1240px;margin:auto;padding:0 28px}
    .top{
      position:sticky;top:0;z-index:10;
      background:#171b18ef;
      backdrop-filter:blur(12px);
      border-bottom:1px solid var(--line)
    }
    .row{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .brand{font-size:29px;font-weight:900;letter-spacing:-.055em}
    .brand b{color:var(--accent)}
    .admin{
      border:1px solid var(--line);padding:10px 14px;text-decoration:none;
      background:var(--panel);border-radius:10px;font-weight:800
    }
    .admin:hover{background:var(--panel-2);border-color:var(--accent)}
    .hero{padding:64px 0 36px}
    .stamp{
      display:inline-block;border:1px solid var(--accent);color:var(--accent);
      padding:6px 9px;border-radius:6px;font:900 11px ui-monospace,monospace;letter-spacing:.04em
    }
    .hero h1{
      font-size:clamp(64px,9vw,120px);line-height:.76;letter-spacing:-.075em;
      margin:18px 0 28px
    }
    .hero h1 em{font-style:normal;color:var(--accent)}
    .hero p{max-width:780px;font-size:18px;line-height:1.95;color:#cbd4c9}
    .nav{display:flex;gap:9px;flex-wrap:wrap;margin:30px 0}
    .nav button{
      border:1px solid var(--line);background:var(--panel);color:var(--text);
      padding:11px 15px;font-weight:900;border-radius:10px
    }
    .nav button:hover{border-color:var(--accent)}
    .nav button.on{background:var(--accent);border-color:var(--accent);color:#121612}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:24px 0 34px}
    .stat{
      border:1px solid var(--line);background:var(--panel);padding:18px;
      border-radius:14px;box-shadow:0 8px 24px #0002
    }
    .stat b{font-size:34px;line-height:1.1;display:block;color:var(--accent-2)}
    .stat small{display:block;margin-top:7px;font:800 11px ui-monospace,monospace;color:var(--muted)}
    .grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px;padding-bottom:76px}
    .card{
      grid-column:span 6;border:1px solid var(--line);background:var(--panel);
      padding:22px;border-radius:16px;min-height:210px;box-shadow:0 12px 32px #0002
    }
    .card.video{background:#1b201c}
    .card small{font:900 11px ui-monospace,monospace;color:var(--accent);letter-spacing:.02em}
    .card.video small{color:var(--accent-2)}
    .card h3{font-size:27px;line-height:1.35;margin:9px 0 12px;letter-spacing:-.025em}
    .card p{font-size:16px;line-height:1.9;color:#c1cbc0;margin:0}
    .card.video p{color:#b8c2b6}
    .tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:16px}
    .tag{
      border:1px solid var(--line);background:var(--panel-2);padding:5px 8px;
      border-radius:999px;font:800 11px ui-monospace,monospace;color:#c8d1c6
    }
    .empty{
      grid-column:1/-1;border:1px dashed #566158;padding:34px;text-align:center;
      color:var(--muted);border-radius:14px;font-size:16px
    }
    .footer{border-top:1px solid var(--line);padding:24px 0 38px;font:800 11px ui-monospace,monospace;color:var(--muted)}
    @media(max-width:760px){
      .wrap{padding:0 18px}
      .stats{grid-template-columns:1fr 1fr}
      .card{grid-column:1/-1}
      .row{min-height:66px}
      .hero{padding-top:44px}
      .hero p{font-size:16px}
      .brand{font-size:24px}
    }
  </style>
</head>
<body>
<header class="top">
  <div class="wrap row">
    <div class="brand">MEW <b>LOG</b></div>
    <a class="admin" href="/mew-log/admin/">＋記録 / 編集</a>
  </div>
</header>
<main>
  <section class="wrap hero">
    <span class="stamp">Mewgenics / personal play archive</span>
    <h1>PLAY.<br>NOTE.<br><em>REMEMBER.</em></h1>
    <p>日記、短い動画、ビルドメモ、作った猫の記録をひとつに集める。遊んだ断片が溜まり、あとから攻略や読み物へ育っていく場所。</p>
    <div class="nav">
      <button class="on" data-filter="all">ALL</button>
      <button data-filter="diary">日記</button>
      <button data-filter="video">動画</button>
      <button data-filter="build">ビルドメモ</button>
      <button data-filter="cat">キャラメモ</button>
    </div>
    <div class="stats" id="stats"></div>
  </section>
  <section class="wrap grid" id="grid"></section>
</main>
<footer class="wrap footer">MEW LOG / HARF-WAY — Preview prototype · browser local storage</footer>
<script>
const KEY='mewlog_entries_v1';
const seed=[
{id:'seed1',type:'diary',title:'Day 12 — 予定外のMutationが残った',memo:'PONZUの見た目がまた変わった。強さより、この血統をもう少し残したくなった。',cat:'PONZU',className:'Fighter',tags:['GEN 8','繁殖'],createdAt:'2026-08-29'},
{id:'seed2',type:'build',title:'Fighterで壁際まで押し込む',memo:'完成形ではなく途中メモ。位置取りが決まった場面を動画で残したい。',cat:'MISO',className:'Fighter',tags:['位置取り'],createdAt:'2026-08-28'},
{id:'seed3',type:'cat',title:'PONZU / GEN 8',memo:'いま一番残したい猫。予定外のMutationが続いている。',cat:'PONZU',className:'Fighter',tags:['血統','GEN 8'],createdAt:'2026-08-29'},
{id:'seed4',type:'video',title:'壁際に押し込めた1ターン',memo:'00:19 / Fighter。実装版ではR2動画URLをここに紐づける。',cat:'MISO',className:'Fighter',tags:['20 SEC'],createdAt:'2026-08-28'}
];
function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(Array.isArray(x))return x}catch{} localStorage.setItem(KEY,JSON.stringify(seed));return seed.slice()}
let filter='all';
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(){
  const all=load();
  const counts={diary:0,video:0,build:0,cat:0};
  all.forEach(x=>counts[x.type]=(counts[x.type]||0)+1);
  stats.innerHTML=['diary','video','build','cat'].map(k=>`<div class="stat"><b>${counts[k]||0}</b><small>${k.toUpperCase()}</small></div>`).join('');
  const list=filter==='all'?all:all.filter(x=>x.type===filter);
  grid.innerHTML=list.length?list.sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).map(x=>`<article class="card ${x.type==='video'?'video':''}"><small>${esc(x.type.toUpperCase())} / ${esc(x.createdAt)}</small><h3>${esc(x.title)}</h3><p>${esc(x.memo)}</p><div class="tags">${[x.cat,x.className,...(x.tags||[])].filter(Boolean).map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div></article>`).join(''):'<div class="empty">まだこの種類の記録はありません。管理画面から追加できます。</div>'
}
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('on',x===b));render()});
render();
</script>
</body>
</html>