---
const title = 'MEW LOG — Mewgenics Play Archive';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><style is:global>
:root{--p:#efe5ca;--p2:#dfd0aa;--i:#17140f;--r:#a43128;--y:#e4bb3b;--m:#6e6554;--l:#201b14}*{box-sizing:border-box}body{margin:0;color:var(--i);font-family:Georgia,'Noto Serif JP',serif;background:repeating-linear-gradient(0deg,#00000008 0 1px,transparent 1px 5px),var(--p)}button,a{font:inherit;color:inherit}.wrap{max-width:1240px;margin:auto;padding:0 20px}.top{position:sticky;top:0;z-index:10;background:#efe5caee;border-bottom:2px solid var(--l)}.row{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{font-size:26px;font-weight:900;letter-spacing:-.06em}.brand b{color:var(--r)}.admin{border:2px solid var(--l);padding:8px 11px;text-decoration:none;box-shadow:2px 2px 0 #111}.hero{padding:54px 0 34px}.stamp{display:inline-block;border:2px solid var(--r);color:var(--r);padding:5px 8px;font:900 9px ui-monospace}.hero h1{font-size:clamp(60px,9vw,118px);line-height:.74;letter-spacing:-.08em;margin:14px 0 22px}.hero h1 em{font-style:normal;color:var(--r)}.hero p{max-width:720px;font-size:14px;line-height:1.9}.nav{display:flex;gap:7px;flex-wrap:wrap;margin:24px 0}.nav button{border:2px solid var(--l);background:transparent;padding:9px 12px;font-weight:900;box-shadow:2px 2px 0 #111}.nav button.on{background:#17140f;color:var(--p)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:20px 0 30px}.stat{border:2px solid var(--l);background:var(--p2);padding:14px;box-shadow:3px 3px 0 #111}.stat b{font-size:28px;display:block}.stat small{font:800 8px ui-monospace;color:var(--m)}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px;padding-bottom:70px}.card{grid-column:span 6;border:2px solid var(--l);background:#e8dbb9;padding:16px;box-shadow:4px 4px 0 #111;min-height:190px}.card.video{background:#1a1713;color:var(--p)}.card small{font:900 8px ui-monospace;color:var(--r)}.card.video small{color:var(--y)}.card h3{font-size:24px;margin:7px 0}.card p{font-size:11px;line-height:1.75;color:#594f40}.card.video p{color:#c2b49e}.tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:12px}.tag{border:1px solid currentColor;padding:4px 6px;font:800 8px ui-monospace}.empty{grid-column:1/-1;border:2px dashed #766d5c;padding:30px;text-align:center;color:#6e6554}.footer{border-top:2px solid var(--l);padding:20px 0 35px;font:800 8px ui-monospace;color:var(--m)}@media(max-width:760px){.stats{grid-template-columns:1fr 1fr}.card{grid-column:1/-1}.row{min-height:60px}.hero{padding-top:38px}}
</style></head><body><header class="top"><div class="wrap row"><div class="brand">MEW <b>LOG</b></div><a class="admin" href="/mew-log/admin/">＋記録 / 編集</a></div></header><main><section class="wrap hero"><span class="stamp">Mewgenics / personal play archive</span><h1>PLAY.<br>NOTE.<br><em>REMEMBER.</em></h1><p>日記、短い動画、ビルドメモ、作った猫の記録をひとつに集める。遊んだ断片が溜まり、あとから攻略や読み物へ育っていく場所。</p><div class="nav"><button class="on" data-filter="all">ALL</button><button data-filter="diary">日記</button><button data-filter="video">動画</button><button data-filter="build">ビルドメモ</button><button data-filter="cat">キャラメモ</button></div><div class="stats" id="stats"></div></section><section class="wrap grid" id="grid"></section></main><footer class="wrap footer">MEW LOG / HARF-WAY — Preview prototype · browser local storage</footer><script>
const KEY='mewlog_entries_v1';const seed=[
{id:'seed1',type:'diary',title:'Day 12 — 予定外のMutationが残った',memo:'PONZUの見た目がまた変わった。強さより、この血統をもう少し残したくなった。',cat:'PONZU',className:'Fighter',tags:['GEN 8','繁殖'],createdAt:'2026-08-29'},
{id:'seed2',type:'build',title:'Fighterで壁際まで押し込む',memo:'完成形ではなく途中メモ。位置取りが決まった場面を動画で残したい。',cat:'MISO',className:'Fighter',tags:['位置取り'],createdAt:'2026-08-28'},
{id:'seed3',type:'cat',title:'PONZU / GEN 8',memo:'いま一番残したい猫。予定外のMutationが続いている。',cat:'PONZU',className:'Fighter',tags:['血統','GEN 8'],createdAt:'2026-08-29'},
{id:'seed4',type:'video',title:'壁際に押し込めた1ターン',memo:'00:19 / Fighter。実装版ではR2動画URLをここに紐づける。',cat:'MISO',className:'Fighter',tags:['20 SEC'],createdAt:'2026-08-28'}];
function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(Array.isArray(x))return x}catch{} localStorage.setItem(KEY,JSON.stringify(seed));return seed.slice()}let filter='all';
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function render(){const all=load();const counts={diary:0,video:0,build:0,cat:0};all.forEach(x=>counts[x.type]=(counts[x.type]||0)+1);stats.innerHTML=['diary','video','build','cat'].map(k=>`<div class="stat"><b>${counts[k]||0}</b><small>${k.toUpperCase()}</small></div>`).join('');const list=filter==='all'?all:all.filter(x=>x.type===filter);grid.innerHTML=list.length?list.sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).map(x=>`<article class="card ${x.type==='video'?'video':''}"><small>${esc(x.type.toUpperCase())} / ${esc(x.createdAt)}</small><h3>${esc(x.title)}</h3><p>${esc(x.memo)}</p><div class="tags">${[x.cat,x.className,...(x.tags||[])].filter(Boolean).map(t=>`<span class="tag">${esc(t)}</span>`).join('')}</div></article>`).join(''):'<div class="empty">まだこの種類の記録はありません。管理画面から追加できます。</div>'}
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('on',x===b));render()});render();
</script></body></html>