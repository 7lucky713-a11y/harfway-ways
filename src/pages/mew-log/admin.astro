---
const title = 'MEW LOG ADMIN';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><style>
:root{--p:#efe5ca;--p2:#dfd0aa;--i:#17140f;--r:#a43128;--y:#e4bb3b;--m:#6e6554;--l:#201b14}*{box-sizing:border-box}body{margin:0;color:var(--i);font-family:Georgia,'Noto Serif JP',serif;background:repeating-linear-gradient(0deg,#00000008 0 1px,transparent 1px 5px),var(--p)}button,input,textarea,select{font:inherit}.wrap{max-width:1100px;margin:auto;padding:0 20px}.top{border-bottom:2px solid var(--l);background:#efe5caee;position:sticky;top:0;z-index:10}.row{min-height:64px;display:flex;justify-content:space-between;align-items:center}.brand{font-size:25px;font-weight:900}.back{border:2px solid var(--l);padding:8px 10px;text-decoration:none;color:inherit;box-shadow:2px 2px 0 #111}.hero{padding:34px 0 20px}.hero h1{font-size:52px;letter-spacing:-.06em;margin:0 0 8px}.hero p{font-size:11px;color:var(--m)}.notice{border:2px solid var(--l);background:#eadcab;padding:11px 13px;font-size:10px;line-height:1.6;margin:15px 0}.form{display:grid;grid-template-columns:1fr 1fr;gap:10px;border:2px solid var(--l);background:#e6d8b7;padding:16px;box-shadow:4px 4px 0 #111}.form label{display:grid;gap:5px;font:900 8px ui-monospace}.form input,.form textarea,.form select{border:2px solid var(--l);background:#f8eed6;padding:9px}.form textarea{min-height:105px;resize:vertical}.full{grid-column:1/-1}.actions{grid-column:1/-1;display:flex;gap:8px}.actions button{border:2px solid var(--l);padding:10px 13px;font-weight:900;box-shadow:2px 2px 0 #111;background:var(--y)}.actions .sub{background:transparent}.list{display:grid;gap:10px;margin:28px 0 70px}.item{border:2px solid var(--l);background:#e8dbb9;padding:13px;box-shadow:3px 3px 0 #111;display:grid;grid-template-columns:1fr auto;gap:10px}.item small{font:800 8px ui-monospace;color:var(--r)}.item h3{font-size:18px;margin:4px 0}.item p{font-size:10px;line-height:1.6;color:#5b5142}.item .btns{display:flex;gap:6px;align-items:start}.item button{border:2px solid var(--l);padding:7px 9px;background:transparent;font-size:9px;font-weight:900}.item button.del{background:var(--r);color:#fff}.empty{border:2px dashed #756b57;padding:24px;text-align:center;color:var(--m)}@media(max-width:700px){.form{grid-template-columns:1fr}.full,.actions{grid-column:1}.item{grid-template-columns:1fr}.item .btns{justify-content:flex-start}}
</style></head><body><header class="top"><div class="wrap row"><div class="brand">MEW LOG / ADMIN</div><a class="back" href="/mew-log/">← 公開ページ</a></div></header><main class="wrap"><section class="hero"><h1>とりあえず残す。</h1><p>Preview版はブラウザlocalStorageへ保存。Production DBには書き込みません。</p></section><div class="notice">日記 / 動画メモ / ビルドメモ / キャラメモを同じ形式で保存します。Preview確認後にNeon/R2へ接続する想定です。</div><form class="form" id="form"><input type="hidden" id="editId"><label>種類<select id="type"><option value="diary">日記</option><option value="video">動画メモ</option><option value="build">ビルドメモ</option><option value="cat">キャラメモ</option></select></label><label>タイトル<input id="title" required placeholder="例：PONZUがまた変になった"></label><label>猫 / キャラ<input id="cat" placeholder="例：PONZU"></label><label>クラス<input id="className" placeholder="例：Fighter"></label><label class="full">タグ<input id="tags" placeholder="例：GEN 8, 繁殖, 位置取り"></label><label class="full">メモ<textarea id="memo" required placeholder="何が起きた？何を試した？次に何をしたい？"></textarea></label><div class="actions"><button type="submit">保存する</button><button type="button" class="sub" id="reset">入力をクリア</button></div></form><section class="list" id="list"></section></main><script>
const KEY='mewlog_entries_v1';const seed=[{id:'seed1',type:'diary',title:'Day 12 — 予定外のMutationが残った',memo:'PONZUの見た目がまた変わった。強さより、この血統をもう少し残したくなった。',cat:'PONZU',className:'Fighter',tags:['GEN 8','繁殖'],createdAt:'2026-08-29'}];
function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(Array.isArray(x))return x}catch{} localStorage.setItem(KEY,JSON.stringify(seed));return seed.slice()}function save(x){localStorage.setItem(KEY,JSON.stringify(x))}function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function clearForm(){editId.value='';form.reset();type.value='diary'}
function render(){const xs=load().sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));list.innerHTML=xs.length?xs.map(x=>`<article class="item"><div><small>${esc(x.type.toUpperCase())} / ${esc(x.createdAt)}</small><h3>${esc(x.title)}</h3><p>${esc(x.memo)}</p></div><div class="btns"><button data-edit="${esc(x.id)}">編集</button><button class="del" data-del="${esc(x.id)}">削除</button></div></article>`).join(''):'<div class="empty">まだ記録がありません。</div>';document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{const x=load().find(v=>v.id===b.dataset.edit);if(!x)return;editId.value=x.id;type.value=x.type;title.value=x.title;cat.value=x.cat||'';className.value=x.className||'';tags.value=(x.tags||[]).join(', ');memo.value=x.memo||'';scrollTo({top:0,behavior:'smooth'})});document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{if(!confirm('この記録を削除しますか？'))return;save(load().filter(v=>v.id!==b.dataset.del));render()})}
form.onsubmit=e=>{e.preventDefault();const xs=load();const id=editId.value||('entry-'+Date.now());const prev=xs.find(x=>x.id===id);const obj={id,type:type.value,title:title.value.trim(),cat:cat.value.trim(),className:className.value.trim(),tags:tags.value.split(',').map(s=>s.trim()).filter(Boolean),memo:memo.value.trim(),createdAt:prev?.createdAt||new Date().toISOString().slice(0,10),updatedAt:new Date().toISOString()};const next=prev?xs.map(x=>x.id===id?obj:x):[obj,...xs];save(next);clearForm();render()};reset.onclick=clearForm;render();
</script></body></html>