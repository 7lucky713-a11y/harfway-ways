---
const title = 'MEW LOG ADMIN';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <style is:global>
    :root{
      --bg:#171b18;
      --panel:#202621;
      --panel-2:#272e28;
      --text:#e1e8df;
      --muted:#a8b2a7;
      --accent:#93ad82;
      --accent-2:#c2b58e;
      --line:#3c463d;
      --danger:#b97171;
    }
    *{box-sizing:border-box}
    html{background:var(--bg)}
    body{
      margin:0;color:var(--text);font-family:Georgia,'Noto Serif JP',serif;
      font-size:16px;line-height:1.8;
      background:
        radial-gradient(circle at 85% 0,#91aa7d10 0,transparent 32%),
        repeating-linear-gradient(0deg,#ffffff05 0 1px,transparent 1px 6px),
        var(--bg)
    }
    button,input,textarea,select{font:inherit;color:inherit}
    .wrap{max-width:1120px;margin:auto;padding:0 28px}
    .top{border-bottom:1px solid var(--line);background:#171b18ef;backdrop-filter:blur(12px);position:sticky;top:0;z-index:10}
    .row{min-height:72px;display:flex;justify-content:space-between;align-items:center;gap:16px}
    .brand{font-size:28px;font-weight:900;letter-spacing:-.04em}
    .back{border:1px solid var(--line);padding:10px 14px;text-decoration:none;color:inherit;background:var(--panel);border-radius:10px;font-weight:800}
    .back:hover{border-color:var(--accent);background:var(--panel-2)}
    .hero{padding:46px 0 22px}
    .hero h1{font-size:58px;line-height:1.05;letter-spacing:-.055em;margin:0 0 12px}
    .hero p{font-size:16px;color:var(--muted);margin:0}
    .notice{border:1px solid var(--line);background:var(--panel);padding:14px 16px;font-size:14px;line-height:1.75;margin:18px 0;border-radius:12px;color:#c5cec3}
    .form{display:grid;grid-template-columns:1fr 1fr;gap:14px;border:1px solid var(--line);background:var(--panel);padding:20px;border-radius:16px;box-shadow:0 12px 32px #0002}
    .form label{display:grid;gap:7px;font:900 12px ui-monospace,monospace;color:#bdc7bb}
    .form input,.form textarea,.form select{border:1px solid var(--line);background:#151915;padding:12px 13px;border-radius:10px;font-size:16px;outline:none}
    .form input:focus,.form textarea:focus,.form select:focus{border-color:var(--accent);box-shadow:0 0 0 3px #93ad8218}
    .form textarea{min-height:150px;resize:vertical;line-height:1.7}
    .form input[type="file"]{padding:10px;background:#181d19}
    .full{grid-column:1/-1}
    .media-help{font:700 12px/1.6 ui-monospace,monospace;color:var(--muted)}
    .media-status{grid-column:1/-1;display:none;border:1px solid var(--line);background:#181d19;padding:11px 13px;border-radius:10px;font:800 12px/1.6 ui-monospace,monospace;color:#cbd4c9}
    .media-status.on{display:block}
    .media-status.good{border-color:#56705b;color:#bbd1bc}
    .media-status.bad{border-color:#784d4d;color:#e0b2b2}
    .current-media{grid-column:1/-1;display:none;gap:10px;border:1px solid var(--line);background:#181d19;padding:12px;border-radius:12px}
    .current-media.on{display:grid}
    .current-media video,.current-media img{width:min(440px,100%);max-height:300px;object-fit:contain;background:#0f120f;border-radius:10px;border:1px solid var(--line)}
    .actions{grid-column:1/-1;display:flex;gap:10px;flex-wrap:wrap}
    .actions button{border:1px solid var(--line);padding:12px 16px;font-weight:900;border-radius:10px;background:var(--accent);color:#121612}
    .actions button:disabled{opacity:.55;cursor:wait}
    .actions .sub{background:var(--panel-2);color:var(--text)}
    .list{display:grid;gap:14px;margin:34px 0 76px}
    .item{border:1px solid var(--line);background:var(--panel);padding:18px;border-radius:14px;display:grid;grid-template-columns:1fr auto;gap:16px;box-shadow:0 10px 28px #0002}
    .item small{font:800 11px ui-monospace,monospace;color:var(--accent)}
    .item h3{font-size:23px;line-height:1.35;margin:6px 0 10px}
    .item p{font-size:15px;line-height:1.85;color:#c0c9be;margin:0}
    .item video,.item img{display:block;width:min(380px,100%);max-height:260px;object-fit:contain;margin:12px 0;background:#0f120f;border-radius:10px;border:1px solid var(--line)}
    .item .btns{display:flex;gap:8px;align-items:start}
    .item button{border:1px solid var(--line);padding:8px 11px;background:var(--panel-2);font-size:13px;font-weight:900;border-radius:8px}
    .item button:hover{border-color:var(--accent)}
    .item button.del{background:#3a2424;color:#e4baba;border-color:#6b3d3d}
    .empty{border:1px dashed #566158;padding:28px;text-align:center;color:var(--muted);border-radius:12px;font-size:15px}
    @media(max-width:700px){
      .wrap{padding:0 18px}
      .form{grid-template-columns:1fr}
      .full,.actions,.media-status,.current-media{grid-column:1}
      .item{grid-template-columns:1fr}
      .item .btns{justify-content:flex-start}
      .hero h1{font-size:44px}
      .brand{font-size:23px}
    }
  </style>
</head>
<body>
<header class="top">
  <div class="wrap row">
    <div class="brand">MEW LOG / ADMIN</div>
    <a class="back" href="/mew-log/">← 公開ページ</a>
  </div>
</header>
<main class="wrap">
  <section class="hero">
    <h1>とりあえず残す。</h1>
    <p>日記・動画・ビルド・猫を、Neon Previewへ保存。画像と動画はR2へ直接保管します。</p>
  </section>
  <div class="notice">Preview専用のNeon branchへ保存中。全種類で画像 / 動画を添付できます。画像はJPEG / PNG / WebP / GIF・8MBまで、動画はMP4 / WebM・20MBまで。Productionにはまだ反映しません。</div>
  <form class="form" id="form">
    <input type="hidden" id="editId" />
    <label>種類
      <select id="type"><option value="diary">日記</option><option value="video">動画メモ</option><option value="build">ビルドメモ</option><option value="cat">キャラメモ</option></select>
    </label>
    <label>タイトル<input id="title" required placeholder="例：PONZUがまた変になった" /></label>
    <label>猫 / キャラ<input id="cat" placeholder="例：PONZU" /></label>
    <label>クラス<input id="className" placeholder="例：Fighter" /></label>
    <label class="full">タグ<input id="tags" placeholder="例：GEN 8, 繁殖, 位置取り" /></label>
    <label class="full" id="mediaField">画像 / 動画
      <input id="mediaFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm" />
      <span class="media-help">どの種類でも添付できます。画像8MBまで / 動画20MBまで。選択すると保存時にR2へアップロードします。</span>
    </label>
    <div class="current-media" id="currentMedia"></div>
    <div class="media-status" id="mediaStatus"></div>
    <label class="full">メモ<textarea id="memo" required placeholder="何が起きた？何を試した？次に何をしたい？"></textarea></label>
    <div class="actions"><button type="submit">保存する</button><button type="button" class="sub" id="clearInputs">入力をクリア</button></div>
  </form>
  <section class="list" id="list"></section>
</main>
<script>
const KEY='mewlog_entries_v1';
const seed=[{id:'seed1',type:'diary',title:'Day 12 — 予定外のMutationが残った',memo:'PONZUの見た目がまた変わった。強さより、この血統をもう少し残したくなった。',cat:'PONZU',className:'Fighter',tags:['GEN 8','繁殖'],createdAt:'2026-08-29'}];
function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'null');if(Array.isArray(x))return x}catch{} localStorage.setItem(KEY,JSON.stringify(seed));return seed.slice()}
function save(x){localStorage.setItem(KEY,JSON.stringify(x))}
function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function clearForm(){editId.value='';form.reset();type.value='diary'}
function render(){
  const xs=load().sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));
  list.innerHTML=xs.length?xs.map(x=>`<article class="item"><div><small>${esc(x.type.toUpperCase())} / ${esc(x.createdAt)}</small><h3>${esc(x.title)}</h3><p>${esc(x.memo)}</p></div><div class="btns"><button data-edit="${esc(x.id)}">編集</button><button class="del" data-del="${esc(x.id)}">削除</button></div></article>`).join(''):'<div class="empty">まだ記録がありません。</div>';
  document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{const x=load().find(v=>v.id===b.dataset.edit);if(!x)return;editId.value=x.id;type.value=x.type;title.value=x.title;cat.value=x.cat||'';className.value=x.className||'';tags.value=(x.tags||[]).join(', ');memo.value=x.memo||'';scrollTo({top:0,behavior:'smooth'})});
  document.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{if(!confirm('この記録を削除しますか？'))return;save(load().filter(v=>v.id!==b.dataset.del));render()})
}
form.onsubmit=e=>{e.preventDefault();const xs=load();const id=editId.value||('entry-'+Date.now());const prev=xs.find(x=>x.id===id);const obj={id,type:type.value,title:title.value.trim(),cat:cat.value.trim(),className:className.value.trim(),tags:tags.value.split(',').map(s=>s.trim()).filter(Boolean),memo:memo.value.trim(),createdAt:prev?.createdAt||new Date().toISOString().slice(0,10),updatedAt:new Date().toISOString()};const next=prev?xs.map(x=>x.id===id?obj:x):[obj,...xs];save(next);clearForm();render()};
clearInputs.onclick=clearForm;
render();
</script>
</body>
</html>