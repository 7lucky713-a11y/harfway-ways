---
import { neon } from '@neondatabase/serverless';

const candidates = [
  ['MEW_LOG_PREVIEW_DATABASE_URL', process.env.MEW_LOG_PREVIEW_DATABASE_URL || ''],
  ['SALVAGER_PREVIEW_DATABASE_URL', process.env.SALVAGER_PREVIEW_DATABASE_URL || ''],
  ['WAYS_DATABASE_URL', process.env.WAYS_DATABASE_URL || ''],
  ['DATABASE_URL', process.env.DATABASE_URL || ''],
  ['NEON_DATABASE_URL', process.env.NEON_DATABASE_URL || ''],
  ['POSTGRES_URL', process.env.POSTGRES_URL || ''],
  ['WAYS_ANALYTICS_DATABASE_URL', process.env.WAYS_ANALYTICS_DATABASE_URL || '']
];

async function probe(name, databaseUrl) {
  const result = {
    name,
    configured: Boolean(databaseUrl),
    endpointId: null,
    databaseName: null,
    projectId: null,
    branchId: null,
    contentsTable: null,
    error: null
  };
  if (!databaseUrl) return result;
  try {
    const parsed = new URL(databaseUrl);
    result.endpointId = parsed.hostname.split('.')[0] || null;
    const sql = neon(databaseUrl);
    const rows = await sql`
      SELECT
        current_database()::text AS database_name,
        current_setting('neon.project_id', true)::text AS project_id,
        current_setting('neon.branch_id', true)::text AS branch_id,
        to_regclass('core.contents')::text AS contents_table
    `;
    const row = rows[0] || {};
    result.databaseName = row.database_name || null;
    result.projectId = row.project_id || null;
    result.branchId = row.branch_id || null;
    result.contentsTable = row.contents_table || null;
  } catch (error) {
    result.error = error?.code || error?.message || 'probe_failed';
  }
  return result;
}

const results = [];
for (const [name, value] of candidates) results.push(await probe(name, value));
const automation = {
  neonApiKeyConfigured: Boolean(process.env.NEON_API_KEY),
  neonProjectIdConfigured: Boolean(process.env.NEON_PROJECT_ID),
  neonOrgIdConfigured: Boolean(process.env.NEON_ORG_ID)
};
console.log('[MEW_LOG_DB_PROBE]', JSON.stringify(results));
console.log('[MEW_LOG_NEON_AUTOMATION]', JSON.stringify(automation));
