---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>HARF-WAY SALE WATCH</title>
  <style>
    :root{color-scheme:dark;--bg:#090909;--panel:#111113;--panel2:#171719;--line:#303034;--muted:#98989a;--accent:#efff3d;--danger:#ff818c;--warn:#ffc96b;--ok:#b9ff78;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f6f6f1;font-size:14px}button,input,select{font:inherit}button{cursor:pointer}.hide{display:none!important}.muted{color:var(--muted)}.tiny{font-size:11px}.btn{min-height:40px;border:1px solid var(--line);background:#19191c;color:#fff;border-radius:10px;padding:9px 14px;font-weight:800}.btn.primary{background:var(--accent);color:#111;border-color:transparent}.login{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 15%,#252528,#090909 55%)}.loginbox{width:min(460px,100%);padding:30px;border:1px solid var(--line);border-radius:22px;background:#101012}.eyebrow{font-size:10px;letter-spacing:.17em;color:var(--accent);font-weight:900}.login h1{font-size:48px;line-height:.9;margin:10px 0 18px}.field{display:grid;gap:7px}.field label{font-size:11px;font-weight:850;color:#c9c9c5}.field input{width:100%;border:1px solid #3a3a3e;border-radius:10px;background:#0b0b0d;color:#fff;padding:12px 13px}.top{position:sticky;top:0;z-index:20;border-bottom:1px solid #242427;background:#0b0b0df2;backdrop-filter:blur(12px)}.topmain{display:flex;align-items:center;gap:11px;min-height:68px;padding:12px 20px}.brandwrap{display:grid;gap:3px;margin-right:auto}.brand{font-size:17px;font-weight:950}.brand b{color:var(--accent)}.topactions{display:flex;gap:8px}.page{max-width:1700px;margin:auto;padding:24px}.stats{display:grid;grid-template-columns:repeat(6,minmax(130px,1fr));gap:10px;margin-bottom:16px}.stat{border:1px solid var(--line);border-radius:14px;background:#111113;padding:14px 15px}.stat span{display:block;font-size:10px;color:var(--muted);font-weight:800}.stat b{display:block;font-size:28px;margin-top:8px}.controls{display:grid;grid-template-columns:minmax(260px,1fr) auto auto auto auto;gap:10px;margin-bottom:14px;padding:12px;border:1px solid var(--line);border-radius:14px;background:#101012}.controls input,.controls select{min-height:42px;border:1px solid var(--line);border-radius:10px;background:#171719;color:#fff;padding:10px 12px}.tablewrap{border:1px solid var(--line);border-radius:14px;overflow:auto;background:var(--panel)}table{width:100%;border-collapse:collapse;min-width:1050px}th,td{padding:13px 12px;border-bottom:1px solid #28282b;text-align:left;vertical-align:middle}th{position:sticky;top:0;background:#18181b;color:#aaa;font-size:10px;z-index:2}.game{font-weight:900;font-size:13px}.sub{font-size:10px;color:#777;margin-top:4px}.price{font-weight:900}.price del{color:#777;font-weight:600;margin-right:7px}.discount{display:inline-flex;align-items:center;justify-content:center;min-width:52px;padding:5px 8px;border-radius:999px;background:#263318;color:#d7ff93;font-weight:950}.sale{background:#171d0f}.under500{box-shadow:inset 4px 0 0 var(--accent)}.pill{display:inline-block;padding:4px 8px;border-radius:999px;border:1px solid #414146;font-size:9px;font-weight:850}.error{color:#ff9ca5}.empty{padding:55px 20px;text-align:center;color:var(--muted)}a{color:#fff}.note{margin-top:14px;padding:12px 14px;border:1px solid #3a3926;border-radius:12px;background:#15150f;color:#caca9f;font-size:11px;line-height:1.7}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);padding:10px 14px;border-radius:999px;background:#eee;color:#111;font-size:11px;font-weight:900;opacity:0;transition:.2s}.toast.on{opacity:1}
    @media(max-width:1000px){.stats{grid-template-columns:repeat(3,1fr)}.controls{grid-template-columns:1fr 1fr}.controls input{grid-column:1/-1}}@media(max-width:600px){.page{padding:12px}.topmain{align-items:flex-start;flex-wrap:wrap;padding:12px}.topactions{width:100%;overflow:auto}.stats{grid-template-columns:repeat(2,1fr)}.controls{grid-template-columns:1fr}.controls input{grid-column:auto}}
  </style>
</head>
<body>
  <section id="login" class="login">
    <form id="loginForm" class="loginbox">
      <div class="eyebrow">HARF-WAY / PRIVATE STEAM PRICE CONSOLE</div>
      <h1>SALE<br>WATCH</h1>
      <p class="muted tiny">DBに登録済みのSteam作品だけを対象に、日本向け価格と現在の割引をチェックします。</p>
      <div class="field"><label>管理キー</label><input id="key" type="password" autocomplete="current-password" /></div>
      <p id="loginMsg" class="muted tiny"></p>
      <button class="btn primary" style="width:100%" type="submit">SALE WATCHを開く</button>
    </form>
  </section>

  <div id="app" class="hide">
    <header class="top"><div class="topmain">
      <div class="brandwrap"><div class="brand">HARF-WAY <b>SALE WATCH</b></div><span id="connection" class="tiny muted">未取得</span></div>
      <div class="topactions"><a class="btn" href="/db-master">DB MASTER</a><button id="reload" class="btn">再読込</button><button id="refresh" class="btn primary">Steamを再取得</button><button id="logout" class="btn">ログアウト</button></div>
    </div></header>
    <main class="page">
      <section id="stats" class="stats"></section>
      <div class="controls">
        <input id="search" placeholder="作品名 / AppID / タグで検索" />
        <select id="saleFilter"><option value="sale">セール中</option><option value="all">Steam登録作品すべて</option><option value="under500">500円以下</option><option value="half">50%以上OFF</option><option value="error">取得失敗</option></select>
        <select id="statusFilter"><option value="all">公開・下書きすべて</option><option value="published">公開のみ</option><option value="draft">下書きのみ</option></select>
        <select id="sort"><option value="discount">割引率が高い順</option><option value="price">価格が安い順</option><option value="title">作品名順</option></select>
        <span id="count" class="tiny muted"></span>
      </div>
      <div id="table" class="tablewrap"></div>
      <div class="note">価格は日本向けSteamストア情報から取得します。Steam側の応答、地域制限、未発売・販売停止などにより価格が取れない作品があります。通常取得は15分キャッシュ、再取得ボタンで強制更新します。</div>
    </main>
  </div>
  <div id="toast" class="toast"></div>
<script>
  const $=s=>document.querySelector(s); const KEY='harfway-admin-key'; let key=''; let data={rows:[],summary:{}};
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function toast(m){const el=$('#toast');el.textContent=m;el.classList.add('on');setTimeout(()=>el.classList.remove('on'),1800)}
  function showLogin(msg=''){ $('#login').classList.remove('hide');$('#app').classList.add('hide');$('#loginMsg').textContent=msg; }
  function showApp(){ $('#login').classList.add('hide');$('#app').classList.remove('hide'); }
  async function api(refresh=false){const r=await fetch('/api/steam-sale'+(refresh?'?refresh=1':''),{headers:{'x-showcase-admin-key':key}});const j=await r.json().catch(()=>({}));if(r.status===401){sessionStorage.removeItem(KEY);key='';showLogin(j.error||'管理キーが無効です');throw Error(j.error||'Unauthorized')}if(!r.ok)throw Error(j.error||`HTTP ${r.status}`);return j}
  async function load(refresh=false){$('#connection').textContent=refresh?'Steamを再取得中…':'取得中…';try{data=await api(refresh);$('#connection').textContent=`更新 ${new Date(data.updatedAt).toLocaleString('ja-JP')} / JP`;render();if(refresh)toast('Steam価格を更新しました')}catch(e){$('#connection').textContent='取得失敗';toast(e.message||'取得失敗')}}
  function renderStats(){const s=data.summary||{};const items=[['Steam作品',s.steamGames],['価格取得',s.priced],['セール中',s.onSale],['500円以下',s.under500],['50%以上OFF',s.halfOff],['取得失敗',s.errors]];$('#stats').innerHTML=items.map(x=>`<div class="stat"><span>${esc(x[0])}</span><b>${Number(x[1]||0)}</b></div>`).join('')}
  function filtered(){let rows=[...(data.rows||[])];const q=$('#search').value.trim().toLowerCase(),f=$('#saleFilter').value,st=$('#statusFilter').value,sort=$('#sort').value;rows=rows.filter(r=>{if(st!=='all'&&r.status!==st)return false;const p=r.price||{};if(f==='sale'&&!p.onSale)return false;if(f==='under500'&&!(p.onSale&&Number.isFinite(p.finalYen)&&p.finalYen<=500))return false;if(f==='half'&&!(p.onSale&&Number(p.discountPercent||0)>=50))return false;if(f==='error'&&p.ok!==false)return false;if(q&&!([r.title,r.id,r.appid,r.category,...(r.tags||[])].join(' ').toLowerCase().includes(q)))return false;return true});rows.sort((a,b)=>{if(sort==='title')return a.title.localeCompare(b.title,'ja');if(sort==='price'){const ap=Number.isFinite(a.price?.finalYen)?a.price.finalYen:Infinity,bp=Number.isFinite(b.price?.finalYen)?b.price.finalYen:Infinity;return ap-bp||a.title.localeCompare(b.title,'ja')}return Number(b.price?.discountPercent||0)-Number(a.price?.discountPercent||0)||a.title.localeCompare(b.title,'ja')});return rows}
  function renderTable(){const rows=filtered();$('#count').textContent=`${rows.length}件`;if(!rows.length){$('#table').innerHTML='<div class="empty">条件に一致する作品がありません。</div>';return}$('#table').innerHTML=`<table><thead><tr><th>作品</th><th>状態</th><th>通常価格</th><th>現在価格</th><th>割引</th><th>タグ</th><th>リンク</th></tr></thead><tbody>${rows.map(r=>{const p=r.price||{};const under=p.onSale&&Number.isFinite(p.finalYen)&&p.finalYen<=500;const cls=`${p.onSale?'sale':''} ${under?'under500':''}`;const normal=p.ok?(p.initialFormatted||'—'):`<span class="error">${esc(p.error||'取得失敗')}</span>`;const current=p.ok?(p.finalFormatted||'—'):'—';return `<tr class="${cls}"><td><div class="game">${esc(r.title||p.steamName||'タイトルなし')}</div><div class="sub">AppID ${esc(r.appid)} / ${esc(r.id)}</div></td><td><span class="pill">${r.status==='published'?'公開':'下書き'}</span></td><td class="price">${normal}</td><td class="price">${current}</td><td>${p.onSale?`<span class="discount">-${Number(p.discountPercent||0)}%</span>`:'—'}</td><td>${(r.tags||[]).slice(0,4).map(t=>`<span class="pill">${esc(t)}</span>`).join(' ')||'—'}</td><td><a href="${esc(r.steamUrl)}" target="_blank" rel="noopener">Steam</a>${r.articleUrl?` · <a href="${esc(r.articleUrl)}" target="_blank" rel="noopener">記事</a>`:''}</td></tr>`}).join('')}</tbody></table>`}
  function render(){renderStats();renderTable()}
  $('#loginForm').addEventListener('submit',async e=>{e.preventDefault();key=$('#key').value.trim();if(!key)return;sessionStorage.setItem(KEY,key);showApp();await load(false)});$('#reload').onclick=()=>load(false);$('#refresh').onclick=()=>load(true);$('#logout').onclick=()=>{sessionStorage.removeItem(KEY);key='';showLogin('ログアウトしました')};['search','saleFilter','statusFilter','sort'].forEach(id=>$('#'+id).addEventListener(id==='search'?'input':'change',renderTable));
  key=sessionStorage.getItem(KEY)||'';if(key){showApp();load(false)}else showLogin();
</script>
</body>
</html>
