---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>HARF-WAY / SALE WATCH</title>
<style>
:root{color-scheme:dark;--bg:#090a0c;--panel:#111318;--panel2:#0d0f13;--line:#2b3038;--muted:#929aa6;--text:#f5f5f0;--lime:#efff35;--green:#76e89a;--amber:#ffca69;--red:#ff7777;--blue:#7ebaff;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
*{box-sizing:border-box}html,body{margin:0;max-width:100%;overflow-x:hidden}body{background:var(--bg);color:var(--text)}a{color:inherit}.top{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 18px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.96);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.06em}.brand small{display:block;color:var(--muted);font-size:9px;margin-top:2px}.actions{display:flex;gap:7px;flex-wrap:wrap}.btn{border:1px solid #3a414b;border-radius:9px;background:#15181d;color:#fff;min-height:38px;padding:8px 11px;font:900 10px/1 inherit;text-decoration:none;cursor:pointer}.btn.primary{background:var(--lime);border-color:var(--lime);color:#090a0c}.wrap{width:min(1460px,100%);margin:auto;padding:22px 20px 70px}.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;padding:14px 0 22px}.ey{color:var(--lime);font-size:10px;font-weight:950;letter-spacing:.14em}.hero h1{margin:6px 0 0;font-size:clamp(34px,4.8vw,62px);line-height:.95;letter-spacing:-.055em}.hero p{max-width:660px;margin:0;color:var(--muted);font-size:11px;line-height:1.75}.state{margin-top:7px;font:10px/1.5 ui-monospace,monospace;color:var(--muted)}.sectionTitle{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:6px 0 10px}.sectionTitle h2{margin:0;font-size:13px;letter-spacing:.05em}.sectionTitle p{margin:0;color:var(--muted);font-size:9px}.focus{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-bottom:16px}.focusCard{appearance:none;width:100%;text-align:left;border:1px solid var(--line);border-radius:15px;background:var(--panel);padding:16px;cursor:pointer;color:inherit}.focusCard.active{border-color:var(--lime)}.focusCard small{display:block;color:var(--muted);font-size:9px;font-weight:900}.focusCard b{display:block;font-size:38px;letter-spacing:-.05em;margin:8px 0 3px}.focusCard span{font-size:9px;color:var(--muted)}.focusCard.sale b{color:var(--lime)}.focusCard.cheap b{color:var(--green)}.focusCard.missing b{color:var(--amber)}.overview{display:grid;grid-template-columns:1.4fr 1fr;gap:10px;margin-bottom:16px}.panel{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px;min-width:0}.miniStats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.mini{border:1px solid var(--line);background:var(--panel2);border-radius:10px;padding:11px}.mini small{display:block;color:var(--muted);font-size:8px}.mini b{display:block;font-size:22px;margin-top:5px}.sources{display:flex;gap:7px;flex-wrap:wrap}.sourceBtn{appearance:none;border:1px solid var(--line);border-radius:999px;background:#0d0f13;color:#d7dce3;padding:8px 10px;font:900 9px/1 inherit;cursor:pointer}.sourceBtn b{margin-left:5px}.sourceBtn.active{border-color:var(--lime);color:var(--lime)}.toolbar{display:grid;grid-template-columns:minmax(250px,1fr) minmax(150px,190px) minmax(150px,190px) auto;gap:8px;align-items:center}.toolbar input,.toolbar select{width:100%;min-width:0;min-height:42px;border:1px solid var(--line);border-radius:9px;background:#14171c;color:#fff;padding:8px 10px;font-size:10px}.quick{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.quickBtn{appearance:none;border:1px solid #343b44;border-radius:8px;background:#11141a;color:#cfd5dc;padding:7px 9px;font:900 9px/1 inherit;cursor:pointer}.quickBtn.active{background:var(--lime);border-color:var(--lime);color:#090a0c}.progress{height:4px;margin-top:11px;background:#1d2228;border-radius:999px;overflow:hidden}.progress span{display:block;height:100%;width:0;background:var(--lime);transition:width .2s}.count{display:flex;justify-content:space-between;gap:12px;margin-top:7px;color:var(--muted);font-size:9px}.hint{padding:10px 12px;border:1px solid #514725;border-radius:10px;background:#17140b;color:#d8cda2;font-size:9px;line-height:1.6;margin-top:10px}
.cardGrid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:14px!important;width:100%!important;margin-top:12px!important;align-items:stretch!important}.card{display:flex!important;flex-direction:column!important;min-width:0!important;overflow:hidden!important;border:1px solid var(--line)!important;border-radius:15px!important;background:var(--panel)!important}.card.sale{border-color:#697423!important}.card.missing{border-color:#6b582d!important}.media{position:relative!important;width:100%!important;height:170px!important;overflow:hidden!important;background:#0d0f13!important;border-bottom:1px solid #22272e!important}.media img{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;object-fit:cover!important;object-position:center!important;display:block!important;max-width:none!important}.badge{position:absolute;z-index:2;top:10px;left:10px;padding:7px 9px;border-radius:999px;background:rgba(9,10,12,.9);border:1px solid rgba(255,255,255,.12);font:950 9px/1 ui-monospace,monospace}.badge.sale{background:var(--lime);color:#090a0c;border-color:var(--lime)}.badge.warn{color:var(--amber)}.body{display:flex;flex-direction:column;gap:10px;padding:14px;flex:1}.title{font-weight:950;font-size:16px;line-height:1.35;overflow-wrap:anywhere}.sourceLine{display:flex;gap:5px;flex-wrap:wrap}.chip{display:inline-flex;align-items:center;border:1px solid #3c444e;border-radius:999px;padding:5px 7px;font:850 8px/1 ui-monospace,monospace}.chip.ways{color:var(--blue);border-color:#3d5d78}.chip.playlist{color:var(--lime);border-color:#5b6423}.chip.article{color:var(--amber);border-color:#6b572c}.chip.yorimichi{color:#f298c7;border-color:#71465d}.chip.playlistCode{color:#cbd1d9}.priceBlock{padding:12px;border:1px solid #272c33;border-radius:11px;background:#0d0f13}.priceTop{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}.priceNow{font-size:25px;font-weight:950;letter-spacing:-.04em}.discount{font-size:17px;font-weight:950;color:var(--lime)}.old{margin-top:4px;color:var(--muted);font-size:10px}.message{font-size:11px;color:#d8dde4;line-height:1.6}.meta{color:var(--muted);font:9px/1.5 ui-monospace,monospace}.actionsCard{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto;padding-top:2px}.actionsCard a,.retry{border:1px solid #363d47;border-radius:8px;padding:8px 10px;background:#13161b;color:#fff;text-decoration:none;font-size:9px;font-weight:900;cursor:pointer}.actionsCard a.steam{border-color:#586421;color:var(--lime)}.retry{border-color:#67582f;color:var(--amber)}.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:42px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
@media(max-width:1050px){.overview{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr 1fr}.cardGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:680px){.top{align-items:flex-start;flex-direction:column}.hero{display:block}.hero p{margin-top:14px}.focus,.miniStats,.toolbar{grid-template-columns:1fr}.wrap{padding:18px 12px 50px}.count{display:block}.cardGrid{grid-template-columns:1fr!important}.media{height:190px!important}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / SALE WATCH<small>Steamセール管理 / Shared Content Core</small></div><div class="actions"><a class="btn" href="/db-master-core" target="_blank">CORE DB ↗</a><a class="btn" href="/sales" target="_blank">読者向けページ ↗</a><button class="btn primary" id="reload">最新情報を取得</button></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">SALE WATCH ADMIN</div><h1>いま見るべき<br>セール情報。</h1></div><div><p>HARF-WAYで紹介したゲームを横断して、現在のSteamセールとSteam情報の抜けを確認します。</p><div id="state" class="state">Coreを読み込み中…</div></div></section>
<div class="sectionTitle"><h2>今見るべきもの</h2><p>クリックすると一覧を絞り込みます</p></div>
<section class="focus"><button class="focusCard sale" data-preset="sale"><small>🔥 現在セール中</small><b id="onsale">—</b><span>いま読者に出せる作品</span></button><button class="focusCard cheap" data-preset="cheap"><small>💴 500円以下</small><b id="under500">—</b><span>価格訴求しやすい作品</span></button><button class="focusCard missing" data-preset="missing"><small>⚠ Steam未登録</small><b id="missing">—</b><span>情報を補完したい作品</span></button></section>
<div class="sectionTitle"><h2>全体状況</h2><p>Coreの登録状態</p></div>
<section class="overview"><div class="panel"><div class="miniStats"><div class="mini"><small>紹介ゲーム総数</small><b id="total">—</b></div><div class="mini"><small>Steam紐付け済み</small><b id="linked">—</b></div><div class="mini"><small>価格取得待ち</small><b id="errors">—</b></div></div></div><div class="panel"><div class="sources"><button class="sourceBtn active" data-source="all">すべて <b id="srcAll">—</b></button><button class="sourceBtn" data-source="ways">WAYS <b id="srcWays">—</b></button><button class="sourceBtn" data-source="playlist">プレイリスト <b id="srcPlaylist">—</b></button><button class="sourceBtn" data-source="article">記事 <b id="srcArticle">—</b></button><button class="sourceBtn" data-source="yorimichi">ヨリミチ <b id="srcYorimichi">—</b></button></div></div></section>
<div class="sectionTitle"><h2>作品一覧</h2><p>価格と紹介元だけをシンプルに表示</p></div>
<section class="panel"><div class="toolbar"><input id="q" placeholder="作品名 / AppID / タグで検索"/><select id="link"><option value="all">Steam状態：すべて</option><option value="linked">Steamあり</option><option value="missing">Steamなし</option><option value="article-missing">記事あり / Steamなし</option></select><select id="sale"><option value="all">価格状態：すべて</option><option value="sale">セール中</option><option value="cheap">500円以下</option><option value="regular">通常価格</option><option value="unchecked">価格取得待ち</option></select><button class="btn" id="resolve">記事からSteamを探す</button></div><div class="quick"><button class="quickBtn active" data-preset="all">すべて</button><button class="quickBtn" data-preset="sale">セール中</button><button class="quickBtn" data-preset="cheap">500円以下</button><button class="quickBtn" data-preset="missing">Steam未登録</button></div><div class="progress"><span id="bar"></span></div><div class="count"><span id="count"></span><span>セール作品を優先表示</span></div><div id="hint" class="hint" hidden></div></section>
<div id="rows" class="cardGrid"><div class="empty">読み込み中…</div></div>
</main>
<script>
const $=s=>document.querySelector(s);let catalog=[],prices={},resolved={},busy=false,activeSource='all',activePreset='all';
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const chunk=(a,n)=>{const o=[];for(let i=0;i<a.length;i+=n)o.push(a.slice(i,i+n));return o};
const appidOf=r=>String(r.appid||resolved[r.articleUrl]?.appid||'');
const priceOf=r=>prices[appidOf(r)]||null;
const isSale=p=>Boolean(p?.ok&&p.onSale),isCheap=p=>Boolean(p?.ok&&Number.isFinite(p.finalYen)&&p.finalYen<=500),isMissing=r=>!appidOf(r);
const countSource=n=>n==='all'?catalog.length:catalog.filter(r=>(r.sources||[]).includes(n)).length;
function placeholder(title=''){const t=(title||'?').trim().slice(0,1).toUpperCase()||'?';const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360"><rect width="640" height="360" fill="#111318"/><text x="320" y="210" text-anchor="middle" font-size="120" font-family="Arial" fill="#efff35">${t}</text></svg>`;return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`}
function thumbOf(r){const p=priceOf(r),id=appidOf(r);return p?.headerImage||r.thumbnailUrl||r.thumbnail||r.imageUrl||r.image||r.coverUrl||r.cover||r.eyecatch||r.eyecatchUrl||(id?`https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${id}/header.jpg`:'')||placeholder(r.title)}
function sourceChip(s){const l={ways:'WAYS',playlist:'PLAYLIST',article:'記事',yorimichi:'ヨリミチ'};return `<span class="chip ${esc(s)}">${esc(l[s]||s)}</span>`}
function updateStats(){const linked=catalog.filter(r=>appidOf(r)).length,checked=catalog.map(priceOf).filter(Boolean);$('#total').textContent=catalog.length;$('#linked').textContent=linked;$('#missing').textContent=catalog.length-linked;$('#onsale').textContent=checked.filter(isSale).length;$('#under500').textContent=checked.filter(isCheap).length;$('#errors').textContent=checked.filter(p=>!p?.ok||!p?.priceAvailable).length;$('#srcAll').textContent=countSource('all');$('#srcWays').textContent=countSource('ways');$('#srcPlaylist').textContent=countSource('playlist');$('#srcArticle').textContent=countSource('article');$('#srcYorimichi').textContent=countSource('yorimichi')}
function sync(){document.querySelectorAll('[data-source]').forEach(e=>e.classList.toggle('active',e.dataset.source===activeSource));document.querySelectorAll('[data-preset]').forEach(e=>e.classList.toggle('active',e.dataset.preset===activePreset))}
function filtered(){const q=$('#q').value.trim().toLowerCase(),link=$('#link').value,sale=$('#sale').value;return catalog.filter(r=>{const id=appidOf(r),p=priceOf(r),hay=[r.title,r.category,id,...(r.tags||[]),...(r.playlists||[])].join(' ').toLowerCase();if(q&&!hay.includes(q))return false;if(activeSource!=='all'&&!(r.sources||[]).includes(activeSource))return false;if(link==='linked'&&!id)return false;if(link==='missing'&&id)return false;if(link==='article-missing'&&(!r.articleUrl||id))return false;if(sale==='sale'&&!isSale(p))return false;if(sale==='cheap'&&!isCheap(p))return false;if(sale==='regular'&&!(p?.ok&&p.priceAvailable&&!p.onSale))return false;if(sale==='unchecked'&&(p?.ok&&p.priceAvailable))return false;return true}).sort((a,b)=>{const pa=priceOf(a),pb=priceOf(b),rank=(r,p)=>isSale(p)?0:isCheap(p)?1:isMissing(r)?2:(p?.ok&&p.priceAvailable?3:4);const d=rank(a,pa)-rank(b,pb);if(d)return d;if(isSale(pa)&&isSale(pb)){const x=Number(pb.discountPercent||0)-Number(pa.discountPercent||0);if(x)return x}return String(a.title||'').localeCompare(String(b.title||''),'ja')})}
function priceBlock(p,id){if(!id)return `<div class="priceBlock"><div class="message">Steam情報がまだ登録されていません。</div></div>`;if(!p)return `<div class="priceBlock"><div class="message">価格を確認中…</div></div>`;if(!p.ok)return `<div class="priceBlock"><div class="message">価格を取得できませんでした。再取得できます。</div></div>`;if(!p.priceAvailable){const msg=p.availability==='coming_soon'?'未発売のため価格情報がありません。':'現在、日本向け価格を取得できません。';return `<div class="priceBlock"><div class="message">${msg}</div></div>`}if(p.isFree)return `<div class="priceBlock"><div class="priceTop"><span class="priceNow">無料</span></div></div>`;if(p.onSale)return `<div class="priceBlock"><div class="priceTop"><span class="priceNow">${esc(p.finalFormatted||'')}</span><span class="discount">-${Number(p.discountPercent||0)}%</span></div><div class="old"><s>${esc(p.initialFormatted||'')}</s></div></div>`;return `<div class="priceBlock"><div class="priceTop"><span class="priceNow">${esc(p.finalFormatted||'')}</span></div></div>`}
function render(){updateStats();const rows=filtered();$('#count').textContent=`${rows.length} / ${catalog.length}作品`;const hint=$('#hint');if(activePreset==='missing'){hint.hidden=false;hint.textContent='Steam未登録の作品です。「記事からSteamを探す」で記事本文のSteamリンクを探せます。'}else{hint.hidden=true}if(!rows.length){$('#rows').innerHTML='<div class="empty">条件に合う作品はありません。</div>';return}$('#rows').innerHTML=rows.map(r=>{const id=appidOf(r),p=priceOf(r),found=!r.appid&&Boolean(id),sale=isSale(p),missing=!id;const badge=missing?'Steam未登録':sale?`-${Number(p.discountPercent||0)}%`:p?.ok&&p.priceAvailable?(p.isFree?'無料':'通常価格'):p?'要確認':'確認中';const badgeClass=sale?'sale':(!p?.ok||!p?.priceAvailable||missing?'warn':'');const steam=id?`https://store.steampowered.com/app/${id}/`:'';const src=(r.sources||[]).map(sourceChip).join('');const playlists=(r.playlists||[]).map(v=>`<span class="chip playlistCode">${esc(v)}</span>`).join('');const links=[r.articleUrl?`<a href="${esc(r.articleUrl)}" target="_blank" rel="noopener">記事を見る ↗</a>`:'',steam?`<a class="steam" href="${steam}" target="_blank" rel="noopener">Steam ↗</a>`:'',r.storeUrl&&!steam?`<a href="${esc(r.storeUrl)}" target="_blank" rel="noopener">ストア ↗</a>`:''].filter(Boolean).join('');const retry=id&&p&&(!p.ok||!p.priceAvailable)?`<button class="retry" data-retry="${id}">再取得</button>`:'';const meta=id?`Steam ${id}${found?' / 記事から発見':''}`:'Steam未紐付け';return `<article class="card ${sale?'sale':''} ${missing?'missing':''}"><div class="media"><img src="${esc(thumbOf(r))}" alt="${esc(r.title)}" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='${placeholder(r.title)}'"/><span class="badge ${badgeClass}">${esc(badge)}</span></div><div class="body"><div><div class="title">${esc(r.title)}</div><div class="sourceLine">${src}${playlists}</div></div>${priceBlock(p,id)}<div class="meta">${esc(meta)}</div><div class="actionsCard">${links}${retry}</div></div></article>`}).join('')}
async function fetchPriceGroup(ids,force=false){const qs=new URLSearchParams({appids:ids.join(',')});if(force)qs.set('refresh','1');const res=await fetch(`/api/steam-prices-public?${qs}`,{cache:force?'no-store':'default'});const data=await res.json();if(data.ok)Object.assign(prices,data.prices||{});return data}
async function loadPrices(force=false){const ids=[...new Set(catalog.map(appidOf).filter(Boolean))];let done=0;for(const group of chunk(ids,8)){try{await fetchPriceGroup(group,force)}catch{}done+=group.length;$('#bar').style.width=`${ids.length?Math.min(100,done/ids.length*100):100}%`;$('#state').textContent=`Steam価格を確認中… ${done}/${ids.length}`;render()}$('#state').textContent=`更新完了 / ${catalog.length}作品を監視中`;busy=false}
async function load(force=false){if(busy)return;busy=true;prices={};resolved={};activeSource='all';activePreset='all';$('#bar').style.width='0%';sync();$('#state').textContent='Shared Content Coreを読み込み中…';try{const res=await fetch('/api/sales-catalog',{cache:'no-store'}),data=await res.json();if(!res.ok||!data.ok)throw new Error(data.error||'catalog_failed');catalog=data.rows||[];render();await loadPrices(force)}catch(e){busy=false;$('#state').textContent=`ERROR: ${e.message}`;$('#rows').innerHTML='<div class="empty">SALE WATCHデータを取得できませんでした。</div>'}}
async function resolveArticles(){const targets=catalog.filter(r=>!appidOf(r)&&r.articleUrl).slice(0,80);if(!targets.length){$('#state').textContent='Steam未登録の記事はありません。';return}$('#state').textContent=`記事 ${targets.length}件からSteamリンクを探索中…`;let done=0;for(const group of chunk(targets,4)){const q=group.map(r=>`u=${encodeURIComponent(r.articleUrl)}`).join('&');try{const res=await fetch(`/api/article-steam-public?${q}`),data=await res.json();for(const hit of data.rows||[])if(hit?.url)resolved[hit.url]=hit}catch{}done+=group.length;$('#bar').style.width=`${Math.min(100,done/targets.length*100)}%`;render()}prices={};await loadPrices(true)}
async function retryOne(id,button){if(button){button.disabled=true;button.textContent='取得中…'}try{await fetchPriceGroup([id],true);render()}finally{if(button){button.disabled=false;button.textContent='再取得'}}}
function setPreset(v){activePreset=v;$('#link').value='all';$('#sale').value='all';if(v==='sale')$('#sale').value='sale';else if(v==='cheap')$('#sale').value='cheap';else if(v==='missing')$('#link').value='missing';sync();render()}
document.querySelectorAll('[data-preset]').forEach(e=>e.addEventListener('click',()=>setPreset(e.dataset.preset)));document.querySelectorAll('[data-source]').forEach(e=>e.addEventListener('click',()=>{activeSource=e.dataset.source;sync();render()}));$('#q').addEventListener('input',render);$('#link').addEventListener('change',()=>{activePreset='all';sync();render()});$('#sale').addEventListener('change',()=>{activePreset='all';sync();render()});$('#reload').addEventListener('click',()=>load(true));$('#resolve').addEventListener('click',resolveArticles);$('#rows').addEventListener('click',e=>{const b=e.target.closest('[data-retry]');if(b)retryOne(b.dataset.retry,b)});load(false);
</script>
</body>
</html>
