---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>HARF-WAY / SALE WATCH</title>
<style>
:root{color-scheme:dark;--bg:#090a0c;--panel:#111318;--panel2:#0d0f13;--line:#2b3038;--muted:#929aa6;--text:#f5f5f0;--lime:#efff35;--green:#76e89a;--amber:#ffca69;--red:#ff7777;--blue:#7ebaff;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
*{box-sizing:border-box}html,body{margin:0;max-width:100%;overflow-x:hidden}body{background:var(--bg);color:var(--text)}a{color:inherit}.sw-top{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 18px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.96);backdrop-filter:blur(14px)}.sw-brand{font-weight:950;letter-spacing:.06em}.sw-brand small{display:block;color:var(--muted);font-size:9px;margin-top:2px;letter-spacing:.02em}.sw-actions{display:flex;gap:7px;flex-wrap:wrap}.sw-btn{border:1px solid #3a414b;border-radius:9px;background:#15181d;color:#fff;min-height:38px;padding:8px 11px;font:900 10px/1 inherit;text-decoration:none;cursor:pointer}.sw-btn.primary{background:var(--lime);border-color:var(--lime);color:#090a0c}.sw-wrap{width:min(1460px,100%);margin:auto;padding:22px 20px 70px}.sw-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;padding:14px 0 22px}.sw-ey{color:var(--lime);font-size:10px;font-weight:950;letter-spacing:.14em}.sw-hero h1{margin:6px 0 0;font-size:clamp(34px,4.8vw,62px);line-height:.95;letter-spacing:-.055em}.sw-hero p{max-width:660px;margin:0;color:var(--muted);font-size:11px;line-height:1.75}.sw-state{margin-top:7px;font:10px/1.5 ui-monospace,monospace;color:var(--muted)}.sw-section-title{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:6px 0 10px}.sw-section-title h2{margin:0;font-size:13px;letter-spacing:.05em}.sw-section-title p{margin:0;color:var(--muted);font-size:9px}.sw-focus{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-bottom:16px}.sw-focus-card{appearance:none;width:100%;text-align:left;border:1px solid var(--line);border-radius:15px;background:var(--panel);padding:16px;cursor:pointer;color:inherit}.sw-focus-card:hover{border-color:#515966}.sw-focus-card.active{border-color:var(--lime);box-shadow:inset 0 0 0 1px rgba(239,255,53,.08)}.sw-focus-card small{display:block;color:var(--muted);font-size:9px;font-weight:900}.sw-focus-card b{display:block;font-size:38px;letter-spacing:-.05em;margin:8px 0 3px}.sw-focus-card span{font-size:9px;color:var(--muted)}.sw-focus-card.sale b{color:var(--lime)}.sw-focus-card.cheap b{color:var(--green)}.sw-focus-card.missing b{color:var(--amber)}.sw-overview{display:grid;grid-template-columns:1.4fr 1fr;gap:10px;margin-bottom:16px}.sw-panel{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px;min-width:0}.sw-mini-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.sw-mini{border:1px solid var(--line);background:var(--panel2);border-radius:10px;padding:11px;min-width:0}.sw-mini small{display:block;color:var(--muted);font-size:8px}.sw-mini b{display:block;font-size:22px;margin-top:5px}.sw-sources{display:flex;gap:7px;flex-wrap:wrap}.sw-source-btn{appearance:none;border:1px solid var(--line);border-radius:999px;background:#0d0f13;color:#d7dce3;padding:8px 10px;font:900 9px/1 inherit;cursor:pointer}.sw-source-btn b{margin-left:5px}.sw-source-btn.active{border-color:var(--lime);color:var(--lime)}.sw-toolbar{display:grid;grid-template-columns:minmax(250px,1fr) minmax(150px,190px) minmax(150px,190px) auto;gap:8px;align-items:center}.sw-toolbar input,.sw-toolbar select{width:100%;min-width:0;min-height:42px;border:1px solid var(--line);border-radius:9px;background:#14171c;color:#fff;padding:8px 10px;font-size:10px}.sw-quick{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.sw-quick-btn{appearance:none;border:1px solid #343b44;border-radius:8px;background:#11141a;color:#cfd5dc;padding:7px 9px;font:900 9px/1 inherit;cursor:pointer}.sw-quick-btn.active{background:var(--lime);border-color:var(--lime);color:#090a0c}.sw-progress{height:4px;margin-top:11px;background:#1d2228;border-radius:999px;overflow:hidden}.sw-progress span{display:block;height:100%;width:0;background:var(--lime);transition:width .2s}.sw-count{display:flex;justify-content:space-between;gap:12px;margin-top:7px;color:var(--muted);font-size:9px}.sw-legend{display:flex;gap:12px;flex-wrap:wrap}.sw-legend i{font-style:normal}.sw-hint{padding:10px 12px;border:1px solid #514725;border-radius:10px;background:#17140b;color:#d8cda2;font-size:9px;line-height:1.6;margin-top:10px}
.sw-card-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:14px!important;width:100%!important;max-width:100%!important;margin-top:12px!important;align-items:start!important}.sw-card{display:flex!important;flex-direction:column!important;width:100%!important;min-width:0!important;max-width:100%!important;overflow:hidden!important;border:1px solid var(--line)!important;border-radius:15px!important;background:var(--panel)!important}.sw-card.sale{border-color:#697423!important}.sw-card.missing{border-color:#6b582d!important}.sw-card-media{position:relative!important;width:100%!important;height:170px!important;min-height:170px!important;max-height:170px!important;overflow:hidden!important;background:#0d0f13!important;border-bottom:1px solid #22272e!important}.sw-card-img{position:absolute!important;inset:0!important;display:block!important;width:100%!important;height:100%!important;min-width:100%!important;min-height:100%!important;max-width:100%!important;max-height:100%!important;object-fit:cover!important;object-position:center!important;margin:0!important;padding:0!important;border:0!important}.sw-card-badge{position:absolute;z-index:2;top:9px;left:9px;padding:6px 8px;border-radius:999px;background:rgba(9,10,12,.88);border:1px solid rgba(255,255,255,.1);font:900 8px/1 ui-monospace,monospace;backdrop-filter:blur(8px)}.sw-card-body{display:flex!important;flex-direction:column!important;gap:10px!important;padding:13px!important;min-width:0!important;flex:1!important}.sw-card-title{font-weight:950;font-size:15px;line-height:1.35;overflow-wrap:anywhere}.sw-card-sub{color:var(--muted);font-size:8px;line-height:1.55;overflow-wrap:anywhere}.sw-card-label{color:var(--muted);font-size:8px;letter-spacing:.06em;margin-bottom:5px}.sw-chips,.sw-status-row{display:flex;gap:4px;flex-wrap:wrap}.sw-chip,.sw-status{display:inline-block;border:1px solid #3c444e;border-radius:999px;padding:5px 6px;font:850 8px/1 ui-monospace,monospace}.sw-chip.ways{color:var(--blue);border-color:#3d5d78}.sw-chip.playlist{color:var(--lime);border-color:#5b6423}.sw-chip.article{color:var(--amber);border-color:#6b572c}.sw-chip.yorimichi{color:#f298c7;border-color:#71465d}.sw-status.ok{color:var(--green);border-color:#356548}.sw-status.warn{color:var(--amber);border-color:#6b582d}.sw-status.bad{color:var(--red);border-color:#703d3d}.sw-status.sale{color:#090a0c;background:var(--lime);border-color:var(--lime)}.sw-card-price{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}.sw-card-discount{font-size:17px;font-weight:950;color:var(--lime)}.sw-card-price-now{font-size:21px;font-weight:950}.sw-card-price-old{font-size:9px;color:var(--muted);margin-top:3px}.sw-card-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:2px}.sw-card-actions a{border:1px solid #363d47;border-radius:8px;padding:8px 10px;background:#13161b;text-decoration:none;font-size:9px;font-weight:900}.sw-card-actions a.primary{border-color:#586421;color:var(--lime)}.sw-empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:42px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
@media(max-width:1050px){.sw-overview{grid-template-columns:1fr}.sw-toolbar{grid-template-columns:1fr 1fr}.sw-mini-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.sw-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.sw-card-media{height:160px!important;min-height:160px!important;max-height:160px!important}}
@media(max-width:680px){.sw-top{align-items:flex-start;flex-direction:column}.sw-hero{display:block}.sw-hero p{margin-top:14px}.sw-focus,.sw-mini-stats,.sw-toolbar{grid-template-columns:1fr}.sw-wrap{padding:18px 12px 50px}.sw-count{display:block}.sw-legend{margin-top:5px}.sw-card-grid{grid-template-columns:1fr!important}.sw-card-media{height:180px!important;min-height:180px!important;max-height:180px!important}}
</style>
</head>
<body>
<header class="sw-top"><div class="sw-brand">HARF-WAY / SALE WATCH<small>Steamセール管理 / Shared Content Core</small></div><div class="sw-actions"><a class="sw-btn" href="/db-master-core" target="_blank">CORE DB ↗</a><a class="sw-btn" href="/sales" target="_blank">読者向けページ ↗</a><button class="sw-btn primary" id="reload">最新情報を取得</button></div></header>
<main class="sw-wrap">
<section class="sw-hero"><div><div class="sw-ey">SALE WATCH ADMIN</div><h1>いま見るべき<br>セール情報。</h1></div><div><p>HARF-WAYで紹介したゲームを横断して、現在のSteamセールと「Steam情報が足りない作品」を確認します。</p><div id="state" class="sw-state">Coreを読み込み中…</div></div></section>
<div class="sw-section-title"><h2>今見るべきもの</h2><p>クリックすると一覧を絞り込みます</p></div>
<section class="sw-focus"><button class="sw-focus-card sale" data-preset="sale"><small>🔥 現在セール中</small><b id="onsale">—</b><span>いま読者に出せる作品</span></button><button class="sw-focus-card cheap" data-preset="cheap"><small>💴 500円以下</small><b id="under500">—</b><span>価格訴求しやすい作品</span></button><button class="sw-focus-card missing" data-preset="missing"><small>⚠ Steam未登録</small><b id="missing">—</b><span>情報を補完したい作品</span></button></section>
<div class="sw-section-title"><h2>全体状況</h2><p>Coreの登録状態</p></div>
<section class="sw-overview"><div class="sw-panel"><div class="sw-mini-stats"><div class="sw-mini"><small>紹介ゲーム総数</small><b id="total">—</b></div><div class="sw-mini"><small>Steam紐付け済み</small><b id="linked">—</b></div><div class="sw-mini"><small>価格取得エラー</small><b id="errors">—</b></div></div></div><div class="sw-panel"><div class="sw-sources"><button class="sw-source-btn active" data-source="all">すべて <b id="srcAll">—</b></button><button class="sw-source-btn" data-source="ways">WAYS <b id="srcWays">—</b></button><button class="sw-source-btn" data-source="playlist">プレイリスト <b id="srcPlaylist">—</b></button><button class="sw-source-btn" data-source="article">記事 <b id="srcArticle">—</b></button><button class="sw-source-btn" data-source="yorimichi">ヨリミチ <b id="srcYorimichi">—</b></button></div></div></section>
<div class="sw-section-title"><h2>作品一覧</h2><p>カードで作品ごとに確認</p></div>
<section class="sw-panel"><div class="sw-toolbar"><input id="q" placeholder="作品名 / AppID / タグで検索"/><select id="link"><option value="all">Steam状態：すべて</option><option value="linked">Steamあり</option><option value="missing">Steamなし</option><option value="article-missing">記事あり / Steamなし</option></select><select id="sale"><option value="all">価格状態：すべて</option><option value="sale">セール中</option><option value="cheap">500円以下</option><option value="regular">通常価格</option><option value="unchecked">未取得 / エラー</option></select><button class="sw-btn" id="resolve">記事からSteamを探す</button></div><div class="sw-quick"><button class="sw-quick-btn active" data-preset="all">すべて</button><button class="sw-quick-btn" data-preset="sale">セール中</button><button class="sw-quick-btn" data-preset="cheap">500円以下</button><button class="sw-quick-btn" data-preset="missing">Steam未登録</button></div><div class="sw-progress"><span id="bar"></span></div><div class="sw-count"><span id="count"></span><span class="sw-legend"><i>🟢 正常</i><i>🟡 要確認</i><i>🟢黄 セール</i></span></div><div id="hint" class="sw-hint" hidden></div></section>
<div id="rows" class="sw-card-grid"><div class="sw-empty">読み込み中…</div></div>
</main>
<script>
const $=s=>document.querySelector(s);let catalog=[],prices={},resolved={},busy=false,activeSource='all',activePreset='all';
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const chunk=(a,n)=>{const o=[];for(let i=0;i<a.length;i+=n)o.push(a.slice(i,i+n));return o};
const appidOf=r=>String(r.appid||resolved[r.articleUrl]?.appid||'');
const priceOf=r=>prices[appidOf(r)]||null;
const countSource=n=>n==='all'?catalog.length:catalog.filter(r=>(r.sources||[]).includes(n)).length;
const isCheap=p=>Boolean(p?.ok&&Number.isFinite(p.finalYen)&&p.finalYen<=500);
const isSale=p=>Boolean(p?.ok&&p.onSale);
function steamThumb(appid){return appid?`https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${appid}/header.jpg`:''}
function thumbOf(r){const appid=appidOf(r);return steamThumb(appid)||r.thumbnailUrl||r.thumbnail||r.thumbUrl||r.thumb||r.imageUrl||r.image||r.coverUrl||r.cover||r.eyecatch||r.eyecatchUrl||r.articleThumbnail||r.articleThumbnailUrl||''}
function updateStats(){const linked=catalog.filter(r=>appidOf(r)).length,checked=catalog.map(priceOf).filter(Boolean);$('#total').textContent=catalog.length;$('#linked').textContent=linked;$('#missing').textContent=catalog.length-linked;$('#onsale').textContent=checked.filter(isSale).length;$('#under500').textContent=checked.filter(isCheap).length;$('#errors').textContent=checked.filter(p=>!p?.ok).length;$('#srcAll').textContent=countSource('all');$('#srcWays').textContent=countSource('ways');$('#srcPlaylist').textContent=countSource('playlist');$('#srcArticle').textContent=countSource('article');$('#srcYorimichi').textContent=countSource('yorimichi')}
function syncControls(){document.querySelectorAll('[data-source]').forEach(el=>el.classList.toggle('active',el.dataset.source===activeSource));document.querySelectorAll('[data-preset]').forEach(el=>el.classList.toggle('active',el.dataset.preset===activePreset));if(activePreset==='sale')$('#sale').value='sale';else if(activePreset==='cheap')$('#sale').value='cheap';else if(activePreset==='missing'){$('#sale').value='all';$('#link').value='missing'}else{$('#sale').value='all';if($('#link').value==='missing')$('#link').value='all'}}
function filteredRows(){const q=$('#q').value.trim().toLowerCase(),link=$('#link').value,sale=$('#sale').value;return catalog.filter(r=>{const appid=appidOf(r),p=priceOf(r),hay=[r.title,r.category,appid,...(r.tags||[]),...(r.playlists||[])].join(' ').toLowerCase();if(q&&!hay.includes(q))return false;if(activeSource!=='all'&&!(r.sources||[]).includes(activeSource))return false;if(link==='linked'&&!appid)return false;if(link==='missing'&&appid)return false;if(link==='article-missing'&&(!r.articleUrl||appid))return false;if(sale==='sale'&&!isSale(p))return false;if(sale==='cheap'&&!isCheap(p))return false;if(sale==='regular'&&!(p?.ok&&!p.onSale))return false;if(sale==='unchecked'&&p?.ok)return false;return true}).sort((a,b)=>{const pa=priceOf(a),pb=priceOf(b);const rank=(r,p)=>isSale(p)?0:!appidOf(r)?1:isCheap(p)?2:3;const d=rank(a,pa)-rank(b,pb);if(d)return d;if(isSale(pa)&&isSale(pb)){const x=Number(pb.discountPercent||0)-Number(pa.discountPercent||0);if(x)return x}return String(a.title||'').localeCompare(String(b.title||''),'ja')})}
function sourceChip(n){const labels={ways:'WAYS',playlist:'PLAYLIST',article:'記事',yorimichi:'ヨリミチ'};return `<span class="sw-chip ${esc(n)}">${esc(labels[n]||String(n).toUpperCase())}</span>`}
function render(){updateStats();const rows=filteredRows();$('#count').textContent=`${rows.length} / ${catalog.length}作品を表示`;const hint=$('#hint');if(activePreset==='missing'){hint.hidden=false;hint.textContent='Steam未登録の作品です。「記事からSteamを探す」で記事本文にあるSteamリンクを探せます。'}else if(activePreset==='sale'){hint.hidden=false;hint.textContent='現在セール中の作品だけを表示しています。'}else if(activePreset==='cheap'){hint.hidden=false;hint.textContent='現在価格が500円以下の作品です。通常価格500円以下も含みます。'}else hint.hidden=true;if(!rows.length){$('#rows').innerHTML='<div class="sw-empty">条件に合う作品はありません。</div>';return}$('#rows').innerHTML=rows.map(r=>{const appid=appidOf(r),p=priceOf(r),found=!r.appid&&Boolean(appid),thumb=thumbOf(r),steamUrl=appid?`https://store.steampowered.com/app/${appid}/`:'';let badge='確認中',status='<span class="sw-status warn">確認中</span>',price='<span class="sw-status warn">価格未取得</span>',cls='sw-card';if(!appid){badge='Steam未登録';status='<span class="sw-status warn">Steam未登録</span>';cls+=' missing'}else if(p&&!p.ok){badge='取得エラー';status='<span class="sw-status bad">取得エラー</span>';price='<span class="sw-status bad">取得エラー</span>'}else if(p?.ok&&p.onSale){badge=`-${Number(p.discountPercent||0)}%`;status=`<span class="sw-status sale">-${Number(p.discountPercent||0)}% セール</span>`;price=`<div class="sw-card-price"><span class="sw-card-discount">-${Number(p.discountPercent||0)}%</span><span class="sw-card-price-now">${esc(p.finalFormatted||'')}</span></div><div class="sw-card-price-old"><s>${esc(p.initialFormatted||'')}</s></div>`;cls+=' sale'}else if(p?.ok){badge='通常';status='<span class="sw-status ok">通常価格</span>';price=`<div class="sw-card-price-now">${esc(p.finalFormatted||'')}</div><div class="sw-card-price-old">通常価格</div>`}const source=(r.sources||[]).map(sourceChip).join('')||'<span class="sw-card-sub">—</span>';const playlist=(r.playlists||[]).map(v=>`<span class="sw-chip playlist">${esc(v)}</span>`).join('')||'<span class="sw-card-sub">—</span>';const links=[r.articleUrl?`<a href="${esc(r.articleUrl)}" target="_blank" rel="noopener">記事 ↗</a>`:'',steamUrl?`<a class="primary" href="${esc(steamUrl)}" target="_blank" rel="noopener">Steam ↗</a>`:'',r.storeUrl&&!steamUrl?`<a href="${esc(r.storeUrl)}" target="_blank" rel="noopener">Store ↗</a>`:''].filter(Boolean).join('')||'<span class="sw-card-sub">リンクなし</span>';return `<article class="${cls}"><div class="sw-card-media">${thumb?`<img class="sw-card-img" src="${esc(thumb)}" alt="${esc(r.title)}" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none'">`:''}<span class="sw-card-badge">${esc(badge)}</span></div><div class="sw-card-body"><div><div class="sw-card-title">${esc(r.title)}</div><div class="sw-card-sub">${appid?`AppID ${esc(appid)}`:'Steam情報なし'}${found?' / 記事から発見':''}</div></div><div><div class="sw-card-label">紹介元</div><div class="sw-chips">${source}</div></div><div><div class="sw-card-label">Playlist</div><div class="sw-chips">${playlist}</div></div><div><div class="sw-card-label">現在価格</div>${price}</div><div><div class="sw-card-label">状態</div><div class="sw-status-row">${status}</div></div><div class="sw-card-actions">${links}</div></div></article>`}).join('')}
async function loadPrices(){const ids=[...new Set(catalog.map(appidOf).filter(Boolean))];let done=0;for(const group of chunk(ids,8)){try{const r=await fetch(`/api/steam-prices-public?appids=${encodeURIComponent(group.join(','))}`),j=await r.json();if(j.ok)Object.assign(prices,j.prices||{})}catch{}done+=group.length;$('#bar').style.width=`${ids.length?Math.min(100,done/ids.length*100):100}%`;$('#state').textContent=`Steam価格を確認中… ${done}/${ids.length}`;render()}$('#state').textContent=`更新完了 / ${catalog.length}作品を監視中`;busy=false}
async function load(){if(busy)return;busy=true;catalog=[];prices={};resolved={};activeSource='all';activePreset='all';$('#bar').style.width='0%';syncControls();$('#state').textContent='Shared Content Coreを読み込み中…';try{const r=await fetch('/api/sales-catalog',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'catalog_failed');catalog=j.rows||[];render();await loadPrices()}catch(e){busy=false;$('#state').textContent=`ERROR: ${e.message}`;$('#rows').innerHTML='<div class="sw-empty">SALE WATCHデータを取得できませんでした。</div>'}}
async function resolveArticles(){const targets=catalog.filter(r=>!appidOf(r)&&r.articleUrl).slice(0,80);if(!targets.length){$('#state').textContent='Steam未登録の記事はありません。';return}$('#state').textContent=`記事 ${targets.length}件からSteamリンクを探索中…`;let done=0;for(const group of chunk(targets,4)){const query=group.map(r=>`u=${encodeURIComponent(r.articleUrl)}`).join('&');try{const response=await fetch(`/api/article-steam-public?${query}`),data=await response.json();for(const hit of data.rows||[])if(hit?.url)resolved[hit.url]=hit}catch{}done+=group.length;$('#bar').style.width=`${Math.min(100,done/targets.length*100)}%`;render()}prices={};await loadPrices()}
function setPreset(v){activePreset=v;$('#link').value='all';$('#sale').value='all';if(v==='sale')$('#sale').value='sale';else if(v==='cheap')$('#sale').value='cheap';else if(v==='missing')$('#link').value='missing';syncControls();render()}
document.querySelectorAll('[data-preset]').forEach(el=>el.addEventListener('click',()=>setPreset(el.dataset.preset)));document.querySelectorAll('[data-source]').forEach(el=>el.addEventListener('click',()=>{activeSource=el.dataset.source;syncControls();render()}));$('#q').addEventListener('input',render);$('#link').addEventListener('change',()=>{activePreset='all';syncControls();render()});$('#sale').addEventListener('change',()=>{activePreset='all';syncControls();render()});$('#reload').addEventListener('click',load);$('#resolve').addEventListener('click',resolveArticles);load();
</script>
</body>
</html>