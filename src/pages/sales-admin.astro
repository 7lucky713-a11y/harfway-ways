---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>HARF-WAY / SALE WATCH ADMIN</title>
<style>
:root{color-scheme:dark;--bg:#090a0c;--panel:#111318;--panel2:#0d0f13;--line:#2b3038;--muted:#929aa6;--text:#f5f5f0;--lime:#efff35;--green:#76e89a;--amber:#ffca69;--red:#ff7777;--blue:#7ebaff;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}a{color:inherit}.top{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 18px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.96);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.06em}.brand small{display:block;color:var(--muted);font-size:9px;margin-top:2px;letter-spacing:.02em}.actions{display:flex;gap:7px;flex-wrap:wrap}.btn{border:1px solid #3a414b;border-radius:9px;background:#15181d;color:#fff;min-height:38px;padding:8px 11px;font:900 10px/1 inherit;text-decoration:none;cursor:pointer}.btn.primary{background:var(--lime);border-color:var(--lime);color:#090a0c}.wrap{max-width:1480px;margin:auto;padding:22px 20px 70px}.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;padding:14px 0 22px}.ey{color:var(--lime);font-size:10px;font-weight:950;letter-spacing:.14em}.hero h1{margin:6px 0 0;font-size:clamp(34px,4.8vw,62px);line-height:.95;letter-spacing:-.055em}.hero p{max-width:660px;margin:0;color:var(--muted);font-size:11px;line-height:1.75}.state{margin-top:7px;font:10px/1.5 ui-monospace,monospace;color:var(--muted)}.sectionTitle{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:6px 0 10px}.sectionTitle h2{margin:0;font-size:13px;letter-spacing:.05em}.sectionTitle p{margin:0;color:var(--muted);font-size:9px}.focus{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:16px}.focusCard{appearance:none;width:100%;text-align:left;border:1px solid var(--line);border-radius:15px;background:var(--panel);padding:16px;cursor:pointer;color:inherit}.focusCard:hover{border-color:#515966}.focusCard.active{border-color:var(--lime);box-shadow:inset 0 0 0 1px rgba(239,255,53,.08)}.focusCard small{display:block;color:var(--muted);font-size:9px;font-weight:900}.focusCard b{display:block;font-size:38px;letter-spacing:-.05em;margin:8px 0 3px}.focusCard span{font-size:9px;color:var(--muted)}.focusCard.sale b{color:var(--lime)}.focusCard.cheap b{color:var(--green)}.focusCard.missing b{color:var(--amber)}.overview{display:grid;grid-template-columns:1.4fr 1fr;gap:10px;margin-bottom:16px}.panel{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:14px}.miniStats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mini{border:1px solid var(--line);background:var(--panel2);border-radius:10px;padding:11px}.mini small{display:block;color:var(--muted);font-size:8px}.mini b{display:block;font-size:22px;margin-top:5px}.sources{display:flex;gap:7px;flex-wrap:wrap}.sourceBtn{appearance:none;border:1px solid var(--line);border-radius:999px;background:#0d0f13;color:#d7dce3;padding:8px 10px;font:900 9px/1 inherit;cursor:pointer}.sourceBtn b{margin-left:5px}.sourceBtn.active{border-color:var(--lime);color:var(--lime)}.toolbar{display:grid;grid-template-columns:minmax(250px,1fr) minmax(150px,190px) minmax(150px,190px) auto;gap:8px;align-items:center}.toolbar input,.toolbar select{min-height:42px;border:1px solid var(--line);border-radius:9px;background:#14171c;color:#fff;padding:8px 10px;font-size:10px}.quick{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.quickBtn{appearance:none;border:1px solid #343b44;border-radius:8px;background:#11141a;color:#cfd5dc;padding:7px 9px;font:900 9px/1 inherit;cursor:pointer}.quickBtn.active{background:var(--lime);border-color:var(--lime);color:#090a0c}.progress{height:4px;margin-top:11px;background:#1d2228;border-radius:999px;overflow:hidden}.progress span{display:block;height:100%;width:0;background:var(--lime);transition:width .2s}.count{display:flex;justify-content:space-between;gap:12px;margin-top:7px;color:var(--muted);font-size:9px}.legend{display:flex;gap:12px;flex-wrap:wrap}.legend i{font-style:normal}.hint{padding:10px 12px;border:1px solid #514725;border-radius:10px;background:#17140b;color:#d8cda2;font-size:9px;line-height:1.6;margin-top:10px}
.cardGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;margin-top:10px}.gameCard{border:1px solid var(--line);border-radius:16px;background:var(--panel);overflow:hidden;display:flex;flex-direction:column;min-width:0}.gameCard.saleCard{border-color:#697423;box-shadow:inset 0 0 0 1px rgba(239,255,53,.08)}.gameCard.missingCard{border-color:#6b582d}.thumbWrap{position:relative;aspect-ratio:16/9;background:#0d0f13;overflow:hidden;border-bottom:1px solid #22272e}.thumb{width:100%;height:100%;display:block;object-fit:cover}.thumbBadge{position:absolute;top:9px;left:9px;padding:6px 8px;border-radius:999px;background:rgba(9,10,12,.84);border:1px solid rgba(255,255,255,.1);font:900 8px/1 ui-monospace,monospace;backdrop-filter:blur(8px)}.cardBody{display:flex;flex-direction:column;gap:11px;padding:13px;flex:1}.cardTitle{font-weight:950;font-size:15px;line-height:1.35}.cardSub{color:var(--muted);font-size:8px;line-height:1.55}.cardLabel{color:var(--muted);font-size:8px;letter-spacing:.06em;margin-bottom:5px}.chips,.statusRow{display:flex;gap:4px;flex-wrap:wrap}.chip,.status{display:inline-block;border:1px solid #3c444e;border-radius:999px;padding:5px 6px;font:850 8px/1 ui-monospace,monospace}.chip.ways{color:var(--blue);border-color:#3d5d78}.chip.playlist{color:var(--lime);border-color:#5b6423}.chip.article{color:var(--amber);border-color:#6b572c}.chip.yorimichi{color:#f298c7;border-color:#71465d}.status.ok{color:var(--green);border-color:#356548}.status.warn{color:var(--amber);border-color:#6b582d}.status.bad{color:var(--red);border-color:#703d3d}.status.sale{color:#090a0c;background:var(--lime);border-color:var(--lime)}.cardPrice{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}.cardDiscount{font-size:17px;font-weight:950;color:var(--lime)}.cardPriceNow{font-size:21px;font-weight:950}.cardPriceOld{font-size:9px;color:var(--muted);margin-top:3px}.cardActions{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:2px}.cardActions a{border:1px solid #363d47;border-radius:8px;padding:8px 10px;background:#13161b;text-decoration:none;font-size:9px;font-weight:900}.cardActions a.primaryLink{border-color:#586421;color:var(--lime)}.emptyCard{grid-column:1/-1;text-align:center;color:var(--muted);padding:42px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
@media(max-width:1050px){.overview{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr 1fr}.miniStats{grid-template-columns:repeat(3,1fr)}}@media(max-width:680px){.top{align-items:flex-start;flex-direction:column}.hero{display:block}.hero p{margin-top:14px}.focus,.miniStats,.toolbar{grid-template-columns:1fr}.wrap{padding:18px 12px 50px}.count{display:block}.legend{margin-top:5px}.cardGrid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / SALE WATCH<small>Steamセール管理 / Shared Content Core</small></div><div class="actions"><a class="btn" href="/db-master-core" target="_blank">CORE DB ↗</a><a class="btn" href="/sales" target="_blank">読者向けページ ↗</a><button class="btn primary" id="reload">最新情報を取得</button></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">SALE WATCH ADMIN</div><h1>いま見るべき<br>セール情報。</h1></div><div><p>HARF-WAYで紹介したゲームを横断して、現在のSteamセールと「Steam情報が足りない作品」を確認します。まず上の3項目を見るだけで大丈夫です。</p><div id="state" class="state">Coreを読み込み中…</div></div></section>
<div class="sectionTitle"><h2>今見るべきもの</h2><p>クリックすると一覧を絞り込みます</p></div>
<section class="focus"><button class="focusCard sale" data-preset="sale"><small>🔥 現在セール中</small><b id="onsale">—</b><span>いま読者に出せる作品</span></button><button class="focusCard cheap" data-preset="cheap"><small>💴 500円以下</small><b id="under500">—</b><span>価格訴求しやすい作品</span></button><button class="focusCard missing" data-preset="missing"><small>⚠ Steam未登録</small><b id="missing">—</b><span>情報を補完したい作品</span></button></section>
<div class="sectionTitle"><h2>全体状況</h2><p>Coreの登録状態</p></div>
<section class="overview"><div class="panel"><div class="miniStats"><div class="mini"><small>紹介ゲーム総数</small><b id="total">—</b></div><div class="mini"><small>Steam紐付け済み</small><b id="linked">—</b></div><div class="mini"><small>価格取得エラー</small><b id="errors">—</b></div></div></div><div class="panel"><div class="sources"><button class="sourceBtn active" data-source="all">すべて <b id="srcAll">—</b></button><button class="sourceBtn" data-source="ways">WAYS <b id="srcWays">—</b></button><button class="sourceBtn" data-source="playlist">プレイリスト <b id="srcPlaylist">—</b></button><button class="sourceBtn" data-source="article">記事 <b id="srcArticle">—</b></button><button class="sourceBtn" data-source="yorimichi">ヨリミチ <b id="srcYorimichi">—</b></button></div></div></section>
<div class="sectionTitle"><h2>作品一覧</h2><p>カードで作品ごとに確認</p></div>
<section class="panel"><div class="toolbar"><input id="q" placeholder="作品名 / AppID / タグで検索"/><select id="link"><option value="all">Steam状態：すべて</option><option value="linked">Steamあり</option><option value="missing">Steamなし</option><option value="article-missing">記事あり / Steamなし</option></select><select id="sale"><option value="all">価格状態：すべて</option><option value="sale">セール中</option><option value="cheap">500円以下</option><option value="regular">通常価格</option><option value="unchecked">未取得 / エラー</option></select><button class="btn" id="resolve">記事からSteamを探す</button></div><div class="quick"><button class="quickBtn active" data-preset="all">すべて</button><button class="quickBtn" data-preset="sale">セール中</button><button class="quickBtn" data-preset="cheap">500円以下</button><button class="quickBtn" data-preset="missing">Steam未登録</button></div><div class="progress"><span id="bar"></span></div><div class="count"><span id="count"></span><span class="legend"><i>🟢 正常</i><i>🟡 要確認</i><i>🟢黄 セール</i></span></div><div id="hint" class="hint" hidden></div></section>
<div id="rows" class="cardGrid"><div class="emptyCard">読み込み中…</div></div>
</main>
<script>
const $=s=>document.querySelector(s);let catalog=[],prices={},resolved={},busy=false,activeSource='all',activePreset='all';
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const chunk=(a,n)=>{const o=[];for(let i=0;i<a.length;i+=n)o.push(a.slice(i,i+n));return o};
const appidOf=r=>String(r.appid||resolved[r.articleUrl]?.appid||'');
const priceOf=r=>prices[appidOf(r)]||null;
const countSource=n=>n==='all'?catalog.length:catalog.filter(r=>(r.sources||[]).includes(n)).length;
const isCheap=p=>Boolean(p?.ok&&Number.isFinite(p.finalYen)&&p.finalYen<=500);
const isSale=p=>Boolean(p?.ok&&p.onSale);
const isMissing=r=>!appidOf(r);
function placeholderThumb(title=''){const label=(title||'?').trim().slice(0,1).toUpperCase()||'?';const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360" viewBox="0 0 640 360"><rect width="640" height="360" fill="#111318"/><rect x="1" y="1" width="638" height="358" rx="18" fill="none" stroke="#2b3038"/><text x="320" y="205" text-anchor="middle" font-size="120" font-family="Arial,sans-serif" fill="#efff35">${label}</text></svg>`;return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`}
function steamThumb(appid){return appid?`https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${appid}/header.jpg`:''}
function thumbOf(r){return r.thumbnailUrl||r.thumbnail||r.thumbUrl||r.thumb||r.imageUrl||r.image||r.coverUrl||r.cover||r.eyecatch||r.eyecatchUrl||r.articleThumbnail||r.articleThumbnailUrl||steamThumb(appidOf(r))||placeholderThumb(r.title)}
function sourceChip(name){const labels={ways:'WAYS',playlist:'PLAYLIST',article:'記事',yorimichi:'ヨリミチ'};return `<span class="chip ${esc(name)}">${esc(labels[name]||String(name).toUpperCase())}</span>`}
function updateStats(){const linked=catalog.filter(r=>appidOf(r)).length,checked=catalog.map(priceOf).filter(Boolean);$('#total').textContent=catalog.length;$('#linked').textContent=linked;$('#missing').textContent=catalog.length-linked;$('#onsale').textContent=checked.filter(isSale).length;$('#under500').textContent=checked.filter(isCheap).length;$('#errors').textContent=checked.filter(p=>!p?.ok).length;$('#srcAll').textContent=countSource('all');$('#srcWays').textContent=countSource('ways');$('#srcPlaylist').textContent=countSource('playlist');$('#srcArticle').textContent=countSource('article');$('#srcYorimichi').textContent=countSource('yorimichi')}
function syncControls(){document.querySelectorAll('[data-source]').forEach(el=>el.classList.toggle('active',el.dataset.source===activeSource));document.querySelectorAll('[data-preset]').forEach(el=>el.classList.toggle('active',el.dataset.preset===activePreset));if(activePreset==='sale')$('#sale').value='sale';else if(activePreset==='cheap')$('#sale').value='cheap';else if(activePreset==='missing'){$('#sale').value='all';$('#link').value='missing'}else{$('#sale').value='all';if($('#link').value==='missing')$('#link').value='all'}}
function filteredRows(){const q=$('#q').value.trim().toLowerCase(),link=$('#link').value,sale=$('#sale').value;return catalog.filter(r=>{const appid=appidOf(r),p=priceOf(r),hay=[r.title,r.category,appid,...(r.tags||[]),...(r.playlists||[])].join(' ').toLowerCase();if(q&&!hay.includes(q))return false;if(activeSource!=='all'&&!(r.sources||[]).includes(activeSource))return false;if(link==='linked'&&!appid)return false;if(link==='missing'&&appid)return false;if(link==='article-missing'&&(!r.articleUrl||appid))return false;if(sale==='sale'&&!isSale(p))return false;if(sale==='cheap'&&!isCheap(p))return false;if(sale==='regular'&&!(p?.ok&&!p.onSale))return false;if(sale==='unchecked'&&p?.ok)return false;return true}).sort((a,b)=>{const pa=priceOf(a),pb=priceOf(b),rank=(r,p)=>isSale(p)?0:isMissing(r)?1:isCheap(p)?2:3,d=rank(a,pa)-rank(b,pb);if(d)return d;if(isSale(pa)&&isSale(pb)){const x=Number(pb.discountPercent||0)-Number(pa.discountPercent||0);if(x)return x}return String(a.title||'').localeCompare(String(b.title||''),'ja')})}
function render(){updateStats();const rows=filteredRows();$('#count').textContent=`${rows.length} / ${catalog.length}作品を表示`;const hint=$('#hint');if(activePreset==='missing'){hint.hidden=false;hint.textContent='Steam未登録の作品です。「記事からSteamを探す」で記事本文にあるSteamリンクを候補として探せます。'}else if(activePreset==='sale'){hint.hidden=false;hint.textContent='現在セール中の作品だけを表示しています。公開SALE PICKSに出せる候補です。'}else if(activePreset==='cheap'){hint.hidden=false;hint.textContent='現在価格が500円以下の作品です。セール品だけでなく通常価格500円以下も含みます。'}else hint.hidden=true;if(!rows.length){$('#rows').innerHTML='<div class="emptyCard">条件に合う作品はありません。</div>';return}
$('#rows').innerHTML=rows.map(r=>{const appid=appidOf(r),p=priceOf(r),found=!r.appid&&Boolean(appid),thumb=thumbOf(r),steamUrl=appid?`https://store.steampowered.com/app/${appid}/`:'';let status='',priceHtml='<span class="status warn">価格未取得</span>',badge='未確認',cls='gameCard';if(!appid){status='<span class="status warn">Steam未登録</span>';badge='Steam未登録';cls+=' missingCard'}else if(!p){status='<span class="status warn">確認中</span>';badge='確認中'}else if(!p.ok){status='<span class="status bad">取得エラー</span>';priceHtml='<span class="status bad">取得エラー</span>';badge='取得エラー'}else if(p.onSale){status=`<span class="status sale">-${Number(p.discountPercent||0)}% セール</span>`;priceHtml=`<div class="cardPrice"><span class="cardDiscount">-${Number(p.discountPercent||0)}%</span><span class="cardPriceNow">${esc(p.finalFormatted||'')}</span></div><div class="cardPriceOld"><s>${esc(p.initialFormatted||'')}</s></div>`;badge='セール中';cls+=' saleCard'}else{status='<span class="status ok">通常価格</span>';priceHtml=`<div class="cardPrice"><span class="cardPriceNow">${esc(p.finalFormatted||'')}</span></div><div class="cardPriceOld">通常価格</div>`;badge='通常'}const sourceChips=(r.sources||[]).map(sourceChip).join(''),playlist=(r.playlists||[]).length?(r.playlists||[]).map(v=>`<span class="chip playlist">${esc(v)}</span>`).join(''):'<span class="cardSub">—</span>',links=[r.articleUrl?`<a href="${esc(r.articleUrl)}" target="_blank" rel="noopener">記事 ↗</a>`:'',steamUrl?`<a class="primaryLink" href="${esc(steamUrl)}" target="_blank" rel="noopener">Steam ↗</a>`:'',r.storeUrl&&!steamUrl?`<a href="${esc(r.storeUrl)}" target="_blank" rel="noopener">Store ↗</a>`:''].filter(Boolean).join(''),meta=appid?`AppID ${esc(appid)}${found?' / 記事から発見':''}`:'Steam情報なし';return `<article class="${cls}"><div class="thumbWrap"><img class="thumb" src="${esc(thumb)}" alt="${esc(r.title)}" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='${placeholderThumb(r.title)}'"/><div class="thumbBadge">${esc(badge)}</div></div><div class="cardBody"><div><div class="cardTitle">${esc(r.title)}</div><div class="cardSub">${meta}</div>${found?'<div class="cardSub">記事本文から発見 / Core未保存</div>':''}</div><div><div class="cardLabel">どこで紹介？</div><div class="chips">${sourceChips||'<span class="cardSub">—</span>'}</div></div><div><div class="cardLabel">Playlist</div><div class="chips">${playlist}</div></div><div><div class="cardLabel">価格</div>${priceHtml}</div><div><div class="cardLabel">状態</div><div class="statusRow">${status}</div></div><div class="cardActions">${links||'<span class="cardSub">リンクなし</span>'}</div></div></article>`}).join('')}
async function loadPrices(){const ids=[...new Set(catalog.map(appidOf).filter(Boolean))];let done=0;for(const group of chunk(ids,8)){try{const r=await fetch(`/api/steam-prices-public?appids=${encodeURIComponent(group.join(','))}`),j=await r.json();if(j.ok)Object.assign(prices,j.prices||{})}catch{}done+=group.length;$('#bar').style.width=`${ids.length?Math.min(100,done/ids.length*100):100}%`;$('#state').textContent=`Steam価格を確認中… ${done}/${ids.length}`;render()}$('#state').textContent=`更新完了 / ${catalog.length}作品を監視中`;busy=false}
async function load(){if(busy)return;busy=true;catalog=[];prices={};resolved={};activeSource='all';activePreset='all';$('#bar').style.width='0%';syncControls();$('#state').textContent='Shared Content Coreを読み込み中…';try{const r=await fetch('/api/sales-catalog',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'catalog_failed');catalog=j.rows||[];render();await loadPrices()}catch(e){busy=false;$('#state').textContent=`ERROR: ${e.message}`;$('#rows').innerHTML='<div class="emptyCard">SALE WATCHデータを取得できませんでした。</div>'}}
async function resolveArticles(){const targets=catalog.filter(r=>!appidOf(r)&&r.articleUrl).slice(0,80);if(!targets.length){$('#state').textContent='Steam未登録の記事はありません。';return}$('#state').textContent=`記事 ${targets.length}件からSteamリンクを探索中…`;let done=0;for(const group of chunk(targets,4)){const q=group.map(r=>`u=${encodeURIComponent(r.articleUrl)}`).join('&');try{const r=await fetch(`/api/article-steam-public?${q}`),j=await r.json();for(const hit of j.rows||[])if(hit?.url)resolved[hit.url]=hit}catch{}done+=group.length;$('#bar').style.width=`${Math.min(100,done/targets.length*100)}%`;render()}prices={};await loadPrices()}
function setPreset(v){activePreset=v;$('#link').value='all';$('#sale').value='all';if(v==='sale')$('#sale').value='sale';else if(v==='cheap')$('#sale').value='cheap';else if(v==='missing')$('#link').value='missing';syncControls();render()}
document.querySelectorAll('[data-preset]').forEach(el=>el.addEventListener('click',()=>setPreset(el.dataset.preset)));document.querySelectorAll('[data-source]').forEach(el=>el.addEventListener('click',()=>{activeSource=el.dataset.source;syncControls();render()}));$('#q').addEventListener('input',render);$('#link').addEventListener('change',()=>{activePreset='all';syncControls();render()});$('#sale').addEventListener('change',()=>{activePreset='all';syncControls();render()});$('#reload').addEventListener('click',load);$('#resolve').addEventListener('click',resolveArticles);load();
</script>
</body>
</html>