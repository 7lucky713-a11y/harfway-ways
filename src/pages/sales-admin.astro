---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>HARF-WAY / SALE WATCH ADMIN</title>
<style>
:root{color-scheme:dark;--bg:#090a0c;--panel:#111318;--panel2:#0d0f13;--line:#2b3038;--text:#f3f3ef;--muted:#8f98a5;--lime:#efff35;--green:#73e69a;--amber:#ffcc69;--red:#ff7777;--blue:#79b7ff;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}a{color:inherit}.top{position:sticky;top:0;z-index:20;display:flex;gap:12px;align-items:center;justify-content:space-between;padding:13px 18px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.94);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.08em}.brand small{display:block;color:var(--muted);font-size:9px;margin-top:2px}.toplinks{display:flex;gap:7px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:8px 11px;border:1px solid #39404a;border-radius:9px;background:#15181d;color:#fff;text-decoration:none;font-weight:900;font-size:10px;cursor:pointer}.btn.primary{background:var(--lime);border-color:var(--lime);color:#090a0c}.wrap{max-width:1500px;margin:auto;padding:26px 20px 70px}.hero{display:flex;gap:30px;align-items:flex-end;justify-content:space-between;margin-bottom:20px}.ey{font-size:10px;font-weight:950;letter-spacing:.16em;color:var(--lime)}h1{margin:7px 0 0;font-size:clamp(42px,7vw,86px);line-height:.88;letter-spacing:-.06em}.hero p{max-width:620px;margin:0;color:var(--muted);font-size:11px;line-height:1.75}.state{margin-top:8px;font:10px/1.5 ui-monospace,monospace;color:var(--muted)}.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:16px}.kpi{min-height:98px;padding:14px;border:1px solid var(--line);border-radius:13px;background:var(--panel)}.kpi small{display:block;color:var(--muted);font-size:8px;letter-spacing:.09em}.kpi b{display:block;font-size:30px;letter-spacing:-.04em;margin-top:8px}.kpi i{display:block;font-style:normal;font-size:8px;color:var(--muted);margin-top:3px}.panel{border:1px solid var(--line);border-radius:15px;background:var(--panel);padding:15px;margin-bottom:14px}.sources{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.source{padding:11px 12px;border:1px solid var(--line);border-radius:11px;background:var(--panel2)}.source small{color:var(--muted);font-size:8px}.source b{display:block;font-size:21px;margin-top:5px}.toolbar{display:grid;grid-template-columns:minmax(220px,1fr) repeat(3,minmax(130px,180px)) auto;gap:8px;align-items:center}.toolbar input,.toolbar select{width:100%;min-height:40px;border:1px solid var(--line);border-radius:9px;background:#14171c;color:#fff;padding:8px 10px;font-size:10px}.progress{height:5px;border-radius:999px;background:#1c2026;overflow:hidden;margin-top:12px}.progress i{display:block;height:100%;width:0;background:var(--lime);transition:width .2s}.count{font-size:9px;color:var(--muted);margin-top:8px}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:13px}.table{width:100%;border-collapse:collapse;min-width:1100px}.table th{position:sticky;top:64px;z-index:3;text-align:left;background:#111318;border-bottom:1px solid var(--line);padding:10px;font-size:8px;letter-spacing:.08em;color:var(--muted)}.table td{padding:10px;border-bottom:1px solid #22272e;vertical-align:top;font-size:10px}.table tr:hover td{background:#0f1115}.title{font-weight:900;font-size:12px;line-height:1.35}.sub{font-size:8px;color:var(--muted);margin-top:4px}.chips{display:flex;gap:4px;flex-wrap:wrap}.chip{font:850 8px/1 ui-monospace,monospace;border:1px solid #3a424c;border-radius:999px;padding:5px 6px;color:#bfc6d0}.chip.ways{color:var(--blue);border-color:#395875}.chip.playlist{color:var(--lime);border-color:#5f6823}.chip.article{color:var(--amber);border-color:#6b5729}.chip.yorimichi{color:#ef91c0;border-color:#72435b}.status{font:900 8px/1 ui-monospace,monospace;border-radius:999px;padding:5px 6px;display:inline-block;border:1px solid #3e4650}.status.ok{color:var(--green);border-color:#356548}.status.warn{color:var(--amber);border-color:#68562b}.status.bad{color:var(--red);border-color:#6f3b3b}.discount{font-weight:950;color:var(--lime);font-size:15px}.price{font-weight:900}.links{display:flex;gap:5px;flex-wrap:wrap}.links a{font-size:8px;font-weight:900;text-decoration:none;border:1px solid #353c46;border-radius:7px;padding:5px 7px;background:#13161b}.empty{padding:42px;text-align:center;color:var(--muted)}@media(max-width:1050px){.kpis{grid-template-columns:repeat(3,1fr)}.sources{grid-template-columns:repeat(2,1fr)}.toolbar{grid-template-columns:1fr 1fr}}@media(max-width:650px){.top{align-items:flex-start;flex-direction:column}.hero{display:block}.hero p{margin-top:16px}.kpis,.sources,.toolbar{grid-template-columns:1fr 1fr}.wrap{padding:18px 12px 50px}.table th{top:102px}}@media(max-width:430px){.kpis,.sources,.toolbar{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / SALE WATCH ADMIN<small>Shared Content Core → Steam Price Monitor</small></div><div class="toplinks"><a class="btn" href="/db-master-core" target="_blank">CORE DB ↗</a><a class="btn" href="/sales" target="_blank">公開SALE PICKS ↗</a><button class="btn primary" id="reload">再読み込み</button></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">SALE OPERATIONS / CORE v2</div><h1>ONE<br>CATALOG.</h1></div><div><p>WAYSだけではなく、PLAYLIST・記事・ヨリミチを含むShared Content Core全体を母集団にした管理画面です。Steam紐付けの抜け、価格取得、セール状況を1箇所で確認します。</p><div id="state" class="state">Coreを読み込み中…</div></div></section>
<section class="kpis"><div class="kpi"><small>CORE TOTAL</small><b id="kTotal">—</b><i>全紹介作品</i></div><div class="kpi"><small>STEAM LINKED</small><b id="kSteam">—</b><i>価格チェック可能</i></div><div class="kpi"><small>NO STEAM</small><b id="kNoSteam">—</b><i>要確認</i></div><div class="kpi"><small>ON SALE</small><b id="kSale">—</b><i>現在セール中</i></div><div class="kpi"><small>UNDER ¥500</small><b id="k500">—</b><i>現在価格</i></div><div class="kpi"><small>PRICE ERRORS</small><b id="kErr">—</b><i>取得失敗</i></div></section>
<section class="panel"><div class="sources"><div class="source"><small>WAYS</small><b id="sWays">—</b></div><div class="source"><small>PLAYLIST</small><b id="sPlaylist">—</b></div><div class="source"><small>ARTICLE</small><b id="sArticle">—</b></div><div class="source"><small>YORIMICHI</small><b id="sYorimichi">—</b></div></div></section>
<section class="panel"><div class="toolbar"><input id="q" placeholder="作品名 / AppID / タグで検索"/><select id="source"><option value="all">全紹介元</option><option value="ways">WAYS</option><option value="playlist">PLAYLIST</option><option value="article">ARTICLE</option><option value="yorimichi">YORIMICHI</option></select><select id="link"><option value="all">Steam状態すべて</option><option value="linked">Steamあり</option><option value="missing">Steamなし</option><option value="article-missing">記事あり / Steamなし</option></select><select id="sale"><option value="all">価格状態すべて</option><option value="sale">セール中</option><option value="regular">通常価格</option><option value="unchecked">未取得 / エラー</option></select><button class="btn" id="resolve">記事のSteam候補を探索</button></div><div class="progress"><i id="bar"></i></div><div id="count" class="count"></div></section>
<div class="tablewrap"><table class="table"><thead><tr><th>作品</th><th>紹介元</th><th>Steam</th><th>価格</th><th>Playlist</th><th>Article / Store</th></tr></thead><tbody id="rows"><tr><td colspan="6" class="empty">読み込み中…</td></tr></tbody></table></div>
</main>
<script>
const $=s=>document.querySelector(s);let catalog=[],prices={},resolved={},loading=false;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function chunks(a,n){const out=[];for(let i=0;i<a.length;i+=n)out.push(a.slice(i,i+n));return out}
function appidOf(r){return String(r.appid||resolved[r.articleUrl]?.appid||'')}
function priceOf(r){return prices[appidOf(r)]||null}
function srcLabel(s){return `<span class="chip ${esc(s)}">${esc(String(s).toUpperCase())}</span>`}
function updateKpis(){const steam=catalog.filter(r=>appidOf(r)).length;const checked=catalog.map(priceOf).filter(Boolean);$('#kTotal').textContent=catalog.length;$('#kSteam').textContent=steam;$('#kNoSteam').textContent=catalog.length-steam;$('#kSale').textContent=checked.filter(p=>p?.ok&&p?.onSale).length;$('#k500').textContent=checked.filter(p=>p?.ok&&Number.isFinite(p.finalYen)&&p.finalYen<=500).length;$('#kErr').textContent=checked.filter(p=>!p?.ok).length;const c=k=>catalog.filter(r=>(r.sources||[]).includes(k)).length;$('#sWays').textContent=c('ways');$('#sPlaylist').textContent=c('playlist');$('#sArticle').textContent=c('article');$('#sYorimichi').textContent=c('yorimichi')}
function filtered(){const q=$('#q').value.trim().toLowerCase(),source=$('#source').value,link=$('#link').value,sale=$('#sale').value;return catalog.filter(r=>{const appid=appidOf(r),p=priceOf(r),hay=[r.title,r.category,appid,...(r.tags||[]),...(r.playlists||[])].join(' ').toLowerCase();if(q&&!hay.includes(q))return false;if(source!=='all'&&!(r.sources||[]).includes(source))return false;if(link==='linked'&&!appid)return false;if(link==='missing'&&appid)return false;if(link==='article-missing'&&(!r.articleUrl||appid))return false;if(sale==='sale'&&!(p?.ok&&p?.onSale))return false;if(sale==='regular'&&!(p?.ok&&!p?.onSale))return false;if(sale==='unchecked'&&p?.ok)return false;return true})}
function render(){updateKpis();const out=filtered();$('#count').textContent=`${out.length} / ${catalog.length}作品を表示`;if(!out.length){$('#rows').innerHTML='<tr><td colspan="6" class="empty">条件に合う作品はありません。</td></tr>';return}$('#rows').innerHTML=out.map(r=>{const appid=appidOf(r),p=priceOf(r),found=!r.appid&&appid;let steam=appid?`<span class="status ok">${found?'ARTICLE FOUND':'LINKED'} / ${esc(appid)}</span>`:'<span class="status warn">NO STEAM</span>';let price='<span class="status warn">UNCHECKED</span>';if(p){if(!p.ok)price='<span class="status bad">ERROR</span>';else if(p.onSale)price=`<div class="discount">-${Number(p.discountPercent||0)}%</div><div class="price">${esc(p.finalFormatted||'')}</div><div class="sub"><s>${esc(p.initialFormatted||'')}</s></div>`;else price=`<span class="status ok">REGULAR</span><div class="price">${esc(p.finalFormatted||'')}</div>`}const steamUrl=appid?`https://store.steampowered.com/app/${appid}/`:'';return `<tr><td><div class="title">${esc(r.title)}</div><div class="sub">${esc(r.sourceOfTruth||'core')} / ${esc(r.id)}</div></td><td><div class="chips">${(r.sources||[]).map(srcLabel).join('')}</div></td><td>${steam}${found?'<div class="sub">記事本文から発見・Core未保存</div>':''}</td><td>${price}</td><td>${(r.playlists||[]).length?(r.playlists||[]).map(v=>`<span class="chip playlist">${esc(v)}</span>`).join(' '):'<span class="sub">—</span>'}</td><td><div class="links">${r.articleUrl?`<a href="${esc(r.articleUrl)}" target="_blank" rel="noopener">記事 ↗</a>`:''}${steamUrl?`<a href="${esc(steamUrl)}" target="_blank" rel="noopener">Steam ↗</a>`:''}${r.storeUrl&&!steamUrl?`<a href="${esc(r.storeUrl)}" target="_blank" rel="noopener">Store ↗</a>`:''}</div></td></tr>`}).join('')}
async function loadPrices(){const ids=[...new Set(catalog.map(appidOf).filter(Boolean))];let done=0;for(const group of chunks(ids,8)){try{const r=await fetch(`/api/steam-prices-public?appids=${encodeURIComponent(group.join(','))}`);const j=await r.json();if(j.ok)Object.assign(prices,j.prices||{})}catch{}done+=group.length;$('#bar').style.width=`${ids.length?Math.min(100,done/ids.length*100):100}%`;render()}$('#state').textContent=`Core ${catalog.length}作品 / Steam価格 ${done}/${ids.length}件取得中…`}$('#state').textContent=`Core ${catalog.length}作品 / 価格取得完了`;loading=false}
async function load(){if(loading)return;loading=true;catalog=[];prices={};resolved={};$('#bar').style.width='0%';$('#state').textContent='Shared Content Coreを読み込み中…';try{const r=await fetch('/api/sales-catalog',{cache:'no-store'});const j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'catalog_failed');catalog=j.rows||[];$('#state').textContent=`Core ${catalog.length}作品を取得 / Steam価格を分割確認中…`;render();await loadPrices()}catch(e){$('#state').textContent=`ERROR: ${e.message}`;$('#rows').innerHTML='<tr><td colspan="6" class="empty">SALE WATCHデータを取得できませんでした。</td></tr>';loading=false}}
async function resolveArticles(){const targets=catalog.filter(r=>!appidOf(r)&&r.articleUrl).slice(0,80);if(!targets.length){$('#state').textContent='Steam未紐付けの記事はありません。';return}$('#state').textContent=`記事 ${targets.length}件からSteam候補を探索中…`;let done=0;for(const group of chunks(targets,4)){const qs=group.map(r=>`u=${encodeURIComponent(r.articleUrl)}`).join('&');try{const resp=await fetch(`/api/article-steam-public?${qs}`);const j=await resp.json();for(const hit of j.rows||[])if(hit?.url)resolved[hit.url]=hit}catch{}done+=group.length;$('#bar').style.width=`${Math.min(100,done/targets.length*100)}%`;render()}$('#state').textContent=`記事探索完了 / ${Object.values(resolved).filter(x=>x?.appid).length}件のSteam候補を発見。価格を取得中…`;prices={};await loadPrices()}
['q','source','link','sale'].forEach(id=>$(id).addEventListener(id==='q'?'input':'change',render));$('#reload').addEventListener('click',load);$('#resolve').addEventListener('click',resolveArticles);load();
</script>
</body></html>
