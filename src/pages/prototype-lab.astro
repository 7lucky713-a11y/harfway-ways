---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>HARF-WAY Prototype Lab</title>
  <style>
    :root{--bg:#090a0c;--panel:#111318;--panel2:#171a20;--line:#2a2e37;--text:#f4f3ed;--muted:#8b919e;--acid:#e9ff45;--danger:#ff6d77;--blue:#79a7ff}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
    button,input,textarea{font:inherit}button{cursor:pointer}.app{height:100dvh;display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden}
    header{display:flex;align-items:center;gap:14px;padding:13px 16px;border-bottom:1px solid var(--line);background:#0c0e12}
    .brand{font-weight:950;letter-spacing:-.04em;font-size:20px;white-space:nowrap}.brand b{color:var(--acid)}.sub{font-size:10px;color:var(--muted);letter-spacing:.12em}
    .spacer{flex:1}.pill{font:10px ui-monospace,SFMono-Regular,monospace;padding:6px 9px;border:1px solid var(--line);border-radius:999px;color:var(--muted);white-space:nowrap}.pill.good{border-color:#3e5632;color:var(--acid)}.pill.warn{border-color:#5d4c2a;color:#ffd76a}.pill.bad{border-color:#62333a;color:#ff8a94}
    .key{display:flex;gap:6px;align-items:center}.key input{width:150px;border:1px solid var(--line);background:#090b0f;color:#fff;border-radius:8px;padding:7px 9px;font-size:10px}.key button,.topbtn{border:1px solid var(--line);background:#16191f;color:#ddd;border-radius:8px;padding:7px 10px;font-size:10px}.topbtn.primary{background:var(--acid);border-color:var(--acid);color:#111;font-weight:900}
    .workspace{display:grid;grid-template-columns:250px minmax(370px,.82fr) minmax(430px,1.18fr);min-height:0}
    .library,.editor,.preview{min-height:0;overflow:hidden}.library{border-right:1px solid var(--line);display:flex;flex-direction:column;background:#0d0f13}.editor{border-right:1px solid var(--line);display:flex;flex-direction:column;background:#101217}.preview{display:flex;flex-direction:column;background:#0b0c0f}
    .panelhead{padding:12px;border-bottom:1px solid var(--line);display:flex;gap:8px;align-items:center;min-height:52px}.panelhead strong{font-size:11px;letter-spacing:.08em}.panelhead .grow{flex:1}.smallbtn{border:1px solid var(--line);background:#171a20;color:#ddd;border-radius:7px;padding:7px 9px;font-size:9px}.smallbtn.acid{background:var(--acid);color:#111;border-color:var(--acid);font-weight:900}.smallbtn.danger{color:#ff969e}.search{padding:10px;border-bottom:1px solid var(--line)}.search input{width:100%;border:1px solid var(--line);background:#090b0f;color:#fff;border-radius:8px;padding:9px 10px;font-size:11px}
    .list{overflow:auto;padding:8px;display:flex;flex-direction:column;gap:6px}.item{border:1px solid transparent;background:#12151a;color:#fff;border-radius:9px;padding:10px;text-align:left}.item:hover{border-color:#3a3f49}.item.on{border-color:var(--acid);background:#171b17}.item b{font-size:11px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item span{display:block;font-size:9px;color:var(--muted);margin-top:5px}.empty{padding:18px 10px;color:var(--muted);font-size:10px;line-height:1.7}
    .meta{padding:10px 12px;border-bottom:1px solid var(--line);display:grid;gap:8px}.meta input,.meta textarea{width:100%;border:1px solid var(--line);background:#090b0f;color:#fff;border-radius:7px;padding:8px 9px;font-size:11px}.meta textarea{height:54px;resize:none}.tabs{display:flex;border-bottom:1px solid var(--line);padding:0 10px}.tab{border:0;border-bottom:2px solid transparent;background:transparent;color:#777;padding:10px 12px;font-size:9px;font-weight:850}.tab.on{color:var(--acid);border-color:var(--acid)}
    .codewrap{flex:1;min-height:0;position:relative}.code{position:absolute;inset:0;width:100%;height:100%;resize:none;border:0;outline:0;background:#0b0d11;color:#e8e8e2;padding:14px;font:12px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;tab-size:2;display:none}.code.on{display:block}.editorfoot{display:flex;gap:7px;align-items:center;padding:9px 10px;border-top:1px solid var(--line);background:#0f1115}.editorfoot .hint{margin-left:auto;color:#666;font-size:9px}
    .device{display:flex;gap:5px}.device button{border:1px solid var(--line);background:#13161b;color:#888;border-radius:7px;padding:7px 9px;font-size:9px}.device button.on{background:#242922;color:var(--acid);border-color:#56613b}.stage{flex:1;min-height:0;overflow:auto;padding:20px;display:grid;place-items:start center}.frameShell{height:100%;min-height:420px;width:100%;max-width:100%;background:#fff;border:1px solid #343944;border-radius:10px;overflow:hidden;box-shadow:0 22px 60px #0009;transition:width .2s}.frameShell.tablet{width:768px}.frameShell.mobile{width:390px}.frameShell iframe{width:100%;height:100%;border:0;background:#fff;display:block}.statusline{padding:8px 12px;border-top:1px solid var(--line);color:#747985;font:9px ui-monospace,SFMono-Regular,monospace;display:flex;gap:14px}.dirty{color:#ffd76a}
    @media(max-width:1150px){.workspace{grid-template-columns:210px minmax(340px,.9fr) minmax(390px,1.1fr)}.sub{display:none}}
    @media(max-width:900px){.app{height:auto;min-height:100dvh;overflow:visible}.workspace{display:block}.library,.editor,.preview{height:auto;border:0;border-bottom:1px solid var(--line)}.library{min-height:260px}.list{max-height:260px}.editor{height:620px}.preview{height:720px}.key input{width:110px}header{flex-wrap:wrap}.spacer{display:none}}
  </style>
</head>
<body>
<div class="app">
  <header>
    <div><div class="brand">HARF-WAY <b>/ PROTOTYPE LAB</b></div><div class="sub">IDEA → ITERATE → FREEZE → VERCEL PREVIEW</div></div>
    <div class="spacer"></div>
    <span id="backend" class="pill">CONNECTING</span>
    <div class="key"><input id="adminKey" type="password" placeholder="Admin key" autocomplete="off" /><button id="saveKey">KEY</button></div>
    <button id="copyBundle" class="topbtn">COPY BUNDLE</button>
    <button id="save" class="topbtn primary">SAVE</button>
  </header>

  <main class="workspace">
    <aside class="library">
      <div class="panelhead"><strong>PROTOTYPES</strong><span class="grow"></span><button id="new" class="smallbtn acid">＋ NEW</button></div>
      <div class="search"><input id="search" placeholder="名前で検索" /></div>
      <div id="list" class="list"></div>
    </aside>

    <section class="editor">
      <div class="panelhead"><strong>SOURCE</strong><span class="grow"></span><button id="duplicate" class="smallbtn">複製</button><button id="archive" class="smallbtn danger">しまう</button></div>
      <div class="meta"><input id="title" placeholder="Prototype title" /><textarea id="notes" placeholder="狙い・メモ・次に確認したいこと"></textarea></div>
      <div class="tabs"><button class="tab on" data-tab="html">HTML</button><button class="tab" data-tab="css">CSS</button><button class="tab" data-tab="js">JS</button></div>
      <div class="codewrap">
        <textarea id="html" class="code on" spellcheck="false"></textarea>
        <textarea id="css" class="code" spellcheck="false"></textarea>
        <textarea id="js" class="code" spellcheck="false"></textarea>
      </div>
      <div class="editorfoot"><button id="run" class="smallbtn acid">▶ RUN</button><button id="copyTab" class="smallbtn">COPY TAB</button><span class="hint">Ctrl / Cmd + S で保存</span></div>
    </section>

    <section class="preview">
      <div class="panelhead"><strong>LIVE PREVIEW</strong><span class="grow"></span><div class="device"><button class="on" data-device="desktop">PC</button><button data-device="tablet">TABLET</button><button data-device="mobile">SP</button></div></div>
      <div class="stage"><div id="frameShell" class="frameShell"><iframe id="frame" sandbox="allow-scripts allow-modals allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe></div></div>
      <div class="statusline"><span id="saveState">READY</span><span>Sandbox: scripts + external tabs / network blocked</span></div>
    </section>
  </main>
</div>

<script is:inline>
(() => {
  const API = '/api/prototypes';
  const LOCAL_KEY = 'harfway_prototype_lab_items_v1';
  const ADMIN_KEY = 'harfway_admin_key';
  const $ = s => document.querySelector(s);
  const $$ = s => [...document.querySelectorAll(s)];
  const els = { list:$('#list'), search:$('#search'), title:$('#title'), notes:$('#notes'), html:$('#html'), css:$('#css'), js:$('#js'), frame:$('#frame'), shell:$('#frameShell'), backend:$('#backend'), saveState:$('#saveState'), adminKey:$('#adminKey') };
  let items = [];
  let current = null;
  let storage = 'browser-local';
  let activeTab = 'html';
  let dirty = false;
  let previewTimer = 0;

  const starter = () => ({
    id:'', title:'New prototype', notes:'', viewport:'desktop',
    html:'<main class="demo">\n  <p class="eyebrow">HARF-WAY / PROTOTYPE</p>\n  <h1>試作品をここで育てる。</h1>\n  <p>HTML / CSS / JSを変えて、Vercel deploymentなしで確認します。</p>\n  <button id="action">CLICK</button>\n</main>',
    css:'*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0b0c0f;color:#f4f3ed;font-family:system-ui,sans-serif}.demo{width:min(680px,88vw);padding:48px;border:1px solid #333842;border-radius:22px;background:#12151a}.eyebrow{font-size:11px;letter-spacing:.16em;color:#e9ff45;font-weight:900}h1{font-size:clamp(36px,7vw,72px);line-height:.95;letter-spacing:-.06em;margin:16px 0}p{color:#a9aeb8;line-height:1.8}button{margin-top:20px;border:0;border-radius:999px;background:#e9ff45;color:#111;padding:12px 18px;font-weight:900;cursor:pointer}',
    js:"document.querySelector('#action')?.addEventListener('click', e => { e.currentTarget.textContent = e.currentTarget.textContent === 'CLICK' ? 'WORKS!' : 'CLICK'; });"
  });

  function adminHeaders(extra={}) {
    const key = localStorage.getItem(ADMIN_KEY) || '';
    return { 'content-type':'application/json', ...(key ? {'x-admin-key':key} : {}), ...extra };
  }

  async function api(url=API, options={}) {
    return fetch(url, { cache:'no-store', ...options, headers:adminHeaders(options.headers || {}) });
  }

  function readLocal() {
    try { return JSON.parse(localStorage.getItem(LOCAL_KEY) || '[]'); } catch { return []; }
  }
  function writeLocal(next) { localStorage.setItem(LOCAL_KEY, JSON.stringify(next)); }
  function uid() { return `local-${Date.now()}-${Math.random().toString(36).slice(2,7)}`; }
  function fmt(v) { if(!v) return 'NEW'; try{return new Date(v).toLocaleString('ja-JP',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}catch{return ''} }
  function markDirty(v=true){ dirty=v; els.saveState.textContent=v?'UNSAVED':'SAVED'; els.saveState.classList.toggle('dirty',v); }

  function setBackend(name, type='good') {
    els.backend.textContent = name;
    els.backend.className = `pill ${type}`;
  }

  function buildDoc() {
    const csp = "default-src 'none'; img-src data: blob: https:; media-src data: blob: https:; style-src 'unsafe-inline' https:; font-src data: https:; script-src 'unsafe-inline'; connect-src 'none'; frame-src https:;";
    const open = '<scr'+'ipt>';
    const close = '</scr'+'ipt>';
    return `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="${csp}"><style>${els.css.value}</style></head><body>${els.html.value}${open}${els.js.value}${close}</body></html>`;
  }

  function runPreview(){ clearTimeout(previewTimer); els.frame.srcdoc = buildDoc(); }
  function queuePreview(){ clearTimeout(previewTimer); previewTimer=setTimeout(runPreview,280); }

  function collect(){
    return { id:current?.id || '', title:els.title.value.trim() || 'Untitled prototype', notes:els.notes.value, html:els.html.value, css:els.css.value, js:els.js.value, viewport:current?.viewport || 'desktop' };
  }

  function fill(item){
    current={...item};
    els.title.value=item.title || '';
    els.notes.value=item.notes || '';
    els.html.value=item.html || '';
    els.css.value=item.css || '';
    els.js.value=item.js || '';
    setDevice(item.viewport || 'desktop');
    markDirty(false); runPreview(); renderList();
  }

  function renderList(){
    const q=els.search.value.trim().toLowerCase();
    const shown=items.filter(x => !q || String(x.title||'').toLowerCase().includes(q));
    if(!shown.length){ els.list.innerHTML='<div class="empty">まだ試作品がありません。<br>「＋ NEW」から作り始められます。</div>'; return; }
    els.list.innerHTML=shown.map(x=>`<button class="item ${current?.id&&x.id===current.id?'on':''}" data-id="${String(x.id).replace(/"/g,'&quot;')}"><b>${escapeHtml(x.title||'Untitled')}</b><span>${fmt(x.updatedAt)} · ${(x.viewport||'desktop').toUpperCase()}</span></button>`).join('');
  }
  function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

  async function loadList(){
    try{
      const r=await api();
      const data=await r.json().catch(()=>({}));
      if(r.status===401){ storage='locked'; items=[]; setBackend('ADMIN KEY REQUIRED','bad'); renderList(); return; }
      if(!r.ok) throw new Error(data.error||`HTTP ${r.status}`);
      storage=data.storage || 'browser-local';
      if(storage==='browser-local'){
        items=readLocal(); setBackend('LOCAL / 0 DEPLOY','warn');
      }else{
        items=data.items || []; setBackend(storage==='shared-content-core'?'CORE / 0 DEPLOY':'PREVIEW CORE','good');
      }
      renderList();
      if(!current){ if(items[0]) await selectItem(items[0].id); else newPrototype(); }
    }catch(e){ storage='browser-local'; items=readLocal(); setBackend('LOCAL FALLBACK','warn'); renderList(); if(!current){if(items[0])selectItem(items[0].id);else newPrototype();} }
  }

  async function selectItem(id){
    if(dirty && !confirm('未保存の変更があります。移動しますか？')) return;
    if(storage==='browser-local'){
      const item=readLocal().find(x=>x.id===id); if(item) fill(item); return;
    }
    if(storage==='locked') return;
    try{
      const r=await api(`${API}?id=${encodeURIComponent(id)}`); const d=await r.json();
      if(!r.ok) throw new Error(d.error||'load failed'); fill(d.item);
    }catch(e){ alert(`読み込み失敗: ${e.message}`); }
  }

  function newPrototype(){ fill(starter()); }

  async function saveCurrent(){
    const payload=collect();
    els.saveState.textContent='SAVING…';
    if(storage==='browser-local'){
      const now=new Date().toISOString(); if(!payload.id) payload.id=uid();
      const all=readLocal(); const idx=all.findIndex(x=>x.id===payload.id);
      const saved={...payload,createdAt:idx>=0?all[idx].createdAt:now,updatedAt:now};
      if(idx>=0) all[idx]=saved; else all.unshift(saved); writeLocal(all); items=all; fill(saved); return;
    }
    if(storage==='locked'){ alert('Admin keyを入力してください。'); return; }
    try{
      const r=await api(API,{method:'POST',body:JSON.stringify(payload)}); const d=await r.json();
      if(!r.ok) throw new Error(d.error||'save failed'); current=d.item; markDirty(false); await loadList(); await selectItem(d.item.id);
    }catch(e){ els.saveState.textContent='ERROR'; alert(`保存失敗: ${e.message}`); }
  }

  async function archiveCurrent(){
    if(!current?.id){ newPrototype(); return; }
    if(!confirm(`「${els.title.value || 'Untitled'}」をしまいますか？`)) return;
    if(storage==='browser-local'){
      const all=readLocal().filter(x=>x.id!==current.id); writeLocal(all); items=all; current=null; renderList(); if(items[0])selectItem(items[0].id);else newPrototype(); return;
    }
    try{
      const r=await api(API,{method:'DELETE',body:JSON.stringify({id:current.id})}); const d=await r.json();
      if(!r.ok) throw new Error(d.error||'archive failed'); current=null; await loadList();
    }catch(e){ alert(`しまえませんでした: ${e.message}`); }
  }

  function duplicateCurrent(){ const p=collect(); fill({...p,id:'',title:`${p.title} COPY`,createdAt:null,updatedAt:null}); markDirty(true); }

  function setDevice(device){
    device=['desktop','tablet','mobile'].includes(device)?device:'desktop'; if(current)current.viewport=device;
    els.shell.className=`frameShell ${device==='desktop'?'':device}`;
    $$('[data-device]').forEach(b=>b.classList.toggle('on',b.dataset.device===device)); markDirty(dirty);
  }

  function setTab(tab){ activeTab=tab; $$('.tab').forEach(b=>b.classList.toggle('on',b.dataset.tab===tab)); $$('.code').forEach(t=>t.classList.toggle('on',t.id===tab)); }

  $('#new').onclick=()=>{if(!dirty||confirm('未保存の変更を破棄して新規作成しますか？'))newPrototype()};
  $('#save').onclick=saveCurrent; $('#run').onclick=runPreview; $('#archive').onclick=archiveCurrent; $('#duplicate').onclick=duplicateCurrent;
  els.search.oninput=renderList; els.list.onclick=e=>{const b=e.target.closest('[data-id]'); if(b)selectItem(b.dataset.id)};
  $$('.tab').forEach(b=>b.onclick=()=>setTab(b.dataset.tab));
  $$('[data-device]').forEach(b=>b.onclick=()=>{setDevice(b.dataset.device);markDirty(true)});
  [els.title,els.notes,els.html,els.css,els.js].forEach(el=>el.addEventListener('input',()=>{markDirty(true);if(el===els.html||el===els.css||el===els.js)queuePreview()}));
  $('#copyTab').onclick=async()=>{const el=$(`#${activeTab}`);await navigator.clipboard.writeText(el.value);$('#copyTab').textContent='COPIED';setTimeout(()=>$('#copyTab').textContent='COPY TAB',900)};
  $('#copyBundle').onclick=async()=>{await navigator.clipboard.writeText(buildDoc());$('#copyBundle').textContent='COPIED';setTimeout(()=>$('#copyBundle').textContent='COPY BUNDLE',900)};
  els.adminKey.value=localStorage.getItem(ADMIN_KEY)||'';
  $('#saveKey').onclick=()=>{localStorage.setItem(ADMIN_KEY,els.adminKey.value.trim());current=null;loadList()};
  window.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveCurrent()}if((e.ctrlKey||e.metaKey)&&['1','2','3'].includes(e.key)){e.preventDefault();setTab(['html','css','js'][Number(e.key)-1])}});
  window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue=''}});

  loadList();
})();
</script>
</body>
</html>
