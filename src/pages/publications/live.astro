<html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>HARF-WAY Publications Preview</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;--accent:#8f3131;--bg:#f5efe4;--ink:#201d1a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink)}a{color:inherit}.wrap{width:min(1120px,calc(100% - 30px));margin:auto}.bar{padding:10px 0;background:#0f1319;color:#d8deea;font-size:12px}.bar .wrap{display:flex;justify-content:space-between;gap:16px}.head{padding:34px 0 26px;border-bottom:1px solid color-mix(in srgb,var(--accent) 24%,transparent)}.eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--accent);font-weight:800}.title{font-family:Georgia,"Times New Roman",serif;font-size:clamp(40px,6vw,70px);margin:8px 0}.tag{font-size:18px;line-height:1.8;max-width:780px}.editor{margin-top:12px;font-size:13px;color:#6c665f}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;padding:52px 0}.hero h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(36px,5vw,62px);line-height:1.08;margin:8px 0 14px}.hero p{line-height:1.8;color:#6d675f}.feature{padding:24px;border-radius:18px;border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);background:color-mix(in srgb,#fff 82%,var(--accent) 3%)}section{padding:30px 0}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.section-head h2{font-family:Georgia,"Times New Roman",serif;font-size:30px;margin:0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{padding:18px;border:1px solid rgba(0,0,0,.09);border-radius:14px;background:rgba(255,255,255,.58)}.card strong{font-size:17px;line-height:1.55;display:block;margin:7px 0}.card p{font-size:13px;line-height:1.65;color:#6d675f}.chips{display:flex;gap:9px;flex-wrap:wrap}.chip{padding:9px 13px;border:1px solid color-mix(in srgb,var(--accent) 28%,transparent);background:rgba(255,255,255,.52);border-radius:999px}.empty{padding:24px;border:1px dashed rgba(0,0,0,.2);border-radius:14px;color:#777}.foot{margin-top:35px;padding:28px 0 44px;border-top:1px solid rgba(0,0,0,.1);font-size:13px;color:#736d65}@media(max-width:780px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:1fr}}
</style></head><body>
<div class="bar"><div class="wrap"><span>HARF-WAY Publications / Preview</span><a href="/publications-admin">CMSに戻る</a></div></div>
<header class="head"><div class="wrap"><div class="eyebrow" id="slugLabel">publication</div><div class="title" id="title">読み込み中...</div><div class="tag" id="tagline"></div><div class="editor" id="editor"></div></div></header>
<main class="wrap"><div class="hero"><div><div class="eyebrow">Independent editorial identity</div><h1 id="heroTitle">その人の偏りを、ひとつのメディアに。</h1><p id="description"></p></div><div class="feature"><div class="eyebrow">LIVE PREVIEW</div><h2>Deployなしで更新</h2><p>このページは同じブラウザのCMS保存内容を直接読み込んでいます。保存→再読込だけで変更を確認できます。</p></div></div>
<section><div class="section-head"><h2>棚から探す</h2><span>媒体固有の分類</span></div><div class="chips" id="shelves"></div></section>
<section><div class="section-head"><h2>コンテンツ</h2><span id="count"></span></div><div class="grid" id="articles"></div></section>
<div class="foot">Powered by HARF-WAY. 本番ではこの読み出し元をNeonへ差し替え、Core DB / R2 / Analytics / ADSと接続する設計です。</div></main>
<script>
const KEY='harfway_publications_preview_v1';
const seed=[{slug:'doujin-yawa',title:'同人ゲーム夜話',tagline:'同人ゲームの面白さを、深く、ゆっくり、味わう夜話を。',editor:'編集長：サンプル',theme:'editorial',accent:'#8f3131',bg:'#f5efe4',description:'その人の頭の中にある「同人ゲーム売り場」を、そのままWebにする専門媒体。',shelves:['500円以下','短編ADV','作者から辿る','体験版あり','昔の一本','今月の新着'],articles:[{title:'500円以下で拾った3本',type:'pick',note:'今月の発掘から3本。'},{title:'作者を追う：小さなサークルの過去作',type:'feature',note:'作品ではなく作者から辿る。'},{title:'パッケージだけで惹かれた一本',type:'memo',note:'短い発掘メモ。'}]}];
const params=new URLSearchParams(location.search);const slug=params.get('slug')||'doujin-yawa';let pubs;try{pubs=JSON.parse(localStorage.getItem(KEY)||'null')||seed}catch{pubs=seed}const p=pubs.find(x=>x.slug===slug)||pubs[0];
if(p){document.documentElement.style.setProperty('--accent',p.accent||'#8f3131');document.documentElement.style.setProperty('--bg',p.bg||'#f5efe4');document.title=p.title+' | HARF-WAY Publications Preview';document.getElementById('slugLabel').textContent='HARF-WAY Publications / '+p.slug;document.getElementById('title').textContent=p.title;document.getElementById('tagline').textContent=p.tagline||'';document.getElementById('editor').textContent=p.editor||'';document.getElementById('heroTitle').textContent=p.tagline||p.title;document.getElementById('description').textContent=p.description||'';document.getElementById('shelves').innerHTML=(p.shelves||[]).map(x=>`<span class="chip">${escapeHtml(x)}</span>`).join('')||'<div class="empty">棚はまだありません</div>';document.getElementById('count').textContent=(p.articles||[]).length+'件';document.getElementById('articles').innerHTML=(p.articles||[]).map(a=>`<article class="card"><div class="eyebrow">${escapeHtml(a.type||'memo')}</div><strong>${escapeHtml(a.title)}</strong><p>${escapeHtml(a.note||'')}</p></article>`).join('')||'<div class="empty">コンテンツはまだありません</div>'}
function escapeHtml(s=''){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
</script></body></html>