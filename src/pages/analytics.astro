<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>HARF-WAY Analytics</title>
<style>
:root{--bg:#090a0c;--panel:#111318;--panel2:#0d0f13;--line:#2b3038;--text:#f3f3ed;--muted:#8d96a3;--lime:#efff35;--green:#75ee9a;--red:#ff7676;--amber:#ffcc69}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.top{position:sticky;top:0;z-index:20;display:flex;gap:12px;align-items:center;justify-content:space-between;padding:14px 22px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.94);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.08em}.controls{display:flex;gap:8px;align-items:center}.controls select,.controls input{background:#0a0c0f;color:#fff;border:1px solid #343a44;border-radius:9px;padding:9px 11px}.controls input{width:190px}button{border:1px solid #3b424d;border-radius:9px;padding:9px 12px;background:#171a20;color:#fff;font-weight:850;cursor:pointer}button.primary{background:var(--lime);border-color:var(--lime);color:#08090a}.wrap{max-width:1480px;margin:auto;padding:28px 22px 70px}.hero{display:flex;gap:28px;align-items:end;justify-content:space-between;margin-bottom:24px}.hero h1{font-size:clamp(44px,7vw,94px);letter-spacing:-.06em;line-height:.88;margin:0}.hero p{max-width:520px;color:var(--muted);line-height:1.7;margin:0}.ey{font-size:11px;font-weight:900;letter-spacing:.14em;color:var(--lime);margin-bottom:9px}.statusline{font:12px/1.5 ui-monospace,monospace;color:var(--muted);margin-top:8px}.statusline.ok{color:var(--green)}.statusline.bad{color:var(--red)}.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin-bottom:18px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;min-height:110px}.kpi small{display:block;color:var(--muted);font-size:10px;letter-spacing:.08em}.kpi b{display:block;font-size:34px;letter-spacing:-.04em;margin-top:9px}.kpi i{display:block;color:var(--muted);font-style:normal;font-size:10px;margin-top:4px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px;min-width:0}.panel h2{font-size:13px;letter-spacing:.1em;margin:0 0 14px}.services{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.service{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:13px;min-height:120px}.service .name{font-weight:950;font-size:12px}.service .dot{display:inline-block;width:7px;height:7px;border-radius:999px;margin-right:6px;background:#555}.service.on .dot{background:var(--green)}.service.pending .dot{background:var(--amber)}.service .period{font-size:9px;color:var(--muted);margin-top:5px}.service b{display:block;font-size:22px;margin-top:12px}.service small{color:var(--muted)}.funnel{display:grid;gap:9px}.frow{display:grid;grid-template-columns:115px 1fr 55px;align-items:center;gap:10px}.frow span{font-size:11px;color:var(--muted)}.track{height:10px;background:#20242b;border-radius:999px;overflow:hidden}.track i{display:block;height:100%;background:var(--lime);min-width:1px}.frow b{text-align:right;font-size:12px}.tablewrap{overflow:auto;max-height:470px;border:1px solid var(--line);border-radius:12px}.tablewrap table{width:100%;border-collapse:collapse;min-width:760px}.tablewrap th,.tablewrap td{padding:10px 11px;border-bottom:1px solid #242931;font-size:11px;text-align:right;white-space:nowrap}.tablewrap th{position:sticky;top:0;background:#16191f;color:#9aa3af;font-weight:800}.tablewrap th:first-child,.tablewrap td:first-child{text-align:left;max-width:250px;overflow:hidden;text-overflow:ellipsis}.tabs{display:flex;gap:6px;margin-bottom:10px}.tabs button{padding:7px 9px;font-size:11px}.tabs button.active{background:var(--lime);color:#08090a;border-color:var(--lime)}.empty{padding:24px;color:var(--muted);font-size:12px;text-align:center}.foot{margin-top:20px;padding:14px 0;color:var(--muted);font-size:11px;border-top:1px solid var(--line)}@media(max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}.grid{grid-template-columns:1fr}.services{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.top{align-items:flex-start;flex-direction:column}.controls{width:100%;flex-wrap:wrap}.controls input{flex:1;min-width:170px}.hero{display:block}.hero p{margin-top:16px}.kpis{grid-template-columns:1fr 1fr}.services{grid-template-columns:1fr 1fr}.wrap{padding:20px 14px 55px}.frow{grid-template-columns:85px 1fr 45px}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / ANALYTICS</div><div class="controls"><select id="days"><option value="1">WAYS 1日</option><option value="7" selected>WAYS 7日</option><option value="30">WAYS 30日</option><option value="90">WAYS 90日</option></select><input id="key" type="password" placeholder="Showcase 管理キー" autocomplete="off"><button id="load" class="primary">更新</button></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">EDITORIAL PERFORMANCE HUB</div><h1>WHAT<br>WORKED?</h1></div><div><p>HARF-WAY内の発見・視聴・クリックを横断して見るための共通ダッシュボード。まずWAYSとShowcaseを接続し、Playlist・Yorimichi・ZINEを同じイベント仕様へ順次まとめます。</p><div id="state" class="statusline">データを読み込み中…</div></div></section>
<section class="kpis"><div class="kpi"><small>WAYS PAGE VIEWS</small><b id="pv">—</b><i id="pvPeriod">直近7日</i></div><div class="kpi"><small>WAYS SESSIONS</small><b id="sessions">—</b><i>ユニークセッション</i></div><div class="kpi"><small>GAME VIEWS</small><b id="gameViews">—</b><i>WAYS作品表示</i></div><div class="kpi"><small>VIDEO PLAYS</small><b id="plays">—</b><i>WAYS再生開始</i></div><div class="kpi"><small>STORE CLICKS</small><b id="stores">—</b><i>WAYS＋Showcase</i></div><div class="kpi"><small>SHOWCASE PICKS</small><b id="picks">—</b><i>Showcaseは全期間</i></div></section>
<div class="grid">
<section class="panel" style="grid-column:1/-1"><h2>SERVICE COVERAGE</h2><div class="services" id="services"></div></section>
<section class="panel"><h2>WAYS FUNNEL</h2><div id="waysFunnel" class="funnel"></div></section>
<section class="panel"><h2>SHOWCASE FUNNEL <span style="color:var(--muted);font-weight:500">/ ALL TIME</span></h2><div id="showFunnel" class="funnel"></div></section>
<section class="panel" style="grid-column:1/-1"><h2>GAME PERFORMANCE</h2><div class="tabs"><button id="tabWays" class="active">WAYS</button><button id="tabShow">SHOWCASE</button></div><div class="tablewrap"><table><thead id="thead"></thead><tbody id="tbody"></tbody></table><div id="empty" class="empty" hidden></div></div></section>
</div>
<div class="foot">Preview v0.1 — WAYSは選択期間、Showcaseは現行Metrics APIの全期間集計です。期間の異なる数字は合算せず、サービス別の文脈で比較します。</div>
</main>
<script is:inline>
const $=s=>document.querySelector(s),n=v=>Number(v||0).toLocaleString('ja-JP');let data=null,tab='ways';
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function funnel(root,rows){const max=Math.max(1,...rows.map(x=>Number(x[1]||0)));root.innerHTML=rows.map(([label,value])=>`<div class="frow"><span>${esc(label)}</span><div class="track"><i style="width:${Math.max(1,Number(value||0)/max*100)}%"></i></div><b>${n(value)}</b></div>`).join('')}
function serviceCard(name,s){const on=!!s?.connected,period=s?.period==='all_time'?'ALL TIME':s?.period?.replace('last_','LAST ').replace('_days',' DAYS')||'NOT CONNECTED';let metric='—',label='接続待ち';if(name==='WAYS'&&on){metric=n(s.summary?.gameViews);label='作品表示'}if(name==='SHOWCASE'&&on){metric=n(s.summary?.gameViews);label='作品表示'}return `<div class="service ${on?'on':'pending'}"><div class="name"><i class="dot"></i>${name}</div><div class="period">${period}</div><b>${metric}</b><small>${label}</small></div>`}
function render(){const w=data?.services?.ways,s=data?.services?.showcase;$('#pv').textContent=w?.connected?n(w.summary?.pageViews):'—';$('#sessions').textContent=w?.connected?n(w.summary?.sessions):'—';$('#gameViews').textContent=w?.connected?n(w.summary?.gameViews):'—';$('#plays').textContent=w?.connected?n(w.summary?.plays):'—';$('#stores').textContent=n((w?.summary?.storeClicks||0)+(s?.summary?.storeClicks||0));$('#picks').textContent=s?.connected?n(s.summary?.picks):'—';$('#pvPeriod').textContent=`直近 ${$('#days').value} 日`;$('#services').innerHTML=['WAYS','SHOWCASE','PLAYLIST','YORIMICHI','ZINE'].map(name=>serviceCard(name,data.services[name.toLowerCase()])).join('');funnel($('#waysFunnel'),[['作品表示',w?.summary?.gameViews],['再生',w?.summary?.plays],['完走',w?.summary?.completes],['ストア',w?.summary?.storeClicks],['記事',w?.summary?.articleClicks]]);if(s?.connected)funnel($('#showFunnel'),[['作品表示',s.summary?.gameViews],['再生',s.summary?.plays],['10秒',s.summary?.tenSeconds],['完走',s.summary?.completes],['ストア',s.summary?.storeClicks],['PICK',s.summary?.picks]]);else $('#showFunnel').innerHTML='<div class="empty">Showcase管理キーを入力すると表示されます。</div>';table()}
function table(){const s=data?.services?.[tab];$('#tabWays').classList.toggle('active',tab==='ways');$('#tabShow').classList.toggle('active',tab==='showcase');const empty=$('#empty'),body=$('#tbody'),head=$('#thead');if(!s?.connected){head.innerHTML='';body.innerHTML='';empty.hidden=false;empty.textContent=tab==='showcase'?'管理キーを入力してShowcaseを接続してください。':'データがありません。';return}empty.hidden=true;if(tab==='ways'){head.innerHTML='<tr><th>作品</th><th>表示</th><th>視聴者</th><th>再生</th><th>50%</th><th>完走</th><th>平均視聴%</th><th>ストア</th><th>記事</th></tr>';body.innerHTML=[...(s.games||[])].sort((a,b)=>Number(b.views)-Number(a.views)).map(g=>`<tr><td title="${esc(g.game_id)}">${esc(g.title||g.game_id)}</td><td>${n(g.views)}</td><td>${n(g.viewers)}</td><td>${n(g.plays)}</td><td>${n(g.p50)}</td><td>${n(g.completes)}</td><td>${esc(g.avg_watch_pct||'0')}%</td><td>${n(g.store_clicks)}</td><td>${n(g.article_clicks)}</td></tr>`).join('')}else{head.innerHTML='<tr><th>作品</th><th>表示</th><th>再生</th><th>10秒</th><th>完走</th><th>ストア</th><th>開発者</th><th>PICK</th><th>共有</th></tr>';body.innerHTML=[...(s.games||[])].sort((a,b)=>Number(b.views)-Number(a.views)).map(g=>`<tr><td>${esc(g.title||g.game_id)}</td><td>${n(g.views)}</td><td>${n(g.starts)}</td><td>${n(g.watched_10s)}</td><td>${n(g.completes)}</td><td>${n(g.store_clicks)}</td><td>${n(g.developer_clicks)}</td><td>${n(g.picks)}</td><td>${n(g.shares)}</td></tr>`).join('')}}
async function load(){const days=$('#days').value,key=$('#key').value.trim();$('#state').textContent='データ更新中…';$('#state').className='statusline';try{const r=await fetch(`/api/harfway-analytics?days=${encodeURIComponent(days)}`,{headers:key?{'x-showcase-admin-key':key}:{},cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'取得失敗');data=j;if(key)sessionStorage.setItem('hwAnalyticsShowcaseKey',key);$('#state').textContent=`WAYS ${j.services.ways.connected?'CONNECTED':'ERROR'} / SHOWCASE ${j.services.showcase.connected?'CONNECTED':'LOCKED'} / CORE ${j.core.count}作品`;$('#state').className='statusline '+(j.services.ways.connected?'ok':'bad');render()}catch(e){$('#state').textContent=e.message;$('#state').className='statusline bad'}}
$('#load').onclick=load;$('#days').onchange=load;$('#key').addEventListener('keydown',e=>{if(e.key==='Enter')load()});$('#tabWays').onclick=()=>{tab='ways';table()};$('#tabShow').onclick=()=>{tab='showcase';table()};const saved=sessionStorage.getItem('hwAnalyticsShowcaseKey')||'';if(saved)$('#key').value=saved;load();
</script>
</body></html>
