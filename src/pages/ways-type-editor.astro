---
const title = 'HARF-WAY PLAYBACK EDITOR / DISCOVER・TIP Preview';
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>{title}</title>
<style>
:root{color-scheme:dark;--wt-accent:#efff3d;--wt-bg:#080808;--wt-panel:#0d0d0f;--wt-line:#303036;--wt-muted:#92928c;--wt-text:#f5f5f0;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--wt-bg);color:var(--wt-text)}body{overflow:hidden}button,input,textarea,select,a{font:inherit}button{cursor:pointer}.wt-btn{border:1px solid var(--wt-line);background:#19191d;color:#fff;padding:9px 12px;border-radius:9px;font-weight:800;text-decoration:none;white-space:nowrap}.wt-btn.primary{background:var(--wt-accent);color:#111;border-color:transparent}.wt-btn:disabled{opacity:.35;cursor:not-allowed}.wt-preview-badge{display:inline-flex;align-items:center;border:1px solid #596124;color:var(--wt-accent);border-radius:999px;padding:5px 8px;font-size:9px;font-weight:900;white-space:nowrap}
.wt-top{height:58px;position:sticky;top:0;z-index:30;display:flex;gap:10px;align-items:center;padding:10px 14px;border-bottom:1px solid #242427;background:#0b0b0df2;backdrop-filter:blur(10px);overflow-x:auto}.wt-brand{font-weight:950;white-space:nowrap}.wt-brand b{color:var(--wt-accent)}#wtState{margin-right:auto;color:var(--wt-muted);font-size:11px;white-space:nowrap}
.wt-layout{height:calc(100vh - 58px);display:grid;grid-template-columns:230px minmax(0,1fr) 340px;min-width:0;overflow:hidden}.wt-side,.wt-edit,.wt-preview{min-width:0;min-height:0}.wt-side{padding:12px;border-right:1px solid #242427;background:var(--wt-panel);display:flex;flex-direction:column}.wt-side-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.wt-search{width:100%!important;min-height:40px!important;padding:9px 10px!important;border:1px solid var(--wt-line)!important;border-radius:8px!important;background:#111!important;color:#fff!important;margin:0 0 8px!important}.wt-list{display:grid;gap:6px;overflow:auto;min-height:0;padding-right:2px}.wt-game{width:100%;min-width:0;text-align:left;padding:9px 10px;border-radius:9px;border:1px solid transparent;background:#141417;color:#ddd}.wt-game.on{border-color:#737743;background:#1b1b16}.wt-game b{display:block;font-size:12px;line-height:1.25;overflow:hidden;text-overflow:ellipsis}.wt-game small{display:block;color:#777;font-size:9px;line-height:1.35;margin-top:3px}
.wt-edit{overflow:auto;padding:24px 30px 42px;background:#080808}.wt-edit-inner{width:min(860px,100%);margin:0 auto}.wt-kicker{font-size:10px;letter-spacing:.14em;color:var(--wt-accent);font-weight:900}.wt-title{margin:8px 0 22px;font-size:32px;line-height:1.05}.wt-stack{display:grid;gap:16px}.wt-grid2{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:12px}.wt-field{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:7px!important;min-width:0!important}.wt-field>label{display:block!important;width:auto!important;margin:0!important;font-size:12px!important;line-height:1.3!important;font-weight:850!important;color:#f2f2ed!important}.wt-field>input,.wt-field>textarea,.wt-field>select{display:block!important;width:100%!important;min-width:0!important;max-width:none!important;margin:0!important;padding:11px 12px!important;border:1px solid var(--wt-line)!important;border-radius:8px!important;background:#09090b!important;color:#fff!important;font-size:13px!important;line-height:1.4!important;box-shadow:none!important}.wt-field>input,.wt-field>select{min-height:42px!important}.wt-field>textarea{min-height:104px!important;resize:vertical!important}.wt-field>input[readonly],.wt-field>textarea[readonly],.wt-field>select:disabled{opacity:.86}.wt-muted{color:var(--wt-muted);font-size:12px;line-height:1.7}
.wt-destination{padding:15px;border:1px solid #596124;border-radius:13px;background:#15160e}.wt-destination-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:12px}.wt-destination-head strong{display:block;font-size:13px}.wt-destination-head small{display:block;color:#a7a77f;font-size:10px;line-height:1.5;margin-top:4px}.wt-destination-types{display:grid;grid-template-columns:1fr 1fr;gap:10px}.wt-dest{min-width:0;border:1px solid #3b3e42;background:#0b0c0e;color:#b8bbc1;border-radius:10px;padding:13px 14px;text-align:left}.wt-dest b{display:block;font-size:13px}.wt-dest span{display:block;color:#7f838a;font-size:10px;margin-top:4px;line-height:1.5}.wt-dest.on{border-color:var(--wt-accent);box-shadow:inset 0 0 0 1px var(--wt-accent);background:#171a0e}.wt-dest.on b{color:var(--wt-accent)}
.wt-video{padding:12px;border:1px solid var(--wt-line);border-radius:12px;background:#0d0d0f;overflow:hidden}.wt-video-box{width:100%;max-height:440px;aspect-ratio:16/9;background:#060606;border-radius:8px;overflow:hidden;position:relative;display:grid;place-items:center;margin-top:10px}.wt-video-box video,.wt-video-box img{display:block;width:100%!important;height:100%!important;max-width:100%!important;object-fit:contain!important;background:#000}.wt-video-empty{color:#62656b;font-size:12px}.wt-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:11px}.wt-actions.final{padding-top:14px;border-top:1px solid #2b2b30}
.wt-preview{padding:16px;border-left:1px solid #242427;background:var(--wt-panel);overflow:auto}.wt-preview-title{margin-bottom:10px;font-size:10px;letter-spacing:.14em;color:var(--wt-accent);font-weight:900}.wt-phone{width:100%;height:min(70vh,650px);border:1px solid #333;border-radius:20px;overflow:hidden;position:relative;background:#000}.wt-phone video,.wt-phone img{position:absolute;inset:0;width:100%!important;height:100%!important;object-fit:cover!important}.wt-shade{position:absolute;inset:0;background:linear-gradient(#0008,#0000 38%,#000 100%)}.wt-ptop{position:absolute;top:0;left:0;right:0;padding:16px;font-size:10px;font-weight:950}.wt-ptop b{color:var(--wt-accent)}.wt-meta{position:absolute;left:15px;right:42px;bottom:28px;text-shadow:0 2px 10px #000}.wt-label{font-size:9px;color:var(--wt-accent);font-weight:900}.wt-genres{font-size:9px;color:#ddd;margin-top:4px}.wt-live-title{font-size:24px;line-height:1.04;font-weight:950;margin-top:5px}.wt-desc{font-size:11px;line-height:1.55;margin-top:7px}.wt-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px}.wt-tag{font-size:8px;border:1px solid #ffffff48;border-radius:99px;padding:3px 6px;background:#0007}.wt-store{display:inline-block;margin-top:9px;padding:7px 10px;border-radius:99px;background:var(--wt-accent);color:#111;text-decoration:none;font-size:9px;font-weight:900}.wt-preview-foot{margin-top:12px;padding:10px;border:1px solid #2d2f34;border-radius:10px;color:#8d9096;font-size:10px;line-height:1.6}.wt-preview-foot b{color:var(--wt-accent)}
@media(max-width:1180px){.wt-layout{grid-template-columns:220px minmax(0,1fr)}.wt-preview{display:none}.wt-edit{padding:22px}.wt-edit-inner{width:min(780px,100%)}}
@media(max-width:720px){body{overflow:auto}.wt-top{height:auto;flex-wrap:wrap;overflow:visible}.wt-layout{height:auto;display:block;overflow:visible}.wt-side{border-right:0;border-bottom:1px solid #242427;max-height:320px}.wt-list{grid-template-columns:1fr 1fr}.wt-edit{overflow:visible;padding:18px 14px 40px}.wt-grid2,.wt-destination-types{grid-template-columns:1fr}.wt-title{font-size:28px}.wt-video-box{max-height:none}}
</style>
</head>
<body>
<header class="wt-top">
  <div class="wt-brand">HARF-WAY <b>PLAYBACK</b> EDITOR</div>
  <div id="wtState">Preview読込中…</div>
  <span class="wt-preview-badge">PREVIEW ONLY / DB書込なし</span>
  <button class="wt-btn primary" disabled>既存動画を一括最適化</button>
  <button class="wt-btn" disabled>R2お掃除チェック</button>
  <a class="wt-btn" id="wtFeedPreview" href="/?view=discover">フィードプレビュー</a>
  <button id="wtReload" class="wt-btn">再読込</button>
  <button class="wt-btn" disabled>ログアウト</button>
</header>
<div class="wt-layout">
  <aside class="wt-side">
    <div class="wt-side-head"><b>作品</b><button class="wt-btn primary" disabled>＋追加</button></div>
    <input id="wtSearch" class="wt-search" placeholder="作品名で検索" />
    <div id="wtList" class="wt-list"></div>
  </aside>
  <main class="wt-edit">
    <div id="wtEditor" class="wt-edit-inner"><p class="wt-muted">作品データを読み込み中…</p></div>
  </main>
  <aside class="wt-preview">
    <div class="wt-preview-title">LIVE PREVIEW</div>
    <div id="wtLive"></div>
    <div class="wt-preview-foot"><b>投稿先</b>を切り替えると、右のプレビューと「フィードプレビュー」の表示先が連動します。<br />このPreviewでは分類をブラウザ内だけに保存します。</div>
  </aside>
</div>
<script is:inline>
(() => {
  const KEY='ways_content_type_preview_v1';
  const $=q=>document.querySelector(q);
  const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
  let games=[],sel=null,overrides=readOverrides();
  function readOverrides(){try{const v=JSON.parse(localStorage.getItem(KEY)||'{}');return v&&typeof v==='object'?v:{}}catch{return {}}}
  function saveOverrides(){localStorage.setItem(KEY,JSON.stringify(overrides))}
  function kindOf(g){const raw=String(overrides[g.id]||g.contentType||g.content_type||'discover').toLowerCase();return raw==='tip'?'tip':'discover'}
  function cur(){return games.find(x=>x.id===sel)}
  function renderList(){const q=$('#wtSearch').value.toLowerCase().trim(),a=games.filter(g=>!q||String(g.title||'').toLowerCase().includes(q));$('#wtList').innerHTML=a.map(g=>`<button class="wt-game ${g.id===sel?'on':''}" data-id="${esc(g.id)}"><b>${g.status==='published'?'●':'○'} ${esc(g.title||'名称未設定')}</b><small>${esc(g.category||'ジャンル未設定')} / ${kindOf(g).toUpperCase()}</small></button>`).join('')||'<p class="wt-muted">該当なし</p>';$('#wtList').querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>{sel=b.dataset.id;render()})}
  function field(label,value,type='input'){if(type==='textarea')return `<div class="wt-field"><label>${label}</label><textarea readonly>${esc(value)}</textarea></div>`;return `<div class="wt-field"><label>${label}</label><input value="${esc(value)}" readonly></div>`}
  function renderEditor(){const g=cur();if(!g){$('#wtEditor').innerHTML='<p class="wt-muted">作品を選択してください。</p>';return}const kind=kindOf(g);$('#wtEditor').innerHTML=`<div class="wt-kicker">${g.status==='published'?'PUBLISHED':'DRAFT'} / ${esc(g.id)}</div><h1 class="wt-title">${esc(g.title||'新しい作品')}</h1><div class="wt-stack"><div class="wt-grid2">${field('作品名',g.title)}<div class="wt-field"><label>公開状態</label><select disabled><option>${g.status==='published'?'公開':'下書き'}</option></select></div></div>${field('紹介文',g.description||'','textarea')}<div class="wt-destination"><div class="wt-destination-head"><div><strong>投稿先</strong><small>WAYS内でどの棚に表示するかを選びます。</small></div><span class="wt-preview-badge">NEW</span></div><div class="wt-destination-types"><button class="wt-dest ${kind==='discover'?'on':''}" data-kind="discover"><b>DISCOVER</b><span>ゲームを見つけてもらう通常のWAYS</span></button><button class="wt-dest ${kind==='tip'?'on':''}" data-kind="tip"><b>TIP</b><span>攻略・小ネタ・遊び方のヒント</span></button></div></div>${field('ストアURL',g.storeUrl||'')}${field('記事URL',g.articleUrl||'')}<div class="wt-grid2">${field('基本ジャンル（自動）',g.category||'')}${field('手動タグ（カンマ区切り）',(g.tags||[]).join(', '))}</div><div class="wt-video"><div class="wt-field"><label>動画URL</label><input value="${esc(g.video||'')}" readonly></div><div class="wt-video-box">${g.video?`<video controls muted playsinline preload="metadata" ${g.thumbnailUrl?`poster="${esc(g.thumbnailUrl)}"`:''} src="${esc(g.video)}"></video>`:'<div class="wt-video-empty">動画未設定</div>'}</div><div class="wt-actions"><button class="wt-btn primary" disabled>＋動画をアップロード</button><button class="wt-btn" disabled>ローカル動画で縦横テスト</button><button class="wt-btn" disabled>R2動画一覧</button></div></div><div class="wt-actions final"><button id="wtPreviewSave" class="wt-btn primary">Preview分類を保存</button><button class="wt-btn" disabled>複製</button><button class="wt-btn" disabled>大きくプレビュー</button><button class="wt-btn" disabled>管理DBから削除</button></div></div>`;$('#wtEditor').querySelectorAll('[data-kind]').forEach(b=>b.onclick=()=>{overrides[g.id]=b.dataset.kind==='tip'?'tip':'discover';saveOverrides();$('#wtFeedPreview').href='/?view='+overrides[g.id];render();$('#wtState').textContent=`Preview保存済み / ${g.title} → ${overrides[g.id].toUpperCase()}`});$('#wtPreviewSave').onclick=()=>{$('#wtState').textContent=`Preview保存済み / ${g.title} → ${kindOf(g).toUpperCase()}`}}
  function renderLive(){const g=cur();if(!g){$('#wtLive').innerHTML='<p class="wt-muted">作品を選択してください。</p>';return}const kind=kindOf(g),media=g.video?`<video muted playsinline loop autoplay ${g.thumbnailUrl?`poster="${esc(g.thumbnailUrl)}"`:''} src="${esc(g.video)}"></video>`:(g.thumbnailUrl?`<img src="${esc(g.thumbnailUrl)}" alt="">`:'');$('#wtLive').innerHTML=`<div class="wt-phone">${media}<div class="wt-shade"></div><div class="wt-ptop">HARF-WAY <b>PLAYBACK</b></div><div class="wt-meta"><div class="wt-label">${kind.toUpperCase()} · ${g.status==='published'?'PUBLISHED':'DRAFT PREVIEW'}</div>${g.category?`<div class="wt-genres">${esc(g.category)}</div>`:''}<div class="wt-live-title">${esc(g.title||'Untitled')}</div>${g.description?`<div class="wt-desc">${esc(g.description)}</div>`:''}${(g.tags||[]).length?`<div class="wt-tags">${g.tags.slice(0,4).map(t=>`<span class="wt-tag">#${esc(t)}</span>`).join('')}</div>`:''}${g.storeUrl?`<a class="wt-store" href="${esc(g.storeUrl)}" target="_blank">ストアで見る ↗</a>`:''}</div></div>`}
  function render(){renderList();renderEditor();renderLive()}
  async function load(){try{$('#wtState').textContent='Preview読込中…';const r=await fetch('/api/games-live',{cache:'no-store'}),j=await r.json();games=Array.isArray(j.entries)?j.entries:[];games.sort((a,b)=>String(a.title||'').localeCompare(String(b.title||''),'ja'));if(!sel||!games.some(g=>g.id===sel))sel=games[0]?.id||null;$('#wtState').textContent=`Preview / ${games.length}作品 · DB書込なし`;render()}catch(e){console.error(e);$('#wtState').textContent='読込エラー';$('#wtEditor').innerHTML='<p class="wt-muted">WAYSデータを読み込めませんでした。</p>'}}
  $('#wtSearch').oninput=renderList;$('#wtReload').onclick=load;load();
})();
</script>
</body>
</html>
