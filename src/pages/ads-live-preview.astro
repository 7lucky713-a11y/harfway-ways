---
const title = 'HARF-WAY ADS｜実画面プレビュー';
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0b0c0d;color:#f3f3ed;color-scheme:dark}
      *{box-sizing:border-box}body{margin:0;background:#0b0c0d;color:#f3f3ed}.shell{min-height:100vh}.bar{position:sticky;top:0;z-index:20;border-bottom:1px solid #2c3032;background:rgba(11,12,13,.96);backdrop-filter:blur(14px)}.bar-inner{max-width:1440px;margin:auto;padding:13px 18px;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:grid;gap:3px;min-width:0}.brand small{color:#dfff49;font:900 9px/1 ui-monospace,monospace;letter-spacing:.13em}.brand b{font-size:18px;letter-spacing:-.035em}.brand span{color:#7f8588;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tools{display:flex;align-items:center;gap:9px;flex:none}.seg{display:flex;padding:3px;border:1px solid #363a3c;border-radius:999px;background:#121415}.seg button,.close{border:0;cursor:pointer}.seg button{min-height:34px;padding:0 12px;border-radius:999px;background:transparent;color:#777e82;font:900 9px/1 ui-monospace,monospace}.seg button.active{background:#f2f2ec;color:#0b0c0d}.close{min-height:40px;padding:0 13px;border:1px solid #363a3c;border-radius:10px;background:#151718;color:#d8dad9;font-size:10px;font-weight:800}.main{max-width:1440px;margin:auto;padding:16px 18px 46px}.guide{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:10px}.guide p{margin:0;color:#909699;font-size:11px;line-height:1.6}.guide strong{color:#edf0e8}.status{flex:none;display:inline-flex;align-items:center;gap:6px;padding:7px 9px;border:1px solid #39432a;border-radius:999px;color:#cddc7d;font:900 8px/1 ui-monospace,monospace;letter-spacing:.06em}.status:before{content:'';width:7px;height:7px;border-radius:50%;background:#dfff49}.placement-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:0 0 10px}.placement-tab{min-height:45px;border:1px solid #303538;border-radius:10px;background:#121415;color:#858c90;text-align:left;padding:8px 10px;cursor:pointer}.placement-tab b{display:block;color:inherit;font-size:10px}.placement-tab span{display:block;margin-top:3px;color:#666d70;font-size:8px}.placement-tab.active{border-color:#82963f;background:#192012;color:#e7ff78}.placement-tab.active span{color:#9dab6b}.stage{display:flex;justify-content:center;align-items:flex-start;width:100%;overflow:auto;padding:12px;border:1px solid #292d2f;border-radius:18px;background:radial-gradient(circle at 50% 0,rgba(223,255,73,.035),transparent 35%),#070809}.device{width:100%;min-width:0;transition:width .2s ease}.device.mobile{width:390px;max-width:100%}.device-frame{width:100%;border:1px solid #3a3e40;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 28px 90px rgba(0,0,0,.4)}iframe{display:block;width:100%;height:900px;border:0;background:#fff}.device.mobile iframe{height:780px}.caption{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:8px 10px;border-bottom:1px solid #303437;background:#111314;color:#777e82;font:800 8px/1.3 ui-monospace,monospace}.caption b{color:#dfff49}.error{padding:50px 20px;text-align:center;color:#8f9699}.error b{display:block;color:#fff;font-size:20px;margin-bottom:7px}
      @media(max-width:680px){.bar-inner{align-items:flex-start;flex-direction:column}.tools{width:100%;justify-content:space-between}.main{padding:12px 8px 32px}.guide{align-items:flex-start;flex-direction:column}.placement-tabs{grid-template-columns:1fr 1fr}.stage{padding:5px;border-radius:12px}.device.mobile{width:100%}iframe,.device.mobile iframe{height:720px}}
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="bar">
        <div class="bar-inner">
          <div class="brand"><small>HARF-WAY ADS / ACTUAL SCREEN</small><b>実画面で掲載位置を確認</b><span id="placementName">実際の公開画面を準備しています。</span></div>
          <div class="tools">
            <div class="seg" id="deviceSwitch"><button type="button" data-device="pc">PC</button><button type="button" data-device="mobile">スマホ</button></div>
            <button class="close" id="closeButton" type="button">閉じる</button>
          </div>
        </div>
      </header>
      <main class="main">
        <div class="guide"><p><strong>黄緑の枠が、入稿中の広告が実際に入る場所です。</strong><br>公開画面の通常コンテンツはそのまま表示し、広告だけPreview素材へ差し替えています。計測はされません。</p><span class="status" id="status">広告位置を準備中</span></div>
        <nav class="placement-tabs" id="placementTabs">
          <button class="placement-tab" type="button" data-placement="playlist"><b>PLAYLIST</b><span>実際のトラック一覧</span></button>
          <button class="placement-tab" type="button" data-placement="scraps"><b>切れ端</b><span>実際のメモ一覧</span></button>
          <button class="placement-tab" type="button" data-placement="playback"><b>WAYS</b><span>実際の動画フィード</span></button>
          <button class="placement-tab" type="button" data-placement="sale"><b>SALE WATCH</b><span>実際のセール一覧</span></button>
        </nav>
        <section class="stage" id="stage">
          <div class="device" id="device">
            <div class="device-frame">
              <div class="caption"><span id="deviceLabel">PC VIEWPORT</span><b>PREVIEW ONLY / NOT COUNTED</b></div>
              <iframe id="actualFrame" title="実際の掲載画面プレビュー" loading="eager"></iframe>
            </div>
          </div>
        </section>
      </main>
    </div>
    <script is:inline>
      (() => {
        const labels={playback:'WAYS',playlist:'PLAYLIST',scraps:'切れ端 / GAME SCRAPBOOK',sale:'SALE WATCH'};
        const params=new URL(location.href).searchParams;
        const id=params.get('id')||'';
        let placement=Object.prototype.hasOwnProperty.call(labels,params.get('placement'))?params.get('placement'):'playlist';
        let device=params.get('device')==='mobile'?'mobile':'pc';
        const frame=document.getElementById('actualFrame');
        const box=document.getElementById('device');
        const status=document.getElementById('status');
        const valid=/^[a-zA-Z0-9_-]+$/.test(id);
        function syncPlacement(){document.getElementById('placementName').textContent=`${labels[placement]} の実際の公開画面で確認しています。`;document.querySelectorAll('[data-placement]').forEach(b=>b.classList.toggle('active',b.dataset.placement===placement));status.textContent='広告位置を準備中';frame.src=`/api/ads-live-frame?placement=${encodeURIComponent(placement)}&id=${encodeURIComponent(id)}`;}
        function syncDevice(){box.classList.toggle('mobile',device==='mobile');document.getElementById('deviceLabel').textContent=device==='mobile'?'MOBILE VIEWPORT / 390px':'PC VIEWPORT';document.querySelectorAll('[data-device]').forEach(b=>b.classList.toggle('active',b.dataset.device===device));}
        document.getElementById('placementTabs').addEventListener('click',e=>{const b=e.target.closest('[data-placement]');if(!b||b.dataset.placement===placement)return;placement=b.dataset.placement;syncPlacement();});
        document.getElementById('deviceSwitch').addEventListener('click',e=>{const b=e.target.closest('[data-device]');if(!b)return;device=b.dataset.device==='mobile'?'mobile':'pc';syncDevice();});
        document.getElementById('closeButton').addEventListener('click',()=>window.close());
        window.addEventListener('message',e=>{if(e.origin!==location.origin)return;if(e.data?.type==='hwads-live-preview-ready'){status.textContent='広告位置を表示中';}});
        syncDevice();
        if(valid)syncPlacement();else{document.getElementById('stage').innerHTML='<div class="error"><b>プレビューを開けません</b>広告主ポータルから、もう一度「実際の掲載プレビュー」を開いてください。</div>';status.textContent='データ不足';document.getElementById('placementName').textContent='プレビュー情報が不足しています。';}
      })();
    </script>
  </body>
</html>
