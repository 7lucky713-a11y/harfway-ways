<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY MEMORY</title>
<style is:global>
:root{--bg:#0a0b0d;--panel:#12151a;--panel2:#0d1014;--line:#2b3139;--text:#f4f4ef;--muted:#919aa5;--lime:#efff35;--green:#7ae79a;--amber:#ffd273;--blue:#83bfff;--red:#ff7b7b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{max-width:1180px;margin:auto;padding:34px 18px 70px}.top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:30px}.ey{font:900 10px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:var(--lime)}h1{font-size:clamp(54px,10vw,110px);line-height:.82;letter-spacing:-.065em;margin:12px 0 18px}.lead{max-width:710px;color:var(--muted);line-height:1.75}.links{display:flex;gap:8px;flex-wrap:wrap}.links a,.btn{border:1px solid #3b434d;border-radius:9px;padding:9px 11px;color:#fff;text-decoration:none;font-size:10px;font-weight:900;background:#15191e;cursor:pointer}.links a.primary,.btn.primary{background:var(--lime);color:#08090a;border-color:var(--lime)}.stamp{font:10px/1.5 ui-monospace,monospace;color:var(--muted);margin-top:8px}.grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px}.panel h2{font-size:11px;letter-spacing:.12em;margin:0 0 14px;color:#dfe4ea}.panelhead{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px}.panelhead h2{margin:0}.count{font:900 9px/1 ui-monospace,monospace;color:var(--lime);border:1px solid #53601f;border-radius:999px;padding:6px 8px}.nowlist,.list,.memos{display:grid;gap:9px}.now{background:var(--panel2);border:1px solid #303741;border-radius:13px;padding:14px}.nowtop{display:flex;gap:10px;justify-content:space-between;align-items:flex-start}.project{font-size:9px;font-weight:950;letter-spacing:.08em;color:var(--blue)}.pill{font:900 8px/1 ui-monospace,monospace;border:1px solid #4c555f;border-radius:999px;padding:5px 7px;color:var(--muted)}.pill.PRODUCTION,.pill.READY{color:var(--green);border-color:#386748}.pill.PREVIEW{color:var(--amber);border-color:#6a592d}.now b{display:block;font-size:14px;margin:8px 0 6px}.now p,.item{margin:0;color:var(--muted);font-size:11px;line-height:1.65}.item{border-left:2px solid #3a424c;padding:2px 0 2px 11px}.wide{grid-column:1 / -1}.memoform{display:grid;grid-template-columns:180px 1fr auto;gap:8px;align-items:stretch}.memoform select,.memoform textarea{border:1px solid #353d46;border-radius:10px;background:#0d1014;color:#fff;font:inherit}.memoform select{padding:0 11px}.memoform textarea{min-height:76px;padding:11px;resize:vertical}.memoform textarea:focus,.memoform select:focus{outline:none;border-color:var(--lime)}.memohint{margin:8px 0 14px;color:var(--muted);font-size:9px;line-height:1.6}.memo{background:var(--panel2);border:1px solid #303741;border-radius:13px;padding:13px}.memotop{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.memometa{font:800 8px/1.5 ui-monospace,monospace;color:var(--muted)}.memo p{white-space:pre-wrap;margin:9px 0 12px;font-size:11px;line-height:1.7;color:#c5cbd2}.memoactions{display:flex;gap:6px;flex-wrap:wrap}.memoactions button{border:1px solid #3b434d;border-radius:8px;padding:7px 9px;background:#15191e;color:#fff;font-size:9px;font-weight:900;cursor:pointer}.memoactions button.delete{color:var(--red);border-color:#5c373b}.empty{border:1px dashed #363e47;border-radius:11px;padding:16px;color:var(--muted);font-size:10px}.toast{min-height:18px;margin-top:8px;color:var(--green);font-size:9px}.footer{margin-top:14px;color:var(--muted);font-size:10px;line-height:1.7;border-top:1px solid var(--line);padding-top:14px}@media(max-width:800px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.top{display:block}.links{margin-top:18px}.memoform{grid-template-columns:1fr}.memoform .btn{min-height:42px}}
</style>
</head>
<body>
<main class="wrap">
<div class="top"><div><div class="ey">HARF-WAY / SAVE DATA</div><h1>MEMORY</h1><p id="headline" class="lead">現在地を読み込み中…</p><div id="stamp" class="stamp"></div></div><div class="links"><a class="primary" href="/control-center">CONTROL CENTER</a><a href="/api/knowledge" target="_blank" rel="noreferrer">RAW API</a></div></div>
<div class="grid">
<section class="panel wide"><h2>いま</h2><div id="now" class="nowlist"></div></section>
<section class="panel wide"><div class="panelhead"><h2>自分メモ / INBOX</h2><span id="memoCount" class="count">0 MEMO</span></div><div class="memoform"><select id="memoProject"><option>GLOBAL</option><option>WAYS</option><option>ADS</option><option>CONTROL_CENTER</option><option>SHOWCASE</option><option>PLAYLIST</option><option>YORIMICHI</option><option>ZINE</option><option>SCRAPS</option><option>R2</option><option>DB_CORE</option><option>OTHER</option></select><textarea id="memoText" placeholder="気づいたこと、改善したいこと、思いつき。雑なままでOK。"></textarea><button id="memoSave" class="btn primary">メモする</button></div><div class="memohint">Preview中はこのブラウザに保存します。本番化後は共有メモへ切り替え、ChatGPTが改善材料として拾えるようにします。</div><div id="memoToast" class="toast"></div><div id="memos" class="memos"></div></section>
<section class="panel"><h2>最近決めたこと</h2><div id="decisions" class="list"></div></section>
<section class="panel"><h2>次にやること</h2><div id="next" class="list"></div></section>
<section class="panel"><h2>最近わかったこと</h2><div id="learned" class="list"></div></section>
<section class="panel"><h2>使い方</h2><div id="how" class="list"></div></section>
</div>
<div class="footer">MEMORYはHARF-WAYとChatGPTの「セーブデータ＋気づきの投入口」です。メモはそのまま正しい情報として扱わず、確認してから集合知や改善タスクへ昇格します。</div>
</main>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const list=(id,items=[])=>document.getElementById(id).innerHTML=items.map(x=>`<div class="item">${esc(x)}</div>`).join('');
const MEMO_KEY='harfway-memory-memos-v01';
function getMemos(){try{return JSON.parse(localStorage.getItem(MEMO_KEY)||'[]')}catch{return[]}}
function setMemos(items){localStorage.setItem(MEMO_KEY,JSON.stringify(items));renderMemos()}
function renderMemos(){const items=getMemos();document.getElementById('memoCount').textContent=`${items.length} MEMO`;document.getElementById('memos').innerHTML=items.length?items.map(x=>`<article class="memo"><div class="memotop"><div class="project">${esc(x.project)}</div><div class="memometa">${esc(new Date(x.createdAt).toLocaleString('ja-JP'))}</div></div><p>${esc(x.text)}</p><div class="memoactions"><button data-copy="${esc(x.id)}">ChatGPTに渡す</button><button class="delete" data-delete="${esc(x.id)}">削除</button></div></article>`).join(''):'<div class="empty">まだメモはありません。思いついたことをそのまま置いてください。</div>';document.querySelectorAll('[data-copy]').forEach(b=>b.onclick=()=>copyMemo(b.dataset.copy));document.querySelectorAll('[data-delete]').forEach(b=>b.onclick=()=>deleteMemo(b.dataset.delete))}
function saveMemo(){const text=document.getElementById('memoText').value.trim();if(!text)return;const items=getMemos();items.unshift({id:`memo-${Date.now()}-${Math.random().toString(36).slice(2,7)}`,project:document.getElementById('memoProject').value,text,createdAt:new Date().toISOString(),status:'INBOX'});setMemos(items);document.getElementById('memoText').value='';document.getElementById('memoToast').textContent='メモしました。';setTimeout(()=>document.getElementById('memoToast').textContent='',1800)}
async function copyMemo(id){const x=getMemos().find(m=>m.id===id);if(!x)return;const text=`HARF-WAY MEMORYのメモです。内容を確認して、必要なら改善案・タスク化・集合知への反映をお願いします。\n\nPROJECT: ${x.project}\nMEMO: ${x.text}`;try{await navigator.clipboard.writeText(text);document.getElementById('memoToast').textContent='ChatGPTに渡す文章をコピーしました。'}catch{document.getElementById('memoToast').textContent='コピーできませんでした。'}setTimeout(()=>document.getElementById('memoToast').textContent='',2200)}
function deleteMemo(id){setMemos(getMemos().filter(m=>m.id!==id));document.getElementById('memoToast').textContent='削除しました。';setTimeout(()=>document.getElementById('memoToast').textContent='',1500)}
document.getElementById('memoSave').onclick=saveMemo;document.getElementById('memoText').addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key==='Enter')saveMemo()});renderMemos();
async function load(){try{const r=await fetch('/memory-snapshot.json',{cache:'no-store'}),d=await r.json();if(!r.ok)throw new Error('snapshot');document.getElementById('headline').textContent=d.headline||'';document.getElementById('stamp').textContent=`UPDATED ${new Date(d.updatedAt).toLocaleString('ja-JP')} / v${d.version||'0.1'}`;document.getElementById('now').innerHTML=(d.now||[]).map(x=>`<article class="now"><div class="nowtop"><div class="project">${esc(x.project)}</div><span class="pill ${esc(x.status)}">${esc(x.status)}</span></div><b>${esc(x.title)}</b><p>${esc(x.detail)}</p></article>`).join('');list('decisions',d.recentDecisions);list('next',d.nextActions);list('learned',d.recentLearnings);list('how',d.howToUse)}catch(e){document.getElementById('headline').textContent='MEMORYの読み込みに失敗しました。';}}
load();
</script>
</body>
</html>
