---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY MEMORY</title>
<style is:global>
:root{--bg:#0a0b0d;--panel:#12151a;--panel2:#0d1014;--line:#2b3139;--text:#f4f4ef;--muted:#919aa5;--lime:#efff35;--green:#7ae79a;--amber:#ffd273;--blue:#83bfff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{max-width:1180px;margin:auto;padding:34px 18px 70px}.top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:30px}.ey{font:900 10px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:var(--lime)}h1{font-size:clamp(54px,10vw,110px);line-height:.82;letter-spacing:-.065em;margin:12px 0 18px}.lead{max-width:710px;color:var(--muted);line-height:1.75}.links{display:flex;gap:8px;flex-wrap:wrap}.links a{border:1px solid #3b434d;border-radius:9px;padding:9px 11px;color:#fff;text-decoration:none;font-size:10px;font-weight:900;background:#15191e}.links a.primary{background:var(--lime);color:#08090a;border-color:var(--lime)}.stamp{font:10px/1.5 ui-monospace,monospace;color:var(--muted);margin-top:8px}.grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px}.panel h2{font-size:11px;letter-spacing:.12em;margin:0 0 14px;color:#dfe4ea}.nowlist,.list{display:grid;gap:9px}.now{background:var(--panel2);border:1px solid #303741;border-radius:13px;padding:14px}.nowtop{display:flex;gap:10px;justify-content:space-between;align-items:flex-start}.project{font-size:9px;font-weight:950;letter-spacing:.08em;color:var(--blue)}.pill{font:900 8px/1 ui-monospace,monospace;border:1px solid #4c555f;border-radius:999px;padding:5px 7px;color:var(--muted)}.pill.PRODUCTION,.pill.READY{color:var(--green);border-color:#386748}.pill.PREVIEW{color:var(--amber);border-color:#6a592d}.now b{display:block;font-size:14px;margin:8px 0 6px}.now p,.item{margin:0;color:var(--muted);font-size:11px;line-height:1.65}.item{border-left:2px solid #3a424c;padding:2px 0 2px 11px}.item strong{color:var(--text)}.wide{grid-column:1 / -1}.footer{margin-top:14px;color:var(--muted);font-size:10px;line-height:1.7;border-top:1px solid var(--line);padding-top:14px}@media(max-width:800px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.top{display:block}.links{margin-top:18px}}
</style>
</head>
<body>
<main class="wrap">
<div class="top"><div><div class="ey">HARF-WAY / SAVE DATA</div><h1>MEMORY</h1><p id="headline" class="lead">現在地を読み込み中…</p><div id="stamp" class="stamp"></div></div><div class="links"><a class="primary" href="/control-center">CONTROL CENTER</a><a href="/knowledge">RAW KNOWLEDGE</a></div></div>
<div class="grid">
<section class="panel wide"><h2>いま</h2><div id="now" class="nowlist"></div></section>
<section class="panel"><h2>最近決めたこと</h2><div id="decisions" class="list"></div></section>
<section class="panel"><h2>次にやること</h2><div id="next" class="list"></div></section>
<section class="panel"><h2>最近わかったこと</h2><div id="learned" class="list"></div></section>
<section class="panel"><h2>使い方</h2><div id="how" class="list"></div></section>
</div>
<div class="footer">ここは管理画面ではなく、HARF-WAYとChatGPTの「セーブデータを見る画面」です。細かい集合知の管理はRAW KNOWLEDGE側で行います。</div>
</main>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const list=(id,items=[])=>document.getElementById(id).innerHTML=items.map(x=>`<div class="item">${esc(x)}</div>`).join('');
async function load(){try{const r=await fetch('/memory-snapshot.json',{cache:'no-store'}),d=await r.json();if(!r.ok)throw new Error('snapshot');document.getElementById('headline').textContent=d.headline||'';document.getElementById('stamp').textContent=`UPDATED ${new Date(d.updatedAt).toLocaleString('ja-JP')} / v${d.version||'0.1'}`;document.getElementById('now').innerHTML=(d.now||[]).map(x=>`<article class="now"><div class="nowtop"><div class="project">${esc(x.project)}</div><span class="pill ${esc(x.status)}">${esc(x.status)}</span></div><b>${esc(x.title)}</b><p>${esc(x.detail)}</p></article>`).join('');list('decisions',d.recentDecisions);list('next',d.nextActions);list('learned',d.recentLearnings);list('how',d.howToUse)}catch(e){document.getElementById('headline').textContent='MEMORYの読み込みに失敗しました。';}}
load();
</script>
</body>
</html>
