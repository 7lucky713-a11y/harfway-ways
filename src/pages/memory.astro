<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY MEMORY</title>
<style is:global>
:root{--bg:#0a0b0d;--panel:#12151a;--panel2:#0d1014;--line:#2b3139;--text:#f4f4ef;--muted:#919aa5;--lime:#efff35;--green:#7ae79a;--amber:#ffd273;--blue:#83bfff;--red:#ff7b7b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.wrap{max-width:1180px;margin:auto;padding:34px 18px 70px}.top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:30px}.ey{font:900 10px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:var(--lime)}h1{font-size:clamp(54px,10vw,110px);line-height:.82;letter-spacing:-.065em;margin:12px 0 18px}.lead{max-width:710px;color:var(--muted);line-height:1.75}.links{display:flex;gap:8px;flex-wrap:wrap}.links a,.btn{border:1px solid #3b434d;border-radius:9px;padding:9px 11px;color:#fff;text-decoration:none;font-size:10px;font-weight:900;background:#15191e;cursor:pointer}.links a.primary,.btn.primary{background:var(--lime);color:#08090a;border-color:var(--lime)}.btn:disabled{opacity:.45;cursor:not-allowed}.stamp{font:10px/1.5 ui-monospace,monospace;color:var(--muted);margin-top:8px}.grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px}.panel h2{font-size:11px;letter-spacing:.12em;margin:0 0 14px;color:#dfe4ea}.panelhead{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px}.panelhead h2{margin:0}.count{font:900 9px/1 ui-monospace,monospace;color:var(--lime);border:1px solid #53601f;border-radius:999px;padding:6px 8px}.nowlist,.list,.memos{display:grid;gap:9px}.now{background:var(--panel2);border:1px solid #303741;border-radius:13px;padding:14px}.nowtop{display:flex;gap:10px;justify-content:space-between;align-items:flex-start}.project{font-size:9px;font-weight:950;letter-spacing:.08em;color:var(--blue)}.pill{font:900 8px/1 ui-monospace,monospace;border:1px solid #4c555f;border-radius:999px;padding:5px 7px;color:var(--muted)}.pill.PRODUCTION,.pill.READY{color:var(--green);border-color:#386748}.pill.PREVIEW{color:var(--amber);border-color:#6a592d}.now b{display:block;font-size:14px;margin:8px 0 6px}.now p,.item{margin:0;color:var(--muted);font-size:11px;line-height:1.65}.item{border-left:2px solid #3a424c;padding:2px 0 2px 11px}.wide{grid-column:1 / -1}.authbar{display:none;grid-template-columns:minmax(220px,1fr) auto;gap:8px;align-items:center;margin-bottom:10px;padding:11px;border:1px solid #5d522e;border-radius:11px;background:#17140c}.authbar.show{display:grid}.authbar input{min-width:0;border:1px solid #514a35;border-radius:9px;background:#0d1014;color:#fff;padding:10px 11px;font-size:11px}.authnote{grid-column:1 / -1;color:#b7ab82;font-size:9px;line-height:1.5}.memoform{display:grid;grid-template-columns:180px 1fr auto;gap:8px;align-items:stretch}.memoform select,.memoform textarea{border:1px solid #353d46;border-radius:10px;background:#0d1014;color:#fff;font:inherit}.memoform select{padding:0 11px}.memoform textarea{min-height:76px;padding:11px;resize:vertical}.memoform textarea:focus,.memoform select:focus,.authbar input:focus{outline:none;border-color:var(--lime)}.memohint{margin:8px 0 8px;color:var(--muted);font-size:9px;line-height:1.6}.memoaux{display:flex;gap:8px;align-items:center;justify-content:space-between;margin:0 0 14px;padding:9px 10px;border:1px solid #303741;border-radius:10px;background:#0d1014}.mirrorstate{font:900 9px/1.45 ui-monospace,monospace;color:var(--muted)}.mirrorstate.ready{color:var(--green)}.mirrorstate.warn{color:var(--amber)}.memo{background:var(--panel2);border:1px solid #303741;border-radius:13px;padding:13px}.memo.archived{opacity:.78}.memotop{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.memometa{font:800 8px/1.5 ui-monospace,monospace;color:var(--muted)}.memo p{white-space:pre-wrap;margin:9px 0 12px;font-size:11px;line-height:1.7;color:#c5cbd2}.memoactions{display:flex;gap:6px;flex-wrap:wrap}.memoactions button{border:1px solid #3b434d;border-radius:8px;padding:7px 9px;background:#15191e;color:#fff;font-size:9px;font-weight:900;cursor:pointer}.memoactions button.archive{color:var(--amber);border-color:#66572c}.memoactions button.restore{color:var(--green);border-color:#386748}.memoarchive{margin-top:14px;border:1px solid #303741;border-radius:11px;background:#0d1014}.memoarchive summary{cursor:pointer;padding:11px 12px;color:var(--muted);font:900 9px/1.4 ui-monospace,monospace;list-style:none}.memoarchive summary::-webkit-details-marker{display:none}.memoarchive summary::before{content:'＋ ';color:var(--amber)}.memoarchive[open] summary::before{content:'− '}.memoarchive .memos{padding:0 10px 10px}.empty{border:1px dashed #363e47;border-radius:11px;padding:16px;color:var(--muted);font-size:10px}.toast{min-height:18px;margin-top:8px;color:var(--green);font-size:9px}.toast.bad{color:var(--red)}.footer{margin-top:14px;color:var(--muted);font-size:10px;line-height:1.7;border-top:1px solid var(--line);padding-top:14px}@media(max-width:800px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.top{display:block}.links{margin-top:18px}.memoform,.authbar{grid-template-columns:1fr}.memoform .btn{min-height:42px}.authnote{grid-column:auto}.memoaux{align-items:flex-start;flex-direction:column}}
</style>
</head>
<body>
<main class="wrap">
<div class="top"><div><div class="ey">HARF-WAY / SAVE DATA</div><h1>MEMORY</h1><p id="headline" class="lead">現在地を読み込み中…</p><div id="stamp" class="stamp"></div></div><div class="links"><a class="primary" href="/control-center">CONTROL CENTER</a><a href="/api/knowledge" target="_blank" rel="noreferrer">RAW API</a></div></div>
<div class="grid">
<section class="panel wide"><h2>いま</h2><div id="now" class="nowlist"></div></section>
<section class="panel wide"><div class="panelhead"><h2>自分メモ / INBOX</h2><span id="memoCount" class="count">0 MEMO</span></div><div id="memoAuth" class="authbar"><input id="memoAdminKey" type="password" autocomplete="off" placeholder="既存の管理キー"><button id="memoConnect" class="btn primary">共有メモに接続</button><div class="authnote">キーはこのブラウザセッション内だけに保持し、MEMORYや集合知には保存しません。</div></div><div class="memoform"><select id="memoProject"><option>GLOBAL</option><option>WAYS</option><option>ADS</option><option>CONTROL_CENTER</option><option>SHOWCASE</option><option>PLAYLIST</option><option>YORIMICHI</option><option>ZINE</option><option>SCRAPS</option><option>R2</option><option>DB_CORE</option><option>OTHER</option></select><textarea id="memoText" placeholder="気づいたこと、改善したいこと、思いつき。雑なままでOK。"></textarea><button id="memoSave" class="btn primary">メモする</button></div><div id="memoHint" class="memohint">保存先を確認中…</div><div class="memoaux"><span id="mirrorState" class="mirrorstate">GITHUB MIRROR / CHECKING</span><button id="memoSync" class="btn" type="button" disabled>GitHubへ同期</button></div><div id="memoToast" class="toast"></div><div id="memos" class="memos"></div><details id="memoArchive" class="memoarchive"><summary>しまったメモ / <span id="archivedCount">0</span></summary><div id="archivedMemos" class="memos"></div></details></section>
<section class="panel"><h2>最近決めたこと</h2><div id="decisions" class="list"></div></section>
<section class="panel"><h2>次にやること</h2><div id="next" class="list"></div></section>
<section class="panel"><h2>最近わかったこと</h2><div id="learned" class="list"></div></section>
<section class="panel"><h2>使い方</h2><div id="how" class="list"></div></section>
</div>
<div class="footer">MEMORYはHARF-WAYとChatGPTの「セーブデータ＋気づきの投入口」です。メモはそのまま正しい情報として扱わず、確認してから改善タスクや集合知へ昇格します。「しまう」とNeonには残したまま、新規Chatが読むINBOXから外れます。</div>
</main>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const list=(id,items=[])=>document.getElementById(id).innerHTML=items.map(x=>`<div class="item">${esc(x)}</div>`).join('');
const LOCAL_MEMO_KEY='harfway-memory-memos-v01',LOCAL_ARCHIVE_KEY='harfway-memory-memos-archive-v01',SESSION_KEY='harfway-memory-admin-key-v01';
let memoMode='checking',remoteMemos=[],remoteArchivedMemos=[],mirrorInfo={};
function adminKey(){return sessionStorage.getItem(SESSION_KEY)||''}
function authHeaders(){const key=adminKey();return key?{'x-admin-key':key}:{}}
function readLocal(key){try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}}
function writeLocal(key,items){localStorage.setItem(key,JSON.stringify(items));renderMemos()}
function getLocalMemos(){return readLocal(LOCAL_MEMO_KEY)}
function getLocalArchivedMemos(){return readLocal(LOCAL_ARCHIVE_KEY)}
function activeMemos(){return memoMode==='remote'?remoteMemos:getLocalMemos()}
function archivedMemos(){return memoMode==='remote'?remoteArchivedMemos:getLocalArchivedMemos()}
function toast(message,bad=false){const el=document.getElementById('memoToast');el.textContent=message;el.className='toast'+(bad?' bad':'');setTimeout(()=>{el.textContent='';el.className='toast'},2800)}
function applyMirror(mirror={}){mirrorInfo=mirror||{};const state=document.getElementById('mirrorState'),sync=document.getElementById('memoSync');if(memoMode!=='remote'){state.textContent='GITHUB MIRROR / PREVIEW OFF';state.className='mirrorstate';sync.disabled=true;return}if(mirrorInfo.configured){state.textContent=mirrorInfo.synced?'GITHUB MIRROR / SYNCED':'GITHUB MIRROR / READY';state.className='mirrorstate ready';sync.disabled=false}else{state.textContent='GITHUB MIRROR / TOKEN未設定';state.className='mirrorstate warn';sync.disabled=true}}
function memoCard(x,archived=false){return `<article class="memo ${archived?'archived':''}"><div class="memotop"><div class="project">${esc(x.project)}</div><div class="memometa">${archived?'ARCHIVED / ':''}${esc(new Date(x.updatedAt||x.createdAt||Date.now()).toLocaleString('ja-JP'))}</div></div><p>${esc(x.text||x.body)}</p><div class="memoactions">${archived?`<button class="restore" data-restore="${esc(x.id)}">戻す</button>`:`<button data-copy="${esc(x.id)}">ChatGPTに渡す</button><button class="archive" data-archive="${esc(x.id)}">しまう</button>`}</div></article>`}
function renderMemos(){const active=activeMemos(),archived=archivedMemos();document.getElementById('memoCount').textContent=`${active.length} MEMO`;document.getElementById('archivedCount').textContent=String(archived.length);document.getElementById('memos').innerHTML=active.length?active.map(x=>memoCard(x,false)).join(''):'<div class="empty">INBOXは空です。必要なメモだけここに置いてください。</div>';document.getElementById('archivedMemos').innerHTML=archived.length?archived.map(x=>memoCard(x,true)).join(''):'<div class="empty">しまったメモはありません。</div>';document.querySelectorAll('[data-copy]').forEach(b=>b.onclick=()=>copyMemo(b.dataset.copy));document.querySelectorAll('[data-archive]').forEach(b=>b.onclick=()=>archiveMemo(b.dataset.archive));document.querySelectorAll('[data-restore]').forEach(b=>b.onclick=()=>restoreMemo(b.dataset.restore))}
async function loadMemos(){memoMode='checking';const auth=document.getElementById('memoAuth'),hint=document.getElementById('memoHint');try{const r=await fetch('/api/memory-memos',{cache:'no-store',headers:authHeaders()});const j=await r.json().catch(()=>({}));if(r.status===401){memoMode='locked';auth.classList.add('show');hint.textContent='Production共有メモは管理キー接続後に読み書きできます。キーはセッション内だけ保持します。';applyMirror({});renderMemos();return}if(!r.ok||!j.ok)throw new Error(j.error||`HTTP ${r.status}`);if(j.storage==='browser-local'){memoMode='local';auth.classList.remove('show');hint.textContent='Previewではこのブラウザだけに保存します。Production DB / private GitHubには書き込みません。しまう／戻すもローカルだけで試せます。';applyMirror(j.mirror);renderMemos();return}memoMode='remote';remoteMemos=(j.items||[]).map(x=>({...x,text:x.body}));remoteArchivedMemos=(j.archivedItems||[]).map(x=>({...x,text:x.body}));auth.classList.remove('show');applyMirror(j.mirror);hint.textContent=j.mirror?.configured?'Shared Content Coreが正本です。「しまう」とNeonには残り、private GitHubと新規ChatのREAD対象から外れます。':'Shared Content Coreに保存中。private GitHub同期はトークン設定後に有効になります。';renderMemos()}catch(e){memoMode='local';auth.classList.remove('show');hint.textContent='共有メモ接続を確認できないため、このブラウザ内のメモだけ表示しています。';applyMirror({});renderMemos();toast('メモ保存先の確認に失敗しました。',true)}}
function mirrorToast(prefix,mirror){applyMirror(mirror);if(mirror?.synced)return toast(`${prefix} private GitHubも更新しました。`);if(mirror?.configured===false)return toast(`${prefix} GitHub同期はトークン未設定です。`,true);if(mirror?.ok===false)return toast(`${prefix} Neon更新済み / GitHub同期だけ失敗しました。`,true);return toast(prefix)}
async function saveMemo(){const area=document.getElementById('memoText'),content=area.value.trim();if(!content)return;if(memoMode==='locked'){document.getElementById('memoAuth').classList.add('show');toast('先に共有メモへ接続してください。',true);return}const project=document.getElementById('memoProject').value;if(memoMode==='remote'){try{const r=await fetch('/api/memory-memos',{method:'POST',headers:{'content-type':'application/json',...authHeaders()},body:JSON.stringify({project,body:content})}),j=await r.json().catch(()=>({}));if(!r.ok||!j.ok)throw new Error(j.error||`HTTP ${r.status}`);remoteMemos.unshift({...j.item,text:j.item?.body});area.value='';renderMemos();mirrorToast('共有メモに保存しました。',j.mirror);return}catch(e){if(e.message==='secret_like_content_rejected')toast('秘密値らしい内容はメモに保存できません。',true);else toast('共有メモへの保存に失敗しました。',true);return}}const items=getLocalMemos();items.unshift({id:`memo-${Date.now()}-${Math.random().toString(36).slice(2,7)}`,project,text:content,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),status:'INBOX'});writeLocal(LOCAL_MEMO_KEY,items);area.value='';toast('このブラウザにメモしました。')}
async function copyMemo(id){const x=activeMemos().find(m=>m.id===id);if(!x)return;const body=x.text||x.body||'';const text=`HARF-WAY MEMORYのメモです。内容を確認して、必要なら改善案・タスク化・集合知への反映をお願いします。\n\nPROJECT: ${x.project}\nMEMO: ${body}`;try{await navigator.clipboard.writeText(text);toast('ChatGPTに渡す文章をコピーしました。')}catch{toast('コピーできませんでした。',true)}}
async function patchMemo(action,id){const r=await fetch('/api/memory-memos',{method:'PATCH',headers:{'content-type':'application/json',...authHeaders()},body:JSON.stringify({action,id})}),j=await r.json().catch(()=>({}));if(!r.ok||!j.ok)throw new Error(j.error||`HTTP ${r.status}`);return j}
async function archiveMemo(id){if(memoMode==='remote'){try{const j=await patchMemo('archive',id);const moved={...j.item,text:j.item?.body};remoteMemos=remoteMemos.filter(m=>m.id!==id);remoteArchivedMemos.unshift(moved);renderMemos();mirrorToast('メモをしまいました。',j.mirror)}catch{toast('メモをしまえませんでした。',true)}return}const active=getLocalMemos(),x=active.find(m=>m.id===id);if(!x)return;writeLocal(LOCAL_MEMO_KEY,active.filter(m=>m.id!==id));const archived=getLocalArchivedMemos();archived.unshift({...x,status:'ARCHIVED',updatedAt:new Date().toISOString()});writeLocal(LOCAL_ARCHIVE_KEY,archived);toast('メモをしまいました。')}
async function restoreMemo(id){if(memoMode==='remote'){try{const j=await patchMemo('restore',id);const moved={...j.item,text:j.item?.body};remoteArchivedMemos=remoteArchivedMemos.filter(m=>m.id!==id);remoteMemos.unshift(moved);renderMemos();mirrorToast('メモをINBOXへ戻しました。',j.mirror)}catch{toast('メモを戻せませんでした。',true)}return}const archived=getLocalArchivedMemos(),x=archived.find(m=>m.id===id);if(!x)return;writeLocal(LOCAL_ARCHIVE_KEY,archived.filter(m=>m.id!==id));const active=getLocalMemos();active.unshift({...x,status:'INBOX',updatedAt:new Date().toISOString()});writeLocal(LOCAL_MEMO_KEY,active);toast('メモをINBOXへ戻しました。')}
async function syncAllMemos(){if(memoMode!=='remote'||!mirrorInfo.configured)return;const button=document.getElementById('memoSync');button.disabled=true;try{const r=await fetch('/api/memory-memos',{method:'PATCH',headers:{'content-type':'application/json',...authHeaders()},body:JSON.stringify({action:'sync_all'})}),j=await r.json().catch(()=>({}));if(!r.ok||!j.ok)throw new Error(j.error||`HTTP ${r.status}`);applyMirror(j.mirror);if(j.mirror?.synced)toast(`private GitHubへactive ${j.mirror.count||0}件を同期しました。`);else toast('GitHub同期を完了できませんでした。',true)}catch{toast('GitHub同期に失敗しました。',true)}finally{button.disabled=!mirrorInfo.configured}}
document.getElementById('memoConnect').onclick=async()=>{const key=document.getElementById('memoAdminKey').value.trim();if(!key){toast('管理キーを入力してください。',true);return}sessionStorage.setItem(SESSION_KEY,key);document.getElementById('memoAdminKey').value='';await loadMemos();if(memoMode==='remote')toast('共有メモに接続しました。');else if(memoMode==='locked'){sessionStorage.removeItem(SESSION_KEY);toast('管理キーを確認できませんでした。',true)}};
document.getElementById('memoSave').onclick=saveMemo;document.getElementById('memoSync').onclick=syncAllMemos;document.getElementById('memoText').addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key==='Enter')saveMemo()});loadMemos();
async function load(){try{const r=await fetch('/memory-snapshot.json',{cache:'no-store'}),d=await r.json();if(!r.ok)throw new Error('snapshot');document.getElementById('headline').textContent=d.headline||'';document.getElementById('stamp').textContent=`UPDATED ${new Date(d.updatedAt).toLocaleString('ja-JP')} / v${d.version||'0.1'}`;document.getElementById('now').innerHTML=(d.now||[]).map(x=>`<article class="now"><div class="nowtop"><div class="project">${esc(x.project)}</div><span class="pill ${esc(x.status)}">${esc(x.status)}</span></div><b>${esc(x.title)}</b><p>${esc(x.detail)}</p></article>`).join('');list('decisions',d.recentDecisions);list('next',d.nextActions);list('learned',d.recentLearnings);list('how',d.howToUse)}catch(e){document.getElementById('headline').textContent='MEMORYの読み込みに失敗しました。';}}
load();
</script>
</body>
</html>
