<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>WAYS WEEKLY EDITOR v3</title>
<style>
:root{--bg:#090909;--panel:#111214;--panel2:#15171a;--line:#2d3035;--text:#f4f4ee;--muted:#8d929a;--acid:#efff35}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}button,input,textarea,select{font:inherit}.app{height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 440px;overflow:hidden}.library{min-width:0;height:100vh;overflow:auto;padding:18px 22px 28px;border-right:1px solid var(--line);background:#0a0b0c}.editor{height:100vh;overflow:auto;padding:18px;background:#0d0e0f}.brand{font-size:9px;letter-spacing:.18em;color:var(--acid);font-weight:950}.lib-top{position:sticky;top:-18px;z-index:10;background:#0a0b0cf3;backdrop-filter:blur(14px);padding:18px 0 12px;border-bottom:1px solid #202226}.lib-head{display:flex;align-items:end;justify-content:space-between;gap:18px}.lib-title{margin:4px 0 0;font-size:30px;line-height:.95;letter-spacing:-.045em}.lib-meta{font:9px ui-monospace,monospace;color:#747982;white-space:nowrap}.search-row{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:8px;margin-top:12px}.search{width:100%;background:#111316;color:#fff;border:1px solid #383c43;border-radius:10px;padding:11px 13px}.reset{border:1px solid #393c42;background:#15171a;color:#ddd;border-radius:10px;padding:0 12px;cursor:pointer;font-size:9px}.quick{display:flex;gap:6px;align-items:center;overflow-x:auto;padding:9px 0 2px;scrollbar-width:none}.quick::-webkit-scrollbar{display:none}.quick-label{font-size:8px;color:#666c74;letter-spacing:.12em;margin-right:2px;white-space:nowrap}.chip,.tab,.mini,.btn{border:1px solid #383c42;background:#15171a;color:#e8e9e5;border-radius:999px;cursor:pointer}.chip{padding:6px 9px;font-size:8px;white-space:nowrap}.chip.on,.tab.on{background:var(--acid);border-color:var(--acid);color:#111;font-weight:900}.filters{display:grid;grid-template-columns:repeat(5,minmax(115px,1fr));gap:7px;margin-top:9px}.filter{display:grid;gap:4px}.filter label{font-size:7px;color:#666c74;letter-spacing:.1em}.filter select{width:100%;background:#111316;color:#eaeae5;border:1px solid #30343a;border-radius:8px;padding:7px 8px;font-size:9px}.state-row{display:flex;align-items:center;gap:6px;margin-top:9px}.tab{padding:7px 10px;font-size:8px}.state-spacer{flex:1}.mini{padding:7px 9px;font-size:8px}.mini.primary,.btn.primary{background:var(--acid);color:#111;border-color:var(--acid);font-weight:950}.stats{display:flex;gap:8px;margin:12px 0 9px;font:8px ui-monospace,monospace;color:#70757d}.stats b{color:#e8e9e5}.games{display:grid;grid-template-columns:repeat(auto-fill,minmax(176px,1fr));gap:10px}.game{position:relative;min-width:0;border:1px solid #292c31;background:#111214;border-radius:11px;overflow:hidden;cursor:pointer;transition:.15s transform,.15s border-color,.15s box-shadow}.game:hover{transform:translateY(-2px);border-color:#565b64}.game.selected{border-color:var(--acid);box-shadow:0 0 0 1px #efff3524}.thumb-wrap{position:relative;aspect-ratio:16/9;background:#060606;overflow:hidden}.thumb{width:100%;height:100%;object-fit:cover;display:block}.thumb-empty{width:100%;height:100%;display:grid;place-items:center;color:#555;font-size:8px}.add{position:absolute;z-index:2;right:7px;top:7px;width:28px;height:28px;border-radius:50%;border:1px solid #ffffff45;background:#08090acc;color:#fff;cursor:pointer;font-weight:900}.game.selected .add{background:var(--acid);border-color:var(--acid);color:#111}.card-use{position:absolute;left:7px;top:7px;background:#08090acc;border:1px solid #ffffff2b;color:#ddd;border-radius:999px;padding:4px 6px;font-size:7px}.card-use.fresh{color:var(--acid);border-color:#a8b62d80}.card-body{padding:9px}.game-name{font-size:11px;font-weight:900;line-height:1.28;min-height:28px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.game-cat{font-size:7px;color:#70757d;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badges{display:flex;gap:4px;flex-wrap:wrap;margin-top:7px}.badge{font-size:6px;line-height:1;border:1px solid #35383e;color:#8c9199;border-radius:999px;padding:4px 5px}.empty{padding:30px 18px;border:1px dashed #383b41;border-radius:12px;text-align:center;color:#70757e;font-size:10px;grid-column:1/-1}.editor-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin-bottom:12px}.editor-head h2{font-size:26px;line-height:.96;letter-spacing:-.04em;margin:4px 0 0}.count{font:8px ui-monospace,monospace;color:#7b8088}.panel{border:1px solid var(--line);background:var(--panel);border-radius:11px;padding:12px;margin-bottom:10px}.panel-title{font-size:8px;letter-spacing:.13em;color:var(--acid);font-weight:900;margin-bottom:9px}.grid2{display:grid;grid-template-columns:88px 1fr;gap:8px}.field{display:grid;gap:4px;margin-bottom:7px}.field:last-child{margin-bottom:0}.field label{font-size:7px;letter-spacing:.09em;color:#737880}.field input,.field textarea,.field select{width:100%;background:#0d0e10;color:#fff;border:1px solid #33363c;border-radius:7px;padding:8px;font-size:9px}.field textarea{min-height:50px;resize:vertical;line-height:1.5}.toolbar{display:flex;gap:6px;flex-wrap:wrap}.btn{padding:8px 10px;font-size:8px;border-radius:7px}.btn.danger{color:#ffb9b9}.saved-row{display:grid;grid-template-columns:1fr auto;gap:6px}.selected{display:grid;gap:7px;max-height:38vh;overflow:auto;padding-right:2px}.selected-row{display:grid;grid-template-columns:18px 72px minmax(0,1fr) auto;gap:7px;align-items:center;border:1px solid #2b2e33;background:#121417;border-radius:9px;padding:7px}.grab{cursor:grab;text-align:center;color:#6f747d;font-size:16px}.sel-thumb{width:72px;height:46px;object-fit:cover;border-radius:5px;background:#050505}.sel-name{font-size:9px;font-weight:850;line-height:1.25;margin-bottom:4px}.comment{width:100%;min-height:42px;background:#0b0c0e;color:#fff;border:1px solid #33363c;border-radius:6px;padding:6px;resize:vertical;font-size:8px;line-height:1.45}.row-actions{display:flex;flex-direction:column;gap:4px}.row-actions .mini{padding:5px 6px;font-size:7px;white-space:nowrap;border-radius:6px}.row-actions .pick.on{background:var(--acid);border-color:var(--acid);color:#111;font-weight:900}.preview-panel{padding-bottom:10px}.preview-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}.preview-actions{display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}.frame-wrap{height:220px;border:1px solid #34373d;border-radius:8px;overflow:hidden;background:#fff}.frame{width:100%;height:100%;border:0;background:#fff}.status{font-size:8px;color:#797e86;line-height:1.5;min-height:13px;margin-top:6px}.note{font-size:7px;color:#6e737b;line-height:1.55;margin-top:7px}@media(max-width:1250px){.app{grid-template-columns:minmax(0,1fr) 390px}.games{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}.filters{grid-template-columns:repeat(3,1fr)}.filter:last-child{grid-column:auto}.selected-row{grid-template-columns:18px 62px 1fr}.sel-thumb{width:62px;height:40px}.row-actions{grid-column:2/4;flex-direction:row}}@media(max-width:860px){.app{display:block;height:auto;overflow:visible}.library,.editor{height:auto;overflow:visible;border-right:0}.lib-top{position:relative;top:auto}.editor{border-top:1px solid var(--line)}.filters{grid-template-columns:1fr 1fr}.games{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}.selected{max-height:none}.frame-wrap{height:240px}}@media(max-width:520px){.library,.editor{padding:14px}.games{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.filters{grid-template-columns:1fr 1fr}.game-name{font-size:10px}.search-row{grid-template-columns:1fr}.reset{height:34px}.selected-row{grid-template-columns:18px 58px 1fr}.sel-thumb{width:58px;height:38px}}
</style>
</head>
<body>
<div class="app">
  <section class="library">
    <div class="lib-top">
      <div class="lib-head">
        <div><div class="brand">HARF-WAY / WAYS LIBRARY</div><h1 class="lib-title">棚から選ぶ</h1></div>
        <div class="lib-meta"><span id="resultCount">読み込み中</span></div>
      </div>
      <div class="search-row"><input class="search" id="query" placeholder="作品名 / カテゴリ / タグ / URLで横断検索" /><button class="reset" id="clearFilters">RESET</button></div>
      <div class="quick"><span class="quick-label">QUICK INDEX</span><button class="chip on" data-quick="all">ALL</button><button class="chip" data-quick="unused">未使用</button><button class="chip" data-quick="demo">体験版</button><button class="chip" data-quick="portrait">縦動画</button><span id="quickCats" style="display:contents"></span></div>
      <div class="filters">
        <div class="filter"><label>カテゴリ</label><select id="categoryFilter"><option value="">すべて</option></select></div>
        <div class="filter"><label>配信先</label><select id="platformFilter"><option value="">すべて</option><option value="steam">Steam</option><option value="itch">itch.io</option><option value="freem">ふりーむ</option><option value="other">その他</option></select></div>
        <div class="filter"><label>動画 / 状態</label><select id="mediaFilter"><option value="">すべて</option><option value="landscape">横動画</option><option value="portrait">縦動画</option><option value="demo">体験版</option><option value="sponsored">Sponsored</option><option value="thumb">サムネあり</option></select></div>
        <div class="filter"><label>使用履歴</label><select id="usageFilter"><option value="">すべて</option><option value="unused">未使用のみ</option><option value="used">使用済み</option></select></div>
        <div class="filter"><label>並び順</label><select id="sortFilter"><option value="ways">WAYS順</option><option value="unused">使用回数が少ない順</option><option value="title">作品名順</option><option value="duration">短い動画順</option></select></div>
      </div>
      <div class="state-row" id="stateTabs"><button class="tab on" data-state="all">すべて</button><button class="tab" data-state="unselected">未選択</button><button class="tab" data-state="selected">選択中</button><span class="state-spacer"></span><button class="mini primary" id="addVisible">表示中を追加</button></div>
    </div>
    <div class="stats"><span>WAYS <b id="kpiAll">--</b></span><span>未使用 <b id="kpiUnused">--</b></span><span>選択中 <b id="kpiSelected">0</b></span><span>LOCAL HISTORY</span></div>
    <div id="games" class="games"><div class="empty">WAYSを読み込み中…</div></div>
  </section>

  <aside class="editor">
    <div class="editor-head"><div><div class="brand">CURATION BOARD</div><h2>今週の棚</h2></div><div class="count"><span id="count">0</span> SELECTED</div></div>

    <section class="panel">
      <div class="panel-title">ISSUE</div>
      <div class="grid2"><div class="field"><label>VOL.</label><input id="vol" value="001" /></div><div class="field"><label>今週のテーマ</label><input id="theme" placeholder="例：操作がなんか変なゲーム" /></div></div>
      <div class="field"><label>導入文</label><textarea id="intro" placeholder="今週の棚をひとことで案内"></textarea></div>
      <div class="field"><label>あとがき</label><textarea id="outro" placeholder="総括コメント"></textarea></div>
      <div class="toolbar"><button class="btn primary" id="saveBtn">号を保存</button><button class="btn" id="newBtn">新規</button><button class="btn" id="exportBtn">JSON</button></div>
      <div class="field" style="margin-top:8px"><label>保存済み</label><div class="saved-row"><select id="savedIssues"><option value="">保存済みなし</option></select><button class="mini" id="loadIssue">開く</button></div></div>
    </section>

    <section class="panel">
      <div class="panel-title">SELECTED / DRAG TO REORDER</div>
      <div id="selected" class="selected"><div class="empty">左のカードから作品を選んでください。</div></div>
      <div class="toolbar" style="margin-top:8px"><button class="btn danger" id="clearSelected">すべて外す</button></div>
    </section>

    <section class="panel preview-panel">
      <div class="preview-head"><div class="panel-title" style="margin:0">WORDPRESS PREVIEW</div><div class="preview-actions"><button class="mini primary" id="copyBundle">WP一括コピー</button><button class="mini" id="copyHtml">HTML</button><button class="mini" id="copyCss">CSS</button></div></div>
      <div class="frame-wrap"><iframe id="previewFrame" class="frame" title="WordPress preview"></iframe></div>
      <div class="note">小さい確認窓です。出力は実際のWordPress用HTML / CSSと同じものを使います。</div>
    </section>
    <div class="status" id="saveStatus">Preview / ローカル保存方式</div>
  </aside>
</div>
<script is:inline>
const API='https://harfway-playback.vercel.app/api/games-live';
const KEY='harfway_ways_weekly_issues_v2';
const OLD_KEY='harfway_ways_weekly_issues_v1';
let items=[],selectedIds=[],comments={},pickId='',dragId='',stateFilter='all',visibleIds=[];
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm=s=>String(s??'').toLowerCase().normalize('NFKC');
function getStore(){try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch{return{}}}
function migrate(){if(localStorage.getItem(KEY))return;try{const old=JSON.parse(localStorage.getItem(OLD_KEY)||'{}');if(Object.keys(old).length)localStorage.setItem(KEY,JSON.stringify(old))}catch{}}
migrate();
function issue(){return{vol:$('#vol').value.trim(),theme:$('#theme').value.trim(),intro:$('#intro').value.trim(),outro:$('#outro').value.trim(),selectedIds:[...selectedIds],comments:{...comments},pickId,updatedAt:new Date().toISOString()}}
function game(id){return items.find(x=>x.id===id)}
function catParts(x){return String(x.category||'').split('/').map(v=>v.trim()).filter(v=>v&&v!=='通常')}
function platform(x){const u=String(x.storeUrl||'').toLowerCase();if(u.includes('steampowered.com'))return'steam';if(u.includes('itch.io'))return'itch';if(u.includes('freem.ne.jp'))return'freem';return'other'}
function orient(x){return x.videoOrientation||(Number(x.videoHeight)>Number(x.videoWidth)?'portrait':'landscape')}
function usageMap(){const map={};Object.values(getStore()).forEach(v=>{(v?.selectedIds||[]).forEach(id=>map[id]=(map[id]||0)+1)});return map}
function allCategories(){return [...new Set(items.flatMap(catParts))].sort((a,b)=>a.localeCompare(b,'ja'))}
function categoryCounts(){const m={};items.flatMap(catParts).forEach(c=>m[c]=(m[c]||0)+1);return m}
function refreshCategoryOptions(){const sel=$('#categoryFilter'),current=sel.value,cats=allCategories();sel.innerHTML='<option value="">すべて</option>'+cats.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');if(cats.includes(current))sel.value=current;const counts=categoryCounts();const top=Object.keys(counts).sort((a,b)=>counts[b]-counts[a]||a.localeCompare(b,'ja')).slice(0,7);$('#quickCats').innerHTML=top.map(c=>`<button class="chip" data-catquick="${esc(c)}">${esc(c)} ${counts[c]}</button>`).join('')}
function filterList(){const q=norm($('#query').value),cat=$('#categoryFilter').value,plat=$('#platformFilter').value,media=$('#mediaFilter').value,use=$('#usageFilter').value,usage=usageMap();let list=items.filter(x=>{const chosen=selectedIds.includes(x.id);if(stateFilter==='selected'&&!chosen)return false;if(stateFilter==='unselected'&&chosen)return false;if(q){const hay=norm([x.title,x.category,(x.tags||[]).join(' '),x.storeUrl].join(' '));if(!hay.includes(q))return false}if(cat&&!catParts(x).includes(cat))return false;if(plat&&platform(x)!==plat)return false;if(media==='landscape'&&orient(x)!=='landscape')return false;if(media==='portrait'&&orient(x)!=='portrait')return false;if(media==='demo'&&!String(x.title||'').includes('体験版'))return false;if(media==='sponsored'&&!x.sponsored)return false;if(media==='thumb'&&!x.thumbnailUrl)return false;const n=usage[x.id]||0;if(use==='unused'&&n!==0)return false;if(use==='used'&&n===0)return false;return true});const sort=$('#sortFilter').value;if(sort==='unused')list.sort((a,b)=>(usage[a.id]||0)-(usage[b.id]||0)||String(a.title).localeCompare(String(b.title),'ja'));if(sort==='title')list.sort((a,b)=>String(a.title).localeCompare(String(b.title),'ja'));if(sort==='duration')list.sort((a,b)=>(Number(a.videoDuration)||9999)-(Number(b.videoDuration)||9999));return list}
function renderGames(){const list=filterList();visibleIds=list.map(x=>x.id);const usage=usageMap();$('#resultCount').textContent=`${list.length} / ${items.length} GAMES`;$('#games').innerHTML=list.map(x=>{const chosen=selectedIds.includes(x.id),n=usage[x.id]||0,p=platform(x);return `<article class="game ${chosen?'selected':''}" data-card="${esc(x.id)}"><div class="thumb-wrap">${x.thumbnailUrl?`<img class="thumb" src="${esc(x.thumbnailUrl)}" alt="" loading="lazy">`:'<div class="thumb-empty">NO IMAGE</div>'}<span class="card-use ${n===0?'fresh':''}">${n===0?'未使用':`${n}回`}</span><button class="add" data-add="${esc(x.id)}" aria-label="${chosen?'選択解除':'選択'}">${chosen?'✓':'＋'}</button></div><div class="card-body"><div class="game-name">${esc(x.title)}</div><div class="game-cat">${esc(catParts(x).join(' / ')||x.category||'未分類')}</div><div class="badges"><span class="badge">${p==='steam'?'STEAM':p==='itch'?'ITCH':p==='freem'?'ふりーむ':'OTHER'}</span>${orient(x)==='portrait'?'<span class="badge">縦</span>':''}${String(x.title||'').includes('体験版')?'<span class="badge">体験版</span>':''}${x.sponsored?'<span class="badge">SP</span>':''}${Number(x.videoDuration)?`<span class="badge">${Math.round(Number(x.videoDuration))}s</span>`:''}</div></div></article>`}).join('')||'<div class="empty">この条件に一致する作品はありません。</div>';renderKpis()}
function renderKpis(){const usage=usageMap();$('#kpiAll').textContent=items.length;$('#kpiUnused').textContent=items.filter(x=>(usage[x.id]||0)===0).length;$('#kpiSelected').textContent=selectedIds.length;$('#count').textContent=selectedIds.length}
function toggle(id){if(selectedIds.includes(id)){selectedIds=selectedIds.filter(v=>v!==id);if(pickId===id)pickId=''}else selectedIds.push(id);renderAll()}
function addVisible(){const set=new Set(selectedIds);visibleIds.forEach(id=>set.add(id));selectedIds=[...set];renderAll()}
function renderSelected(){if(!selectedIds.length){$('#selected').innerHTML='<div class="empty">左のカードから作品を選んでください。</div>';return}$('#selected').innerHTML=selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';return `<div class="selected-row" draggable="true" data-drag="${esc(id)}"><div class="grab">⋮</div>${x.thumbnailUrl?`<img class="sel-thumb" src="${esc(x.thumbnailUrl)}" alt="">`:'<div class="thumb-empty" style="width:72px;height:46px">NO IMAGE</div>'}<div><div class="sel-name">${String(i+1).padStart(2,'0')} / ${esc(x.title)}</div><textarea class="comment" data-comment="${esc(id)}" placeholder="この作品への一言">${esc(comments[id]||'')}</textarea></div><div class="row-actions"><button class="mini pick ${pickId===id?'on':''}" data-pick="${esc(id)}">PICK</button><button class="mini" data-remove="${esc(id)}">外す</button></div></div>`}).join('')}
const commonCSS=`.ways-weekly{--ww-ink:#141414;--ww-muted:#6d6d6d;--ww-line:#dcdcdc;--ww-acid:#d9ef23;max-width:920px;margin:0 auto;padding:10px 0 30px;color:var(--ww-ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.ways-weekly *{box-sizing:border-box}.ways-weekly__kicker{font-size:12px;font-weight:900;letter-spacing:.14em}.ways-weekly__title{font-size:clamp(34px,6vw,62px);font-weight:950;letter-spacing:-.045em;line-height:1.03;margin:10px 0 22px}.ways-weekly__intro,.ways-weekly__outro{font-size:16px;line-height:1.95;margin:0 0 34px;color:#3d3d3d}.ways-weekly__item{margin:0 0 54px;padding-bottom:12px}.ways-weekly__media{position:relative;background:#000;overflow:hidden}.ways-weekly__media video,.ways-weekly__media img{display:block;width:100%!important;max-width:none!important;height:auto!important;margin:0!important;background:#000}.ways-weekly__num{position:absolute;left:12px;top:12px;z-index:2;background:#111;color:#fff;padding:6px 8px;font-size:11px;font-weight:900;line-height:1}.ways-weekly__pick{display:inline-block;margin-top:12px;background:var(--ww-acid);color:#111;padding:6px 9px;font-size:10px;font-weight:950;letter-spacing:.08em}.ways-weekly__game-title{font-size:clamp(22px,4vw,32px);font-weight:950;line-height:1.18;letter-spacing:-.025em;margin-top:12px}.ways-weekly__comment{font-size:15px;line-height:1.85;margin:9px 0 0;color:#404040}.ways-weekly__store{display:inline-block;margin-top:12px;padding:9px 13px;background:#111;color:#fff!important;text-decoration:none!important;font-size:12px;font-weight:900}.ways-weekly__outro{margin-top:18px;padding-top:28px;border-top:1px solid var(--ww-line)}.ways-weekly__more{margin-top:28px}.ways-weekly__more a{display:inline-block;color:#111!important;text-decoration:none!important;border-bottom:2px solid #111;font-weight:900}@media(max-width:640px){.ways-weekly{padding-top:0}.ways-weekly__intro,.ways-weekly__outro{font-size:15px}.ways-weekly__item{margin-bottom:42px}.ways-weekly__num{left:8px;top:8px}}`;
function contentHTML(){const data=issue();return `<div class="ways-weekly"><div class="ways-weekly__kicker">WAYS WEEKLY / VOL.${esc(data.vol)}</div><div class="ways-weekly__title">${esc(data.theme||'今週のWAYS')}</div>${data.intro?`<p class="ways-weekly__intro">${esc(data.intro).replace(/\n/g,'<br>')}</p>`:''}<div class="ways-weekly__list">${data.selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';const media=x.video?`<video controls muted playsinline preload="metadata" poster="${esc(x.thumbnailUrl||'')}" src="${esc(x.video)}"></video>`:(x.thumbnailUrl?`<img src="${esc(x.thumbnailUrl)}" alt="">`:'');return `<section class="ways-weekly__item"><div class="ways-weekly__media">${media}<span class="ways-weekly__num">${String(i+1).padStart(2,'0')}</span></div>${data.pickId===id?'<div class="ways-weekly__pick">EDITOR\'S PICK</div>':''}<div class="ways-weekly__game-title">${esc(x.title)}</div>${data.comments[id]?`<p class="ways-weekly__comment">${esc(data.comments[id]).replace(/\n/g,'<br>')}</p>`:''}${x.storeUrl?`<a class="ways-weekly__store" href="${esc(x.storeUrl)}" target="_blank" rel="noopener">ゲームを見る ↗</a>`:''}</section>`}).join('')}</div>${data.outro?`<p class="ways-weekly__outro">${esc(data.outro).replace(/\n/g,'<br>')}</p>`:''}<p class="ways-weekly__more"><a href="https://harfway-playback.vercel.app/" target="_blank" rel="noopener">もっとWAYSを掘る →</a></p></div>`}
function bundleHTML(){return `<style>\n${commonCSS}\n</style>\n${contentHTML()}`}
function renderPreview(){const doc=`<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:0;padding:18px 14px;background:#fff;color:#111} ${commonCSS}</style></head><body>${contentHTML()}</body></html>`;$('#previewFrame').srcdoc=doc}
function refreshSaved(){const all=getStore(),sel=$('#savedIssues'),cur=sel.value;const keys=Object.keys(all).sort((a,b)=>String(b).localeCompare(String(a)));sel.innerHTML=keys.length?'<option value="">保存済みを選択</option>'+keys.map(k=>`<option value="${esc(k)}">VOL.${esc(k)} / ${esc(all[k]?.theme||'無題')}</option>`).join(''):'<option value="">保存済みなし</option>';if(keys.includes(cur))sel.value=cur}
function renderAll(){renderGames();renderSelected();renderPreview();refreshSaved();renderKpis()}
function save(){const all=getStore(),data=issue(),key=data.vol||'draft';all[key]=data;localStorage.setItem(KEY,JSON.stringify(all));setStatus(`VOL.${key} を保存しました`);renderAll()}
function loadSaved(){const key=$('#savedIssues').value;if(!key)return;const d=getStore()[key];if(!d)return;$('#vol').value=d.vol||key;$('#theme').value=d.theme||'';$('#intro').value=d.intro||'';$('#outro').value=d.outro||'';selectedIds=(d.selectedIds||[]).filter(id=>items.some(x=>x.id===id));comments={...(d.comments||{})};pickId=d.pickId||'';renderAll();setStatus(`VOL.${key} を開きました`)}
function reset(){selectedIds=[];comments={};pickId='';$('#vol').value=String(Date.now()).slice(-3);$('#theme').value='';$('#intro').value='';$('#outro').value='';renderAll();setStatus('新しい号を開始しました')}
function setStatus(t){$('#saveStatus').textContent=t;clearTimeout(setStatus.t);setStatus.t=setTimeout(()=>$('#saveStatus').textContent='Preview / ローカル保存方式',1900)}
async function copy(text,label){try{await navigator.clipboard.writeText(text);setStatus(label)}catch{setStatus('コピーできませんでした')}}
function resetQuick(){document.querySelectorAll('[data-quick]').forEach(b=>b.classList.toggle('on',b.dataset.quick==='all'));document.querySelectorAll('[data-catquick]').forEach(b=>b.classList.remove('on'))}
function clearFilters(){stateFilter='all';document.querySelectorAll('[data-state]').forEach(b=>b.classList.toggle('on',b.dataset.state==='all'));$('#query').value='';$('#categoryFilter').value='';$('#platformFilter').value='';$('#mediaFilter').value='';$('#usageFilter').value='';$('#sortFilter').value='ways';resetQuick();renderGames()}
$('#games').onclick=e=>{const b=e.target.closest('[data-add]'),card=e.target.closest('[data-card]');if(b){e.stopPropagation();toggle(b.dataset.add);return}if(card)toggle(card.dataset.card)};
$('#stateTabs').onclick=e=>{const b=e.target.closest('[data-state]');if(!b)return;stateFilter=b.dataset.state;document.querySelectorAll('[data-state]').forEach(x=>x.classList.toggle('on',x===b));renderGames()};
$('.quick').onclick=e=>{const q=e.target.closest('[data-quick]'),c=e.target.closest('[data-catquick]');if(q){resetQuick();q.classList.add('on');if(q.dataset.quick==='all'){clearFilters();return}if(q.dataset.quick==='unused'){$('#usageFilter').value='unused';$('#mediaFilter').value=''}if(q.dataset.quick==='demo'){$('#mediaFilter').value='demo';$('#usageFilter').value=''}if(q.dataset.quick==='portrait'){$('#mediaFilter').value='portrait';$('#usageFilter').value=''}renderGames();return}if(c){resetQuick();c.classList.add('on');$('#categoryFilter').value=c.dataset.catquick;renderGames()}};
['query','categoryFilter','platformFilter','mediaFilter','usageFilter','sortFilter'].forEach(id=>$('#'+id).addEventListener(id==='query'?'input':'change',()=>{if(id!=='sortFilter')resetQuick();renderGames()}));
$('#addVisible').onclick=addVisible;$('#clearFilters').onclick=clearFilters;
$('#selected').oninput=e=>{const t=e.target.closest('[data-comment]');if(t){comments[t.dataset.comment]=t.value;renderPreview()}};
$('#selected').onclick=e=>{const r=e.target.closest('[data-remove]');if(r){selectedIds=selectedIds.filter(id=>id!==r.dataset.remove);delete comments[r.dataset.remove];if(pickId===r.dataset.remove)pickId='';renderAll();return}const p=e.target.closest('[data-pick]');if(p){pickId=pickId===p.dataset.pick?'':p.dataset.pick;renderAll()}};
$('#selected').addEventListener('dragstart',e=>{const el=e.target.closest('[data-drag]');if(el)dragId=el.dataset.drag});
$('#selected').addEventListener('dragover',e=>e.preventDefault());
$('#selected').addEventListener('drop',e=>{e.preventDefault();const el=e.target.closest('[data-drag]');if(!el||!dragId||el.dataset.drag===dragId)return;const from=selectedIds.indexOf(dragId),to=selectedIds.indexOf(el.dataset.drag);selectedIds.splice(from,1);selectedIds.splice(to,0,dragId);renderAll()});
['vol','theme','intro','outro'].forEach(id=>$('#'+id).addEventListener('input',renderPreview));
$('#saveBtn').onclick=save;$('#newBtn').onclick=reset;$('#loadIssue').onclick=loadSaved;$('#clearSelected').onclick=()=>{selectedIds=[];comments={};pickId='';renderAll()};
$('#copyBundle').onclick=()=>copy(bundleHTML(),'CSS込みWordPress HTMLをコピーしました');$('#copyHtml').onclick=()=>copy(contentHTML(),'HTMLをコピーしました');$('#copyCss').onclick=()=>copy(commonCSS,'CSSをコピーしました');
$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(issue(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`ways-weekly-${issue().vol||'draft'}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)};
fetch(API,{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error('API');return r.json()}).then(d=>{items=(d.entries||[]).filter(x=>x.video);refreshCategoryOptions();renderAll()}).catch(()=>{$('#games').innerHTML='<div class="empty">WAYSの読み込みに失敗しました。</div>'});
</script>
</body>
</html>