<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>WAYS WEEKLY EDITOR v2</title>
<style>
:root{--wwe-bg:#090909;--wwe-panel:#111214;--wwe-panel2:#15171a;--wwe-line:#2d3035;--wwe-text:#f4f4ee;--wwe-muted:#8d929a;--wwe-acid:#efff35;--wwe-soft:#1b1d21}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--wwe-bg);color:var(--wwe-text);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}button,input,textarea,select{font:inherit}.wwe-app{min-height:100vh;display:grid;grid-template-columns:420px minmax(460px,.86fr) minmax(520px,1.14fr);background:var(--wwe-bg)}.wwe-library,.wwe-board,.wwe-preview-col{min-width:0}.wwe-library{height:100vh;overflow:auto;border-right:1px solid var(--wwe-line);padding:18px;background:#0b0b0c}.wwe-board{height:100vh;overflow:auto;border-right:1px solid var(--wwe-line);padding:22px}.wwe-preview-col{height:100vh;display:flex;flex-direction:column;padding:22px;background:#0d0e0f}.wwe-brand{font-size:10px;letter-spacing:.18em;color:var(--wwe-acid);font-weight:950}.wwe-title{font-size:34px;line-height:.92;letter-spacing:-.045em;margin:8px 0 4px;color:var(--wwe-text)!important}.wwe-sub{font-size:10px;line-height:1.6;color:var(--wwe-muted);margin:0}.wwe-sticky{position:sticky;top:-18px;z-index:8;background:#0b0b0cf4;backdrop-filter:blur(12px);padding:18px 0 12px;border-bottom:1px solid #1e2024}.wwe-search{width:100%;margin-top:14px;background:#111316;color:#fff;border:1px solid #353940;border-radius:10px;padding:12px}.wwe-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px}.wwe-tab,.wwe-chip,.wwe-btn,.wwe-mini{border:1px solid #393c42;background:#15171a;color:#e7e8e4;border-radius:8px;cursor:pointer}.wwe-tab{padding:8px 6px;font-size:10px}.wwe-tab.on{background:var(--wwe-acid);border-color:var(--wwe-acid);color:#111;font-weight:900}.wwe-filters{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.wwe-filter{display:grid;gap:4px}.wwe-filter label{font-size:8px;letter-spacing:.1em;color:#71767f}.wwe-filter select{width:100%;background:#111316;color:#eaeae5;border:1px solid #30343a;border-radius:8px;padding:8px;font-size:10px}.wwe-actions{display:flex;gap:6px;margin-top:9px}.wwe-mini{padding:7px 9px;font-size:9px}.wwe-mini.primary{background:var(--wwe-acid);color:#111;border-color:var(--wwe-acid);font-weight:900}.wwe-result-meta{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:12px 0 8px;font:9px ui-monospace,monospace;color:#757a83}.wwe-games{display:grid;gap:7px}.wwe-game{display:grid;grid-template-columns:74px minmax(0,1fr) 34px;gap:9px;align-items:center;padding:7px;border:1px solid #272a2f;border-radius:10px;background:#111214;cursor:pointer;transition:.15s}.wwe-game:hover{border-color:#545861;transform:translateY(-1px)}.wwe-game.selected{border-color:var(--wwe-acid);box-shadow:inset 0 0 0 1px #efff3524}.wwe-thumb{width:74px;height:48px;object-fit:cover;border-radius:6px;background:#050505;display:block}.wwe-thumb-empty{width:74px;height:48px;border-radius:6px;background:#181a1d;display:grid;place-items:center;color:#555;font-size:8px}.wwe-game-copy{min-width:0}.wwe-game-name{font-size:11px;font-weight:850;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#f4f4ee}.wwe-game-cat{font-size:8px;color:#737881;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wwe-badges{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}.wwe-badge{font-size:7px;line-height:1;border:1px solid #33363b;color:#9398a1;border-radius:999px;padding:4px 5px}.wwe-badge.fresh{border-color:#6b7222;color:var(--wwe-acid)}.wwe-add{width:30px;height:30px;border:1px solid #41454c;border-radius:50%;background:#191b1f;color:#fff;cursor:pointer}.wwe-game.selected .wwe-add{background:var(--wwe-acid);border-color:var(--wwe-acid);color:#111;font-weight:950}.wwe-section-head{display:flex;justify-content:space-between;align-items:end;gap:14px;margin-bottom:14px}.wwe-section-head h2{margin:0;color:var(--wwe-text)!important;font-size:30px;letter-spacing:-.035em}.wwe-count{font:9px ui-monospace,monospace;color:#7c818a}.wwe-panel{border:1px solid var(--wwe-line);background:var(--wwe-panel);border-radius:12px;padding:14px;margin-bottom:12px}.wwe-panel-title{font-size:9px;letter-spacing:.13em;color:var(--wwe-acid);font-weight:900;margin-bottom:10px}.wwe-grid2{display:grid;grid-template-columns:120px 1fr;gap:10px}.wwe-field{display:grid;gap:5px;margin-bottom:9px}.wwe-field:last-child{margin-bottom:0}.wwe-field label{font-size:8px;letter-spacing:.09em;color:#777c84}.wwe-field input,.wwe-field textarea,.wwe-field select{width:100%;background:#0d0e10;color:#fff;border:1px solid #33363c;border-radius:8px;padding:9px}.wwe-field textarea{min-height:70px;resize:vertical}.wwe-toolbar{display:flex;gap:7px;flex-wrap:wrap}.wwe-btn{padding:9px 11px;font-size:10px}.wwe-btn.primary{background:var(--wwe-acid);border-color:var(--wwe-acid);color:#111;font-weight:950}.wwe-btn.danger{color:#ffb8b8}.wwe-saved-row{display:grid;grid-template-columns:1fr auto;gap:7px}.wwe-selected{display:grid;gap:8px}.wwe-empty{padding:28px 16px;border:1px dashed #393c42;border-radius:10px;text-align:center;color:#70757e;font-size:11px}.wwe-selected-row{display:grid;grid-template-columns:26px 104px minmax(0,1fr) auto;gap:9px;align-items:center;border:1px solid #2b2e33;background:#121417;border-radius:10px;padding:8px}.wwe-selected-row.dragging{opacity:.5}.wwe-grab{cursor:grab;text-align:center;color:#737881;font-size:18px}.wwe-selected-thumb{width:104px;height:66px;object-fit:cover;border-radius:6px;background:#050505}.wwe-selected-body{min-width:0}.wwe-selected-name{font-size:11px;font-weight:850;line-height:1.3;margin-bottom:5px}.wwe-comment{width:100%;min-height:56px;background:#0b0c0e;color:#fff;border:1px solid #33363c;border-radius:7px;padding:7px;resize:vertical;font-size:10px;line-height:1.5}.wwe-row-actions{display:flex;flex-direction:column;gap:5px}.wwe-row-actions .wwe-mini{white-space:nowrap}.wwe-row-actions .pick.on{background:var(--wwe-acid);border-color:var(--wwe-acid);color:#111;font-weight:900}.wwe-note{font-size:9px;color:#777c84;line-height:1.6;margin-top:8px}.wwe-preview-top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.wwe-preview-top h2{margin:0;color:var(--wwe-text)!important;font-size:22px}.wwe-preview-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.wwe-frame-wrap{flex:1;min-height:0;border:1px solid var(--wwe-line);border-radius:12px;overflow:hidden;background:#fff}.wwe-frame{width:100%;height:100%;border:0;background:#fff;display:block}.wwe-status{font-size:9px;color:#858a92;margin-top:8px;min-height:15px}.wwe-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px}.wwe-kpi{border:1px solid #272a2e;background:#101113;border-radius:8px;padding:8px}.wwe-kpi b{display:block;font-size:15px;color:#fff}.wwe-kpi span{font-size:7px;color:#737881;letter-spacing:.09em}@media(max-width:1450px){.wwe-app{grid-template-columns:360px minmax(430px,.9fr) minmax(460px,1.1fr)}.wwe-library{padding:14px}.wwe-sticky{top:-14px;padding-top:14px}.wwe-board,.wwe-preview-col{padding:16px}.wwe-selected-row{grid-template-columns:24px 86px minmax(0,1fr)}.wwe-selected-thumb{width:86px;height:56px}.wwe-row-actions{grid-column:2/4;flex-direction:row}}@media(max-width:1100px){.wwe-app{grid-template-columns:390px 1fr}.wwe-preview-col{grid-column:1/3;height:78vh;border-top:1px solid var(--wwe-line)}.wwe-library,.wwe-board{height:auto;min-height:100vh}}@media(max-width:760px){.wwe-app{display:block}.wwe-library,.wwe-board,.wwe-preview-col{height:auto;min-height:0;border-right:0;padding:14px}.wwe-library{max-height:none}.wwe-sticky{position:relative;top:auto}.wwe-preview-col{height:75vh}.wwe-grid2{grid-template-columns:1fr}.wwe-selected-row{grid-template-columns:24px 76px 1fr}.wwe-selected-thumb{width:76px;height:50px}.wwe-filters{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="wwe-app">
  <aside class="wwe-library">
    <div class="wwe-sticky">
      <div class="wwe-brand">HARF-WAY / WAYS LIBRARY</div>
      <h1 class="wwe-title">棚から選ぶ</h1>
      <p class="wwe-sub">WAYSを検索するのではなく、未使用・カテゴリ・配信先・動画形式から棚卸しします。</p>
      <input class="wwe-search" id="query" placeholder="作品名 / カテゴリ / タグで検索" />
      <div class="wwe-tabs" id="stateTabs">
        <button class="wwe-tab on" data-state="all">すべて</button>
        <button class="wwe-tab" data-state="unselected">未選択</button>
        <button class="wwe-tab" data-state="selected">選択中</button>
      </div>
      <div class="wwe-filters">
        <div class="wwe-filter"><label>カテゴリ索引</label><select id="categoryFilter"><option value="">すべて</option></select></div>
        <div class="wwe-filter"><label>配信先</label><select id="platformFilter"><option value="">すべて</option><option value="steam">Steam</option><option value="itch">itch.io</option><option value="freem">ふりーむ</option><option value="other">その他</option></select></div>
        <div class="wwe-filter"><label>動画 / 状態</label><select id="mediaFilter"><option value="">すべて</option><option value="landscape">横動画</option><option value="portrait">縦動画</option><option value="demo">体験版</option><option value="sponsored">Sponsored</option><option value="thumb">サムネあり</option></select></div>
        <div class="wwe-filter"><label>棚卸し</label><select id="usageFilter"><option value="">使用回数すべて</option><option value="unused">未使用のみ</option><option value="used">使用済み</option></select></div>
        <div class="wwe-filter" style="grid-column:1/3"><label>並び順</label><select id="sortFilter"><option value="ways">WAYS順</option><option value="unused">使用回数が少ない順</option><option value="title">作品名順</option><option value="duration">短い動画順</option></select></div>
      </div>
      <div class="wwe-actions">
        <button class="wwe-mini primary" id="addVisible">表示中を追加</button>
        <button class="wwe-mini" id="clearFilters">絞り込み解除</button>
      </div>
      <div class="wwe-kpis"><div class="wwe-kpi"><b id="kpiAll">--</b><span>WAYS</span></div><div class="wwe-kpi"><b id="kpiUnused">--</b><span>未使用</span></div><div class="wwe-kpi"><b id="kpiSelected">0</b><span>選択中</span></div></div>
    </div>
    <div class="wwe-result-meta"><span id="resultCount">読み込み中</span><span id="usageNote">LOCAL HISTORY</span></div>
    <div id="games" class="wwe-games"><div class="wwe-note">WAYSを読み込み中…</div></div>
  </aside>

  <main class="wwe-board">
    <div class="wwe-section-head"><div><div class="wwe-brand">CURATION BOARD</div><h2>今週の棚</h2></div><div class="wwe-count"><span id="count">0</span> SELECTED</div></div>

    <section class="wwe-panel">
      <div class="wwe-panel-title">ISSUE</div>
      <div class="wwe-grid2"><div class="wwe-field"><label>VOL.</label><input id="vol" value="001" /></div><div class="wwe-field"><label>今週のテーマ</label><input id="theme" placeholder="例：操作がなんか変なゲーム" /></div></div>
      <div class="wwe-field"><label>導入文</label><textarea id="intro" placeholder="今週の棚をひとことで案内する文章"></textarea></div>
      <div class="wwe-field"><label>あとがき</label><textarea id="outro" placeholder="今週の総括コメント"></textarea></div>
      <div class="wwe-toolbar"><button class="wwe-btn primary" id="saveBtn">号を保存</button><button class="wwe-btn" id="newBtn">新規</button><button class="wwe-btn" id="exportBtn">JSON</button></div>
      <div class="wwe-field" style="margin-top:10px"><label>保存済みの号</label><div class="wwe-saved-row"><select id="savedIssues"><option value="">保存済みなし</option></select><button class="wwe-mini" id="loadIssue">開く</button></div></div>
    </section>

    <section class="wwe-panel">
      <div class="wwe-panel-title">SELECTED GAMES / DRAG TO REORDER</div>
      <div id="selected" class="wwe-selected"><div class="wwe-empty">左のWAYS棚から作品を選んでください。</div></div>
      <div class="wwe-toolbar" style="margin-top:10px"><button class="wwe-btn danger" id="clearSelected">選択をすべて外す</button></div>
      <div class="wwe-note">保存した号は、このブラウザ内の「使用回数」に反映されます。未使用だけを出せるので、棚卸しが進むほど探しやすくなります。</div>
    </section>
    <div class="wwe-status" id="saveStatus">Preview / ローカル保存方式</div>
  </main>

  <section class="wwe-preview-col">
    <div class="wwe-preview-top"><div><div class="wwe-brand">WORDPRESS</div><h2>完成プレビュー</h2></div><div class="wwe-preview-actions"><button class="wwe-btn primary" id="copyBundle">WP一括コピー</button><button class="wwe-btn" id="copyHtml">HTMLのみ</button><button class="wwe-btn" id="copyCss">CSSのみ</button></div></div>
    <div class="wwe-frame-wrap"><iframe id="previewFrame" class="wwe-frame" title="WordPress preview"></iframe></div>
    <div class="wwe-status">「WP一括コピー」はCSS込み。WordPressのカスタムHTMLへそのまま貼れる形です。</div>
  </section>
</div>
<script is:inline>
const API='https://harfway-playback.vercel.app/api/games-live';
const KEY='harfway_ways_weekly_issues_v2';
const OLD_KEY='harfway_ways_weekly_issues_v1';
let items=[],selectedIds=[],comments={},pickId='',dragId='',stateFilter='all',visibleIds=[];
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm=s=>String(s??'').toLowerCase().normalize('NFKC');
function getStore(){try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch{return{}}}
function migrate(){if(localStorage.getItem(KEY))return;try{const old=JSON.parse(localStorage.getItem(OLD_KEY)||'{}');if(Object.keys(old).length)localStorage.setItem(KEY,JSON.stringify(old))}catch{}}
migrate();
function issue(){return{vol:$('#vol').value.trim(),theme:$('#theme').value.trim(),intro:$('#intro').value.trim(),outro:$('#outro').value.trim(),selectedIds:[...selectedIds],comments:{...comments},pickId,updatedAt:new Date().toISOString()}}
function game(id){return items.find(x=>x.id===id)}
function catParts(x){return String(x.category||'').split('/').map(v=>v.trim()).filter(v=>v&&v!=='通常')}
function platform(x){const u=String(x.storeUrl||'').toLowerCase();if(u.includes('steampowered.com'))return'steam';if(u.includes('itch.io'))return'itch';if(u.includes('freem.ne.jp'))return'freem';return'other'}
function orient(x){return x.videoOrientation||(Number(x.videoHeight)>Number(x.videoWidth)?'portrait':'landscape')}
function usageMap(){const map={};Object.values(getStore()).forEach(v=>{(v?.selectedIds||[]).forEach(id=>map[id]=(map[id]||0)+1)});return map}
function savedUsage(id){return usageMap()[id]||0}
function allCategories(){return [...new Set(items.flatMap(catParts))].sort((a,b)=>a.localeCompare(b,'ja'))}
function refreshCategoryOptions(){const sel=$('#categoryFilter'),current=sel.value;sel.innerHTML='<option value="">すべて</option>'+allCategories().map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');if([...sel.options].some(o=>o.value===current))sel.value=current}
function filterList(){const q=norm($('#query').value),cat=$('#categoryFilter').value,plat=$('#platformFilter').value,media=$('#mediaFilter').value,use=$('#usageFilter').value,usage=usageMap();let list=items.filter(x=>{const chosen=selectedIds.includes(x.id);if(stateFilter==='selected'&&!chosen)return false;if(stateFilter==='unselected'&&chosen)return false;if(q){const hay=norm([x.title,x.category,(x.tags||[]).join(' '),x.storeUrl].join(' '));if(!hay.includes(q))return false}if(cat&&!catParts(x).includes(cat))return false;if(plat&&platform(x)!==plat)return false;if(media==='landscape'&&orient(x)!=='landscape')return false;if(media==='portrait'&&orient(x)!=='portrait')return false;if(media==='demo'&&!String(x.title||'').includes('体験版'))return false;if(media==='sponsored'&&!x.sponsored)return false;if(media==='thumb'&&!x.thumbnailUrl)return false;const n=usage[x.id]||0;if(use==='unused'&&n!==0)return false;if(use==='used'&&n===0)return false;return true});const sort=$('#sortFilter').value;if(sort==='unused')list.sort((a,b)=>(usage[a.id]||0)-(usage[b.id]||0)||String(a.title).localeCompare(String(b.title),'ja'));if(sort==='title')list.sort((a,b)=>String(a.title).localeCompare(String(b.title),'ja'));if(sort==='duration')list.sort((a,b)=>(Number(a.videoDuration)||9999)-(Number(b.videoDuration)||9999));return list}
function renderGames(){const list=filterList();visibleIds=list.map(x=>x.id);const usage=usageMap();$('#resultCount').textContent=`${list.length} / ${items.length} GAMES`;$('#games').innerHTML=list.map(x=>{const chosen=selectedIds.includes(x.id),n=usage[x.id]||0,p=platform(x);return `<div class="wwe-game ${chosen?'selected':''}" data-card="${esc(x.id)}">${x.thumbnailUrl?`<img class="wwe-thumb" src="${esc(x.thumbnailUrl)}" alt="" loading="lazy">`:'<div class="wwe-thumb-empty">NO IMAGE</div>'}<div class="wwe-game-copy"><div class="wwe-game-name">${esc(x.title)}</div><div class="wwe-game-cat">${esc(catParts(x).join(' / ')||x.category||'未分類')}</div><div class="wwe-badges"><span class="wwe-badge ${n===0?'fresh':''}">${n===0?'未使用':`${n}回使用`}</span><span class="wwe-badge">${p==='steam'?'STEAM':p==='itch'?'ITCH':p==='freem'?'ふりーむ':'OTHER'}</span>${orient(x)==='portrait'?'<span class="wwe-badge">縦</span>':''}${String(x.title||'').includes('体験版')?'<span class="wwe-badge">体験版</span>':''}${x.sponsored?'<span class="wwe-badge">SP</span>':''}</div></div><button class="wwe-add" data-add="${esc(x.id)}" aria-label="${chosen?'選択解除':'選択'}">${chosen?'✓':'＋'}</button></div>`}).join('')||'<div class="wwe-empty">この条件に一致する作品はありません。</div>';renderKpis()}
function renderKpis(){const usage=usageMap();$('#kpiAll').textContent=items.length;$('#kpiUnused').textContent=items.filter(x=>(usage[x.id]||0)===0).length;$('#kpiSelected').textContent=selectedIds.length;$('#count').textContent=selectedIds.length}
function toggle(id){if(selectedIds.includes(id)){selectedIds=selectedIds.filter(v=>v!==id);if(pickId===id)pickId=''}else selectedIds.push(id);renderAll()}
function addVisible(){const set=new Set(selectedIds);visibleIds.forEach(id=>set.add(id));selectedIds=[...set];renderAll()}
function renderSelected(){if(!selectedIds.length){$('#selected').innerHTML='<div class="wwe-empty">左のWAYS棚から作品を選んでください。</div>';return}$('#selected').innerHTML=selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';return `<div class="wwe-selected-row" draggable="true" data-drag="${esc(id)}"><div class="wwe-grab">⋮⋮</div>${x.thumbnailUrl?`<img class="wwe-selected-thumb" src="${esc(x.thumbnailUrl)}" alt="">`:'<div class="wwe-thumb-empty">NO IMAGE</div>'}<div class="wwe-selected-body"><div class="wwe-selected-name">${String(i+1).padStart(2,'0')} / ${esc(x.title)}</div><textarea class="wwe-comment" data-comment="${esc(id)}" placeholder="この作品への一言">${esc(comments[id]||'')}</textarea></div><div class="wwe-row-actions"><button class="wwe-mini pick ${pickId===id?'on':''}" data-pick="${esc(id)}">EDITOR'S PICK</button><button class="wwe-mini" data-remove="${esc(id)}">外す</button></div></div>`}).join('')}
const commonCSS=`.ways-weekly{--ww-ink:#141414;--ww-muted:#6d6d6d;--ww-line:#dcdcdc;--ww-acid:#d9ef23;max-width:920px;margin:0 auto;padding:10px 0 30px;color:var(--ww-ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.ways-weekly *{box-sizing:border-box}.ways-weekly__kicker{font-size:12px;font-weight:900;letter-spacing:.14em}.ways-weekly__title{font-size:clamp(34px,6vw,62px);font-weight:950;letter-spacing:-.045em;line-height:1.03;margin:10px 0 22px}.ways-weekly__intro,.ways-weekly__outro{font-size:16px;line-height:1.95;margin:0 0 34px;color:#3d3d3d}.ways-weekly__item{margin:0 0 54px;padding-bottom:12px}.ways-weekly__media{position:relative;background:#000;overflow:hidden}.ways-weekly__media video,.ways-weekly__media img{display:block;width:100%!important;max-width:none!important;height:auto!important;margin:0!important;background:#000}.ways-weekly__num{position:absolute;left:12px;top:12px;z-index:2;background:#111;color:#fff;padding:6px 8px;font-size:11px;font-weight:900;line-height:1}.ways-weekly__pick{display:inline-block;margin-top:12px;background:var(--ww-acid);color:#111;padding:6px 9px;font-size:10px;font-weight:950;letter-spacing:.08em}.ways-weekly__game-title{font-size:clamp(22px,4vw,32px);font-weight:950;line-height:1.18;letter-spacing:-.025em;margin-top:12px}.ways-weekly__comment{font-size:15px;line-height:1.85;margin:9px 0 0;color:#404040}.ways-weekly__store{display:inline-block;margin-top:12px;padding:9px 13px;background:#111;color:#fff!important;text-decoration:none!important;font-size:12px;font-weight:900}.ways-weekly__outro{margin-top:18px;padding-top:28px;border-top:1px solid var(--ww-line)}.ways-weekly__more{margin-top:28px}.ways-weekly__more a{display:inline-block;color:#111!important;text-decoration:none!important;border-bottom:2px solid #111;font-weight:900}@media(max-width:640px){.ways-weekly{padding-top:0}.ways-weekly__intro,.ways-weekly__outro{font-size:15px}.ways-weekly__item{margin-bottom:42px}.ways-weekly__num{left:8px;top:8px}}`;
function contentHTML(){const data=issue();return `<div class="ways-weekly"><div class="ways-weekly__kicker">WAYS WEEKLY / VOL.${esc(data.vol)}</div><div class="ways-weekly__title">${esc(data.theme||'今週のWAYS')}</div>${data.intro?`<p class="ways-weekly__intro">${esc(data.intro).replace(/\n/g,'<br>')}</p>`:''}<div class="ways-weekly__list">${data.selectedIds.map((id,i)=>{const x=game(id);if(!x)return'';const media=x.video?`<video controls muted playsinline preload="metadata" poster="${esc(x.thumbnailUrl||'')}" src="${esc(x.video)}"></video>`:(x.thumbnailUrl?`<img src="${esc(x.thumbnailUrl)}" alt="">`:'');return `<section class="ways-weekly__item"><div class="ways-weekly__media">${media}<span class="ways-weekly__num">${String(i+1).padStart(2,'0')}</span></div>${data.pickId===id?'<div class="ways-weekly__pick">EDITOR\'S PICK</div>':''}<div class="ways-weekly__game-title">${esc(x.title)}</div>${data.comments[id]?`<p class="ways-weekly__comment">${esc(data.comments[id]).replace(/\n/g,'<br>')}</p>`:''}${x.storeUrl?`<a class="ways-weekly__store" href="${esc(x.storeUrl)}" target="_blank" rel="noopener">ゲームを見る ↗</a>`:''}</section>`}).join('')}</div>${data.outro?`<p class="ways-weekly__outro">${esc(data.outro).replace(/\n/g,'<br>')}</p>`:''}<p class="ways-weekly__more"><a href="https://harfway-playback.vercel.app/" target="_blank" rel="noopener">もっとWAYSを掘る →</a></p></div>`}
function bundleHTML(){return `<style>\n${commonCSS}\n</style>\n${contentHTML()}`}
function renderPreview(){const frame=$('#previewFrame');const doc=`<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:0;padding:38px 28px;background:#fff;color:#111} ${commonCSS}</style></head><body>${contentHTML()}</body></html>`;frame.srcdoc=doc}
function refreshSaved(){const all=getStore(),sel=$('#savedIssues'),cur=sel.value;const keys=Object.keys(all).sort((a,b)=>String(b).localeCompare(String(a)));sel.innerHTML=keys.length?'<option value="">保存済みの号を選択</option>'+keys.map(k=>`<option value="${esc(k)}">VOL.${esc(k)} / ${esc(all[k]?.theme||'無題')}</option>`).join(''):'<option value="">保存済みなし</option>';if(keys.includes(cur))sel.value=cur}
function renderAll(){renderGames();renderSelected();renderPreview();refreshSaved();renderKpis()}
function save(){const all=getStore(),data=issue(),key=data.vol||'draft';all[key]=data;localStorage.setItem(KEY,JSON.stringify(all));setStatus(`VOL.${key} を保存しました`);renderAll()}
function loadSaved(){const key=$('#savedIssues').value;if(!key)return;const d=getStore()[key];if(!d)return;$('#vol').value=d.vol||key;$('#theme').value=d.theme||'';$('#intro').value=d.intro||'';$('#outro').value=d.outro||'';selectedIds=(d.selectedIds||[]).filter(id=>items.some(x=>x.id===id));comments={...(d.comments||{})};pickId=d.pickId||'';renderAll();setStatus(`VOL.${key} を開きました`)}
function reset(){selectedIds=[];comments={};pickId='';$('#vol').value=String(Date.now()).slice(-3);$('#theme').value='';$('#intro').value='';$('#outro').value='';renderAll();setStatus('新しい号を開始しました')}
function setStatus(t){$('#saveStatus').textContent=t;clearTimeout(setStatus.t);setStatus.t=setTimeout(()=>$('#saveStatus').textContent='Preview / ローカル保存方式',1900)}
async function copy(text,label){try{await navigator.clipboard.writeText(text);setStatus(label)}catch{setStatus('コピーできませんでした') }}
function clearFilters(){stateFilter='all';document.querySelectorAll('[data-state]').forEach(b=>b.classList.toggle('on',b.dataset.state==='all'));$('#query').value='';$('#categoryFilter').value='';$('#platformFilter').value='';$('#mediaFilter').value='';$('#usageFilter').value='';$('#sortFilter').value='ways';renderGames()}
$('#games').onclick=e=>{const b=e.target.closest('[data-add]'),card=e.target.closest('[data-card]');if(b){e.stopPropagation();toggle(b.dataset.add);return}if(card)toggle(card.dataset.card)};
$('#stateTabs').onclick=e=>{const b=e.target.closest('[data-state]');if(!b)return;stateFilter=b.dataset.state;document.querySelectorAll('[data-state]').forEach(x=>x.classList.toggle('on',x===b));renderGames()};
['query','categoryFilter','platformFilter','mediaFilter','usageFilter','sortFilter'].forEach(id=>$('#'+id).addEventListener(id==='query'?'input':'change',renderGames));
$('#addVisible').onclick=addVisible;$('#clearFilters').onclick=clearFilters;
$('#selected').oninput=e=>{const t=e.target.closest('[data-comment]');if(t){comments[t.dataset.comment]=t.value;renderPreview()}};
$('#selected').onclick=e=>{const r=e.target.closest('[data-remove]');if(r){selectedIds=selectedIds.filter(id=>id!==r.dataset.remove);delete comments[r.dataset.remove];if(pickId===r.dataset.remove)pickId='';renderAll();return}const p=e.target.closest('[data-pick]');if(p){pickId=pickId===p.dataset.pick?'':p.dataset.pick;renderAll()}};
$('#selected').addEventListener('dragstart',e=>{const el=e.target.closest('[data-drag]');if(el){dragId=el.dataset.drag;el.classList.add('dragging')}});
$('#selected').addEventListener('dragend',e=>e.target.closest('[data-drag]')?.classList.remove('dragging'));
$('#selected').addEventListener('dragover',e=>e.preventDefault());
$('#selected').addEventListener('drop',e=>{e.preventDefault();const el=e.target.closest('[data-drag]');if(!el||!dragId||el.dataset.drag===dragId)return;const from=selectedIds.indexOf(dragId),to=selectedIds.indexOf(el.dataset.drag);selectedIds.splice(from,1);selectedIds.splice(to,0,dragId);renderAll()});
['vol','theme','intro','outro'].forEach(id=>$('#'+id).addEventListener('input',renderPreview));
$('#saveBtn').onclick=save;$('#newBtn').onclick=reset;$('#loadIssue').onclick=loadSaved;$('#clearSelected').onclick=()=>{selectedIds=[];comments={};pickId='';renderAll()};
$('#copyBundle').onclick=()=>copy(bundleHTML(),'CSS込みWordPress HTMLをコピーしました');$('#copyHtml').onclick=()=>copy(contentHTML(),'HTMLのみコピーしました');$('#copyCss').onclick=()=>copy(commonCSS,'CSSのみコピーしました');
$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(issue(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`ways-weekly-${issue().vol||'draft'}.json`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)};
fetch(API,{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error('API');return r.json()}).then(d=>{items=(d.entries||[]).filter(x=>x.video);refreshCategoryOptions();renderAll()}).catch(()=>{$('#games').innerHTML='<div class="wwe-empty">WAYSの読み込みに失敗しました。</div>'});
</script>
</body>
</html>