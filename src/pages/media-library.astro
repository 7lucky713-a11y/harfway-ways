---
const title='HARF-WAY MEDIA LIBRARY';
---
<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>{title}</title><style is:global>:root{--bg:#0e1210;--side:#141915;--panel:#191f1b;--panel2:#202720;--line:#303a32;--line2:#475148;--text:#edf2ed;--muted:#8d9990;--accent:#b7d49b;--accent2:#dfe8a8;--danger:#d88989;--warn:#d7ba76}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Hiragino Sans","Yu Gothic",sans-serif}button,input,select{font:inherit;color:inherit}.app{display:grid;grid-template-columns:250px minmax(0,1fr);min-height:100vh}.side{position:sticky;top:0;height:100vh;background:var(--side);border-right:1px solid var(--line);padding:18px 14px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:10px;margin-bottom:18px}.brand>b{display:grid;place-items:center;width:42px;height:42px;border-radius:10px;background:var(--accent);color:#101510;font-weight:950}.brand span{font-size:13px;font-weight:900}.brand small{display:block;margin-top:2px;font:750 8px ui-monospace,monospace;color:var(--muted);letter-spacing:.08em}.primary,.ghost{border-radius:8px;padding:10px 12px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:var(--accent);color:#101510;border:1px solid var(--accent)}.ghost{background:var(--panel);border:1px solid var(--line);color:#c8d0ca}.upload{width:100%;text-align:left}.side nav{display:grid;gap:4px;margin:17px 0}.side nav button{display:flex;justify-content:space-between;border:0;background:transparent;color:var(--muted);padding:10px;border-radius:8px;text-align:left;font-size:11px;font-weight:850;cursor:pointer}.side nav button.on,.side nav button:hover{background:var(--panel2);color:var(--text)}.side nav i{font-style:normal;color:#667169}.storage{margin-top:auto;border-top:1px solid var(--line);padding:14px 9px}.storage small{display:block;font:800 8px ui-monospace,monospace;color:#6d786f}.storage b{display:block;font-size:18px;margin-top:3px}.storage span{font-size:9px;color:var(--muted)}header{height:68px;position:sticky;top:0;z-index:20;background:#0e1210eb;border-bottom:1px solid var(--line);display:flex;gap:8px;align-items:center;padding:0 26px}.search{width:min(720px,68vw);height:40px;border:1px solid var(--line);background:var(--panel);border-radius:9px;display:flex;align-items:center;padding:0 10px;color:var(--muted)}.search input{flex:1;border:0;background:transparent;outline:0;font-size:12px}.view{display:none;padding:32px 34px 70px}.view.show{display:block}.heading{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:20px}.heading small{font:900 8px ui-monospace,monospace;color:var(--accent);letter-spacing:.1em}.heading h1{font-size:38px;line-height:1;margin:6px 0 0;letter-spacing:-.04em}.heading p{font-size:11px;color:var(--muted);margin:8px 0 0}.stats{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:11px;overflow:hidden;margin-bottom:12px}.stats>div{padding:13px 15px;border-right:1px solid var(--line)}.stats>div:last-child{border:0}.stats small{display:block;font:800 8px ui-monospace,monospace;color:#738077}.stats b{display:block;font-size:22px;margin-top:2px}.filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-bottom:12px}.filters select,.picker-tools input{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:9px;font-size:10px}.asset-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:13px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.card{border:1px solid var(--line);background:var(--panel);border-radius:10px;overflow:hidden;cursor:pointer}.card:hover,.card.on{border-color:#778977}.thumb{height:160px;position:relative;background:#0a0d0b;display:grid;place-items:center;overflow:hidden}.thumb.image::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(to top,rgba(8,12,9,.66),rgba(8,12,9,0) 55%);pointer-events:none}.thumb.video::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,#2d3538,#101516 48%,#4a3c32)}.thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}.thumb span{position:absolute;left:9px;bottom:8px;z-index:2;font:900 8px ui-monospace,monospace;letter-spacing:.08em;background:#111814c9;border:1px solid #445047;border-radius:999px;padding:4px 7px}.thumb .used{position:absolute;z-index:3;top:8px;right:8px;border:1px solid #5d6f60;background:#152018dd;border-radius:999px;padding:4px 6px;font:800 7px ui-monospace,monospace;color:#bdd2bd}.card-body{padding:10px}.card-body b{display:block;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-meta{display:flex;justify-content:space-between;gap:6px;margin-top:6px;font:700 8px ui-monospace,monospace;color:#707b73}.detail{min-height:620px;border:1px solid var(--line);background:var(--panel);border-radius:11px;overflow:hidden;position:sticky;top:82px;align-self:start}.detail-empty{padding:22px;color:var(--muted);font-size:11px}.detail-preview{height:210px;background:#0b0e0c;display:grid;place-items:center;font:900 11px ui-monospace,monospace;letter-spacing:.08em}.detail-body{padding:15px}.detail-body h2{font-size:16px;margin:0 0 4px}.asset-id{font:750 8px ui-monospace,monospace;color:#758078;word-break:break-all}.fields{display:grid;gap:9px;margin-top:14px}.field label{display:block;font:800 8px ui-monospace,monospace;color:#758078;margin-bottom:4px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);background:#111612;border-radius:7px;padding:8px;font-size:10px}.field textarea{min-height:58px;resize:vertical}.usage-list{display:grid;gap:5px;margin-top:12px}.usage-item{display:flex;justify-content:space-between;gap:10px;border:1px solid var(--line);border-radius:7px;padding:8px;font-size:9px}.usage-item span:last-child{color:var(--muted)}.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:14px}.danger{border:1px solid #684a4a;background:#251616;color:#e0a3a3;border-radius:8px;padding:9px;font-size:10px;font-weight:850;cursor:pointer}.danger:disabled{opacity:.35;cursor:not-allowed}.warning{font-size:9px;line-height:1.6;color:#c9a878;margin-top:8px}.trash-list,.dupe-list,.usage-board{display:grid;gap:9px}.row{display:grid;grid-template-columns:90px minmax(0,1fr) 170px;gap:12px;align-items:center;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:12px}.mini{height:62px;border-radius:7px;background:linear-gradient(135deg,#253b2d,#111914)}.row b{font-size:11px}.row p{font-size:9px;color:var(--muted);margin:4px 0 0}.row-actions{display:flex;justify-content:flex-end;gap:5px}.dupe-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:11px}.dupe-item{border:1px solid var(--line);border-radius:8px;padding:10px}.dupe-item.keep{border-color:#61765e;background:#19221a}.dupe-item small{font:800 8px ui-monospace,monospace;color:var(--muted)}.usage-group{border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden}.usage-group h3{font-size:12px;margin:0;padding:12px;border-bottom:1px solid var(--line)}.usage-entry{display:flex;justify-content:space-between;padding:9px 12px;border-bottom:1px solid var(--line);font-size:9px}.usage-entry:last-child{border:0}.modal{position:fixed;inset:0;background:#050705d9;z-index:50;display:none;place-items:center;padding:20px}.modal.on{display:grid}.picker{width:min(1100px,94vw);height:min(760px,90vh);background:#101511;border:1px solid var(--line2);border-radius:13px;display:grid;grid-template-rows:auto auto 1fr auto;overflow:hidden}.picker-head{display:flex;justify-content:space-between;align-items:center;padding:15px;border-bottom:1px solid var(--line)}.picker-head small{font:850 8px ui-monospace,monospace;color:var(--accent)}.picker-head h2{margin:2px 0 0;font-size:20px}.picker-tools{display:flex;gap:7px;padding:10px;border-bottom:1px solid var(--line)}.picker-tools input{flex:1}.picker-grid{overflow:auto;padding:11px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.pick-card{border:1px solid var(--line);border-radius:8px;background:var(--panel);padding:0;overflow:hidden;cursor:pointer}.pick-card.on{outline:2px solid var(--accent)}.pick-thumb{height:100px;background:linear-gradient(135deg,#243b2b,#0e1711);display:grid;place-items:center;font:900 9px ui-monospace,monospace}.pick-card b{display:block;padding:7px;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.picker-foot{display:flex;justify-content:space-between;align-items:center;padding:11px;border-top:1px solid var(--line);font-size:10px}@media(max-width:1050px){.asset-layout{grid-template-columns:1fr}.detail{position:static;min-height:0}.grid{grid-template-columns:repeat(2,1fr)}.picker-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.app{display:block}.side{height:auto;position:static}.brand,.upload,.storage{display:none}.side nav{grid-template-columns:repeat(4,1fr);margin:0}.side nav button{justify-content:center}.side nav i{display:none}header{padding:0 12px}.search{width:100%}.view{padding:22px 13px 50px}.heading{align-items:flex-start;flex-direction:column}.stats{grid-template-columns:1fr 1fr}.filters{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.picker-grid{grid-template-columns:repeat(2,1fr)}.row{grid-template-columns:70px 1fr}.row-actions{grid-column:1/-1}.dupe-pair{grid-template-columns:1fr}}
.view{display:none}.view.show{display:block}.asset-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:13px}.detail-preview img,.detail-preview video{width:100%;height:100%;object-fit:contain}.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:14px}.usage-list{display:grid;gap:5px;margin-top:13px}.usage-list>b{font:800 8px ui-monospace,monospace;color:#758078}.dupe-list,.usage-board{display:grid;gap:9px}.dupe-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:11px}.dupe-item{border:1px solid var(--line);border-radius:8px;padding:10px}.dupe-item.keep{border-color:#61765e;background:#19221a}.usage-group{border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden}.usage-group h3{font-size:12px;margin:0;padding:12px;border-bottom:1px solid var(--line)}.usage-entry{display:flex;justify-content:space-between;gap:12px;padding:9px 12px;border-bottom:1px solid var(--line);font-size:9px}.usage-entry:last-child{border:0}.lock{position:fixed;inset:0;background:#0a0d0bee;z-index:70;display:none;place-items:center}.lock.on{display:grid}.lock-card{width:min(440px,92vw);background:var(--panel);border:1px solid var(--line2);border-radius:14px;padding:25px}.lock-card form{display:flex;gap:7px}.lock-card input{flex:1;border:1px solid var(--line);background:#111612;border-radius:8px;padding:11px}.toast{position:fixed;right:20px;bottom:20px;z-index:80;background:#263028;border:1px solid #516052;border-radius:9px;padding:11px 14px;font-size:11px;transform:translateY(120px);transition:.2s}.toast.on{transform:none}@media(max-width:1100px){.asset-layout{grid-template-columns:1fr}.detail{position:static}}</style></head><body><div class="app"><aside class="side"><div class="brand"><b>HW</b><span>MEDIA LIBRARY<small>R2 ASSET WORKSPACE</small></span></div><button class="upload primary" id="uploadBtn">＋ アップロード</button><input id="uploadInput" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm" hidden><nav><button class="on" data-view="library">ライブラリ <i id="activeCount">0</i></button><button data-view="trash">ゴミ箱 <i id="trashCount">0</i></button><button data-view="unregistered">未登録 <i id="rawCount">0</i></button><button data-view="duplicates">重複候補</button><button data-view="usage">使用先</button><a href="/game-notes/" style="text-decoration:none">GAME NOTES ↗</a></nav><div class="storage">R2 ASSET REGISTRY<br><span>物理ファイルと編集用途を分離</span></div></aside><main><header><div class="search">⌕ <input id="search" placeholder="ファイル名、ゲーム、タグ、用途から検索"></div><span id="env" style="font:800 9px ui-monospace,monospace;color:var(--muted)">LOADING</span></header><section class="view show" id="view-library"><div class="heading"><div><small>ASSET LIBRARY</small><h1>メディアライブラリ</h1><p>R2素材を一元管理し、HARF-WAYの各編集面から再利用する。</p></div><button class="primary" id="uploadBtnTop">＋ 新規アップロード</button></div><div class="stats"><div><small>ASSETS</small><b id="statAll">0</b></div><div><small>IMAGES</small><b id="statImages">0</b></div><div><small>VIDEOS</small><b id="statVideos">0</b></div><div><small>UNUSED</small><b id="statUnused">0</b></div></div><div class="filters"><select id="typeFilter"><option value="all">すべての種類</option><option value="image">画像</option><option value="video">動画</option><option value="audio">音声</option><option value="other">その他</option></select><select id="gameFilter"><option value="all">すべてのゲーム</option></select><select id="usageFilter"><option value="all">すべての使用状態</option><option value="used">使用中</option><option value="unused">未使用</option></select><select id="sort"><option value="new">新しい順</option><option value="old">古い順</option><option value="large">容量順</option><option value="name">名前順</option></select></div><div class="asset-layout"><div class="grid" id="assetGrid"></div><aside class="detail" id="detail"><div class="detail-empty">素材を選択すると詳細が表示されます。</div></aside></div></section><section class="view" id="view-trash"><div class="heading"><div><small>SOFT DELETE</small><h1>ゴミ箱</h1><p>R2実ファイルを残したまま、ライブラリとPickerから外す。</p></div></div><div class="asset-layout"><div class="grid" id="trashGrid"></div><aside class="detail" id="trashDetail"></aside></div></section><section class="view" id="view-unregistered"><div class="heading"><div><small>R2 INVENTORY</small><h1>未登録素材</h1><p>R2にはあるが、Media Asset IDをまだ持っていない素材。</p></div></div><div class="asset-layout"><div class="grid" id="rawGrid"></div><aside class="detail" id="rawDetail"></aside></div></section><section class="view" id="view-duplicates"><div class="heading"><div><small>DUPLICATE REVIEW</small><h1>重複候補</h1><p>サイズ＋ETagが一致する候補。参照を統合してから削除する。</p></div></div><div class="dupe-list" id="dupeList"></div></section><section class="view" id="view-usage"><div class="heading"><div><small>USAGE REGISTRY</small><h1>使用先</h1><p>GAME NOTES / Public Play Noteなど、素材が使われている場所。</p></div></div><div class="usage-board" id="usageBoard"></div></section></main></div><div class="lock" id="lock"><div class="lock-card"><h2>MEDIA LIBRARY</h2><p>HARF-WAY管理キーを入力してください。</p><form id="unlockForm"><input id="key" type="password" autocomplete="current-password"><button class="primary">開く</button></form></div></div><div class="toast" id="toast"></div><script is:inline>(function client(){
  const state={items:[],environment:'',branchId:'',view:'library',selected:'',query:'',type:'all',game:'all',usage:'all',sort:'new',key:sessionStorage.getItem('harfway_game_notes_key')||'',objectUrl:''};
  const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt=n=>{n=Number(n)||0;const u=['B','KB','MB','GB'];let i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return `${n>=10||i===0?n.toFixed(0):n.toFixed(1)} ${u[i]}`};
  const headers=(json=false)=>({...((state.key)?{'x-admin-key':state.key}:{}),...(json?{'content-type':'application/json'}:{})});
  async function api(path,opt={}){const r=await fetch(path,{...opt,headers:{...headers(Boolean(opt.body)&&!(opt.body instanceof Blob)),...(opt.headers||{})},cache:'no-store'});let d={};const ct=r.headers.get('content-type')||'';if(ct.includes('json'))d=await r.json().catch(()=>({}));if(r.status===401){$('#lock').classList.add('on');throw Object.assign(new Error(d.error||'unauthorized'),{status:401,data:d})}if(!r.ok)throw Object.assign(new Error(d.error||`http_${r.status}`),{status:r.status,data:d});return d}
  function toast(msg,bad=false){const t=$('#toast');t.textContent=msg;t.style.background=bad?'#5c2626':'';t.classList.add('on');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('on'),1800)}
  async function load(){try{const d=await api('/api/media-library');state.items=d.items||[];state.environment=d.environment||'';state.branchId=d.branchId||'';$('#env').textContent=`${String(state.environment).toUpperCase()} · ${state.items.length}`;$('#lock').classList.remove('on');renderAll()}catch(e){if(e.status!==401)toast(`読み込み失敗: ${e.message}`,true)}}
  function activeItems(){return state.items.filter(a=>a.status==='active'||a.status==='unregistered')}
  function filtered(){let rows=(state.view==='trash'?state.items.filter(a=>a.status==='trash'):activeItems());if(state.view==='unregistered')rows=state.items.filter(a=>a.status==='unregistered');const q=state.query.toLowerCase();rows=rows.filter(a=>(state.type==='all'||a.kind===state.type)&&(state.game==='all'||a.gameName===state.game)&&(state.usage==='all'||(state.usage==='used'?a.usageCount>0:a.usageCount===0))&&(!q||[a.name,a.r2Key,a.gameName,...(a.tags||[]),...(a.usages||[]).map(u=>u.label+' '+u.title)].join(' ').toLowerCase().includes(q)));rows.sort((a,b)=>state.sort==='old'?String(a.lastModified||a.updatedAt||'').localeCompare(String(b.lastModified||b.updatedAt||'')):state.sort==='large'?(b.size||0)-(a.size||0):state.sort==='name'?String(a.name).localeCompare(String(b.name),'ja'):String(b.lastModified||b.updatedAt||'').localeCompare(String(a.lastModified||a.updatedAt||'')));return rows}
  function setView(name){state.view=name;$$('.view').forEach(v=>v.classList.toggle('show',v.id===`view-${name}`));$$('[data-view]').forEach(b=>b.classList.toggle('on',b.dataset.view===name));state.selected='';if(name==='library'||name==='trash'||name==='unregistered'){renderGrid();renderDetail()}if(name==='duplicates')renderDupes();if(name==='usage')renderUsage()}
  function renderAll(){const active=activeItems(),trash=state.items.filter(a=>a.status==='trash'),raw=state.items.filter(a=>a.status==='unregistered');$('#activeCount').textContent=active.length;$('#trashCount').textContent=trash.length;$('#rawCount').textContent=raw.length;$('#statAll').textContent=active.length;$('#statImages').textContent=active.filter(a=>a.kind==='image').length;$('#statVideos').textContent=active.filter(a=>a.kind==='video').length;$('#statUnused').textContent=active.filter(a=>!a.usageCount).length;const games=[...new Set(state.items.map(a=>a.gameName).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ja'));$('#gameFilter').innerHTML='<option value="all">すべてのゲーム</option>'+games.map(g=>`<option>${esc(g)}</option>`).join('');$('#gameFilter').value=games.includes(state.game)?state.game:'all';$('#uploadBtn').disabled=state.environment!=='production';$('#uploadBtnTop').disabled=state.environment!=='production';setView(state.view)}
  function renderGrid(){const rows=filtered(),root=state.view==='trash'?$('#trashGrid'):state.view==='unregistered'?$('#rawGrid'):$('#assetGrid');root.innerHTML=rows.length?rows.map(a=>{const visual=a.kind==='image'&&a.rawUrl?`<img loading="lazy" decoding="async" src="${esc(a.rawUrl)}" alt="" onerror="this.remove()">`:'';return `<article class="card ${state.selected===(a.id||a.r2Key)?'on':''}" data-asset="${esc(a.id||a.r2Key)}"><div class="thumb ${esc(a.kind||'other')}">${visual}<span>${esc(String(a.kind||'FILE').toUpperCase())}</span>${a.usageCount?`<div class="used">${a.usageCount} USE</div>`:''}${!a.registered?'<div class="used" style="left:8px;right:auto">RAW</div>':''}</div><div class="card-body"><b>${esc(a.gameName||a.name||a.r2Key)}</b><div class="card-meta"><span>${esc(a.name||a.storagePurpose||'')}</span><span>${fmt(a.size)}</span></div></div></article>`}).join(''):'<div class="empty">条件に一致する素材がありません。</div>'}
  function current(){return state.items.find(a=>(a.id||a.r2Key)===state.selected)||null}
  async function preview(a){if(state.objectUrl){URL.revokeObjectURL(state.objectUrl);state.objectUrl=''}const box=$('#assetPreview');if(!box)return;box.innerHTML='<span>LOADING…</span>';try{const url=a.id?`/api/media-library?action=file&id=${encodeURIComponent(a.id)}`:`/api/media-library?action=file&key=${encodeURIComponent(a.r2Key)}`;const r=await fetch(url,{headers:headers(),cache:'no-store'});if(!r.ok)throw new Error();state.objectUrl=URL.createObjectURL(await r.blob());box.innerHTML=a.kind==='video'?`<video controls playsinline preload="metadata" src="${state.objectUrl}"></video>`:a.kind==='image'?`<img src="${state.objectUrl}" alt="">`:'<span>PREVIEWなし</span>'}catch{box.innerHTML='<span>PREVIEWを読み込めませんでした</span>'}}
  function renderDetail(){const a=current(),root=state.view==='trash'?$('#trashDetail'):state.view==='unregistered'?$('#rawDetail'):$('#detail');if(!a){root.innerHTML='<div class="detail-empty">素材を選択すると詳細が表示されます。</div>';return}const uses=(a.usages||[]).map(u=>`<a class="usage-item" href="${esc(u.url||'#')}" target="_blank" rel="noopener"><span>${esc(u.label)} · ${esc(u.title||'')}</span><span>↗</span></a>`).join('')||'<div class="usage-item"><span>未使用</span><span>0</span></div>';const trash=a.status==='trash';root.innerHTML=`<div class="detail-preview" id="assetPreview"><span>PREVIEW</span></div><div class="detail-body"><h2>${esc(a.name||a.r2Key)}</h2><div class="asset-id">${esc(a.id||'UNREGISTERED')}<br>${esc(a.r2Key)}</div>${trash?'<p class="warning">ゴミ箱にあります。R2実ファイルはまだ残っています。</p>':''}<div class="fields"><div class="field"><label>ゲーム</label><input id="assetGame" value="${esc(a.gameName||'')}" ${!a.registered?'disabled':''}></div><div class="field"><label>ALT</label><input id="assetAlt" value="${esc(a.alt||'')}" ${!a.registered?'disabled':''}></div><div class="field"><label>キャプション</label><textarea id="assetCaption" ${!a.registered?'disabled':''}>${esc(a.caption||'')}</textarea></div><div class="field"><label>タグ（カンマ区切り）</label><input id="assetTags" value="${esc((a.tags||[]).join(', '))}" ${!a.registered?'disabled':''}></div></div><div class="usage-list"><b>使用先 · ${a.usageCount||0}</b>${uses}</div><div class="detail-actions">${!a.registered?'<button class="primary" id="registerAsset">ライブラリ登録</button>':'<button class="ghost" id="saveAsset">保存</button>'}<button class="ghost" id="copyWp">WordPressコード</button>${trash?`<button class="ghost" id="restoreAsset">復元</button><button class="danger" id="hardDelete" ${a.hardDeleteAllowed?'':'disabled'}>完全削除</button>`:`<button class="danger" id="trashAsset" ${a.registered?'':'disabled'}>ゴミ箱へ</button>`}</div><p class="warning">${trash?(a.hardDeleteAllowed?'使用先0件。完全削除可能です。':a.hardDeleteReason==='preview_hard_delete_disabled'?'Previewでは完全削除を停止しています。':a.usageCount?'使用中のため完全削除できません。':'この保存領域はv1の完全削除対象外です。'):'通常削除はゴミ箱へ移すだけです。'}</p></div>`;preview(a)}
  function duplicateGroups(){const map=new Map();for(const a of state.items.filter(x=>x.etag&&x.size)){const k=`${a.size}:${a.etag}`,xs=map.get(k)||[];xs.push(a);map.set(k,xs)}return [...map.values()].filter(xs=>xs.length>1)}
  function renderDupes(){$('#dupeList').innerHTML=duplicateGroups().map(xs=>`<section class="dupe-pair">${xs.map((a,i)=>`<article class="dupe-item ${i===0?'keep':''}"><small>${i===0?'KEEP CANDIDATE':'DUPLICATE'}</small><h3>${esc(a.name)}</h3><p>${esc(a.storagePurpose)} · ${fmt(a.size)} · USE ${a.usageCount||0}</p></article>`).join('')}</section>`).join('')||'<div class="empty">重複候補はありません。</div>'}
  function renderUsage(){const groups={};for(const a of state.items){for(const u of a.usages||[]){(groups[u.label]||=[]).push({a,u})}}$('#usageBoard').innerHTML=Object.entries(groups).map(([k,xs])=>`<section class="usage-group"><h3>${esc(k)} · ${xs.length}</h3>${xs.map(({a,u})=>`<div class="usage-entry"><span>${esc(a.name)}</span><span>${esc(u.title||'')}</span></div>`).join('')}</section>`).join('')||'<div class="empty">使用先はまだありません。</div>'}
  async function register(a){const d=await api('/api/media-library',{method:'POST',body:JSON.stringify({action:'register',key:a.r2Key,name:a.name,gameName:a.gameName||''})});state.selected=d.asset.id;await load();toast('Media Assetとして登録しました')}
  async function save(a){await api('/api/media-library',{method:'PATCH',body:JSON.stringify({id:a.id,name:a.name,gameName:$('#assetGame').value.trim(),alt:$('#assetAlt').value.trim(),caption:$('#assetCaption').value.trim(),tags:$('#assetTags').value.split(',').map(x=>x.trim()).filter(Boolean)})});await load();toast('保存しました')}
  async function trash(a){await api('/api/media-library',{method:'POST',body:JSON.stringify({action:'trash',id:a.id})});state.selected='';await load();toast('ゴミ箱へ移動しました')}
  async function restore(a){await api('/api/media-library',{method:'POST',body:JSON.stringify({action:'restore',id:a.id})});await load();toast('復元しました')}
  async function hardDelete(a){if(!confirm(`R2から完全削除します。元に戻せません。\n\n${a.name}`))return;await api('/api/media-library',{method:'DELETE',body:JSON.stringify({id:a.id,confirm:'DELETE'})});state.selected='';await load();toast('完全削除しました')}
  function wpCode(a){if(!a.rawUrl)return'';if(a.kind==='video'){const token=btoa(a.rawUrl).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');return `<div style="width:100%;max-width:560px;aspect-ratio:16/9;overflow:hidden"><iframe src="https://ways.harf-way.com/embed/r2/${token}" title="${String(a.caption||a.name||'HARF-WAY video').replace(/"/g,'&quot;')}" loading="lazy" allow="autoplay; fullscreen" allowfullscreen style="width:100%;height:100%;border:0"></iframe></div>`}return `<figure><img src="${a.rawUrl}" alt="${String(a.alt||'').replace(/"/g,'&quot;')}" loading="lazy">${a.caption?`<figcaption>${esc(a.caption)}</figcaption>`:''}</figure>`}
  async function copyWp(a){const code=wpCode(a);if(!code)return toast('公開R2 URLを解決できません',true);await navigator.clipboard.writeText(code);toast('WordPress用コードをコピーしました')}
  async function uploadFile(file){const start=await api('/api/game-notes-media?action=start',{method:'POST',body:JSON.stringify({fileName:file.name,contentType:file.type,size:file.size})});const parts=Math.ceil(file.size/start.chunkBytes);for(let p=1;p<=parts;p++){const blob=file.slice((p-1)*start.chunkBytes,Math.min(file.size,p*start.chunkBytes));await api('/api/game-notes-media',{method:'PUT',body:blob,headers:{'content-type':'application/octet-stream','x-upload-id':start.uploadId,'x-part-number':String(p),'x-content-type':file.type,'x-file-size':String(file.size)}})}const done=await api('/api/game-notes-media?action=complete',{method:'POST',body:JSON.stringify({uploadId:start.uploadId,fileName:file.name,contentType:file.type,size:file.size,parts})});return (await api('/api/media-library',{method:'POST',body:JSON.stringify({action:'register',key:done.media.key,name:file.name,mimeType:file.type,size:file.size})})).asset}
  async function upload(files){if(state.environment!=='production')return toast('PreviewではR2 uploadを停止しています',true);for(const f of [...files]){try{toast(`アップロード中: ${f.name}`);const a=await uploadFile(f);state.selected=a.id}catch(e){toast(`失敗: ${e.message}`,true)}}$('#uploadInput').value='';await load()}
  document.addEventListener('click',e=>{const v=e.target.closest('[data-view]');if(v){setView(v.dataset.view);return}const card=e.target.closest('[data-asset]');if(card){state.selected=card.dataset.asset;renderGrid();renderDetail();return}const a=current();if(!a)return;if(e.target.closest('#registerAsset'))register(a).catch(x=>toast(x.message,true));else if(e.target.closest('#saveAsset'))save(a).catch(x=>toast(x.message,true));else if(e.target.closest('#trashAsset'))trash(a).catch(x=>toast(x.message,true));else if(e.target.closest('#restoreAsset'))restore(a).catch(x=>toast(x.message,true));else if(e.target.closest('#hardDelete'))hardDelete(a).catch(x=>toast(x.data?.usages?.length?'使用中のため削除できません':x.message,true));else if(e.target.closest('#copyWp'))copyWp(a).catch(x=>toast(x.message,true))});
  $('#unlockForm').addEventListener('submit',e=>{e.preventDefault();state.key=$('#key').value.trim();sessionStorage.setItem('harfway_game_notes_key',state.key);load()});
  $('#search').addEventListener('input',e=>{state.query=e.target.value;renderGrid()});$('#typeFilter').addEventListener('change',e=>{state.type=e.target.value;renderGrid()});$('#gameFilter').addEventListener('change',e=>{state.game=e.target.value;renderGrid()});$('#usageFilter').addEventListener('change',e=>{state.usage=e.target.value;renderGrid()});$('#sort').addEventListener('change',e=>{state.sort=e.target.value;renderGrid()});
  $('#uploadBtn').onclick=$('#uploadBtnTop').onclick=()=>$('#uploadInput').click();$('#uploadInput').addEventListener('change',e=>upload(e.target.files));load();
})();</script></body></html>