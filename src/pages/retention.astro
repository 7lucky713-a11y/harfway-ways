<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>WAYS Retention</title>
<style>
:root{--bg:#090a0c;--panel:#111318;--panel2:#0d0f13;--line:#2b3038;--text:#f3f3ed;--muted:#8d96a3;--lime:#efff35;--green:#75ee9a;--amber:#ffcc69;--red:#ff7676}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.top{position:sticky;top:0;z-index:20;display:flex;gap:12px;align-items:center;justify-content:space-between;padding:14px 22px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.94)}.brand{font-weight:950;letter-spacing:.08em}.controls{display:flex;gap:8px;align-items:center}.controls select{background:#0a0c0f;color:#fff;border:1px solid #343a44;border-radius:9px;padding:9px 11px}.wrap{max-width:1280px;margin:auto;padding:28px 22px 70px}.hero{display:flex;gap:28px;align-items:end;justify-content:space-between;margin-bottom:24px}.hero h1{font-size:clamp(44px,7vw,88px);letter-spacing:-.06em;line-height:.9;margin:0}.hero p{max-width:610px;color:var(--muted);line-height:1.7;margin:0}.ey{font-size:11px;font-weight:900;letter-spacing:.14em;color:var(--lime);margin-bottom:9px}.status{font:12px/1.5 ui-monospace,monospace;color:var(--muted);margin-top:8px}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:18px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}.kpi small{display:block;color:var(--muted);font-size:10px;letter-spacing:.08em}.kpi b{display:block;font-size:34px;letter-spacing:-.04em;margin-top:9px}.kpi i{display:block;color:var(--muted);font-style:normal;font-size:10px;margin-top:4px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px;margin-top:18px}.panel h2{font-size:13px;letter-spacing:.1em;margin:0 0 14px}.note{padding:14px;border:1px solid #4f4a2f;border-radius:12px;background:#15140d;color:#d8cf9e;font-size:12px;line-height:1.7}.tablewrap{overflow:auto;border:1px solid var(--line);border-radius:12px}.tablewrap table{width:100%;border-collapse:collapse;min-width:900px}.tablewrap th,.tablewrap td{padding:11px 12px;border-bottom:1px solid #242931;font-size:11px;text-align:right;white-space:nowrap}.tablewrap th{background:#16191f;color:#9aa3af}.tablewrap th:first-child,.tablewrap td:first-child{text-align:left}.pending{color:var(--amber)}.good{color:var(--green)}.muted{color:var(--muted)}.legend{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.chip{font:800 10px/1 ui-monospace,monospace;padding:7px 8px;border-radius:999px;border:1px solid #383e47;color:var(--muted)}.foot{margin-top:20px;color:var(--muted);font-size:11px;border-top:1px solid var(--line);padding-top:14px}@media(max-width:900px){.kpis{grid-template-columns:1fr 1fr}.hero{display:block}.hero p{margin-top:16px}}@media(max-width:600px){.top{align-items:flex-start;flex-direction:column}.wrap{padding:20px 14px 55px}.kpis{grid-template-columns:1fr}.controls{width:100%}.controls select{width:100%}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / WAYS RETENTION</div><div class="controls"><select id="days"><option value="7" selected>直近7日</option><option value="30">直近30日</option><option value="90">直近90日</option></select></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">RETURNING AUDIENCE</div><h1>DO THEY<br>COME BACK?</h1></div><div><p>毎週のHARF-WAYコンテンツからWAYSへ来た人が、その後に自発的に戻っているかを追います。PVではなく「匿名Visitorの別日再訪」を定着の基準にします。</p><div id="state" class="status">読み込み中…</div></div></section>
<section class="kpis">
<div class="kpi"><small>VISITORS</small><b id="visitors">—</b><i>選択期間の匿名Visitor</i></div>
<div class="kpi"><small>REPEAT VISITORS</small><b id="repeatVisitors">—</b><i>別日に2日以上訪問</i></div>
<div class="kpi"><small>REPEAT RATE</small><b id="repeatRate">—</b><i>期間内リピート率</i></div>
<div class="kpi"><small>NEW</small><b id="newVisitors">—</b><i>期間内に初観測</i></div>
<div class="kpi"><small>RETURNING</small><b id="returningVisitors">—</b><i>期間前から存在</i></div>
</section>
<div class="note">測定は匿名Visitor ID導入後のアクセスだけが対象です。7日率は初回から7日経過した人、30日率・習慣化率は30日経過した人だけを母数にするため、新しい週は「測定中」と表示されます。</div>
<section class="panel"><h2>WEEKLY COHORTS</h2><div class="tablewrap"><table><thead><tr><th>キャンペーン</th><th>流入元</th><th>開始</th><th>初回Visitor</th><th>7日母数</th><th>7日再訪</th><th>7日率</th><th>30日母数</th><th>30日再訪</th><th>30日率</th><th>30日内3日+</th><th>習慣化率</th></tr></thead><tbody id="cohorts"></tbody></table></div><div class="legend"><span class="chip">推奨UTM: utm_source=harfway</span><span class="chip">utm_medium=weekly</span><span class="chip">utm_campaign=weekly_harfway_YYYYwWW</span></div></section>
<div class="foot">定義: 7日再訪 = 初回来訪日の翌日〜7日目に1回以上 / 30日再訪 = 翌日〜30日目に1回以上 / 習慣化 = 初回日を含む30日間で3日以上利用。JST基準。</div>
</main>
<script is:inline>
const $=s=>document.querySelector(s);const n=v=>Number(v||0).toLocaleString('ja-JP');const pct=v=>v==null?'測定中':`${Number(v).toFixed(1)}%`;const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function renderRetention(r){const w=r?.current_window||{};$('#visitors').textContent=n(w.visitors);$('#repeatVisitors').textContent=n(w.repeat_visitors);$('#repeatRate').textContent=pct(w.repeat_rate);$('#newVisitors').textContent=n(w.new_visitors);$('#returningVisitors').textContent=n(w.returning_visitors);const rows=[...(r?.cohorts||[])].filter(x=>x.campaign!=='(no campaign)'||x.visitors>0);$('#cohorts').innerHTML=rows.length?rows.map(x=>`<tr><td>${esc(x.campaign)}</td><td>${esc(x.source)} / ${esc(x.medium)}</td><td>${esc(x.cohort_start||'—')}</td><td>${n(x.visitors)}</td><td>${n(x.mature_7d)}</td><td>${n(x.retained_7d)}</td><td class="${x.retention_7d_rate==null?'pending':'good'}">${pct(x.retention_7d_rate)}</td><td>${n(x.mature_30d)}</td><td>${n(x.retained_30d)}</td><td class="${x.retention_30d_rate==null?'pending':'good'}">${pct(x.retention_30d_rate)}</td><td>${n(x.habitual_30d)}</td><td class="${x.habitual_30d_rate==null?'pending':'good'}">${pct(x.habitual_30d_rate)}</td></tr>`).join(''):'<tr><td colspan="12" class="muted">Visitor ID導入後のデータがまだありません。</td></tr>'}
async function load(){const days=$('#days').value;$('#state').textContent='更新中…';try{const res=await fetch(`/api/harfway-analytics?days=${encodeURIComponent(days)}`,{cache:'no-store'});const json=await res.json();if(!res.ok||!json.ok)throw new Error(json.error||'取得失敗');const r=json?.services?.ways?.retention;if(!r)throw new Error('Retention data is not available yet');renderRetention(r);$('#state').textContent=`JST / 直近${days}日 / ${new Date(json.generatedAt).toLocaleString('ja-JP')}`;}catch(err){$('#state').textContent=err.message;}}
$('#days').addEventListener('change',load);load();
</script>
</body></html>