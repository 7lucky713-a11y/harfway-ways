---
const services = [
  {
    key: 'admin',
    name: '広告管理',
    role: 'キャンペーン・素材・配信条件の管理',
    url: 'https://harfway-ads-admin.vercel.app',
    status: 'preview',
  },
  {
    key: 'delivery',
    name: '配信API',
    role: 'WAYS / 切れ端 / プレイリストへの広告配信',
    url: 'https://harfway-ads-delivery.vercel.app',
    status: 'production',
  },
  {
    key: 'placements',
    name: '配信面ダッシュボード',
    role: '配信場所・配信面ごとの状況確認',
    url: 'https://harfway-ads-placement-dashboard.vercel.app',
    status: 'production',
  },
];

const placements = [
  { name: 'WAYS', state: '接続候補', note: '短尺動画フィード内の広告枠' },
  { name: '切れ端', state: '接続候補', note: 'アーカイブ/記事導線内の広告枠' },
  { name: 'プレイリスト', state: '接続候補', note: '視聴導線内の広告枠' },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>HARF-WAY ADS HUB</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      body { margin:0; background:#0b0d10; color:#f6f7f9; }
      main { max-width:1180px; margin:auto; padding:48px 24px 80px; }
      .eyebrow { font-size:12px; letter-spacing:.16em; color:#8f98a8; text-transform:uppercase; }
      h1 { font-size:clamp(32px,5vw,64px); margin:8px 0 12px; letter-spacing:-.04em; }
      .lead { max-width:760px; color:#b8c0cc; line-height:1.8; }
      .grid { display:grid; grid-template-columns:repeat(12,1fr); gap:16px; margin-top:32px; }
      .card { grid-column:span 4; border:1px solid #222831; background:#11151a; border-radius:18px; padding:20px; }
      .wide { grid-column:span 8; }
      .full { grid-column:1/-1; }
      .side { grid-column:span 4; }
      .label { color:#8d96a4; font-size:12px; letter-spacing:.04em; }
      .value { font-size:30px; font-weight:700; margin-top:6px; }
      .service { display:flex; justify-content:space-between; gap:16px; align-items:flex-start; padding:16px 0; border-top:1px solid #222831; }
      .service:first-of-type { border-top:none; }
      .service h3 { margin:0 0 6px; font-size:18px; }
      .service p { margin:0; color:#99a3b1; font-size:14px; line-height:1.6; }
      .service-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; justify-content:flex-end; }
      a.button { display:inline-flex; align-items:center; justify-content:center; padding:10px 14px; border-radius:999px; text-decoration:none; background:#f5f7fa; color:#111; font-size:13px; font-weight:700; white-space:nowrap; }
      a.button.secondary { border:1px solid #303844; background:#161b21; color:#d9dee6; }
      .badge { display:inline-flex; align-items:center; gap:6px; padding:5px 8px; border-radius:999px; border:1px solid #303844; color:#aeb7c5; font-size:11px; margin-top:8px; }
      .live-badge { margin:0; min-width:76px; justify-content:center; }
      .live-badge[data-state="ok"] { border-color:#315844; color:#8fe0af; background:#12251a; }
      .live-badge[data-state="protected"] { border-color:#66542f; color:#e9c879; background:#261f11; }
      .live-badge[data-state="error"] { border-color:#6b3434; color:#ef9d9d; background:#281414; }
      .live-badge[data-state="loading"] { color:#9da7b6; }
      .dot { width:7px; height:7px; border-radius:50%; background:currentColor; opacity:.9; }
      .flow { display:grid; gap:10px; margin-top:16px; }
      .step { display:flex; gap:12px; align-items:center; padding:13px 14px; background:#0d1116; border:1px solid #20262f; border-radius:12px; }
      .num { width:28px; height:28px; border-radius:50%; background:#f2f4f7; color:#111; display:grid; place-items:center; font-size:12px; font-weight:800; }
      table { width:100%; border-collapse:collapse; margin-top:8px; }
      th,td { text-align:left; padding:12px 8px; border-bottom:1px solid #222831; font-size:14px; }
      th { color:#7e8794; font-weight:500; }
      .note { color:#919ba9; font-size:13px; line-height:1.7; }
      .live-head { display:flex; justify-content:space-between; gap:20px; align-items:flex-start; }
      .live-summary { display:flex; align-items:baseline; gap:8px; margin-top:8px; }
      .live-summary strong { font-size:34px; letter-spacing:-.04em; }
      .live-summary span { color:#8993a1; font-size:13px; }
      .live-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:18px; }
      .live-item { padding:16px; border:1px solid #222a34; background:#0d1116; border-radius:14px; }
      .live-item-top { display:flex; justify-content:space-between; gap:12px; align-items:center; }
      .live-item h3 { margin:0; font-size:15px; }
      .live-meta { margin-top:12px; min-height:38px; color:#87919f; font-size:12px; line-height:1.6; }
      .metrics-box { display:flex; justify-content:space-between; gap:18px; align-items:center; padding:14px 16px; margin-top:14px; border:1px dashed #2d3540; border-radius:12px; background:#0c1014; }
      .metrics-title { font-size:13px; font-weight:700; }
      .metrics-copy { margin-top:4px; color:#8e98a6; font-size:12px; line-height:1.6; }
      .metric-values { display:none; gap:18px; flex-wrap:wrap; }
      .metric-values.is-visible { display:flex; }
      .metric { min-width:70px; }
      .metric span { display:block; color:#7e8997; font-size:10px; letter-spacing:.08em; }
      .metric strong { display:block; margin-top:3px; font-size:20px; }
      #last-checked { color:#77818e; font-size:11px; white-space:nowrap; }
      .performance-head { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; }
      .performance-title { margin:5px 0 0; font-size:24px; letter-spacing:-.02em; }
      .performance-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; justify-content:flex-end; }
      .performance-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-top:20px; }
      .performance-metric { min-width:0; padding:15px; border:1px solid #222a34; background:#0d1116; border-radius:14px; }
      .performance-metric span { display:block; color:#7e8997; font-size:10px; letter-spacing:.08em; }
      .performance-metric strong { display:block; margin-top:6px; font-size:25px; letter-spacing:-.03em; overflow-wrap:anywhere; }
      .performance-state { margin-top:16px; padding:14px 16px; border:1px dashed #3a3323; border-radius:12px; background:#15130e; color:#c9b77f; font-size:13px; line-height:1.7; }
      .performance-state[data-state="available"] { border-color:#264c37; background:#0f1b14; color:#92d8ad; }
      .performance-state[data-state="error"] { border-color:#5c3232; background:#1c1111; color:#e3a0a0; }
      .auth-panel { margin-top:12px; padding:14px 16px; border:1px solid #262e38; border-radius:14px; background:#0d1116; }
      .auth-form { display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; }
      .auth-field { flex:1 1 260px; }
      .auth-field label { display:block; margin-bottom:7px; color:#8d96a4; font-size:11px; letter-spacing:.06em; }
      .auth-field input { width:100%; box-sizing:border-box; border:1px solid #303844; border-radius:10px; background:#11161c; color:#f6f7f9; padding:11px 12px; font:inherit; outline:none; }
      .auth-field input:focus { border-color:#68778a; }
      .auth-button { border:0; border-radius:999px; background:#f5f7fa; color:#111; padding:11px 16px; font:inherit; font-size:13px; font-weight:800; cursor:pointer; }
      .auth-button.secondary { border:1px solid #303844; background:#161b21; color:#d9dee6; }
      .auth-button:disabled { opacity:.55; cursor:default; }
      .auth-message { margin:9px 0 0; color:#87919f; font-size:12px; line-height:1.6; }
      .auth-message[data-state="error"] { color:#ef9d9d; }
      .auth-session { display:flex; justify-content:space-between; gap:12px; align-items:center; }
      .auth-session[hidden], .auth-form[hidden] { display:none; }
      .auth-session strong { font-size:13px; }
      .auth-session span { display:block; margin-top:4px; color:#7f8a98; font-size:12px; }
      .table-wrap { overflow-x:auto; margin-top:14px; }
      .performance-table { min-width:860px; }
      .performance-table td { color:#c5ccd6; }
      .performance-table .empty-row td { padding:24px 8px; color:#87919f; text-align:center; }
      .campaign-name { font-weight:700; color:#f2f4f7; }
      .campaign-sub { display:block; margin-top:3px; color:#737e8d; font-size:11px; }
      @media (max-width: 900px) {
        .performance-grid { grid-template-columns:repeat(2,1fr); }
      }
      @media (max-width: 800px) {
        .card,.wide,.side { grid-column:1/-1; }
        .live-grid { grid-template-columns:1fr; }
        .live-head,.metrics-box,.performance-head { align-items:flex-start; flex-direction:column; }
        .service { flex-direction:column; }
        .service-actions,.performance-actions { justify-content:flex-start; }
      }
      @media (max-width: 520px) {
        .performance-grid { grid-template-columns:1fr; }
        .auth-form { align-items:stretch; flex-direction:column; }
        .auth-button { width:100%; }
        .auth-session { align-items:flex-start; flex-direction:column; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">HARF-WAY / Advertising Infrastructure</div>
      <h1>ADS HUB</h1>
      <p class="lead">広告キャンペーン、素材、配信面、配信API、計測を1か所から扱うための統合管理HUB。既存システムを残したまま、段階的にここへ集約します。</p>

      <section class="grid">
        <div class="card"><div class="label">SYSTEM</div><div class="value">3</div><div class="note">主要サービスを統合管理</div></div>
        <div class="card"><div class="label">DELIVERY</div><div class="value" id="delivery-top">確認中</div><div class="note" id="delivery-top-note">Production APIを確認しています</div></div>
        <div class="card"><div class="label">NEXT</div><div class="value">統合</div><div class="note">管理画面・配信面・DBの一本化</div></div>

        <div class="card full">
          <div class="live-head">
            <div>
              <div class="label">LIVE SYSTEM</div>
              <div class="live-summary"><strong id="online-count">— / 3</strong><span>services online</span></div>
            </div>
            <div id="last-checked">確認中…</div>
          </div>

          <div class="live-grid">
            {services.map((service) => (
              <div class="live-item" data-service={service.key}>
                <div class="live-item-top">
                  <h3>{service.name}</h3>
                  <span class="badge live-badge" data-live-badge data-state="loading"><span class="dot"></span><span data-live-label>確認中</span></span>
                </div>
                <div class="live-meta" data-live-meta>接続を確認しています…</div>
              </div>
            ))}
          </div>

          <div class="metrics-box">
            <div>
              <div class="metrics-title" id="metrics-title">配信計測</div>
              <div class="metrics-copy" id="metrics-copy">imp / click / CTR の取得可否を確認しています。</div>
            </div>
            <div class="metric-values" id="metric-values">
              <div class="metric"><span>IMPRESSIONS</span><strong id="metric-impressions">—</strong></div>
              <div class="metric"><span>CLICKS</span><strong id="metric-clicks">—</strong></div>
              <div class="metric"><span>CTR</span><strong id="metric-ctr">—</strong></div>
            </div>
          </div>
        </div>

        <div class="card full">
          <div class="performance-head">
            <div>
              <div class="label">AD PERFORMANCE</div>
              <h2 class="performance-title">キャンペーン配信実績</h2>
              <p class="note" style="margin:7px 0 0">広告Adminの正式データを読み取り専用で集約します。認証が必要なデータは保護したまま表示します。</p>
            </div>
            <div class="performance-actions">
              <span class="badge live-badge" id="performance-badge" data-state="loading"><span class="dot"></span><span>確認中</span></span>
              <a class="button secondary" href="https://harfway-ads-admin.vercel.app" target="_blank" rel="noreferrer">広告Adminを開く ↗</a>
            </div>
          </div>

          <div class="performance-grid">
            <div class="performance-metric"><span>ACTIVE CAMPAIGNS</span><strong id="performance-active">—</strong></div>
            <div class="performance-metric"><span>IMPRESSIONS</span><strong id="performance-impressions">—</strong></div>
            <div class="performance-metric"><span>CLICKS</span><strong id="performance-clicks">—</strong></div>
            <div class="performance-metric"><span>CTR</span><strong id="performance-ctr">—</strong></div>
            <div class="performance-metric"><span>REMAINING IMP</span><strong id="performance-remaining">—</strong></div>
          </div>

          <div class="performance-state" id="performance-state" data-state="loading">キャンペーン実績の取得可否を確認しています。</div>

          <div class="auth-panel">
            <form class="auth-form" id="performance-login-form">
              <div class="auth-field">
                <label for="performance-admin-key">広告Admin 管理キー</label>
                <input id="performance-admin-key" name="key" type="password" autocomplete="current-password" placeholder="管理キーを入力" />
              </div>
              <button class="auth-button" id="performance-login-button" type="submit">認証して表示</button>
            </form>
            <div class="auth-session" id="performance-auth-session" hidden>
              <div><strong>広告Admin 認証済み</strong><span>セッションはHttpOnly Cookieで保持し、管理キーは保存しません。</span></div>
              <button class="auth-button secondary" id="performance-logout-button" type="button">ログアウト</button>
            </div>
            <p class="auth-message" id="performance-auth-message">管理キーは保存されず、広告Adminの正規ログインAPIへ送信されます。</p>
          </div>

          <div class="table-wrap">
            <table class="performance-table">
              <thead>
                <tr><th>キャンペーン</th><th>状態</th><th>配信面</th><th>目標imp</th><th>配信imp</th><th>残imp</th><th>click</th><th>CTR</th></tr>
              </thead>
              <tbody id="performance-body">
                <tr class="empty-row"><td colspan="8">確認中…</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card wide">
          <div class="label">SERVICES</div>
          {services.map((service) => (
            <div class="service">
              <div>
                <h3>{service.name}</h3>
                <p>{service.role}</p>
                <span class="badge">{service.status}</span>
              </div>
              <div class="service-actions">
                <span class="badge live-badge" data-service-status={service.key} data-state="loading"><span class="dot"></span><span>確認中</span></span>
                <a class="button" href={service.url} target="_blank" rel="noreferrer">開く ↗</a>
              </div>
            </div>
          ))}
        </div>

        <div class="card side">
          <div class="label">STANDARD FLOW</div>
          <div class="flow">
            {['広告登録','素材アップロード','配信面を選択','上限imp設定','自動配信','自動停止','レポート'].map((step, index) => (
              <div class="step"><span class="num">{index + 1}</span><span>{step}</span></div>
            ))}
          </div>
        </div>

        <div class="card wide">
          <div class="label">PLACEMENTS</div>
          <table>
            <thead><tr><th>配信面</th><th>状態</th><th>用途</th></tr></thead>
            <tbody>
              {placements.map((placement) => (
                <tr><td>{placement.name}</td><td>{placement.state}</td><td>{placement.note}</td></tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="card side">
          <div class="label">DB POLICY</div>
          <p class="note">今後の標準系は public.ad_campaigns / public.ad_media / public.ad_events / public.ad_placement_rules に寄せます。旧 ads.* 系は動作確認後に段階的に整理します。</p>
          <div class="label" style="margin-top:20px">STATUS FLOW</div>
          <p class="note">下書き → 審査待ち → 配信予約 → 配信中 → 上限到達 → 終了</p>
        </div>
      </section>
    </main>

    <script is:inline>
      const number = (value) => new Intl.NumberFormat('ja-JP').format(Number(value || 0));
      const displayNumber = (value) => value === null || value === undefined ? '—' : number(value);
      const displayCtr = (value) => value === null || value === undefined ? '—' : `${Number(value).toFixed(2).replace(/\.00$/, '')}%`;
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));

      const setBadge = (element, state, label) => {
        if (!element) return;
        element.dataset.state = state;
        const target = element.querySelector('[data-live-label]') || element.querySelector('span:last-child');
        if (target) target.textContent = label;
      };

      const serviceText = (key, service) => {
        if (!service) return '状態を取得できませんでした';
        const latency = Number.isFinite(service.latencyMs) ? ` / ${service.latencyMs}ms` : '';
        if (key === 'delivery' && service.ok) return `Production / 配信判定API正常${latency}`;
        if (key === 'placements' && service.metricsAccess === 'protected') return `Production / 計測データは認証保護中${latency}`;
        if (service.ok) return `${service.mode || ''} / HTTP ${service.status || 'OK'}${latency}`;
        return `要確認 / HTTP ${service.status ?? '接続失敗'}${latency}`;
      };

      async function loadStatus() {
        try {
          const response = await fetch('/api/ads-hub-status', { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();

          document.querySelector('#online-count').textContent = `${data.online ?? 0} / ${data.total ?? 3}`;
          document.querySelector('#last-checked').textContent = `最終確認 ${new Date(data.generatedAt).toLocaleString('ja-JP')}`;

          for (const [key, service] of Object.entries(data.services || {})) {
            const item = document.querySelector(`[data-service="${key}"]`);
            const badge = item?.querySelector('[data-live-badge]');
            const meta = item?.querySelector('[data-live-meta]');
            const listBadge = document.querySelector(`[data-service-status="${key}"]`);
            const protectedMetrics = key === 'placements' && service.metricsAccess === 'protected';
            const state = service.ok ? (protectedMetrics ? 'protected' : 'ok') : 'error';
            const label = service.ok ? (protectedMetrics ? '認証保護' : '正常') : '要確認';
            setBadge(badge, state, label);
            setBadge(listBadge, state, label);
            if (meta) meta.textContent = serviceText(key, service);
          }

          const delivery = data.services?.delivery;
          const deliveryTop = document.querySelector('#delivery-top');
          const deliveryNote = document.querySelector('#delivery-top-note');
          if (delivery?.ok) {
            deliveryTop.textContent = 'LIVE';
            deliveryNote.textContent = 'Production API 正常';
          } else {
            deliveryTop.textContent = 'CHECK';
            deliveryNote.textContent = '配信APIを確認してください';
          }

          const metricsCopy = document.querySelector('#metrics-copy');
          const metricValues = document.querySelector('#metric-values');
          const overall = data.metrics?.stats?.overall || data.metrics?.overall || null;
          if (data.metricsState === 'available' && overall) {
            document.querySelector('#metrics-title').textContent = '直近7日 配信計測';
            metricsCopy.textContent = '配信状況APIから読み取り専用で取得しています。';
            document.querySelector('#metric-impressions').textContent = displayNumber(overall.impressions);
            document.querySelector('#metric-clicks').textContent = displayNumber(overall.clicks);
            document.querySelector('#metric-ctr').textContent = displayCtr(overall.ctr);
            metricValues.classList.add('is-visible');
          } else if (data.metricsState === 'login_required') {
            document.querySelector('#metrics-title').textContent = '配信計測は認証保護中';
            metricsCopy.textContent = 'imp / click / CTR は既存の配信状況画面でログイン後に確認できます。認証を迂回せず保護したままです。';
          } else {
            document.querySelector('#metrics-title').textContent = '配信計測を確認できません';
            metricsCopy.textContent = '計測APIの状態を確認してください。';
          }
        } catch (error) {
          document.querySelector('#online-count').textContent = '取得失敗';
          document.querySelector('#last-checked').textContent = 'HUB status API error';
          document.querySelector('#delivery-top').textContent = 'CHECK';
          document.querySelector('#delivery-top-note').textContent = '状態取得に失敗しました';
          document.querySelectorAll('[data-live-badge], [data-service-status]').forEach((badge) => setBadge(badge, 'error', '要確認'));
          document.querySelectorAll('[data-live-meta]').forEach((meta) => { meta.textContent = '状態を取得できませんでした'; });
          document.querySelector('#metrics-title').textContent = '配信計測を確認できません';
          document.querySelector('#metrics-copy').textContent = 'ADS HUBの状態APIを確認してください。';
          console.error('[ads-hub-status]', error);
        }
      }

      function resetPerformanceValues() {
        document.querySelector('#performance-active').textContent = '—';
        document.querySelector('#performance-impressions').textContent = '—';
        document.querySelector('#performance-clicks').textContent = '—';
        document.querySelector('#performance-ctr').textContent = '—';
        document.querySelector('#performance-remaining').textContent = '—';
      }

      function setAuthUi(authenticated, message = '', messageState = '') {
        const form = document.querySelector('#performance-login-form');
        const session = document.querySelector('#performance-auth-session');
        const authMessage = document.querySelector('#performance-auth-message');
        form.hidden = authenticated;
        session.hidden = !authenticated;
        authMessage.textContent = message || (authenticated
          ? '認証済みです。管理キーは保存されていません。'
          : '管理キーは保存されず、広告Adminの正規ログインAPIへ送信されます。');
        authMessage.dataset.state = messageState;
      }

      function renderCampaigns(campaigns) {
        const body = document.querySelector('#performance-body');
        if (!campaigns.length) {
          body.innerHTML = '<tr class="empty-row"><td colspan="8">キャンペーンはまだありません。</td></tr>';
          return;
        }

        body.innerHTML = campaigns.map((campaign) => `
          <tr>
            <td><span class="campaign-name">${escapeHtml(campaign.name)}</span><span class="campaign-sub">${escapeHtml(campaign.advertiser)}</span></td>
            <td>${escapeHtml(campaign.status)}</td>
            <td>${escapeHtml(campaign.placement)}</td>
            <td>${displayNumber(campaign.impressionsTarget)}</td>
            <td>${displayNumber(campaign.impressionsServed)}</td>
            <td>${displayNumber(campaign.remainingImpressions)}</td>
            <td>${displayNumber(campaign.clicks)}</td>
            <td>${displayCtr(campaign.ctr)}</td>
          </tr>
        `).join('');
      }

      async function loadPerformance() {
        const badge = document.querySelector('#performance-badge');
        const state = document.querySelector('#performance-state');
        const body = document.querySelector('#performance-body');

        try {
          const response = await fetch('/api/ads-performance', { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();

          if (data.status === 'available') {
            setBadge(badge, 'ok', '取得済み');
            state.dataset.state = 'available';
            state.textContent = `広告Adminの正式データを認証済みセッションで読み取り専用取得しています。最終確認 ${new Date(data.generatedAt).toLocaleString('ja-JP')}`;
            document.querySelector('#performance-active').textContent = displayNumber(data.summary?.activeCampaigns);
            document.querySelector('#performance-impressions').textContent = displayNumber(data.summary?.impressions);
            document.querySelector('#performance-clicks').textContent = displayNumber(data.summary?.clicks);
            document.querySelector('#performance-ctr').textContent = displayCtr(data.summary?.ctr);
            document.querySelector('#performance-remaining').textContent = displayNumber(data.summary?.remainingImpressions);
            setAuthUi(true);
            renderCampaigns(data.campaigns || []);
            return;
          }

          if (data.status === 'protected') {
            resetPerformanceValues();
            setBadge(badge, 'protected', '認証保護');
            state.dataset.state = 'protected';
            state.textContent = data.reason === 'session_expired'
              ? '広告Adminのセッションが切れました。管理キーでもう一度認証してください。'
              : 'キャンペーン名・imp・click・CTRは広告Adminの認証で保護されています。下の管理キー認証後だけ実数を表示します。';
            setAuthUi(false, data.reason === 'session_expired' ? 'セッションが切れました。もう一度認証してください。' : '管理キーは保存せず、安全なセッションだけを保持します。');
            body.innerHTML = '<tr class="empty-row"><td colspan="8">管理キーで認証すると正式データを表示します。未取得値を 0 として表示していません。</td></tr>';
            return;
          }

          throw new Error(`performance ${data.status || 'unknown'}`);
        } catch (error) {
          resetPerformanceValues();
          setBadge(badge, 'error', '要確認');
          state.dataset.state = 'error';
          state.textContent = 'キャンペーン実績APIへ接続できませんでした。広告Admin本体のデータや認証には変更を加えていません。';
          body.innerHTML = '<tr class="empty-row"><td colspan="8">実績を取得できませんでした。</td></tr>';
          console.error('[ads-performance]', error);
        }
      }

      async function loginPerformance(event) {
        event.preventDefault();
        const input = document.querySelector('#performance-admin-key');
        const button = document.querySelector('#performance-login-button');
        const key = input.value;
        if (!key) {
          setAuthUi(false, '管理キーを入力してください。', 'error');
          input.focus();
          return;
        }

        button.disabled = true;
        button.textContent = '認証中…';
        setAuthUi(false, '広告Adminへ認証しています。');

        try {
          const response = await fetch('/api/ads-auth', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ key }),
          });
          const data = await response.json().catch(() => ({}));
          input.value = '';

          if (response.status === 401 || data.error === 'invalid_key') {
            setAuthUi(false, '管理キーが違います。入力内容を確認してください。', 'error');
            input.focus();
            return;
          }
          if (!response.ok || !data.ok) throw new Error(data.error || `HTTP ${response.status}`);

          setAuthUi(true, '認証しました。正式なキャンペーン実績を読み込んでいます。');
          await loadPerformance();
        } catch (error) {
          input.value = '';
          setAuthUi(false, '認証APIへ接続できませんでした。広告Admin本体には変更を加えていません。', 'error');
          console.error('[ads-auth]', error);
        } finally {
          button.disabled = false;
          button.textContent = '認証して表示';
        }
      }

      async function logoutPerformance() {
        const button = document.querySelector('#performance-logout-button');
        button.disabled = true;
        button.textContent = 'ログアウト中…';
        try {
          await fetch('/api/ads-logout', { method: 'POST' });
        } finally {
          button.disabled = false;
          button.textContent = 'ログアウト';
          resetPerformanceValues();
          setAuthUi(false, 'ログアウトしました。管理キーで再認証できます。');
          await loadPerformance();
        }
      }

      document.querySelector('#performance-login-form').addEventListener('submit', loginPerformance);
      document.querySelector('#performance-logout-button').addEventListener('click', logoutPerformance);
      loadStatus();
      loadPerformance();
    </script>
  </body>
</html>