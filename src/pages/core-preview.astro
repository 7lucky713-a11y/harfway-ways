---
const title = 'Shared Content Core Preview';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, system-ui, sans-serif; }
      body { margin: 0; background: #0b0b0b; color: #f4f2ec; }
      main { max-width: 980px; margin: 0 auto; padding: 56px 24px 80px; }
      .eyebrow { margin: 0 0 10px; color: #888; font-size: 11px; letter-spacing: .18em; }
      h1 { margin: 0 0 12px; font-size: clamp(32px, 6vw, 64px); line-height: .98; }
      .lead { color: #aaa; max-width: 700px; line-height: 1.7; }
      .status { margin: 32px 0; padding: 20px; border: 1px solid #333; background: #111; }
      .status strong { display: block; font-size: 20px; margin-bottom: 8px; }
      .ok { color: #bfffc8; }
      .bad { color: #ffb5ad; }
      .meta { display: flex; gap: 16px; flex-wrap: wrap; color: #999; font-size: 13px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
      .card { border: 1px solid #2b2b2b; padding: 16px; min-height: 130px; }
      .card h2 { margin: 0 0 10px; font-size: 17px; }
      .card p { margin: 0; color: #999; font-size: 13px; line-height: 1.5; word-break: break-all; }
      button { margin-top: 18px; border: 1px solid #444; background: #f4f2ec; color: #111; padding: 12px 16px; font: inherit; font-weight: 700; cursor: pointer; }
      code { color: #d8d5cf; }
    </style>
  </head>
  <body>
    <main>
      <p class="eyebrow">HARF-WAY / SHARED CONTENT CORE / PREVIEW</p>
      <h1>Game Core</h1>
      <p class="lead">Neonの共通Game Coreを、WAYS・Showcase・今後のYorimichiやPlaylistから同じGame IDで参照するための確認ページです。</p>

      <section class="status" id="status">
        <strong>Checking API...</strong>
        <div class="meta"><span><code>/api/core/games</code></span></div>
      </section>

      <div class="grid" id="games"></div>
      <button id="retry" type="button">再読み込み</button>
    </main>

    <script>
      const status = document.querySelector('#status');
      const games = document.querySelector('#games');
      const retry = document.querySelector('#retry');

      async function load() {
        status.innerHTML = '<strong>Checking API...</strong><div class="meta"><span><code>/api/core/games</code></span></div>';
        games.innerHTML = '';
        try {
          const response = await fetch('/api/core/games?limit=8', { cache: 'no-store' });
          const data = await response.json().catch(() => ({}));
          if (!response.ok || !data.ok) throw new Error(data.error || `HTTP ${response.status}`);

          status.innerHTML = `
            <strong class="ok">CORE API READY</strong>
            <div class="meta">
              <span>version ${data.version || '-'}</span>
              <span>source ${data.source || '-'}</span>
              <span>sample ${data.count || 0} games</span>
            </div>`;

          games.innerHTML = (data.games || []).map((game) => `
            <article class="card">
              <h2>${escapeHtml(game.title || game.id)}</h2>
              <p>${escapeHtml(game.id || '')}</p>
              <p>${escapeHtml(game.storeUrl || '')}</p>
            </article>`).join('');
        } catch (error) {
          status.innerHTML = `
            <strong class="bad">CORE API ERROR</strong>
            <div class="meta"><span>${escapeHtml(error.message || String(error))}</span></div>`;
        }
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>'"]/g, (char) => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        })[char]);
      }

      retry.addEventListener('click', load);
      load();
    </script>
  </body>
</html>
