---
const pageTitle='ADS ADMIN — HARF-WAY';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{pageTitle}</title>
  <style is:global>
    :root{--paper:#f2ede1;--panel:#faf7ef;--ink:#171712;--muted:#817767;--line:#d5ccbc;--lime:#c9ff3d;--amber:#ffe39a;--red:#9e4036;--green:#416d39}
    *{box-sizing:border-box}html{background:var(--paper);color:var(--ink)}body{margin:0;background:var(--paper);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.shell{max-width:1320px;margin:0 auto;padding:34px 28px 70px}.top{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding-bottom:26px;border-bottom:1px solid var(--line)}.eyebrow{font:700 10px/1.4 ui-monospace,monospace;letter-spacing:.17em;color:#766b5b}.top h1{margin:8px 0 0;font:500 clamp(48px,7vw,82px)/.9 Georgia,serif;letter-spacing:-.055em}.top-note{max-width:520px;color:var(--muted);font-size:12px;line-height:1.8}.preview-badge{display:inline-flex;align-items:center;gap:7px;margin-bottom:8px;padding:7px 10px;border:1px solid #9e8f72;border-radius:999px;font:800 9px/1 ui-monospace,monospace;letter-spacing:.12em}.preview-badge:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--lime)}
    .authbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:18px 0 0}.authstate{font-size:11px;color:var(--muted)}.authstate b{color:var(--ink)}.pillbtn{height:40px;padding:0 14px;border:1px solid var(--line);border-radius:999px;background:var(--panel);font-weight:800;cursor:pointer}.pillbtn:hover{border-color:#222}.toolbar{display:grid;grid-template-columns:1fr auto;gap:12px;margin:20px 0}.search{width:100%;height:50px;border:1px solid var(--line);border-radius:999px;background:var(--panel);padding:0 20px;font-size:14px;color:var(--ink);outline:none}.reload{height:50px;padding:0 18px;border:1px solid var(--line);border-radius:999px;background:var(--panel);font-weight:800;cursor:pointer}.notice{margin-bottom:18px;padding:12px 15px;border:1px dashed #a99470;border-radius:10px;color:#766951;font-size:11px;line-height:1.7}.notice strong{color:var(--red)}.layout{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(0,1.35fr);gap:18px}.box{background:var(--panel);border:1px solid var(--line);min-height:520px}.box-head{padding:17px 20px;border-bottom:1px solid var(--line);font:800 10px/1 ui-monospace,monospace;letter-spacing:.14em;color:#6f6557}.list{padding:12px}.item{width:100%;display:grid;grid-template-columns:1fr auto;gap:10px;text-align:left;padding:15px;border:1px solid var(--line);background:transparent;margin-bottom:8px;cursor:pointer}.item:hover,.item.active{border-color:#222;background:#fffdf7}.item-title{font-weight:850;font-size:15px}.item-meta{margin-top:6px;color:var(--muted);font-size:10px;line-height:1.5}.status{align-self:start;white-space:nowrap;padding:6px 9px;border-radius:999px;border:1px solid var(--line);font-size:9px;font-weight:850}.status.pending{background:var(--amber)}.status.active{background:#d8efd2;color:#254722}.status.paused{background:#e6e1d7}.status.completed{background:#e4e0d8}.empty,.loading{padding:32px 20px;color:var(--muted);font-size:12px}.detail{padding:20px}.hero{display:grid;grid-template-columns:180px 1fr;gap:18px;padding-bottom:18px;border-bottom:1px solid var(--line)}.media{aspect-ratio:16/10;border:1px solid var(--line);background:#dfd7c7;display:grid;place-items:center;overflow:hidden;color:#887d6d;font:700 11px ui-monospace,monospace}.media img,.media video{width:100%;height:100%;object-fit:cover;display:block}.detail h2{margin:8px 0 8px;font:600 34px/1.05 Georgia,"Noto Serif JP",serif}.catch{color:#6f5b33;font-weight:750;line-height:1.7;font-size:13px}.description{margin-top:10px;color:#5e574c;font-size:12px;line-height:1.8;white-space:pre-wrap}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}.metric{border:1px solid var(--line);padding:12px}.metric small{display:block;color:var(--muted);font:700 9px ui-monospace,monospace;letter-spacing:.08em}.metric b{display:block;margin-top:5px;font-size:22px}.progress{height:8px;background:#ddd5c6;border-radius:999px;overflow:hidden}.progress>i{display:block;height:100%;background:#222;width:0}.facts{display:grid;grid-template-columns:110px 1fr;gap:9px 14px;margin-top:18px;font-size:11px}.facts dt{color:var(--muted)}.facts dd{margin:0;font-weight:750}.tags{display:flex;flex-wrap:wrap;gap:5px}.tag{padding:5px 7px;border:1px solid var(--line);border-radius:999px;font-size:9px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}.action{padding:11px 14px;border-radius:8px;border:1px solid #222;background:#fffdf7;color:#222;font-weight:850;cursor:pointer}.action.primary{background:#24231f;color:#fff}.action.stop{border-color:#9e4036;color:#8f352d}.action:disabled{opacity:.45;cursor:wait}.storelink{display:inline-flex;text-decoration:none}.write-note{margin-top:10px;color:var(--red);font-size:10px;line-height:1.6}.error{margin:20px;color:var(--red);font-size:12px}.right-empty{padding:28px;color:var(--muted);font-size:12px}
    .gate{margin:34px auto 0;max-width:560px;background:var(--panel);border:1px solid var(--line);padding:26px}.gate h2{margin:0 0 8px;font:600 30px/1.1 Georgia,serif}.gate p{margin:0 0 18px;color:var(--muted);font-size:12px;line-height:1.8}.gate form{display:grid;gap:10px}.gate input{height:48px;border:1px solid var(--line);background:#fffdf8;padding:0 14px;font-size:14px}.gate button{height:48px;border:1px solid #222;background:#222;color:white;font-weight:850;cursor:pointer}.gate .gate-error{min-height:18px;color:var(--red);font-size:11px}.hidden{display:none!important}
    @media(max-width:820px){.shell{padding:24px 14px 50px}.top{display:block}.top-note{margin-top:18px}.authbar{align-items:flex-start}.layout{grid-template-columns:1fr}.box{min-height:auto}.hero{grid-template-columns:1fr}.media{max-height:250px}.metrics{grid-template-columns:repeat(2,1fr)}}
  </style>
</head>
<body>
<main class="shell">
  <header class="top">
    <div><div class="eyebrow">HARF-WAY / AD DELIVERY CONTROL</div><h1>ADS ADMIN</h1></div>
    <div class="top-note"><div class="preview-badge">AUTH PREVIEW / LIVE DATA</div><br>Neon Authの管理者だけが全案件を確認できます。管理者以外の広告主アカウントでは管理画面を開けません。</div>
  </header>

  <section id="gate" class="gate hidden">
    <h2>管理者ログイン</h2>
    <p>広告主ポータルで使っている同じNeon Authアカウントでログインしてください。管理者権限が付いているアカウントだけ通過できます。</p>
    <form id="loginForm">
      <input id="email" type="email" autocomplete="username" placeholder="メールアドレス" required />
      <input id="password" type="password" autocomplete="current-password" placeholder="パスワード" required />
      <button id="loginButton" type="submit">ログイン</button>
      <div id="loginError" class="gate-error"></div>
    </form>
  </section>

  <section id="denied" class="gate hidden">
    <h2>管理者権限がありません</h2>
    <p>ログインは成功していますが、このアカウントにはADS ADMIN権限がありません。</p>
    <button class="pillbtn" id="deniedLogout">ログアウト</button>
  </section>

  <div id="app" class="hidden">
    <div class="authbar"><div class="authstate">SIGNED IN / <b id="signedInLabel">ADMIN</b></div><button class="pillbtn" id="logout">ログアウト</button></div>
    <div class="toolbar"><input class="search" id="search" placeholder="作品名・タグ・掲載先・状態で検索"><button class="reload" id="reload">再読込</button></div>
    <div class="notice">広告主ポータルと同じlive広告DBを見ています。<strong>このPreviewで「承認」「停止」を押した場合もlive配信状態へ反映されます。</strong> 操作前に必ず確認ダイアログを出します。</div>
    <section class="layout">
      <div class="box"><div class="box-head" id="count">ALL CAMPAIGNS / —</div><div id="list" class="list"><div class="loading">live広告DBを読み込んでいます…</div></div></div>
      <div class="box"><div class="box-head">CAMPAIGN DETAIL</div><div id="detail" class="right-empty">左から案件を選択してください。</div></div>
    </section>
  </div>
</main>
<script>
import { createClient } from '@neondatabase/neon-js';

const client=createClient({
  auth:{url:'https://ep-damp-resonance-awphji1s.neonauth.c-12.us-east-1.aws.neon.tech/neondb/auth'},
  dataApi:{url:'https://ep-damp-resonance-awphji1s.apirest.c-12.us-east-1.aws.neon.tech/neondb/rest/v1'}
});

const state={all:[],filtered:[],selected:-1,user:null,busy:false};
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const statusLabel=s=>({pending:'審査待ち',active:'配信中',paused:'停止中',completed:'完了',ended:'終了',draft:'下書き',rejected:'却下'}[s]||s||'—');
const placementLabel=s=>({playback:'WAYS',playlist:'プレイリスト',scraps:'切れ端',sale:'SALE WATCH'}[s]||s);
const fmt=n=>Number(n||0).toLocaleString('ja-JP');
const date=v=>v?new Date(v).toLocaleDateString('ja-JP'):'—';
const show=id=>{for(const x of ['gate','denied','app'])$('#'+x).classList.toggle('hidden',x!==id)};
function isAdminRpc(v){if(v===true)return true;if(Array.isArray(v))return v.some(x=>x===true||x?.hwads_is_admin===true);return v?.hwads_is_admin===true||v?.ad_is_admin===true}
function media(c){if(!c.mediaUrl)return '<div class="media">NO MEDIA</div>';return c.mediaMime?.startsWith('video/')?`<div class="media"><video src="${esc(c.mediaUrl)}" muted autoplay loop playsinline></video></div>`:`<div class="media"><img src="${esc(c.mediaUrl)}" alt=""></div>`}
function normalize(r){const impressions=Number(r.impressions||0),limit=Number(r.impression_limit||0),clicks=Number(r.clicks||0);return {id:r.id,title:r.title||'',catchText:r.catch_text||'',description:r.description||'',storeUrl:r.store_url||'',mediaUrl:r.media_url||'',mediaMime:r.media_mime||'',targetTags:Array.isArray(r.target_tags)?r.target_tags:[],placements:Array.isArray(r.placements)?r.placements:[],status:r.status||'',impressions,impressionLimit:limit,remaining:Math.max(0,limit-impressions),clicks,ctr:impressions?clicks/impressions*100:0,storeVisits:Number(r.store_visits||0),priceYen:Number(r.price_yen||0),endDate:r.end_date||null,createdAt:r.created_at||null,approvedAt:r.approved_at||null}}
function renderList(){const q=$('#search').value.trim().toLowerCase();state.filtered=state.all.filter(c=>[c.title,c.status,statusLabel(c.status),(c.targetTags||[]).join(' '),(c.placements||[]).map(placementLabel).join(' ')].join(' ').toLowerCase().includes(q));$('#count').textContent=`ALL CAMPAIGNS / ${state.filtered.length}`;if(!state.filtered.length){$('#list').innerHTML='<div class="empty">条件に合う案件がありません。</div>';$('#detail').innerHTML='<div class="right-empty">案件を選択してください。</div>';return}$('#list').innerHTML=state.filtered.map((c,i)=>`<button class="item ${i===state.selected?'active':''}" data-i="${i}"><div><div class="item-title">${esc(c.title)}</div><div class="item-meta">${esc((c.placements||[]).map(placementLabel).join(' / '))}<br>IMP ${fmt(c.impressions)} / ${fmt(c.impressionLimit)}</div></div><span class="status ${esc(c.status)}">${esc(statusLabel(c.status))}</span></button>`).join('');if(state.selected<0||state.selected>=state.filtered.length)select(0)}
function actionHtml(c){const parts=[];if(c.status==='pending')parts.push(`<button class="action primary" data-action="activate">承認して配信開始</button>`);if(c.status==='paused')parts.push(`<button class="action primary" data-action="activate">配信を再開</button>`);if(c.status==='active')parts.push(`<button class="action stop" data-action="pause">配信を停止</button>`);if(c.storeUrl)parts.push(`<a class="action storelink" href="${esc(c.storeUrl)}" target="_blank" rel="noopener noreferrer">ストアを見る</a>`);return parts.join('')||'<span class="write-note">現在この案件に操作はありません。</span>'}
function select(i){state.selected=i;const c=state.filtered[i];if(!c)return;document.querySelectorAll('.item').forEach((el,j)=>el.classList.toggle('active',j===i));const pct=c.impressionLimit?Math.min(100,c.impressions/c.impressionLimit*100):0;$('#detail').innerHTML=`<div class="detail"><div class="hero">${media(c)}<div><span class="status ${esc(c.status)}">${esc(statusLabel(c.status))}</span><h2>${esc(c.title)}</h2><div class="catch">${esc(c.catchText||'')}</div><div class="description">${esc(c.description||'')}</div></div></div><div class="metrics"><div class="metric"><small>IMP</small><b>${fmt(c.impressions)}</b></div><div class="metric"><small>残り</small><b>${fmt(c.remaining)}</b></div><div class="metric"><small>CTR</small><b>${Number(c.ctr||0).toFixed(2)}%</b></div><div class="metric"><small>STORE</small><b>${fmt(c.storeVisits)}</b></div></div><div class="progress"><i style="width:${pct}%"></i></div><dl class="facts"><dt>掲載先</dt><dd>${esc((c.placements||[]).map(placementLabel).join(' / ')||'—')}</dd><dt>タグ</dt><dd><div class="tags">${(c.targetTags||[]).length?(c.targetTags||[]).map(t=>`<span class="tag">${esc(t)}</span>`).join(''):'—'}</div></dd><dt>配信量</dt><dd>${fmt(c.impressionLimit)} imp</dd><dt>参考料金</dt><dd>${c.priceYen?`¥${fmt(c.priceYen)}`:'—'}</dd><dt>終了日</dt><dd>${date(c.endDate)}</dd><dt>作成日</dt><dd>${date(c.createdAt)}</dd></dl><div class="actions">${actionHtml(c)}</div><div class="write-note">承認・停止はlive DBへ即時反映されます。</div></div>`}
async function checkAdmin(){const {data,error}=await client.rpc('hwads_is_admin');if(error)throw error;return isAdminRpc(data)}
async function load(){state.selected=-1;$('#list').innerHTML='<div class="loading">live広告DBを読み込んでいます…</div>';const {data,error}=await client.from('ad_campaigns').select('id,title,catch_text,description,store_url,media_url,media_mime,target_tags,placements,status,impressions,impression_limit,clicks,store_visits,price_yen,end_date,created_at,approved_at').order('created_at',{ascending:false}).limit(200);if(error)throw error;state.all=(data||[]).map(normalize).sort((a,b)=>({pending:0,active:1,paused:2}[a.status]??3)-({pending:0,active:1,paused:2}[b.status]??3));renderList()}
async function enter(){try{const {data,error}=await client.auth.getSession();if(error)throw error;if(!data?.session||!data?.user){show('gate');return}state.user=data.user;const admin=await checkAdmin();if(!admin){show('denied');return}$('#signedInLabel').textContent='ADMIN';show('app');await load()}catch(e){console.error(e);show('gate');$('#loginError').textContent='認証状態の確認に失敗しました。再ログインしてください。'}}
async function doLogin(e){e.preventDefault();$('#loginError').textContent='';const btn=$('#loginButton');btn.disabled=true;btn.textContent='確認中…';try{const {error}=await client.auth.signIn.email({email:$('#email').value.trim(),password:$('#password').value});if(error)throw error;await enter()}catch(err){$('#loginError').textContent=err?.message||'ログインに失敗しました。'}finally{btn.disabled=false;btn.textContent='ログイン'}}
async function logout(){await client.auth.signOut();state.user=null;state.all=[];show('gate')}
async function changeStatus(action){if(state.busy)return;const c=state.filtered[state.selected];if(!c)return;const next=action==='activate'?'active':'paused';const verb=action==='activate'?(c.status==='paused'?'配信を再開':'承認して配信開始'):'配信を停止';if(!confirm(`「${c.title}」を${verb}します。\n\nこの操作はlive配信へ反映されます。よろしいですか？`))return;state.busy=true;document.querySelectorAll('[data-action]').forEach(b=>b.disabled=true);try{const payload={status:next};if(action==='activate'&&c.status==='pending')payload.approved_at=new Date().toISOString();const {error}=await client.from('ad_campaigns').update(payload).eq('id',c.id).select('id,status');if(error)throw error;await load()}catch(err){alert('更新に失敗しました：'+(err?.message||'unknown error'))}finally{state.busy=false}}
$('#loginForm').addEventListener('submit',doLogin);$('#logout').addEventListener('click',logout);$('#deniedLogout').addEventListener('click',logout);$('#search').addEventListener('input',()=>{state.selected=-1;renderList()});$('#reload').addEventListener('click',()=>load().catch(e=>alert(e.message)));$('#list').addEventListener('click',e=>{const b=e.target.closest('[data-i]');if(b)select(Number(b.dataset.i))});$('#detail').addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)changeStatus(b.dataset.action)});enter();
</script>
</body></html>
