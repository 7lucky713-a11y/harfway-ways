---
const pageTitle='ADS ADMIN v2 — HARF-WAY';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{pageTitle}</title>
  <style is:global>
    :root{--paper:#f2ede1;--panel:#faf7ef;--ink:#171712;--muted:#817767;--line:#d5ccbc;--lime:#c9ff3d;--amber:#ffe39a;--red:#9e4036;--green:#416d39}
    *{box-sizing:border-box}html{background:var(--paper);color:var(--ink)}body{margin:0;background:var(--paper);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.shell{max-width:1320px;margin:0 auto;padding:34px 28px 70px}.top{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding-bottom:26px;border-bottom:1px solid var(--line)}.eyebrow{font:700 10px/1.4 ui-monospace,monospace;letter-spacing:.17em;color:#766b5b}.top h1{margin:8px 0 0;font:500 clamp(48px,7vw,82px)/.9 Georgia,serif;letter-spacing:-.055em}.top-note{max-width:500px;color:var(--muted);font-size:12px;line-height:1.8}.preview-badge{display:inline-flex;align-items:center;gap:7px;margin-bottom:8px;padding:7px 10px;border:1px solid #9e8f72;border-radius:999px;font:800 9px/1 ui-monospace,monospace;letter-spacing:.12em}.preview-badge:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--lime)}
    .toolbar{display:grid;grid-template-columns:1fr auto;gap:12px;margin:20px 0}.search{width:100%;height:50px;border:1px solid var(--line);border-radius:999px;background:var(--panel);padding:0 20px;font-size:14px;color:var(--ink);outline:none}.reload{height:50px;padding:0 18px;border:1px solid var(--line);border-radius:999px;background:var(--panel);font-weight:800;cursor:pointer}.notice{margin-bottom:18px;padding:12px 15px;border:1px dashed #a99470;border-radius:10px;color:#766951;font-size:11px;line-height:1.7}.layout{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(0,1.35fr);gap:18px}.box{background:var(--panel);border:1px solid var(--line);min-height:520px}.box-head{padding:17px 20px;border-bottom:1px solid var(--line);font:800 10px/1 ui-monospace,monospace;letter-spacing:.14em;color:#6f6557}.list{padding:12px}.item{width:100%;display:grid;grid-template-columns:1fr auto;gap:10px;text-align:left;padding:15px;border:1px solid var(--line);background:transparent;margin-bottom:8px;cursor:pointer}.item:hover,.item.active{border-color:#222;background:#fffdf7}.item-title{font-weight:850;font-size:15px}.item-meta{margin-top:6px;color:var(--muted);font-size:10px;line-height:1.5}.status{align-self:start;white-space:nowrap;padding:6px 9px;border-radius:999px;border:1px solid var(--line);font-size:9px;font-weight:850}.status.pending{background:var(--amber)}.status.active{background:#d8efd2;color:#254722}.status.paused{background:#e6e1d7}.empty,.loading{padding:32px 20px;color:var(--muted);font-size:12px}.detail{padding:20px}.hero{display:grid;grid-template-columns:180px 1fr;gap:18px;padding-bottom:18px;border-bottom:1px solid var(--line)}.media{aspect-ratio:16/10;border:1px solid var(--line);background:#dfd7c7;display:grid;place-items:center;overflow:hidden;color:#887d6d;font:700 11px ui-monospace,monospace}.media img,.media video{width:100%;height:100%;object-fit:cover;display:block}.detail h2{margin:2px 0 8px;font:600 34px/1.05 Georgia,"Noto Serif JP",serif}.catch{color:#6f5b33;font-weight:750;line-height:1.7;font-size:13px}.description{margin-top:10px;color:#5e574c;font-size:12px;line-height:1.8}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}.metric{border:1px solid var(--line);padding:12px}.metric small{display:block;color:var(--muted);font:700 9px ui-monospace,monospace;letter-spacing:.08em}.metric b{display:block;margin-top:5px;font-size:22px}.progress{height:8px;background:#ddd5c6;border-radius:999px;overflow:hidden}.progress>i{display:block;height:100%;background:#222;width:0}.facts{display:grid;grid-template-columns:110px 1fr;gap:9px 14px;margin-top:18px;font-size:11px}.facts dt{color:var(--muted)}.facts dd{margin:0;font-weight:750}.tags{display:flex;flex-wrap:wrap;gap:5px}.tag{padding:5px 7px;border:1px solid var(--line);border-radius:999px;font-size:9px}.actions{display:flex;gap:8px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line)}.action{padding:11px 14px;border-radius:8px;border:1px solid #aaa;background:#eee9dc;color:#9c9283;font-weight:850;cursor:not-allowed}.action.primary{background:#2a2924;color:#9b968b}.write-note{margin-top:10px;color:var(--red);font-size:10px;line-height:1.6}.error{margin:20px;color:var(--red);font-size:12px}.right-empty{padding:28px;color:var(--muted);font-size:12px}
    @media(max-width:820px){.shell{padding:24px 14px 50px}.top{display:block}.top-note{margin-top:18px}.layout{grid-template-columns:1fr}.box{min-height:auto}.hero{grid-template-columns:1fr}.media{max-height:250px}.metrics{grid-template-columns:repeat(2,1fr)}}
  </style>
</head>
<body>
<main class="shell">
  <header class="top">
    <div><div class="eyebrow">HARF-WAY / AD DELIVERY CONTROL</div><h1>ADS ADMIN</h1></div>
    <div class="top-note"><div class="preview-badge">PREVIEW / READ ONLY</div><br>live広告DBを読み取る新管理画面のPreviewです。承認・停止などの書き込み操作は、管理者Auth設定が完了するまで無効です。</div>
  </header>
  <div class="toolbar"><input class="search" id="search" placeholder="作品名・タグ・掲載先・状態で検索"><button class="reload" id="reload">再読込</button></div>
  <div class="notice">広告主ポータルで作成した案件を、同じlive広告DBから直接確認しています。旧ADS ADMINのPreview用アカウント・旧接続設定には依存しません。</div>
  <section class="layout">
    <div class="box"><div class="box-head" id="count">ALL CAMPAIGNS / —</div><div id="list" class="list"><div class="loading">live広告DBを読み込んでいます…</div></div></div>
    <div class="box"><div class="box-head">CAMPAIGN DETAIL</div><div id="detail" class="right-empty">左から案件を選択してください。</div></div>
  </section>
</main>
<script>
const state={all:[],filtered:[],selected:-1};
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const statusLabel=s=>({pending:'審査待ち',active:'配信中',paused:'停止中',ended:'終了',draft:'下書き'}[s]||s||'—');
const placementLabel=s=>({playback:'WAYS',playlist:'プレイリスト',scraps:'切れ端',sale:'SALE WATCH'}[s]||s);
const fmt=n=>Number(n||0).toLocaleString('ja-JP');
const date=v=>v?new Date(v).toLocaleDateString('ja-JP'):'—';
function media(c){if(!c.mediaUrl)return '<div class="media">NO MEDIA</div>';return c.mediaMime?.startsWith('video/')?`<div class="media"><video src="${esc(c.mediaUrl)}" muted autoplay loop playsinline></video></div>`:`<div class="media"><img src="${esc(c.mediaUrl)}" alt=""></div>`}
function renderList(){const q=$('#search').value.trim().toLowerCase();state.filtered=state.all.filter(c=>[c.title,c.status,statusLabel(c.status),(c.targetTags||[]).join(' '),(c.placements||[]).map(placementLabel).join(' ')].join(' ').toLowerCase().includes(q));$('#count').textContent=`ALL CAMPAIGNS / ${state.filtered.length}`;if(!state.filtered.length){$('#list').innerHTML='<div class="empty">条件に合う案件がありません。</div>';$('#detail').innerHTML='<div class="right-empty">案件を選択してください。</div>';return}$('#list').innerHTML=state.filtered.map((c,i)=>`<button class="item ${i===state.selected?'active':''}" data-i="${i}"><div><div class="item-title">${esc(c.title)}</div><div class="item-meta">${esc((c.placements||[]).map(placementLabel).join(' / '))}<br>IMP ${fmt(c.impressions)} / ${fmt(c.impressionLimit)}</div></div><span class="status ${esc(c.status)}">${esc(statusLabel(c.status))}</span></button>`).join('');if(state.selected<0||state.selected>=state.filtered.length)select(0)}
function select(i){state.selected=i;const c=state.filtered[i];if(!c)return;document.querySelectorAll('.item').forEach((el,j)=>el.classList.toggle('active',j===i));const pct=c.impressionLimit?Math.min(100,c.impressions/c.impressionLimit*100):0;$('#detail').innerHTML=`<div class="detail"><div class="hero">${media(c)}<div><span class="status ${esc(c.status)}">${esc(statusLabel(c.status))}</span><h2>${esc(c.title)}</h2><div class="catch">${esc(c.catchText||'')}</div><div class="description">${esc(c.description||'')}</div></div></div><div class="metrics"><div class="metric"><small>IMP</small><b>${fmt(c.impressions)}</b></div><div class="metric"><small>残り</small><b>${fmt(c.remaining)}</b></div><div class="metric"><small>CTR</small><b>${Number(c.ctr||0).toFixed(2)}%</b></div><div class="metric"><small>STORE</small><b>${fmt(c.storeVisits)}</b></div></div><div class="progress"><i style="width:${pct}%"></i></div><dl class="facts"><dt>掲載先</dt><dd>${esc((c.placements||[]).map(placementLabel).join(' / ')||'—')}</dd><dt>タグ</dt><dd><div class="tags">${(c.targetTags||[]).length?(c.targetTags||[]).map(t=>`<span class="tag">${esc(t)}</span>`).join(''):'—'}</div></dd><dt>配信量</dt><dd>${fmt(c.impressionLimit)} imp</dd><dt>参考料金</dt><dd>${c.priceYen?`¥${fmt(c.priceYen)}`:'—'}</dd><dt>終了日</dt><dd>${date(c.endDate)}</dd><dt>作成日</dt><dd>${date(c.createdAt)}</dd></dl><div class="actions"><button class="action primary" disabled>承認して配信開始</button><button class="action" disabled>停止</button></div><div class="write-note">現在は安全確認用Previewのため書き込みOFFです。管理者Authを有効化した本番版で承認操作を開放します。</div></div>`}
async function load(){state.selected=-1;$('#list').innerHTML='<div class="loading">live広告DBを読み込んでいます…</div>';try{const r=await fetch('/api/ads-admin-preview-data',{cache:'no-store'});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`HTTP ${r.status}`);state.all=d.campaigns||[];renderList()}catch(e){$('#count').textContent='ALL CAMPAIGNS / ERROR';$('#list').innerHTML=`<div class="error">読み込みに失敗しました：${esc(e.message)}</div>`}}
$('#search').addEventListener('input',()=>{state.selected=-1;renderList()});$('#reload').addEventListener('click',load);$('#list').addEventListener('click',e=>{const b=e.target.closest('[data-i]');if(b)select(Number(b.dataset.i))});load();
</script>
</body></html>
