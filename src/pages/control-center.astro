<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>HARF-WAY CONTROL CENTER</title>
<style is:global>
:root{--bg:#090a0c;--panel:#111318;--panel2:#0c0e12;--line:#2a3038;--text:#f4f4ef;--muted:#8f98a5;--lime:#efff35;--green:#75ee9a;--red:#ff7777;--amber:#ffcc69;--blue:#77baff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.top{position:sticky;top:0;z-index:30;display:flex;gap:18px;align-items:center;justify-content:space-between;padding:13px 20px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.95);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.08em}.brand small{color:var(--muted);font-size:9px}.nav{display:flex;gap:6px;flex-wrap:wrap}.nav button,.linkbtn{appearance:none;border:1px solid #343b45;border-radius:9px;padding:9px 11px;background:#15181e;color:#fff;font-weight:900;font-size:11px;cursor:pointer;text-decoration:none}.nav button.active{background:var(--lime);border-color:var(--lime);color:#08090a}.actions{display:flex;gap:7px;align-items:center}.wrap{max-width:1500px;margin:auto;padding:26px 22px 70px}.hero{display:flex;gap:32px;align-items:flex-end;justify-content:space-between;margin-bottom:22px}.ey{font-size:11px;font-weight:950;letter-spacing:.14em;color:var(--lime);margin-bottom:9px}.hero h1{font-size:clamp(46px,7vw,92px);line-height:.87;letter-spacing:-.065em;margin:0}.hero p{max-width:620px;color:var(--muted);line-height:1.72;margin:0}.state{margin-top:9px;font:11px/1.5 ui-monospace,monospace;color:var(--muted)}.state.ok{color:var(--green)}.state.bad{color:var(--red)}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-bottom:18px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:15px;min-height:100px}.kpi small{display:block;color:var(--muted);font-size:9px;letter-spacing:.09em}.kpi b{display:block;font-size:31px;letter-spacing:-.04em;margin-top:8px}.kpi i{display:block;font-style:normal;color:var(--muted);font-size:9px;margin-top:4px}.view{display:none}.view.active{display:block}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px;margin-bottom:16px}.panel h2{font-size:12px;letter-spacing:.1em;margin:0 0 13px}.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.step{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:14px;min-height:112px}.step strong{display:block;color:var(--lime);font-size:9px;letter-spacing:.08em}.step b{display:block;font-size:14px;margin:8px 0 5px}.step span{display:block;color:var(--muted);font-size:9px;line-height:1.55}.lane{display:grid;grid-template-columns:185px 1fr;gap:14px;padding:16px 0;border-top:1px solid var(--line)}.lane:first-child{border-top:0;padding-top:0}.lanehead strong{display:block;font-size:11px;letter-spacing:.12em;color:var(--lime)}.lanehead span{display:block;color:var(--muted);font-size:9px;line-height:1.55;margin-top:6px}.systemgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.sys{position:relative;background:var(--panel2);border:1px solid #303640;border-radius:13px;padding:14px;min-height:142px;display:flex;flex-direction:column}.sys:hover{border-color:#4a535f}.systop{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.sysname{font-weight:950;font-size:12px;line-height:1.35}.status{font:900 8px/1 ui-monospace,monospace;border:1px solid #444b55;border-radius:999px;padding:5px 6px;color:var(--muted);white-space:nowrap}.status.up{color:var(--green);border-color:#376749}.status.down{color:var(--red);border-color:#724040}.status.wait{color:var(--amber);border-color:#68582f}.role{font-size:9px;color:var(--blue);font-weight:850;margin-top:6px}.desc{font-size:9px;line-height:1.55;color:var(--muted);margin:7px 0 12px;flex:1}.syslinks{display:flex;gap:5px;flex-wrap:wrap}.syslinks a{font-size:9px;font-weight:900;color:#e8edf5;text-decoration:none;border:1px solid #353c46;border-radius:7px;padding:6px 8px;background:#13161b}.syslinks a.primary{background:var(--lime);border-color:var(--lime);color:#08090a}.syslinks a:hover{border-color:var(--lime)}details.legacy{border:1px solid var(--line);border-radius:12px;background:var(--panel2);overflow:hidden}details.legacy summary{cursor:pointer;padding:13px 14px;font-size:10px;font-weight:900;letter-spacing:.06em;color:var(--muted)}.legacygrid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line)}.legacyitem{background:#0e1014;padding:11px}.legacyitem b{display:block;font-size:9px}.legacyitem span{display:block;color:var(--muted);font-size:8px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.services{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.service{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:14px;min-height:150px}.service .name{font-weight:950;font-size:11px}.dot{display:inline-block;width:7px;height:7px;border-radius:99px;background:#555;margin-right:6px}.service.live .dot{background:var(--green)}.service b{display:block;font-size:29px;margin-top:13px}.service small{color:var(--muted);font-size:9px}.badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:12px}.badge{font:800 8px/1 ui-monospace,monospace;padding:5px 6px;border-radius:999px;border:1px solid #39414b;color:var(--muted)}.badge.ok{color:var(--green);border-color:#376749}.badge.warn{color:var(--amber);border-color:#66562f}.analyticslink{display:flex;justify-content:space-between;align-items:center;gap:20px;background:linear-gradient(120deg,#141821,#101218);border:1px solid #343b46;border-radius:14px;padding:18px}.analyticslink b{font-size:20px}.analyticslink p{margin:5px 0 0;color:var(--muted);font-size:10px;line-height:1.5}.analyticslink a{background:var(--lime);color:#08090a;text-decoration:none;font-weight:950;font-size:10px;padding:10px 12px;border-radius:9px;white-space:nowrap}.ops{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.health{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:13px}.healthtop{display:flex;justify-content:space-between;gap:7px}.healthname{font-weight:950;font-size:10px}.healthstatus{font:900 9px/1 ui-monospace,monospace}.health.ok .healthstatus{color:var(--green)}.health.bad .healthstatus{color:var(--red)}.health b{display:block;font-size:24px;margin-top:13px}.health small{color:var(--muted);font-size:9px}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:16px}.todo{display:grid;gap:7px}.todoitem{display:grid;grid-template-columns:90px 1fr;gap:12px;border:1px solid var(--line);background:var(--panel2);border-radius:11px;padding:12px}.todoitem strong{font-size:9px;color:var(--amber);letter-spacing:.08em}.todoitem span{font-size:10px;color:var(--muted);line-height:1.55}.foot{margin-top:20px;border-top:1px solid var(--line);padding-top:14px;color:var(--muted);font-size:10px}@media(max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}.pipeline{grid-template-columns:repeat(3,1fr)}.lane{grid-template-columns:145px 1fr}.systemgrid{grid-template-columns:repeat(2,1fr)}.services{grid-template-columns:repeat(3,1fr)}.ops{grid-template-columns:repeat(3,1fr)}.legacygrid{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.top{align-items:flex-start;flex-direction:column}.actions{width:100%;justify-content:space-between}.hero{display:block}.hero p{margin-top:17px}.kpis{grid-template-columns:1fr 1fr}.pipeline,.systemgrid,.services,.ops,.twocol{grid-template-columns:1fr}.lane{grid-template-columns:1fr}.legacygrid{grid-template-columns:1fr 1fr}.wrap{padding:20px 14px 55px}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / CONTROL CENTER <small>Preview v0.2</small></div><div class="actions"><nav class="nav"><button data-view="system" class="active">SYSTEM</button><button data-view="analytics">ANALYTICS</button><button data-view="ops">OPS</button></nav><a class="linkbtn" href="https://harfway-vercel-hub.vercel.app/" target="_blank" rel="noreferrer">OLD HUB ↗</a></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">HARF-WAY OPERATING SYSTEM</div><h1>ONE<br>PLACE.</h1></div><div><p>「Vercelにあるもの全部」ではなく、いまHARF-WAYを動かすために使うシステムだけを整理。役割・入口・稼働状態がすぐ分かる管理画面にします。</p><div id="state" class="state">SYSTEM / ANALYTICS / OPS を読み込み中…</div></div></section>
<section class="kpis"><div class="kpi"><small>ACTIVE SYSTEMS</small><b id="activeCount">16</b><i>現役のみ</i></div><div class="kpi"><small>LIVE HEALTH</small><b id="healthCount">—</b><i>主要16サービス</i></div><div class="kpi"><small>GA4 COLLECTION</small><b id="gaCount">—</b><i>主要5サービス</i></div><div class="kpi"><small>GA4 REPORTING</small><b id="reportCount">—</b><i>Data API</i></div><div class="kpi"><small>NEXT BUILD</small><b style="font-size:22px">OPS</b><i>Rollback / Backup</i></div></section>

<section id="view-system" class="view active">
<section class="panel"><h2>SYSTEM FLOW</h2><div class="pipeline"><div class="step"><strong>01 INPUT</strong><b>素材を集める</b><span>R2・過去記事・切れ端・ゲーム情報。</span></div><div class="step"><strong>02 CORE</strong><b>DBでつなぐ</b><span>作品・動画・記事を共通の情報として保持。</span></div><div class="step"><strong>03 CREATE</strong><b>再編集する</b><span>WAYS / Yorimichi / ZINEなどのEditor。</span></div><div class="step"><strong>04 PUBLISH</strong><b>公開する</b><span>フィード・ショーケース・プレイリストへ。</span></div><div class="step"><strong>05 OPERATE</strong><b>測る・守る</b><span>Analytics / OPS / Cleanup / Rollback。</span></div></div></section>
<section class="panel"><h2>ACTIVE SYSTEMS</h2><div id="lanes"></div></section>
<section class="panel"><h2>LEGACY / AUXILIARY</h2><details class="legacy"><summary>既存HUBに残っている補助・旧システムを表示</summary><div id="legacy" class="legacygrid"></div></details></section>
</section>

<section id="view-analytics" class="view">
<section class="panel"><h2>5 SERVICE ANALYTICS SNAPSHOT / LAST 7 DAYS</h2><div id="services" class="services"><div class="state">GA4を読み込み中…</div></div></section>
<section class="panel"><div class="analyticslink"><div><b>Analytics Hub v0.3</b><p>ゲーム別・ファネル・期間切替などの詳細分析は既存Analytics画面へ。</p></div><a href="/analytics" target="_blank">OPEN FULL ANALYTICS ↗</a></div></section>
</section>

<section id="view-ops" class="view">
<section class="panel"><h2>LIVE HEALTH CHECK / ACTIVE SYSTEMS</h2><div id="ops" class="ops"><div class="state">主要サービスを確認中…</div></div></section>
<div class="twocol"><section class="panel"><h2>OPS v0.1 — NOW</h2><div class="todo"><div class="todoitem"><strong>LIVE</strong><span>各システムのHTTP疎通と応答時間をリアルタイム確認。</span></div><div class="todoitem"><strong>LIVE</strong><span>現役システムへの入口を1箇所に統合。</span></div><div class="todoitem"><strong>LIVE</strong><span>5サービスのGA4計測状態を同時表示。</span></div></div></section><section class="panel"><h2>OPS v0.2 — NEXT</h2><div class="todo"><div class="todoitem"><strong>NEXT</strong><span>最新Production deployment・commit・更新時刻。</span></div><div class="todoitem"><strong>NEXT</strong><span>Rollback候補と最後に正常だったProduction。</span></div><div class="todoitem"><strong>NEXT</strong><span>DB / R2 / Backupの最終成功時刻と容量。</span></div></div></section></div>
</section>
<div class="foot">Preview v0.2 — Productionは変更していません。SYSTEMは現役システムを編集して表示し、旧HUBの生一覧はLEGACYへ隔離しました。</div>
</main>
<script is:inline>
const $=s=>document.querySelector(s),n=v=>Number(v||0).toLocaleString('ja-JP');
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
const SYSTEMS=[
 {group:'DATA / CORE',note:'素材と共通データを管理',items:[
  {id:'db-master',name:'DB MASTER',role:'DB全体管理',desc:'作品・動画・記事など共通DBを閲覧・編集。',links:[['OPEN','/db-master']]},
  {id:'salvager',name:'ARCHIVE SALVAGER',role:'過去記事回収',desc:'過去記事URLから内容をサルベージしてDBへ統合。',links:[['OPEN','/salvage/']]},
  {id:'r2-media',name:'R2 MEDIA MANAGER',role:'メディア管理',desc:'R2内の動画・画像を一覧確認し、不要ファイルや重複を整理。',links:[['OPEN','https://harfway-showcase-manager-v2.vercel.app/r2-media.html']]}
 ]},
 {group:'CREATE',note:'素材をコンテンツへ変換',items:[
  {id:'ways-editor',name:'WAYS EDITOR',role:'短尺動画投稿',desc:'R2動画・ストア情報・紹介文をWAYSへ登録。',links:[['OPEN','https://harfway-playback-editor.vercel.app/']]},
  {id:'yorimichi',name:'YORIMICHI EDITOR',role:'週刊制作',desc:'週刊ヨリミチをブロックで組み立てる誌面Editor。',links:[['OPEN','https://weekly-yorimichi-editor.vercel.app/']]},
  {id:'zine',name:'ZINE EDITOR',role:'紙面制作',desc:'切れ端とCoreから「みちすがら」のページを制作。',links:[['OPEN','https://harfway-zine-editor.vercel.app/']]},
  {id:'design-stock',name:'DESIGN STOCK',role:'参考ストック',desc:'参考URL・画像・メモをデザイン資料として保存。',links:[['OPEN','https://design-stock-nu.vercel.app/']]},
  {id:'factory',name:'HARFWAY FACTORY',role:'制作基盤',desc:'新しいVercelツールを安全なPreview運用で立ち上げる。',links:[['OPEN','https://harfway-factory-restart-test.vercel.app/']]}
 ]},
 {group:'PUBLISH',note:'読者へ届ける公開面',items:[
  {id:'ways',name:'WAYS',role:'短尺ゲーム発見',desc:'動画からゲームを見つけるHARF-WAYの発見基盤。',links:[['PUBLIC','https://harfway-playback.vercel.app/'],['ARCHIVE','https://harfway-playback.vercel.app/archive/']]},
  {id:'showcase',name:'SHOWCASE',role:'持込所',desc:'第2回 #HARFWAY持込所の30秒ゲームショーケース。',links:[['PUBLIC','https://harfway-showcase-ui-v4.vercel.app/'],['ADMIN','https://harfway-showcase-manager-v2.vercel.app/']]},
  {id:'playlist',name:'PLAYLIST TV',role:'連続視聴',desc:'テーマ別にゲーム動画をTV型UIで連続視聴。',links:[['PUBLIC','https://harfway-playlist-tv.vercel.app/'],['ADMIN','https://harfway-playlist-tv.vercel.app/admin']]},
  {id:'scrapbook',name:'GAME SCRAPBOOK',role:'切れ端アーカイブ',desc:'ゲームメモと動画を保管・再発見するアーカイブ。',links:[['PUBLIC','https://harf-way-game-scrapbook.vercel.app/'],['ADMIN','https://harf-way-game-scrapbook-admin.vercel.app/']]}
 ]},
 {group:'OPERATE',note:'測定・管理・保守',items:[
  {id:'analytics',name:'ANALYTICS HUB',role:'計測',desc:'WAYS / Showcase / Playlist / Yorimichi / ZINEを一括計測。',links:[['OPEN','/analytics']]},
  {id:'hub',name:'VERCEL HUB',role:'リンク台帳',desc:'公開・管理・計測ページをまとめた旧管理ポータル。',links:[['OPEN','https://harfway-vercel-hub.vercel.app/']]},
  {id:'cleanup',name:'VERCEL CLEANUP',role:'デプロイ整理',desc:'不要・古いVercel deploymentを確認して整理。',links:[['OPEN','https://harfway-vercel-cleanup-harf-way.vercel.app/']]}
 ]}
];
document.querySelectorAll('[data-view]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x===btn));document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));$('#view-'+btn.dataset.view).classList.add('active')}));
function sysCard(x,health){const h=health.get(x.id);const state=h?(h.ok?'up':'down'):'wait';const text=h?(h.ok?`UP ${h.status}`:`DOWN ${h.status||'ERR'}`):'CHECKING';return `<article class="sys"><div class="systop"><div><div class="sysname"><i class="dot" style="background:${state==='up'?'var(--green)':state==='down'?'var(--red)':'#555'}"></i>${esc(x.name)}</div><div class="role">${esc(x.role)}</div></div><span class="status ${state}">${text}</span></div><div class="desc">${esc(x.desc)}</div><div class="syslinks">${x.links.map(([label,url],i)=>`<a class="${i===0?'primary':''}" href="${esc(url)}" target="_blank" rel="noreferrer">${esc(label)} ↗</a>`).join('')}</div></article>`}
function renderSystems(healthMap){$('#lanes').innerHTML=SYSTEMS.map(g=>`<div class="lane"><div class="lanehead"><strong>${esc(g.group)}</strong><span>${esc(g.note)}</span></div><div class="systemgrid">${g.items.map(x=>sysCard(x,healthMap)).join('')}</div></div>`).join('')}
function healthCard(x){return `<article class="health ${x.ok?'ok':'bad'}"><div class="healthtop"><div class="healthname"><i class="dot" style="background:${x.ok?'var(--green)':'var(--red)'}"></i>${esc(x.name)}</div><div class="healthstatus">${x.ok?'UP':'DOWN'} / ${x.status||'ERR'}</div></div><b>${n(x.latencyMs)} ms</b><small>${esc(x.kind||'service')}</small></article>`}
function serviceCard(name,s){const collect=!!s?.collection?.enabled,report=!!s?.reportingConnected;let metric='—',label='';if(name==='WAYS'&&report){metric=n(s.summary?.gameViews);label='GAME VIEWS'}else if(name==='SHOWCASE'&&s?.deepReportingConnected){metric=n(s.summary?.gameViews);label='GAME VIEWS'}else if(report){metric=n(s.summary?.pageViews);label=`PV / USERS ${n(s.summary?.activeUsers)}`}return `<article class="service ${collect?'live':''}"><div class="name"><i class="dot"></i>${name}</div><b>${metric}</b><small>${label||'REPORTING WAIT'}</small><div class="badges"><span class="badge ${collect?'ok':'warn'}">${collect?'COLLECTION':'COLLECTION OFF'}</span><span class="badge ${report?'ok':'warn'}">${report?'REPORTING':'WAIT'}</span></div></article>`}
async function load(){try{const [health,analytics]=await Promise.all([fetch('/api/control-center-health').then(r=>r.json()),fetch('/api/harfway-analytics?days=7').then(r=>r.json())]);const healthMap=new Map((health?.checks||[]).map(x=>[x.id,x]));renderSystems(healthMap);if(health?.ok){$('#healthCount').textContent=`${n(health.summary?.healthy)} / ${n(health.summary?.total)}`;$('#ops').innerHTML=(health.checks||[]).map(healthCard).join('');const activeNames=new Set(SYSTEMS.flatMap(g=>g.items.map(x=>x.name.toLowerCase())));const legacy=(health.hub?.items||[]).filter(x=>!activeNames.has(String(x.name||'').toLowerCase()));$('#legacy').innerHTML=legacy.map(x=>`<div class="legacyitem"><b>${esc(x.name)}</b><span>${esc(x.description||x.project_slug||'')}</span></div>`).join('')||'<div class="legacyitem"><b>なし</b><span>旧HUBとの差分なし</span></div>'}if(analytics?.ok){const all=Object.values(analytics.services||{});$('#gaCount').textContent=`${all.filter(x=>x.collection?.enabled).length} / ${all.length}`;$('#reportCount').textContent=`${all.filter(x=>x.reportingConnected).length} / ${all.length}`;$('#services').innerHTML=['WAYS','SHOWCASE','PLAYLIST','YORIMICHI','ZINE'].map(name=>serviceCard(name,analytics.services?.[name.toLowerCase()])).join('')}$('#state').textContent=`更新 ${new Date().toLocaleTimeString('ja-JP')} / ACTIVE SYSTEMS・GA4・Health接続済み`;$('#state').className='state ok'}catch(e){renderSystems(new Map());$('#state').textContent='読み込みエラー: '+e.message;$('#state').className='state bad'}}
renderSystems(new Map());load();
</script>
</body>
</html>
