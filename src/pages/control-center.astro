<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>HARF-WAY CONTROL CENTER</title>
<style>
:root{--bg:#090a0c;--panel:#111318;--panel2:#0c0e12;--line:#2a3038;--text:#f4f4ef;--muted:#8f98a5;--lime:#efff35;--green:#75ee9a;--red:#ff7777;--amber:#ffcc69;--blue:#77baff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.top{position:sticky;top:0;z-index:30;display:flex;gap:18px;align-items:center;justify-content:space-between;padding:13px 20px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.94);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.08em}.brand small{color:var(--muted);font-size:9px}.nav{display:flex;gap:6px;flex-wrap:wrap}.nav button,.linkbtn{appearance:none;border:1px solid #343b45;border-radius:9px;padding:9px 11px;background:#15181e;color:#fff;font-weight:900;font-size:11px;cursor:pointer;text-decoration:none}.nav button.active{background:var(--lime);border-color:var(--lime);color:#08090a}.actions{display:flex;gap:7px;align-items:center}.wrap{max-width:1500px;margin:auto;padding:28px 22px 70px}.hero{display:flex;gap:34px;align-items:flex-end;justify-content:space-between;margin-bottom:24px}.ey{font-size:11px;font-weight:950;letter-spacing:.14em;color:var(--lime);margin-bottom:9px}.hero h1{font-size:clamp(48px,7vw,96px);line-height:.86;letter-spacing:-.065em;margin:0}.hero p{max-width:600px;color:var(--muted);line-height:1.75;margin:0}.state{margin-top:9px;font:11px/1.5 ui-monospace,monospace;color:var(--muted)}.state.ok{color:var(--green)}.state.bad{color:var(--red)}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-bottom:18px}.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:15px;min-height:104px}.kpi small{display:block;color:var(--muted);font-size:9px;letter-spacing:.09em}.kpi b{display:block;font-size:32px;letter-spacing:-.04em;margin-top:8px}.kpi i{display:block;font-style:normal;color:var(--muted);font-size:9px;margin-top:4px}.view{display:none}.view.active{display:block}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:17px;min-width:0}.panel.wide{grid-column:1/-1}.panel h2{font-size:12px;letter-spacing:.1em;margin:0 0 13px}.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.step{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:14px;min-height:125px}.step strong{display:block;color:var(--lime);font-size:10px;letter-spacing:.08em}.step b{display:block;font-size:15px;margin:9px 0 6px}.step span{display:block;color:var(--muted);font-size:10px;line-height:1.55}.catalog{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.item{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:13px;min-width:0}.itemtop{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.itemname{font-weight:950;font-size:11px;line-height:1.4}.cat{font:800 8px/1 ui-monospace,monospace;border:1px solid #37404a;border-radius:999px;padding:5px 6px;color:var(--muted);white-space:nowrap}.desc{color:var(--muted);font-size:9px;line-height:1.55;min-height:28px;margin:8px 0}.links{display:flex;gap:5px;flex-wrap:wrap}.links a{font-size:9px;font-weight:850;color:#dce6f4;text-decoration:none;border:1px solid #303741;border-radius:7px;padding:6px 7px}.links a:hover{border-color:var(--lime);color:var(--lime)}.services{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.service{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:14px;min-height:150px}.service .name{font-weight:950;font-size:11px}.dot{display:inline-block;width:7px;height:7px;border-radius:99px;background:#555;margin-right:6px}.service.live .dot{background:var(--green)}.service b{display:block;font-size:29px;margin-top:13px}.service small{color:var(--muted);font-size:9px}.badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:12px}.badge{font:800 8px/1 ui-monospace,monospace;padding:5px 6px;border-radius:999px;border:1px solid #39414b;color:var(--muted)}.badge.ok{color:var(--green);border-color:#376749}.badge.warn{color:var(--amber);border-color:#66562f}.analyticslink{display:flex;justify-content:space-between;align-items:center;gap:20px;background:linear-gradient(120deg,#141821,#101218);border:1px solid #343b46;border-radius:14px;padding:18px}.analyticslink b{font-size:20px}.analyticslink p{margin:5px 0 0;color:var(--muted);font-size:10px;line-height:1.5}.analyticslink a{background:var(--lime);color:#08090a;text-decoration:none;font-weight:950;font-size:10px;padding:10px 12px;border-radius:9px;white-space:nowrap}.ops{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.health{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:13px}.healthtop{display:flex;justify-content:space-between;gap:7px}.healthname{font-weight:950;font-size:10px}.healthstatus{font:900 9px/1 ui-monospace,monospace}.health.ok .healthstatus{color:var(--green)}.health.bad .healthstatus{color:var(--red)}.health b{display:block;font-size:24px;margin-top:13px}.health small{color:var(--muted);font-size:9px}.todo{display:grid;gap:7px}.todoitem{display:grid;grid-template-columns:90px 1fr;gap:12px;border:1px solid var(--line);background:var(--panel2);border-radius:11px;padding:12px}.todoitem strong{font-size:9px;color:var(--amber);letter-spacing:.08em}.todoitem span{font-size:10px;color:var(--muted);line-height:1.55}.foot{margin-top:20px;border-top:1px solid var(--line);padding-top:14px;color:var(--muted);font-size:10px}@media(max-width:1100px){.kpis{grid-template-columns:repeat(3,1fr)}.pipeline{grid-template-columns:repeat(3,1fr)}.catalog{grid-template-columns:repeat(2,1fr)}.services{grid-template-columns:repeat(3,1fr)}.ops{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.top{align-items:flex-start;flex-direction:column}.actions{width:100%;justify-content:space-between}.hero{display:block}.hero p{margin-top:17px}.kpis{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr}.panel.wide{grid-column:auto}.pipeline,.catalog,.services,.ops{grid-template-columns:1fr}.wrap{padding:20px 14px 55px}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / CONTROL CENTER <small>Preview v0.1</small></div><div class="actions"><nav class="nav"><button data-view="system" class="active">SYSTEM</button><button data-view="analytics">ANALYTICS</button><button data-view="ops">OPS</button></nav><a class="linkbtn" href="https://harfway-vercel-hub.vercel.app/" target="_blank" rel="noreferrer">OLD HUB ↗</a></div></header>
<main class="wrap">
<section class="hero"><div><div class="ey">HARF-WAY OPERATING SYSTEM</div><h1>ONE<br>PLACE.</h1></div><div><p>素材・DB・制作ツール・公開サービス・計測・運用状態を1画面にまとめる管理センター。まずは「どこに何があるか」「数字は動いているか」「サービスは生きているか」を同時に確認できる状態にします。</p><div id="state" class="state">SYSTEM / ANALYTICS / OPS を読み込み中…</div></div></section>
<section class="kpis"><div class="kpi"><small>REGISTERED IN HUB</small><b id="hubCount">—</b><i>既存HUB登録数</i></div><div class="kpi"><small>CORE HEALTH</small><b id="healthCount">—</b><i>主要12サービス</i></div><div class="kpi"><small>GA4 COLLECTION</small><b id="gaCount">—</b><i>主要5サービス</i></div><div class="kpi"><small>GA4 REPORTING</small><b id="reportCount">—</b><i>Data API</i></div><div class="kpi"><small>NEXT BUILD</small><b style="font-size:22px">OPS</b><i>Rollback / Backup</i></div></section>

<section id="view-system" class="view active">
<div class="grid">
<section class="panel wide"><h2>SYSTEM PIPELINE</h2><div class="pipeline"><div class="step"><strong>01 INPUT</strong><b>素材を集める</b><span>R2動画・過去記事・切れ端・ゲーム情報・デザイン参考。</span></div><div class="step"><strong>02 CORE</strong><b>つなぐ</b><span>Shared Content Core / DBを中心に、素材と作品情報を共通化。</span></div><div class="step"><strong>03 EDIT</strong><b>再編集する</b><span>WAYS・Yorimichi・ZINE・Showcase・Playlistの各Editor。</span></div><div class="step"><strong>04 PUBLISH</strong><b>公開する</b><span>短尺フィード、ショーケース、プレイリストなど各公開体験へ。</span></div><div class="step"><strong>05 MEASURE</strong><b>測って戻す</b><span>Analytics Hub → 改善判断。OPSで稼働監視と復旧へ。</span></div></div></section>
<section class="panel wide"><h2>REGISTERED SYSTEMS / EXISTING HUB</h2><div id="catalog" class="catalog"><div class="state">既存HUB一覧を読み込み中…</div></div></section>
</div>
</section>

<section id="view-analytics" class="view">
<div class="grid">
<section class="panel wide"><h2>5 SERVICE ANALYTICS SNAPSHOT / LAST 7 DAYS</h2><div id="services" class="services"><div class="state">GA4を読み込み中…</div></div></section>
<section class="panel wide"><div class="analyticslink"><div><b>Analytics Hub v0.3</b><p>ゲーム別・ファネル・期間切替など、深い分析は既存Analytics画面をそのまま使います。</p></div><a href="/analytics" target="_blank">OPEN FULL ANALYTICS ↗</a></div></section>
</div>
</section>

<section id="view-ops" class="view">
<div class="grid">
<section class="panel wide"><h2>LIVE HEALTH CHECK / CORE 12</h2><div id="ops" class="ops"><div class="state">主要サービスを確認中…</div></div></section>
<section class="panel"><h2>OPS v0.1 — NOW</h2><div class="todo"><div class="todoitem"><strong>LIVE</strong><span>公開URLのHTTP疎通と応答時間を、この画面を開くたびに確認。</span></div><div class="todoitem"><strong>LIVE</strong><span>既存Vercel HUBの登録一覧を1画面に集約。</span></div><div class="todoitem"><strong>LIVE</strong><span>Analytics Hubの5サービス計測状況を同時表示。</span></div></div></section>
<section class="panel"><h2>OPS v0.2 — NEXT</h2><div class="todo"><div class="todoitem"><strong>NEXT</strong><span>最新Production deployment・commit・更新時刻の自動取得。</span></div><div class="todoitem"><strong>NEXT</strong><span>異常時のRollback候補と「最後に正常だったProduction」を表示。</span></div><div class="todoitem"><strong>NEXT</strong><span>DB / R2 / Backupの最終成功時刻と容量を一覧化。</span></div></div></section>
</div>
</section>
<div class="foot">Preview v0.1 — Productionは変更していません。SYSTEMは既存HUB一覧、ANALYTICSは現行GA4 Data API、OPSは主要サービスのHTTP health checkを利用します。</div>
</main>
<script is:inline>
const $=s=>document.querySelector(s),n=v=>Number(v||0).toLocaleString('ja-JP');
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
document.querySelectorAll('[data-view]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x===btn));document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));$('#view-'+btn.dataset.view).classList.add('active')}));
function itemCard(x){const links=[['PUBLIC',x.public_url],['ADMIN',x.admin_url],['METRICS',x.metrics_url]].filter(v=>v[1]);return `<article class="item"><div class="itemtop"><div class="itemname">${esc(x.name)}</div><span class="cat">${esc(x.category||'SYSTEM')}</span></div><div class="desc">${esc(x.description||x.project_slug||'')}</div><div class="links">${links.map(([l,u])=>`<a href="${esc(u)}" target="_blank" rel="noreferrer">${l} ↗</a>`).join('')||'<span class="badge warn">URL未登録</span>'}</div></article>`}
function healthCard(x){return `<article class="health ${x.ok?'ok':'bad'}"><div class="healthtop"><div class="healthname"><i class="dot" style="background:${x.ok?'var(--green)':'var(--red)'}"></i>${esc(x.name)}</div><div class="healthstatus">${x.ok?'UP':'DOWN'} / ${x.status||'ERR'}</div></div><b>${n(x.latencyMs)} ms</b><small>${esc(x.kind||'service')}</small></article>`}
function serviceCard(name,s){const collect=!!s?.collection?.enabled,report=!!s?.reportingConnected;let metric='—',label='';if(name==='WAYS'&&report){metric=n(s.summary?.gameViews);label='GAME VIEWS'}else if(name==='SHOWCASE'&&s?.deepReportingConnected){metric=n(s.summary?.gameViews);label='GAME VIEWS'}else if(report){metric=n(s.summary?.pageViews);label=`PV / USERS ${n(s.summary?.activeUsers)}`}return `<article class="service ${collect?'live':''}"><div class="name"><i class="dot"></i>${name}</div><b>${metric}</b><small>${label||'REPORTING WAIT'}</small><div class="badges"><span class="badge ${collect?'ok':'warn'}">${collect?'COLLECTION':'COLLECTION OFF'}</span><span class="badge ${report?'ok':'warn'}">${report?'REPORTING':'WAIT'}</span></div></article>`}
async function load(){let health=null,analytics=null;try{[health,analytics]=await Promise.all([fetch('/api/control-center-health').then(r=>r.json()),fetch('/api/harfway-analytics?days=7').then(r=>r.json())]);if(health?.ok){$('#hubCount').textContent=n(health.summary?.hubEntries);$('#healthCount').textContent=`${n(health.summary?.healthy)} / ${n(health.summary?.total)}`;$('#catalog').innerHTML=(health.hub?.items||[]).map(itemCard).join('')||'<div class="state bad">HUB一覧を取得できませんでした。</div>';$('#ops').innerHTML=(health.checks||[]).map(healthCard).join('')||'<div class="state bad">health checkを取得できませんでした。</div>'}if(analytics?.ok){const all=Object.values(analytics.services||{});$('#gaCount').textContent=`${all.filter(x=>x.collection?.enabled).length} / ${all.length}`;$('#reportCount').textContent=`${all.filter(x=>x.reportingConnected).length} / ${all.length}`;$('#services').innerHTML=['WAYS','SHOWCASE','PLAYLIST','YORIMICHI','ZINE'].map(name=>serviceCard(name,analytics.services?.[name.toLowerCase()])).join('')}$('#state').textContent=`更新 ${new Date().toLocaleTimeString('ja-JP')} / HUB・GA4・Health接続済み`;$('#state').className='state ok'}catch(e){$('#state').textContent='読み込みエラー: '+e.message;$('#state').className='state bad'}}
load();
</script>
</body>
</html>
