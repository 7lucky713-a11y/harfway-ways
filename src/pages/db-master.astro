---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>HARF-WAY DB MASTER</title>
  <style>
    :root{color-scheme:dark;--bg:#090909;--panel:#111113;--panel2:#171719;--panel3:#1d1d20;--line:#303034;--line2:#252528;--muted:#98989a;--accent:#efff3d;--danger:#ff818c;--warn:#ffc96b;--ok:#b9ff78;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f6f6f1;font-size:14px}button,input,textarea,select{font:inherit}button{cursor:pointer}.hide{display:none!important}.muted{color:var(--muted)}.tiny{font-size:11px}.btn{min-height:40px;border:1px solid var(--line);background:#19191c;color:#fff;border-radius:10px;padding:9px 14px;font-weight:800;white-space:nowrap}.btn:hover{border-color:#666;background:#202024}.btn.primary{background:var(--accent);color:#111;border-color:transparent}.btn.primary:hover{background:#f4ff6a}.btn.danger{color:#ffabb2;border-color:#6a343a;background:#211215}.btn:disabled{opacity:.42;cursor:not-allowed}
    .login{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 15%,#252528,#090909 55%)}.loginbox{width:min(460px,100%);padding:30px;border:1px solid var(--line);border-radius:22px;background:#101012}.eyebrow{font-size:10px;letter-spacing:.17em;color:var(--accent);font-weight:900}.login h1{font-size:46px;line-height:.9;margin:10px 0 18px}.field{display:grid;gap:7px}.field label{font-size:11px;font-weight:850;color:#c9c9c5}.field input,.field textarea,.field select{width:100%;border:1px solid #3a3a3e;border-radius:10px;background:#0b0b0d;color:#fff;padding:12px 13px;line-height:1.45}.field input:focus,.field textarea:focus,.field select:focus{outline:none;border-color:#7d7d60;box-shadow:0 0 0 3px #efff3d12}.field textarea{min-height:122px;resize:vertical}
    .top{position:sticky;top:0;z-index:30;border-bottom:1px solid #242427;background:#0b0b0df2;backdrop-filter:blur(12px)}.topmain{display:flex;align-items:center;gap:11px;min-height:68px;padding:12px 20px}.brandwrap{display:grid;gap:3px;margin-right:auto}.brand{font-size:17px;font-weight:950;white-space:nowrap}.brand b{color:var(--accent)}#connection{font-size:11px;color:var(--muted)}.topactions{display:flex;gap:8px;align-items:center}
    .page{max-width:1840px;margin:auto;padding:24px 24px 48px}.stats{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:12px;margin-bottom:18px}.stat{min-height:90px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(180deg,#141416,#101012);padding:15px 17px;display:flex;flex-direction:column;justify-content:space-between}.stat span{display:block;font-size:11px;color:var(--muted);font-weight:750}.stat b{display:block;font-size:29px;line-height:1;margin-top:9px}.stat.warn{border-color:#4c4332}.stat.warn b{color:var(--warn)}
    .controls{display:grid;grid-template-columns:auto minmax(260px,1fr) auto auto auto;gap:10px;align-items:center;margin:0 0 16px;padding:12px;border:1px solid var(--line);border-radius:15px;background:#101012}.controls input,.controls select{min-height:42px;border:1px solid var(--line);border-radius:10px;background:#171719;color:#fff;padding:10px 12px}.controls input{width:100%}.tabs{display:flex;gap:6px}.tab{min-height:42px;border:1px solid var(--line);background:#111;color:#bbb;border-radius:10px;padding:9px 15px;font-weight:850}.tab.on{background:var(--accent);color:#111;border-color:transparent}.count{font-size:11px;color:var(--muted);white-space:nowrap;padding:0 4px}
    .workspace{display:grid;grid-template-columns:minmax(620px,1.12fr) minmax(520px,.88fr);gap:16px;align-items:start}.tablewrap{border:1px solid var(--line);border-radius:15px;overflow:auto;background:var(--panel);max-height:calc(100vh - 250px)}table{width:100%;border-collapse:collapse;min-width:880px}th,td{padding:13px 12px;border-bottom:1px solid #28282b;text-align:left;vertical-align:middle;font-size:12px;line-height:1.45}th{position:sticky;top:0;background:#18181b;color:#aaa;font-size:10px;letter-spacing:.05em;z-index:2;height:45px}tbody tr{cursor:pointer;transition:.12s background}tbody tr:hover{background:#19191b}tbody tr.on{background:#252518;box-shadow:inset 3px 0 0 var(--accent)}.titlecell{font-weight:850;min-width:230px;font-size:13px}.titlecell .idline{margin-top:4px;font-size:10px;color:#737377;font-weight:500}.categorycell{max-width:250px;color:#c7c7c5}.pill{display:inline-block;padding:4px 8px;border-radius:999px;border:1px solid #414146;font-size:9px;font-weight:850}.published{color:#caff81;border-color:#3c5134;background:#131a10}.draft{color:#b1b1b4}.ok{color:var(--ok)}.bad{color:#ff9ca5}.health{display:flex;gap:5px}.health span{width:25px;height:25px;border-radius:7px;border:1px solid #343438;display:grid;place-items:center;font-size:9px;font-weight:900;color:#626267;background:#0d0d0f}.health span.on{color:var(--ok);border-color:#3c5134;background:#11190f}.health span.off{color:#8c8c90}.tagcount{display:inline-flex;min-width:28px;height:27px;align-items:center;justify-content:center;border-radius:8px;background:#19191c;border:1px solid #333;color:#ccc}.miss{display:flex;gap:5px;flex-wrap:wrap}.miss i{font-style:normal;font-size:9px;line-height:1;padding:5px 7px;border:1px solid #594836;border-radius:999px;color:#ffd08a;background:#211b13;white-space:nowrap}.miss .miss-critical{border-color:#633a3e;color:#ffadb4;background:#211416}.empty{padding:48px 25px;text-align:center;color:var(--muted)}
    .editor{border:1px solid var(--line);border-radius:15px;background:var(--panel);position:sticky;top:92px;max-height:calc(100vh - 112px);overflow:auto}.editorhead{position:sticky;top:0;z-index:3;padding:18px 20px 16px;border-bottom:1px solid #29292c;background:#121214f7;backdrop-filter:blur(10px)}.editorheadrow{display:flex;gap:12px;align-items:flex-start}.editorheadrow>div:first-child{min-width:0;flex:1}.editor h2{font-size:27px;line-height:1.1;margin:6px 0 10px}.editorbody{padding:16px;display:grid;gap:14px}.formsection{border:1px solid #2e2e32;border-radius:13px;background:#0f0f11;overflow:hidden}.sectionhead{display:flex;align-items:center;gap:8px;padding:11px 13px;border-bottom:1px solid #28282b;background:#151517}.sectionhead b{font-size:11px;letter-spacing:.04em}.sectionhead span{font-size:10px;color:#6f6f74;margin-left:auto}.sectionbody{padding:13px;display:grid;gap:12px}.g2{display:grid;grid-template-columns:1fr 1fr;gap:11px}.rowactions{display:flex;flex-wrap:wrap;gap:8px;padding-top:12px;border-top:1px solid #29292c}.readonly{opacity:.6}.note{padding:11px 12px;border:1px solid #39392a;background:#15150f;border-radius:10px;color:#c7c79d;font-size:10px;line-height:1.7}.editor-empty{display:grid;place-items:center;min-height:460px;padding:40px;text-align:center}.editor-empty b{display:block;font-size:18px;margin-bottom:7px}.editor-empty .btn{margin-top:15px}
    .showcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}.showcard{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:16px}.showcard h3{margin:6px 0 9px}.json{white-space:pre-wrap;word-break:break-word;font:10px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;color:#aaa;max-height:210px;overflow:auto;background:#0b0b0c;padding:10px;border-radius:9px}
    dialog{border:1px solid var(--line);border-radius:15px;background:#101012;color:#fff;width:min(820px,calc(100vw - 30px));max-height:85vh;padding:0}dialog::backdrop{background:#000c}.modalhead{display:flex;align-items:center;gap:8px;padding:13px 15px;border-bottom:1px solid var(--line)}.modalhead b{margin-right:auto}.modalbody{padding:15px;overflow:auto}.csvarea{width:100%;min-height:280px;background:#08080a;color:#fff;border:1px solid var(--line);border-radius:10px;padding:11px;font:11px/1.55 ui-monospace,monospace}
    .toast{position:fixed;z-index:80;bottom:22px;left:50%;transform:translateX(-50%);padding:9px 13px;border-radius:999px;background:#eee;color:#111;font-size:11px;font-weight:850;opacity:0;pointer-events:none;transition:.2s}.toast.on{opacity:1}
    @media(max-width:1450px){.workspace{grid-template-columns:minmax(560px,1fr) minmax(470px,.86fr)}.page{padding-left:18px;padding-right:18px}}
    @media(max-width:1180px){.stats{grid-template-columns:repeat(4,1fr)}.workspace{grid-template-columns:1fr}.editor{position:relative;top:auto;max-height:none}.tablewrap{max-height:62vh}.controls{grid-template-columns:auto minmax(240px,1fr) auto auto}.controls .count{grid-column:1/-1}.editor-empty{min-height:260px}}
    @media(max-width:760px){.topmain{align-items:flex-start;flex-wrap:wrap;padding:12px}.brandwrap{width:100%}.topactions{width:100%;overflow:auto}.page{padding:12px}.stats{grid-template-columns:repeat(2,1fr);gap:8px}.stat{min-height:78px}.controls{grid-template-columns:1fr;padding:9px}.tabs{width:100%}.tab{flex:1}.controls input,.controls select,.controls .btn{width:100%}.g2{grid-template-columns:1fr}.workspace{display:block}.editor{margin-top:12px}table{min-width:820px}}
  </style>
</head>
<body>
  <section id="login" class="login">
    <form id="loginForm" class="loginbox">
      <div class="eyebrow">HARF-WAY / PRIVATE DATABASE CONSOLE</div>
      <h1>DB<br>MASTER</h1>
      <p class="muted tiny">WAYSの既存管理APIを経由して中核DBをまとめて確認・編集します。Productionへの直接SQL書き込みは行いません。</p>
      <div class="field"><label>管理キー</label><input id="key" type="password" autocomplete="current-password" /></div>
      <p id="loginMsg" class="muted tiny"></p>
      <button class="btn primary" style="width:100%" type="submit">DB MASTERを開く</button>
    </form>
  </section>

  <div id="app" class="hide">
    <header class="top">
      <div class="topmain">
        <div class="brandwrap">
          <div class="brand">HARF-WAY <b>DB MASTER</b></div>
          <span id="connection">接続中…</span>
        </div>
        <div class="topactions">
          <button id="reload" class="btn">再読込</button>
          <button id="exportCsv" class="btn">CSV出力</button>
          <button id="importCsv" class="btn">CSV取込</button>
          <button id="saveAll" class="btn primary" disabled>変更を保存</button>
          <button id="logout" class="btn">ログアウト</button>
        </div>
      </div>
    </header>

    <main class="page">
      <section id="stats" class="stats"></section>
      <div class="controls">
        <div class="tabs"><button class="tab on" data-tab="games">作品</button><button class="tab" data-tab="showcases">ショーケース</button></div>
        <input id="search" placeholder="作品名 / ID / タグ / URLで検索" />
        <select id="statusFilter"><option value="all">すべての状態</option><option value="published">公開</option><option value="draft">下書き</option></select>
        <select id="missingFilter"><option value="all">不足項目：すべて</option><option value="any">不足あり</option><option value="store">ストアURLなし</option><option value="article">記事URLなし</option><option value="video">動画なし</option><option value="category">カテゴリなし</option></select>
        <button id="newGame" class="btn primary">＋ 新規作品</button>
        <span id="visibleCount" class="count"></span>
      </div>
      <section id="gamesView" class="workspace">
        <div id="gamesTable" class="tablewrap"></div>
        <aside id="editor" class="editor"><div class="editor-empty"><div><b>作品を選択してください</b><span class="muted tiny">一覧から作品を選ぶと、ここに編集画面が開きます。</span><br><button id="emptyNewGame" class="btn primary">＋ 新規作品を追加</button></div></div></aside>
      </section>
      <section id="showcasesView" class="hide"><div id="showcases" class="showcards"></div></section>
    </main>
  </div>

  <dialog id="csvDialog">
    <div class="modalhead"><b id="csvTitle">CSV</b><button id="csvClose" class="btn">閉じる</button></div>
    <div class="modalbody">
      <p id="csvHelp" class="muted tiny"></p>
      <textarea id="csvText" class="csvarea"></textarea>
      <div class="rowactions" style="margin-top:10px"><button id="csvDownload" class="btn primary">CSVをダウンロード</button><button id="csvApply" class="btn primary hide">プレビューへ反映</button></div>
      <p id="csvResult" class="tiny muted"></p>
    </div>
  </dialog>
  <div id="toast" class="toast"></div>

<script is:inline>
(() => {
  const KEY_NAME='hw-db-master-admin-key';
  const $=q=>document.querySelector(q);
  let key=sessionStorage.getItem(KEY_NAME)||'';
  let state={games:[],showcases:[]};
  let summary={};
  let selected=null;
  let dirty=false;
  let currentTab='games';

  const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
  function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove('on'),1800)}
  function setDirty(v=true){dirty=v;$('#saveAll').disabled=!dirty;$('#connection').textContent=dirty?'● 未保存の変更があります':'WAYS管理DB 接続済み'}
  function login(msg=''){ $('#login').classList.remove('hide');$('#app').classList.add('hide');$('#loginMsg').textContent=msg }
  function headers(){return {'x-showcase-admin-key':key}}
  async function api(options={}){
    const h={...headers(),...(options.body?{'content-type':'application/json'}:{}),...(options.headers||{})};
    const r=await fetch('/api/db-master',{cache:'no-store',...options,headers:h});
    let j={};try{j=await r.json()}catch{}
    if(r.status===401){sessionStorage.removeItem(KEY_NAME);key='';login(j.error||'管理キーが無効です');throw Error(j.error||'Unauthorized')}
    if(!r.ok)throw Error(j.error||`HTTP ${r.status}`);return j;
  }
  function norm(g,i){return {id:String(g.id||`game-${i}`),title:String(g.title||''),description:String(g.description||''),video:String(g.video||g.video_url||''),thumbnail:String(g.thumbnail||g.thumbnailUrl||g.thumbnail_url||''),tags:Array.isArray(g.tags)?g.tags.map(String):[],articleUrl:String(g.articleUrl||g.article_url||''),storeUrl:String(g.storeUrl||g.store_url||''),category:g.category==='通常'?'':String(g.category||''),status:g.status==='published'?'published':'draft',sponsored:!!g.sponsored,sponsorName:String(g.sponsorName||g.sponsor_name||''),sortOrder:Number.isFinite(Number(g.sortOrder??g.sort_order))?Number(g.sortOrder??g.sort_order):i,fastStart:!!(g.fastStart??g.fast_start),videoWidth:Number(g.videoWidth??g.video_width??0)||0,videoHeight:Number(g.videoHeight??g.video_height??0)||0,videoDuration:Number(g.videoDuration??g.video_duration??0)||0,videoOrientation:String(g.videoOrientation||g.video_orientation||''),videoLayoutMode:String(g.videoLayoutMode||g.video_layout_mode||'auto')}}
  function calcSummary(){const g=state.games||[];return {games:g.length,published:g.filter(x=>x.status==='published').length,draft:g.filter(x=>x.status!=='published').length,showcases:(state.showcases||[]).length,missingStore:g.filter(x=>!x.storeUrl).length,missingVideo:g.filter(x=>!x.video).length,missingArticle:g.filter(x=>!x.articleUrl).length,missingCategory:g.filter(x=>!x.category).length}}
  function renderStats(){summary=calcSummary();const items=[['作品',summary.games],['公開',summary.published],['下書き',summary.draft],['ショーケース',summary.showcases],['ストアURLなし',summary.missingStore,'warn'],['記事URLなし',summary.missingArticle,'warn'],['動画なし',summary.missingVideo,'warn'],['カテゴリなし',summary.missingCategory,'warn']];$('#stats').innerHTML=items.map(x=>`<div class="stat ${x[2]||''}"><span>${esc(x[0])}</span><b>${Number(x[1]||0)}</b></div>`).join('')}
  const MISS_LABEL={store:'Storeなし',article:'記事なし',video:'動画なし',category:'カテゴリなし'};
  function misses(g){const a=[];if(!g.storeUrl)a.push('store');if(!g.articleUrl)a.push('article');if(!g.video)a.push('video');if(!g.category)a.push('category');return a}
  function missChips(g){const ms=misses(g);return ms.map(x=>`<i class="${x==='video'?'miss-critical':''}">${MISS_LABEL[x]}</i>`).join('')||'<span class="ok tiny">OK</span>'}
  function filtered(){const q=$('#search').value.trim().toLowerCase(),s=$('#statusFilter').value,m=$('#missingFilter').value;return state.games.filter(g=>{if(s!=='all'&&g.status!==s)return false;const ms=misses(g);if(m==='any'&&!ms.length)return false;if(!['all','any'].includes(m)&&!ms.includes(m))return false;if(!q)return true;return [g.id,g.title,g.category,g.storeUrl,g.articleUrl,g.video,...g.tags].join(' ').toLowerCase().includes(q)})}
  function health(g){return `<div class="health" aria-label="導線"><span class="${g.storeUrl?'on':'off'}" title="Store">S</span><span class="${g.articleUrl?'on':'off'}" title="記事">A</span><span class="${g.video?'on':'off'}" title="動画">V</span></div>`}
  function renderTable(){const list=filtered();$('#visibleCount').textContent=`表示 ${list.length} / 全 ${state.games.length}作品`;if(!list.length){$('#gamesTable').innerHTML='<div class="empty">条件に一致する作品はありません。</div>';return}$('#gamesTable').innerHTML=`<table><thead><tr><th>状態</th><th>作品</th><th>カテゴリ</th><th>導線</th><th>タグ</th><th>不足</th><th>順番</th></tr></thead><tbody>${list.map(g=>`<tr data-id="${esc(g.id)}" class="${selected===g.id?'on':''}"><td><span class="pill ${g.status}">${g.status==='published'?'公開':'下書き'}</span></td><td class="titlecell">${esc(g.title||'名称未設定')}<div class="idline">${esc(g.id)}</div></td><td class="categorycell">${esc(g.category||'—')}</td><td>${health(g)}</td><td><span class="tagcount">${g.tags.length}</span></td><td><div class="miss">${missChips(g)}</div></td><td>${g.sortOrder}</td></tr>`).join('')}</tbody></table>`;$('#gamesTable').querySelectorAll('tr[data-id]').forEach(r=>r.onclick=()=>{selected=r.dataset.id;renderTable();renderEditor()})}
  function field(k,label,v,type='input',extra=''){if(type==='textarea')return `<div class="field"><label>${label}</label><textarea data-k="${k}" ${extra}>${esc(v)}</textarea></div>`;return `<div class="field"><label>${label}</label><input data-k="${k}" value="${esc(v)}" ${extra}></div>`}
  function section(title,hint,body){return `<section class="formsection"><div class="sectionhead"><b>${title}</b>${hint?`<span>${hint}</span>`:''}</div><div class="sectionbody">${body}</div></section>`}
  function emptyEditor(){return `<div class="editor-empty"><div><b>作品を選択してください</b><span class="muted tiny">一覧から作品を選ぶと、ここに編集画面が開きます。</span><br><button id="emptyNewGame" class="btn primary">＋ 新規作品を追加</button></div></div>`}
  function renderEditor(){const g=state.games.find(x=>x.id===selected);if(!g){$('#editor').innerHTML=emptyEditor();$('#emptyNewGame')?.addEventListener('click',newGame);return}
    const basic=field('id','ID',g.id,'input','disabled class="readonly"')+`<div class="g2">${field('title','作品名',g.title)}<div class="field"><label>状態</label><select data-k="status"><option value="draft" ${g.status!=='published'?'selected':''}>下書き</option><option value="published" ${g.status==='published'?'selected':''}>公開</option></select></div></div>`+field('description','紹介文',g.description,'textarea');
    const links=field('storeUrl','ストアURL',g.storeUrl)+field('articleUrl','記事URL',g.articleUrl);
    const classify=field('category','カテゴリ',g.category)+field('tags','タグ（カンマ区切り）',g.tags.join(', '));
    const media=field('video','動画URL',g.video)+field('thumbnail','サムネイルURL',g.thumbnail);
    const misc=`<div class="g2">${field('sortOrder','並び順',g.sortOrder,'input','type="number"')}<div class="field"><label>スポンサード</label><select data-k="sponsored"><option value="false" ${!g.sponsored?'selected':''}>通常</option><option value="true" ${g.sponsored?'selected':''}>SPONSORED</option></select></div></div>${field('sponsorName','スポンサー名',g.sponsorName)}`;
    $('#editor').innerHTML=`<div class="editorhead"><div class="editorheadrow"><div><div class="eyebrow">${g.status==='published'?'PUBLISHED':'DRAFT'} / ${esc(g.id)}</div><h2>${esc(g.title||'名称未設定')}</h2><div class="miss">${missChips(g)}</div></div></div></div><div class="editorbody"><div class="note">横断管理に必要な情報だけをここで編集します。動画アップロードやR2処理は従来のWAYS EDITORを利用してください。</div>${section('基本情報','名前・公開状態・説明',basic)}${section('導線','外部ページ',links)}${section('分類','カテゴリ・タグ',classify)}${section('メディア','URLのみ編集',media)}${section('運用設定','並び順・広告',misc)}<div class="rowactions"><button id="duplicate" class="btn">複製</button><button id="deleteRow" class="btn danger">DBから削除</button></div></div>`;
    $('#editor').querySelectorAll('[data-k]').forEach(el=>el.addEventListener(el.tagName==='SELECT'?'change':'input',()=>{const k=el.dataset.k;if(k==='tags')g[k]=el.value.split(',').map(x=>x.trim()).filter(Boolean);else if(k==='sortOrder')g[k]=Number(el.value)||0;else if(k==='sponsored')g[k]=el.value==='true';else g[k]=el.value;setDirty();renderStats();renderTable();if(k==='title')$('#editor h2').textContent=g.title||'名称未設定';if(['storeUrl','articleUrl','video','category'].includes(k))$('#editor .miss').innerHTML=missChips(g)}));
    $('#duplicate').onclick=()=>{const copy=JSON.parse(JSON.stringify(g));copy.id='game-'+Date.now();copy.title=(copy.title||'作品')+' コピー';copy.status='draft';copy.sortOrder=Math.max(0,...state.games.map(x=>Number(x.sortOrder)||0))+1;state.games.unshift(copy);selected=copy.id;setDirty();renderAll();toast('複製しました（未保存）')};
    $('#deleteRow').onclick=()=>{if(!confirm(`「${g.title||g.id}」を管理DBから削除しますか？\n保存するまでは本番側に反映されません。`))return;state.games=state.games.filter(x=>x.id!==g.id);selected=state.games[0]?.id||null;setDirty();renderAll()};
  }
  function newGame(){const next=Math.max(0,...state.games.map(x=>Number(x.sortOrder)||0))+1;const g=norm({id:'game-'+Date.now(),title:'',status:'draft',sortOrder:next},state.games.length);state.games.unshift(g);selected=g.id;setDirty();renderAll();toast('新規作品を追加しました（未保存）');setTimeout(()=>$('#editor [data-k="title"]')?.focus(),50)}
  function renderShowcases(){const a=state.showcases||[];$('#showcases').innerHTML=a.length?a.map((s,i)=>`<article class="showcard"><div class="eyebrow">SHOWCASE ${i+1}</div><h3>${esc(s.title||s.name||s.id||'名称未設定')}</h3><p class="muted tiny">ID: ${esc(s.id||'—')} / status: ${esc(s.status||'—')}</p><div class="json">${esc(JSON.stringify(s,null,2))}</div></article>`).join(''):'<div class="empty">ショーケースデータはありません。</div>'}
  function renderAll(){renderStats();renderTable();renderEditor();renderShowcases()}
  async function load(){try{$('#connection').textContent='WAYS管理DB 読込中…';const j=await api();state=j.state||{games:[],showcases:[]};state.games=(state.games||[]).map(norm);state.showcases=Array.isArray(state.showcases)?state.showcases:[];summary=j.summary||{};if(selected&&!state.games.some(x=>x.id===selected))selected=null;dirty=false;$('#saveAll').disabled=true;renderAll();$('#connection').textContent=`WAYS管理DB 接続済み / ${state.games.length}作品`}catch(e){$('#connection').textContent='読込エラー: '+e.message}}
  async function save(){if(!dirty)return;try{$('#saveAll').disabled=true;$('#connection').textContent='保存中…';const j=await api({method:'POST',body:JSON.stringify({state})});summary=j.summary||calcSummary();dirty=false;renderAll();$('#connection').textContent='WAYS管理DB 保存済み';toast('DBを保存しました')}catch(e){$('#saveAll').disabled=false;$('#connection').textContent='保存エラー: '+e.message;alert('保存できませんでした: '+e.message)}}
  function csvEscape(v){const s=String(v??'');return /[",\n\r]/.test(s)?`"${s.replace(/"/g,'""')}"`:s}
  const CSV_FIELDS=['id','title','description','category','tags','storeUrl','articleUrl','video','thumbnail','status','sponsored','sponsorName','sortOrder'];
  function toCsv(){const rows=[CSV_FIELDS.join(',')];for(const g of state.games){rows.push(CSV_FIELDS.map(k=>csvEscape(k==='tags'?g.tags.join('|'):g[k])).join(','))}return rows.join('\r\n')}
  function parseCsv(text){const rows=[];let row=[],cell='',quoted=false;for(let i=0;i<text.length;i++){const c=text[i],n=text[i+1];if(c==='"'){if(quoted&&n==='"'){cell+='"';i++}else quoted=!quoted}else if(c===','&&!quoted){row.push(cell);cell=''}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&n==='\n')i++;row.push(cell);cell='';if(row.some(x=>x!==''))rows.push(row);row=[]}else cell+=c}row.push(cell);if(row.some(x=>x!==''))rows.push(row);return rows}
  function applyCsv(text){const rows=parseCsv(text);if(rows.length<2)throw Error('データ行がありません');const head=rows[0].map(x=>x.trim());if(!head.includes('id'))throw Error('id列が必要です');const byId=new Map(state.games.map(g=>[g.id,g]));let updated=0,added=0;for(const r of rows.slice(1)){const o={};head.forEach((h,i)=>o[h]=r[i]??'');if(!o.id)continue;let g=byId.get(o.id);if(!g){g=norm({id:o.id},state.games.length);state.games.push(g);byId.set(o.id,g);added++}else updated++;for(const k of CSV_FIELDS){if(k==='id'||!(k in o))continue;if(k==='tags')g.tags=String(o[k]).split('|').map(x=>x.trim()).filter(Boolean);else if(k==='sponsored')g.sponsored=['true','1','yes'].includes(String(o[k]).toLowerCase());else if(k==='sortOrder')g.sortOrder=Number(o[k])||0;else g[k]=o[k]}}setDirty();renderAll();return {updated,added}}
  function showCsv(mode){const d=$('#csvDialog');$('#csvResult').textContent='';if(mode==='export'){$('#csvTitle').textContent='CSV EXPORT';$('#csvHelp').textContent='現在読み込んでいる作品データを書き出します。';$('#csvText').value=toCsv();$('#csvDownload').classList.remove('hide');$('#csvApply').classList.add('hide')}else{$('#csvTitle').textContent='CSV IMPORT';$('#csvHelp').textContent='idで既存作品を照合します。「プレビューへ反映」しただけでは管理DBへ保存されません。';$('#csvText').value='';$('#csvDownload').classList.add('hide');$('#csvApply').classList.remove('hide')}d.showModal()}
  function downloadCsv(){const b=new Blob(['\ufeff'+$('#csvText').value],{type:'text/csv;charset=utf-8'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=`harfway-db-${new Date().toISOString().slice(0,10)}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(u),500)}
  function switchTab(t){currentTab=t;document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.tab===t));$('#gamesView').classList.toggle('hide',t!=='games');$('#showcasesView').classList.toggle('hide',t!=='showcases');$('#search').disabled=t!=='games';$('#statusFilter').disabled=t!=='games';$('#missingFilter').disabled=t!=='games';$('#newGame').disabled=t!=='games';$('#visibleCount').classList.toggle('hide',t!=='games')}

  $('#loginForm').onsubmit=async e=>{e.preventDefault();const k=$('#key').value.trim();if(!k)return;key=k;try{await api();sessionStorage.setItem(KEY_NAME,key);$('#login').classList.add('hide');$('#app').classList.remove('hide');load()}catch(e){login(e.message)}};
  $('#logout').onclick=()=>{sessionStorage.removeItem(KEY_NAME);location.reload()};
  $('#reload').onclick=()=>{if(dirty&&!confirm('未保存の変更を破棄して再読込しますか？'))return;selected=null;load()};
  $('#saveAll').onclick=save;
  $('#newGame').onclick=newGame;
  $('#search').oninput=renderTable;$('#statusFilter').onchange=renderTable;$('#missingFilter').onchange=renderTable;
  document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));
  $('#exportCsv').onclick=()=>showCsv('export');$('#importCsv').onclick=()=>showCsv('import');$('#csvClose').onclick=()=>$('#csvDialog').close();$('#csvDownload').onclick=downloadCsv;$('#csvApply').onclick=()=>{try{const r=applyCsv($('#csvText').value);$('#csvResult').textContent=`既存 ${r.updated}件を更新候補、新規 ${r.added}件を追加候補として読み込みました。まだDBには保存されていません。`;toast('CSVをプレビューへ反映しました')}catch(e){$('#csvResult').textContent='エラー: '+e.message}};
  window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue=''}});
  (async()=>{if(!key)return login();try{await api();$('#login').classList.add('hide');$('#app').classList.remove('hide');load()}catch{login('管理キーを入力してください。')}})();
})();
</script>
</body>
</html>
