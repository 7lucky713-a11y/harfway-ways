---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY DB MASTER v2</title><link rel="stylesheet" href="/db-master-v2.css">
</head>
<body>
<section id="login" class="login"><form id="loginForm" class="loginbox"><div class="eyebrow">HARF-WAY / PRIVATE DATABASE CONSOLE</div><h1>DB<br>MASTER <small style="font-size:15px;color:#98989a">v2</small></h1><p class="muted tiny">WAYS・プレイリスト・切れ端・記事サルベージを横断して確認します。WAYS編集に加え、Core Game IDへの紐づけを管理できます。</p><div class="field"><label>管理キー</label><input id="key" type="password" autocomplete="current-password"></div><p id="loginMsg" class="muted tiny"></p><button class="btn primary" style="width:100%" type="submit">DB MASTERを開く</button></form></section>
<div id="app" class="hide">
<header class="top"><div class="topmain"><div class="brandwrap"><div class="brand">HARF-WAY <b>DB MASTER v2</b></div><span id="connection">接続中…</span></div><div class="topactions"><button id="reload" class="btn">再読込</button><button id="exportCsv" class="btn">WAYS CSV出力</button><button id="importCsv" class="btn">WAYS CSV取込</button><button id="saveAll" class="btn primary" disabled>WAYS変更を保存</button><button id="logout" class="btn">ログアウト</button></div></div></header>
<main class="page">
<section id="stats" class="stats"></section>
<div class="controls"><div class="tabs"><button class="tab on" data-tab="games">作品</button><button class="tab" data-tab="playlists">プレイリスト</button><button class="tab" data-tab="scraps">切れ端</button><button class="tab" data-tab="articles">記事</button><button class="tab" data-tab="showcases">ショーケース</button></div><input id="search" placeholder="現在のタブを検索"><select id="statusFilter"><option value="all">すべての状態</option><option value="published">公開</option><option value="draft">下書き</option></select><select id="missingFilter"><option value="all">不足項目：すべて</option><option value="any">不足あり</option><option value="store">ストアURLなし</option><option value="article">記事URLなし</option><option value="video">動画なし</option><option value="category">カテゴリなし</option></select><button id="newGame" class="btn primary">＋ 新規作品</button><span id="visibleCount" class="count"></span></div>
<section id="gamesView" class="workspace"><div id="gamesTable" class="tablewrap"></div><aside id="editor" class="editor"><div class="editor-empty"><div><b>作品を選択してください</b><span class="muted tiny">編集欄とHARF-WAY内の関連コンテンツが表示されます。</span></div></div></aside></section>
<section id="playlistsView" class="hide"><p class="readnote">Shared Content Core の playlist 参照を表示しています。ここでは読み取り専用です。</p><div id="playlists" class="cards"></div></section>
<section id="scrapsView" class="hide"><p class="readnote">GAME SCRAPBOOK / 切れ端の公開APIを表示しています。Core作品との紐付けはSteam App IDを優先して自動判定します。</p><div id="scraps" class="tablewrap"></div></section>
<section id="articlesView" class="hide"><p class="readnote">記事サルベージの Core / Preview DB を読み取り専用で表示します。Preview側の同URL記事があればそちらを優先します。</p><div id="articles" class="tablewrap"></div></section>
<section id="showcasesView" class="hide"><div id="showcases" class="cards"></div></section>
</main></div>
<dialog id="csvDialog"><div class="modalhead"><b id="csvTitle">CSV</b><button id="csvClose" class="btn">閉じる</button></div><div class="modalbody"><p id="csvHelp" class="muted tiny"></p><textarea id="csvText" class="csvarea"></textarea><div class="rowactions" style="margin-top:10px"><button id="csvDownload" class="btn primary">CSVをダウンロード</button><button id="csvApply" class="btn primary hide">プレビューへ反映</button></div><p id="csvResult" class="tiny muted"></p></div></dialog><div id="toast" class="toast"></div>
<script is:inline src="/db-master-v2.js"></script>
<script is:inline src="/db-master-core-link.js"></script>
</body></html>
