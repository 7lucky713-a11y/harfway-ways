---
---
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Publication Editor v2 / HARF-WAY Publications</title>
<style is:global>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0e1116;color:#eef1f5;--accent:#8f3131}*{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}.wrap{width:min(1180px,calc(100% - 28px));margin:auto}.topbar{position:sticky;top:0;z-index:10;background:rgba(14,17,22,.94);backdrop-filter:blur(12px);border-bottom:1px solid #262d38}.topbar .wrap{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px}.brand{display:flex;align-items:center;gap:12px}.mark{width:11px;height:36px;border-radius:8px;background:var(--accent)}.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8792a3}.pubname{font-weight:800;font-size:18px}.account{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.role,.storage{padding:7px 10px;border:1px solid #374153;border-radius:999px;color:#b9c3d2;font-size:11px;letter-spacing:.05em}.storage{border-color:#355848;color:#9ed7b1}.logout{border:0;background:#202733;color:#e6ebf3;padding:8px 10px;border-radius:9px;cursor:pointer}.shell{display:grid;grid-template-columns:220px minmax(0,1fr);gap:22px;padding:26px 0 70px}.nav{position:sticky;top:96px;height:max-content;display:grid;gap:6px}.nav button{border:0;background:transparent;color:#9ea9b8;text-align:left;padding:11px 12px;border-radius:10px;cursor:pointer}.nav button.active{background:#1b2230;color:#fff}.nav .boundary{margin-top:16px;padding:12px;border:1px solid #293240;border-radius:12px;color:#8792a3;font-size:12px;line-height:1.6}.main{min-width:0}.pagehead{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:18px}.pagehead h1{font-size:clamp(28px,4vw,46px);margin:3px 0}.lead{color:#9ea9b8;line-height:1.7;max-width:760px}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn,button.primary{border:0;background:#6578ff;color:#fff;padding:10px 14px;border-radius:10px;font-weight:800;cursor:pointer;text-decoration:none}.ghost{background:#202733!important;color:#e6ebf3!important}.panel{background:#151a22;border:1px solid #28313f;border-radius:16px;padding:18px;margin-bottom:16px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{background:#10151c;border:1px solid #27303d;border-radius:13px;padding:16px}.stat strong{display:block;font-size:28px;margin-top:4px}.muted{color:#8994a3;font-size:12px}.section{display:none}.section.active{display:block}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:grid;gap:6px;color:#aab3c0;font-size:12px}input,textarea,select{width:100%;background:#0e131a;color:#f3f6fa;border:1px solid #303a49;border-radius:9px;padding:10px}textarea{min-height:92px;resize:vertical}.full{grid-column:1/-1}.rows{display:grid;gap:10px}.content-row{background:#10151c;border:1px solid #293240;border-radius:12px;padding:12px}.content-top{display:grid;grid-template-columns:1fr 140px auto;gap:8px}.content-row textarea{margin-top:8px}.small{padding:8px 10px!important}.danger{background:#633a45!important}.shelf-row{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:8px}.preview-card{padding:20px;border-radius:16px;background:var(--preview-bg,#f5efe4);color:#201d1a;border:5px solid var(--accent)}.preview-card h2{font-family:Georgia,"Times New Roman",serif;font-size:34px;margin:8px 0}.notice{padding:13px 15px;border-left:3px solid #6e86ff;background:#151c2b;color:#bcc8df;font-size:13px;line-height:1.7}.notice.ok{border-left-color:#5baf78}.status{min-height:22px;margin-top:10px;color:#91d7a5;font-size:13px}.locked{opacity:.62}.locked input{cursor:not-allowed}.loading{min-height:60vh;display:grid;place-items:center;color:#9ea9b8}@media(max-width:850px){.shell{grid-template-columns:1fr}.nav{position:static;display:flex;overflow:auto}.nav .boundary{display:none}.stats{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:1fr}.full{grid-column:auto}.content-top{grid-template-columns:1fr}.pagehead{display:block}.actions{margin-top:12px}.account .role{display:none}}
</style>
</head>
<body>
<div id="loading" class="loading">権限を確認しています…</div>
<div id="app" hidden>
<div class="topbar"><div class="wrap"><div class="brand"><span class="mark"></span><div><div class="eyebrow">HARF-WAY Publications</div><div id="pubName" class="pubname">読み込み中...</div></div></div><div class="account"><span id="storageBadge" class="storage">STORAGE</span><span id="accountEmail" class="role"></span><button id="logout" class="logout">ログアウト</button></div></div></div>
<div class="wrap shell">
<nav class="nav">
<button class="active" data-tab="dashboard">ダッシュボード</button>
<button data-tab="contents">記事・メモ</button>
<button data-tab="shelves">棚</button>
<button data-tab="design">トップ・デザイン</button>
<button data-tab="settings">媒体設定</button>
<div class="boundary"><strong>実権限境界 v0.2</strong><br/>この画面はURLのslugを使いません。ログインセッションの <strong>publication_id</strong> から編集対象を決定します。</div>
</nav>
<main class="main">
<div class="pagehead"><div><div class="eyebrow">Publication workspace / scoped session</div><h1 id="pageTitle">編集長CMS</h1><p class="lead">自分の媒体だけを直接運用。別媒体のslugをURLへ付けても編集対象は変わりません。</p></div><div class="actions"><button class="primary" id="saveAll">保存</button><a id="openPreview" class="btn ghost" target="_blank">公開Preview</a></div></div>
<section id="dashboard" class="section active">
<div class="stats"><div class="stat"><span class="muted">コンテンツ</span><strong id="statContents">0</strong></div><div class="stat"><span class="muted">棚</span><strong id="statShelves">0</strong></div><div class="stat"><span class="muted">公開状態</span><strong style="font-size:20px">ACTIVE</strong></div><div class="stat"><span class="muted">権限</span><strong id="statRole" style="font-size:18px">編集長</strong></div></div>
<div class="panel" style="margin-top:16px"><div class="eyebrow">Security boundary</div><h2 style="margin:8px 0">媒体はサーバー側で固定</h2><p class="lead">ログインしたユーザーに割り当てられたpublication_idだけをAPIが読み書きします。ブラウザから別publication_idを送っても採用しない設計です。</p></div>
<div id="storageNotice" class="notice"></div>
</section>
<section id="contents" class="section"><div class="panel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><div><div class="eyebrow">Contents</div><h2>記事・メモ</h2></div><button class="primary" id="addContent">＋ 追加</button></div><div id="contentRows" class="rows"></div></div></section>
<section id="shelves" class="section"><div class="panel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><div><div class="eyebrow">Curation</div><h2>棚</h2></div><button class="primary" id="addShelf">＋ 棚を追加</button></div><p class="lead">編集長のゲームの探し方・分類の仕方を、そのまま媒体の入口にします。</p><div id="shelfRows"></div></div></section>
<section id="design" class="section"><div class="panel"><div class="eyebrow">Editorial surface</div><h2>トップ・デザイン</h2><div class="form-grid"><label class="full">タグライン<input id="tagline" /></label><label>テーマ<select id="theme"><option value="editorial">ミニコミ誌</option><option value="shelf">ショップ棚</option><option value="archive">個人アーカイブ</option></select></label><label>アクセント色<input id="accent" /></label><label>背景色<input id="bg" /></label><label class="full">媒体説明<textarea id="description"></textarea></label></div></div><div id="visualPreview" class="preview-card"><div class="eyebrow">LIVE DESIGN SAMPLE</div><h2 id="previewTitle">媒体名</h2><div id="previewTagline"></div></div></section>
<section id="settings" class="section"><div class="panel"><div class="eyebrow">Publication settings</div><h2>媒体設定</h2><div class="form-grid"><label class="full">媒体名<input id="title" /></label><label>編集長表示名<input id="editor" /></label><label class="locked">slug（HARF-WAY管理）<input id="slug" readonly /></label><label class="locked">publication_id（サーバー割当）<input id="publicationId" readonly /></label></div><div class="notice" style="margin-top:16px">媒体削除、slug変更、権限付与、広告全体設定、共通DB操作はHARF-WAY管理者だけが行います。</div></div></section>
<div id="status" class="status"></div>
</main></div></div>
<script>
const q=id=>document.getElementById(id);let p=null;let auth=null;let apiState=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function localKey(){return `harfway_publication_fixture_${auth?.user?.publicationId||'unknown'}`}
function contentRow(a={id:'',title:'',type:'memo',note:''}){const el=document.createElement('div');el.className='content-row';el.dataset.id=a.id||crypto.randomUUID();el.innerHTML=`<div class="content-top"><input class="c-title" placeholder="タイトル" value="${esc(a.title)}"><select class="c-type"><option value="pick">PICK</option><option value="feature">FEATURE</option><option value="memo">MEMO</option><option value="article">ARTICLE</option></select><button type="button" class="ghost small danger remove">削除</button></div><textarea class="c-note" placeholder="本文・短い説明">${esc(a.note)}</textarea>`;el.querySelector('.c-type').value=a.type||'memo';el.querySelector('.remove').onclick=()=>{el.remove();refreshStats()};return el}
function shelfRow(value=''){const el=document.createElement('div');el.className='shelf-row';el.innerHTML=`<input class="shelf-input" value="${esc(value)}" placeholder="例：500円以下"><button type="button" class="ghost small remove">削除</button>`;el.querySelector('.remove').onclick=()=>{el.remove();refreshStats()};return el}
function refreshStats(){q('statContents').textContent=document.querySelectorAll('.content-row').length;q('statShelves').textContent=document.querySelectorAll('.shelf-row').length}
function refreshDesign(){document.documentElement.style.setProperty('--accent',q('accent').value||'#8f3131');q('visualPreview').style.setProperty('--preview-bg',q('bg').value||'#f5efe4');q('previewTitle').textContent=q('title').value||p?.title||'';q('previewTagline').textContent=q('tagline').value||''}
function render(){document.documentElement.style.setProperty('--accent',p.accent||'#8f3131');q('pubName').textContent=p.title;q('pageTitle').textContent=p.title+' / 編集長CMS';q('title').value=p.title||'';q('editor').value=p.editor||'';q('slug').value=p.slug||'';q('publicationId').value=p.id||auth.user.publicationId||'';q('tagline').value=p.tagline||'';q('theme').value=p.theme||'editorial';q('accent').value=p.accent||'#8f3131';q('bg').value=p.bg||'#f5efe4';q('description').value=p.description||'';q('contentRows').innerHTML='';(p.articles||[]).forEach(a=>q('contentRows').appendChild(contentRow(a)));q('shelfRows').innerHTML='';(p.shelves||[]).forEach(s=>q('shelfRows').appendChild(shelfRow(s)));q('openPreview').href='/publications-live-v2?slug='+encodeURIComponent(p.slug);q('accountEmail').textContent=auth.user.email;q('statRole').textContent=auth.user.role==='editor_in_chief'?'編集長':auth.user.role;q('storageBadge').textContent=(apiState?.storage||auth.storage||'').toUpperCase();const fixture=(apiState?.storage||'').includes('fixture');q('storageNotice').classList.toggle('ok',!fixture);q('storageNotice').innerHTML=fixture?'現在は <strong>Preview Fixture</strong>。ログインとpublication_id境界はサーバー側で動作し、編集内容だけブラウザ保存です。Neon専用URLが設定されるまでDB書込は0です。':'<strong>Neon永続化モード</strong>。保存は割り当てpublication_idへサーバー経由で反映されます。';refreshStats();refreshDesign()}
function collect(){return {title:q('title').value.trim(),editor:q('editor').value.trim(),tagline:q('tagline').value.trim(),theme:q('theme').value,accent:q('accent').value.trim(),bg:q('bg').value.trim(),description:q('description').value.trim(),shelves:[...document.querySelectorAll('.shelf-input')].map(x=>x.value.trim()).filter(Boolean),articles:[...document.querySelectorAll('.content-row')].map(el=>({id:el.dataset.id,title:el.querySelector('.c-title').value.trim(),type:el.querySelector('.c-type').value,note:el.querySelector('.c-note').value.trim()})).filter(x=>x.title)}}
async function save(){q('status').textContent='保存中…';const payload=collect();try{const r=await fetch('/api/publications-content',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const d=await r.json();if(r.status===401){location.replace('/publications-login?returnTo='+encodeURIComponent(location.pathname));return}if(!r.ok||!d.ok){q('status').textContent='保存できません: '+(d.error||r.status);return}p=d.publication;if(d.persisted===false){localStorage.setItem(localKey(),JSON.stringify(p));q('status').textContent='Preview保存しました（ブラウザ保存 / DB書込なし）。'}else{localStorage.removeItem(localKey());q('status').textContent='Neonへ保存しました。'}apiState=d;render()}catch{q('status').textContent='保存通信に失敗しました。'}}
async function boot(){try{const ar=await fetch('/api/publications-auth',{cache:'no-store'});const ad=await ar.json();if(!ar.ok||!ad.ok){location.replace('/publications-login?returnTo='+encodeURIComponent(location.pathname));return}auth=ad;const cr=await fetch('/api/publications-content',{cache:'no-store'});const cd=await cr.json();if(!cr.ok||!cd.ok)throw new Error(cd.error||'content_load_failed');apiState=cd;p=cd.publication;if((cd.storage||'').includes('fixture')){try{const local=JSON.parse(localStorage.getItem(localKey())||'null');if(local&&local.id===auth.user.publicationId)p=local}catch{}}q('loading').hidden=true;q('app').hidden=false;render()}catch(e){q('loading').textContent='読み込みに失敗しました: '+(e.message||e)}}
document.querySelectorAll('.nav button[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));b.classList.add('active');q(b.dataset.tab).classList.add('active')});q('addContent').onclick=()=>{q('contentRows').appendChild(contentRow());refreshStats()};q('addShelf').onclick=()=>{q('shelfRows').appendChild(shelfRow());refreshStats()};q('saveAll').onclick=save;q('logout').onclick=async()=>{await fetch('/api/publications-auth',{method:'DELETE'}).catch(()=>{});location.replace('/publications-login')};['title','tagline','accent','bg'].forEach(id=>q(id).addEventListener('input',refreshDesign));boot();
</script>
</body>
</html>