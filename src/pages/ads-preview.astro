---
const title = 'HARF-WAY ADS｜掲載プレビュー';
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <style is:global>
      :root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0a0b0d;color:#f5f5ef}
      *{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 75% 0,#202517 0,transparent 30%),#0a0b0d;color:#f5f5ef}button{font:inherit}
      .page{min-height:100vh}.top{position:sticky;top:0;z-index:30;border-bottom:1px solid #2b2e31;background:rgba(10,11,13,.94);backdrop-filter:blur(14px)}
      .top-inner{max-width:1280px;margin:auto;padding:16px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:grid;gap:2px}.brand small{color:#dfff49;font:900 9px/1 ui-monospace,monospace;letter-spacing:.14em}.brand b{font-size:19px;letter-spacing:-.035em}.brand span{color:#7d8488;font-size:10px}
      .tools{display:flex;align-items:center;gap:10px}.seg{display:flex;padding:3px;border:1px solid #33373a;border-radius:999px;background:#111315}.seg button{border:0;border-radius:999px;padding:8px 12px;background:transparent;color:#747b80;font:900 9px/1 ui-monospace,monospace;letter-spacing:.06em;cursor:pointer}.seg button.active{background:#f5f5ef;color:#0c0d0e}.back{border:1px solid #363a3d;border-radius:9px;padding:9px 11px;background:#141617;color:#d3d6d7;font-size:10px;cursor:pointer}
      .main{max-width:1280px;margin:auto;padding:24px 22px 60px}.intro{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:16px}.intro h1{margin:0;font-size:32px;letter-spacing:-.055em}.intro p{max-width:680px;margin:8px 0 0;color:#858c90;font-size:11px;line-height:1.7}.pill{flex:none;border:1px solid #455029;border-radius:999px;padding:7px 9px;color:#cfe761;font:900 8px/1 ui-monospace,monospace;letter-spacing:.08em}
      .tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:18px 0}.tab{border:1px solid #303438;border-radius:12px;padding:12px 13px;text-align:left;background:#121416;color:#8c9397;cursor:pointer}.tab b{display:block;color:inherit;font-size:12px}.tab span{display:block;margin-top:4px;color:#666d71;font-size:9px}.tab.active{border-color:#82963f;background:#1a2013;color:#e6ff76;box-shadow:inset 0 0 0 1px rgba(223,255,73,.08)}.tab.active span{color:#a2af72}
      .frame{border:1px solid #2b2f32;border-radius:18px;background:#0d0f10;overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.35)}.frame-head{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:14px 16px;border-bottom:1px solid #272b2e;background:#121416}.frame-head div{display:grid;gap:2px}.frame-head small{color:#dfff49;font:900 8px/1 ui-monospace,monospace;letter-spacing:.12em}.frame-head b{font-size:13px}.frame-head span{color:#777e82;font-size:9px}.preview-wrap{padding:20px;min-height:600px;background:radial-gradient(circle at 70% 0,rgba(203,255,73,.045),transparent 34%),#090a0b}.preview{max-width:1040px;margin:auto;transition:max-width .2s ease}.preview.mobile{max-width:390px}.note{padding:12px 16px;border-top:1px solid #272b2e;color:#6f767a;font-size:9px;line-height:1.5}.note b{color:#b8cc5e}
      .media{position:relative;overflow:hidden;background:linear-gradient(145deg,#2b321f,#11140d)}.media img,.media video{width:100%;height:100%;object-fit:cover;display:block}.media-fallback{width:100%;height:100%;min-height:160px;display:grid;place-content:end start;padding:18px;background:radial-gradient(circle at 70% 20%,#46551c,#181d10 42%,#0c0e0a 80%);color:#dfff49}.media-fallback b{font-size:21px;letter-spacing:-.05em}.media-fallback small{margin-top:4px;color:#84974b;font:900 8px/1 ui-monospace,monospace}.badge{position:absolute;top:9px;left:9px;border-radius:999px;padding:6px 8px;background:#dfff49;color:#090a0b;font:950 8px/1 ui-monospace,monospace;letter-spacing:.06em}.cta{display:inline-flex;margin-top:11px;border:0;border-radius:8px;padding:9px 11px;background:#dfff49;color:#090a0b;font-weight:950;font-size:9px}.tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}.tags span{border:1px solid #455026;border-radius:999px;padding:5px 7px;color:#b1c368;font:850 7px/1 ui-monospace,monospace}.context-note{display:flex;align-items:center;justify-content:center;gap:9px;padding:9px 12px;color:#737a7d;font:850 8px/1.3 ui-monospace,monospace;letter-spacing:.04em}.context-note strong{color:#dfff49}.organic-label{display:inline-flex;align-items:center;border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:5px 7px;color:#a2a8aa;font:850 7px/1 ui-monospace,monospace;letter-spacing:.04em}

      /* WAYS: regular feed item / PR / regular feed item */
      .ways-context{overflow:hidden;border:1px solid #202427;border-radius:14px;background:#070809}.ways-bar{display:flex;justify-content:space-between;align-items:center;padding:11px 13px;border-bottom:1px solid #24272a;background:#101214}.ways-bar b{font-size:11px}.ways-bar span{color:#6d7478;font:850 8px/1 ui-monospace,monospace}.ways-feed{display:grid;grid-template-columns:.72fr 1.55fr .72fr;gap:10px;align-items:center;padding:18px;background:radial-gradient(circle at 50% 45%,#171b12,#090a0a 62%)}.ways-organic{overflow:hidden;border:1px solid #292d30;border-radius:11px;background:#101214;opacity:.72}.ways-organic-art{height:280px;background:linear-gradient(155deg,#283044,#11141b 45%,#071018)}.ways-organic.next .ways-organic-art{background:linear-gradient(155deg,#402b31,#171013 48%,#09090b)}.ways-organic-copy{display:grid;gap:5px;padding:10px}.ways-organic-copy b{font-size:10px}.ways-organic-copy small{color:#6d7478;font-size:8px}.ways-ad{position:relative;min-height:480px;overflow:hidden;border:1px solid #667633;border-radius:14px;background:#08090a;box-shadow:0 18px 55px rgba(0,0,0,.45)}.ways-ad .hero{height:480px}.ways-ad .copy{position:absolute;left:0;right:0;bottom:0;padding:100px 72px 22px 20px;background:linear-gradient(transparent,rgba(2,3,3,.98))}.ways-ad .copy small{color:#dfff49;font:900 8px/1 ui-monospace,monospace;letter-spacing:.1em}.ways-ad .copy h2{margin:7px 0 0;font-size:27px;line-height:1;letter-spacing:-.05em}.ways-ad .copy p{margin:8px 0 0;color:#d1d5d6;font-size:10px;line-height:1.55}.ways-ad .rail{position:absolute;right:16px;bottom:70px;display:grid;gap:16px;color:#fff;font-size:17px}
      .mobile .ways-feed{grid-template-columns:1fr;gap:8px;padding:9px}.mobile .ways-organic{display:grid;grid-template-columns:86px 1fr;min-height:76px}.mobile .ways-organic-art{height:76px}.mobile .ways-ad{min-height:590px}.mobile .ways-ad .hero{height:590px}.mobile .ways-ad .copy{padding:120px 50px 20px 16px}.mobile .ways-ad .copy h2{font-size:25px}.mobile .ways-organic-copy{align-content:center}.mobile .context-note{flex-wrap:wrap}

      /* PLAYLIST: shelf with normal records surrounding the sponsored record */
      .playlist{overflow:hidden;border:1px solid #2a2823;border-radius:14px;background:#15130f}.playlist-head,.scraps-head,.sale-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.08)}.playlist-head b,.scraps-head b,.sale-head b{font-size:11px}.playlist-head span,.scraps-head span,.sale-head span{color:#777b78;font:850 8px/1 ui-monospace,monospace}.playlist-shelf{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;align-items:end;padding:22px;background:linear-gradient(#211c16,#0f0d0b)}.record-item{min-width:0}.record-cover-organic,.record-cover{position:relative;aspect-ratio:1;border-radius:7px;overflow:hidden}.record-cover-organic{border:1px solid #3c3932;background:linear-gradient(145deg,#506070,#20242b 45%,#111315)}.record-item:nth-child(2) .record-cover-organic{background:linear-gradient(145deg,#665143,#27201c 50%,#12110f)}.record-item:nth-child(4) .record-cover-organic{background:linear-gradient(145deg,#435c4b,#1c2920 50%,#111511)}.record-item:nth-child(5) .record-cover-organic{background:linear-gradient(145deg,#5d4662,#271d2a 50%,#121013)}.record-groove{position:absolute;inset:12%;border:10px double rgba(8,8,8,.55);border-radius:50%}.record-caption{display:grid;gap:3px;margin-top:8px}.record-caption b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9px}.record-caption small{color:#716e67;font-size:7px}.promo-record{padding:9px;border:1px solid #667633;border-radius:10px;background:#171a12;box-shadow:0 13px 36px rgba(0,0,0,.28)}.promo-record .record-cover{border:1px solid #778942}.record-copy small{color:#dfff49;font:900 7px/1 ui-monospace,monospace}.record-copy h2{margin:6px 0 0;font-size:18px}.record-copy p{margin:5px 0 0;color:#9e9a91;font-size:8px;line-height:1.4}.playlist-deck{display:flex;align-items:center;gap:10px;padding:11px 16px;border-top:1px solid rgba(255,255,255,.07);color:#6f6c65;font:800 8px/1 ui-monospace,monospace}.playlist-deck i{height:1px;flex:1;background:#37332e}
      .mobile .playlist-shelf{grid-template-columns:.42fr 1.35fr .42fr;gap:7px;padding:12px 7px}.mobile .playlist-shelf .record-item:nth-child(1),.mobile .playlist-shelf .record-item:nth-child(5){display:none}.mobile .playlist-shelf .record-item:nth-child(2){order:1;transform:translateX(-34%);opacity:.58}.mobile .playlist-shelf .promo-record{order:2}.mobile .playlist-shelf .record-item:nth-child(4){order:3;transform:translateX(34%);opacity:.58}.mobile .record-caption{display:none}.mobile .record-copy h2{font-size:20px}.mobile .promo-record{padding:8px}

      /* SCRAPS: PR note appears between ordinary notes */
      .scraps{overflow:hidden;border:1px solid #2c2925;border-radius:14px;background:#13110f}.scraps-feed{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:start;padding:18px;background:linear-gradient(145deg,#171411,#0e0d0b)}.scrap-note,.scrap-promo{overflow:hidden;border:1px solid #302d29;border-radius:9px;background:#181613}.scrap-note{padding:10px}.scrap-note:nth-child(1){transform:rotate(-1deg)}.scrap-note:nth-child(3){transform:rotate(.8deg)}.scrap-note:nth-child(4){transform:rotate(-.5deg)}.scrap-thumb{height:105px;border-radius:5px;background:linear-gradient(145deg,#4a443d,#211e1a)}.scrap-note:nth-child(3) .scrap-thumb{background:linear-gradient(145deg,#354a4e,#192326)}.scrap-note:nth-child(4) .scrap-thumb{background:linear-gradient(145deg,#4f3d4a,#251c22)}.scrap-note b{display:block;margin-top:8px;font-size:9px}.scrap-note p{margin:4px 0 0;color:#817c73;font-size:8px;line-height:1.5}.scrap-promo{grid-row:span 2;border-color:#667433;background:#161a11;box-shadow:0 15px 42px rgba(0,0,0,.3)}.scrap-media{aspect-ratio:16/10}.scrap-copy{padding:14px}.scrap-copy small{color:#dfff49;font:900 8px/1 ui-monospace,monospace}.scrap-copy h2{margin:6px 0;font-size:22px}.scrap-copy p{margin:0;color:#aaa79e;font-size:10px;line-height:1.6}
      .mobile .scraps-feed{grid-template-columns:1fr;padding:10px}.mobile .scrap-note{display:block;transform:none!important}.mobile .scrap-note:nth-child(3),.mobile .scrap-note:nth-child(4){display:none}.mobile .scrap-note:first-child{order:1;display:grid;grid-template-columns:86px 1fr;column-gap:10px;align-items:center}.mobile .scrap-note:first-child .scrap-thumb{height:72px;grid-row:1/4}.mobile .scrap-note:first-child b,.mobile .scrap-note:first-child p{margin:0}.mobile .scrap-promo{order:2}.mobile .scrap-note:nth-child(5){order:3;display:grid;grid-template-columns:86px 1fr;column-gap:10px;align-items:center}.mobile .scrap-note:nth-child(5) .scrap-thumb{height:72px;grid-row:1/4}.mobile .scrap-note:nth-child(5) b,.mobile .scrap-note:nth-child(5) p{margin:0}

      /* SALE WATCH already communicates insertion among ordinary cards */
      .sale{overflow:hidden;border:1px solid #283029;border-radius:14px;background:#0d100e}.sale-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:17px}.sale-card,.sale-promo{overflow:hidden;border:1px solid #2d322d;border-radius:8px;background:#141814}.sale-thumb{aspect-ratio:16/9;background:linear-gradient(145deg,#343b35,#141816)}.sale-card .meta{display:grid;grid-template-columns:1fr auto;gap:4px;padding:9px}.sale-card b{grid-column:1/-1;font-size:9px;color:#b6bbb6}.sale-card span{color:#dfff49;font:950 10px/1 ui-monospace,monospace}.sale-card small{color:#828883;font-size:8px}.sale-promo{border-color:#667832;background:#171b12}.sale-promo .promo-media{aspect-ratio:16/9}.sale-promo .promo-copy{padding:10px}.sale-promo .promo-copy small{color:#dfff49;font:900 7px/1 ui-monospace,monospace}.sale-promo .promo-copy h2{margin:5px 0 3px;font-size:17px}.sale-promo .promo-copy p{margin:0;color:#9fa59e;font-size:8px;line-height:1.5}.mobile .sale-grid{grid-template-columns:1fr 1fr;gap:7px;padding:10px}.mobile .sale-promo{grid-column:1/-1}.mobile .sale-promo .promo-copy h2{font-size:19px}

      .empty{min-height:520px;display:grid;place-content:center;text-align:center;color:#7b8286}.empty b{color:#e2e3df;font-size:19px}.empty p{max-width:460px;margin:8px auto 0;font-size:11px;line-height:1.7}.expired{max-width:760px;margin:60px auto;padding:30px;border:1px solid #33373a;border-radius:18px;background:#111315;text-align:center}.expired h1{margin:0;font-size:27px}.expired p{color:#858b8f;line-height:1.7}.expired button{margin-top:10px;border:1px solid #444a4d;border-radius:9px;padding:10px 13px;background:#191c1e;color:#fff;cursor:pointer}
      @media(max-width:760px){.top-inner,.intro{align-items:flex-start;flex-direction:column}.tools{width:100%;justify-content:space-between}.tabs{grid-template-columns:1fr 1fr}.main{padding:18px 12px 40px}.preview-wrap{padding:10px;min-height:520px}.intro h1{font-size:27px}.pill{display:none}.frame-head{align-items:flex-start;flex-direction:column}}
    </style>
  </head>
  <body>
    <div class="page">
      <header class="top">
        <div class="top-inner">
          <div class="brand"><small>HARF-WAY ADS / PREVIEW</small><b>掲載プレビュー</b><span>このページでは計測されません。</span></div>
          <div class="tools">
            <div class="seg" id="deviceSwitch"><button type="button" data-device="pc">PC</button><button type="button" data-device="mobile">スマホ</button></div>
            <button class="back" type="button" onclick="window.close()">ポータルに戻る</button>
          </div>
        </div>
      </header>
      <main class="main" id="app"><div class="empty"><div><b>プレビューを読み込み中…</b><p>入稿中の内容をブラウザ内から読み込んでいます。</p></div></div></main>
    </div>
    <script is:inline>
      (() => {
        const DB_NAME='harfway-ads-preview', STORE_NAME='drafts';
        const PLACEMENTS=[
          {id:'playlist',label:'PLAYLIST',desc:'選曲棚の中に挿入'},
          {id:'scraps',label:'切れ端',desc:'記録カードの途中に挿入'},
          {id:'playback',label:'WAYS',desc:'通常フィードの途中に挿入'},
          {id:'sale',label:'SALE WATCH',desc:'セール一覧の途中に挿入'},
        ];
        const state={device:'pc',active:'playlist',draft:null,mediaUrl:''};
        const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const id=new URL(location.href).searchParams.get('id');

        function openDb(){return new Promise((resolve,reject)=>{const req=indexedDB.open(DB_NAME,1);req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains(STORE_NAME))db.createObjectStore(STORE_NAME,{keyPath:'id'});};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});}
        async function loadDraft(){const db=await openDb();const record=await new Promise((resolve,reject)=>{const tx=db.transaction(STORE_NAME,'readonly');const req=tx.objectStore(STORE_NAME).get(id);req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error);});db.close();return record;}
        function mediaMarkup(cls=''){const d=state.draft;if(!d?.mediaFile)return `<div class="media-fallback ${cls}"><b>MEDIA PREVIEW</b><small>IMAGE / VIDEO</small></div>`;return (d.mediaType||'').startsWith('video/')?`<video class="${cls}" src="${esc(state.mediaUrl)}" muted autoplay loop playsinline controls></video>`:`<img class="${cls}" src="${esc(state.mediaUrl)}" alt="" />`;}
        function tags(){const list=state.draft.tags?.length?state.draft.tags:['INDIE GAME','PROMOTED'];return `<div class="tags">${list.slice(0,4).map(t=>`<span># ${esc(t)}</span>`).join('')}</div>`;}
        function organicLabel(){return '<span class="organic-label">通常コンテンツ</span>';}

        function ways(){const d=state.draft;return `<section class="ways-context"><div class="ways-bar"><b>WAYS / DISCOVER</b><span>RANDOM FEED</span></div><div class="ways-feed"><article class="ways-organic prev"><div class="ways-organic-art"></div><div class="ways-organic-copy">${organicLabel()}<b>夜に遊びたい一本</b><small>20 SEC / GAME CLIP</small></div></article><article class="ways-ad"><div class="media hero">${mediaMarkup()}<span class="badge">PR / SPONSORED</span></div><div class="copy"><small>PROMOTED ON WAYS</small><h2>${esc(d.title)}</h2><p>${esc(d.catchText)}</p>${tags()}<button class="cta" type="button">ストアで見る ↗</button></div><div class="rail"><span>♡</span><span>▢</span><span>↗</span></div></article><article class="ways-organic next"><div class="ways-organic-art"></div><div class="ways-organic-copy">${organicLabel()}<b>次に出会うゲーム</b><small>20 SEC / RANDOM</small></div></article></div><div class="context-note"><span>通常投稿</span><span>→</span><strong>PR</strong><span>→</span><span>通常投稿</span></div></section>`;}

        function organicRecord(title,sub){return `<article class="record-item"><div class="record-cover-organic"><div class="record-groove"></div></div><div class="record-caption">${organicLabel()}<b>${title}</b><small>${sub}</small></div></article>`;}
        function playlist(){const d=state.draft;return `<section class="playlist"><div class="playlist-head"><b>HARF-WAY PLAYLIST</b><span>CURATED SELECTION</span></div><div class="playlist-shelf">${organicRecord('TRACK 01','編集部セレクト')}${organicRecord('TRACK 02','今週の一本')}<article class="promo-record"><div class="media record-cover">${mediaMarkup()}<span class="badge">PR</span></div><div class="record-copy"><small>PLAYLIST SUPPORTER / PR</small><h2>${esc(d.title)}</h2><p>${esc(d.catchText)}</p>${tags()}<button class="cta" type="button">ストアで見る ↗</button></div></article>${organicRecord('TRACK 04','寄り道セレクト')}${organicRecord('TRACK 05','NEXT PICK')}</div><div class="playlist-deck"><span>NORMAL</span><i></i><strong style="color:#dfff49">SPONSORED TRACK</strong><i></i><span>NORMAL</span></div></section>`;}

        function scrapNote(title,text){return `<article class="scrap-note"><div class="scrap-thumb"></div>${organicLabel()}<b>${title}</b><p>${text}</p></article>`;}
        function scraps(){const d=state.draft;return `<section class="scraps"><div class="scraps-head"><b>GAME SCRAPBOOK</b><span>記録されたゲームの切れ端</span></div><div class="scraps-feed">${scrapNote('PLAY LOG','短い記録と映像の断片。')}${scrapNote('気になった一本','あとから読み返すためのメモ。')}<article class="scrap-promo"><div class="media scrap-media">${mediaMarkup()}<span class="badge">SPONSORED</span></div><div class="scrap-copy"><small>HARF-WAY / PR NOTE</small><h2>${esc(d.title)}</h2><p>${esc(d.description)}</p>${tags()}<button class="cta" type="button">ストアで見る ↗</button></div></article>${scrapNote('MEMO','プレイ中に残した小さな発見。')}${scrapNote('CLIP','あとで見返したいゲームの瞬間。')}</div><div class="context-note"><span>通常の切れ端</span><span>→</span><strong>SPONSORED NOTE</strong><span>→</span><span>通常の切れ端</span></div></section>`;}

        function saleCard(name,off){return `<article class="sale-card"><div class="sale-thumb"></div><div class="meta"><b>${name}</b><span>-${off}%</span><small>¥980</small></div></article>`;}
        function sale(){const d=state.draft;return `<section class="sale"><div class="sale-head"><b>SALE WATCH</b><span>LIVE SALE</span></div><div class="sale-grid">${saleCard('ON SALE',35)}${saleCard('WEEKEND DEAL',50)}${state.device==='pc'?saleCard('SPECIAL OFFER',20):''}<article class="sale-promo"><div class="media promo-media">${mediaMarkup()}<span class="badge">PR / SPONSORED</span></div><div class="promo-copy"><small>HARF-WAY / SALE WATCH PR</small><h2>${esc(d.title)}</h2><p>${esc(d.catchText)}</p>${tags()}<button class="cta" type="button">ストアで見る ↗</button></div></article>${saleCard('DEAL',40)}${state.device==='pc'?saleCard('PRICE DROP',25):''}</div><div class="context-note"><span>セール作品</span><span>→</span><strong>PR</strong><span>→</span><span>セール作品</span></div></section>`;}
        function view(){return state.active==='playlist'?playlist():state.active==='scraps'?scraps():state.active==='sale'?sale():ways();}
        function render(){const app=document.getElementById('app');if(!state.draft)return;const allowed=state.draft.placements?.length?state.draft.placements:PLACEMENTS.map(x=>x.id);if(!allowed.includes(state.active))state.active=allowed[0];const tabs=PLACEMENTS.filter(x=>allowed.includes(x.id)).map(x=>`<button class="tab ${state.active===x.id?'active':''}" type="button" data-placement="${x.id}"><b>${x.label}</b><span>${x.desc}</span></button>`).join('');app.innerHTML=`<section class="intro"><div><h1>実際の掲載イメージ</h1><p>広告単体ではなく、通常コンテンツの中でどう見えるかを確認できます。表示位置や前後のコンテンツは実配信時に変動します。</p></div><span class="pill">PREVIEW ONLY / NOT COUNTED</span></section><nav class="tabs">${tabs}</nav><section class="frame"><div class="frame-head"><div><small>YOUR AD / ${esc(state.active.toUpperCase())}</small><b>${esc(state.draft.title)}</b><span>${state.device==='pc'?'PC表示':'スマホ表示'}</span></div><span>IMP / CLICK / STORE VISIT は計測されません</span></div><div class="preview-wrap"><div class="preview ${state.device==='mobile'?'mobile':''}">${view()}</div></div><div class="note"><b>PREVIEW ONLY</b>　これは掲載確認用のページです。実際の掲載順や周辺コンテンツは変動します。</div></section>`;document.querySelectorAll('[data-placement]').forEach(btn=>btn.onclick=()=>{state.active=btn.dataset.placement;render();});document.querySelectorAll('#deviceSwitch [data-device]').forEach(btn=>btn.classList.toggle('active',btn.dataset.device===state.device));}
        document.getElementById('deviceSwitch').addEventListener('click',(e)=>{const b=e.target.closest('[data-device]');if(!b)return;state.device=b.dataset.device==='mobile'?'mobile':'pc';render();});
        loadDraft().then(d=>{if(!d)throw new Error('not found');state.draft=d;state.active=d.placements?.[0]||'playlist';if(d.mediaFile)state.mediaUrl=URL.createObjectURL(d.mediaFile);render();}).catch(()=>{document.getElementById('app').innerHTML='<section class="expired"><h1>プレビュー情報が見つかりません</h1><p>広告主ポータルから「実際の掲載プレビューを開く」を押して、もう一度開いてください。</p><button type="button" onclick="window.close()">閉じる</button></section>';});
        window.addEventListener('beforeunload',()=>{if(state.mediaUrl)URL.revokeObjectURL(state.mediaUrl);});
      })();
    </script>
  </body>
</html>
