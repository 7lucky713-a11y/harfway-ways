---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>HARF-WAY DB MASTER / CORE</title>
<style>
:root{color-scheme:dark;--bg:#090909;--panel:#111113;--panel2:#171719;--line:#303034;--muted:#98989a;--accent:#efff3d;--ok:#b9ff78;--warn:#ffc96b;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}*{box-sizing:border-box}body{margin:0;background:#090909;color:#f7f7f2;font-size:14px}button,input{font:inherit}.hide{display:none!important}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 14px;border:1px solid var(--line);border-radius:10px;background:#19191c;color:#fff;text-decoration:none;font-weight:850;cursor:pointer}.btn.primary{background:var(--accent);border-color:transparent;color:#111}.muted{color:var(--muted)}.tiny{font-size:11px}.eyebrow{font-size:10px;letter-spacing:.16em;color:var(--accent);font-weight:900}.login{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 15%,#252528,#090909 55%)}.loginbox{width:min(460px,100%);padding:30px;border:1px solid var(--line);border-radius:22px;background:#101012}.login h1{font-size:48px;line-height:.9;margin:10px 0 18px}.login input{width:100%;height:44px;border:1px solid #3a3a3e;border-radius:10px;background:#0b0b0d;color:#fff;padding:0 12px;margin:8px 0 12px}.top{position:sticky;top:0;z-index:20;background:#0b0b0df2;backdrop-filter:blur(12px);border-bottom:1px solid #242427}.topin{display:flex;align-items:center;gap:12px;min-height:68px;padding:12px 20px}.brand{font-size:17px;font-weight:950;margin-right:auto}.brand b{color:var(--accent)}.page{max-width:1800px;margin:auto;padding:22px}.stats{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:10px;margin-bottom:16px}.stat{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,#141416,#101012);padding:15px}.stat small{color:var(--muted);font-size:10px;font-weight:800}.stat b{display:block;font-size:30px;margin-top:7px}.controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px;padding:10px;border:1px solid var(--line);border-radius:14px;background:#101012}.tabs{display:flex;gap:6px}.tab{min-height:40px;border:1px solid var(--line);border-radius:9px;background:#111;color:#aaa;padding:8px 13px;font-weight:850;cursor:pointer}.tab.on{background:var(--accent);border-color:transparent;color:#111}.controls input{flex:1;min-width:240px;height:40px;border:1px solid var(--line);border-radius:9px;background:#171719;color:#fff;padding:0 12px}.workspace{display:grid;grid-template-columns:minmax(620px,1.08fr) minmax(470px,.92fr);gap:14px;align-items:start}.panel{border:1px solid var(--line);border-radius:14px;background:var(--panel);overflow:hidden}.scroll{max-height:calc(100vh - 235px);overflow:auto}.detail{position:sticky;top:88px;max-height:calc(100vh - 106px);overflow:auto}.phead{padding:15px;border-bottom:1px solid #29292d;background:#151517}.pbody{padding:14px}.empty{padding:50px 20px;text-align:center;color:var(--muted)}table{width:100%;border-collapse:collapse;min-width:760px}th,td{padding:12px;border-bottom:1px solid #28282b;text-align:left;vertical-align:middle;font-size:12px}th{position:sticky;top:0;background:#18181b;color:#aaa;font-size:10px;z-index:2}tr[data-id]{cursor:pointer}tr[data-id]:hover{background:#19191b}tr.on{background:#252518;box-shadow:inset 3px 0 0 var(--accent)}.title{font-weight:850;font-size:13px}.idline{font-size:10px;color:#777;margin-top:3px}.pill{display:inline-block;border:1px solid #414146;border-radius:999px;padding:4px 7px;font-size:9px;font-weight:850}.pill.core{color:#dcff78;border-color:#4d5728;background:#171b0c}.pill.draft{color:#c0c0c4}.pill.reviewed,.pill.published{color:#caff81;border-color:#3c5134;background:#131a10}.health{display:flex;gap:4px}.health span{display:grid;place-items:center;width:24px;height:24px;border:1px solid #333;border-radius:7px;color:#666;font-size:9px;font-weight:900}.health span.on{color:var(--ok);border-color:#3c5134;background:#11190f}.corecount{display:inline-flex;align-items:center;gap:5px;border:1px solid #4c512d;border-radius:8px;padding:5px 8px;background:#17180f;color:#e6ff78;font-weight:900}.gamehead h2{font-size:29px;line-height:1.12;margin:7px 0}.metaGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}.metaBox{padding:11px;border:1px solid #2e2e32;border-radius:10px;background:#0e0e10;min-width:0}.metaBox small{display:block;color:#7f7f84;font-size:9px;margin-bottom:5px}.metaBox div{word-break:break-word}.section{margin-top:14px;border:1px solid #303034;border-radius:12px;overflow:hidden}.sectionTitle{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid #28282b;background:#151517}.sectionTitle b{font-size:11px}.sectionTitle span{margin-left:auto;color:#777;font-size:10px}.articleList{display:grid;gap:8px;padding:10px}.article{border:1px solid #303034;border-radius:10px;background:#0e0e10;padding:12px}.article h3{font-size:15px;line-height:1.4;margin:6px 0}.article p{margin:8px 0;color:#aaa;font-size:11px;line-height:1.6}.articleMeta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;color:#888;font-size:9px}.articleActions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.articleActions .btn{min-height:34px;padding:7px 10px;font-size:10px}.allgrid{display:grid;gap:9px}.allarticle{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:12px;background:#111113}.allarticle h3{margin:4px 0;font-size:16px}.gamechips{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.chip{font-size:9px;border:1px solid #3d4038;border-radius:999px;padding:4px 7px;background:#1b1d18;color:#d1d0c4}.showcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}.showcard{border:1px solid var(--line);border-radius:12px;background:#111113;padding:14px}.json{white-space:pre-wrap;word-break:break-word;font:10px/1.55 ui-monospace,monospace;color:#aaa;max-height:240px;overflow:auto;background:#09090b;padding:9px;border-radius:8px}@media(max-width:1100px){.workspace{grid-template-columns:1fr}.detail{position:relative;top:auto;max-height:none}.scroll{max-height:55vh}}@media(max-width:720px){.page{padding:10px}.stats{grid-template-columns:1fr 1fr}.topin{flex-wrap:wrap}.brand{width:100%}.controls input{min-width:100%}.metaGrid{grid-template-columns:1fr}.allarticle{grid-template-columns:1fr}}
</style>
</head>
<body>
<section id="login" class="login">
<form id="loginForm" class="loginbox">
<div class="eyebrow">HARF-WAY / DB MASTER + SHARED CONTENT CORE</div>
<h1>DB<br>MASTER</h1>
<p class="muted tiny">WAYSの管理データと、Archive Salvagerで回収した記事を同じ作品単位で確認します。</p>
<input id="key" type="password" autocomplete="current-password" placeholder="管理キー" />
<div id="loginMsg" class="muted tiny"></div>
<button class="btn primary" style="width:100%;margin-top:10px" type="submit">開く</button>
</form>
</section>
<div id="app" class="hide">
<header class="top"><div class="topin"><div class="brand">HARF-WAY <b>DB MASTER / CORE</b></div><span id="connection" class="muted tiny">接続中…</span><button id="reload" class="btn">再読込</button><a class="btn" href="/db-master/">既存編集画面 ↗</a><a class="btn" href="/salvage/library/">Archive Library ↗</a><button id="logout" class="btn">ログアウト</button></div></header>
<main class="page">
<section id="stats" class="stats"></section>
<div class="controls"><div class="tabs"><button class="tab on" data-tab="games">作品 × CORE</button><button class="tab" data-tab="articles">CORE ARTICLES</button><button class="tab" data-tab="showcases">ショーケース</button></div><input id="search" placeholder="作品名 / 記事名 / URL / IDで検索" /><span id="count" class="muted tiny"></span></div>
<section id="gamesView" class="workspace"><div class="panel scroll" id="gameTable"></div><aside class="panel detail" id="detail"><div class="empty">作品を選択してください。</div></aside></section>
<section id="articlesView" class="hide"><div id="articleGrid" class="allgrid"></div></section>
<section id="showcasesView" class="hide"><div id="showcards" class="showcards"></div></section>
</main>
</div>
<script is:inline>
(()=>{
const KEY='hw-db-master-admin-key';const $=s=>document.querySelector(s);let key=sessionStorage.getItem(KEY)||'';let data={state:{games:[],showcases:[]},core:{articles:[],summary:{}}};let selected='';let tab='games';
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const nt=v=>String(v||'').normalize('NFKC').toLowerCase().replace(/[\s:：・!！?？'"“”‘’()（）\[\]【】_\-–—～~]+/g,'');
const refId=x=>String(x?.gameId||x?.game_id||x?.id||'');const refTitle=x=>String(x?.title||x?.name||x?.gameTitle||x?.game_title||'');
function refs(a){return Array.isArray(a?.games)?a.games:[]}
function articlesFor(g){const gid=String(g?.id||''),gt=nt(g?.title||'');return (data.core?.articles||[]).filter(a=>refs(a).some(r=>{const rid=refId(r),rt=nt(refTitle(r));return (rid&&rid===gid)||(gt&&rt&&gt===rt)}))}
function latest(arr){return [...arr].sort((a,b)=>String(b.updatedAt||b.publishedAt||'').localeCompare(String(a.updatedAt||a.publishedAt||'')))[0]||null}
function health(g){return `<div class="health"><span class="${g.storeUrl||g.store_url?'on':''}">S</span><span class="${g.articleUrl||g.article_url?'on':''}">A</span><span class="${g.video||g.video_url?'on':''}">V</span></div>`}
function date(v){if(!v)return '—';try{return new Date(v).toLocaleDateString('ja-JP')}catch{return String(v)}}
function login(msg=''){ $('#login').classList.remove('hide');$('#app').classList.add('hide');$('#loginMsg').textContent=msg }
async function api(){const r=await fetch('/api/db-master',{cache:'no-store',headers:{'x-showcase-admin-key':key}});let j={};try{j=await r.json()}catch{}if(r.status===401){sessionStorage.removeItem(KEY);key='';login('管理キーを確認してください。');throw Error('unauthorized')}if(!r.ok)throw Error(j.error||`HTTP ${r.status}`);return j}
function normGame(g,i){return {id:String(g.id||`game-${i}`),title:String(g.title||''),status:g.status==='published'?'published':'draft',description:String(g.description||''),category:String(g.category||''),tags:Array.isArray(g.tags)?g.tags:[],storeUrl:String(g.storeUrl||g.store_url||''),articleUrl:String(g.articleUrl||g.article_url||''),video:String(g.video||g.video_url||''),thumbnail:String(g.thumbnail||g.thumbnail_url||'')}}
function stats(){const games=data.state.games||[],arts=data.core?.articles||[];const linkedGames=games.filter(g=>articlesFor(g).length).length;const links=arts.reduce((n,a)=>n+refs(a).length,0);$('#stats').innerHTML=[['WAYS GAMES',games.length],['CORE ARTICLES',arts.length],['ARTICLE付き作品',linkedGames],['GAME LINKS',links]].map(([a,b])=>`<div class="stat"><small>${a}</small><b>${b}</b></div>`).join('')}
function filteredGames(){const q=nt($('#search').value);return (data.state.games||[]).filter(g=>!q||[g.title,g.id,g.category,g.storeUrl,g.articleUrl].some(x=>nt(x).includes(q))||articlesFor(g).some(a=>nt(`${a.title} ${a.url}`).includes(q)))}
function renderGames(){const games=filteredGames();$('#count').textContent=`表示 ${games.length} / ${data.state.games.length}作品`;if(!games.length){$('#gameTable').innerHTML='<div class="empty">該当する作品はありません。</div>';return}$('#gameTable').innerHTML=`<table><thead><tr><th>状態</th><th>作品</th><th>WAYS</th><th>CORE記事</th><th>最新記事</th></tr></thead><tbody>${games.map(g=>{const aa=articlesFor(g),la=latest(aa);return `<tr data-id="${esc(g.id)}" class="${selected===g.id?'on':''}"><td><span class="pill ${g.status}">${g.status==='published'?'公開':'下書き'}</span></td><td><div class="title">${esc(g.title||'名称未設定')}</div><div class="idline">${esc(g.id)}</div></td><td>${health(g)}</td><td><span class="corecount">CORE ${aa.length}</span></td><td>${la?`<div>${esc(la.title)}</div><div class="idline">${date(la.publishedAt)}</div>`:'<span class="muted">—</span>'}</td></tr>`}).join('')}</tbody></table>`;$('#gameTable').querySelectorAll('tr[data-id]').forEach(r=>r.onclick=()=>{selected=r.dataset.id;renderGames();renderDetail()})}
function articleCard(a){return `<article class="article"><div class="articleMeta"><span class="pill ${esc(a.status||'draft')}">${esc(a.status||'draft')}</span><span>${date(a.publishedAt)}</span><span>${esc(a.source||'')}</span></div><h3>${esc(a.title||'Untitled')}</h3>${a.excerpt?`<p>${esc(String(a.excerpt).slice(0,220))}${String(a.excerpt).length>220?'…':''}</p>`:''}<div class="articleActions"><a class="btn" href="${esc(a.url)}" target="_blank" rel="noreferrer">元記事 ↗</a><a class="btn primary" href="/salvage/?url=${encodeURIComponent(a.url)}">Salvagerで再編集</a></div></article>`}
function renderDetail(){const g=(data.state.games||[]).find(x=>x.id===selected);if(!g){$('#detail').innerHTML='<div class="empty">作品を選択してください。</div>';return}const aa=articlesFor(g);$('#detail').innerHTML=`<div class="phead gamehead"><div class="eyebrow">${esc(g.status.toUpperCase())} / ${esc(g.id)}</div><h2>${esc(g.title||'名称未設定')}</h2><div class="articleMeta"><span class="pill core">CORE ARTICLES ${aa.length}</span>${g.category?`<span>${esc(g.category)}</span>`:''}</div></div><div class="pbody"><div class="metaGrid"><div class="metaBox"><small>STORE</small><div>${g.storeUrl?`<a href="${esc(g.storeUrl)}" target="_blank" rel="noreferrer">${esc(g.storeUrl)}</a>`:'—'}</div></div><div class="metaBox"><small>WAYS ARTICLE</small><div>${g.articleUrl?`<a href="${esc(g.articleUrl)}" target="_blank" rel="noreferrer">${esc(g.articleUrl)}</a>`:'—'}</div></div><div class="metaBox"><small>VIDEO</small><div>${g.video?'あり':'なし'}</div></div><div class="metaBox"><small>TAGS</small><div>${esc((g.tags||[]).join(', ')||'—')}</div></div></div><div class="articleActions"><a class="btn" href="/db-master/">既存DB MASTERで編集 ↗</a><a class="btn" href="/salvage/">記事を追加 ↗</a></div><section class="section"><div class="sectionTitle"><b>CORE / ARTICLES</b><span>${aa.length}件</span></div>${aa.length?`<div class="articleList">${aa.map(articleCard).join('')}</div>`:'<div class="empty">この作品に紐づくサルベージ記事はまだありません。</div>'}</section></div>`}
function renderArticles(){const q=nt($('#search').value);const arts=(data.core?.articles||[]).filter(a=>!q||nt(`${a.title} ${a.url} ${refs(a).map(refTitle).join(' ')}`).includes(q));$('#count').textContent=`表示 ${arts.length} / 全 ${data.core?.articles?.length||0}記事`;$('#articleGrid').innerHTML=arts.length?arts.map(a=>`<article class="allarticle"><div><div class="articleMeta"><span class="pill ${esc(a.status||'draft')}">${esc(a.status||'draft')}</span><span>${date(a.publishedAt)}</span></div><h3>${esc(a.title||'Untitled')}</h3><div class="gamechips">${refs(a).length?refs(a).map(r=>`<span class="chip">${esc(refTitle(r)||refId(r))}</span>`).join(''):'<span class="muted tiny">ゲーム未紐付け</span>'}</div></div><div class="articleActions"><a class="btn" href="${esc(a.url)}" target="_blank" rel="noreferrer">元記事 ↗</a><a class="btn primary" href="/salvage/?url=${encodeURIComponent(a.url)}">再編集</a></div></article>`).join(''):'<div class="empty">該当する記事はありません。</div>'}
function renderShowcases(){const arr=data.state.showcases||[];$('#count').textContent=`${arr.length}件`;$('#showcards').innerHTML=arr.length?arr.map((s,i)=>`<article class="showcard"><div class="eyebrow">SHOWCASE ${i+1}</div><h3>${esc(s.title||s.name||s.id||'名称未設定')}</h3><div class="json">${esc(JSON.stringify(s,null,2))}</div></article>`).join(''):'<div class="empty">ショーケースデータはありません。</div>'}
function switchTab(next){tab=next;document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('on',b.dataset.tab===tab));$('#gamesView').classList.toggle('hide',tab!=='games');$('#articlesView').classList.toggle('hide',tab!=='articles');$('#showcasesView').classList.toggle('hide',tab!=='showcases');$('#search').placeholder=tab==='games'?'作品名 / 記事名 / URL / IDで検索':tab==='articles'?'記事名 / URL / ゲーム名で検索':'検索';render()}
function render(){stats();if(tab==='games'){renderGames();renderDetail()}else if(tab==='articles')renderArticles();else renderShowcases()}
async function load(){try{$('#connection').textContent='WAYS + CORE 読込中…';const j=await api();data=j;data.state=data.state||{games:[],showcases:[]};data.state.games=(data.state.games||[]).map(normGame);data.state.showcases=Array.isArray(data.state.showcases)?data.state.showcases:[];data.core=data.core||{available:false,articles:[]};data.core.articles=Array.isArray(data.core.articles)?data.core.articles:[];if(selected&&!data.state.games.some(g=>g.id===selected))selected='';$('#login').classList.add('hide');$('#app').classList.remove('hide');$('#connection').textContent=data.core.available?`WAYS + Shared Content Core 接続済み / ${data.core.articles.length}記事`:'WAYS接続済み / Core記事取得なし';render()}catch(e){if(e.message!=='unauthorized')$('#connection').textContent='読込エラー: '+e.message}}
$('#loginForm').onsubmit=async e=>{e.preventDefault();key=$('#key').value.trim();if(!key)return;sessionStorage.setItem(KEY,key);await load()};$('#reload').onclick=load;$('#logout').onclick=()=>{sessionStorage.removeItem(KEY);key='';login('')};$('#search').oninput=render;document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));if(key)load();else login();
})();
</script>
</body>
</html>
