---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>HARF-WAY DB MASTER / CORE FIRST</title>
<style>
:root{color-scheme:dark;--bg:#090909;--panel:#111113;--panel2:#171719;--line:#303034;--muted:#98989a;--accent:#efff3d;--ok:#b9ff78;--warn:#ffc96b;--blue:#9ed8ff;--pink:#ffb6da;font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f7f7f2;font-size:14px}button,input,select{font:inherit}.hide{display:none!important}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 14px;border:1px solid var(--line);border-radius:10px;background:#19191c;color:#fff;text-decoration:none;font-weight:850;cursor:pointer}.btn.primary{background:var(--accent);border-color:transparent;color:#111}.muted{color:var(--muted)}.tiny{font-size:11px}.eyebrow{font-size:10px;letter-spacing:.16em;color:var(--accent);font-weight:900}.login{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 50% 15%,#252528,#090909 55%)}.loginbox{width:min(470px,100%);padding:30px;border:1px solid var(--line);border-radius:22px;background:#101012}.login h1{font-size:48px;line-height:.9;margin:10px 0 18px}.login input{width:100%;height:44px;border:1px solid #3a3a3e;border-radius:10px;background:#0b0b0d;color:#fff;padding:0 12px;margin:8px 0 12px}.top{position:sticky;top:0;z-index:20;background:#0b0b0df2;backdrop-filter:blur(12px);border-bottom:1px solid #242427}.topin{display:flex;align-items:center;gap:10px;min-height:68px;padding:12px 20px}.brand{font-size:17px;font-weight:950;margin-right:auto}.brand b{color:var(--accent)}.page{max-width:1840px;margin:auto;padding:22px}.stats{display:grid;grid-template-columns:repeat(5,minmax(140px,1fr));gap:10px;margin-bottom:16px}.stat{border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,#141416,#101012);padding:15px}.stat small{color:var(--muted);font-size:10px;font-weight:800}.stat b{display:block;font-size:29px;margin-top:7px}.controls{display:grid;grid-template-columns:auto minmax(260px,1fr) auto auto auto;gap:8px;align-items:center;margin-bottom:14px;padding:10px;border:1px solid var(--line);border-radius:14px;background:#101012}.tabs{display:flex;gap:6px}.tab{min-height:40px;border:1px solid var(--line);border-radius:9px;background:#111;color:#aaa;padding:8px 13px;font-weight:850;cursor:pointer}.tab.on{background:var(--accent);border-color:transparent;color:#111}.controls input,.controls select{height:40px;border:1px solid var(--line);border-radius:9px;background:#171719;color:#fff;padding:0 12px}.workspace{display:grid;grid-template-columns:minmax(720px,1.12fr) minmax(470px,.88fr);gap:14px;align-items:start}.panel{border:1px solid var(--line);border-radius:14px;background:var(--panel);overflow:hidden}.scroll{max-height:calc(100vh - 250px);overflow:auto}.detail{position:sticky;top:88px;max-height:calc(100vh - 106px);overflow:auto}.empty{padding:50px 20px;text-align:center;color:var(--muted)}table{width:100%;border-collapse:collapse;min-width:930px}th,td{padding:12px;border-bottom:1px solid #28282b;text-align:left;vertical-align:middle;font-size:12px}th{position:sticky;top:0;background:#18181b;color:#aaa;font-size:10px;z-index:2}tr[data-id]{cursor:pointer}tr[data-id]:hover{background:#19191b}tr.on{background:#252518;box-shadow:inset 3px 0 0 var(--accent)}.title{font-weight:850;font-size:13px}.idline{font-size:9px;color:#777;margin-top:4px}.pill{display:inline-block;border:1px solid #414146;border-radius:999px;padding:4px 7px;font-size:9px;font-weight:900;white-space:nowrap}.pill.article{color:var(--pink);border-color:#5b3548;background:#20131a}.pill.ways{color:var(--blue);border-color:#345067;background:#101b22}.pill.full{color:var(--ok);border-color:#3c5134;background:#11190f}.pill.core{color:#d6d6d8}.pill.source{color:#e5e5c9;border-color:#4b4b38;background:#17170f}.health{display:flex;gap:4px}.health span{display:grid;place-items:center;min-width:25px;height:25px;padding:0 6px;border:1px solid #333;border-radius:7px;color:#666;font-size:9px;font-weight:900}.health span.on{color:var(--ok);border-color:#3c5134;background:#11190f}.corecount{display:inline-flex;align-items:center;border:1px solid #4c512d;border-radius:8px;padding:5px 8px;background:#17180f;color:#e6ff78;font-weight:900}.phead{padding:16px;border-bottom:1px solid #29292d;background:#151517}.gamehead h2{font-size:30px;line-height:1.12;margin:7px 0}.gamehead .badges{display:flex;gap:6px;flex-wrap:wrap}.pbody{padding:14px}.note{padding:11px 12px;border:1px solid #3b3b2b;border-radius:10px;background:#15150f;color:#cdcca0;font-size:11px;line-height:1.65;margin-bottom:12px}.metaGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.metaBox{padding:11px;border:1px solid #2e2e32;border-radius:10px;background:#0e0e10;min-width:0}.metaBox small{display:block;color:#7f7f84;font-size:9px;margin-bottom:5px}.metaBox div{word-break:break-word}.setgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:12px}.set{padding:11px;border:1px solid #2c2c30;border-radius:10px;background:#0e0e10}.set small{display:block;color:#777;font-size:9px}.set b{display:block;font-size:18px;margin-top:5px}.set.yes b{color:var(--ok)}.section{margin-top:14px;border:1px solid #303034;border-radius:12px;overflow:hidden}.sectionTitle{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid #28282b;background:#151517}.sectionTitle b{font-size:11px}.sectionTitle span{margin-left:auto;color:#777;font-size:10px}.articleList,.refList{display:grid;gap:8px;padding:10px}.article,.ref{border:1px solid #303034;border-radius:10px;background:#0e0e10;padding:12px}.article h3{font-size:15px;line-height:1.4;margin:6px 0}.article p{margin:8px 0;color:#aaa;font-size:11px;line-height:1.6}.articleMeta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;color:#888;font-size:9px}.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.actions .btn{min-height:34px;padding:7px 10px;font-size:10px}.allgrid{display:grid;gap:9px}.allarticle{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:12px;background:#111113}.allarticle h3{margin:4px 0;font-size:16px}.gamechips{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.chip{font-size:9px;border:1px solid #3d4038;border-radius:999px;padding:4px 7px;background:#1b1d18;color:#d1d0c4}.showcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}.showcard{border:1px solid var(--line);border-radius:12px;background:#111113;padding:14px}.json{white-space:pre-wrap;word-break:break-word;font:10px/1.55 ui-monospace,monospace;color:#aaa;max-height:230px;overflow:auto;background:#09090b;padding:9px;border-radius:8px}@media(max-width:1200px){.stats{grid-template-columns:repeat(3,1fr)}.workspace{grid-template-columns:1fr}.detail{position:relative;top:auto;max-height:none}.scroll{max-height:55vh}.controls{grid-template-columns:1fr 1fr}.tabs{grid-column:1/-1}}@media(max-width:720px){.page{padding:10px}.stats{grid-template-columns:1fr 1fr}.topin{flex-wrap:wrap}.brand{width:100%}.controls{grid-template-columns:1fr}.setgrid,.metaGrid{grid-template-columns:1fr 1fr}.allarticle{grid-template-columns:1fr}}
</style>
</head>
<body>
<section id="login" class="login"><form id="loginForm" class="loginbox"><div class="eyebrow">HARF-WAY / CORE-FIRST DATABASE CONSOLE</div><h1>DB<br>MASTER</h1><p class="muted tiny">Shared Content Coreを作品の本体にして、記事・WAYS・プレイリスト・ヨリミチを横断表示します。</p><input id="key" type="password" autocomplete="current-password" placeholder="管理キー"/><div id="loginMsg" class="muted tiny"></div><button class="btn primary" style="width:100%;margin-top:10px" type="submit">開く</button></form></section>
<div id="app" class="hide"><header class="top"><div class="topin"><div class="brand">HARF-WAY <b>DB MASTER / CORE FIRST</b></div><span id="connection" class="muted tiny">接続中…</span><button id="reload" class="btn">再読込</button><a class="btn" href="/salvage/">Salvager ↗</a><a class="btn" href="/salvage/library/">Library ↗</a><a class="btn" href="/db-master/">WAYS編集 ↗</a><button id="logout" class="btn">ログアウト</button></div></header><main class="page"><section id="stats" class="stats"></section><div class="controls"><div class="tabs"><button class="tab on" data-tab="games">CORE GAMES</button><button class="tab" data-tab="articles">ARTICLES</button><button class="tab" data-tab="showcases">SHOWCASES</button></div><input id="search" placeholder="作品名 / ID / URL / 記事名で検索"/><select id="setFilter"><option value="all">素材状態：すべて</option><option value="article-only">ARTICLE ONLY</option><option value="video-article">VIDEO + ARTICLE</option><option value="ways-only">WAYS ONLY</option><option value="core-only">CORE ONLY</option></select><select id="sourceFilter"><option value="all">起点：すべて</option><option value="archive-salvager">記事 / SALVAGER</option><option value="ways">WAYS</option><option value="playlist">PLAYLIST</option><option value="yorimichi">ヨリミチ</option></select><span id="count" class="muted tiny"></span></div><section id="gamesView" class="workspace"><div class="panel scroll" id="gameTable"></div><aside class="panel detail" id="detail"><div class="empty">作品を選択してください。</div></aside></section><section id="articlesView" class="hide"><div id="articleGrid" class="allgrid"></div></section><section id="showcasesView" class="hide"><div id="showcards" class="showcards"></div></section></main></div>
<script is:inline>
(()=>{
const KEY='hw-db-master-admin-key';const $=s=>document.querySelector(s);let key=sessionStorage.getItem(KEY)||'';let data={state:{games:[],showcases:[]},core:{games:[],articles:[],summary:{}}};let selected='';let tab='games';
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const nt=v=>String(v||'').normalize('NFKC').toLowerCase().replace(/[\s:：・!！?？'"“”‘’()（）\[\]【】_\-–—～~]+/g,'');
const arr=v=>Array.isArray(v)?v:[];const gameRefId=x=>String(x?.gameId||x?.game_id||x?.id||'');const gameRefTitle=x=>String(x?.title||x?.name||x?.gameTitle||x?.game_title||'');
function login(msg=''){ $('#login').classList.remove('hide');$('#app').classList.add('hide');$('#loginMsg').textContent=msg }
async function api(){const r=await fetch('/api/db-master',{cache:'no-store',headers:{'x-showcase-admin-key':key}});let j={};try{j=await r.json()}catch{}if(r.status===401){sessionStorage.removeItem(KEY);key='';login('管理キーを確認してください。');throw Error('unauthorized')}if(!r.ok)throw Error(j.error||`HTTP ${r.status}`);return j}
function refsOf(g){return arr(g?.refs)}function waysRef(g){return refsOf(g).find(r=>r?.service==='ways')||null}
function waysGame(g){const wr=waysRef(g);const id=String(wr?.externalId||g?.id||'');const direct=arr(data.state?.games).find(x=>String(x?.id||'')===id);if(direct)return direct;const t=nt(g?.title);const matches=arr(data.state?.games).filter(x=>nt(x?.title)===t);return matches.length===1?matches[0]:null}
function videoUrl(g){const wg=waysGame(g),wr=waysRef(g);return String(wg?.video||wg?.video_url||wr?.metadata?.video_url||'')}
function articleRefs(a){return arr(a?.games)}function articlesFor(g){const id=String(g?.id||''),title=nt(g?.title);return arr(data.core?.articles).filter(a=>articleRefs(a).some(r=>{const rid=gameRefId(r),rt=nt(gameRefTitle(r));return (rid&&rid===id)||(rt&&title&&rt===title)}))}
function hasArticle(g){return articlesFor(g).length>0||Boolean(g?.articleUrl)}function setType(g){const v=Boolean(videoUrl(g)),a=hasArticle(g);if(v&&a)return 'video-article';if(a)return 'article-only';if(v)return 'ways-only';return 'core-only'}
function setLabel(g){return {'video-article':'VIDEO + ARTICLE','article-only':'ARTICLE ONLY','ways-only':'WAYS ONLY','core-only':'CORE ONLY'}[setType(g)]}
function setClass(g){return {'video-article':'full','article-only':'article','ways-only':'ways','core-only':'core'}[setType(g)]}
function date(v){if(!v)return '—';try{return new Date(v).toLocaleDateString('ja-JP')}catch{return String(v)}}
function sourceServices(g){return [...new Set([g?.sourceOfTruth,...refsOf(g).map(r=>r?.service)].filter(Boolean))]}
function stats(){const games=arr(data.core?.games),arts=arr(data.core?.articles);const articleOrigin=games.filter(g=>g.sourceOfTruth==='archive-salvager').length;const video=games.filter(g=>Boolean(videoUrl(g))).length;const articleOnly=games.filter(g=>setType(g)==='article-only').length;$('#stats').innerHTML=[['CORE GAMES',games.length],['ARTICLE ORIGIN',articleOrigin],['WAYS VIDEO',video],['CORE ARTICLES',arts.length],['ARTICLE ONLY',articleOnly]].map(([a,b])=>`<div class="stat"><small>${a}</small><b>${b}</b></div>`).join('')}
function filteredGames(){const q=nt($('#search').value),sf=$('#setFilter').value,src=$('#sourceFilter').value;return arr(data.core?.games).filter(g=>(sf==='all'||setType(g)===sf)&&(src==='all'||sourceServices(g).includes(src))&&(!q||[g.title,g.id,g.storeUrl,g.articleUrl,g.category,g.sourceOfTruth,...sourceServices(g)].some(x=>nt(x).includes(q))||articlesFor(g).some(a=>nt(`${a.title} ${a.url}`).includes(q))))}
function health(g){const v=Boolean(videoUrl(g)),a=hasArticle(g),s=Boolean(g.storeUrl);return `<div class="health"><span class="${v?'on':''}">V</span><span class="${a?'on':''}">A</span><span class="${s?'on':''}">S</span></div>`}
function renderGames(){const games=filteredGames();$('#count').textContent=`表示 ${games.length} / Core ${arr(data.core?.games).length}作品`;if(!games.length){$('#gameTable').innerHTML='<div class="empty">条件に一致するCore作品はありません。</div>';return}$('#gameTable').innerHTML=`<table><thead><tr><th>素材状態</th><th>作品</th><th>起点</th><th>SET</th><th>記事</th><th>更新</th></tr></thead><tbody>${games.map(g=>{const aa=articlesFor(g);return `<tr data-id="${esc(g.id)}" class="${selected===g.id?'on':''}"><td><span class="pill ${setClass(g)}">${setLabel(g)}</span></td><td><div class="title">${esc(g.title||'名称未設定')}</div><div class="idline">${esc(g.id)}</div></td><td><span class="pill source">${esc(g.sourceOfTruth||'core')}</span></td><td>${health(g)}</td><td><span class="corecount">${aa.length}</span></td><td class="muted tiny">${date(g.updatedAt)}</td></tr>`}).join('')}</tbody></table>`;$('#gameTable').querySelectorAll('tr[data-id]').forEach(r=>r.onclick=()=>{selected=r.dataset.id;renderGames();renderDetail()})}
function articleCard(a){return `<article class="article"><div class="articleMeta"><span class="pill ${a.status==='draft'?'core':'full'}">${esc(a.status||'saved')}</span><span>${date(a.publishedAt)}</span><span>${esc(a.source||'')}</span></div><h3>${esc(a.title||'Untitled')}</h3><p>${esc(String(a.excerpt||'').slice(0,220))}</p><div class="actions"><a class="btn" href="${esc(a.url)}" target="_blank" rel="noreferrer">元記事 ↗</a><a class="btn primary" href="/salvage/?url=${encodeURIComponent(a.url)}">Salvagerで再編集</a></div></article>`}
function renderDetail(){const g=arr(data.core?.games).find(x=>x.id===selected);if(!g){$('#detail').innerHTML='<div class="empty">作品を選択してください。</div>';return}const aa=articlesFor(g),wg=waysGame(g),v=videoUrl(g),refs=refsOf(g),services=sourceServices(g);const isArticleOrigin=g.sourceOfTruth==='archive-salvager';const note=isArticleOrigin&&!v?'この記事から新規登録されたCore作品です。動画がなくてもDBの正式作品として扱われています。あとからWAYSを追加すると同じ作品に素材が増えます。':'Shared Content Coreを本体として、各コンテンツの素材を横断表示しています。';$('#detail').innerHTML=`<div class="phead"><div class="gamehead"><div class="eyebrow">CORE GAME</div><h2>${esc(g.title||'名称未設定')}</h2><div class="badges"><span class="pill ${setClass(g)}">${setLabel(g)}</span>${services.map(s=>`<span class="pill source">${esc(s)}</span>`).join('')}</div></div></div><div class="pbody"><div class="note">${esc(note)}</div><div class="metaGrid"><div class="metaBox"><small>CORE ID</small><div>${esc(g.id)}</div></div><div class="metaBox"><small>SOURCE OF TRUTH</small><div>${esc(g.sourceOfTruth||'—')}</div></div><div class="metaBox"><small>STORE</small><div>${g.storeUrl?`<a href="${esc(g.storeUrl)}" target="_blank" style="color:#fff">${esc(g.storeUrl)}</a>`:'—'}</div></div><div class="metaBox"><small>WAYS ID</small><div>${esc(wg?.id||waysRef(g)?.externalId||'未作成')}</div></div></div><div class="setgrid"><div class="set ${v?'yes':''}"><small>VIDEO</small><b>${v?'1':'0'}</b></div><div class="set ${aa.length||g.articleUrl?'yes':''}"><small>ARTICLE</small><b>${aa.length||Number(Boolean(g.articleUrl))}</b></div><div class="set ${g.storeUrl?'yes':''}"><small>STORE</small><b>${g.storeUrl?'1':'0'}</b></div><div class="set ${refs.length?'yes':''}"><small>REFS</small><b>${refs.length}</b></div></div>${v?`<div class="section"><div class="sectionTitle"><b>WAYS / VIDEO</b><span>接続済み</span></div><div class="refList"><div class="ref"><div class="muted tiny">${esc(v)}</div><div class="actions"><a class="btn" href="${esc(v)}" target="_blank">動画を開く ↗</a><a class="btn primary" href="/db-master/">WAYS側を編集 ↗</a></div></div></div></div>`:`<div class="section"><div class="sectionTitle"><b>WAYS / VIDEO</b><span>0</span></div><div class="empty" style="padding:24px">WAYS動画はまだありません。記事だけでもCore作品として保持されます。</div></div>`}<div class="section"><div class="sectionTitle"><b>ARTICLES</b><span>${aa.length}</span></div>${aa.length?`<div class="articleList">${aa.map(articleCard).join('')}</div>`:`<div class="empty" style="padding:24px">Core記事リンクはありません。${g.articleUrl?`<div class="actions" style="justify-content:center"><a class="btn" href="${esc(g.articleUrl)}" target="_blank">登録記事を開く ↗</a></div>`:''}</div>`}</div><div class="section"><div class="sectionTitle"><b>CONTENT REFS</b><span>${refs.length}</span></div>${refs.length?`<div class="refList">${refs.map(r=>`<div class="ref"><b>${esc(r.service||'ref')}</b><div class="muted tiny" style="margin-top:5px">${esc(r.externalId||'')}</div>${r.externalUrl?`<div class="actions"><a class="btn" href="${esc(r.externalUrl)}" target="_blank">参照先 ↗</a></div>`:''}</div>`).join('')}</div>`:'<div class="empty" style="padding:24px">外部コンテンツ参照はありません。</div>'}</div></div>`}
function renderArticles(){const q=nt($('#search').value);const arts=arr(data.core?.articles).filter(a=>!q||nt(`${a.title} ${a.url} ${articleRefs(a).map(gameRefTitle).join(' ')}`).includes(q));$('#count').textContent=`Core Articles ${arts.length}`;$('#articleGrid').innerHTML=arts.length?arts.map(a=>`<article class="allarticle"><div><div class="eyebrow">${esc(a.status||'saved')}</div><h3>${esc(a.title)}</h3><div class="muted tiny">${date(a.publishedAt)} / ${esc(a.url)}</div><div class="gamechips">${articleRefs(a).map(r=>`<span class="chip">${esc(gameRefTitle(r)||gameRefId(r))}</span>`).join('')}</div></div><div class="actions"><a class="btn" href="${esc(a.url)}" target="_blank">元記事 ↗</a><a class="btn primary" href="/salvage/?url=${encodeURIComponent(a.url)}">再編集</a></div></article>`).join(''):'<div class="empty">記事はありません。</div>'}
function renderShowcases(){const s=arr(data.state?.showcases);$('#count').textContent=`Showcases ${s.length}`;$('#showcards').innerHTML=s.length?s.map((x,i)=>`<article class="showcard"><div class="eyebrow">SHOWCASE ${i+1}</div><h3>${esc(x.title||x.name||x.id||'名称未設定')}</h3><div class="json">${esc(JSON.stringify(x,null,2))}</div></article>`).join(''):'<div class="empty">ショーケースはありません。</div>'}
function render(){stats();$('#gamesView').classList.toggle('hide',tab!=='games');$('#articlesView').classList.toggle('hide',tab!=='articles');$('#showcasesView').classList.toggle('hide',tab!=='showcases');if(tab==='games'){renderGames();renderDetail()}if(tab==='articles')renderArticles();if(tab==='showcases')renderShowcases()}
async function load(){try{$('#connection').textContent='Core + WAYS 読込中…';data=await api();if(!data.core?.games)data.core={...(data.core||{}),games:[],articles:arr(data.core?.articles)};$('#login').classList.add('hide');$('#app').classList.remove('hide');$('#connection').textContent=`CORE ${arr(data.core.games).length}作品 / WAYS ${arr(data.state?.games).length}作品`;if(selected&&!arr(data.core.games).some(g=>g.id===selected))selected='';render()}catch(e){if(e.message!=='unauthorized')$('#connection').textContent='読込エラー: '+e.message}}
$('#loginForm').onsubmit=e=>{e.preventDefault();key=$('#key').value.trim();if(!key)return;sessionStorage.setItem(KEY,key);load()};$('#reload').onclick=load;$('#logout').onclick=()=>{sessionStorage.removeItem(KEY);key='';location.reload()};$('#search').oninput=render;$('#setFilter').onchange=render;$('#sourceFilter').onchange=render;document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('on',x===b));render()});if(key)load();
})();
</script>
</body>
</html>