---
const isProduction = process.env.VERCEL_ENV === 'production';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content={isProduction ? 'index,follow' : 'noindex,nofollow,noarchive'} />
  <meta name="theme-color" content="#101310" />
  <title>PLAY NOTES / HARF-WAY</title>
  <style is:global>
    :root{--bg:#101310;--paper:#f0eee6;--ink:#1c211d;--muted:#687068;--line:#c8c8bd;--accent:#dff238;--dark:#151a16;--soft:#e7e5dd}
    *{box-sizing:border-box}
    html,body{margin:0;background:var(--bg);color:var(--paper);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}
    a{color:inherit}.shell{width:min(1080px,calc(100% - 34px));margin:auto;padding:44px 0 80px}
    .mast{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;border-bottom:1px solid #374039;padding-bottom:22px;margin-bottom:32px}
    .eyebrow{font:800 11px ui-monospace,monospace;letter-spacing:.18em;color:var(--accent)}
    h1{margin:7px 0 0;font-size:clamp(42px,8vw,82px);line-height:.88;letter-spacing:-.06em}.mast p{max-width:360px;margin:0;color:#9ba39c;font-size:12px;line-height:1.8;text-align:right}
    .list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.card{display:block;text-decoration:none;background:#171c18;border:1px solid #303831;border-radius:14px;padding:22px;transition:.15s transform,.15s border-color;position:relative;overflow:hidden}.card:before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--accent);opacity:.7}.card:hover{transform:translateY(-3px);border-color:#7c8a7d}.card small{font:800 10px ui-monospace,monospace;color:#9ba39c}.card h2{font-size:25px;line-height:1.2;margin:10px 0 12px}.card p{margin:0;color:#bcc3bc;font-size:13px;line-height:1.75;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.pill{border:1px solid #445045;border-radius:999px;padding:6px 8px;color:#aeb7af;font-size:10px;font-weight:800}.pill.ways{border-color:#788321;color:var(--accent)}.pill.progress{border-color:#6a765f;color:#cfd9c7;background:#1b211b}
    .empty{border:1px dashed #3e473f;border-radius:14px;padding:50px 22px;text-align:center;color:#8e978f}.detail{display:none}.detail.on{display:block}.index.hidden{display:none}.back{display:inline-flex;align-items:center;gap:7px;text-decoration:none;color:#b8c1b9;font-size:12px;margin-bottom:22px}
    .article{background:var(--paper);color:var(--ink);border-radius:18px;overflow:hidden;box-shadow:0 24px 90px #0005;border:1px solid #d7d6cc}.hero{padding:clamp(30px,7vw,72px);padding-bottom:30px;position:relative}.hero:after{content:"";position:absolute;left:clamp(30px,7vw,72px);right:clamp(30px,7vw,72px);bottom:0;height:1px;background:var(--line)}.hero-top{display:flex;justify-content:space-between;gap:18px;align-items:center}.hero .eyebrow{color:#5a665b}.state-chip{display:inline-flex;align-items:center;gap:7px;font:900 10px ui-monospace,monospace;letter-spacing:.08em;color:#42503f}.state-chip:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px #dff23833}.hero h2{font-size:clamp(38px,7vw,70px);line-height:1.05;letter-spacing:-.045em;margin:14px 0 22px;max-width:17ch}.hero-lead{max-width:590px;font-size:12px;line-height:1.8;color:#727a72;margin:0}
    .log-strip{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;background:#1c211d;color:#f0eee6;border-top:1px solid #2d352e;border-bottom:1px solid #2d352e}.log-cell{padding:13px 18px;border-right:1px solid #394239;min-width:0}.log-cell:last-child{border-right:0}.log-cell b{display:block;font:800 9px ui-monospace,monospace;letter-spacing:.13em;color:#899489;margin-bottom:5px}.log-cell span{display:block;font-size:12px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.log-cell.state span{color:var(--accent)}
    .note-body{display:grid;grid-template-columns:120px minmax(0,1fr);gap:24px;padding:clamp(34px,7vw,72px)}.note-rail{padding-top:7px}.rail-label{font:900 10px ui-monospace,monospace;letter-spacing:.12em;color:#6f786e}.rail-line{width:36px;height:3px;background:var(--accent);margin:12px 0}.rail-copy{font-size:10px;line-height:1.7;color:#8a9189}.copy{font-size:20px;line-height:2;white-space:pre-wrap;max-width:39em}.copy::first-line{font-weight:700}
    .ways{padding:0 clamp(30px,7vw,72px) clamp(38px,7vw,72px)}.ways-head{border-top:1px solid var(--line);padding-top:28px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:end;gap:16px}.ways-title small{display:block;font:900 9px ui-monospace,monospace;letter-spacing:.12em;color:#717a71;margin-bottom:6px}.ways-title b{display:block;font-size:21px;letter-spacing:-.03em}.ways-head>span{font-size:11px;color:#777}.ways-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.ways-card{border:1px solid #c6c8bd;border-radius:12px;overflow:hidden;background:var(--soft);position:relative}.ways-card:before{content:"PLAYBACK";position:absolute;z-index:2;top:10px;left:10px;background:var(--accent);color:#20271f;padding:5px 7px;border-radius:999px;font:900 9px ui-monospace,monospace;letter-spacing:.08em}.ways-card video{display:block;width:100%;aspect-ratio:16/9;object-fit:contain;background:#050505}.ways-info{padding:14px}.ways-info strong{display:block;font-size:15px;margin-bottom:9px}.ways-info a{display:inline-flex;align-items:center;gap:6px;background:#1c211d;color:#f3f2e9;text-decoration:none;border-radius:999px;padding:9px 12px;font-size:10px;font-weight:900}.ways-info a:hover{background:#2b342c}.end-mark{padding:0 clamp(30px,7vw,72px) clamp(38px,7vw,58px);font:900 10px ui-monospace,monospace;letter-spacing:.1em;color:#7c847c}.end-mark span{color:#475347}.foot{color:#798179;font-size:10px;text-align:center;margin-top:28px}.loading{padding:40px;text-align:center;color:#929b93}
    @media(max-width:720px){.shell{width:min(100% - 20px,1080px);padding-top:25px}.mast{grid-template-columns:1fr}.mast p{text-align:left}.list,.ways-grid{grid-template-columns:1fr}.hero{padding:30px 22px 24px}.hero:after{left:22px;right:22px}.hero h2{font-size:38px}.hero-top{align-items:flex-start}.log-strip{grid-template-columns:1fr 1fr}.log-cell:nth-child(2){border-right:0}.log-cell:nth-child(-n+2){border-bottom:1px solid #394239}.note-body{grid-template-columns:1fr;gap:15px;padding:30px 22px}.note-rail{display:grid;grid-template-columns:auto 36px 1fr;align-items:center;gap:10px;padding:0}.rail-line{margin:0}.rail-copy{font-size:9px}.copy{font-size:18px;line-height:1.9}.ways{padding:0 22px 32px}.end-mark{padding:0 22px 34px}}
  </style>
</head>
<body>
  <main class="shell">
    <section class="index" id="index-view">
      <header class="mast"><div><div class="eyebrow">HARF-WAY / PLAY LOG</div><h1>PLAY<br>NOTES</h1></div><p>遊んでいる途中で拾った、小さな発見や考えごと。レビューになる前の記録を、そのまま読める場所です。</p></header>
      <div id="notes-list" class="list"><div class="loading">公開メモを読み込み中…</div></div>
    </section>
    <section class="detail" id="detail-view"><a class="back" href="/notes/">← PLAY NOTES</a><div id="detail-root"><div class="loading">メモを読み込み中…</div></div></section>
    <div class="foot">HARF-WAY / NOTES FROM PLAY</div>
  </main>
<script>
(() => {
  const API='/api/game-note-publications',WAYS='/api/games-live';
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt=v=>{try{return new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric'}).format(new Date(v))}catch{return''}};
  const id=new URLSearchParams(location.search).get('note')||'';
  async function data(){const r=await fetch(API,{cache:'no-store'});if(!r.ok)throw new Error('notes_load_failed');return r.json()}
  async function ways(){try{const r=await fetch(WAYS,{cache:'no-store'});const d=await r.json();return Array.isArray(d.entries)?d.entries:[]}catch{return[]}}
  function card(n){return `<a class="card" href="/notes/?note=${encodeURIComponent(n.id)}"><small>${esc(n.gameName||'PLAY NOTE')} · ${esc(fmt(n.publishedAt))}</small><h2>${esc(n.title||'無題')}</h2><p>${esc(n.body||'')}</p><div class="meta">${n.typeName?`<span class="pill">${esc(n.typeName)}</span>`:''}<span class="pill progress">STILL IN PROGRESS</span>${n.relatedWaysIds?.length?`<span class="pill ways">WAYS ${n.relatedWaysIds.length}</span>`:''}</div></a>`}
  async function render(){
    try{
      const d=await data(),entries=d.entries||[];
      if(!id){document.getElementById('notes-list').innerHTML=entries.length?entries.map(card).join(''):'<div class="empty" style="grid-column:1/-1">公開中のPLAY NOTEはまだありません。</div>';return}
      document.getElementById('index-view').classList.add('hidden');document.getElementById('detail-view').classList.add('on');
      const n=entries.find(x=>String(x.id)===String(id));if(!n){document.getElementById('detail-root').innerHTML='<div class="empty">この公開メモは見つかりませんでした。</div>';return}
      document.title=`${n.title||'PLAY NOTE'} / HARF-WAY`;
      const xs=await ways(),related=(n.relatedWaysIds||[]).map(rid=>xs.find(x=>String(x.id)===String(rid))).filter(Boolean);
      const relatedHtml=related.length?`<section class="ways"><div class="ways-head"><div class="ways-title"><small>FROM THIS NOTE</small><b>この時のプレイ</b></div><span>メモと同じ場面を、映像で見る</span></div><div class="ways-grid">${related.map(x=>`<article class="ways-card"><video controls playsinline preload="metadata" ${x.thumbnailUrl?`poster="${esc(x.thumbnailUrl)}"`:''} src="${esc(x.video||'')}"></video><div class="ways-info"><strong>${esc(x.title||'')}</strong><a href="/?game=${encodeURIComponent(x.id)}">WAYSでこの動画を見る →</a></div></article>`).join('')}</div></section>`:'';
      document.getElementById('detail-root').innerHTML=`<article class="article"><header class="hero"><div class="hero-top"><div class="eyebrow">HARF-WAY / PLAY NOTE</div><div class="state-chip">STILL IN PROGRESS</div></div><h2>${esc(n.title||'無題')}</h2><p class="hero-lead">遊んでいる途中で残したメモです。結論ではなく、その時点で見えていたものをそのまま置いています。</p></header><div class="log-strip"><div class="log-cell"><b>GAME</b><span>${esc(n.gameName||'—')}</span></div><div class="log-cell"><b>TYPE</b><span>${esc(n.typeName||'PLAY NOTE')}</span></div><div class="log-cell"><b>DATE</b><span>${esc(fmt(n.publishedAt)||'—')}</span></div><div class="log-cell state"><b>STATE</b><span>IN PROGRESS</span></div></div><section class="note-body"><aside class="note-rail"><div class="rail-label">PLAYING NOTE</div><div class="rail-line"></div><div class="rail-copy">まだ途中。<br>あとで見え方が変わってもいい。</div></aside><div class="copy">${esc(n.body||'')}</div></section>${relatedHtml}<div class="end-mark">END OF THIS NOTE <span>— TO BE CONTINUED</span></div></article>`;
    }catch{document.getElementById(id?'detail-root':'notes-list').innerHTML='<div class="empty">読み込みに失敗しました。</div>'}
  }
  render();
})();
</script>
</body>
</html>
