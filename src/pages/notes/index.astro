---
const isProduction = process.env.VERCEL_ENV === 'production';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content={isProduction ? 'index,follow' : 'noindex,nofollow,noarchive'} />
  <meta name="theme-color" content="#1a1b17" />
  <title>プレイノート / HARF-WAY</title>
  <style is:global>
    :root{--bg:#1a1b17;--paper:#f2eddf;--paper2:#e7dfcd;--ink:#22241f;--muted:#6d7068;--line:#aaa493;--accent:#dff238;--deep:#252822}
    *{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:#f4f0e6;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.shell{width:min(1120px,calc(100% - 28px));margin:auto;padding:28px 0 72px}.index.hidden{display:none}.detail{display:none}.detail.on{display:block}.back{display:inline-flex;text-decoration:none;font-size:12px;font-weight:800;color:#b5baae;margin:0 0 14px}.foot{text-align:center;margin-top:18px;font-size:10px;letter-spacing:.08em;color:#7a8076}.loading,.empty{padding:52px 20px;text-align:center;color:#7d8279}
    .paper{background:var(--paper);color:var(--ink);border:1px solid #d2cbb9;box-shadow:0 26px 90px #0007;position:relative;overflow:hidden}.paper:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.17;background-image:linear-gradient(#7c735c12 1px,transparent 1px),linear-gradient(90deg,#7c735c0c 1px,transparent 1px);background-size:5px 5px;mix-blend-mode:multiply}.paper:after{content:"";position:absolute;left:50%;top:0;bottom:0;width:1px;background:#9e97851f;pointer-events:none}
    .masthead{position:relative;z-index:1;padding:20px 28px 14px;border-bottom:4px double var(--ink)}.mast-kicker{display:flex;justify-content:space-between;gap:18px;font-size:9px;font-weight:900;letter-spacing:.12em;color:#62675f}.mast-title{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,380px);gap:28px;align-items:end;margin-top:9px}.mast-title h1{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(48px,8vw,90px);line-height:.88;letter-spacing:-.075em;margin:0}.mast-title p{margin:0 0 4px;font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:13px;line-height:1.8;color:#5e625b;text-align:justify}.strap{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;border-bottom:1px solid var(--line)}.strap div{padding:9px 13px;border-right:1px solid var(--line);font-size:10px;font-weight:900}.strap div:last-child{border-right:0}.strap b{display:block;font-size:8px;letter-spacing:.1em;color:#777b72;margin-bottom:3px}.strap .hot{background:var(--accent);color:#22281e}.strap .hot b{color:#56603c}
    .page-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:0;padding:0 28px 28px}.clipping{display:block;text-decoration:none;color:var(--ink);padding:22px 18px 22px 0;border-bottom:1px solid var(--line);border-right:1px solid var(--line);min-height:220px;position:relative}.clipping:nth-child(6n+1){grid-column:span 7}.clipping:nth-child(6n+2){grid-column:span 5;padding-left:18px;border-right:0}.clipping:nth-child(6n+3){grid-column:span 4}.clipping:nth-child(6n+4){grid-column:span 4;padding-left:18px}.clipping:nth-child(6n+5){grid-column:span 4;padding-left:18px;border-right:0}.clipping:nth-child(6n+6){grid-column:span 12;border-right:0}.clipping:before{content:"記録";display:inline-block;background:var(--ink);color:var(--paper);padding:4px 7px;margin-bottom:12px;font-size:9px;font-weight:900;letter-spacing:.08em}.clipping.has-video:before{content:"映像あり";background:var(--accent);color:#28301f}.clipping-meta{display:flex;gap:8px;flex-wrap:wrap;font-size:9px;font-weight:900;color:#73776e;margin-bottom:8px}.clipping h2{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(20px,2.3vw,30px);line-height:1.35;margin:0 0 10px;letter-spacing:-.03em}.clipping p{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:16px;line-height:1.9;margin:0;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden}.clipping-foot{display:flex;justify-content:space-between;gap:10px;margin-top:16px;padding-top:8px;border-top:1px dotted #9c9688;font-size:9px;font-weight:800;color:#72766e}.clipping-foot .state{color:#465221;background:#e1ed85;padding:3px 6px}
    .single{position:relative;z-index:1;padding:0 28px 28px}.single-layout{display:grid;grid-template-columns:160px minmax(0,1fr);border-bottom:1px solid var(--line)}.side-col{border-right:1px solid var(--line);padding:22px 18px 22px 0}.side-label{font-size:9px;font-weight:900;letter-spacing:.1em;color:#6d7168;margin-bottom:18px}.side-data{display:grid;gap:16px}.side-data div{padding-top:8px;border-top:1px solid var(--line)}.side-data b{display:block;font-size:8px;letter-spacing:.08em;color:#7b7e75;margin-bottom:5px}.side-data span{display:block;font-size:11px;font-weight:900;line-height:1.5}.side-state{display:inline-block!important;background:var(--accent);padding:5px 7px;width:max-content}.main-post{padding:26px 0 30px 28px}.post-mark{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:18px}.post-mark strong{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:15px}.post-mark span{font-size:9px;font-weight:900;color:#777b72}.post-title{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(22px,3vw,38px);line-height:1.35;margin:0 0 18px;letter-spacing:-.03em}.post-copy{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(19px,2.3vw,26px);line-height:2;letter-spacing:.015em;white-space:pre-wrap;margin:0;max-width:31em}.post-copy:before{content:"「";font-size:2.2em;line-height:0;vertical-align:-.18em;margin-right:2px;color:#77766e}.post-copy:after{content:"」";font-size:2.2em;line-height:0;vertical-align:-.18em;margin-left:2px;color:#77766e}.post-note{margin-top:23px;border-top:1px dotted #989181;padding-top:10px;font-size:10px;line-height:1.7;color:#6c7068}.post-note b{color:#30342e}
    .media-section{padding:26px 0 4px}.media-head{display:grid;grid-template-columns:160px minmax(0,1fr);border-top:4px double var(--ink);border-bottom:1px solid var(--line);margin-bottom:0}.media-head>div{padding:12px 14px 12px 0}.media-head>div:first-child{border-right:1px solid var(--line);font-size:9px;font-weight:900;letter-spacing:.08em}.media-head>div:last-child{padding-left:18px}.media-head h3{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:24px;margin:0}.media-head p{font-size:10px;color:#6f736b;margin:4px 0 0}.media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}.media{border-bottom:1px solid var(--line);border-right:1px solid var(--line);padding:18px 18px 18px 0}.media:nth-child(2n){border-right:0;padding-left:18px}.media video{display:block;width:100%;aspect-ratio:16/9;object-fit:contain;background:#050505;border:1px solid #777166}.caption{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end;padding-top:10px}.caption strong{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:14px}.caption a{font-size:10px;font-weight:900;text-decoration:none;border-bottom:1px solid #33382f;padding-bottom:2px}.caption a:hover{background:var(--accent)}.page-end{display:flex;justify-content:space-between;gap:20px;align-items:end;padding-top:18px;font-size:9px;font-weight:900;color:#6a6e66}.seal{border:2px solid #3f463c;padding:7px 10px;transform:rotate(-2deg);font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:12px;background:#f5efdf}.folio{font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:11px}
    @media(max-width:760px){.shell{width:min(100% - 12px,1120px);padding-top:10px}.paper:after{display:none}.masthead{padding:17px 15px 11px}.mast-title{grid-template-columns:1fr}.mast-title p{margin-top:13px}.strap{grid-template-columns:1fr 1fr}.strap div:nth-child(2){border-right:0}.strap div:nth-child(-n+2){border-bottom:1px solid var(--line)}.page-grid,.single{padding-left:15px;padding-right:15px}.clipping,.clipping:nth-child(n){grid-column:span 12;padding:20px 0;border-right:0;min-height:auto}.single-layout{grid-template-columns:1fr}.side-col{border-right:0;border-bottom:1px solid var(--line);padding:16px 0}.side-data{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 15px}.main-post{padding:22px 0 26px}.post-copy{font-size:20px;line-height:1.85}.media-head{grid-template-columns:1fr}.media-head>div:first-child{border-right:0;border-bottom:1px solid var(--line);padding-right:0}.media-head>div:last-child{padding-left:0}.media-grid{grid-template-columns:1fr}.media,.media:nth-child(2n){border-right:0;padding:16px 0}.caption{grid-template-columns:1fr}.page-end{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <main class="shell">
    <section class="index" id="index-view">
      <div class="paper">
        <header class="masthead">
          <div class="mast-kicker"><span>HARF-WAY　遊びかけ通信</span><span>ゲームの途中で拾ったこと</span></div>
          <div class="mast-title"><h1>プレイノート</h1><p>レビューになる前の感想、試している途中の考え、妙に気になった一場面。完成させず、その時の温度のまま紙面に並べます。</p></div>
        </header>
        <div class="strap"><div><b>紙面</b>遊びかけ通信</div><div><b>内容</b>短いプレイ記録</div><div><b>映像</b>WAYSと連動</div><div class="hot"><b>状態</b>まだ途中</div></div>
        <div id="notes-list" class="page-grid"><div class="loading" style="grid-column:1/-1">公開メモを読み込み中…</div></div>
      </div>
    </section>
    <section class="detail" id="detail-view"><a class="back" href="/notes/">← プレイノート一覧へ</a><div id="detail-root"><div class="loading">メモを読み込み中…</div></div></section>
    <div class="foot">HARF-WAY　遊びかけ通信 / プレイノート</div>
  </main>
<script>
(() => {
  const API='/api/game-note-publications',WAYS='/api/games-live';
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt=v=>{try{return new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric'}).format(new Date(v))}catch{return''}};
  const id=new URLSearchParams(location.search).get('note')||'';
  async function data(){const r=await fetch(API,{cache:'no-store'});if(!r.ok)throw new Error('notes_load_failed');return r.json()}
  async function ways(){try{const r=await fetch(WAYS,{cache:'no-store'});const d=await r.json();return Array.isArray(d.entries)?d.entries:[]}catch{return[]}}
  function card(n){const hasVideo=Boolean(n.relatedWaysIds?.length);return `<a class="clipping ${hasVideo?'has-video':''}" href="/notes/?note=${encodeURIComponent(n.id)}"><div class="clipping-meta"><span>${esc(n.gameName||'ゲーム名なし')}</span><span>・</span><span>${esc(fmt(n.publishedAt))}</span></div><h2>${esc(n.title||'無題')}</h2><p>${esc(n.body||'')}</p><div class="clipping-foot"><span>${esc(n.typeName||'メモ')}</span><span class="state">まだ途中</span>${hasVideo?`<span>映像 ${n.relatedWaysIds.length}本</span>`:''}</div></a>`}
  async function render(){
    try{
      const d=await data(),entries=d.entries||[];
      if(!id){document.getElementById('notes-list').innerHTML=entries.length?entries.map(card).join(''):'<div class="empty" style="grid-column:1/-1">公開中のプレイノートはまだありません。</div>';return}
      document.getElementById('index-view').classList.add('hidden');document.getElementById('detail-view').classList.add('on');
      const n=entries.find(x=>String(x.id)===String(id));if(!n){document.getElementById('detail-root').innerHTML='<div class="empty">このプレイノートは見つかりませんでした。</div>';return}
      document.title=`${n.title||'プレイノート'} / HARF-WAY`;
      const xs=await ways(),related=(n.relatedWaysIds||[]).map(rid=>xs.find(x=>String(x.id)===String(rid))).filter(Boolean);
      const media=related.length?`<section class="media-section"><div class="media-head"><div>このときの映像</div><div><h3>映像で見る</h3><p>このメモに紐づいた実際のプレイ。文章の続きとして再生できます。</p></div></div><div class="media-grid">${related.map(x=>`<article class="media"><video controls playsinline preload="metadata" ${x.thumbnailUrl?`poster="${esc(x.thumbnailUrl)}"`:''} src="${esc(x.video||'')}"></video><div class="caption"><strong>${esc(x.title||'')}</strong><a href="/?game=${encodeURIComponent(x.id)}">WAYSでこの動画を見る →</a></div></article>`).join('')}</div></section>`:'';
      document.getElementById('detail-root').innerHTML=`<article class="paper"><header class="masthead"><div class="mast-kicker"><span>HARF-WAY　遊びかけ通信</span><span>一件のプレイ記録</span></div><div class="mast-title"><h1>プレイノート</h1><p>その時点で思ったことを、その時点のまま残した記録です。</p></div></header><div class="strap"><div><b>作品</b>${esc(n.gameName||'—')}</div><div><b>種類</b>${esc(n.typeName||'メモ')}</div><div><b>公開日</b>${esc(fmt(n.publishedAt)||'—')}</div><div class="hot"><b>状態</b>まだ途中</div></div><div class="single"><div class="single-layout"><aside class="side-col"><div class="side-label">記録票</div><div class="side-data"><div><b>作品</b><span>${esc(n.gameName||'—')}</span></div><div><b>記録の種類</b><span>${esc(n.typeName||'メモ')}</span></div><div><b>公開日</b><span>${esc(fmt(n.publishedAt)||'—')}</span></div><div><b>いまの状態</b><span class="side-state">まだ途中</span></div></div></aside><section class="main-post"><div class="post-mark"><strong>ゲームの途中で、ひとこと。</strong><span>${esc(fmt(n.publishedAt))}</span></div><h2 class="post-title">${esc(n.title||'無題')}</h2><p class="post-copy">${esc(n.body||'')}</p><div class="post-note"><b>※ プレイ中に残した記録です。</b> 後から考えが変わったり、続きを書き足したりすることがあります。</div></section></div>${media}<div class="page-end"><span class="folio">記録番号　${esc(n.id)}</span><span class="seal">つづくかもしれない</span></div></div></article>`;
    }catch{document.getElementById(id?'detail-root':'notes-list').innerHTML='<div class="empty">読み込みに失敗しました。</div>'}
  }
  render();
})();
</script>
</body>
</html>
