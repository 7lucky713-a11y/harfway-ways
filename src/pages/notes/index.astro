---
const isProduction = process.env.VERCEL_ENV === 'production';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content={isProduction ? 'index,follow' : 'noindex,nofollow,noarchive'} />
  <meta name="theme-color" content="#171915" />
  <title>PLAY NOTES / HARF-WAY</title>
  <style is:global>
    :root{--bg:#171915;--paper:#f3f0e6;--paper2:#ebe6d8;--ink:#20231f;--muted:#71766e;--line:#b9b5a8;--accent:#dff238;--dark:#171a16}
    *{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:#f4f2e8;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}a{color:inherit}.shell{width:min(980px,calc(100% - 28px));margin:auto;padding:28px 0 70px}.index.hidden{display:none}.detail{display:none}.detail.on{display:block}.back{display:inline-flex;text-decoration:none;font:800 11px ui-monospace,monospace;letter-spacing:.08em;color:#aeb5aa;margin:0 0 14px}.foot{text-align:center;margin-top:18px;font:800 9px ui-monospace,monospace;letter-spacing:.14em;color:#737b72}.loading,.empty{padding:46px 20px;text-align:center;color:#7d8279}
    .paper{background:var(--paper);color:var(--ink);border:1px solid #d4d0c4;box-shadow:0 24px 80px #0006;position:relative;overflow:hidden}.paper:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.18;background-image:repeating-linear-gradient(0deg,transparent 0 3px,#6d66551a 4px);mix-blend-mode:multiply}
    .masthead{position:relative;z-index:1;padding:22px 28px 15px;border-bottom:4px double var(--ink)}.mast-top{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;font:800 9px ui-monospace,monospace;letter-spacing:.1em;color:#5f655d}.mast-title{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;margin-top:10px}.mast-title h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(46px,8vw,82px);line-height:.82;letter-spacing:-.06em;margin:0}.mast-title p{max-width:330px;margin:0;text-align:right;font-size:11px;line-height:1.65;color:#6b7169}.ticker{position:relative;z-index:1;display:flex;gap:8px;flex-wrap:wrap;padding:9px 28px;border-bottom:1px solid var(--line);font:800 9px ui-monospace,monospace;letter-spacing:.08em;color:#5f655d}.ticker span:after{content:" / ";margin-left:8px;color:#999387}.ticker span:last-child:after{display:none}
    .feed{position:relative;z-index:1;padding:0 28px}.post-card{display:grid;grid-template-columns:54px minmax(0,1fr);gap:15px;padding:24px 0;border-bottom:1px solid var(--line);text-decoration:none}.post-card:last-child{border-bottom:0}.avatar{width:44px;height:44px;border:1px solid #3a4038;border-radius:50%;display:grid;place-items:center;font:900 11px ui-monospace,monospace;background:var(--ink);color:var(--accent)}.post-head{display:flex;gap:8px;flex-wrap:wrap;align-items:baseline;font-size:11px}.post-head strong{font-size:13px}.post-head .handle{font:700 10px ui-monospace,monospace;color:#7d827a}.post-head time{margin-left:auto;font:700 9px ui-monospace,monospace;color:#7d827a}.post-title{font-size:13px;font-weight:900;color:#5c625b;margin:8px 0 5px}.post-copy{font-size:17px;line-height:1.78;margin:0;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}.post-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px;font:800 9px ui-monospace,monospace;color:#6c726b}.post-meta span{border-top:1px solid #aaa698;padding-top:5px}.post-card:hover .post-copy{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
    .single{position:relative;z-index:1;padding:0 28px 28px}.issuebar{display:grid;grid-template-columns:1.3fr 1fr 1fr;border-bottom:1px solid var(--line);font:800 9px ui-monospace,monospace;letter-spacing:.08em;color:#5f655d}.issuebar div{padding:9px 10px;border-right:1px solid var(--line)}.issuebar div:last-child{border-right:0}.tweet{display:grid;grid-template-columns:58px minmax(0,1fr);gap:17px;padding:30px 6px 28px;border-bottom:1px solid var(--line)}.tweet .avatar{width:48px;height:48px}.tweet-head{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap}.tweet-head strong{font-size:14px}.tweet-head .handle{font:800 10px ui-monospace,monospace;color:#737971}.tweet-head time{font:700 10px ui-monospace,monospace;color:#858a82}.tweet-game{font:900 10px ui-monospace,monospace;letter-spacing:.08em;color:#5f655d;margin:10px 0 13px}.tweet-copy{font-size:clamp(20px,2.9vw,29px);line-height:1.75;letter-spacing:.01em;white-space:pre-wrap;margin:0;max-width:31em}.tweet-note{margin-top:20px;display:flex;gap:10px;flex-wrap:wrap;font:800 9px ui-monospace,monospace;color:#6d736b}.tweet-note span{border:1px solid #aaa697;border-radius:999px;padding:6px 9px;background:#f8f5ec}.tweet-note .state{background:var(--accent);border-color:#bdcc2f;color:#273020}
    .attachment{padding:24px 0 6px}.attachment-label{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:10px;border-top:3px double var(--ink);padding-top:10px}.attachment-label b{font-family:Georgia,"Times New Roman",serif;font-size:24px}.attachment-label span{font:800 9px ui-monospace,monospace;color:#70766e}.media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.media{border:1px solid #b9b5a8;background:var(--paper2)}.media video{display:block;width:100%;aspect-ratio:16/9;object-fit:contain;background:#050505}.caption{padding:10px 11px 11px;border-top:1px solid #b9b5a8}.caption strong{display:block;font-size:13px;margin-bottom:7px}.caption a{font:900 9px ui-monospace,monospace;text-decoration:none;border-bottom:1px solid #353a34;padding-bottom:2px}.caption a:hover{background:var(--accent)}.print-foot{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:12px;margin-top:22px;font:800 9px ui-monospace,monospace;letter-spacing:.08em;color:#666c65}.stamp{transform:rotate(-2deg);border:2px solid #424941;padding:5px 8px;font-weight:900;letter-spacing:.08em}
    @media(max-width:720px){.shell{width:min(100% - 14px,980px);padding-top:12px}.masthead{padding:18px 16px 12px}.mast-title{display:block}.mast-title p{text-align:left;margin-top:14px}.ticker,.feed,.single{padding-left:16px;padding-right:16px}.post-card{grid-template-columns:42px minmax(0,1fr);gap:11px}.avatar{width:36px;height:36px;font-size:9px}.post-copy{font-size:16px}.issuebar{grid-template-columns:1fr}.issuebar div{border-right:0;border-bottom:1px solid var(--line)}.issuebar div:last-child{border-bottom:0}.tweet{grid-template-columns:42px minmax(0,1fr);gap:11px;padding-top:22px}.tweet .avatar{width:38px;height:38px}.tweet-copy{font-size:20px;line-height:1.72}.media-grid{grid-template-columns:1fr}.attachment-label{align-items:flex-start;flex-direction:column;gap:4px}.print-foot{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <main class="shell">
    <section class="index" id="index-view">
      <div class="paper">
        <header class="masthead"><div class="mast-top"><span>HARF-WAY / PLAY LOG PAPER</span><span>UNFINISHED THOUGHTS FROM GAMES</span></div><div class="mast-title"><h1>PLAY NOTES</h1><p>遊んでいる途中の気づきを、完成させすぎずに紙面へ。短いメモと映像が並ぶ、小さなプレイ新聞。</p></div></header>
        <div class="ticker"><span>PLAY</span><span>NOTE</span><span>WAYS</span><span>STILL IN PROGRESS</span></div>
        <div id="notes-list" class="feed"><div class="loading">公開メモを読み込み中…</div></div>
      </div>
    </section>
    <section class="detail" id="detail-view"><a class="back" href="/notes/">← PLAY NOTES</a><div id="detail-root"><div class="loading">メモを読み込み中…</div></div></section>
    <div class="foot">HARF-WAY / PLAY NOTES / PAPER SOCIAL LOG</div>
  </main>
<script>
(() => {
  const API='/api/game-note-publications',WAYS='/api/games-live';
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt=v=>{try{return new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric'}).format(new Date(v))}catch{return''}};
  const id=new URLSearchParams(location.search).get('note')||'';
  async function data(){const r=await fetch(API,{cache:'no-store'});if(!r.ok)throw new Error('notes_load_failed');return r.json()}
  async function ways(){try{const r=await fetch(WAYS,{cache:'no-store'});const d=await r.json();return Array.isArray(d.entries)?d.entries:[]}catch{return[]}}
  function card(n){return `<a class="post-card" href="/notes/?note=${encodeURIComponent(n.id)}"><div class="avatar">HW</div><div><div class="post-head"><strong>HARF-WAY</strong><span class="handle">@playnotes</span><time>${esc(fmt(n.publishedAt))}</time></div><div class="post-title">${esc(n.gameName||'PLAY NOTE')} / ${esc(n.title||'無題')}</div><p class="post-copy">${esc(n.body||'')}</p><div class="post-meta"><span>${esc(n.typeName||'NOTE')}</span><span>STILL IN PROGRESS</span>${n.relatedWaysIds?.length?`<span>VIDEO ${n.relatedWaysIds.length}</span>`:''}</div></div></a>`}
  async function render(){
    try{
      const d=await data(),entries=d.entries||[];
      if(!id){document.getElementById('notes-list').innerHTML=entries.length?entries.map(card).join(''):'<div class="empty">公開中のPLAY NOTEはまだありません。</div>';return}
      document.getElementById('index-view').classList.add('hidden');document.getElementById('detail-view').classList.add('on');
      const n=entries.find(x=>String(x.id)===String(id));if(!n){document.getElementById('detail-root').innerHTML='<div class="empty">この公開メモは見つかりませんでした。</div>';return}
      document.title=`${n.title||'PLAY NOTE'} / HARF-WAY`;
      const xs=await ways(),related=(n.relatedWaysIds||[]).map(rid=>xs.find(x=>String(x.id)===String(rid))).filter(Boolean);
      const media=related.length?`<section class="attachment"><div class="attachment-label"><b>Attached Play</b><span>この投稿に紐づいた実際のプレイ</span></div><div class="media-grid">${related.map(x=>`<article class="media"><video controls playsinline preload="metadata" ${x.thumbnailUrl?`poster="${esc(x.thumbnailUrl)}"`:''} src="${esc(x.video||'')}"></video><div class="caption"><strong>${esc(x.title||'')}</strong><a href="/?game=${encodeURIComponent(x.id)}">OPEN IN WAYS →</a></div></article>`).join('')}</div></section>`:'';
      document.getElementById('detail-root').innerHTML=`<article class="paper"><header class="masthead"><div class="mast-top"><span>HARF-WAY / PLAY LOG PAPER</span><span>SINGLE POST</span></div><div class="mast-title"><h1>PLAY NOTES</h1><p>レビューになる前の、途中の投稿。</p></div></header><div class="single"><div class="issuebar"><div>GAME / ${esc(n.gameName||'—')}</div><div>TYPE / ${esc(n.typeName||'NOTE')}</div><div>PRINTED / ${esc(fmt(n.publishedAt)||'—')}</div></div><section class="tweet"><div class="avatar">HW</div><div><div class="tweet-head"><strong>HARF-WAY</strong><span class="handle">@playnotes</span><time>· ${esc(fmt(n.publishedAt))}</time></div><div class="tweet-game">${esc(n.title||'PLAY NOTE')}</div><p class="tweet-copy">${esc(n.body||'')}</p><div class="tweet-note"><span class="state">STILL IN PROGRESS</span><span>${esc(n.gameName||'PLAY')}</span>${related.length?`<span>ATTACHED VIDEO ${related.length}</span>`:''}</div></div></section>${media}<div class="print-foot"><span>NOTE ID / ${esc(n.id)}</span><span class="stamp">TO BE CONTINUED</span></div></div></article>`;
    }catch{document.getElementById(id?'detail-root':'notes-list').innerHTML='<div class="empty">読み込みに失敗しました。</div>'}
  }
  render();
})();
</script>
</body>
</html>
