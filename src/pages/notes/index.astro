---
const isProduction = process.env.VERCEL_ENV === 'production';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content={isProduction ? 'index,follow' : 'noindex,nofollow,noarchive'} />
  <meta name="theme-color" content="#171815" />
  <title>プレイノート / HARF-WAY</title>
  <style is:global>
    :root{--bg:#171815;--paper:#f3efe4;--ink:#252720;--muted:#74776e;--line:#cbc5b7;--accent:#dff238}
    *{box-sizing:border-box}
    html,body{margin:0;background:var(--bg);color:#f4f1e8;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}
    a{color:inherit}
    .shell{width:min(860px,calc(100% - 22px));margin:auto;padding:24px 0 64px}
    .index.hidden{display:none}.detail{display:none}.detail.on{display:block}
    .back{display:inline-block;margin:0 0 12px;text-decoration:none;color:#b8beb3;font-size:12px;font-weight:800}
    .paper{background:var(--paper);color:var(--ink);border:1px solid #d7d1c3;box-shadow:0 22px 70px #0006}
    .head{padding:28px 30px 24px;border-bottom:1px solid var(--ink)}
    .head-top{display:flex;justify-content:space-between;gap:20px;align-items:baseline;margin-bottom:9px;color:#6b6f67;font-size:10px;font-weight:800}
    .head h1{margin:0;font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(40px,7vw,68px);line-height:1;letter-spacing:-.06em}
    .head p{margin:14px 0 0;max-width:520px;color:#6d7169;font-size:12px;line-height:1.8}
    .feed{padding:0 30px}
    .note{display:block;padding:24px 0 26px;border-bottom:1px solid var(--line);text-decoration:none}
    .note:last-child{border-bottom:0}
    .note-meta{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:10px;color:#6f736b;font-size:10px;font-weight:800}
    .note-game{color:var(--ink);font-size:12px}
    .note-state{margin-left:auto;background:var(--accent);color:#303620;padding:4px 7px;font-size:9px;font-weight:900}
    .note h2{margin:0 0 8px;font-size:13px;color:#676b63;font-weight:900}
    .note p{margin:0;font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:19px;line-height:1.9;display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
    .note-foot{display:flex;gap:12px;flex-wrap:wrap;margin-top:13px;color:#7b7e76;font-size:9px;font-weight:800}
    .note:hover p{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
    .single{padding:0 30px 34px}
    .single-meta{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:18px 0;border-bottom:1px solid var(--line);color:#6e726a;font-size:10px;font-weight:800}
    .single-meta strong{color:var(--ink);font-size:12px}.single-meta .state{margin-left:auto;background:var(--accent);color:#303620;padding:5px 8px}
    .single-body{padding:34px 0 38px;border-bottom:1px solid var(--line)}
    .single-body h2{margin:0 0 18px;font-size:14px;color:#696d65}
    .single-copy{margin:0;font-family:"Hiragino Mincho ProN","Yu Mincho",YuMincho,serif;font-size:clamp(21px,3vw,28px);line-height:2;white-space:pre-wrap;max-width:29em}
    .media-section{padding:28px 0 0}
    .media-section h3{margin:0 0 6px;font-size:14px}.media-section>p{margin:0 0 16px;color:#74786f;font-size:10px}
    .media-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .media{border:1px solid var(--line);background:#ebe5d8}.media video{display:block;width:100%;aspect-ratio:16/9;object-fit:contain;background:#050505}
    .caption{padding:10px 11px 12px}.caption strong{display:block;font-size:12px;margin-bottom:7px}.caption a{font-size:10px;font-weight:900;text-decoration:none;border-bottom:1px solid #44483f}
    .foot{margin-top:16px;text-align:center;color:#777d73;font-size:9px}.empty,.loading{padding:44px 20px;text-align:center;color:#7f847a}
    @media(max-width:700px){.shell{width:min(100% - 12px,860px);padding-top:10px}.head,.feed,.single{padding-left:17px;padding-right:17px}.head{padding-top:22px;padding-bottom:18px}.note{padding:21px 0}.note-state{margin-left:0}.note p{font-size:17px}.single-copy{font-size:20px;line-height:1.9}.single-meta .state{margin-left:0}.media-grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <main class="shell">
    <section class="index" id="index-view">
      <div class="paper">
        <header class="head">
          <div class="head-top"><span>HARF-WAY</span><span>遊んでいる途中の記録</span></div>
          <h1>プレイノート</h1>
          <p>ゲームを遊びながら残した短いメモです。考えがまとまり切る前のことも、そのまま置いています。</p>
        </header>
        <div id="notes-list" class="feed"><div class="loading">公開メモを読み込み中…</div></div>
      </div>
    </section>

    <section class="detail" id="detail-view">
      <a class="back" href="/notes/">← プレイノート一覧へ</a>
      <div id="detail-root"><div class="loading">メモを読み込み中…</div></div>
    </section>

    <div class="foot">HARF-WAY / プレイノート</div>
  </main>

<script>
(() => {
  const API='/api/game-note-publications', WAYS='/api/games-live';
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt=v=>{try{return new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'long',day:'numeric'}).format(new Date(v))}catch{return''}};
  const id=new URLSearchParams(location.search).get('note')||'';
  async function data(){const r=await fetch(API,{cache:'no-store'});if(!r.ok)throw new Error('notes_load_failed');return r.json()}
  async function ways(){try{const r=await fetch(WAYS,{cache:'no-store'});const d=await r.json();return Array.isArray(d.entries)?d.entries:[]}catch{return[]}}

  function card(n){
    const count=n.relatedWaysIds?.length||0;
    return `<a class="note" href="/notes/?note=${encodeURIComponent(n.id)}">
      <div class="note-meta"><span class="note-game">${esc(n.gameName||'ゲーム名なし')}</span><span>${esc(fmt(n.publishedAt))}</span><span class="note-state">まだ途中</span></div>
      <h2>${esc(n.title||'無題')}</h2>
      <p>${esc(n.body||'')}</p>
      <div class="note-foot"><span>${esc(n.typeName||'メモ')}</span>${count?`<span>映像 ${count}本</span>`:''}</div>
    </a>`;
  }

  async function render(){
    try{
      const d=await data(), entries=d.entries||[];
      if(!id){document.getElementById('notes-list').innerHTML=entries.length?entries.map(card).join(''):'<div class="empty">公開中のプレイノートはまだありません。</div>';return}
      document.getElementById('index-view').classList.add('hidden');
      document.getElementById('detail-view').classList.add('on');
      const n=entries.find(x=>String(x.id)===String(id));
      if(!n){document.getElementById('detail-root').innerHTML='<div class="empty">このプレイノートは見つかりませんでした。</div>';return}
      document.title=`${n.title||'プレイノート'} / HARF-WAY`;
      const xs=await ways(), related=(n.relatedWaysIds||[]).map(rid=>xs.find(x=>String(x.id)===String(rid))).filter(Boolean);
      const media=related.length?`<section class="media-section"><h3>このときの映像</h3><p>メモに紐づいているWAYS動画です。</p><div class="media-grid">${related.map(x=>`<article class="media"><video controls playsinline preload="metadata" ${x.thumbnailUrl?`poster="${esc(x.thumbnailUrl)}"`:''} src="${esc(x.video||'')}"></video><div class="caption"><strong>${esc(x.title||'')}</strong><a href="/?game=${encodeURIComponent(x.id)}">WAYSで見る →</a></div></article>`).join('')}</div></section>`:'';
      document.getElementById('detail-root').innerHTML=`<article class="paper"><header class="head"><div class="head-top"><span>HARF-WAY</span><span>プレイノート</span></div><h1>${esc(n.gameName||'プレイノート')}</h1></header><div class="single"><div class="single-meta"><strong>${esc(n.gameName||'ゲーム名なし')}</strong><span>${esc(fmt(n.publishedAt))}</span><span>${esc(n.typeName||'メモ')}</span><span class="state">まだ途中</span></div><section class="single-body"><h2>${esc(n.title||'無題')}</h2><p class="single-copy">${esc(n.body||'')}</p></section>${media}</div></article>`;
    }catch{
      document.getElementById(id?'detail-root':'notes-list').innerHTML='<div class="empty">読み込みに失敗しました。</div>';
    }
  }
  render();
})();
</script>
</body>
</html>
