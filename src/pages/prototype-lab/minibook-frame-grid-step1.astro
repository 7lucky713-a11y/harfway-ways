---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>MINI BOOK Frame Lab Step 1</title>
  <style>
    :root{--bg:#090d0a;--panel:#0e140f;--line:#2b382f;--text:#eef4ef;--muted:#829087;--acid:#dff238;--paper:#f2efe6}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
    button{font:inherit}.app{min-height:100dvh;display:grid;grid-template-columns:300px 1fr}.panel{padding:20px;border-right:1px solid var(--line)}
    .brand{font:900 11px ui-monospace,monospace;color:var(--acid);letter-spacing:.12em}h1{font-size:22px;margin:10px 0}.lead{color:var(--muted);font-size:11px;line-height:1.7}
    .tools{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.tool{border:1px solid #415047;background:#151c17;color:#eef4ef;border-radius:8px;padding:9px 11px;font-size:11px;font-weight:800;cursor:pointer}.tool.on{background:var(--acid);border-color:var(--acid);color:#111}.status{margin-top:14px;padding:10px;border:1px solid var(--line);border-radius:8px;font:800 10px ui-monospace,monospace;color:#a9b5ad}.count{color:var(--acid)}
    .stage{padding:24px;display:grid;place-items:start center}.page{position:relative;width:min(720px,90vw);aspect-ratio:182/257;background:var(--paper);box-shadow:0 24px 70px #0008;border:1px solid #c8c1b2;cursor:crosshair;overflow:hidden}.frame{position:absolute;border:2px solid #d9534f;background:rgba(217,83,79,.08);pointer-events:none}.frame.title{border-color:#4b7cff;background:rgba(75,124,255,.08)}.frame.quote{border-color:#4f9a68;background:rgba(79,154,104,.08)}.label{position:absolute;top:3px;left:4px;padding:2px 4px;border-radius:3px;background:#161a16;color:#fff;font:800 8px ui-monospace,monospace}
    @media(max-width:800px){.app{display:block}.panel{border-right:0;border-bottom:1px solid var(--line)}.stage{padding:14px}}
  </style>
</head>
<body>
<div class="app">
  <aside class="panel">
    <div class="brand">HARF-WAY / FRAME LAB / STEP 1</div>
    <h1>箱を置く、それだけ</h1>
    <p class="lead">1. 種類を選ぶ → 2. B5紙面をクリック → 3. その位置にフレームを作成。今回は移動・リサイズをまだ入れていません。</p>
    <div class="tools">
      <button class="tool" data-tool="body">本文</button>
      <button class="tool" data-tool="title">タイトル</button>
      <button class="tool" data-tool="quote">引用</button>
      <button class="tool" id="cancel">キャンセル</button>
    </div>
    <div class="status" id="status">TOOL: NONE</div>
    <div class="status">FRAME COUNT: <span class="count" id="count">0</span></div>
  </aside>
  <main class="stage">
    <div id="page" class="page" aria-label="B5 page"></div>
  </main>
</div>
<script is:inline>
(() => {
  const page = document.getElementById('page');
  const status = document.getElementById('status');
  const count = document.getElementById('count');
  const tools = [...document.querySelectorAll('[data-tool]')];
  let active = '';
  let serial = 0;

  function setTool(type){
    active = type || '';
    tools.forEach(btn => btn.classList.toggle('on', btn.dataset.tool === active));
    status.textContent = active ? `TOOL: ${active.toUpperCase()} / 紙面をクリック` : 'TOOL: NONE';
  }

  function place(type, clientX, clientY){
    const rect = page.getBoundingClientRect();
    const x = Math.max(0, Math.min(rect.width, clientX - rect.left));
    const y = Math.max(0, Math.min(rect.height, clientY - rect.top));
    const size = type === 'body' ? {w:rect.width*.38,h:rect.height*.56} : {w:rect.width*.12,h:rect.height*.42};
    const left = Math.max(0, Math.min(rect.width - size.w, x - size.w/2));
    const top = Math.max(0, Math.min(rect.height - size.h, y - size.h/2));
    const el = document.createElement('div');
    el.className = `frame ${type}`;
    el.dataset.frameId = `${type}-${++serial}`;
    el.style.left = `${left}px`;
    el.style.top = `${top}px`;
    el.style.width = `${size.w}px`;
    el.style.height = `${size.h}px`;
    el.innerHTML = `<span class="label">${type.toUpperCase()}</span>`;
    page.appendChild(el);
    count.textContent = String(page.querySelectorAll('.frame').length);
    status.textContent = `PLACED: ${type.toUpperCase()} / ${el.dataset.frameId}`;
    return el;
  }

  tools.forEach(btn => btn.addEventListener('click', () => setTool(btn.dataset.tool)));
  document.getElementById('cancel').addEventListener('click', () => setTool(''));
  page.addEventListener('click', ev => {
    if(!active) return;
    place(active, ev.clientX, ev.clientY);
  });
  window.__FRAME_LAB_STEP1__ = { setTool, place, count: () => page.querySelectorAll('.frame').length };
})();
</script>
</body>
</html>
