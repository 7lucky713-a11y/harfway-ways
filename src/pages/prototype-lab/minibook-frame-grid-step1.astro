---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>MINI BOOK Frame Lab Step 1</title>
  <style>
    :root{--bg:#090d0a;--panel:#0e140f;--line:#2b382f;--text:#eef4ef;--muted:#829087;--acid:#dff238;--paper:#f2efe6}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
    button{font:inherit}.hwfl-app{min-height:100dvh;display:grid;grid-template-columns:300px 1fr}.hwfl-panel{padding:20px;border-right:1px solid var(--line)}
    .hwfl-brand{font:900 11px ui-monospace,monospace;color:var(--acid);letter-spacing:.12em}.hwfl-title{font-size:22px;margin:10px 0}.hwfl-lead{color:var(--muted);font-size:11px;line-height:1.7}
    .hwfl-tools{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.hwfl-tool{border:1px solid #415047;background:#151c17;color:#eef4ef;border-radius:8px;padding:9px 11px;font-size:11px;font-weight:800;cursor:pointer}.hwfl-tool.on{background:var(--acid);border-color:var(--acid);color:#111}.hwfl-status{margin-top:14px;padding:10px;border:1px solid var(--line);border-radius:8px;font:800 10px ui-monospace,monospace;color:#a9b5ad}.hwfl-count{color:var(--acid)}
    .hwfl-stage{padding:24px;display:grid;place-items:start center}.hwfl-page{position:relative!important;width:min(720px,90vw)!important;aspect-ratio:182/257!important;background:#f2efe6!important;box-shadow:0 24px 70px #0008!important;border:1px solid #c8c1b2!important;cursor:crosshair!important;overflow:hidden!important;isolation:isolate!important}
    .hwfl-box{position:absolute!important;display:block!important;pointer-events:none!important;z-index:50!important;border:4px solid #ff3b30!important;background:rgba(255,59,48,.28)!important;box-shadow:0 0 0 2px rgba(255,255,255,.85) inset,0 5px 18px rgba(0,0,0,.22)!important;min-width:60px!important;min-height:90px!important}
    .hwfl-box.hwfl-titlebox{border-color:#245dff!important;background:rgba(36,93,255,.30)!important}.hwfl-box.hwfl-quotebox{border-color:#00a651!important;background:rgba(0,166,81,.28)!important}
    .hwfl-label{position:absolute!important;top:8px!important;left:8px!important;display:block!important;padding:4px 7px!important;border-radius:4px!important;background:#111!important;color:#fff!important;font:900 11px ui-monospace,monospace!important;letter-spacing:.06em!important;z-index:2!important}
    .hwfl-help{position:absolute;inset:0;display:grid;place-items:center;color:#8d8a80;font:800 12px ui-monospace,monospace;pointer-events:none}.hwfl-page.has-box .hwfl-help{display:none}
    @media(max-width:800px){.hwfl-app{display:block}.hwfl-panel{border-right:0;border-bottom:1px solid var(--line)}.hwfl-stage{padding:14px}}
  </style>
</head>
<body>
<div class="hwfl-app">
  <aside class="hwfl-panel">
    <div class="hwfl-brand">HARF-WAY / FRAME LAB / STEP 1</div>
    <h1 class="hwfl-title">箱を置く、それだけ</h1>
    <p class="hwfl-lead">1. 種類を選ぶ → 2. B5紙面をクリック → 3. 色付きフレームを作成。今回は移動・リサイズをまだ入れていません。</p>
    <div class="hwfl-tools">
      <button class="hwfl-tool" data-tool="body">本文</button>
      <button class="hwfl-tool" data-tool="title">タイトル</button>
      <button class="hwfl-tool" data-tool="quote">引用</button>
      <button class="hwfl-tool" id="hwfl-cancel">キャンセル</button>
    </div>
    <div class="hwfl-status" id="hwfl-status">TOOL: NONE</div>
    <div class="hwfl-status">FRAME COUNT: <span class="hwfl-count" id="hwfl-count">0</span></div>
  </aside>
  <main class="hwfl-stage">
    <div id="hwfl-page" class="hwfl-page" aria-label="B5 page"><div class="hwfl-help">種類を選んで、この紙面をクリック</div></div>
  </main>
</div>
<script is:inline>
(() => {
  const page = document.getElementById('hwfl-page');
  const status = document.getElementById('hwfl-status');
  const count = document.getElementById('hwfl-count');
  const tools = [...document.querySelectorAll('[data-tool]')];
  let active = '';
  let serial = 0;

  function setTool(type){
    active = type || '';
    tools.forEach(btn => btn.classList.toggle('on', btn.dataset.tool === active));
    status.textContent = active ? `TOOL: ${active.toUpperCase()} / 紙面をクリック` : 'TOOL: NONE';
  }

  function place(type, clientX, clientY){
    const rect = page.getBoundingClientRect();
    const x = Math.max(0, Math.min(rect.width, clientX - rect.left));
    const y = Math.max(0, Math.min(rect.height, clientY - rect.top));
    const size = type === 'body' ? {w:Math.max(160,rect.width*.38),h:Math.max(260,rect.height*.56)} : {w:Math.max(90,rect.width*.15),h:Math.max(220,rect.height*.42)};
    const left = Math.max(0, Math.min(rect.width - size.w, x - size.w/2));
    const top = Math.max(0, Math.min(rect.height - size.h, y - size.h/2));
    const el = document.createElement('div');
    el.className = `hwfl-box ${type === 'title' ? 'hwfl-titlebox' : type === 'quote' ? 'hwfl-quotebox' : ''}`;
    el.dataset.frameId = `${type}-${++serial}`;
    el.style.cssText += `left:${left}px!important;top:${top}px!important;width:${size.w}px!important;height:${size.h}px!important;`;
    el.innerHTML = `<span class="hwfl-label">${type.toUpperCase()} / ${el.dataset.frameId}</span>`;
    page.appendChild(el);
    page.classList.add('has-box');
    count.textContent = String(page.querySelectorAll('.hwfl-box').length);
    status.textContent = `VISIBLE FRAME: ${type.toUpperCase()} / ${el.dataset.frameId}`;
    return el;
  }

  tools.forEach(btn => btn.addEventListener('click', () => setTool(btn.dataset.tool)));
  document.getElementById('hwfl-cancel').addEventListener('click', () => setTool(''));
  page.addEventListener('click', ev => {
    if(!active) return;
    place(active, ev.clientX, ev.clientY);
  });
  window.__FRAME_LAB_STEP1__ = { setTool, place, count: () => page.querySelectorAll('.hwfl-box').length };
})();
</script>
</body>
</html>
