---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>MINI BOOK Frame Lab SVG Step 5</title>
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#090d0a;color:#eef4ef;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
.app{min-height:100dvh;display:grid;grid-template-columns:330px 1fr}.panel{padding:20px;border-right:1px solid #2b382f}.stage{padding:24px;display:grid;place-items:start center}
.brand{font:900 11px ui-monospace,monospace;color:#dff238;letter-spacing:.12em}h1{font-size:22px;margin:10px 0}.lead{color:#829087;font-size:11px;line-height:1.7}.tools{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.tool{border:1px solid #415047;background:#151c17;color:#eef4ef;border-radius:8px;padding:9px 11px;font-size:11px;font-weight:800;cursor:pointer}.tool.on{background:#dff238;border-color:#dff238;color:#111}.status{margin-top:10px;padding:10px;border:1px solid #2b382f;border-radius:8px;font:800 10px/1.55 ui-monospace,monospace;color:#a9b5ad}.count,.accent{color:#dff238}.sheet{width:min(720px,90vw);filter:drop-shadow(0 24px 50px #0008);cursor:crosshair;touch-action:none}.frame-hit{fill:transparent;stroke:transparent;pointer-events:all;cursor:grab!important}.resize-mark{fill:#dff238;stroke:#111;stroke-width:.8;pointer-events:none}.resize-hot{fill:transparent;stroke:transparent;pointer-events:all;cursor:nwse-resize!important}.grid-layer,.text-layer{pointer-events:none}.grid-path{fill:none;stroke:#253bff;stroke-width:.28;stroke-opacity:.3;vector-effect:non-scaling-stroke}.grid-bound{fill:none;stroke:#253bff;stroke-width:.5;stroke-opacity:.62;stroke-dasharray:1.2 1.2;vector-effect:non-scaling-stroke}.text-cell{fill:#171914;font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-weight:500}.resize-hot:hover+.resize-mark{stroke-width:1.35;transform:scale(1.08);transform-box:fill-box;transform-origin:center}.sheet[data-gesture="move"],.sheet[data-gesture="move"] *{cursor:grabbing!important}.sheet[data-gesture="resize"],.sheet[data-gesture="resize"] *{cursor:nwse-resize!important}html.hwfl-moving,html.hwfl-moving *,body.hwfl-moving,body.hwfl-moving *{cursor:grabbing!important}html.hwfl-resizing,html.hwfl-resizing *,body.hwfl-resizing,body.hwfl-resizing *{cursor:nwse-resize!important}
@media(max-width:800px){.app{display:block}.panel{border-right:0;border-bottom:1px solid #2b382f}.stage{padding:14px}.sheet{width:min(94vw,720px)}}
</style>
</head>
<body>
<div class="app">
<aside class="panel">
<div class="brand">HARF-WAY / SVG FRAME LAB / STEP 5</div>
<h1>本文をグリッドへ流す</h1>
<p class="lead">本文フレームの右上から下へ1文字ずつ配置し、列末まで来たら1列左へ移ります。フレームを縮めると入らない本文は「残り文字」として保持します。</p>
<div class="tools"><button class="tool on" data-tool="body">本文</button><button class="tool" data-tool="title">タイトル</button><button class="tool" data-tool="quote">引用</button></div>
<div class="status" id="status">TOOL: BODY / 紙面をクリック</div>
<div class="status">FRAME COUNT: <span class="count" id="count">1</span></div>
<div class="status" id="geometry">TEST FRAME: 70.0 × 120.0mm</div>
<div class="status" id="grid-stats">GRID: <span class="accent">25字/列 × 14列 = 350字</span><br>CELL: 4.8mm</div>
<div class="status" id="text-stats">TEXT: <span class="accent">0 / 0字</span><br>残り 0字</div>
</aside>
<main class="stage">
<svg id="sheet" class="sheet" viewBox="0 0 182 257" aria-label="B5 page">
<rect id="paper" x="0" y="0" width="182" height="257" fill="#f2efe6" stroke="#c8c1b2" stroke-width="0.6"/>
<g id="frames"></g>
</svg>
</main>
</div>
<script is:inline>
(() => {
const svg=document.getElementById('sheet'),paper=document.getElementById('paper'),layer=document.getElementById('frames'),count=document.getElementById('count'),status=document.getElementById('status'),geometry=document.getElementById('geometry'),gridStats=document.getElementById('grid-stats'),textStats=document.getElementById('text-stats');
const tools=[...document.querySelectorAll('[data-tool]')],NS='http://www.w3.org/2000/svg';
let active='body',serial=1,gesture=null,suppressPlace=false;
const BODY_TEXT='最初のデッキはインプを軸に組むことにした。序盤はとにかく手数が足りない。攻撃を増やすより、連撃が発生する条件を先に整えた方がよさそうだ。途中で拾ったカードが思った以上に噛み合い、一気に盤面を返せるようになった。ただし防御が薄い。強い動きを見つけた瞬間ほど、それ以外が雑になる。ボス戦では火力だけでは押し切れず、最後の一体を残して崩れた。次はインプを消費した後の盤面をどう維持するかを見る。攻撃の気持ちよさに寄り過ぎていた。';
const BODY_CHARS=Array.from(BODY_TEXT);
const spec={body:{w:70,h:120,minW:28,minH:38,cell:4.8,font:3.35,stroke:'#ff3b30',fill:'#ff3b3014'},title:{w:24,h:100,minW:12,minH:28,stroke:'#245dff',fill:'#245dff48'},quote:{w:24,h:100,minW:12,minH:28,stroke:'#00a651',fill:'#00a65148'}};
function point(cx,cy){const p=svg.createSVGPoint();p.x=cx;p.y=cy;return p.matrixTransform(svg.getScreenCTM().inverse())}
function setTool(type){active=type;tools.forEach(b=>b.classList.toggle('on',b.dataset.tool===type));status.textContent=`TOOL: ${type.toUpperCase()} / 紙面をクリック`}
function clampFrame(g){let x=+g.dataset.x,y=+g.dataset.y,w=+g.dataset.w,h=+g.dataset.h;x=Math.max(0,Math.min(182-w,x));y=Math.max(0,Math.min(257-h,y));g.dataset.x=x.toFixed(2);g.dataset.y=y.toFixed(2);g.setAttribute('transform',`translate(${x.toFixed(2)} ${y.toFixed(2)})`)}
function renderGrid(g){const grid=g.querySelector('.grid-layer');if(!grid)return;grid.replaceChildren();if(g.dataset.type!=='body')return;const w=+g.dataset.w,h=+g.dataset.h,cell=spec.body.cell;const cols=Math.max(1,Math.floor(w/cell)),rows=Math.max(1,Math.floor(h/cell));const gridW=cols*cell,gridH=rows*cell,x0=w-gridW;let d='';for(let c=0;c<=cols;c++){const x=w-c*cell;d+=`M${x.toFixed(2)} 0V${gridH.toFixed(2)}`;}for(let r=0;r<=rows;r++){const y=r*cell;d+=`M${x0.toFixed(2)} ${y.toFixed(2)}H${w.toFixed(2)}`;}const path=document.createElementNS(NS,'path');path.classList.add('grid-path');path.setAttribute('d',d);const bound=document.createElementNS(NS,'rect');bound.classList.add('grid-bound');bound.setAttribute('x',x0.toFixed(2));bound.setAttribute('y','0');bound.setAttribute('width',gridW.toFixed(2));bound.setAttribute('height',gridH.toFixed(2));grid.append(path,bound);g.dataset.rows=rows;g.dataset.cols=cols;g.dataset.capacity=rows*cols;g.dataset.gridWidth=gridW.toFixed(2);g.dataset.gridHeight=gridH.toFixed(2)}
function renderText(g){const textLayer=g.querySelector('.text-layer');if(!textLayer)return;textLayer.replaceChildren();if(g.dataset.type!=='body')return;const rows=+g.dataset.rows||0,cols=+g.dataset.cols||0,cap=+g.dataset.capacity||0,w=+g.dataset.w,cell=spec.body.cell,font=spec.body.font;const visible=Math.min(cap,BODY_CHARS.length);for(let i=0;i<visible;i++){const col=Math.floor(i/rows),row=i%rows;if(col>=cols)break;const x=w-(col*cell)-(cell/2),y=(row*cell)+(cell/2);const t=document.createElementNS(NS,'text');t.classList.add('text-cell');t.setAttribute('x',x.toFixed(2));t.setAttribute('y',y.toFixed(2));t.setAttribute('font-size',font.toFixed(2));t.setAttribute('text-anchor','middle');t.setAttribute('dominant-baseline','middle');t.textContent=BODY_CHARS[i];textLayer.appendChild(t)}g.dataset.visibleChars=visible;g.dataset.remainingChars=Math.max(0,BODY_CHARS.length-visible)}
function updatePanel(g){const w=+g.dataset.w,h=+g.dataset.h;geometry.textContent=`${g.dataset.frame}: ${w.toFixed(1)} × ${h.toFixed(1)}mm`;if(g.dataset.type==='body'){const rows=+g.dataset.rows||0,cols=+g.dataset.cols||0,cap=+g.dataset.capacity||0,visible=+g.dataset.visibleChars||0,remaining=+g.dataset.remainingChars||0;gridStats.innerHTML=`GRID: <span class="accent">${rows}字/列 × ${cols}列 = ${cap}字</span><br>CELL: ${spec.body.cell.toFixed(1)}mm`;textStats.innerHTML=`TEXT: <span class="accent">${visible} / ${BODY_CHARS.length}字</span><br>残り ${remaining}字`}else{gridStats.textContent='GRID: 本文フレームのみ';textStats.textContent='TEXT: 本文フレームのみ'}}
function syncGeometry(g){const w=+g.dataset.w,h=+g.dataset.h;g.querySelector('.frame-main').setAttribute('width',w);g.querySelector('.frame-main').setAttribute('height',h);g.querySelector('.frame-hit').setAttribute('width',w);g.querySelector('.frame-hit').setAttribute('height',h);const mark=g.querySelector('.resize-mark');mark.setAttribute('x',Math.max(0,w-5));mark.setAttribute('y',Math.max(0,h-5));const hot=g.querySelector('.resize-hot');hot.setAttribute('x',Math.max(0,w-12));hot.setAttribute('y',Math.max(0,h-12));renderGrid(g);renderText(g);updatePanel(g)}
function setGlobalCursor(mode){document.documentElement.classList.toggle('hwfl-moving',mode==='move');document.body.classList.toggle('hwfl-moving',mode==='move');document.documentElement.classList.toggle('hwfl-resizing',mode==='resize');document.body.classList.toggle('hwfl-resizing',mode==='resize')}
function clearGlobalCursor(){document.documentElement.classList.remove('hwfl-moving','hwfl-resizing');document.body.classList.remove('hwfl-moving','hwfl-resizing')}
function begin(mode,g,ev){ev.preventDefault();ev.stopPropagation();const p=point(ev.clientX,ev.clientY);gesture={mode,g,pointerId:ev.pointerId,startX:p.x,startY:p.y,x:+g.dataset.x,y:+g.dataset.y,w:+g.dataset.w,h:+g.dataset.h,moved:false};svg.dataset.gesture=mode;setGlobalCursor(mode);updatePanel(g);try{svg.setPointerCapture(ev.pointerId)}catch{}status.textContent=`${mode==='resize'?'RESIZE':'DRAG'}: ${g.dataset.frame}`}
function bind(g){const hit=g.querySelector('.frame-hit'),hot=g.querySelector('.resize-hot');hit.style.cursor='grab';hot.style.cursor='nwse-resize';hit.addEventListener('pointerdown',ev=>begin('move',g,ev));hot.addEventListener('pointerdown',ev=>begin('resize',g,ev))}
function makeFrame(type,x,y,id){const s=spec[type],g=document.createElementNS(NS,'g');g.dataset.frame=id||`${type}-${++serial}`;g.dataset.type=type;g.dataset.x=x;g.dataset.y=y;g.dataset.w=s.w;g.dataset.h=s.h;
const r=document.createElementNS(NS,'rect');r.classList.add('frame-main');r.setAttribute('fill',s.fill);r.setAttribute('stroke',s.stroke);r.setAttribute('stroke-width','1.4');
const grid=document.createElementNS(NS,'g');grid.classList.add('grid-layer');
const textLayer=document.createElementNS(NS,'g');textLayer.classList.add('text-layer');
const bg=document.createElementNS(NS,'rect');bg.setAttribute('x','3');bg.setAttribute('y','3');bg.setAttribute('width',type==='body'?'37':'31');bg.setAttribute('height','8');bg.setAttribute('rx','1');bg.setAttribute('fill','#111');bg.setAttribute('pointer-events','none');
const t=document.createElementNS(NS,'text');t.setAttribute('x','5');t.setAttribute('y','8.7');t.setAttribute('fill','#fff');t.setAttribute('font-size','4');t.setAttribute('font-family','monospace');t.setAttribute('font-weight','700');t.setAttribute('pointer-events','none');t.textContent=id==='test-1'?'TEST FRAME':type.toUpperCase();
const hit=document.createElementNS(NS,'rect');hit.classList.add('frame-hit');
const hot=document.createElementNS(NS,'rect');hot.classList.add('resize-hot');hot.setAttribute('width','12');hot.setAttribute('height','12');
const mark=document.createElementNS(NS,'rect');mark.classList.add('resize-mark');mark.setAttribute('width','5');mark.setAttribute('height','5');mark.setAttribute('rx','.6');
g.append(r,grid,textLayer,bg,t,hit,hot,mark);layer.appendChild(g);syncGeometry(g);clampFrame(g);bind(g);return g}
svg.addEventListener('pointermove',ev=>{if(!gesture||ev.pointerId!==gesture.pointerId)return;const p=point(ev.clientX,ev.clientY),dx=p.x-gesture.startX,dy=p.y-gesture.startY,g=gesture.g;if(Math.abs(dx)+Math.abs(dy)>.5)gesture.moved=true;if(gesture.mode==='move'){g.dataset.x=(gesture.x+dx).toFixed(2);g.dataset.y=(gesture.y+dy).toFixed(2);clampFrame(g);geometry.textContent=`${g.dataset.frame}: X ${(+g.dataset.x).toFixed(1)} / Y ${(+g.dataset.y).toFixed(1)}`}else{const s=spec[g.dataset.type],maxW=182-gesture.x,maxH=257-gesture.y;g.dataset.w=Math.max(s.minW,Math.min(maxW,gesture.w+dx)).toFixed(2);g.dataset.h=Math.max(s.minH,Math.min(maxH,gesture.h+dy)).toFixed(2);syncGeometry(g)}});
function end(ev){if(!gesture||ev.pointerId!==gesture.pointerId)return;const id=gesture.g.dataset.frame,mode=gesture.mode,moved=gesture.moved;try{svg.releasePointerCapture(ev.pointerId)}catch{}gesture=null;delete svg.dataset.gesture;clearGlobalCursor();if(moved){suppressPlace=true;setTimeout(()=>suppressPlace=false,0);status.textContent=`${mode==='resize'?'RESIZED':'MOVED'}: ${id}`}}
svg.addEventListener('pointerup',end);svg.addEventListener('pointercancel',end);window.addEventListener('blur',()=>{gesture=null;delete svg.dataset.gesture;clearGlobalCursor()});
tools.forEach(b=>b.addEventListener('click',()=>setTool(b.dataset.tool)));
svg.addEventListener('click',ev=>{if(suppressPlace||ev.target!==paper)return;const p=point(ev.clientX,ev.clientY),s=spec[active],x=Math.max(0,Math.min(182-s.w,p.x-s.w/2)),y=Math.max(0,Math.min(257-s.h,p.y-s.h/2)),g=makeFrame(active,x,y);count.textContent=String(layer.querySelectorAll('g[data-frame]').length);status.textContent=`PLACED: ${g.dataset.frame}`});
makeFrame('body',61,82,'test-1');
})();
</script>
</body>
</html>
