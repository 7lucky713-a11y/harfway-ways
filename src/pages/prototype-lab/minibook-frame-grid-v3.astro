---
export const prerender = true;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>MINI BOOK Frame Grid Lab V3</title>
<style>
:root{--bg:#090d0a;--panel:#0f1510;--line:#2b382f;--text:#edf3ee;--muted:#849087;--acid:#dff238;--paper:#f2efe6;--ink:#181a17;--body:#be5e5e;--title:#5c7ff0;--quote:#51996b}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}button,input,select{font:inherit}button{cursor:pointer}.app{min-height:100dvh;display:grid;grid-template-columns:330px minmax(0,1fr)}.panel{position:sticky;top:0;height:100dvh;overflow:auto;padding:18px;border-right:1px solid var(--line);background:var(--panel)}.brand{font:950 11px ui-monospace,monospace;letter-spacing:.13em;color:var(--acid)}h1{font-size:22px;margin:9px 0 5px;letter-spacing:-.04em}.lead{font-size:10px;line-height:1.75;color:var(--muted);margin:0 0 16px}.group{padding:14px 0;border-top:1px solid var(--line)}.group h2{margin:0 0 9px;font:900 10px ui-monospace,monospace;letter-spacing:.1em;color:#c1cbc4}.row{display:flex;gap:7px;flex-wrap:wrap}.btn{border:1px solid #3b4b40;background:#141b16;color:#e4ebe5;border-radius:8px;padding:8px 10px;font-size:10px;font-weight:850}.btn.on,.btn.acid{background:var(--acid);border-color:var(--acid);color:#111}.btn.danger{color:#ff9ca4}.placeNote{display:none;margin-top:9px;padding:9px 10px;border:1px solid #5c672a;border-radius:8px;background:#171d10;color:var(--acid);font-size:9px;font-weight:850}.placeNote.on{display:block}.fields{display:grid;grid-template-columns:1fr 1fr;gap:8px}.field{display:grid;gap:5px}.field.wide{grid-column:1/-1}.field label{font-size:9px;color:#91a097}.field input,.field select{width:100%;border:1px solid #354339;background:#090d0a;color:#fff;border-radius:7px;padding:7px 8px;font-size:10px}.stat{display:grid;grid-template-columns:1fr auto;gap:7px 10px;padding:10px;border:1px solid var(--line);border-radius:10px;background:#0a0f0b;font:800 9px/1.55 ui-monospace,monospace;color:#91a097}.stat b{color:#f1f5f1}.hint{margin-top:8px;font-size:9px;line-height:1.65;color:#718078}.stage{min-width:0;padding:24px 28px 44px;display:grid;justify-items:center;align-content:start;gap:14px;background:radial-gradient(circle at 50% 10%,#151d17 0,#090d0a 54%)}.stagebar{width:min(100%,980px);display:flex;gap:8px;align-items:center}.stagebar strong{font-size:11px;letter-spacing:.08em}.stagebar span{font-size:9px;color:#78867c}.spacer{flex:1}.pageWrap{width:min(720px,calc(100vw - 390px));min-width:320px}.page{position:relative;width:100%;aspect-ratio:182/257;background:var(--paper);color:var(--ink);border:1px solid #c9c1b1;box-shadow:0 26px 80px #0008;overflow:hidden;user-select:none;touch-action:none}.page.placing{cursor:crosshair;outline:3px solid var(--acid);outline-offset:4px}.page.pageGrid{background-image:linear-gradient(to right,rgba(75,124,255,.11) 1px,transparent 1px),linear-gradient(to bottom,rgba(75,124,255,.11) 1px,transparent 1px);background-size:2.74725% 1.94555%}.pageLabel{position:absolute;left:3%;bottom:2%;font:800 8px ui-monospace,monospace;letter-spacing:.12em;color:#85857d;pointer-events:none}.frame{position:absolute;overflow:hidden;background:rgba(255,255,255,.04);border:1px solid #777;cursor:grab;touch-action:none}.frame:active{cursor:grabbing}.frame.body{border-color:var(--body)}.frame.title{border-color:var(--title)}.frame.quote{border-color:var(--quote)}.frame.selected{outline:2px solid var(--acid);outline-offset:2px;z-index:30}.frameLabel{position:absolute;z-index:7;top:3px;left:4px;padding:2px 4px;border-radius:3px;background:#171b17dd;color:#f1f5f1;font:800 7px ui-monospace,monospace;letter-spacing:.07em;pointer-events:none}.resize{position:absolute;z-index:12;right:0;bottom:0;width:16px;height:16px;border-top-left-radius:5px;background:var(--acid);cursor:nwse-resize}.grid{position:absolute;inset:0;pointer-events:none}.grid.on{background-image:linear-gradient(to right,rgba(196,68,68,.28) 1px,transparent 1px),linear-gradient(to bottom,rgba(196,68,68,.28) 1px,transparent 1px)}.chars{position:absolute;inset:0;pointer-events:none}.char{position:absolute;display:grid;place-items:center;color:var(--ink);font-family:"Yu Mincho","Hiragino Mincho ProN",serif;line-height:1}.verticalText{position:absolute;inset:0;padding:5px 7px;overflow:hidden;writing-mode:vertical-rl;text-orientation:mixed;line-break:strict;word-break:normal;color:var(--ink);font-family:"Yu Mincho","Hiragino Mincho ProN",serif}.title .verticalText{font-weight:750}.quote .verticalText{font-weight:650}.emptyCanvas{position:absolute;inset:0;display:grid;place-items:center;color:#aaa;font:800 10px ui-monospace,monospace;pointer-events:none}.testBadge{padding:5px 8px;border:1px solid #3b4b40;border-radius:999px;font:800 8px ui-monospace,monospace;color:#94a198}.testBadge.pass{border-color:#56642f;color:var(--acid)}
@media(max-width:920px){.app{display:block}.panel{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--line)}.stage{padding:18px 10px 34px}.pageWrap{width:min(94vw,720px)}}
</style>
</head>
<body>
<div class="app">
<aside class="panel">
<div class="brand">HARF-WAY / PROTOTYPE LAB</div><h1>MINI BOOK FRAME LAB V3</h1><p class="lead">B5紙面にフレームを置いてから文字を流す方式。追加ボタンを押し、紙面の好きな場所をクリックして配置します。</p>
<section class="group"><h2>PLACE FRAME</h2><div class="row"><button class="btn add acid" data-type="body">＋本文</button><button class="btn add" data-type="title">＋タイトル</button><button class="btn add" data-type="quote">＋引用</button><button id="cancelPlace" class="btn" hidden>キャンセル</button></div><div id="placeNote" class="placeNote"></div></section>
<section class="group"><h2>VIEW</h2><div class="row"><button id="toggleGrid" class="btn on">文字グリッド</button><button id="toggleText" class="btn on">テキスト</button><button id="togglePageGrid" class="btn">5mmガイド</button><button id="clearAll" class="btn">全消去</button></div><div class="hint">配置中は紙面が黄色い枠になります。既存フレーム上をクリックしても、その位置に新しい箱を置けます。</div></section>
<section class="group"><h2>SELECTED FRAME</h2><div id="empty" class="hint">フレームをクリックすると数値編集できます。</div><div id="editor" hidden><div class="fields"><div class="field wide"><label>TYPE</label><select id="type"><option value="body">本文</option><option value="title">タイトル</option><option value="quote">引用</option></select></div><div class="field"><label>X / mm</label><input id="x" type="number" step="1"></div><div class="field"><label>Y / mm</label><input id="y" type="number" step="1"></div><div class="field"><label>幅 / mm</label><input id="w" type="number" step="1" min="8"></div><div class="field"><label>高さ / mm</label><input id="h" type="number" step="1" min="12"></div><div class="field"><label>文字 / px</label><input id="font" type="number" step="1" min="10" max="34"></div><div class="field"><label>セル / mm</label><input id="cell" type="number" step="0.2" min="3" max="12"></div></div><div class="row" style="margin-top:10px"><button id="delete" class="btn danger">削除</button></div></div></section>
<section class="group"><h2>FRAME RESULT</h2><div class="stat"><span>ページ</span><b>B5 182×257mm</b><span>フレーム数</span><b id="countStat">0</b><span>選択フレーム</span><b id="frameStat">—</b><span>1列文字数</span><b id="rowsStat">—</b><span>列数</span><b id="colsStat">—</b><span>最大文字数</span><b id="capStat">—</b><span>本文残り</span><b id="remainStat">—</b></div></section>
</aside>
<main class="stage"><div class="stagebar"><strong>LIVE B5 / CLICK TO PLACE</strong><span>フレーム → グリッド → テキスト</span><div class="spacer"></div><span id="testBadge" class="testBadge">INTERACTION TESTABLE</span><span id="status">0 FRAMES</span></div><div class="pageWrap"><div id="page" class="page"><div id="emptyCanvas" class="emptyCanvas">左の「＋本文」などを押して、ここをクリック</div><div class="pageLabel">B5 / 182 × 257 mm</div></div></div></main>
</div>
<script is:inline>
(() => {
  'use strict';
  const B5={w:182,h:257};
  const SAMPLE='とりあえずモードで「王冠を食う者」を育てる流れで進行。素の攻撃力が100を笑う。連撃を巨人の盾でアタッカーに。タンクを用意した方がいいのかもしれないけど、とりあえず最前線に立たせている。これでいいのだろうか……。インプを犠牲に攻撃と連撃が異様に噛み合って強い。インプに永続を与えて、その後に犠牲で何度も殴るとかが強い？次の戦闘では配置順によって被害量が大きく変わった。手札の回り方だけではなく、どの階層で誰を受けに置くかを先に決めた方が安定する。強いカードを引いた瞬間だけを見るより、毎ターンの損失を減らす方が最終的な火力につながっている。';
  const TITLE='第二回「2026年9月11日、20時53分」';
  const QUOTE='インプを犠牲に攻撃と連撃が異様に噛み合って強い。';
  const $=id=>document.getElementById(id);
  const page=$('page');
  const inputs={type:$('type'),x:$('x'),y:$('y'),w:$('w'),h:$('h'),font:$('font'),cell:$('cell')};
  let frames=[]; let selectedId=''; let placingType=''; let showGrid=true; let showText=true; let serial=1;
  const clamp=(n,min,max)=>Math.max(min,Math.min(max,n));
  const snap=n=>Math.round(n);
  const textFor=f=>f.type==='body'?SAMPLE:f.type==='title'?TITLE:QUOTE;
  const typeName=t=>t==='body'?'本文':t==='title'?'タイトル':'引用';
  const selected=()=>frames.find(f=>f.id===selectedId)||null;
  const metrics=f=>({rows:Math.max(1,Math.floor(f.h/f.cell)),cols:Math.max(1,Math.floor(f.w/f.cell))});
  const mmX=(clientX,rect)=>(clientX-rect.left)/rect.width*B5.w;
  const mmY=(clientY,rect)=>(clientY-rect.top)/rect.height*B5.h;
  function frameDefaults(type){if(type==='body')return {w:88,h:176,font:15,cell:4.8};if(type==='title')return {w:22,h:150,font:24,cell:6.2};return {w:22,h:150,font:17,cell:5.2};}
  function makeFrame(type,x,y){const d=frameDefaults(type),id=`${type}-${Date.now()}-${serial++}`;return {id,type,x:clamp(snap(x-d.w/2),0,B5.w-d.w),y:clamp(snap(y-d.h/2),0,B5.h-d.h),...d};}
  function setPlacement(type){placingType=type||'';page.classList.toggle('placing',Boolean(placingType));$('cancelPlace').hidden=!placingType;$('placeNote').classList.toggle('on',Boolean(placingType));$('placeNote').textContent=placingType?`${typeName(placingType)}フレーム配置中：B5紙面をクリックしてください`:'';document.querySelectorAll('.add').forEach(b=>b.classList.toggle('on',b.dataset.type===placingType));$('status').textContent=placingType?`PLACE ${placingType.toUpperCase()} FRAME`:`${frames.length} FRAMES`;}
  function bodyHTML(f){const m=metrics(f),cap=m.rows*m.cols,chars=Array.from(textFor(f)).slice(0,cap);let charHTML='';for(let i=0;i<chars.length;i++){const col=Math.floor(i/m.rows),row=i%m.rows;const left=100-(col+1)*100/m.cols,top=row*100/m.rows;charHTML+=`<span class="char" style="left:${left}%;top:${top}%;width:${100/m.cols}%;height:${100/m.rows}%;font-size:${f.font}px">${chars[i]}</span>`;}return `<div class="grid ${showGrid?'on':''}" style="background-size:${100/m.cols}% ${100/m.rows}%"></div>${showText?`<div class="chars">${charHTML}</div>`:''}`;}
  function textHTML(f){return showText?`<div class="verticalText" style="font-size:${f.font}px;line-height:1.55">${textFor(f)}</div>`:'';}
  function render(){page.querySelectorAll('.frame').forEach(n=>n.remove());frames.forEach(f=>{const el=document.createElement('div');el.className=`frame ${f.type}${f.id===selectedId?' selected':''}`;el.dataset.id=f.id;el.style.left=`${f.x/B5.w*100}%`;el.style.top=`${f.y/B5.h*100}%`;el.style.width=`${f.w/B5.w*100}%`;el.style.height=`${f.h/B5.h*100}%`;el.innerHTML=`<div class="frameLabel">${typeName(f.type)} · ${f.w}×${f.h}mm</div>${f.type==='body'?bodyHTML(f):textHTML(f)}<div class="resize" aria-label="resize"></div>`;page.appendChild(el);bindFrame(el,f);});$('emptyCanvas').hidden=frames.length>0;$('countStat').textContent=String(frames.length);syncEditor();if(!placingType)$('status').textContent=`${frames.length} FRAMES · ${showGrid?'GRID ON':'GRID OFF'}`;}
  function syncEditor(){const f=selected();$('editor').hidden=!f;$('empty').hidden=Boolean(f);if(!f){$('frameStat').textContent=$('rowsStat').textContent=$('colsStat').textContent=$('capStat').textContent=$('remainStat').textContent='—';return;}inputs.type.value=f.type;inputs.x.value=f.x;inputs.y.value=f.y;inputs.w.value=f.w;inputs.h.value=f.h;inputs.font.value=f.font;inputs.cell.value=f.cell;const m=metrics(f),cap=m.rows*m.cols,len=Array.from(textFor(f)).length;$('frameStat').textContent=`${f.w}×${f.h}mm`;$('rowsStat').textContent=f.type==='body'?`${m.rows}字`:'—';$('colsStat').textContent=f.type==='body'?`${m.cols}列`:'—';$('capStat').textContent=f.type==='body'?`${cap}字`:'—';$('remainStat').textContent=f.type==='body'?`${Math.max(0,len-cap)}字`:'—';}
  function bindFrame(el,f){el.addEventListener('pointerdown',ev=>{if(placingType||ev.target.closest('.resize'))return;ev.preventDefault();ev.stopPropagation();selectedId=f.id;render();const rect=page.getBoundingClientRect(),sx=ev.clientX,sy=ev.clientY,ox=f.x,oy=f.y;const move=e=>{f.x=clamp(snap(ox+(e.clientX-sx)/rect.width*B5.w),0,B5.w-f.w);f.y=clamp(snap(oy+(e.clientY-sy)/rect.height*B5.h),0,B5.h-f.h);render();};const up=()=>{window.removeEventListener('pointermove',move);window.removeEventListener('pointerup',up);};window.addEventListener('pointermove',move);window.addEventListener('pointerup',up,{once:true});});el.querySelector('.resize').addEventListener('pointerdown',ev=>{if(placingType)return;ev.preventDefault();ev.stopPropagation();selectedId=f.id;const rect=page.getBoundingClientRect(),sx=ev.clientX,sy=ev.clientY,ow=f.w,oh=f.h;const move=e=>{f.w=clamp(snap(ow+(e.clientX-sx)/rect.width*B5.w),8,B5.w-f.x);f.h=clamp(snap(oh+(e.clientY-sy)/rect.height*B5.h),12,B5.h-f.y);render();};const up=()=>{window.removeEventListener('pointermove',move);window.removeEventListener('pointerup',up);};window.addEventListener('pointermove',move);window.addEventListener('pointerup',up,{once:true});});}
  page.addEventListener('pointerdown',ev=>{if(placingType){ev.preventDefault();ev.stopPropagation();const rect=page.getBoundingClientRect(),f=makeFrame(placingType,mmX(ev.clientX,rect),mmY(ev.clientY,rect));frames.push(f);selectedId=f.id;setPlacement('');render();return;}if(ev.target===page||ev.target.id==='emptyCanvas'){selectedId='';render();}},true);
  document.querySelectorAll('.add').forEach(btn=>btn.addEventListener('click',()=>setPlacement(btn.dataset.type)));
  $('cancelPlace').addEventListener('click',()=>setPlacement(''));
  Object.values(inputs).forEach(el=>el.addEventListener('input',()=>{const f=selected();if(!f)return;f.type=inputs.type.value;f.w=clamp(snap(Number(inputs.w.value)||8),8,B5.w-f.x);f.h=clamp(snap(Number(inputs.h.value)||12),12,B5.h-f.y);f.x=clamp(snap(Number(inputs.x.value)||0),0,B5.w-f.w);f.y=clamp(snap(Number(inputs.y.value)||0),0,B5.h-f.h);f.font=clamp(Number(inputs.font.value)||15,10,34);f.cell=clamp(Number(inputs.cell.value)||4.8,3,12);render();}));
  $('delete').addEventListener('click',()=>{frames=frames.filter(f=>f.id!==selectedId);selectedId='';render();});
  $('toggleGrid').addEventListener('click',e=>{showGrid=!showGrid;e.currentTarget.classList.toggle('on',showGrid);render();});
  $('toggleText').addEventListener('click',e=>{showText=!showText;e.currentTarget.classList.toggle('on',showText);render();});
  $('togglePageGrid').addEventListener('click',e=>{page.classList.toggle('pageGrid');e.currentTarget.classList.toggle('on',page.classList.contains('pageGrid'));});
  $('clearAll').addEventListener('click',()=>{frames=[];selectedId='';setPlacement('');render();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')setPlacement('');});
  window.__FRAME_LAB_DEBUG__={snapshot:()=>({frames:frames.map(f=>({...f})),selectedId,placingType,showGrid,showText})};
  render();
})();
</script>
</body></html>
