---
const title = 'ADS creative scope v6 preview';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <style>
    :root{font-family:ui-sans-serif,system-ui,"Noto Sans JP",sans-serif;background:#f2ede3;color:#171714}
    *{box-sizing:border-box} body{margin:0;padding:28px}.shell{max-width:1180px;margin:auto;display:grid;grid-template-columns:360px 1fr;gap:20px}
    .card{background:#fffdf8;border:1px solid #d9cfbf;border-radius:24px;padding:26px}.eyebrow{font:700 11px/1.2 ui-monospace,monospace;letter-spacing:.2em;color:#7a6343}.card h1{font-size:25px;margin:12px 0}.note{font-size:13px;line-height:1.8;color:#6f665c}.upload{margin-top:24px;border:1px dashed #b8a98f;border-radius:16px;padding:18px}.upload input{width:100%}.status{margin-top:14px;padding:12px 14px;border-radius:12px;background:#f2ede3;font-size:12px;line-height:1.6}
    #hwads-inline-preview-controls{display:flex;gap:8px;margin:16px 0 18px}.tab{border:1px solid #d8cdbd;background:#fffdf8;border-radius:11px;padding:11px 18px;font-weight:700;cursor:pointer}.tab.active{background:#171714;color:#fff}
    .preview-panel{max-width:690px}.frame{border:1px solid #d8cdbd;border-radius:18px;overflow:hidden;background:#fff;min-height:510px}.decor-band{height:96px;overflow:hidden;border-bottom:1px solid #d8cdbd}.decor-band img{width:100%;height:100%;object-fit:cover;display:block}.shelves{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:14px}.shelf{height:92px;background:#b3bd9e;border-radius:12px}.ad-card{margin:0 14px 14px;border:1px solid #b8aa94;border-radius:14px;padding:14px;display:grid;grid-template-columns:190px 1fr;gap:18px;align-items:center;min-height:180px}.ad-media{height:130px;border-radius:10px;overflow:hidden;background:#304d35}.ad-media img{width:100%;height:100%;object-fit:cover;display:block}.ad-copy small{letter-spacing:.16em}.ad-copy h2{margin:10px 0 6px;font-size:25px}.scrap-layout .decor-band{height:74px}.scrap-layout .shelves{display:none}.scrap-layout .ad-card{grid-template-columns:1fr;margin:16px;min-height:330px}.scrap-layout .ad-media{height:280px}.scrap-layout .ad-copy{display:none}.check{margin-top:18px;border-top:1px solid #ddd0be;padding-top:18px;font-size:13px;line-height:1.8}.ok{color:#42671e;font-weight:800}
    @media(max-width:820px){body{padding:14px}.shell{grid-template-columns:1fr}.card{padding:20px}.ad-card{grid-template-columns:1fr}.ad-media{height:220px}}
  </style>
  <script is:inline src="/ads-portal-preview-creative-scope-v6.js"></script>
</head>
<body>
  <main class="shell">
    <section class="card">
      <div class="eyebrow">REGRESSION TEST / V6</div>
      <h1>広告素材を選ぶ</h1>
      <p class="note">本番で起きた「選んだ画像が上の帯と広告枠の両方に入る」状態を再現します。v6では広告枠だけに素材が残ります。</p>
      <div class="upload">
        <strong>画像を選ぶ</strong><br/><br/>
        <input id="creative-file" type="file" accept="image/*" />
      </div>
      <div class="status" id="fixture-status">画像を選ぶとテストを開始します。</div>
      <div class="check">確認ポイント<br/>① 上の横長帯が消える<br/>② 4つの棚は残る（プレイリスト）<br/>③ 広告カードの画像は残る<br/>④ プレイリスト ⇄ 切れ端を切り替えても崩れない</div>
    </section>

    <section class="card preview-panel" data-hwads-active-placement="playlist" data-hwads-preview-device="pc">
      <div class="eyebrow">LIVE PREVIEW</div>
      <h1>掲載されたときの見え方</h1>
      <div id="hwads-inline-preview-controls">
        <button class="tab active" data-hwads-placement="playlist">プレイリスト</button>
        <button class="tab" data-hwads-placement="scraps">切れ端</button>
      </div>
      <div class="frame" data-hwads-inline-preview-active-frame="1">
        <div class="decor-band" id="duplicate-band"><img id="duplicate-image" alt="上部の非広告帯" /></div>
        <div class="shelves"><div class="shelf"></div><div class="shelf"></div><div class="shelf"></div><div class="shelf"></div></div>
        <article class="ad-card">
          <div class="ad-media" data-hwads-preview-media-slot="1"><img id="ad-image" alt="広告素材" /></div>
          <div class="ad-copy"><small>PLAYLIST SUPPORTER / PR</small><h2>作品タイトル</h2><p>キャッチコピーがここに入ります。</p></div>
        </article>
      </div>
      <div class="status" id="result-status">上帯と広告枠の両方へ同じ画像を入れて、v6が重複だけを除去します。</div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const input = document.querySelector('#creative-file');
      const panel = document.querySelector('.preview-panel');
      const frame = panel.querySelector('.frame');
      const duplicate = document.querySelector('#duplicate-image');
      const ad = document.querySelector('#ad-image');
      const fixtureStatus = document.querySelector('#fixture-status');
      const resultStatus = document.querySelector('#result-status');
      let file = null;
      let urls = [];

      const clearUrls = () => { urls.forEach((u) => URL.revokeObjectURL(u)); urls = []; };
      const applyCreative = () => {
        if (!file) return;
        clearUrls();
        const a = URL.createObjectURL(file);
        const b = URL.createObjectURL(file);
        urls.push(a,b);
        duplicate.src = a;
        ad.src = b;
        window.setTimeout(() => {
          const hidden = getComputedStyle(document.querySelector('#duplicate-band')).display === 'none';
          fixtureStatus.innerHTML = hidden ? '<span class="ok">PASS：上帯だけ除去できています。</span>' : 'FAIL：上帯がまだ表示されています。';
          resultStatus.textContent = hidden ? '選択素材は広告枠側だけに残っています。' : '上帯の重複除去が未成立です。';
        }, 520);
      };

      input.addEventListener('change', () => { file = input.files?.[0] || null; if (file) applyCreative(); });
      document.querySelectorAll('[data-hwads-placement]').forEach((button) => button.addEventListener('click', () => {
        document.querySelectorAll('[data-hwads-placement]').forEach((b) => b.classList.toggle('active', b === button));
        const placement = button.dataset.hwadsPlacement;
        panel.dataset.hwadsActivePlacement = placement;
        frame.classList.toggle('scrap-layout', placement === 'scraps');
        if (file) applyCreative();
      }));
      window.addEventListener('beforeunload', clearUrls);
    })();
  </script>
</body>
</html>