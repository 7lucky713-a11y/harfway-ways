<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>WEEKLY HARF-WAY / CURRENT FORMAT EDITOR</title>
<style is:global>
:root{--bg:#0a0b0d;--panel:#12151a;--panel2:#171b21;--line:#303943;--text:#f4f5f2;--muted:#929ca8;--acid:#eaff38;--paper:#f3f1ea;--ink:#171817;--blue:#dfe7ff;--orange:#ffca80;--red:#ffb2b2}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}.app{min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) 560px}.library{padding:26px 28px 60px;border-right:1px solid var(--line)}.editor{padding:24px 22px 60px;background:#0d1014}.top{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:20px}.kicker{font:900 11px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:var(--acid)}h1,h2{margin:6px 0 0;letter-spacing:-.05em}h1{font-size:42px;line-height:.98}h2{font-size:31px;line-height:1}.desc{max-width:760px;margin:13px 0 0;color:#c1c8cf;font-size:14px;line-height:1.75}.range{padding:11px 13px;border:1px solid var(--line);border-radius:11px;background:var(--panel);font:850 11px/1.4 ui-monospace,monospace;color:#e6ebee;white-space:nowrap}.panel{border:1px solid var(--line);border-radius:15px;background:linear-gradient(180deg,var(--panel2),var(--panel));padding:15px;margin-bottom:13px}.paneltitle{display:flex;align-items:center;gap:8px;margin-bottom:11px;font:900 10px/1 ui-monospace,monospace;letter-spacing:.13em;color:var(--acid)}.paneltitle:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--acid)}.tabs{display:flex;gap:7px;flex-wrap:wrap}.tab,.btn,.mini{border:1px solid #3a444f;background:#161a20;color:#eef2f4;font-weight:850}.tab{padding:9px 12px;border-radius:999px;font-size:11px}.tab.on,.btn.primary,.mini.primary{background:var(--acid);border-color:var(--acid);color:#090a0b}.sourcegrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}.source{padding:11px;border:1px solid #2d3540;border-radius:11px;background:#0d1014}.source span{font-size:9px;color:var(--muted)}.source b{display:block;margin-top:5px;font-size:22px;line-height:1}.toolbar{display:flex;gap:7px;flex-wrap:wrap}.btn{border-radius:9px;padding:9px 11px;font-size:11px}.btn.danger{color:var(--red)}.filters{display:grid;grid-template-columns:minmax(0,1fr) 160px;gap:8px;margin-top:11px}.input,.select,.textarea{width:100%;border:1px solid #35404b;border-radius:9px;background:#0a0d11;color:#fff;outline:none}.input,.select{height:42px;padding:0 11px;font-size:12px}.textarea{min-height:88px;padding:11px;font-size:13px;line-height:1.7;resize:vertical}.smallinput{height:35px;padding:0 8px;font-size:11px}.status,.warn{margin-top:9px;font-size:10px;line-height:1.6}.status{color:var(--muted)}.warn{color:#ffd18a}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:11px;margin-top:14px}.card{overflow:hidden;border:1px solid #2d3640;border-radius:14px;background:#12161b;display:flex;flex-direction:column;min-height:248px}.card.selected{border-color:#7c8728;box-shadow:0 0 0 1px rgba(234,255,56,.15)}.thumb{width:100%;height:125px;object-fit:cover;background:#07090b;display:block}.thumb.blank{display:grid;place-items:center;color:#5c6670;font:800 9px ui-monospace,monospace}.cardbody{display:flex;flex-direction:column;gap:7px;padding:11px;flex:1}.badges{display:flex;gap:5px;flex-wrap:wrap}.badge{display:inline-flex;border:1px solid #3b4550;border-radius:999px;padding:4px 6px;font:850 8px/1 ui-monospace,monospace;color:#aeb7c0}.badge.week{color:var(--acid);border-color:#66711f}.title{font-size:17px;font-weight:950;line-height:1.35;letter-spacing:-.02em}.summary{font-size:11px;line-height:1.62;color:#a9b2bc;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.cardactions{display:flex;gap:6px;margin-top:auto}.mini{border-radius:7px;padding:6px 8px;font-size:9px}.mini.add{margin-left:auto}.selected .mini.add{background:var(--acid);border-color:var(--acid);color:#090a0b}.field{display:grid;gap:5px;margin-bottom:10px}.field label{font-size:9px;color:#89939e;letter-spacing:.08em}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px}.editorhint{margin:-3px 0 12px;color:#9ca6b0;font-size:10px;line-height:1.55}.selectedlist{display:grid;gap:8px}.sel{border:1px solid #303943;border-radius:11px;background:#0d1014;padding:10px}.selhead{display:grid;grid-template-columns:60px minmax(0,1fr) auto;gap:9px;align-items:start}.sel img,.selblank{width:60px;height:50px;border-radius:7px;object-fit:cover;background:#07090b}.selblank{display:grid;place-items:center;color:#59636e;font-size:7px}.selname{font-size:12px;font-weight:900;line-height:1.35}.selmeta{margin-top:3px;font-size:8px;color:#78838f}.rowactions{display:flex;flex-direction:column;gap:4px}.rowactions button{width:32px;height:28px;border:1px solid #37414c;border-radius:7px;background:#161a20;color:#fff;font-size:10px}.editgrid{display:grid;grid-template-columns:110px 1fr;gap:7px;margin-top:9px}.editgrid.wide{grid-template-columns:1fr}.editgrid .textarea{min-height:68px;font-size:11px}.editgrid .input{height:36px;font-size:11px}.custombox{display:none;margin-top:10px;padding-top:10px;border-top:1px dashed #37404a}.custombox.open{display:block}.save{min-height:15px;margin-top:8px;font-size:9px;color:#8e99a4}.preview{border-radius:12px;background:#fff;color:#111;overflow:auto;max-height:700px}.previewin{padding:18px}.ref{display:inline-flex;margin-top:8px;color:var(--acid);font-size:10px;text-decoration:none}.empty{border:1px dashed #39434e;border-radius:13px;padding:26px;text-align:center;color:#75808b;font-size:11px}
/* WordPress preview */
.hw-weekly{max-width:920px;margin:0 auto;color:#181818;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.hw-weekly *{box-sizing:border-box}.hw-log{padding:42px 34px 48px;background:#f4f0e8;border:1px solid #111}.hw-kicker{font-size:11px;font-weight:950;letter-spacing:.18em;text-transform:uppercase}.hw-log h2,.hw-board h2{margin:10px 0 14px;font-size:clamp(34px,6vw,62px);line-height:1;letter-spacing:-.055em;color:#111}.hw-intro{max-width:700px;margin:0;font-size:15px;line-height:1.85}.hw-stats{display:flex;gap:10px;flex-wrap:wrap;margin:24px 0 30px}.hw-stat{border:1px solid #111;padding:10px 12px;background:#fff}.hw-stat b{display:block;font-size:23px;line-height:1}.hw-stat span{font-size:9px;font-weight:900;letter-spacing:.1em}.hw-game{padding:28px 0;border-top:1px solid #171717}.hw-game-meta{display:flex;gap:10px;align-items:flex-end;justify-content:space-between}.hw-date{font-size:13px;font-weight:900}.hw-date small{display:block;font-size:10px;font-weight:700}.hw-pick{font-size:10px;font-weight:950;letter-spacing:.14em}.hw-game-kicker{margin-top:20px;font-size:9px;font-weight:950;letter-spacing:.15em}.hw-game-title{margin:5px 0 0;font-size:31px;font-weight:950;letter-spacing:-.04em;line-height:1.08}.hw-game-image{width:100%;margin:15px 0 0;border:1px solid #111;display:block}.hw-game-text{font-size:15px;line-height:1.9;margin:14px 0 0}.hw-link{display:inline-flex;margin-top:13px;color:#111;text-decoration:none;border-bottom:2px solid #111;font-size:12px;font-weight:900}.hw-dbnote{padding:25px 0 0;margin-top:8px;border-top:1px solid #111;font-size:13px;line-height:1.8}.hw-board{margin-top:34px;padding:38px 30px;background:#101215;color:#fff}.hw-board .hw-kicker,.hw-board h2{color:#fff}.hw-board .hw-intro{color:#d8dde1}.hw-board-stats{display:flex;gap:10px;margin:22px 0 24px}.hw-board-stat{border:1px solid #525a63;padding:10px 12px}.hw-board-stat b{display:block;font-size:22px}.hw-board-stat span{font-size:8px;letter-spacing:.1em}.hw-updates{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.hw-update{border:1px solid #3b424a;background:#171b20;padding:18px;min-height:210px;display:flex;flex-direction:column}.hw-update.feature{grid-row:span 2;min-height:432px}.hw-update-num{font-size:10px;color:#eaff38;font-weight:950;letter-spacing:.12em}.hw-update-label{margin-top:13px;font-size:9px;color:#aeb6bf;font-weight:900;letter-spacing:.12em}.hw-update-title{margin:7px 0 0;font-size:24px;font-weight:950;line-height:1.15}.hw-update-img{width:100%;height:150px;object-fit:cover;margin:14px 0 0;border:1px solid #343b43}.hw-update.feature .hw-update-img{height:220px}.hw-update-text{font-size:13px;line-height:1.8;color:#d5dade;margin:12px 0 0}.hw-update a{margin-top:auto;padding-top:14px;color:#eaff38;text-decoration:none;font-size:11px;font-weight:900}.hw-board-foot{margin:22px 0 0;padding-top:18px;border-top:1px solid #3e454d;color:#b9c0c6;font-size:11px;line-height:1.7}.hw-tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.hw-tags span{border:1px solid #4a525a;padding:6px 8px;font-size:8px;font-weight:900;letter-spacing:.1em}.hw-memo{padding:30px;background:#eaff38;color:#111}.hw-memo .hw-kicker{color:#111}.hw-memo p{white-space:pre-line;font-size:15px;line-height:1.95;margin:14px 0 0}.hw-memo-link{display:inline-flex;margin-top:18px;color:#111;text-decoration:none;border-bottom:2px solid #111;font-size:12px;font-weight:950}@media(max-width:1200px){.app{grid-template-columns:minmax(0,1fr) 500px}.sourcegrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:920px){.app{display:block}.library{border-right:0;border-bottom:1px solid var(--line)}.filters{grid-template-columns:1fr}.hw-updates{grid-template-columns:1fr}.hw-update.feature{grid-row:auto;min-height:260px}}@media(max-width:600px){.library,.editor{padding:18px 14px 38px}.top{display:block}.range{display:inline-block;margin-top:14px}.sourcegrid{grid-template-columns:repeat(2,1fr)}.cards{grid-template-columns:1fr}.grid2,.grid3{grid-template-columns:1fr}.editgrid{grid-template-columns:1fr}h1{font-size:34px}.hw-log,.hw-board,.hw-memo{padding:26px 20px}.hw-game-title{font-size:26px}}
</style>
</head>
<body>
<div class="app">
<main class="library">
  <div class="top">
    <div><div class="kicker">HARF-WAY / MONDAY AUTOMATION</div><h1>WEEKLY 編集室</h1><p class="desc">現在の「HARF-WAY週刊ニュース」と同じ3段構成に合わせたPreviewです。左で素材を拾い、右で文章・日付・ラベル・リンクまで手動調整できます。</p><a class="ref" href="https://harf-way.com/weekly/news_2026_august4week/" target="_blank" rel="noopener">現在の週刊ニュースを開く ↗</a></div>
    <div class="range" id="range">読み込み中…</div>
  </div>

  <section class="panel">
    <div class="paneltitle">SOURCE LIBRARY</div>
    <div class="tabs"><button class="tab on" data-mode="games">WEEKDAY GAME LOG</button><button class="tab" data-mode="updates">WEEKLY BOARD</button></div>
    <div class="sourcegrid">
      <div class="source"><span>週次候補</span><b id="weeklyCount">--</b></div>
      <div class="source"><span>WordPress</span><b id="wpCount">--</b></div>
      <div class="source"><span>ヨリミチ</span><b id="yorimichiCount">--</b></div>
      <div class="source"><span>WAYS候補</span><b id="waysCount">--</b></div>
    </div>
    <div class="toolbar" style="margin-top:11px"><button class="btn primary" id="autoFill">自動で下書き</button><button class="btn" id="refresh">再取得</button><button class="btn" id="toggleCustom">＋ 手動追加</button><button class="btn danger" id="clearMode">この欄を空にする</button></div>
    <div class="filters"><input class="input" id="query" placeholder="タイトル・本文・URLで検索"><select class="select" id="typeFilter"><option value="">すべて</option></select></div>
    <div class="custombox" id="customBox"><div class="grid2"><input class="input" id="customTitle" placeholder="タイトル"><input class="input" id="customUrl" placeholder="URL（任意）"></div><textarea class="textarea" id="customText" placeholder="説明文（任意）" style="margin-top:7px"></textarea><button class="btn primary" id="addCustom" style="margin-top:7px">この内容を追加</button></div>
    <div class="status" id="status">データ取得中…</div><div class="warn" id="warnings"></div>
  </section>

  <div class="cards" id="cards"><div class="empty">先週分を集めています…</div></div>
</main>

<aside class="editor">
  <section class="panel">
    <div class="paneltitle">ISSUE / HEADER</div>
    <div class="grid2"><div class="field"><label>号の表記</label><input class="input" id="weekLabel" placeholder="August WEEK 5"></div><div class="field"><label>投稿タイトル用</label><input class="input" id="jpWeekLabel" placeholder="2026年8月5週目"></div></div>
    <div class="field"><label>GAME LOGタイトル</label><input class="input" id="gameHeading" value="今週紹介したゲーム"></div>
    <div class="field"><label>GAME LOGリード</label><textarea class="textarea" id="gameLead">平日に拾ったゲームを、週末にまとめて振り返ります。\n気になった作品は、Xの映像とHARF-WAYデータベースからどうぞ。</textarea></div>
    <div class="grid3"><div class="field"><label>WEEKDAYS</label><input class="input" id="weekdayCount" value="5"></div><div class="field"><label>GAMES</label><input class="input" id="gameCount" value="0"></div><div class="field"><label>3つ目のSTAT</label><input class="input" id="thirdStat" value="ALL IN DATABASE"></div></div>
  </section>

  <section class="panel">
    <div class="paneltitle">WEEKDAY GAME LOG</div>
    <div class="editorhint">WAYSから選択後、曜日・日付・紹介文・Xリンクをここで修正できます。WAYS側に追加日時が無いため、週次の正誤だけ人の確認を残しています。</div>
    <div class="selectedlist" id="gameSelected"><div class="empty">左のWAYS候補からゲームを追加してください。</div></div>
  </section>

  <section class="panel">
    <div class="paneltitle">WEEKLY BOARD</div>
    <div class="field"><label>BOARDタイトル</label><input class="input" id="boardHeading" value="今週のHARF-WAY"></div>
    <div class="field"><label>BOARDリード</label><textarea class="textarea" id="boardLead">サイトのあちこちで更新したものを、今週の案内板にまとめました。大きく変わった場所から、気になるところへ寄り道してみてください。</textarea></div>
    <div class="grid2"><div class="field"><label>SITE UPDATES</label><input class="input" id="updateCount" value="0"></div><div class="field"><label>STREET NEW ARRIVALS</label><input class="input" id="arrivalCount" value="0"></div></div>
    <div class="editorhint">一番上の項目を大きなカードとして表示します。↑↓で「今週もっとも大きな更新」を変更できます。</div>
    <div class="selectedlist" id="updateSelected"><div class="empty">左の週次候補から更新を追加してください。</div></div>
    <div class="field" style="margin-top:10px"><label>BOARD末尾メモ</label><textarea class="textarea" id="boardFoot">今週もっとも大きな更新を左上へ。残りは役割ごとのカードとして並べています。</textarea></div>
    <div class="field"><label>下部タグ（カンマ区切り）</label><input class="input" id="boardTags" value="STREET, ARCHIVE, SCRAPS, PLAYLIST"></div>
  </section>

  <section class="panel">
    <div class="paneltitle">WEEKLY MEMO</div>
    <textarea class="textarea" id="memo" style="min-height:150px" placeholder="今週の編集後記"></textarea>
    <div class="grid2" style="margin-top:8px"><input class="input" id="memoLinkLabel" value="ヨリミチポストに投函する"><input class="input" id="memoLink" placeholder="リンクURL（任意）"></div>
  </section>

  <section class="panel">
    <div class="paneltitle">SAVE / OUTPUT</div>
    <div class="toolbar"><button class="btn primary" id="save">ローカル保存</button><button class="btn" id="copyBundle">HTML + CSS COPY</button><button class="btn" id="copyHtml">HTML COPY</button><button class="btn" id="exportJson">JSON</button></div>
    <div class="save" id="saveStatus">Preview / Production DBには保存しません</div>
  </section>

  <section class="panel">
    <div class="paneltitle">WORDPRESS PREVIEW</div>
    <div class="preview"><div class="previewin" id="preview"></div></div>
  </section>
</aside>
</div>

<script is:inline>
const $=s=>document.querySelector(s);let payload=null,items=[],mode='games',gameIds=[],updateIds=[],gameEdit={},updateEdit={};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nl=s=>esc(s).replace(/\n/g,'<br>');
const typeLabel=t=>({ARTICLE:'記事',PLAYLIST:'PLAYLIST',SCRAPS:'切れ端',YORIMICHI:'ヨリミチ',NEWS:'NEWS',DIARY:'日記',WAYS:'WAYS',CUSTOM:'手動'}[t]||t);
function storageKey(){return `harfway-weekly-current:${payload?.range?.start||'draft'}`}
function item(id){return items.find(x=>x.id===id)||{id,title:'手動項目',summary:'',url:'',image:'',type:'CUSTOM',source:'MANUAL'}}
function defaultWeek(){const end=new Date(payload?.range?.end||Date.now()),d=new Date(end.getTime()-86400000);const en=d.toLocaleDateString('en-US',{timeZone:'Asia/Tokyo',month:'long'});const jp=`${d.getFullYear()}年${d.getMonth()+1}月`;const n=Math.max(1,Math.ceil(d.getDate()/7));if(!$('#weekLabel').value)$('#weekLabel').value=`${en} WEEK ${n}`;if(!$('#jpWeekLabel').value)$('#jpWeekLabel').value=`${jp}${n}週目`}
function counts(){const s=payload?.sources||{};$('#weeklyCount').textContent=payload?.weeklyCount??0;$('#wpCount').textContent=s.wordpress?.count??0;$('#yorimichiCount').textContent=s.yorimichi?.count??0;$('#waysCount').textContent=s.ways?.count??0;$('#range').textContent=payload?.range?.label||'--'}
function currentIds(){return mode==='games'?gameIds:updateIds}
function currentPool(){return mode==='games'?items.filter(x=>x.type==='WAYS'||x.type==='CUSTOM'):items.filter(x=>x.weeklyVerified||x.type==='CUSTOM')}
function buildTypeFilter(){const types=[...new Set(currentPool().map(x=>x.type))];$('#typeFilter').innerHTML='<option value="">すべて</option>'+types.map(t=>`<option value="${esc(t)}">${esc(typeLabel(t))}</option>`).join('')}
function filtered(){const q=$('#query').value.toLowerCase().trim(),type=$('#typeFilter').value;return currentPool().filter(x=>{if(type&&x.type!==type)return false;if(q&&!`${x.title} ${x.summary} ${x.url} ${x.source}`.toLowerCase().includes(q))return false;return true})}
function toggle(id){const a=currentIds();if(a.includes(id)){if(mode==='games')gameIds=gameIds.filter(x=>x!==id);else updateIds=updateIds.filter(x=>x!==id)}else{if(mode==='games')gameIds=[...gameIds,id];else updateIds=[...updateIds,id]}renderAll()}
function renderCards(){const ids=currentIds(),list=filtered();$('#cards').innerHTML=list.length?list.map(x=>{const sel=ids.includes(x.id);return `<article class="card ${sel?'selected':''}">${x.image?`<img class="thumb" src="${esc(x.image)}" alt="" loading="lazy">`:'<div class="thumb blank">NO IMAGE</div>'}<div class="cardbody"><div class="badges"><span class="badge">${esc(typeLabel(x.type))}</span><span class="badge">${esc(x.source)}</span>${x.weeklyVerified?'<span class="badge week">WEEK VERIFIED</span>':''}</div><div class="title">${esc(x.title)}</div><div class="summary">${esc(x.summary||'説明なし')}</div><div class="cardactions"><a class="mini" href="${esc(x.url||'#')}" target="_blank" rel="noopener">OPEN ↗</a><button class="mini add" data-toggle="${esc(x.id)}">${sel?'✓ 選択中':'＋ 追加'}</button></div></div></article>`}).join(''):'<div class="empty">この条件に一致する候補はありません。</div>'}
function gameData(id,i){const x=item(id),d=gameEdit[id]||{};return{day:d.day||'',date:d.date||'',pickup:d.pickup||String(i+1).padStart(2,'0'),title:d.title??x.title,text:d.text??x.summary,xUrl:d.xUrl||'',dbUrl:d.dbUrl||x.url||'',image:d.image??x.image||''}}
function updateData(id,i){const x=item(id),d=updateEdit[id]||{};return{label:d.label||typeLabel(x.type),title:d.title??x.title,text:d.text??x.summary,url:d.url??x.url||'',cta:d.cta||defaultCta(x.type),image:d.image??x.image||''}}
function defaultCta(type){return type==='YORIMICHI'?'商店街へ寄り道する':type==='PLAYLIST'?'プレイリストを見る':type==='SCRAPS'?'今週の記録を読む':'詳しく見る'}
function move(arr,id,dir){const i=arr.indexOf(id),j=i+dir;if(i<0||j<0||j>=arr.length)return;[arr[i],arr[j]]=[arr[j],arr[i]]}
function renderGamesSelected(){if(!gameIds.length){$('#gameSelected').innerHTML='<div class="empty">左のWAYS候補からゲームを追加してください。</div>';return}$('#gameSelected').innerHTML=gameIds.map((id,i)=>{const x=item(id),d=gameData(id,i);return `<div class="sel"><div class="selhead">${x.image?`<img src="${esc(x.image)}" alt="">`:'<div class="selblank">NO IMG</div>'}<div><div class="selname">PICKUP ${esc(d.pickup)} / ${esc(d.title)}</div><div class="selmeta">${esc(x.source)} / ${esc(typeLabel(x.type))}</div></div><div class="rowactions"><button data-gup="${esc(id)}">↑</button><button data-gdown="${esc(id)}">↓</button><button data-gremove="${esc(id)}">×</button></div></div><div class="editgrid"><input class="input" data-gfield="day" data-id="${esc(id)}" value="${esc(d.day)}" placeholder="月曜日"><input class="input" data-gfield="date" data-id="${esc(id)}" value="${esc(d.date)}" placeholder="8月24日"></div><div class="editgrid"><input class="input" data-gfield="pickup" data-id="${esc(id)}" value="${esc(d.pickup)}" placeholder="01"><input class="input" data-gfield="title" data-id="${esc(id)}" value="${esc(d.title)}"></div><div class="editgrid wide"><textarea class="textarea" data-gfield="text" data-id="${esc(id)}">${esc(d.text)}</textarea></div><div class="editgrid"><input class="input" data-gfield="xUrl" data-id="${esc(id)}" value="${esc(d.xUrl)}" placeholder="X投稿URL"><input class="input" data-gfield="dbUrl" data-id="${esc(id)}" value="${esc(d.dbUrl)}" placeholder="DB / 記事URL"></div><div class="editgrid wide"><input class="input" data-gfield="image" data-id="${esc(id)}" value="${esc(d.image)}" placeholder="画像URL（任意）"></div></div>`}).join('')}
function renderUpdatesSelected(){if(!updateIds.length){$('#updateSelected').innerHTML='<div class="empty">左の週次候補から更新を追加してください。</div>';return}$('#updateSelected').innerHTML=updateIds.map((id,i)=>{const x=item(id),d=updateData(id,i);return `<div class="sel"><div class="selhead">${x.image?`<img src="${esc(x.image)}" alt="">`:'<div class="selblank">NO IMG</div>'}<div><div class="selname">${String(i+1).padStart(2,'0')} / ${esc(d.title)}</div><div class="selmeta">${i===0?'FEATURE / 大カード':esc(x.source)}</div></div><div class="rowactions"><button data-uup="${esc(id)}">↑</button><button data-udown="${esc(id)}">↓</button><button data-uremove="${esc(id)}">×</button></div></div><div class="editgrid"><input class="input" data-ufield="label" data-id="${esc(id)}" value="${esc(d.label)}" placeholder="ARCHIVE RENEWAL"><input class="input" data-ufield="title" data-id="${esc(id)}" value="${esc(d.title)}"></div><div class="editgrid wide"><textarea class="textarea" data-ufield="text" data-id="${esc(id)}">${esc(d.text)}</textarea></div><div class="editgrid"><input class="input" data-ufield="cta" data-id="${esc(id)}" value="${esc(d.cta)}"><input class="input" data-ufield="url" data-id="${esc(id)}" value="${esc(d.url)}" placeholder="リンクURL"></div><div class="editgrid wide"><input class="input" data-ufield="image" data-id="${esc(id)}" value="${esc(d.image)}" placeholder="画像URL（任意）"></div></div>`}).join('')}
function syncStats(){$('#gameCount').value=gameIds.length;$('#updateCount').value=updateIds.length;$('#arrivalCount').value=updateIds.filter(id=>item(id).type==='YORIMICHI').length}
function html(){const games=gameIds.map(gameData),updates=updateIds.map(updateData),tags=$('#boardTags').value.split(',').map(x=>x.trim()).filter(Boolean);return `<div class="hw-weekly"><section class="hw-log"><div class="hw-kicker">WEEKDAY GAME LOG / ${esc($('#weekLabel').value)}</div><h2>${esc($('#gameHeading').value)}</h2><p class="hw-intro">${nl($('#gameLead').value)}</p><div class="hw-stats"><div class="hw-stat"><b>${esc($('#weekdayCount').value)}</b><span>WEEKDAYS</span></div><div class="hw-stat"><b>${esc($('#gameCount').value)}</b><span>GAMES</span></div><div class="hw-stat"><b>✓</b><span>${esc($('#thirdStat').value)}</span></div></div>${games.map((g,i)=>`<article class="hw-game"><div class="hw-game-meta"><div class="hw-date">${esc(g.day||'曜日')}<small>${esc(g.date||'日付')}</small></div><div class="hw-pick">PICKUP ${esc(g.pickup||String(i+1).padStart(2,'0'))}</div></div><div class="hw-game-kicker">TODAY'S GAME</div><div class="hw-game-title">${esc(g.title)}</div>${g.image?`<img class="hw-game-image" src="${esc(g.image)}" alt="">`:''}${g.text?`<p class="hw-game-text">${nl(g.text)}</p>`:''}${g.xUrl?`<a class="hw-link" href="${esc(g.xUrl)}" target="_blank" rel="noopener">Xで投稿を見る</a>`:''}${g.dbUrl?`<a class="hw-link" href="${esc(g.dbUrl)}" target="_blank" rel="noopener" style="margin-left:14px">記録を見る</a>`:''}</article>`).join('')}<div class="hw-dbnote">今週登場したゲームは、HARF-WAYデータベースにも追加しています。</div></section><section class="hw-board"><div class="hw-kicker">HARF-WAY WEEKLY BOARD / ${esc($('#weekLabel').value)}</div><h2>${esc($('#boardHeading').value)}</h2><p class="hw-intro">${nl($('#boardLead').value)}</p><div class="hw-board-stats"><div class="hw-board-stat"><b>${esc($('#updateCount').value)}</b><span>SITE UPDATES</span></div><div class="hw-board-stat"><b>${esc($('#arrivalCount').value)}</b><span>STREET NEW ARRIVALS</span></div></div><div class="hw-updates">${updates.map((u,i)=>`<article class="hw-update ${i===0?'feature':''}"><div class="hw-update-num">${String(i+1).padStart(2,'0')}</div><div class="hw-update-label">${esc(u.label)}</div><div class="hw-update-title">${esc(u.title)}</div>${u.image?`<img class="hw-update-img" src="${esc(u.image)}" alt="">`:''}${u.text?`<p class="hw-update-text">${nl(u.text)}</p>`:''}${u.url?`<a href="${esc(u.url)}" target="_blank" rel="noopener">${esc(u.cta)} →</a>`:''}</article>`).join('')}</div>${$('#boardFoot').value?`<p class="hw-board-foot">${nl($('#boardFoot').value)}</p>`:''}${tags.length?`<div class="hw-tags">${tags.map(t=>`<span>${esc(t)}</span>`).join('')}</div>`:''}</section><section class="hw-memo"><div class="hw-kicker">WEEKLY MEMO</div><p>${nl($('#memo').value||'今週のメモをここに書きます。')}</p>${$('#memoLink').value?`<a class="hw-memo-link" href="${esc($('#memoLink').value)}">${esc($('#memoLinkLabel').value||'続きを読む')} →</a>`:''}</section></div>`}
const wpCss=`.hw-weekly{max-width:920px;margin:0 auto;color:#181818;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.hw-weekly *{box-sizing:border-box}.hw-log{padding:42px 34px 48px;background:#f4f0e8;border:1px solid #111}.hw-kicker{font-size:11px;font-weight:950;letter-spacing:.18em;text-transform:uppercase}.hw-log h2,.hw-board h2{margin:10px 0 14px;font-size:clamp(34px,6vw,62px);line-height:1;letter-spacing:-.055em;color:#111}.hw-intro{max-width:700px;margin:0;font-size:15px;line-height:1.85}.hw-stats{display:flex;gap:10px;flex-wrap:wrap;margin:24px 0 30px}.hw-stat{border:1px solid #111;padding:10px 12px;background:#fff}.hw-stat b{display:block;font-size:23px;line-height:1}.hw-stat span{font-size:9px;font-weight:900;letter-spacing:.1em}.hw-game{padding:28px 0;border-top:1px solid #171717}.hw-game-meta{display:flex;gap:10px;align-items:flex-end;justify-content:space-between}.hw-date{font-size:13px;font-weight:900}.hw-date small{display:block;font-size:10px;font-weight:700}.hw-pick{font-size:10px;font-weight:950;letter-spacing:.14em}.hw-game-kicker{margin-top:20px;font-size:9px;font-weight:950;letter-spacing:.15em}.hw-game-title{margin:5px 0 0;font-size:31px;font-weight:950;letter-spacing:-.04em;line-height:1.08}.hw-game-image{width:100%;margin:15px 0 0;border:1px solid #111;display:block}.hw-game-text{font-size:15px;line-height:1.9;margin:14px 0 0}.hw-link{display:inline-flex;margin-top:13px;color:#111;text-decoration:none;border-bottom:2px solid #111;font-size:12px;font-weight:900}.hw-dbnote{padding:25px 0 0;margin-top:8px;border-top:1px solid #111;font-size:13px;line-height:1.8}.hw-board{margin-top:34px;padding:38px 30px;background:#101215;color:#fff}.hw-board .hw-kicker,.hw-board h2{color:#fff}.hw-board .hw-intro{color:#d8dde1}.hw-board-stats{display:flex;gap:10px;margin:22px 0 24px}.hw-board-stat{border:1px solid #525a63;padding:10px 12px}.hw-board-stat b{display:block;font-size:22px}.hw-board-stat span{font-size:8px;letter-spacing:.1em}.hw-updates{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.hw-update{border:1px solid #3b424a;background:#171b20;padding:18px;min-height:210px;display:flex;flex-direction:column}.hw-update.feature{grid-row:span 2;min-height:432px}.hw-update-num{font-size:10px;color:#eaff38;font-weight:950;letter-spacing:.12em}.hw-update-label{margin-top:13px;font-size:9px;color:#aeb6bf;font-weight:900;letter-spacing:.12em}.hw-update-title{margin:7px 0 0;font-size:24px;font-weight:950;line-height:1.15}.hw-update-img{width:100%;height:150px;object-fit:cover;margin:14px 0 0;border:1px solid #343b43}.hw-update.feature .hw-update-img{height:220px}.hw-update-text{font-size:13px;line-height:1.8;color:#d5dade;margin:12px 0 0}.hw-update a{margin-top:auto;padding-top:14px;color:#eaff38;text-decoration:none;font-size:11px;font-weight:900}.hw-board-foot{margin:22px 0 0;padding-top:18px;border-top:1px solid #3e454d;color:#b9c0c6;font-size:11px;line-height:1.7}.hw-tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.hw-tags span{border:1px solid #4a525a;padding:6px 8px;font-size:8px;font-weight:900;letter-spacing:.1em}.hw-memo{padding:30px;background:#eaff38;color:#111}.hw-memo .hw-kicker{color:#111}.hw-memo p{white-space:pre-line;font-size:15px;line-height:1.95;margin:14px 0 0}.hw-memo-link{display:inline-flex;margin-top:18px;color:#111;text-decoration:none;border-bottom:2px solid #111;font-size:12px;font-weight:950}@media(max-width:700px){.hw-log,.hw-board,.hw-memo{padding:26px 20px}.hw-updates{grid-template-columns:1fr}.hw-update.feature{grid-row:auto;min-height:260px}.hw-game-title{font-size:26px}}`;
function renderPreview(){syncStats();$('#preview').innerHTML=html()}
function renderAll(){buildTypeFilter();renderCards();renderGamesSelected();renderUpdatesSelected();renderPreview()}
function autoFill(){updateIds=items.filter(x=>x.weeklyVerified&&!['DIARY','NEWS'].includes(x.type)).slice(0,5).map(x=>x.id);if(updateIds.length<5)updateIds=[...updateIds,...items.filter(x=>x.weeklyVerified&&!updateIds.includes(x.id)).slice(0,5-updateIds.length).map(x=>x.id)];gameIds=items.filter(x=>x.type==='WAYS').slice(0,11).map(x=>x.id);const start=new Date(payload.range.start);gameIds.forEach((id,i)=>{const d=new Date(start.getTime()+Math.min(i,6)*86400000);gameEdit[id]={...(gameEdit[id]||{}),day:new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',weekday:'long'}).format(d),date:new Intl.DateTimeFormat('ja-JP',{timeZone:'Asia/Tokyo',month:'long',day:'numeric'}).format(d),pickup:String(i+1).padStart(2,'0')}});renderAll();flash('自動下書きを作りました。WAYSの週次判定だけ確認してください')}
function addCustom(){const title=$('#customTitle').value.trim();if(!title)return;const id=`custom-${Date.now()}`,x={id,title,summary:$('#customText').value.trim(),url:$('#customUrl').value.trim(),image:'',type:'CUSTOM',source:'MANUAL',weeklyVerified:mode==='updates'};items=[x,...items];if(mode==='games')gameIds.push(id);else updateIds.push(id);$('#customTitle').value='';$('#customText').value='';$('#customUrl').value='';renderAll()}
function saveLocal(){const fields=['weekLabel','jpWeekLabel','gameHeading','gameLead','weekdayCount','gameCount','thirdStat','boardHeading','boardLead','updateCount','arrivalCount','boardFoot','boardTags','memo','memoLinkLabel','memoLink'];const data={gameIds,updateIds,gameEdit,updateEdit,fields:Object.fromEntries(fields.map(id=>[id,$('#'+id).value])),custom:items.filter(x=>x.type==='CUSTOM'),savedAt:new Date().toISOString()};localStorage.setItem(storageKey(),JSON.stringify(data));flash('ローカル保存しました')}
function loadLocal(){try{const d=JSON.parse(localStorage.getItem(storageKey())||'null');if(!d)return;gameIds=d.gameIds||[];updateIds=d.updateIds||[];gameEdit=d.gameEdit||{};updateEdit=d.updateEdit||{};if(Array.isArray(d.custom))items=[...d.custom,...items];Object.entries(d.fields||{}).forEach(([id,v])=>{if($('#'+id))$('#'+id).value=v})}catch{}}
function flash(t){$('#saveStatus').textContent=t;setTimeout(()=>$('#saveStatus').textContent='Preview / Production DBには保存しません',2200)}
async function copy(v,msg){await navigator.clipboard.writeText(v);flash(msg)}
async function load(){try{$('#status').textContent='HARF-WAY / WAYS / ヨリミチから先週分を取得中…';const r=await fetch('/api/weekly-harfway-source',{cache:'no-store'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||r.status);payload=d;items=d.items||[];counts();defaultWeek();loadLocal();$('#warnings').textContent=(d.warnings||[]).join(' / ');$('#status').textContent=`取得完了：週次確認済み ${d.weeklyCount||0}件 / WAYS候補 ${d.sources?.ways?.count||0}件`;renderAll()}catch(e){$('#status').textContent='取得に失敗しました';$('#warnings').textContent=String(e?.message||e);$('#cards').innerHTML='<div class="empty">素材を読み込めませんでした。</div>'}}

document.querySelector('.tabs').onclick=e=>{const b=e.target.closest('[data-mode]');if(!b)return;mode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('on',x===b));$('#query').value='';renderAll()};
$('#cards').onclick=e=>{const b=e.target.closest('[data-toggle]');if(b)toggle(b.dataset.toggle)};$('#query').oninput=renderCards;$('#typeFilter').onchange=renderCards;$('#autoFill').onclick=autoFill;$('#refresh').onclick=load;$('#toggleCustom').onclick=()=>$('#customBox').classList.toggle('open');$('#addCustom').onclick=addCustom;$('#clearMode').onclick=()=>{if(mode==='games')gameIds=[];else updateIds=[];renderAll()};
$('#gameSelected').oninput=e=>{const t=e.target.closest('[data-gfield]');if(!t)return;gameEdit[t.dataset.id]={...(gameEdit[t.dataset.id]||{}),[t.dataset.gfield]:t.value};renderPreview()};$('#gameSelected').onclick=e=>{const up=e.target.closest('[data-gup]'),down=e.target.closest('[data-gdown]'),rem=e.target.closest('[data-gremove]');if(up){move(gameIds,up.dataset.gup,-1)}if(down){move(gameIds,down.dataset.gdown,1)}if(rem){gameIds=gameIds.filter(x=>x!==rem.dataset.gremove)}renderAll()};
$('#updateSelected').oninput=e=>{const t=e.target.closest('[data-ufield]');if(!t)return;updateEdit[t.dataset.id]={...(updateEdit[t.dataset.id]||{}),[t.dataset.ufield]:t.value};renderPreview()};$('#updateSelected').onclick=e=>{const up=e.target.closest('[data-uup]'),down=e.target.closest('[data-udown]'),rem=e.target.closest('[data-uremove]');if(up){move(updateIds,up.dataset.uup,-1)}if(down){move(updateIds,down.dataset.udown,1)}if(rem){updateIds=updateIds.filter(x=>x!==rem.dataset.uremove)}renderAll()};
['weekLabel','jpWeekLabel','gameHeading','gameLead','weekdayCount','gameCount','thirdStat','boardHeading','boardLead','updateCount','arrivalCount','boardFoot','boardTags','memo','memoLinkLabel','memoLink'].forEach(id=>$('#'+id).addEventListener('input',renderPreview));$('#save').onclick=saveLocal;$('#copyBundle').onclick=()=>copy(`<style>${wpCss}</style>${html()}`,'HTML + CSSをコピーしました');$('#copyHtml').onclick=()=>copy(html(),'HTMLをコピーしました');$('#exportJson').onclick=()=>{const data={weekLabel:$('#weekLabel').value,jpWeekLabel:$('#jpWeekLabel').value,gameIds,updateIds,gameEdit,updateEdit,memo:$('#memo').value};const b=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=`weekly-harfway-${Date.now()}.json`;a.click()};load();
</script>
</body>
