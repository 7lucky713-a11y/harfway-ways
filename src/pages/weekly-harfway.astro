<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>WEEKLY HARF-WAY / AUTO SAVE + X + WAYS SECTIONS</title>
<style>
html,body{margin:0;min-height:100%;background:#0a0b0d;color:#f4f5f2;font-family:Inter,system-ui,-apple-system,"Noto Sans JP",sans-serif}.boot{min-height:100vh;display:grid;place-items:center}.box{width:min(560px,calc(100vw - 32px));border:1px solid #303943;border-radius:16px;background:#12151a;padding:24px}.k{font:900 11px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:#eaff38}.t{font-size:28px;font-weight:950;margin:8px 0}.s{color:#9ba5af;font-size:13px;line-height:1.7}.err{color:#ffb2b2;white-space:pre-wrap}</style>
</head>
<body>
<div class="boot"><div class="box"><div class="k">HARF-WAY / PREVIEW UPDATE</div><div class="t">WEEKLY 編集室を読み込み中…</div><div class="s" id="status">区切り・X独立素材・自動保存を組み込んでいます。</div></div></div>
<script>
(async()=>{
  const status=document.getElementById('status');
  try{
    const sourceUrl='https://raw.githubusercontent.com/7lucky713-a11y/harfway-ways/618137fc35ddd5fc4a6c3ce2d8573794419ea9ea/src/pages/weekly-harfway.astro';
    const helperUrl='https://raw.githubusercontent.com/7lucky713-a11y/harfway-ways/a2ded72c132f2a8e6d229eb1862f89931456919f/public/weekly-x-library.js';
    const autosaveUrl='https://raw.githubusercontent.com/7lucky713-a11y/harfway-ways/e81d6b130c580f360c8b7a2f39ab9eb2da19d194/public/weekly-autosave.js';
    const [sourceRes,helperRes,autosaveRes]=await Promise.all([fetch(sourceUrl,{cache:'no-store'}),fetch(helperUrl,{cache:'no-store'}),fetch(autosaveUrl,{cache:'no-store'})]);
    if(!sourceRes.ok)throw new Error('source_'+sourceRes.status);
    if(!helperRes.ok)throw new Error('x_helper_'+helperRes.status);
    if(!autosaveRes.ok)throw new Error('autosave_helper_'+autosaveRes.status);
    let html=await sourceRes.text();
    const helper=await helperRes.text();
    const autosave=await autosaveRes.text();
    html=html.replace(/^---\s*---\s*/,'')
      .replace('<style is:global>','<style>')
      .replace('<script is:inline>','<script>')
      .replaceAll("image:d.image??x.image||''","image:(d.image??x.image??'')")
      .replaceAll("url:d.url??x.url||''","url:(d.url??x.url??'')")
      .replaceAll('<h2>','<div class="hw-section-title">')
      .replaceAll('</h2>','</div>')
      .replaceAll('.hw-log h2,.hw-board h2','.hw-section-title')
      .replace('.hw-game{padding:28px 0;border-top:1px solid #171717}', '.hw-game{padding:24px;margin:18px 0 0;border:1px solid #111;background:#fff;box-shadow:6px 6px 0 #111}.hw-game:first-of-type{margin-top:0}.hw-xembed{margin:18px 0 0;padding:14px;background:#f5f5f5;border:1px solid #cfd3d6}.hw-xembed .twitter-tweet{margin:0 auto!important}.hw-xfallback{display:inline-flex;margin-top:10px;color:#111;text-decoration:none;border-bottom:2px solid #111;font-size:12px;font-weight:900}')
      .replace('.card.selected{border-color:#7c8728;box-shadow:0 0 0 1px rgba(234,255,56,.15)}', '.card.selected{border-color:#7c8728;box-shadow:0 0 0 1px rgba(234,255,56,.15)}.card.ways-card{position:relative;border-color:#59621f;background:linear-gradient(180deg,#15190f,#101318)}.card.ways-card:before{content:"WAYS";position:absolute;z-index:3;left:9px;top:9px;padding:5px 7px;border-radius:999px;background:#eaff38;color:#090a0b;font:950 8px/1 ui-monospace,monospace;letter-spacing:.1em}.card.ways-card .thumb{border-bottom:1px solid #59621f}.card.ways-card .title{color:#f7ffd1}.card.ways-card .badge:first-child{background:#eaff38;border-color:#eaff38;color:#090a0b}')
      .replace('.editgrid .input{height:36px;font-size:11px}', '.editgrid .input{height:36px;font-size:11px}.game-edit-tabs{display:flex;gap:6px;margin-top:10px;padding-top:10px;border-top:1px solid #29313a}.game-edit-tab{border:1px solid #39434e;border-radius:999px;background:#11151a;color:#9ea8b2;padding:7px 10px;font-size:9px;font-weight:900;letter-spacing:.05em}.game-edit-tab.on{background:#eaff38;border-color:#eaff38;color:#090a0b}.game-edit-panel{display:none}.game-edit-panel.on{display:block}.game-x-panel{margin-top:8px;padding:12px;border:1px solid #36404a;border-radius:10px;background:#090c10}.game-x-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:8px}.game-x-label{font:900 9px/1 ui-monospace,monospace;letter-spacing:.12em;color:#eaff38}.game-x-state{font-size:8px;color:#7f8a95}.game-x-state.ready{color:#eaff38}.game-x-help{margin-top:8px;font-size:9px;line-height:1.55;color:#7f8a95}.game-x-open{display:inline-flex;margin-top:9px;color:#eaff38;text-decoration:none;border-bottom:1px solid #eaff38;font-size:9px;font-weight:900}')
      .replace('class="card ${sel?\'selected\':\'\'}"', 'class="card ${x.type===\'WAYS\'?\'ways-card\':\'\'} ${sel?\'selected\':\'\'}"')
      .replace('${g.xUrl?`<a class="hw-link" href="${esc(g.xUrl)}" target="_blank" rel="noopener">Xで投稿を見る</a>`:\'\'}', '${g.xUrl?`<div class="hw-xembed"><blockquote class="twitter-tweet" data-dnt="true"><a href="${esc(g.xUrl)}"></a></blockquote><a class="hw-xfallback" href="${esc(g.xUrl)}" target="_blank" rel="noopener">Xで投稿を開く ↗</a></div>`:\'\'}')
      .replace("let payload=null,items=[],mode='games',gameIds=[],updateIds=[],gameEdit={},updateEdit={};", "let payload=null,items=[],mode='games',gameIds=[],updateIds=[],gameEdit={},updateEdit={},gameTab={};")
      .replace("function renderPreview(){syncStats();$('#preview').innerHTML=html()}", `function decorateGameTabs(){document.querySelectorAll('#gameSelected .sel').forEach(sel=>{if(sel.querySelector('.game-edit-tabs'))return;const any=sel.querySelector('[data-gfield]');if(!any)return;const id=any.dataset.id;const grids=[...sel.querySelectorAll(':scope > .editgrid')];if(!grids.length)return;const active=gameTab[id]||'basic';const tabs=document.createElement('div');tabs.className='game-edit-tabs';tabs.innerHTML='<button class="game-edit-tab '+(active==='basic'?'on':'')+'" type="button" data-gtab="basic" data-id="'+esc(id)+'">基本情報</button><button class="game-edit-tab '+(active==='x'?'on':'')+'" type="button" data-gtab="x" data-id="'+esc(id)+'">X POST</button>';const basic=document.createElement('div');basic.className='game-edit-panel '+(active==='basic'?'on':'');const xpanel=document.createElement('div');xpanel.className='game-edit-panel '+(active==='x'?'on':'');const xbox=document.createElement('div');xbox.className='game-x-panel';const xInput=sel.querySelector('[data-gfield="xUrl"]');const dbInput=sel.querySelector('[data-gfield="dbUrl"]');const xUrl=xInput?.value?.trim()||'';xbox.innerHTML='<div class="game-x-head"><div class="game-x-label">X POST EMBED</div><div class="game-x-state '+(xUrl?'ready':'')+'">'+(xUrl?'● 埋め込みあり':'○ URL未設定')+'</div></div>';if(xInput){const row=xInput.closest('.editgrid');const xWrap=document.createElement('div');xWrap.className='editgrid wide';xWrap.appendChild(xInput);xbox.appendChild(xWrap);if(dbInput){const dbWrap=document.createElement('div');dbWrap.className='editgrid wide';dbWrap.appendChild(dbInput);basic.appendChild(dbWrap)}row?.remove()}const help=document.createElement('div');help.className='game-x-help';help.textContent='X投稿URLを貼ると、右下のWordPress Previewに埋め込みが反映されます。';xbox.appendChild(help);if(xUrl){const open=document.createElement('a');open.className='game-x-open';open.href=xUrl;open.target='_blank';open.rel='noopener';open.textContent='Xで投稿を開く ↗';xbox.appendChild(open)}xpanel.appendChild(xbox);grids.forEach(g=>{if(g.isConnected)basic.appendChild(g)});sel.appendChild(tabs);sel.appendChild(basic);sel.appendChild(xpanel)})}\nfunction renderPreview(){syncStats();$('#preview').innerHTML=html();setTimeout(()=>window.twttr?.widgets?.load?.($('#preview')),30)}`)
      .replace("function renderAll(){buildTypeFilter();renderCards();renderGamesSelected();renderUpdatesSelected();renderPreview()}", "function renderAll(){buildTypeFilter();renderCards();renderGamesSelected();decorateGameTabs();renderUpdatesSelected();renderPreview()}")
      .replace("$('#gameSelected').onclick=e=>{const up=e.target.closest('[data-gup]'),down=e.target.closest('[data-gdown]'),rem=e.target.closest('[data-gremove]');if(up){move(gameIds,up.dataset.gup,-1)}if(down){move(gameIds,down.dataset.gdown,1)}if(rem){gameIds=gameIds.filter(x=>x!==rem.dataset.gremove)}renderAll()};", "$('#gameSelected').onclick=e=>{const tab=e.target.closest('[data-gtab]');if(tab){gameTab[tab.dataset.id]=tab.dataset.gtab;document.querySelectorAll('#gameSelected .sel').forEach(sel=>{const any=sel.querySelector('[data-gfield]');if(!any||any.dataset.id!==tab.dataset.id)return;sel.querySelectorAll('.game-edit-tab').forEach(b=>b.classList.toggle('on',b.dataset.gtab===tab.dataset.gtab));const panels=sel.querySelectorAll('.game-edit-panel');panels[0]?.classList.toggle('on',tab.dataset.gtab==='basic');panels[1]?.classList.toggle('on',tab.dataset.gtab==='x')});return}const up=e.target.closest('[data-gup]'),down=e.target.closest('[data-gdown]'),rem=e.target.closest('[data-gremove]');if(up){move(gameIds,up.dataset.gup,-1)}if(down){move(gameIds,down.dataset.gdown,1)}if(rem){gameIds=gameIds.filter(x=>x!==rem.dataset.gremove);delete gameTab[rem.dataset.gremove]}renderAll()};")
      .replace("$('#copyBundle').onclick=()=>copy(`<style>${wpCss}</style>${html()}`,'HTML + CSSをコピーしました')", "$('#copyBundle').onclick=()=>copy(`<style>${wpCss}</style>${html()}<script async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"><\\/script>`,'HTML + CSSをコピーしました')")
      .replace("$('#copyHtml').onclick=()=>copy(html(),'HTMLをコピーしました')", "$('#copyHtml').onclick=()=>copy(`${html()}<script async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"><\\/script>`,'HTMLをコピーしました')");
    const scriptOpen='<scr'+'ipt>';
    const scriptClose='</scr'+'ipt>';
    const twitterOpen='<scr'+'ipt async src="https://platform.twitter.com/widgets.js" charset="utf-8">';
    html=html.replace('</body>',scriptOpen+helper+scriptClose+scriptOpen+autosave+scriptClose+twitterOpen+scriptClose+'</body>');
    document.open();document.write(html);document.close();
  }catch(e){
    status.className='s err';
    status.textContent='修正版の読み込みに失敗しました。\n'+String(e?.message||e);
  }
})();
</script>
</body>
</html>