---
const title = 'MINI BOOK / SMOOTH MOTION TEST';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title}</title>
  <style is:global>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0d110f}
    #smooth-frame{display:block;width:100%;height:100%;border:0;background:#0d110f}
    #boot{position:fixed;inset:0;display:grid;place-items:center;color:#9aa59d;font:12px -apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif;background:#0d110f}
  </style>
</head>
<body>
<div id="boot">SMOOTH MOTION TEST を読み込んでいます…</div>
<iframe id="smooth-frame" title="MINI BOOK smooth motion preview"></iframe>
<script is:inline>
(async()=>{
  const frame=document.getElementById('smooth-frame');
  const boot=document.getElementById('boot');
  try{
    let html=await fetch('/game-notes/minibook-clean/',{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error(`HTTP ${r.status}`);return r.text()});

    html=html.replace('B5 / EBOOK MOTION PREVIEW','B5 / SMOOTH MOTION TEST');
    html=html.replace('FLUID PAGE SWIPE','SMOOTH PAGE SWIPE');
    html=html.replace('ページ送りは3D回転ではなく、電子書籍に近い横スライド＋指追従に変更しています。','ページ送りは次ページを固定し、手前の1枚だけを滑らかに送る方式で調整しています。');

    html=html.replace('</head>',`<style>
      .book-stage.auto-next .motion-page,
      .book-stage.auto-next .static-page,
      .book-stage.auto-prev .motion-page,
      .book-stage.auto-prev .static-page,
      .book-stage.settling .motion-page,
      .book-stage.settling .static-page{
        transition-property:transform,filter,box-shadow!important;
        transition-duration:var(--turn-ms,460ms)!important;
        transition-timing-function:cubic-bezier(.25,.46,.45,.94)!important;
      }
      .book-stage.prep-next .static-page,
      .book-stage.prep-next.auto-next.go .static-page{
        transform:translate3d(0,0,0)!important;
        filter:none!important;
      }
      .book-stage.prep-next .motion-page{box-shadow:10px 0 26px #00000012!important}
      .book-stage.prep-next.auto-next.go .motion-page{box-shadow:18px 0 34px #00000006!important}
      .book-stage.prep-prev .motion-page{box-shadow:10px 0 28px #00000012!important}
      .book-stage.prep-prev.auto-prev.go .motion-page{box-shadow:8px 0 22px #00000008!important}
    </style></head>`);

    html=html.replace("stage.style.setProperty('--turn-ms','330ms')","stage.style.setProperty('--turn-ms','460ms')");
    html=html.replace('setTimeout(()=>finishTo(next),350)','setTimeout(()=>finishTo(next),490)');
    html=html.replace("const ms=Math.round(commit?Math.max(120,280*(1-progress)):190);","const ms=Math.round(commit?(230+300*(1-progress)):(220+220*progress));");

    html=html.replace("under.style.transform=`translate3d(${(1-progress)*4.5}%,0,0) scale(${(.998+.002*progress).toFixed(4)})`;under.style.filter=`brightness(${(.985+.015*progress).toFixed(3)})`","under.style.transform='translate3d(0,0,0)';under.style.filter='none'");
    html=html.replace("under.style.transform=commit?'translate3d(0,0,0) scale(1)':'translate3d(4.5%,0,0) scale(.998)';under.style.filter=commit?'none':'brightness(.985)'","under.style.transform='translate3d(0,0,0)';under.style.filter='none'");

    frame.srcdoc=html;
    frame.addEventListener('load',()=>{boot.style.display='none'},{once:true});
  }catch(err){
    boot.textContent=`読み込みに失敗しました: ${err?.message||err}`;
  }
})();
</script>
</body>
</html>
