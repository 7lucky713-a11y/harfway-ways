<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="same-origin" />
  <title>GLOSSARY — PRIVATE GAME NOTEBOOK</title>
  <style>
    :root{--bg:#090c0a;--panel:#101511;--panel2:#151b16;--line:#273029;--text:#eff4ef;--muted:#89958b;--accent:#dff238;--danger:#ff7b72;--radius:16px;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif;color-scheme:dark}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);min-height:100vh}button,input,select,textarea{font:inherit}button{cursor:pointer}.wrap{max-width:1180px;margin:auto;padding:28px 24px 80px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:52px}.top-actions{display:flex;gap:8px;align-items:center}.back,.public-link{color:var(--muted);text-decoration:none;font-size:14px}.back:hover,.public-link:hover{color:var(--text)}.primary,.ghost,.danger,.publish,.unpublish{border-radius:10px;padding:11px 16px;border:1px solid var(--line);font-weight:700}.primary{background:var(--accent);border-color:var(--accent);color:#10130a}.ghost{background:transparent;color:var(--text)}.ghost:disabled{opacity:.38;cursor:not-allowed}.danger{background:transparent;border-color:#613733;color:var(--danger)}.publish{background:#26320d;border-color:#566817;color:#e5f870}.unpublish{background:transparent;border-color:#5b4636;color:#f2b578}.hero{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;margin-bottom:34px}.eyebrow{font-size:11px;letter-spacing:.18em;color:var(--accent);font-weight:800}.hero h1{font-size:clamp(40px,7vw,78px);line-height:.95;margin:10px 0 14px;letter-spacing:-.055em}.hero p{margin:0;color:var(--muted);font-size:16px;line-height:1.9;max-width:760px}.count{font-size:12px;color:var(--muted);white-space:nowrap}.count b{font-size:36px;color:var(--text);display:block;line-height:1}.tools{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:12px;margin-bottom:28px}.tools input,.tools select{width:100%;background:var(--panel);border:1px solid var(--line);color:var(--text);padding:14px 15px;border-radius:11px;font-size:16px;outline:none}.tools input:focus,.tools select:focus{border-color:#73801e}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:22px;display:grid;gap:14px;min-height:240px;transition:border-color .2s,box-shadow .2s}.card.focused{border-color:var(--accent);box-shadow:0 0 0 1px rgba(223,242,56,.2)}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.pills{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.game-pill,.state-pill{display:inline-flex;font-size:10px;letter-spacing:.08em;border:1px solid var(--line);border-radius:999px;padding:5px 8px}.game-pill{color:#aab6ac}.state-pill.private{color:#879188}.state-pill.candidate{color:#e6f773;border-color:#53631c;background:#1c230d}.state-pill.published{color:#8ee7ba;border-color:#24573d;background:#0d2118}.card h2{font-size:26px;line-height:1.2;margin:6px 0 0;letter-spacing:-.03em}.card p{white-space:pre-wrap;margin:0;color:#d6ded7;font-size:15px;line-height:1.9}.related{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}.chip{font-size:11px;color:#cbd3cc;background:#1a211b;border:1px solid #303a31;border-radius:999px;padding:5px 8px}.chip.linked:hover{border-color:#6a7c36;color:var(--text)}.chip.legacy{opacity:.62;cursor:default}.edit{border:0;background:transparent;color:var(--muted);font-size:12px;padding:4px}.edit:hover{color:var(--accent)}.publication-actions{display:flex;gap:10px;align-items:center;border-top:1px solid var(--line);padding-top:14px}.publication-actions button{padding:8px 12px;font-size:12px}.publication-actions a{color:#aeb9af;font-size:12px;text-decoration:none}.publication-actions a:hover{color:var(--accent)}.empty{grid-column:1/-1;border:1px dashed var(--line);border-radius:var(--radius);padding:56px 24px;text-align:center;color:var(--muted)}.empty b{display:block;color:var(--text);font-size:22px;margin-bottom:8px}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);display:none;align-items:center;justify-content:center;padding:20px;z-index:30}.overlay.on{display:flex}.dialog{width:min(760px,100%);max-height:92vh;overflow:auto;background:#101411;border:1px solid #313b32;border-radius:18px;padding:24px}.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:22px}.dialog-head small{font-size:10px;letter-spacing:.15em;color:var(--accent)}.dialog-head h2{margin:4px 0 0;font-size:30px}.icon{border:0;background:transparent;color:var(--muted);font-size:28px}.form{display:grid;gap:17px}.form label{display:grid;gap:7px;font-size:14px;font-weight:700}.form input,.form select,.form textarea{width:100%;background:#0b0f0c;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:12px 13px;font-size:17px}.form textarea{min-height:190px;resize:vertical;line-height:1.75}.related-editor{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.chips{display:flex;gap:7px;flex-wrap:wrap}.chips button{border:1px solid var(--line);background:#171d18;color:#d7ded8;border-radius:999px;padding:6px 9px;font-size:12px}.relation-note{font-size:12px;color:var(--muted);line-height:1.65;font-weight:400}.candidate-box{border:1px solid var(--line);background:#0d120e;border-radius:12px;padding:14px}.candidate-box label{display:flex;align-items:center;gap:10px;font-size:14px}.candidate-box input{width:auto}.candidate-box small{display:block;color:var(--muted);line-height:1.65;margin-top:7px}.dialog-foot{display:flex;gap:10px;align-items:center;margin-top:8px}.spacer{flex:1}.lock{position:fixed;inset:0;background:#080b09;z-index:50;display:none;place-items:center;padding:24px}.lock.on{display:grid}.lock-card{width:min(440px,100%);background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:28px}.lock-card h1{font-size:38px;margin:0 0 8px}.lock-card p{color:var(--muted);line-height:1.7}.lock-card form{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:18px}.lock-card input{min-width:0;background:#080b09;border:1px solid var(--line);border-radius:10px;color:var(--text);padding:12px}.toast{position:fixed;right:20px;bottom:20px;background:#1a211b;border:1px solid #3b493d;border-radius:10px;padding:11px 14px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none;z-index:70}.toast.on{opacity:1;transform:none}.hidden{display:none!important}
    @media(max-width:760px){.wrap{padding:20px 15px 70px}.top{margin-bottom:38px;align-items:flex-start}.top-actions{flex-direction:column;align-items:flex-end}.hero{grid-template-columns:1fr}.count{display:none}.tools{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.card{min-height:0}.hero h1{font-size:46px}.dialog{padding:20px}.dialog-foot{flex-wrap:wrap}.publication-actions{flex-wrap:wrap}.related-editor{grid-template-columns:1fr}.lock-card form{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <main class="wrap">
    <div class="top">
      <a class="back" href="/game-notes/">← PRIVATE GAME NOTEBOOK</a>
      <div class="top-actions"><a class="public-link" href="/game-wiki/" target="_blank" rel="noopener">公開Wikiを見る ↗</a><button class="primary" id="open-entry">＋ 用語を追加</button></div>
    </div>

    <section class="hero">
      <div>
        <div class="eyebrow">KNOWLEDGE, NOT NOTES</div>
        <h1>GLOSSARY</h1>
        <p>何度も参照するゲーム固有の言葉を、日々のメモとは分けて置いておく。関連語は既存Glossary同士を双方向でつなぎ、公開候補にしても外には出ず、明示的に「公開する」を押した用語だけ公開Wikiへ送る。</p>
      </div>
      <div class="count"><b id="entry-count">0</b> TERMS</div>
    </section>

    <section class="tools">
      <input id="search" type="search" placeholder="用語名・説明・関連語から検索" autocomplete="off" />
      <select id="game-filter"><option value="all">すべてのゲーム</option></select>
    </section>

    <section class="grid" id="entry-grid"></section>
  </main>

  <div class="overlay" id="entry-overlay" aria-hidden="true">
    <div class="dialog">
      <div class="dialog-head">
        <div><small>GLOSSARY ENTRY</small><h2 id="dialog-title">用語を追加</h2></div>
        <button class="icon" id="close-entry" type="button">×</button>
      </div>
      <form class="form" id="entry-form">
        <input type="hidden" id="entry-id" />
        <label>用語名<input id="term" required placeholder="例：盟約ランク" /></label>
        <label>対象ゲーム<select id="game"><option value="">共通 / ゲーム横断</option></select></label>
        <label>説明<textarea id="description" required placeholder="あとから自分が理解できる説明でOK。"></textarea></label>
        <label>関連語
          <div class="related-editor"><select id="related-picker"><option value="">既存Glossaryから選択</option></select><button class="ghost" id="add-related" type="button">つなぐ</button></div>
          <div class="chips" id="related-chips"></div>
          <span class="relation-note">既存の用語だけを選択します。AとBをつなぐと、B側にもAが自動で表示されます。</span>
        </label>
        <div class="candidate-box">
          <label><input id="publication-candidate" type="checkbox" /> 公開候補にする</label>
          <small id="publication-note">公開候補にしても外部には出ません。一覧から「公開する」を押した時だけ公開されます。</small>
        </div>
        <div class="dialog-foot">
          <button class="danger hidden" id="delete-entry" type="button">削除</button>
          <div class="spacer"></div>
          <button class="ghost" id="cancel-entry" type="button">キャンセル</button>
          <button class="primary" type="submit">保存する</button>
        </div>
      </form>
    </div>
  </div>

  <div class="lock" id="lock">
    <div class="lock-card">
      <h1>UNLOCK</h1>
      <p>専門用語帳もPRIVATE GAME NOTEBOOKと同じ管理キーで保護します。</p>
      <form id="unlock-form"><input id="admin-key" type="password" autocomplete="current-password" placeholder="HARF-WAY 管理キー" /><button class="primary">開く</button></form>
      <small id="lock-message" style="color:var(--muted)">Previewでは認証なしで検証できます。</small>
    </div>
  </div>

  <div class="toast" id="toast"></div>
  <script is:inline src="/game-notes/glossary.js"></script>
  <script is:inline src="/private-tools/shell.js"></script>
</body>
</html>
