---
const title = 'GAME NOTES WORKFLOW';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="same-origin" />
  <title>{title}</title>
  <style is:global>
    :root{--bg:#0d110f;--panel:#171d19;--panel2:#1d251f;--line:#2a342d;--line2:#3a473d;--text:#dbe3dc;--muted:#839087;--accent:#dff238;--accent2:#d6df8b;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif;color-scheme:dark}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text)}button,a,input{font:inherit}.shell{width:min(1120px,100%);margin:auto;padding:28px 24px 70px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-bottom:22px;border-bottom:1px solid var(--line)}.brand small{display:block;font:900 9px ui-monospace,monospace;color:var(--accent);letter-spacing:.14em;margin-bottom:7px}.brand h1{margin:0;font-size:26px;letter-spacing:-.035em}.brand p{margin:7px 0 0;color:var(--muted);font-size:12px}.back{border:1px solid var(--line2);background:var(--panel);color:#c9d3cb;border-radius:9px;padding:10px 13px;text-decoration:none;font-weight:800;font-size:12px;white-space:nowrap}.summary{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;margin:22px 0 12px;padding:17px 18px;border:1px solid #4c5f50;border-radius:13px;background:linear-gradient(135deg,#1d271f,#171d19)}.summary b{font-size:15px}.summary p{font-size:11px;color:var(--muted);margin:5px 0 0}.summary strong{font:900 11px ui-monospace,monospace;color:var(--accent2);letter-spacing:.08em}.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:0 0 20px}.tab{border:1px solid var(--line);background:var(--panel);color:#89958b;border-radius:10px;padding:13px;text-align:left;cursor:pointer}.tab b{display:block;font:900 11px ui-monospace,monospace;letter-spacing:.08em}.tab span{display:block;color:#e0e6e1;font-size:24px;font-weight:900;margin-top:5px}.tab.on{border-color:#617562;background:#273229;color:var(--accent2)}.mode-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:0 2px 14px;border-bottom:1px solid var(--line)}.mode-head b{font-size:14px}.mode-head span{font-size:10px;color:var(--muted)}.list{display:grid}.card{display:grid;grid-template-columns:minmax(180px,1fr) minmax(230px,1fr) auto;align-items:center;gap:20px;padding:20px 3px;border-bottom:1px solid var(--line)}.card h2{font-size:16px;margin:0 0 6px}.meta{display:flex;gap:11px;flex-wrap:wrap;color:#7e8a81;font:800 9px ui-monospace,monospace}.state{display:inline-flex;border:1px solid #526255;border-radius:999px;padding:4px 7px;color:var(--accent2)}.copy{font-size:11px;line-height:1.7;color:var(--muted)}.actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.btn,.channel{border:1px solid var(--line2);background:var(--panel);color:#c3cec5;border-radius:8px;padding:9px 11px;cursor:pointer;text-decoration:none;font-size:10px;font-weight:850;white-space:nowrap}.btn.primary{border:0;background:var(--accent);color:#111610}.btn:disabled{opacity:.35;cursor:not-allowed}.channels{display:flex;gap:7px;flex-wrap:wrap}.channel{border-radius:999px;color:#78847b}.channel.planned{border-color:#758255;color:#dce58c;background:#242919}.channel.done{border-color:#55745d;color:#bde1c4;background:#19291f}.empty{margin-top:18px;padding:40px;border:1px dashed var(--line2);border-radius:12px;text-align:center;color:var(--muted);font-size:12px}.foot{margin-top:24px;color:#657168;font-size:10px;line-height:1.7}.lock{position:fixed;inset:0;display:none;place-items:center;background:#0a0d0bed;backdrop-filter:blur(9px);padding:20px;z-index:10}.lock.on{display:grid}.lock-card{width:min(430px,100%);background:var(--panel);border:1px solid var(--line2);border-radius:15px;padding:28px}.lock-card small{font:900 9px ui-monospace,monospace;color:var(--accent);letter-spacing:.12em}.lock-card h2{font-size:30px;margin:8px 0}.lock-card p{font-size:12px;color:var(--muted);line-height:1.7}.lock-card form{display:flex;gap:8px;margin-top:18px}.lock-card input{min-width:0;flex:1;border:1px solid var(--line2);background:#0f1411;color:var(--text);border-radius:8px;padding:12px}.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;background:#dff238;color:#121712;padding:10px 14px;border-radius:8px;font-size:11px;font-weight:900;transition:.2s;pointer-events:none;z-index:20}.toast.on{opacity:1;transform:translate(-50%,0)}
    @media(max-width:820px){.shell{padding:18px 14px 50px}.topbar{align-items:flex-start}.summary{grid-template-columns:1fr}.tabs{grid-template-columns:1fr 1fr}.card{grid-template-columns:1fr;gap:12px}.actions{justify-content:flex-start}.mode-head{align-items:flex-start;flex-direction:column}}
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand"><small>PRIVATE GAME NOTEBOOK / TASK WINDOW</small><h1>WORKFLOW</h1><p>ゲームメモとデータは共有。ここでは制作の現在地だけを見る。</p></div>
      <a class="back" href="/game-notes/" target="_blank" rel="noopener">GAME NOTES ↗</a>
    </header>
    <section class="summary" id="summary"><div><b>読み込み中…</b><p>ワークフローを確認しています。</p></div><strong>—</strong></section>
    <nav class="tabs" id="tabs"></nav>
    <div class="mode-head" id="mode-head"></div>
    <section class="list" id="list"></section>
    <p class="foot">ARCHIVEは記録削除ではなく、今回の制作サイクルを閉じるだけです。メモや素材はGAME NOTES側に残ります。</p>
  </main>
  <div class="lock" id="lock"><div class="lock-card"><small>PRIVATE WORKSPACE</small><h2>UNLOCK</h2><p>タスク画面もGame Notesと同じHARF-WAY管理キーで保護されています。</p><form id="unlock"><input id="key" type="password" autocomplete="current-password" placeholder="HARF-WAY 管理キー" /><button class="btn primary">開く</button></form></div></div>
  <div class="toast" id="toast"></div>
<script is:inline>
(() => {
  const CHANNELS=[['ways','WAYS'],['x','X'],['scraps','切れ端']];
  const LABEL={play:'PLAY',edit:'EDIT',publish:'PUBLISH',archive:'ARCHIVE'};
  const state={games:[],mode:'play',busy:new Set()};
  const $=s=>document.querySelector(s);
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const headers=()=>{const key=sessionStorage.getItem('harfway_game_notes_key')||'';return key?{'x-admin-key':key}:{}};
  const notify=(m,bad=false)=>{const t=$('#toast');t.textContent=m;t.style.background=bad?'#d58d8d':'';t.classList.add('on');clearTimeout(t._x);t._x=setTimeout(()=>t.classList.remove('on'),1800)};
  async function api(options={}){const h={...headers(),...(options.body?{'content-type':'application/json'}:{})};const r=await fetch('/api/game-notes-workflow',{...options,headers:h,cache:'no-store'});const d=await r.json().catch(()=>({}));if(r.status===401){$('#lock').classList.add('on');throw Object.assign(new Error(d.error||'unauthorized'),{status:401})}if(!r.ok)throw new Error(d.error||`http_${r.status}`);return d}
  function counts(){return ['play','edit','publish','archive'].reduce((o,k)=>(o[k]=state.games.filter(g=>g.workflowStatus===k).length,o),{})}
  function recommend(c){if(c.edit>=4)return['edit','編集待ちが溜まっています','新しく遊ぶ前に、EDITをまとめて捌くのがおすすめです。','EDIT MODE 推奨'];if(c.publish>=4)return['publish','登録待ちが溜まっています','編集済み素材を各媒体へまとめて登録すると、未完了感を減らせます。','PUBLISH MODE 推奨'];return['play','PLAYしてOK','編集待ちは許容量内です。録画とプレイメモまでで閉じて大丈夫です。','PLAY MODE']}
  function modeCopy(m){if(m==='play')return['PLAY MODE','ゲームを遊ぶ → 録画 → プレイメモ。ここで一度終了。'];if(m==='edit')return['EDIT MODE','編集待ちだけをまとめて処理。媒体登録にはまだ移らない。'];if(m==='publish')return['PUBLISH MODE','完成した素材をWAYS / X / 切れ端へ登録。使わない媒体は選ばなくてOK。'];return['ARCHIVE','制作サイクルを閉じたゲーム。記録はGame Notesに残っています。']}
  function chState(g,id){if((g.publishedTargets||[]).includes(id))return'done';if((g.publishTargets||[]).includes(id))return'planned';return'off'}
  function chHtml(g){return `<div class="channels">${CHANNELS.map(([id,label])=>{const s=chState(g,id);return `<button class="channel ${s}" data-channel="${id}" data-id="${esc(g.id)}">${label}${s==='done'?' ✓':s==='planned'?' 予定':' ＋'}</button>`}).join('')}</div>`}
  function card(g){const busy=state.busy.has(g.id);const meta=`<div class="meta"><span>${g.noteCount} NOTES</span><span>${g.mediaCount} MEDIA</span><span class="state">${LABEL[g.workflowStatus]}</span></div>`;const noteLink=`/game-notes/?game=${encodeURIComponent(g.id)}`;
    if(g.workflowStatus==='play')return `<article class="card"><div><h2>${esc(g.name)}</h2>${meta}</div><div class="copy">録画とプレイメモを残したらEDITへ。動画編集や投稿はここではやらない。</div><div class="actions"><a class="btn" href="${noteLink}" target="_blank" rel="noopener">GAME NOTES ↗</a><button class="btn primary" data-move="edit" data-id="${esc(g.id)}" ${busy?'disabled':''}>記録完了 → EDIT</button></div></article>`;
    if(g.workflowStatus==='edit')return `<article class="card"><div><h2>${esc(g.name)}</h2>${meta}</div><div class="copy">録画素材をまとめて編集。必要なら別タブのGame Notesでプレイメモを確認する。</div><div class="actions"><a class="btn" href="${noteLink}" target="_blank" rel="noopener">メモを見る ↗</a><button class="btn" data-move="archive" data-id="${esc(g.id)}" ${busy?'disabled':''}>今回は出さない</button><button class="btn primary" data-move="publish" data-id="${esc(g.id)}" ${busy?'disabled':''}>編集完了 → PUBLISH</button></div></article>`;
    if(g.workflowStatus==='publish'){const targets=g.publishTargets||[],done=g.publishedTargets||[],allDone=targets.length===0||targets.every(x=>done.includes(x));return `<article class="card"><div><h2>${esc(g.name)}</h2>${meta}</div><div>${chHtml(g)}<div class="copy" style="margin-top:8px">クリックで「使わない → 予定 → 完了」。</div></div><div class="actions"><button class="btn" data-move="edit" data-id="${esc(g.id)}">EDITへ戻す</button><button class="btn primary" data-move="archive" data-id="${esc(g.id)}" ${!allDone||busy?'disabled':''}>${targets.length?'登録完了 → ARCHIVE':'公開せずARCHIVE'}</button></div></article>`}
    const used=(g.publishedTargets||[]).map(id=>CHANNELS.find(c=>c[0]===id)?.[1]).filter(Boolean).join(' / ')||'公開なし';return `<article class="card"><div><h2>${esc(g.name)}</h2>${meta}</div><div class="copy">${esc(used)} · 制作サイクル完了</div><div class="actions"><a class="btn" href="${noteLink}" target="_blank" rel="noopener">GAME NOTES ↗</a><button class="btn primary" data-move="play" data-id="${esc(g.id)}">もう一度PLAYへ</button></div></article>`}
  function render(){const c=counts(),r=recommend(c);$('#summary').innerHTML=`<div><b>${esc(r[1])}</b><p>${esc(r[2])}</p></div><strong>${esc(r[3])}</strong>`;$('#tabs').innerHTML=['play','edit','publish','archive'].map(m=>`<button class="tab ${state.mode===m?'on':''}" data-mode="${m}"><b>${LABEL[m]}</b><span>${c[m]}</span></button>`).join('');const mc=modeCopy(state.mode);$('#mode-head').innerHTML=`<b>${mc[0]}</b><span>${mc[1]}</span>`;const list=state.games.filter(g=>g.workflowStatus===state.mode);$('#list').innerHTML=list.length?list.map(card).join(''):`<div class="empty">${LABEL[state.mode]} に待っているゲームはありません。</div>`}
  async function load(select=true){const d=await api();state.games=d.games||[];if(select)state.mode=recommend(counts())[0];$('#lock').classList.remove('on');render()}
  async function patch(g,p){if(!g||state.busy.has(g.id))return;state.busy.add(g.id);render();try{await api({method:'PATCH',body:JSON.stringify({gameId:g.id,workflowStatus:p.workflowStatus||g.workflowStatus,publishTargets:p.publishTargets??g.publishTargets??[],publishedTargets:p.publishedTargets??g.publishedTargets??[]})});await load(false)}catch(e){if(e.status!==401)notify(`更新失敗: ${e.message}`,true)}finally{state.busy.delete(g.id);render()}}
  $('#tabs').addEventListener('click',e=>{const b=e.target.closest('[data-mode]');if(!b)return;state.mode=b.dataset.mode;render()});
  $('#list').addEventListener('click',e=>{const m=e.target.closest('[data-move]');if(m){const g=state.games.find(x=>x.id===m.dataset.id);return patch(g,{workflowStatus:m.dataset.move})}const ch=e.target.closest('[data-channel]');if(!ch)return;const g=state.games.find(x=>x.id===ch.dataset.id);if(!g)return;const id=ch.dataset.channel,targets=[...(g.publishTargets||[])],done=[...(g.publishedTargets||[])],ti=targets.indexOf(id),di=done.indexOf(id);if(ti<0)targets.push(id);else if(di<0)done.push(id);else{targets.splice(ti,1);done.splice(di,1)}patch(g,{workflowStatus:'publish',publishTargets:targets,publishedTargets:done})});
  $('#unlock').addEventListener('submit',e=>{e.preventDefault();const k=$('#key').value.trim();if(!k)return;sessionStorage.setItem('harfway_game_notes_key',k);load(true).then(()=>{$('#key').value=''}).catch(()=>{})});
  load(true).catch(e=>{if(e.status!==401){notify(`読み込み失敗: ${e.message}`,true)}});
})();
</script>
</body>
</html>
