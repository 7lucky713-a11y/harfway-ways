---
const title = 'GAME FRAGMENTS / B5 STUDIO';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title}</title>
  <style is:global>
    :root{--bg:#0b0f0d;--panel:#131814;--panel2:#0f1411;--line:#29322c;--line2:#3b483f;--text:#eef2ed;--muted:#89938b;--accent:#dff238;--paper:#f2efe6;--paper2:#e8e2d3;--ink:#171916;--ink2:#62665f;--rule:#c9c2b3}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.app{min-height:100vh}.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 18px;border-bottom:1px solid var(--line);background:#0b0f0df2;backdrop-filter:blur(12px)}.top a{color:#9da79f;text-decoration:none;font-size:12px;font-weight:850}.top b{font:900 11px ui-monospace,monospace;letter-spacing:.13em}.layout{display:grid;grid-template-columns:minmax(315px,390px) minmax(0,1fr);min-height:calc(100vh - 53px)}.tools{padding:20px;border-right:1px solid var(--line);background:var(--panel);overflow:auto}.preview{padding:24px;overflow:auto}.eyebrow{font:900 10px ui-monospace,monospace;letter-spacing:.15em;color:var(--accent)}.tools h1{font-size:30px;letter-spacing:-.04em;margin:7px 0}.tools>p{margin:0 0 20px;color:var(--muted);font-size:12px;line-height:1.75}.group{padding:14px 0;border-top:1px solid var(--line)}.group label,.group-title{display:block;margin-bottom:7px;color:#b8c1ba;font-size:10px;font-weight:900;letter-spacing:.05em}.group select,.group input,.group textarea{width:100%;border:1px solid var(--line2);background:#0e1310;color:var(--text);border-radius:8px;padding:10px 11px;outline:none;font-size:13px}.group textarea{min-height:74px;line-height:1.6;resize:vertical}.row{display:flex;gap:7px}.row>*{flex:1}.btn{border:1px solid var(--line2);background:#171d19;color:var(--text);border-radius:8px;padding:9px 10px;font-size:11px;font-weight:850;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:#111610}.btn:disabled{opacity:.35;cursor:default}.note-actions{display:flex;gap:6px;margin-bottom:8px}.note-list{display:grid;gap:6px;max-height:290px;overflow:auto}.note-item{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:8px;border:1px solid var(--line);background:var(--panel2);border-radius:8px}.note-item input{width:auto;margin-top:3px}.note-item b{display:block;font-size:11px;line-height:1.4}.note-item small{display:block;color:var(--muted);font-size:9px;line-height:1.45;margin-top:3px}.count{color:var(--accent)}.hint{margin-top:6px;color:#6f7a71;font-size:9px;line-height:1.55}.status{display:none;padding:10px;margin-bottom:12px;border:1px solid #684949;background:#251717;border-radius:8px;color:#e5bcbc;font-size:11px;line-height:1.6}.status.on{display:block}.auth-row{display:flex;gap:7px;margin-top:7px}.auth-row input{flex:1;border:1px solid #684949;background:#120d0d;color:#fff;border-radius:7px;padding:8px}.format-card,.print-card{border:1px solid var(--line2);background:#0e1310;border-radius:8px;padding:11px 12px}.format-card b,.print-card b{display:block;color:var(--accent);font:900 12px ui-monospace,monospace;letter-spacing:.08em}.format-card small,.print-card small{display:block;margin-top:4px;color:var(--muted);font-size:9px;line-height:1.5}.warn{padding:9px 10px;border:1px solid #5f5b38;background:#1d1b10;color:#c8c195;border-radius:7px;font-size:9px;line-height:1.55}.empty{min-height:65vh;display:grid;place-items:center;text-align:center;border:1px dashed var(--line2);border-radius:14px;color:var(--muted);padding:24px}

    .reader{width:min(660px,100%);margin:0 auto;color:var(--ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;touch-action:pan-y}.page-shell{position:relative;perspective:1600px}.page{position:relative;width:100%;aspect-ratio:182/257;background:var(--paper);box-shadow:0 22px 70px #0009;overflow:hidden;transform-origin:left center;backface-visibility:hidden;border:1px solid #c8c0b2}.page.flip-next{animation:flipNext .34s ease-in both}.page.flip-prev{animation:flipPrev .28s ease-out both}@keyframes flipNext{0%{transform:rotateY(0);opacity:1}100%{transform:rotateY(-88deg);opacity:.18}}@keyframes flipPrev{0%{transform:rotateY(-70deg);opacity:.2}100%{transform:rotateY(0);opacity:1}}.hit{position:absolute;top:0;bottom:0;width:15%;z-index:5;border:0;background:transparent;cursor:pointer}.hit.prev{left:0}.hit.next{right:0}.edge{position:absolute;top:50%;transform:translateY(-50%);z-index:4;opacity:.12;font:900 20px ui-monospace,monospace;pointer-events:none}.edge.left{left:12px}.edge.right{right:12px}.paper{height:100%;padding:8.2% 9%;display:flex;flex-direction:column}.folio{font:800 8px ui-monospace,monospace;letter-spacing:.13em;color:#7a7d76}.running{display:flex;justify-content:space-between;gap:10px;align-items:center}.reader-nav{display:grid;grid-template-columns:86px 1fr 86px;gap:10px;align-items:center;margin-top:13px}.reader-nav button{border:1px solid #3b483f;background:#111713;color:#edf1ed;border-radius:999px;padding:9px;font-size:10px;font-weight:850;cursor:pointer}.reader-nav button:disabled{opacity:.28}.progress{text-align:center;color:#9ca69e;font:800 9px ui-monospace,monospace;letter-spacing:.09em}.dots{display:flex;justify-content:center;gap:4px;flex-wrap:wrap;margin-top:8px}.dot{width:4px;height:4px;border-radius:99px;background:#344139}.dot.on{background:var(--accent)}.reader-help{text-align:center;color:#667169;font-size:9px;margin-top:7px}

    .cover{background:#171b17;color:#f2f3ec;position:relative}.cover::before{content:"";position:absolute;inset:0;background:linear-gradient(155deg,transparent 0 62%,#dff238 62% 64%,transparent 64%);opacity:.85}.cover .paper{position:relative;justify-content:space-between}.cover-top{display:flex;justify-content:space-between;gap:12px;align-items:start}.cover-mark{font:900 9px ui-monospace,monospace;letter-spacing:.18em;color:var(--accent)}.cover-issue{font:800 9px ui-monospace,monospace;letter-spacing:.1em;color:#9ca49d}.cover-main{margin-top:auto;margin-bottom:auto}.cover-series{font:900 10px ui-monospace,monospace;letter-spacing:.17em;color:#a9b1aa}.cover h1{font-size:clamp(48px,8vw,74px);line-height:.9;letter-spacing:-.07em;margin:18px 0 16px;max-width:8ch}.cover-sub{font-size:16px;line-height:1.8;max-width:28em;color:#c5cbc5}.cover-foot{display:flex;justify-content:space-between;align-items:end;gap:14px;font:800 9px ui-monospace,monospace;letter-spacing:.1em;color:#aeb5ae}.cover-foot strong{color:#f2f3ec;font-size:11px}

    .intro .paper{justify-content:center}.intro-label,.after-label,.colophon-label{font:900 9px ui-monospace,monospace;letter-spacing:.16em;color:#747971}.intro h2{font-size:34px;line-height:1.15;letter-spacing:-.04em;margin:12px 0 20px}.intro p{font-size:17px;line-height:2;max-width:32em;margin:0}.meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#bbb5a9;margin-top:32px;border:1px solid #bbb5a9}.meta-cell{background:var(--paper);padding:12px}.meta-cell b{display:block;font:900 8px ui-monospace,monospace;letter-spacing:.13em;color:#777b74}.meta-cell span{display:block;margin-top:5px;font-size:14px;font-weight:700}

    .run-opener{background:#e7e1d2}.run-opener .paper{justify-content:space-between}.run-no{font:900 clamp(78px,15vw,130px)/.8 ui-monospace,monospace;letter-spacing:-.08em;color:#1c211d}.run-opener h2{font-size:32px;line-height:1.15;letter-spacing:-.045em;margin:20px 0 0;max-width:14ch}.run-date{font:800 9px ui-monospace,monospace;letter-spacing:.1em;color:#72776f}.run-quote{font-size:24px;line-height:1.65;font-weight:700;margin:26px 0 0;padding-top:16px;border-top:4px solid #171b17;max-width:28em}.run-facets{display:grid;gap:8px;border-top:1px solid #bcb5a8;padding-top:15px}.facet-row{display:grid;grid-template-columns:100px 1fr;gap:10px;font:800 8px ui-monospace,monospace;letter-spacing:.06em}.facet-row b{color:#71766f}.facet-row span{color:#30352f}

    .text-page .paper{justify-content:space-between}.text-head{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid var(--rule);padding-bottom:11px;font:800 8px ui-monospace,monospace;letter-spacing:.1em;color:#747971}.text-body{white-space:pre-wrap;font-size:14px;line-height:1.95;max-width:40em;margin:26px 0 auto;overflow-wrap:anywhere}.text-foot{display:flex;justify-content:space-between;align-items:end;border-top:1px solid var(--rule);padding-top:10px}.text-foot span{font:800 8px ui-monospace,monospace;color:#777a74;letter-spacing:.08em}.cont{font:900 8px ui-monospace,monospace;letter-spacing:.14em;color:#7a7d76;margin-bottom:16px}

    .media-page{background:#171b17;color:#f2f3ec}.media-page .paper{padding:6%;justify-content:space-between}.media-top{display:flex;justify-content:space-between;font:800 8px ui-monospace,monospace;letter-spacing:.1em;color:#a8b0a9}.media-frame{display:grid;place-items:center;min-height:0;flex:1;margin:18px 0;background:#0d100e;border:1px solid #363d37;overflow:hidden}.media-frame img,.media-frame video{width:100%;height:100%;object-fit:contain;display:block}.media-caption{display:flex;justify-content:space-between;gap:12px;font:800 8px ui-monospace,monospace;color:#aab2ab;letter-spacing:.07em}.media-caption strong{color:#f2f3ec}

    .after{background:#dff238}.after .paper{justify-content:center}.after-label{color:#33382f}.after h2{font-size:40px;line-height:1;letter-spacing:-.055em;margin:10px 0 30px}.after ul{margin:0;padding-left:1.2em;display:grid;gap:15px;font-size:16px;line-height:1.8;max-width:32em}.colophon{background:#e7e1d2}.colophon .paper{justify-content:space-between}.colophon h2{font-size:38px;letter-spacing:-.05em;margin:10px 0 18px}.colophon p{font-size:15px;line-height:1.9;max-width:32em}.colophon-data{display:grid;gap:7px;border-top:1px solid #b8b1a4;padding-top:14px;font:800 8px ui-monospace,monospace;letter-spacing:.08em;color:#5e645d}.colophon-data div{display:flex;justify-content:space-between;gap:12px}.blank{background:#f2efe6}

    .print-stack{display:none}
    @media(max-width:900px){.layout{grid-template-columns:1fr}.tools{border-right:0;border-bottom:1px solid var(--line)}.preview{padding:12px}.note-list{max-height:230px}.reader-nav{grid-template-columns:74px 1fr 74px}}
    @media(max-width:560px){.preview{padding:7px}.tools{padding:16px}.page{box-shadow:none}.paper{padding:7% 8%}.cover h1{font-size:44px}.cover-sub{font-size:12px}.intro h2{font-size:27px}.intro p{font-size:12px;line-height:1.8}.run-no{font-size:80px}.run-opener h2{font-size:25px}.run-quote{font-size:16px;line-height:1.55}.text-body{font-size:10px;line-height:1.72;margin-top:18px}.facet-row{grid-template-columns:75px 1fr;font-size:7px}.after h2{font-size:31px}.after ul{font-size:11px;gap:10px}.colophon h2{font-size:30px}.colophon p{font-size:11px}.media-page .paper{padding:5%}}
    @media(prefers-reduced-motion:reduce){.page.flip-next,.page.flip-prev{animation:none}}
    @page{size:B5 portrait;margin:0}
    @media print{html,body{background:#fff!important}.top,.tools,.preview,.reader-nav,.dots,.reader-help{display:none!important}.layout{display:block!important}.print-stack{display:block!important}.print-sheet{width:182mm;height:257mm;page-break-after:always;overflow:hidden;background:var(--paper);color:var(--ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}.print-sheet:last-child{page-break-after:auto}.print-sheet>.paper{height:100%}.print-sheet.cover,.print-sheet.media-page,.print-sheet.after{color-adjust:exact;-webkit-print-color-adjust:exact}}
  </style>
</head>
<body>
<div class="app">
  <header class="top"><div><a href="/game-notes/">← GAME NOTES</a> <small>/ B5 STUDIO</small></div><b>GAME FRAGMENTS / PRINT-FIRST</b></header>
  <div class="layout">
    <aside class="tools">
      <div class="eyebrow">GAME NOTES → FIELD BOOK</div>
      <h1>B5 STUDIO</h1>
      <p>原文を削らず、「プレイ中に採取した記録」をB5の小冊子として組むための完成見本。Web・WordPress・PDF・紙を同じBOOKデータから派生させる前提です。</p>
      <div class="status" id="status"><span id="status-text"></span><div class="auth-row" id="auth-row"><input id="admin-key" type="password" placeholder="HARF-WAY管理キー" /><button class="btn" id="auth-btn">再接続</button></div></div>
      <div class="group"><label>FORMAT</label><div class="format-card"><b>B5 / 182 × 257 mm</b><small>FIELD NOTE · PORTRAIT · PRINT-FIRST TEMPLATE</small></div></div>
      <div class="group"><label>GAME</label><select id="game"></select></div>
      <div class="group"><div class="group-title">RECORDS <span class="count" id="selected-count">0</span></div><div class="note-actions"><button class="btn" id="latest10">最新10件</button><button class="btn" id="select-all">すべて</button><button class="btn" id="clear-all">解除</button></div><div class="note-list" id="notes"></div></div>
      <div class="group"><label>BOOK TITLE</label><input id="book-title" /></div>
      <div class="group"><label>SUBTITLE</label><input id="subtitle" value="遊びながら残した、まだ途中の記録。" /></div>
      <div class="group"><label>INTRO</label><textarea id="intro"></textarea></div>
      <div class="group"><label>ENDING NOTE</label><textarea id="ending"></textarea></div>
      <div class="group"><div class="print-card"><b id="print-pages">0 PAGES</b><small id="print-hint">印刷ページ数を計算中</small></div><div class="hint">中綴じを想定し、4の倍数に足りない分は印刷時だけ白紙を自動追加します。</div></div>
      <div class="group"><div class="warn">画像・動画はGAME NOTESの非公開R2をプレビューでは利用できます。WordPress公開用メディアの複製処理は次段階で実装します。</div></div>
      <div class="group"><div class="row"><button class="btn primary" id="generate">BOOKを更新</button><button class="btn" id="print">印刷 / PDF</button></div><div class="row" style="margin-top:7px"><button class="btn" id="copy">WordPress HTMLをコピー</button></div></div>
    </aside>
    <main class="preview"><div id="book"><div class="empty">GAME NOTESを読み込み中…</div></div></main>
  </div>
</div>
<div class="print-stack" id="print-stack"></div>
<script is:inline>
(() => {
  const state={games:[],notes:[],facets:[],selected:new Set(),pages:[],page:0,touchX:null,adminKey:sessionStorage.getItem('harfway_game_notes_key')||'',exportHtml:'',_t:null};
  const $=s=>document.querySelector(s);
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const plain=v=>String(v??'').replace(/\s+/g,' ').trim();
  const fmtDate=v=>{try{return new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(v))}catch{return''}};
  const currentGameId=()=>$('#game').value;
  const gameById=id=>state.games.find(g=>g.id===id);
  const facetById=id=>state.facets.find(f=>f.id===id);
  const gameNotes=()=>state.notes.filter(n=>n.gameId===currentGameId()).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')));
  const chosen=()=>gameNotes().filter(n=>state.selected.has(n.id));
  function status(msg,auth=false){$('#status-text').textContent=msg;$('#status').classList.toggle('on',Boolean(msg));$('#auth-row').style.display=auth?'flex':'none'}
  async function load(){status('GAME NOTESを読み込んでいます…');const headers=state.adminKey?{'x-admin-key':state.adminKey}:{};const res=await fetch('/api/game-notes',{headers,cache:'no-store'});const data=await res.json().catch(()=>({}));if(res.status===401){status('管理キーを入力するとGAME NOTESを読み込めます。',true);$('#book').innerHTML='<div class="empty">GAME NOTESへの認証が必要です。</div>';return}if(!res.ok){status(`読み込みに失敗しました: ${data.error||res.status}`);return}state.games=data.games||[];state.notes=data.notes||[];state.facets=data.facets||[];status('');renderGames()}
  function renderGames(){const sel=$('#game');sel.innerHTML=state.games.map(g=>`<option value="${esc(g.id)}">${esc(g.name)}</option>`).join('');const mt=state.games.find(g=>/モンスタートレイン/i.test(g.name));if(mt)sel.value=mt.id;onGame()}
  function onGame(){state.selected.clear();const list=gameNotes();list.slice(-Math.min(10,list.length)).forEach(n=>state.selected.add(n.id));const g=gameById(currentGameId());$('#book-title').value=g?g.name:'PLAY NOTES';$('#intro').value=g?`${g.name}を遊びながら残した記録。強そうだと思ったこと、失敗したこと、まだ分からないこと。その時点の言葉を、あとから整えすぎずに並べ直す。`:'';$('#ending').value='まだ結論は出ていない。次のプレイで、また見え方が変わるかもしれない。';renderNotes();generate()}
  function renderNotes(){const list=gameNotes();$('#notes').innerHTML=list.length?list.map((n,i)=>`<label class="note-item"><input type="checkbox" data-id="${esc(n.id)}" ${state.selected.has(n.id)?'checked':''}><span><b>${esc(n.title||`記録 ${i+1}`)}</b><small>${esc(fmtDate(n.createdAt||n.updatedAt))} · ${esc(plain(n.body).slice(0,54))}${plain(n.body).length>54?'…':''}</small></span></label>`).join(''):'<div class="empty" style="min-height:100px">記録なし</div>';$('#selected-count').textContent=state.selected.size}
  function runNumber(note,index){const m=String(note.title||'').match(/(?:第\s*)?(\d+)\s*(?:回|run)/i);return m?Number(m[1]):index+1}
  function sentences(body){return String(body||'').replace(/\r/g,'').split(/(?<=[。！？!?])|\n+/).map(plain).filter(s=>s.length>=5)}
  function score(s){let n=Math.min(4,s.length/38);if(/[！？!?]/.test(s))n+=2;if(/強|弱|勝|負|死|難|面白|笑|最強|わから|分から|気づ|重要|相性|クリア|撃破|終わ|役割|デバフ|タンク|後列/.test(s))n+=2;if(/かも|だろう|気が|思う|っぽい/.test(s))n+=1;return n}
  function quote(note){const ss=sentences(note.body);return ss.sort((a,b)=>score(b)-score(a))[0]||plain(note.body).slice(0,110)}
  function facetRows(note){const rows=[];for(const [id,values] of Object.entries(note.facets||{})){const vals=(values||[]).filter(Boolean);if(!vals.length)continue;rows.push({name:facetById(id)?.name||id,values:vals.slice(0,5)})}return rows.slice(0,5)}
  function splitBlock(text,limit){const t=String(text||'').trim();if(!t)return[];if(t.length<=limit)return[t];const ss=t.match(/[^。！？!?\n]+[。！？!?]?/g)?.map(s=>s.trim()).filter(Boolean)||[t];const out=[];let buf='';for(const s of ss){if(s.length>limit){if(buf){out.push(buf);buf=''}for(let i=0;i<s.length;i+=limit)out.push(s.slice(i,i+limit));continue}if(buf&&(buf.length+s.length)>limit){out.push(buf);buf=s}else{buf+=s}}if(buf)out.push(buf);return out}
  function paginate(body,limit=860){const raw=String(body||'').replace(/\r/g,'').trim();if(!raw)return[''];let blocks=raw.split(/\n{2,}/).map(s=>s.trim()).filter(Boolean);if(blocks.length===1)blocks=raw.split(/\n+/).map(s=>s.trim()).filter(Boolean);const units=[];for(const b of blocks)units.push(...splitBlock(b,limit));const pages=[];let buf='';for(const u of units){const c=buf?`${buf}\n\n${u}`:u;if(c.length<=limit){buf=c}else{if(buf)pages.push(buf);buf=u}}if(buf)pages.push(buf);return pages.length?pages:['']}
  function mediaUrl(m){return `/api/game-notes-media?action=file&key=${encodeURIComponent(m.key)}`}
  function lateInsights(notes){const pool=notes.slice(Math.max(0,Math.floor(notes.length*.45))).flatMap(n=>sentences(n.body));const ranked=pool.map(s=>[s,score(s)+(/役割|相乗|回転率|デバフ|タンク|後列|カード|圧縮|火力/.test(s)?2:0)]).sort((a,b)=>b[1]-a[1]);const out=[];for(const [s] of ranked){if(out.some(x=>x.includes(s.slice(0,12))||s.includes(x.slice(0,12))))continue;out.push(s);if(out.length>=4)break}return out}
  function dateSpan(notes){const ds=notes.map(n=>n.createdAt||n.updatedAt).filter(Boolean).sort();if(!ds.length)return'';const a=fmtDate(ds[0]),b=fmtDate(ds[ds.length-1]);return a===b?a:`${a} — ${b}`}
  function coverPage(notes,g){const title=$('#book-title').value.trim()||g?.name||'PLAY NOTES';const sub=$('#subtitle').value.trim();return{type:'cover',html:`<div class="paper"><div class="cover-top"><span class="cover-mark">HARF-WAY / GAME FRAGMENTS</span><span class="cover-issue">FIELD NOTE 001</span></div><div class="cover-main"><div class="cover-series">PLAY NOTES / ${notes.length} FRAGMENTS</div><h1>${esc(title)}</h1><div class="cover-sub">${esc(sub)}</div></div><div class="cover-foot"><span><strong>${esc(g?.name||'')}</strong><br>${esc(dateSpan(notes))}</span><span>B5 · 182 × 257 MM</span></div></div>`}}
  function introPage(notes,g){return{type:'intro',html:`<div class="paper"><span class="intro-label">ABOUT THIS BOOK</span><h2>まだ途中の理解を、そのまま残す。</h2><p>${esc($('#intro').value.trim())}</p><div class="meta-grid"><div class="meta-cell"><b>GAME</b><span>${esc(g?.name||'')}</span></div><div class="meta-cell"><b>RUN RECORDS</b><span>${notes.length}</span></div><div class="meta-cell"><b>PERIOD</b><span>${esc(dateSpan(notes))}</span></div><div class="meta-cell"><b>SOURCE</b><span>GAME NOTES</span></div></div></div>`}}
  function openerPage(note,index){const run=runNumber(note,index),rows=facetRows(note);return{type:'run-opener',html:`<div class="paper"><div class="running"><span class="run-date">${esc(fmtDate(note.createdAt||note.updatedAt))}</span><span class="folio">GAME FRAGMENTS</span></div><div><div class="run-no">${String(run).padStart(2,'0')}</div><h2>${esc(note.title||`RUN ${run}`)}</h2><p class="run-quote">${esc(quote(note))}</p></div><div class="run-facets">${rows.length?rows.map(r=>`<div class="facet-row"><b>${esc(r.name)}</b><span>${esc(r.values.join(' / '))}</span></div>`).join(''):`<div class="facet-row"><b>NOTE</b><span>RAW PLAY RECORD</span></div>`}</div></div>`}}
  function textPages(note,index){const run=runNumber(note,index),chunks=paginate(note.body,860);return chunks.map((chunk,i)=>({type:'text-page',html:`<div class="paper"><div class="text-head"><span>RUN ${String(run).padStart(2,'0')} ${i?'/ CONT.':''}</span><span>${esc(fmtDate(note.createdAt||note.updatedAt))}</span></div><div class="text-body">${i?`<div class="cont">CONTINUED ${i+1} / ${chunks.length}</div>`:''}${esc(chunk)}</div><div class="text-foot"><span>${esc(note.title||`RUN ${run}`)}</span><span>${String(i+1).padStart(2,'0')} / ${String(chunks.length).padStart(2,'0')}</span></div></div>`}))}
  function mediaPages(note,index){const run=runNumber(note,index);return (note.media||[]).map((m,i)=>{const url=mediaUrl(m);const visual=m.kind==='video'?`<video src="${esc(url)}" controls playsinline></video>`:`<img src="${esc(url)}" alt="${esc(m.name||`RUN ${run} image`)}" />`;return{type:'media-page',privateMedia:true,html:`<div class="paper"><div class="media-top"><span>RUN ${String(run).padStart(2,'0')} / EVIDENCE</span><span>${String(i+1).padStart(2,'0')}</span></div><div class="media-frame">${visual}</div><div class="media-caption"><strong>${esc(m.kind==='video'?'VIDEO FRAGMENT':'SCREENSHOT')}</strong><span>${esc(m.name||'GAME NOTES MEDIA')}</span></div></div>`}})}
  function afterPage(notes){const ins=lateInsights(notes);if(!ins.length)return null;return{type:'after',html:`<div class="paper"><span class="after-label">AFTER THESE RUNS</span><h2>いま見えていること</h2><ul>${ins.map(s=>`<li>${esc(s)}</li>`).join('')}</ul></div>`}}
  function colophonPage(notes,g){return{type:'colophon',html:`<div class="paper"><div><span class="colophon-label">CONTINUE</span><h2>まだ途中。</h2><p>${esc($('#ending').value.trim())}</p></div><div class="colophon-data"><div><span>GAME</span><b>${esc(g?.name||'')}</b></div><div><span>RECORDS</span><b>${notes.length}</b></div><div><span>PERIOD</span><b>${esc(dateSpan(notes))}</b></div><div><span>FORMAT</span><b>B5 / 182×257mm</b></div><div><span>GENERATED FROM</span><b>HARF-WAY GAME NOTES</b></div></div></div>`}}
  function build(){const notes=chosen(),g=gameById(currentGameId()),pages=[];pages.push(coverPage(notes,g),introPage(notes,g));notes.forEach((n,i)=>{pages.push(openerPage(n,i));pages.push(...textPages(n,i));pages.push(...mediaPages(n,i))});const after=afterPage(notes);if(after)pages.push(after);pages.push(colophonPage(notes,g));state.pages=pages;state.page=Math.min(state.page,Math.max(0,pages.length-1));updatePrintInfo();renderPrintStack();return pages}
  function updatePrintInfo(){const n=state.pages.length,pad=(4-(n%4))%4,total=n+pad;$('#print-pages').textContent=`${total} PAGES / B5`;$('#print-hint').textContent=pad?`本文 ${n}P + 白紙 ${pad}P → 中綴じ用 ${total}P`:`本文 ${n}P → 4の倍数で中綴じOK`}
  function frame(item){return `<section class="page ${item.type}"><button class="hit prev" type="button" aria-label="前のページ"></button><span class="edge left">‹</span>${item.html}<span class="edge right">›</span><button class="hit next" type="button" aria-label="次のページ"></button></section>`}
  function render(){const pages=build();if(!pages.length){$('#book').innerHTML='<div class="empty">記録を選択してください。</div>';return}const i=state.page,item=pages[i];$('#book').innerHTML=`<div class="reader"><div class="page-shell">${frame(item)}</div><div class="reader-nav"><button data-nav="prev" ${i===0?'disabled':''}>← 前</button><div class="progress">PAGE ${i+1} / ${pages.length}</div><button data-nav="next" ${i===pages.length-1?'disabled':''}>次 →</button></div><div class="dots">${pages.map((_,x)=>`<span class="dot ${x===i?'on':''}"></span>`).join('')}</div><div class="reader-help">左右クリック / ← → / スワイプでページをめくる</div></div>`;bindReader();makeExport()}
  function go(next,dir){if(next<0||next>=state.pages.length||next===state.page)return;const p=$('.page');if(!p){state.page=next;render();return}p.classList.add(dir==='prev'?'flip-prev':'flip-next');setTimeout(()=>{state.page=next;render()},dir==='prev'?150:230)}
  function bindReader(){const prev=()=>go(state.page-1,'prev'),next=()=>go(state.page+1,'next');$('[data-nav="prev"]')?.addEventListener('click',prev);$('[data-nav="next"]')?.addEventListener('click',next);$('.hit.prev')?.addEventListener('click',prev);$('.hit.next')?.addEventListener('click',next);const r=$('.reader');if(r){r.addEventListener('touchstart',e=>state.touchX=e.changedTouches[0]?.clientX??null,{passive:true});r.addEventListener('touchend',e=>{if(state.touchX==null)return;const dx=(e.changedTouches[0]?.clientX??state.touchX)-state.touchX;state.touchX=null;if(Math.abs(dx)<45)return;dx<0?next():prev()},{passive:true})}}
  function renderPrintStack(){const pad=(4-(state.pages.length%4))%4;const all=[...state.pages,...Array.from({length:pad},()=>({type:'blank',html:'<div class="paper"></div>'}))];$('#print-stack').innerHTML=all.map(p=>`<section class="print-sheet ${p.type}">${p.html}</section>`).join('')}
  function exportCss(){return `.hwfg{--p:#f2efe6;--p2:#e8e2d3;--i:#171916;--m:#62665f;--r:#c9c2b3;max-width:660px;margin:28px auto;color:var(--i);font-family:"Hiragino Mincho ProN","Yu Mincho",serif}.hwfg *{box-sizing:border-box}.hwfg-page{display:none;position:relative;width:100%;aspect-ratio:182/257;background:var(--p);overflow:hidden;border:1px solid #c8c0b2}.hwfg-page.on{display:block}.hwfg .paper{height:100%;padding:8.2% 9%;display:flex;flex-direction:column}.hwfg .cover{background:#171b17;color:#f2f3ec}.hwfg .cover .paper,.hwfg .run-opener .paper,.hwfg .text-page .paper,.hwfg .colophon .paper{justify-content:space-between}.hwfg .cover h1{font-size:64px;line-height:.9;letter-spacing:-.07em;margin:18px 0;max-width:8ch}.hwfg .cover-mark,.hwfg .cover-issue,.hwfg .cover-series,.hwfg .cover-foot,.hwfg .run-date,.hwfg .folio,.hwfg .text-head,.hwfg .text-foot,.hwfg .facet-row,.hwfg .intro-label,.hwfg .after-label,.hwfg .colophon-label{font-family:ui-monospace,monospace}.hwfg .run-no{font:900 120px/.8 ui-monospace,monospace;letter-spacing:-.08em}.hwfg .run-opener h2{font-size:32px;line-height:1.15}.hwfg .run-quote{font-size:24px;line-height:1.65;font-weight:700;border-top:4px solid #171b17;padding-top:16px}.hwfg .text-body{white-space:pre-wrap;font-size:14px;line-height:1.95;margin:26px 0 auto}.hwfg .media-page{background:#171b17;color:#f2f3ec}.hwfg .media-frame{display:grid;place-items:center;flex:1;margin:18px 0;background:#0d100e;overflow:hidden}.hwfg .media-frame img,.hwfg .media-frame video{width:100%;height:100%;object-fit:contain}.hwfg .after{background:#dff238}.hwfg .after .paper{justify-content:center}.hwfg-nav{display:grid;grid-template-columns:86px 1fr 86px;gap:10px;align-items:center;margin-top:12px}.hwfg-nav button{border:1px solid #333;background:#111;color:#fff;border-radius:99px;padding:9px}.hwfg-nav span{text-align:center;font:800 9px ui-monospace,monospace}@media(max-width:600px){.hwfg .cover h1{font-size:42px}.hwfg .run-no{font-size:78px}.hwfg .run-opener h2{font-size:25px}.hwfg .run-quote{font-size:16px}.hwfg .text-body{font-size:10px;line-height:1.72}}`}
  function makeExport(){if(!state.pages.length)return;const pages=state.pages.map((p,i)=>{let html=p.html;if(p.privateMedia){html='<div class="paper"><div class="media-top"><span>PRIVATE MEDIA</span></div><div class="media-frame" style="padding:30px;color:#aab2ab;text-align:center">WordPress公開用メディアは未変換です。</div></div>'}return`<section class="hwfg-page ${p.type} ${i===0?'on':''}" data-hwfg-page="${i}">${html}</section>`}).join('');const script=`<script>(()=>{document.querySelectorAll('[data-hwfg]').forEach(r=>{let i=0;const ps=[...r.querySelectorAll('[data-hwfg-page]')],c=r.querySelector('[data-hwfg-count]');function s(x){i=Math.max(0,Math.min(ps.length-1,x));ps.forEach((p,j)=>p.classList.toggle('on',j===i));if(c)c.textContent=(i+1)+' / '+ps.length}r.querySelector('[data-hwfg-prev]')?.addEventListener('click',()=>s(i-1));r.querySelector('[data-hwfg-next]')?.addEventListener('click',()=>s(i+1));let x=null;r.addEventListener('touchstart',e=>x=e.changedTouches[0].clientX,{passive:true});r.addEventListener('touchend',e=>{if(x==null)return;let d=e.changedTouches[0].clientX-x;x=null;if(Math.abs(d)>45)s(i+(d<0?1:-1))},{passive:true});s(0)})})();<\/script>`;state.exportHtml=`<style>${exportCss()}</style><div class="hwfg" data-hwfg>${pages}<div class="hwfg-nav"><button data-hwfg-prev type="button">← 前</button><span data-hwfg-count>1 / ${state.pages.length}</span><button data-hwfg-next type="button">次 →</button></div></div>${script}`}
  function generate(){state.page=0;render()}
  $('#game').addEventListener('change',onGame);$('#generate').addEventListener('click',generate);['book-title','subtitle','intro','ending'].forEach(id=>$('#'+id).addEventListener('input',()=>{clearTimeout(state._t);state._t=setTimeout(render,180)}));$('#notes').addEventListener('change',e=>{const id=e.target?.dataset?.id;if(!id)return;e.target.checked?state.selected.add(id):state.selected.delete(id);$('#selected-count').textContent=state.selected.size;generate()});$('#latest10').addEventListener('click',()=>{state.selected.clear();gameNotes().slice(-10).forEach(n=>state.selected.add(n.id));renderNotes();generate()});$('#select-all').addEventListener('click',()=>{gameNotes().forEach(n=>state.selected.add(n.id));renderNotes();generate()});$('#clear-all').addEventListener('click',()=>{state.selected.clear();renderNotes();generate()});$('#print').addEventListener('click',()=>{renderPrintStack();window.print()});$('#copy').addEventListener('click',async()=>{makeExport();try{await navigator.clipboard.writeText(state.exportHtml);const b=$('#copy');const t=b.textContent;b.textContent='コピーしました';setTimeout(()=>b.textContent=t,1400)}catch{alert('コピーできませんでした')}});$('#auth-btn').addEventListener('click',()=>{state.adminKey=$('#admin-key').value.trim();if(state.adminKey)sessionStorage.setItem('harfway_game_notes_key',state.adminKey);load()});document.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;if(e.key==='ArrowLeft')go(state.page-1,'prev');if(e.key==='ArrowRight')go(state.page+1,'next')});load();
})();
</script>
</body>
</html>