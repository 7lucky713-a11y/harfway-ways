---
const title = 'MINI BOOK / B5 FLUID';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title}</title>
  <style is:global>
    :root{--bg:#0d110f;--panel:#151a17;--line:#2d3831;--line2:#414f46;--text:#eef4ef;--muted:#8e9a91;--accent:#dff238;--paper:#f2efe6;--paper2:#ebe7dc;--book-ink:#171916;--book-muted:#6e716b;--book-line:#c9c3b5}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.app{min-height:100vh}.top{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 20px;border-bottom:1px solid var(--line);background:#0d110ff2;backdrop-filter:blur(12px)}.top a{color:var(--muted);text-decoration:none;font-size:12px;font-weight:800}.top small{color:#68756c}.top b{font-size:11px;letter-spacing:.12em}.layout{display:grid;grid-template-columns:minmax(340px,430px) minmax(0,1fr);min-height:calc(100vh - 57px)}.tools{border-right:1px solid var(--line);padding:22px;overflow:auto}.preview{padding:24px;overflow:auto;display:grid;align-items:start}.eyebrow{font:800 10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);margin-bottom:7px}.tools h1{margin:0 0 7px;font-size:29px;letter-spacing:-.04em}.tools>p{margin:0 0 20px;color:var(--muted);font-size:13px;line-height:1.75}.group{padding:14px 0;border-top:1px solid var(--line)}.group:first-of-type{border-top:0}.group label,.group-title{display:block;margin-bottom:8px;font-size:11px;font-weight:850;color:#b1bcb3}.group input,.group select,.group textarea{width:100%;border:1px solid var(--line2);background:#101511;color:var(--text);border-radius:8px;padding:10px 11px;font-size:13px;outline:none}.group textarea{min-height:92px;line-height:1.65;resize:vertical}.row{display:flex;gap:8px}.row>*{flex:1}.btn{border:1px solid var(--line2);background:#161c18;color:var(--text);border-radius:8px;padding:9px 11px;font-size:11px;font-weight:850;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:#111610}.btn.ghost{background:transparent}.btn:disabled{opacity:.35;cursor:default}.note-actions{display:flex;gap:7px;margin-bottom:8px}.note-list{display:grid;gap:6px;max-height:270px;overflow:auto;padding-right:2px}.note-item{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:9px;border:1px solid var(--line);border-radius:8px;background:#111612}.note-item input{width:auto;margin-top:3px}.note-item b{display:block;font-size:12px;line-height:1.4}.note-item small{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.45}.status{display:none;margin-bottom:13px;padding:11px;border:1px solid #745151;background:#261818;border-radius:8px;color:#e6baba;font-size:12px;line-height:1.6}.status.on{display:block}.status .auth-row{display:flex;gap:8px;margin-top:8px}.status input{flex:1;border:1px solid #684747;background:#120d0d;color:#fff;border-radius:7px;padding:9px}.count{color:var(--accent);font-weight:900}.empty{min-height:65vh;display:grid;place-items:center;border:1px dashed var(--line2);border-radius:16px;color:var(--muted);text-align:center;padding:28px}.hint{margin-top:8px;color:#6d796f;font-size:10px;line-height:1.6}.format-card{padding:12px 13px;border:1px solid var(--line2);background:#101511;border-radius:8px}.format-card b{display:block;font:900 13px ui-monospace,monospace;letter-spacing:.08em;color:var(--accent)}.format-card small{display:block;margin-top:5px;color:var(--muted);font-size:10px;line-height:1.5}.page-editor{display:grid;gap:8px}.edit-card{border:1px solid var(--line);border-radius:10px;background:#111612;overflow:hidden}.edit-card>button{width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;border:0;background:transparent;color:#e9efea;padding:11px 12px;cursor:pointer;text-align:left}.edit-card>button b{font:850 11px ui-monospace,monospace;letter-spacing:.09em}.edit-card>button span{color:#748078;font-size:10px}.edit-body{display:none;padding:0 12px 12px;border-top:1px solid var(--line)}.edit-card.open .edit-body{display:block}.edit-grid{display:grid;gap:8px;padding-top:10px}.mini-label{display:block;margin:0 0 5px;color:#8f9a91;font-size:9px;font-weight:800}.inline-check{display:flex!important;align-items:center;gap:7px;margin:0!important;font-size:10px!important;color:#aeb8b0!important}.inline-check input{width:auto!important}.jump-row{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}.jump-row button{border:1px solid var(--line);background:#101511;color:#9ba79e;border-radius:999px;padding:6px 9px;font-size:9px;cursor:pointer}

    .reader{width:min(680px,100%);margin:0 auto;color:var(--book-ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;touch-action:pan-y;user-select:none}.reader *{box-sizing:border-box}.book-shell{position:relative}.book-stage{position:relative;width:100%;aspect-ratio:182/257;isolation:isolate;overflow:hidden}.book-stage::before{content:"";position:absolute;inset:8px -7px -8px 7px;background:#d8d2c5;border:1px solid #bbb4a6;box-shadow:0 25px 70px #0008;z-index:-3}.book-stage::after{content:"";position:absolute;left:0;top:0;bottom:0;width:10px;background:linear-gradient(90deg,#4f4b4417,transparent);z-index:8;pointer-events:none}.static-page,.motion-page{position:absolute;inset:0}.static-page{z-index:1;will-change:transform,filter}.motion-page{z-index:4;will-change:transform,box-shadow}.paper-page{position:relative;width:100%;height:100%;background:var(--paper);border:1px solid #c8c2b5;overflow:hidden}.motion-page::after{content:"";position:absolute;top:0;right:-1px;bottom:0;width:22px;pointer-events:none;background:linear-gradient(90deg,transparent,#00000012);opacity:.18}.book-stage.auto-next .motion-page,.book-stage.auto-next .static-page,.book-stage.auto-prev .motion-page,.book-stage.auto-prev .static-page,.book-stage.settling .motion-page,.book-stage.settling .static-page{transition:transform var(--turn-ms,330ms) cubic-bezier(.2,.78,.18,1),filter var(--turn-ms,330ms) cubic-bezier(.2,.78,.18,1),box-shadow var(--turn-ms,330ms) cubic-bezier(.2,.78,.18,1)}.book-stage.prep-next .static-page{transform:translate3d(4.5%,0,0) scale(.998);filter:brightness(.985)}.book-stage.prep-next .motion-page{transform:translate3d(0,0,0);box-shadow:16px 0 34px #00000018}.book-stage.prep-next.auto-next.go .static-page{transform:translate3d(0,0,0) scale(1);filter:none}.book-stage.prep-next.auto-next.go .motion-page{transform:translate3d(-102%,0,0);box-shadow:24px 0 44px #00000008}.book-stage.prep-prev .static-page{transform:translate3d(0,0,0)}.book-stage.prep-prev .motion-page{transform:translate3d(-102%,0,0);box-shadow:18px 0 36px #00000018}.book-stage.prep-prev.auto-prev.go .motion-page{transform:translate3d(0,0,0);box-shadow:14px 0 28px #0000000c}.page-hit{position:absolute;top:0;bottom:0;width:18%;z-index:10;border:0;background:transparent;cursor:pointer}.page-hit.prev{left:0}.page-hit.next{right:0}.page-hit:focus-visible{outline:2px solid #111;outline-offset:-5px}.paper-page:hover .edge-cue{opacity:.34}.edge-cue{position:absolute;top:50%;transform:translateY(-50%);z-index:9;opacity:.1;font:900 20px ui-monospace,monospace;pointer-events:none;transition:opacity .18s ease}.edge-cue.left{left:14px}.edge-cue.right{right:14px}

    .book-page{height:100%;min-height:0;padding:7.2% 8.8%;display:flex;flex-direction:column;background:var(--paper)}.page-head{display:flex;justify-content:space-between;gap:16px;padding-bottom:11px;border-bottom:1px solid var(--book-line);font:900 9px ui-monospace,monospace;letter-spacing:.13em;color:var(--book-muted)}.page-title{margin:30px 0 20px;font-size:clamp(29px,4.5vw,43px);line-height:1.12;letter-spacing:-.045em;max-width:16ch}.page-body{white-space:pre-wrap;font-size:15px;line-height:2;max-width:39em;overflow-wrap:anywhere}.page-foot{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:auto;padding-top:16px;border-top:1px solid var(--book-line);font:800 9px ui-monospace,monospace;color:#777a74;letter-spacing:.07em}.cover-body{display:flex;flex:1;flex-direction:column;justify-content:center}.cover-kicker{font:900 10px ui-monospace,monospace;letter-spacing:.16em;color:var(--book-muted)}.cover-title{margin:20px 0 18px;font-size:clamp(42px,7vw,66px);line-height:.98;letter-spacing:-.062em;max-width:10ch}.cover-sub{max-width:31em;font-size:16px;line-height:1.9;color:var(--book-muted)}.intro-body{margin-top:28px}.intro-body .page-body{font-size:18px;line-height:2.05}.run-main{min-height:0}.run-title{margin:30px 0 20px;font-size:clamp(30px,4.5vw,44px);line-height:1.12;letter-spacing:-.045em;max-width:15ch}.run-quote{margin:0;padding:17px 0;border-top:3px solid var(--book-ink);border-bottom:1px solid var(--book-line);font-size:clamp(20px,2.6vw,25px);line-height:1.65;font-weight:700}.run-body{margin-top:22px;white-space:pre-wrap;font-size:15px;line-height:2;max-width:39em;overflow-wrap:anywhere}.cont-mark{display:inline-block;margin-top:18px;border-top:1px solid var(--book-line);padding-top:11px;font:800 9px ui-monospace,monospace;letter-spacing:.15em;color:var(--book-muted)}.run-cont .run-title{margin-top:16px;font-size:20px;color:var(--book-muted);letter-spacing:-.02em}.run-cont .run-body{margin-top:28px}.tags{display:flex;gap:5px;flex-wrap:wrap}.tag{border:1px solid #aaa497;border-radius:999px;padding:4px 7px;font:700 8px ui-monospace,monospace;color:#595e57}.after-list{margin:28px 0 0;padding-left:1.1em;display:grid;gap:13px;font-size:16px;line-height:1.8;max-width:37em}.colophon-body{margin-top:28px}.media-page{padding:6% 7%;}.media-frame{flex:1;min-height:0;margin:18px 0;display:grid;place-items:center;background:#e5e0d4;overflow:hidden}.media-frame img,.media-frame video{width:100%;height:100%;display:block;object-fit:contain}.blank-page{background:var(--paper)}.reader-nav{display:grid;grid-template-columns:88px 1fr 88px;gap:10px;align-items:center;margin-top:17px}.reader-nav button{border:1px solid #3c4941;background:#111713;color:#e9efea;border-radius:999px;padding:9px 11px;font-size:11px;font-weight:850;cursor:pointer}.reader-nav button:disabled{opacity:.28;cursor:default}.progress{text-align:center;color:#a5b0a7;font:800 10px ui-monospace,monospace;letter-spacing:.09em}.reader-help{text-align:center;margin-top:8px;color:#69766d;font-size:10px}.print-stack{display:none}
    @media(max-width:900px){.layout{grid-template-columns:1fr}.tools{border-right:0;border-bottom:1px solid var(--line)}.preview{padding:12px}.note-list{max-height:230px}.reader-nav{grid-template-columns:76px 1fr 76px}}
    @media(max-width:560px){.tools{padding:17px}.preview{padding:7px}.book-page{padding:7.2% 8.8%}.cover-title{font-size:40px}.page-title,.run-title{margin-top:22px;font-size:27px}.run-cont .run-title{font-size:16px}.run-quote{font-size:17px;padding:12px 0}.page-body,.run-body{font-size:11px;line-height:1.72}.intro-body .page-body{font-size:13px;line-height:1.85}.reader-help{font-size:9px}.book-stage::before{inset:4px -3px -4px 3px}}
    @media(prefers-reduced-motion:reduce){.book-stage.auto-next .motion-page,.book-stage.auto-next .static-page,.book-stage.auto-prev .motion-page,.book-stage.auto-prev .static-page,.book-stage.settling .motion-page,.book-stage.settling .static-page{transition-duration:.01ms!important}}
    @page{size:B5 portrait;margin:0}
    @media print{html,body{margin:0!important;padding:0!important;background:#fff!important}.top,.tools,.preview{display:none!important}.layout{display:block!important}.print-stack{display:block!important}.print-page{width:182mm;height:257mm;overflow:hidden;break-after:page;page-break-after:always;background:var(--paper);color:var(--book-ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}.print-page:last-child{break-after:auto;page-break-after:auto}.print-page>.book-page{height:257mm;padding:18mm 16mm}.print-page>.media-page{padding:14mm}.print-page>.blank-page{height:257mm}}
  </style>
</head>
<body>
<div class="app">
  <header class="top"><div><a href="/game-notes/">← GAME NOTES</a> <small>/ MINI BOOK EDITABLE</small></div><b>B5 / EBOOK MOTION PREVIEW</b></header>
  <div class="layout">
    <aside class="tools">
      <div class="eyebrow">GAME NOTES → GAME FRAGMENTS</div>
      <h1>MINI BOOK</h1>
      <p>GAME NOTES本文はそのまま使い、それ以外のページだけ手で編集できます。ページ送りは3D回転ではなく、電子書籍に近い横スライド＋指追従に変更しています。</p>
      <div class="status" id="status"><span id="status-text"></span><div class="auth-row" id="auth-row"><input id="admin-key" type="password" placeholder="HARF-WAY管理キー" /><button class="btn" id="auth-btn">再接続</button></div></div>
      <div class="group"><label>FORMAT</label><div class="format-card"><b>B5 / 182 × 257 mm</b><small>FULL NOTES · EDITABLE FRONT/BACK MATTER · FLUID PAGE SWIPE</small></div></div>
      <div class="group"><label>GAME</label><select id="game"></select></div>
      <div class="group"><div class="group-title">RECORDS <span class="count" id="selected-count">0</span></div><div class="note-actions"><button class="btn" id="latest10">最新10件</button><button class="btn" id="select-all">すべて</button><button class="btn" id="clear-all">解除</button></div><div class="note-list" id="notes"></div></div>

      <div class="group">
        <div class="group-title">PAGE EDITOR</div>
        <div class="page-editor">
          <section class="edit-card open" data-edit-card="cover"><button type="button" data-toggle-edit="cover"><b>COVER</b><span>表紙</span></button><div class="edit-body"><div class="edit-grid">
            <label class="inline-check"><input type="checkbox" id="cover-enabled" checked /> このページを入れる</label>
            <div><span class="mini-label">KICKER</span><input id="cover-kicker" value="GAME FRAGMENTS / PLAY NOTES" /></div>
            <div><span class="mini-label">TITLE</span><textarea id="cover-title"></textarea></div>
            <div><span class="mini-label">SUBTITLE</span><textarea id="cover-sub"></textarea></div>
            <div class="row"><div><span class="mini-label">FOOT LEFT</span><input id="cover-foot-left" value="HARF-WAY" /></div><div><span class="mini-label">FOOT RIGHT</span><input id="cover-foot-right" value="B5" /></div></div>
            <button class="btn ghost" type="button" data-jump="cover">表紙を見る</button>
          </div></div></section>

          <section class="edit-card" data-edit-card="intro"><button type="button" data-toggle-edit="intro"><b>INTRO</b><span>導入</span></button><div class="edit-body"><div class="edit-grid">
            <label class="inline-check"><input type="checkbox" id="intro-enabled" checked /> このページを入れる</label>
            <div><span class="mini-label">LABEL</span><input id="intro-label" value="INTRODUCTION" /></div>
            <div><span class="mini-label">HEADING</span><input id="intro-heading" value="この本について" /></div>
            <div><span class="mini-label">BODY</span><textarea id="intro-body">遊びながら残したGAME NOTESを、整えすぎず時間順に並べた小さな記録集。</textarea></div>
            <button class="btn ghost" type="button" data-jump="intro">INTROを見る</button>
          </div></div></section>

          <section class="edit-card" data-edit-card="after"><button type="button" data-toggle-edit="after"><b>AFTER</b><span>振り返り</span></button><div class="edit-body"><div class="edit-grid">
            <label class="inline-check"><input type="checkbox" id="after-enabled" checked /> このページを入れる</label>
            <div><span class="mini-label">LABEL</span><input id="after-label" value="AFTER THESE RUNS" /></div>
            <div><span class="mini-label">HEADING</span><input id="after-heading" value="いま見えていること" /></div>
            <div><span class="mini-label">POINTS（1行=1項目）</span><textarea id="after-body"></textarea></div>
            <div class="row"><button class="btn ghost" id="after-regenerate" type="button">メモから再生成</button><button class="btn ghost" type="button" data-jump="after">AFTERを見る</button></div>
          </div></div></section>

          <section class="edit-card" data-edit-card="colophon"><button type="button" data-toggle-edit="colophon"><b>COLOPHON</b><span>奥付</span></button><div class="edit-body"><div class="edit-grid">
            <label class="inline-check"><input type="checkbox" id="colophon-enabled" checked /> このページを入れる</label>
            <div><span class="mini-label">LABEL</span><input id="colophon-label" value="COLOPHON / GAME FRAGMENTS" /></div>
            <div><span class="mini-label">HEADING</span><input id="colophon-heading" value="まだ途中。" /></div>
            <div><span class="mini-label">BODY</span><textarea id="colophon-body">ここにあるのは結論ではなく、いまのところ見えている途中経過。</textarea></div>
            <div class="row"><div><span class="mini-label">FOOT LEFT</span><input id="colophon-foot-left" value="GAME NOTES" /></div><div><span class="mini-label">FOOT RIGHT</span><input id="colophon-foot-right" value="HARF-WAY" /></div></div>
            <button class="btn ghost" type="button" data-jump="colophon">奥付を見る</button>
          </div></div></section>
        </div>
        <div class="hint">メモ本文は編集対象から外しています。非メモページだけ、この場で内容と有無を変更できます。</div>
      </div>

      <div class="group"><div class="row"><button class="btn primary" id="refresh">BOOKを更新</button><button class="btn" id="print">印刷 / PDF</button></div><div class="hint" id="print-hint">ページ数を計算中…</div></div>
    </aside>
    <main class="preview"><div id="book"><div class="empty">GAME NOTESを読み込んでいます…</div></div></main>
  </div>
</div>
<div class="print-stack" id="print-stack"></div>
<script is:inline>
(()=>{
  const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const state={games:[],notes:[],facets:[],selected:new Set(),page:0,pages:[],adminKey:sessionStorage.getItem('harfway_game_notes_key')||sessionStorage.getItem('harfway-admin-key')||'',animating:false,afterSeeded:false,drag:null};
  const showStatus=(m,a=false)=>{$('#status-text').textContent=m;$('#status').classList.toggle('on',!!m);$('#auth-row').style.display=a?'flex':'none'};
  const gameById=id=>state.games.find(g=>g.id===id), facetById=id=>state.facets.find(f=>f.id===id), gameId=()=>$('#game').value;
  const fmtDate=v=>{if(!v)return'';const d=new Date(v);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'2-digit',day:'2-digit'}).format(d)};
  const kanji={一:1,二:2,三:3,四:4,五:5,六:6,七:7,八:8,九:9,十:10};
  function runNumber(n,i){const t=String(n.title||'');let m=t.match(/第\s*(\d+)\s*回/);if(m)return Number(m[1]);m=t.match(/第\s*([一二三四五六七八九十])\s*回/);if(m)return kanji[m[1]]||i+1;return i+1}
  function sentences(t){return String(t||'').replace(/\r/g,'').split(/(?<=[。！？!?])|\n+/).map(s=>s.trim()).filter(s=>s.length>=7)}
  function quoteOf(n){const ss=sentences(n.body);if(!ss.length)return String(n.body||'').slice(0,90);const scored=ss.map(s=>[s,(s.length>=18&&s.length<=95?3:0)+(/分か|強|弱|勝|負|役割|デバフ|シナジー|コア|結局|たぶん|気づ/.test(s)?3:0)]).sort((a,b)=>b[1]-a[1]);return scored[0][0].slice(0,130)}
  function tagsOf(n){const out=[];for(const [id,vals] of Object.entries(n.facets||{})){const name=facetById(id)?.name||'';for(const v of vals||[]){if(v)out.push(name?`${name}: ${v}`:v)}}return [...new Set(out)].slice(0,6)}
  function splitLong(text,limit){const s=String(text||'').trim();if(!s)return[];if(s.length<=limit)return[s];const units=s.match(/[^。！？!?\n]+[。！？!?]?/g)?.map(x=>x.trim()).filter(Boolean)||[s];const out=[];let b='';for(const u of units){if(u.length>limit){if(b){out.push(b);b=''}for(let i=0;i<u.length;i+=limit)out.push(u.slice(i,i+limit));continue}if(b&&(b.length+u.length)>limit){out.push(b);b=u}else b+=u}if(b)out.push(b);return out}
  function paginate(body,first=520,next=760){const t=String(body||'').replace(/\r/g,'').trim();if(!t)return[''];let blocks=t.split(/\n{2,}/).map(s=>s.trim()).filter(Boolean);if(blocks.length===1)blocks=t.split(/\n+/).map(s=>s.trim()).filter(Boolean);const units=[];blocks.forEach(b=>units.push(...splitLong(b,next)));const pages=[];let buf='',lim=first;const flush=()=>{if(buf.trim()){pages.push(buf.trim());buf='';lim=next}};for(const u of units){const c=buf?`${buf}\n\n${u}`:u;if(c.length<=lim){buf=c;continue}flush();if(u.length<=lim){buf=u;continue}for(const ch of splitLong(u,lim)){if(ch.length>=lim){pages.push(ch);lim=next}else if(buf){pages.push(buf);buf=ch;lim=next}else buf=ch}}flush();return pages.length?pages:['']}
  function chosen(){return state.notes.filter(n=>n.gameId===gameId()&&state.selected.has(n.id)).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')))}
  function autoInsights(notes){const pool=notes.slice(Math.max(0,Math.floor(notes.length*.45))).flatMap(n=>sentences(n.body));const score=s=>(/役割|相乗|回転率|中途半端|コア|デバフ|タンク|後列|カード|勝ち筋/.test(s)?3:0)+(s.length>=16&&s.length<=100?2:0);const out=[];for(const s of pool.sort((a,b)=>score(b)-score(a))){if(out.some(x=>x.slice(0,12)===s.slice(0,12)))continue;out.push(s);if(out.length>=4)break}return out}
  const pageHead=(left,right)=>`<div class="page-head"><span>${esc(left)}</span><span>${esc(right)}</span></div>`;
  const pageFoot=(left,right)=>`<div class="page-foot"><span>${esc(left)}</span><span>${esc(right)}</span></div>`;
  function notePages(n,index){const run=runNumber(n,index),label=String(run).padStart(2,'0'),chunks=paginate(n.body),tags=tagsOf(n),out=[];chunks.forEach((chunk,part)=>{const first=part===0,last=part===chunks.length-1;out.push({key:`run-${label}-${part+1}`,type:'run',html:`<article class="book-page ${first?'':'run-cont'}"><div class="run-main">${pageHead(`RUN ${label}${first?'':' / CONT.'}`,fmtDate(n.createdAt||n.updatedAt))}${first?`<h2 class="run-title">${esc(n.title||`RUN ${run}`)}</h2><p class="run-quote">${esc(quoteOf(n))}</p>`:`<span class="cont-mark">CONTINUED ${part+1}/${chunks.length}</span><h2 class="run-title">${esc(n.title||`RUN ${run}`)}</h2>`}<div class="run-body">${esc(chunk)}</div></div><div class="page-foot"><div class="tags">${last?tags.map(t=>`<span class="tag">${esc(t)}</span>`).join(''):''}</div><span>RUN ${label}${chunks.length>1?` · ${part+1}/${chunks.length}`:''}</span></div></article>`})});
    const media=(n.media||[]).filter(m=>m&&m.key);media.forEach((m,mi)=>{const src=`/api/game-notes-media?action=file&key=${encodeURIComponent(m.key)}`;const el=m.kind==='video'?`<video controls preload="metadata" src="${src}"></video>`:`<img src="${src}" alt="${esc(m.name||n.title||'GAME NOTES media')}" />`;out.push({key:`media-${label}-${mi+1}`,type:'media',html:`<article class="book-page media-page">${pageHead(`RUN ${label} / IMAGE`,`${mi+1} / ${media.length}`)}<div class="media-frame">${el}</div>${pageFoot(n.title||`RUN ${run}`,m.name||m.kind||'MEDIA')}</article>`})});return out}
  function build(){
    const notes=chosen(),g=gameById(gameId()),raw=[];
    if($('#cover-enabled').checked){raw.push({key:'cover',type:'cover',html:`<article class="book-page">${pageHead($('#cover-kicker').value,'COVER')}<div class="cover-body"><div class="cover-kicker">${esc($('#cover-kicker').value)}</div><h1 class="cover-title">${esc($('#cover-title').value)}</h1><div class="cover-sub">${esc($('#cover-sub').value)}</div></div>${pageFoot($('#cover-foot-left').value,$('#cover-foot-right').value)}</article>`})}
    if($('#intro-enabled').checked && ($('#intro-body').value.trim()||$('#intro-heading').value.trim())){raw.push({key:'intro',type:'intro',html:`<article class="book-page">${pageHead($('#intro-label').value,'INTRO')}<div class="intro-body"><h2 class="page-title">${esc($('#intro-heading').value)}</h2><div class="page-body">${esc($('#intro-body').value)}</div></div>${pageFoot(g?.name||'GAME NOTES','HARF-WAY')}</article>`})}
    notes.forEach((n,i)=>raw.push(...notePages(n,i)));
    if($('#after-enabled').checked){const points=$('#after-body').value.split(/\n+/).map(s=>s.trim()).filter(Boolean);if(points.length||$('#after-heading').value.trim())raw.push({key:'after',type:'after',html:`<article class="book-page">${pageHead($('#after-label').value,'AFTER')}<h2 class="page-title">${esc($('#after-heading').value)}</h2><ul class="after-list">${points.map(s=>`<li>${esc(s)}</li>`).join('')}</ul>${pageFoot(`${notes.length} NOTES`,g?.name||'GAME NOTES')}</article>`})}
    if($('#colophon-enabled').checked){raw.push({key:'colophon',type:'colophon',html:`<article class="book-page">${pageHead($('#colophon-label').value,'COLOPHON')}<div class="colophon-body"><h2 class="page-title">${esc($('#colophon-heading').value)}</h2><div class="page-body">${esc($('#colophon-body').value)}</div></div>${pageFoot($('#colophon-foot-left').value,$('#colophon-foot-right').value)}</article>`})}
    state.pages=raw;state.page=Math.max(0,Math.min(state.page,raw.length-1));renderPrint();return raw;
  }
  function paperPage(p){return `<div class="paper-page">${p?.html||'<div class="book-page blank-page"></div>'}</div>`}
  function readerChrome(i,pages){return `<button class="page-hit prev" type="button" aria-label="前のページ"></button><span class="edge-cue left">‹</span><span class="edge-cue right">›</span><button class="page-hit next" type="button" aria-label="次のページ"></button>`}
  function render(){const pages=build();if(!pages.length){$('#book').innerHTML='<div class="empty">表示するページがありません。</div>';return}const i=state.page,p=pages[i];$('#book').innerHTML=`<div class="reader"><div class="book-shell"><div class="book-stage" data-stage><div class="static-page">${paperPage(p)}</div>${readerChrome(i,pages)}</div></div><div class="reader-nav"><button data-nav="prev" ${i===0?'disabled':''}>← 前</button><div class="progress">B5 · PAGE ${i+1} / ${pages.length}</div><button data-nav="next" ${i===pages.length-1?'disabled':''}>次 →</button></div><div class="reader-help">左右タップ / ドラッグ / ← → で送る</div></div>`;bindReader()}
  function finishTo(next,ms=330){state.page=next;state.animating=false;state.drag=null;setTimeout(render,0)}
  function prepareMotion(next,dir){const stage=$('[data-stage]'),current=state.pages[state.page],target=state.pages[next];if(!stage)return null;if(dir==='next'){
      stage.className='book-stage prep-next';stage.innerHTML=`<div class="static-page">${paperPage(target)}</div><div class="motion-page">${paperPage(current)}</div>`;
    }else{
      stage.className='book-stage prep-prev';stage.innerHTML=`<div class="static-page">${paperPage(current)}</div><div class="motion-page">${paperPage(target)}</div>`;
    }return stage}
  function animatePage(next,dir){if(state.animating||next<0||next>=state.pages.length||next===state.page)return;state.animating=true;const stage=prepareMotion(next,dir);if(!stage){finishTo(next);return}const cls=dir==='next'?'auto-next':'auto-prev';stage.classList.add(cls);stage.style.setProperty('--turn-ms','330ms');requestAnimationFrame(()=>requestAnimationFrame(()=>stage.classList.add('go')));setTimeout(()=>finishTo(next),350)}
  function beginDrag(e){if(state.animating||e.button>0||e.target.closest('video,button[data-nav]'))return;const stage=$('[data-stage]');if(!stage)return;state.drag={id:e.pointerId,startX:e.clientX,lastX:e.clientX,startAt:performance.now(),lastAt:performance.now(),active:false,dir:null,next:null,width:stage.getBoundingClientRect().width};stage.setPointerCapture?.(e.pointerId)}
  function moveDrag(e){const d=state.drag;if(!d||d.id!==e.pointerId||state.animating)return;const dx=e.clientX-d.startX,abs=Math.abs(dx);d.lastX=e.clientX;d.lastAt=performance.now();if(!d.active){if(abs<7)return;const dir=dx<0?'next':'prev',next=state.page+(dir==='next'?1:-1);if(next<0||next>=state.pages.length){state.drag=null;return}d.active=true;d.dir=dir;d.next=next;prepareMotion(next,dir)}
    const stage=$('[data-stage]'),motion=stage?.querySelector('.motion-page'),under=stage?.querySelector('.static-page');if(!stage||!motion||!under)return;e.preventDefault();const width=d.width||1;
    if(d.dir==='next'){const x=Math.max(-width,Math.min(0,dx)),progress=Math.min(1,Math.abs(x)/width);motion.style.transform=`translate3d(${x}px,0,0)`;motion.style.boxShadow=`${Math.round(12+20*progress)}px 0 ${Math.round(28+24*progress)}px rgba(0,0,0,${(0.08*(1-progress)).toFixed(3)})`;under.style.transform=`translate3d(${(1-progress)*4.5}%,0,0) scale(${(.998+.002*progress).toFixed(4)})`;under.style.filter=`brightness(${(.985+.015*progress).toFixed(3)})`}
    else{const x=Math.min(width,Math.max(0,dx)),progress=Math.min(1,x/width);motion.style.transform=`translate3d(${(-width+x)}px,0,0)`;motion.style.boxShadow=`${Math.round(8+18*progress)}px 0 ${Math.round(24+22*progress)}px rgba(0,0,0,${(0.12*(1-progress)).toFixed(3)})`}}
  function endDrag(e){const d=state.drag;if(!d||d.id!==e.pointerId)return;const stage=$('[data-stage]');if(!d.active||!stage){state.drag=null;return}const motion=stage.querySelector('.motion-page'),under=stage.querySelector('.static-page'),dx=e.clientX-d.startX,width=d.width||1,progress=Math.min(1,Math.abs(dx)/width),elapsed=Math.max(1,performance.now()-d.startAt),velocity=Math.abs(dx)/elapsed,commit=progress>.18||velocity>.55;state.animating=true;stage.classList.add('settling');const ms=Math.round(commit?Math.max(120,280*(1-progress)):190);stage.style.setProperty('--turn-ms',`${ms}ms`);
    if(d.dir==='next'){motion.style.transform=commit?'translate3d(-102%,0,0)':'translate3d(0,0,0)';under.style.transform=commit?'translate3d(0,0,0) scale(1)':'translate3d(4.5%,0,0) scale(.998)';under.style.filter=commit?'none':'brightness(.985)'}else{motion.style.transform=commit?'translate3d(0,0,0)':`translate3d(-${width}px,0,0)`}
    const next=d.next;state.drag=null;setTimeout(()=>{if(commit)state.page=next;state.animating=false;render()},ms+24)}
  function cancelDrag(e){if(!state.drag)return;endDrag(e)}
  function bindReader(){const prev=()=>animatePage(state.page-1,'prev'),next=()=>animatePage(state.page+1,'next');$('[data-nav="prev"]')?.addEventListener('click',prev);$('[data-nav="next"]')?.addEventListener('click',next);$('.page-hit.prev')?.addEventListener('click',prev);$('.page-hit.next')?.addEventListener('click',next);const stage=$('[data-stage]');if(stage){stage.addEventListener('pointerdown',beginDrag);stage.addEventListener('pointermove',moveDrag,{passive:false});stage.addEventListener('pointerup',endDrag);stage.addEventListener('pointercancel',cancelDrag)}}
  function renderPrint(){const pad=(4-(state.pages.length%4))%4,total=state.pages.length+pad;$('#print-hint').textContent=`本文 ${state.pages.length}ページ${pad?` + 印刷用白紙 ${pad}ページ`:''} = ${total}ページ`;$('#print-stack').innerHTML=state.pages.map(p=>`<section class="print-page">${p.html}</section>`).join('')+Array.from({length:pad},()=>'<section class="print-page"><div class="blank-page"></div></section>').join('')}
  function renderGames(){const s=$('#game');s.innerHTML=state.games.map(g=>`<option value="${esc(g.id)}">${esc(g.name)}</option>`).join('');const mt=state.games.find(g=>/モンスタートレイン/i.test(g.name));if(mt)s.value=mt.id;onGame()}
  function seedPageEditor(ns){const g=gameById(gameId());$('#cover-title').value=g?.name?`${g.name} / ${ns.length||''} RUNS`.replace(' /  RUNS',''):'';$('#cover-sub').value=g?.name||'';$('#cover-foot-right').value=`${ns.length} FRAGMENTS · B5`;$('#after-body').value=autoInsights(ns).join('\n');state.afterSeeded=true}
  function onGame(){const ns=state.notes.filter(n=>n.gameId===gameId()).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')));state.selected=new Set(ns.slice(-10).map(n=>n.id));seedPageEditor(ns);renderNoteList(ns);state.page=0;render()}
  function renderNoteList(ns){$('#notes').innerHTML=ns.map(n=>`<label class="note-item"><input type="checkbox" value="${esc(n.id)}" ${state.selected.has(n.id)?'checked':''}/><span><b>${esc(n.title||'無題')}</b><small>${esc(fmtDate(n.createdAt||n.updatedAt))}${(n.media||[]).length?` · MEDIA ${(n.media||[]).length}`:''}</small></span></label>`).join('')||'<div class="hint">このゲームの記録はありません。</div>';$('#selected-count').textContent=state.selected.size}
  function updateAfterFromSelected(){const ins=autoInsights(chosen());$('#after-body').value=ins.join('\n');state.page=0;render()}
  async function load(){showStatus('GAME NOTESを読み込んでいます…');const headers=state.adminKey?{'x-admin-key':state.adminKey}:{};const res=await fetch('/api/game-notes',{headers,cache:'no-store'}),data=await res.json().catch(()=>({}));if(res.status===401){showStatus('管理キーを入力するとGAME NOTESを読み込めます。',true);$('#book').innerHTML='<div class="empty">GAME NOTESへの認証が必要です。</div>';return}if(!res.ok){showStatus(`読み込みに失敗しました: ${data.error||res.status}`);return}state.games=data.games||[];state.notes=data.notes||[];state.facets=data.facets||[];showStatus('');renderGames()}
  function jumpTo(key){build();const i=state.pages.findIndex(p=>p.key===key);if(i>=0){state.page=i;render()}}
  $('#game').addEventListener('change',onGame);$('#notes').addEventListener('change',e=>{if(!e.target.matches('input[type="checkbox"]'))return;e.target.checked?state.selected.add(e.target.value):state.selected.delete(e.target.value);$('#selected-count').textContent=state.selected.size;state.page=0;render()});
  $('#latest10').addEventListener('click',()=>{const ns=state.notes.filter(n=>n.gameId===gameId()).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')));state.selected=new Set(ns.slice(-10).map(n=>n.id));renderNoteList(ns);state.page=0;render()});
  $('#select-all').addEventListener('click',()=>{const ns=state.notes.filter(n=>n.gameId===gameId());state.selected=new Set(ns.map(n=>n.id));renderNoteList(ns);state.page=0;render()});
  $('#clear-all').addEventListener('click',()=>{const ns=state.notes.filter(n=>n.gameId===gameId());state.selected.clear();renderNoteList(ns);state.page=0;render()});
  $$('[data-toggle-edit]').forEach(btn=>btn.addEventListener('click',()=>{$(`[data-edit-card="${btn.dataset.toggleEdit}"]`)?.classList.toggle('open')}));
  $$('[data-jump]').forEach(btn=>btn.addEventListener('click',()=>jumpTo(btn.dataset.jump)));
  $('#after-regenerate').addEventListener('click',updateAfterFromSelected);$('#refresh').addEventListener('click',()=>{state.page=0;render()});$('#print').addEventListener('click',()=>{build();window.print()});
  $$('.page-editor input,.page-editor textarea').forEach(el=>el.addEventListener('input',()=>{clearTimeout(state._t);state._t=setTimeout(()=>render(),120)}));
  $('#auth-btn').addEventListener('click',()=>{state.adminKey=$('#admin-key').value.trim();if(state.adminKey){sessionStorage.setItem('harfway_game_notes_key',state.adminKey);sessionStorage.setItem('harfway-admin-key',state.adminKey)}load()});
  document.addEventListener('keydown',e=>{if(/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName||''))return;if(e.key==='ArrowLeft')animatePage(state.page-1,'prev');if(e.key==='ArrowRight')animatePage(state.page+1,'next')});
  load();
})();
</script>
</body>
