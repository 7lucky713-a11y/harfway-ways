---
const title = 'MINI BOOK / B5 CLEAN';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title}</title>
  <style is:global>
    :root{--bg:#0d110f;--panel:#151a17;--line:#2d3831;--line2:#414f46;--text:#eef4ef;--muted:#8e9a91;--accent:#dff238;--ink:#111610}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.app{min-height:100vh}.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 20px;border-bottom:1px solid var(--line);background:#0d110ff2;backdrop-filter:blur(12px)}.top a{color:var(--muted);text-decoration:none;font-size:12px;font-weight:800}.top small{color:#68756c}.top b{font-size:12px;letter-spacing:.12em}.layout{display:grid;grid-template-columns:minmax(320px,410px) minmax(0,1fr);min-height:calc(100vh - 57px)}.tools{border-right:1px solid var(--line);padding:22px;overflow:auto}.preview{padding:24px;overflow:auto;display:grid;align-items:start}.eyebrow{font:800 10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);margin-bottom:7px}.tools h1{margin:0 0 7px;font-size:29px;letter-spacing:-.04em}.tools>p{margin:0 0 20px;color:var(--muted);font-size:13px;line-height:1.75}.group{padding:14px 0;border-top:1px solid var(--line)}.group:first-of-type{border-top:0}.group label,.group-title{display:block;margin-bottom:8px;font-size:11px;font-weight:850;color:#b1bcb3}.group input,.group select,.group textarea{width:100%;border:1px solid var(--line2);background:#101511;color:var(--text);border-radius:8px;padding:10px 11px;font-size:14px;outline:none}.group textarea{min-height:80px;line-height:1.6;resize:vertical}.row{display:flex;gap:8px}.row>*{flex:1}.btn{border:1px solid var(--line2);background:#161c18;color:var(--text);border-radius:8px;padding:10px 11px;font-size:12px;font-weight:850;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--ink)}.btn:disabled{opacity:.4;cursor:not-allowed}.note-actions{display:flex;gap:7px;margin-bottom:8px}.note-list{display:grid;gap:6px;max-height:300px;overflow:auto;padding-right:2px}.note-item{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:9px;border:1px solid var(--line);border-radius:8px;background:#111612}.note-item input{width:auto;margin-top:3px}.note-item b{display:block;font-size:12px;line-height:1.4}.note-item small{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.45}.status{display:none;margin-bottom:13px;padding:11px;border:1px solid #745151;background:#261818;border-radius:8px;color:#e6baba;font-size:12px;line-height:1.6}.status.on{display:block}.status .auth-row{display:flex;gap:8px;margin-top:8px}.status input{flex:1;border:1px solid #684747;background:#120d0d;color:#fff;border-radius:7px;padding:9px}.count{color:var(--accent);font-weight:900}.empty{min-height:65vh;display:grid;place-items:center;border:1px dashed var(--line2);border-radius:16px;color:var(--muted);text-align:center;padding:28px}.hint{margin-top:8px;color:#6d796f;font-size:10px;line-height:1.6}.format-card{padding:12px 13px;border:1px solid var(--line2);background:#101511;border-radius:8px}.format-card b{display:block;font:900 13px ui-monospace,monospace;letter-spacing:.08em;color:var(--accent)}.format-card small{display:block;margin-top:5px;color:var(--muted);font-size:10px;line-height:1.5}

    .hwmb-reader{--paper:#f2efe6;--book-ink:#171916;--book-muted:#6e716b;--book-line:#c9c3b5;--book-accent:#161b17;width:min(680px,100%);margin:0 auto;color:var(--book-ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;touch-action:pan-y}.hwmb-reader *{box-sizing:border-box}.hwmb-shell{position:relative;perspective:1600px}.hwmb-page{position:relative;width:100%;aspect-ratio:182/257;background:var(--paper);border:1px solid #c8c2b5;box-shadow:0 22px 65px #0008;overflow:hidden;transform-origin:left center;backface-visibility:hidden}.hwmb-page.is-flipping-next{animation:hwmbFlipNext .38s ease-in both}.hwmb-page.is-flipping-prev{animation:hwmbFlipPrev .34s ease-out both}@keyframes hwmbFlipNext{0%{transform:rotateY(0);opacity:1}60%{opacity:.78}100%{transform:rotateY(-88deg);opacity:.15}}@keyframes hwmbFlipPrev{0%{transform:rotateY(-72deg);opacity:.2}100%{transform:rotateY(0);opacity:1}}.hwmb-corner{position:absolute;top:0;bottom:0;width:14%;z-index:4;border:0;background:transparent;cursor:pointer}.hwmb-corner.prev{left:0}.hwmb-corner.next{right:0}.hwmb-cover,.hwmb-intro,.hwmb-run,.hwmb-after,.hwmb-colophon,.hwmb-media,.hwmb-blank{height:100%;min-height:0;padding:7.2% 8.8%;display:flex;flex-direction:column;background:var(--paper);color:var(--book-ink)}.hwmb-cover,.hwmb-intro,.hwmb-run,.hwmb-after,.hwmb-colophon{justify-content:space-between}.hwmb-run-main{min-height:0}.hwmb-run-top{display:flex;justify-content:space-between;gap:16px;padding-bottom:12px;border-bottom:1px solid var(--book-line);font:900 10px ui-monospace,monospace;letter-spacing:.13em}.hwmb-run-date{color:var(--book-muted);letter-spacing:.04em}.hwmb-run h2,.hwmb-cover h1,.hwmb-intro h2,.hwmb-after h2,.hwmb-colophon h2{margin:34px 0 20px;font-size:clamp(30px,4.5vw,44px);line-height:1.12;letter-spacing:-.045em;max-width:15ch}.hwmb-run-cont h2{margin-top:18px;font-size:20px;color:var(--book-muted);letter-spacing:-.02em}.hwmb-cont-mark{display:inline-block;margin-top:18px;border-top:1px solid var(--book-line);padding-top:11px;font:800 9px ui-monospace,monospace;letter-spacing:.15em;color:var(--book-muted)}.hwmb-quote,.hwmb-cover-sub{margin:0;padding:17px 0;border-top:3px solid var(--book-accent);border-bottom:1px solid var(--book-line);font-size:clamp(20px,2.6vw,25px);line-height:1.65;font-weight:700}.hwmb-body{margin-top:22px;white-space:pre-wrap;font-size:15px;line-height:2;max-width:39em;overflow-wrap:anywhere}.hwmb-run-cont .hwmb-body{margin-top:30px}.hwmb-footer,.hwmb-cover-foot{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:30px;padding-top:10px;border-top:1px solid var(--book-line)}.hwmb-cover-foot{font:800 9px/1.5 ui-monospace,monospace;letter-spacing:.1em}.hwmb-tags{display:flex;gap:5px;flex-wrap:wrap}.hwmb-tag{border:1px solid #aaa497;border-radius:999px;padding:4px 7px;font:700 8px ui-monospace,monospace;color:#595e57}.hwmb-pageno{font:800 9px ui-monospace,monospace;color:#777a74}.hwmb-section-body{margin-top:22px;max-width:39em;font-size:15px;line-height:2;white-space:pre-wrap}.hwmb-after ul{margin:22px 0 0;padding-left:1.15em;display:grid;gap:14px;max-width:38em;font-size:15px;line-height:1.9}.hwmb-media{justify-content:space-between}.hwmb-media-head{display:flex;justify-content:space-between;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--book-line);font:900 9px ui-monospace,monospace;letter-spacing:.12em;color:var(--book-muted)}.hwmb-media-frame{flex:1;min-height:0;margin:22px 0 16px;display:grid;place-items:center;background:#e4dfd4;overflow:hidden}.hwmb-media-frame img,.hwmb-media-frame video{width:100%;height:100%;display:block;object-fit:contain}.hwmb-media-caption{display:flex;justify-content:space-between;gap:12px;padding-top:10px;border-top:1px solid var(--book-line);font:800 9px ui-monospace,monospace;color:var(--book-muted);letter-spacing:.06em}.hwmb-blank{background:var(--paper)}.hwmb-reader-nav{display:grid;grid-template-columns:88px 1fr 88px;gap:10px;align-items:center;margin-top:14px}.hwmb-reader-nav button{border:1px solid #3c4941;background:#111713;color:#e9efea;border-radius:999px;padding:9px 11px;font-size:11px;font-weight:850;cursor:pointer}.hwmb-reader-nav button:disabled{opacity:.28;cursor:default}.hwmb-progress{text-align:center;color:#a5b0a7;font:800 10px ui-monospace,monospace;letter-spacing:.09em}.hwmb-dots{display:flex;justify-content:center;gap:4px;margin-top:9px;flex-wrap:wrap}.hwmb-dot{width:5px;height:5px;border-radius:99px;background:#3c4941}.hwmb-dot.on{background:#dff238}.hwmb-reader-help{text-align:center;margin-top:8px;color:#69766d;font-size:10px}.print-stack{display:none}
    @media(max-width:900px){.layout{grid-template-columns:1fr}.tools{border-right:0;border-bottom:1px solid var(--line)}.preview{padding:12px}.note-list{max-height:260px}.hwmb-reader-nav{grid-template-columns:76px 1fr 76px}.hwmb-corner{width:20%}}
    @media(max-width:560px){.tools{padding:17px}.preview{padding:7px}.hwmb-cover,.hwmb-intro,.hwmb-run,.hwmb-after,.hwmb-colophon,.hwmb-media{padding:7.2% 8.8%}.hwmb-run h2,.hwmb-cover h1,.hwmb-intro h2,.hwmb-after h2,.hwmb-colophon h2{margin-top:22px;font-size:27px}.hwmb-run-cont h2{font-size:16px;margin-top:12px}.hwmb-quote,.hwmb-cover-sub{font-size:17px;padding:12px 0}.hwmb-body,.hwmb-section-body{margin-top:15px;font-size:11px;line-height:1.72}.hwmb-run-cont .hwmb-body{margin-top:18px}.hwmb-after ul{font-size:11px;line-height:1.72;gap:9px}.hwmb-reader-help{font-size:9px}}
    @media(prefers-reduced-motion:reduce){.hwmb-page.is-flipping-next,.hwmb-page.is-flipping-prev{animation:none}}
    @page{size:B5 portrait;margin:0}
    @media print{html,body{margin:0!important;padding:0!important;background:#fff!important}.top,.tools,.preview{display:none!important}.layout{display:block!important}.print-stack{display:block!important}.print-page{width:182mm;height:257mm;overflow:hidden;break-after:page;page-break-after:always;background:#f2efe6;color:#171916;font-family:"Hiragino Mincho ProN","Yu Mincho",serif;-webkit-print-color-adjust:exact;print-color-adjust:exact}.print-page:last-child{break-after:auto;page-break-after:auto}.print-page>.hwmb-cover,.print-page>.hwmb-intro,.print-page>.hwmb-run,.print-page>.hwmb-after,.print-page>.hwmb-colophon,.print-page>.hwmb-media,.print-page>.hwmb-blank{height:257mm;padding:18mm 16mm}}
  </style>
</head>
<body>
<div class="app">
  <header class="top"><div><a href="/game-notes/">← GAME NOTES</a> <small>/ MINI BOOK CLEAN</small></div><b>ONE TYPOGRAPHIC SYSTEM / B5</b></header>
  <div class="layout">
    <aside class="tools">
      <div class="eyebrow">GAME NOTES → GAME FRAGMENTS</div>
      <h1>MINI BOOK</h1>
      <p>本文ページの紙面ルールを一冊全体へ拡張した検証版。表紙・導入・AFTER・奥付も、白い紙・余白・小さな上部情報・罫線だけで統一します。</p>
      <div class="status" id="status"><span id="status-text"></span><div class="auth-row" id="auth-row"><input id="admin-key" type="password" placeholder="HARF-WAY管理キー" /><button class="btn" id="auth-btn">再接続</button></div></div>
      <div class="group"><label>FORMAT</label><div class="format-card"><b>B5 / 182 × 257 mm</b><small>BODY-PAGE SYSTEM · WEB / PRINT 共通</small></div></div>
      <div class="group"><label>GAME</label><select id="game"></select></div>
      <div class="group"><div class="group-title">RECORDS <span class="count" id="selected-count">0</span></div><div class="note-actions"><button class="btn" id="latest10">最新10件</button><button class="btn" id="select-all">すべて</button><button class="btn" id="clear-all">解除</button></div><div class="note-list" id="notes"></div></div>
      <div class="group"><label>BOOK TITLE</label><input id="book-title" /></div>
      <div class="group"><label>KICKER</label><input id="kicker" value="GAME FRAGMENTS / PLAY NOTES" /></div>
      <div class="group"><label>INTRO</label><textarea id="intro"></textarea></div>
      <div class="group"><label>ENDING NOTE</label><textarea id="ending"></textarea></div>
      <div class="group"><div class="row"><button class="btn primary" id="generate">BOOKを更新</button><button class="btn" id="print">印刷 / PDF</button></div><div class="hint" id="print-hint">ページ数を計算中…</div></div>
    </aside>
    <main class="preview"><div id="book"><div class="empty">GAME NOTESを読み込んでいます…</div></div></main>
  </div>
</div>
<div class="print-stack" id="print-stack"></div>
<script is:inline>
(()=>{
  const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const state={games:[],notes:[],facets:[],selected:new Set(),page:0,pages:[],adminKey:sessionStorage.getItem('harfway-admin-key')||'',touchX:null};
  const showStatus=(m,a=false)=>{$('#status-text').textContent=m;$('#status').classList.toggle('on',!!m);$('#auth-row').style.display=a?'flex':'none'};
  const gameById=id=>state.games.find(g=>g.id===id);const facetById=id=>state.facets.find(f=>f.id===id);const gameId=()=>$('#game').value;
  const fmtDate=v=>{if(!v)return'';const d=new Date(v);return Number.isNaN(d.getTime())?String(v):new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'2-digit',day:'2-digit'}).format(d)};
  const kanji={一:1,二:2,三:3,四:4,五:5,六:6,七:7,八:8,九:9,十:10};
  function runNumber(n,i){const t=String(n.title||'');let m=t.match(/第\s*(\d+)\s*回/);if(m)return Number(m[1]);m=t.match(/第\s*([一二三四五六七八九十])\s*回/);if(m)return kanji[m[1]]||i+1;return i+1}
  function sentences(t){return String(t||'').replace(/\r/g,'').split(/(?<=[。！？!?])|\n+/).map(s=>s.trim()).filter(s=>s.length>=7)}
  function quoteOf(n){const ss=sentences(n.body);if(!ss.length)return String(n.body||'').slice(0,90);const scored=ss.map(s=>[s,(s.length>=18&&s.length<=95?3:0)+(/分か|強|弱|勝|負|役割|デバフ|シナジー|コア|結局|たぶん|気づ/.test(s)?3:0)]).sort((a,b)=>b[1]-a[1]);return scored[0][0].slice(0,130)}
  function tagsOf(n){const out=[];for(const [id,vals] of Object.entries(n.facets||{})){const name=facetById(id)?.name||'';for(const v of vals||[]){if(v)out.push(name?`${name}: ${v}`:v)}}return [...new Set(out)].slice(0,6)}
  function splitLong(text,limit){const s=String(text||'').trim();if(!s)return[];if(s.length<=limit)return[s];const units=s.match(/[^。！？!?\n]+[。！？!?]?/g)?.map(x=>x.trim()).filter(Boolean)||[s];const out=[];let b='';for(const u of units){if(u.length>limit){if(b){out.push(b);b=''}for(let i=0;i<u.length;i+=limit)out.push(u.slice(i,i+limit));continue}if(b&&(b.length+u.length)>limit){out.push(b);b=u}else b+=u}if(b)out.push(b);return out}
  function paginate(body,first=520,next=760){const t=String(body||'').replace(/\r/g,'').trim();if(!t)return[''];let blocks=t.split(/\n{2,}/).map(s=>s.trim()).filter(Boolean);if(blocks.length===1)blocks=t.split(/\n+/).map(s=>s.trim()).filter(Boolean);const units=[];blocks.forEach(b=>units.push(...splitLong(b,next)));const pages=[];let buf='',lim=first;const flush=()=>{if(buf.trim()){pages.push(buf.trim());buf='';lim=next}};for(const u of units){const c=buf?`${buf}\n\n${u}`:u;if(c.length<=lim){buf=c;continue}flush();if(u.length<=lim){buf=u;continue}for(const ch of splitLong(u,lim)){if(ch.length>=lim){pages.push(ch);lim=next}else if(buf){pages.push(buf);buf=ch;lim=next}else buf=ch}}flush();return pages.length?pages:['']}
  function chosen(){return state.notes.filter(n=>n.gameId===gameId()&&state.selected.has(n.id)).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')))}
  function notePages(n,index){const run=runNumber(n,index),label=String(run).padStart(2,'0'),chunks=paginate(n.body),tags=tagsOf(n),out=[];chunks.forEach((chunk,part)=>{const first=part===0,last=part===chunks.length-1;out.push({type:'run',html:`<article class="hwmb-run ${first?'':'hwmb-run-cont'}"><div class="hwmb-run-main"><div class="hwmb-run-top"><span>RUN ${label}${first?'':' / CONT.'}</span><span class="hwmb-run-date">${esc(fmtDate(n.createdAt||n.updatedAt))}</span></div>${first?`<h2>${esc(n.title||`RUN ${run}`)}</h2><p class="hwmb-quote">${esc(quoteOf(n))}</p>`:`<span class="hwmb-cont-mark">RUN ${label} · CONTINUED ${part+1}/${chunks.length}</span><h2>${esc(n.title||`RUN ${run}`)}</h2>`}<div class="hwmb-body">${esc(chunk)}</div></div><div class="hwmb-footer"><div class="hwmb-tags">${last?tags.map(t=>`<span class="hwmb-tag">${esc(t)}</span>`).join(''):''}</div><span class="hwmb-pageno">RUN ${label}${chunks.length>1?` · ${part+1}/${chunks.length}`:''}</span></div></article>`})});
    const media=(n.media||[]).filter(m=>m&&m.key);media.forEach((m,mi)=>{const src=`/api/game-notes-media?action=file&key=${encodeURIComponent(m.key)}`;const el=m.kind==='video'?`<video controls preload="metadata" src="${src}"></video>`:`<img src="${src}" alt="${esc(m.name||n.title||'GAME NOTES media')}" />`;out.push({type:'media',html:`<article class="hwmb-media"><div class="hwmb-media-head"><span>RUN ${label} / EVIDENCE</span><span>${mi+1} / ${media.length}</span></div><div class="hwmb-media-frame">${el}</div><div class="hwmb-media-caption"><strong>${esc(n.title||`RUN ${run}`)}</strong><span>${esc(m.name||m.kind||'MEDIA')}</span></div></article>`})});return out}
  function insights(notes){const pool=notes.slice(Math.max(0,Math.floor(notes.length*.45))).flatMap(n=>sentences(n.body));const score=s=>(/役割|相乗|回転率|中途半端|コア|デバフ|タンク|後列|カード|勝ち筋/.test(s)?3:0)+(s.length>=16&&s.length<=100?2:0);const out=[];for(const s of pool.sort((a,b)=>score(b)-score(a))){if(out.some(x=>x.slice(0,12)===s.slice(0,12)))continue;out.push(s);if(out.length>=4)break}return out}
  function build(){const notes=chosen(),g=gameById(gameId()),title=$('#book-title').value.trim()||(g?.name||'PLAY NOTES'),kicker=$('#kicker').value.trim(),intro=$('#intro').value.trim(),ending=$('#ending').value.trim(),raw=[];
    raw.push({type:'cover',html:`<div class="hwmb-cover"><div class="hwmb-run-main"><div class="hwmb-run-top"><span>${esc(kicker)}</span><span>B5 / 182 × 257 mm</span></div><h1>${esc(title)}</h1><p class="hwmb-cover-sub">${esc(g?.name||'')}</p></div><div class="hwmb-cover-foot"><span>HARF-WAY</span><span>${notes.length} FRAGMENTS</span></div></div>`});
    if(intro)raw.push({type:'intro',html:`<div class="hwmb-intro"><div class="hwmb-run-main"><div class="hwmb-run-top"><span>INTRODUCTION</span><span>BEFORE READING</span></div><h2>この本について</h2><div class="hwmb-section-body">${esc(intro)}</div></div><div class="hwmb-footer"><span class="hwmb-pageno">GAME NOTES</span><span class="hwmb-pageno">INTRO</span></div></div>`});
    notes.forEach((n,i)=>raw.push(...notePages(n,i)));
    const ins=insights(notes);if(ins.length)raw.push({type:'after',html:`<div class="hwmb-after"><div class="hwmb-run-main"><div class="hwmb-run-top"><span>AFTER THESE RUNS</span><span>${notes.length} FRAGMENTS</span></div><h2>いま見えていること</h2><ul>${ins.map(s=>`<li>${esc(s)}</li>`).join('')}</ul></div><div class="hwmb-footer"><span class="hwmb-pageno">GAME NOTES</span><span class="hwmb-pageno">AFTER</span></div></div>`});
    raw.push({type:'colophon',html:`<div class="hwmb-colophon"><div class="hwmb-run-main"><div class="hwmb-run-top"><span>COLOPHON</span><span>B5 / GAME FRAGMENTS</span></div><h2>まだ途中。</h2><div class="hwmb-section-body">${esc(ending)}</div></div><div class="hwmb-cover-foot"><span>GAME NOTES · HARF-WAY</span><span>182 × 257 mm</span></div></div>`});
    state.pages=raw;state.page=Math.min(state.page,raw.length-1);renderPrint();return raw}
  function frame(p){return `<section class="hwmb-page"><button class="hwmb-corner prev" type="button" aria-label="前"></button>${p.html}<button class="hwmb-corner next" type="button" aria-label="次"></button></section>`}
  function render(){const pages=build();if(!pages.length){$('#book').innerHTML='<div class="empty">記録を選択してください。</div>';return}const i=state.page;$('#book').innerHTML=`<div class="hwmb-reader"><div class="hwmb-shell">${frame(pages[i])}</div><div class="hwmb-reader-nav"><button data-nav="prev" ${i===0?'disabled':''}>← 前</button><div class="hwmb-progress">B5 · PAGE ${i+1} / ${pages.length}</div><button data-nav="next" ${i===pages.length-1?'disabled':''}>次 →</button></div><div class="hwmb-dots">${pages.map((_,j)=>`<span class="hwmb-dot ${i===j?'on':''}"></span>`).join('')}</div><div class="hwmb-reader-help">左右クリック / ← → / スワイプでめくる</div></div>`;bindReader()}
  function renderPrint(){const pad=(4-(state.pages.length%4))%4,total=state.pages.length+pad;$('#print-hint').textContent=`本文 ${state.pages.length}ページ${pad?` + 印刷用白紙 ${pad}ページ`:''} = ${total}ページ（4の倍数）`;$('#print-stack').innerHTML=state.pages.map(p=>`<section class="print-page">${p.html}</section>`).join('')+Array.from({length:pad},()=>'<section class="print-page"><div class="hwmb-blank"></div></section>').join('')}
  function flip(next,dir){if(next<0||next>=state.pages.length||next===state.page)return;const p=$('.hwmb-page');if(!p){state.page=next;render();return}p.classList.add(dir==='prev'?'is-flipping-prev':'is-flipping-next');setTimeout(()=>{state.page=next;render()},dir==='prev'?170:260)}
  function bindReader(){const prev=()=>flip(state.page-1,'prev'),next=()=>flip(state.page+1,'next');$('[data-nav="prev"]')?.addEventListener('click',prev);$('[data-nav="next"]')?.addEventListener('click',next);$('.hwmb-corner.prev')?.addEventListener('click',prev);$('.hwmb-corner.next')?.addEventListener('click',next);const r=$('.hwmb-reader');if(r){r.addEventListener('touchstart',e=>state.touchX=e.changedTouches[0]?.clientX??null,{passive:true});r.addEventListener('touchend',e=>{if(state.touchX==null)return;const dx=(e.changedTouches[0]?.clientX??state.touchX)-state.touchX;state.touchX=null;if(Math.abs(dx)>45)(dx<0?next:prev)()},{passive:true})}}
  function renderGames(){const s=$('#game');s.innerHTML=state.games.map(g=>`<option value="${esc(g.id)}">${esc(g.name)}</option>`).join('');const mt=state.games.find(g=>/モンスタートレイン/i.test(g.name));if(mt)s.value=mt.id;onGame()}
  function onGame(){const ns=state.notes.filter(n=>n.gameId===gameId()).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')));state.selected=new Set(ns.slice(-10).map(n=>n.id));const g=gameById(gameId());$('#book-title').value=g?.name?`${g.name} / ${ns.length||''} RUNS`.replace(' /  RUNS',''):'';if(!$('#intro').value)$('#intro').value='遊びながら残したGAME NOTESを、整えすぎず時間順に並べた小さな記録集。';if(!$('#ending').value)$('#ending').value='ここにあるのは結論ではなく、いまのところ見えている途中経過。';renderNoteList(ns);state.page=0;render()}
  function renderNoteList(ns){$('#notes').innerHTML=ns.map(n=>`<label class="note-item"><input type="checkbox" value="${esc(n.id)}" ${state.selected.has(n.id)?'checked':''}/><span><b>${esc(n.title||'無題')}</b><small>${esc(fmtDate(n.createdAt||n.updatedAt))}${(n.media||[]).length?` · MEDIA ${(n.media||[]).length}`:''}</small></span></label>`).join('')||'<div class="hint">このゲームの記録はありません。</div>';$('#selected-count').textContent=state.selected.size}
  async function load(){showStatus('GAME NOTESを読み込んでいます…');const headers=state.adminKey?{'x-admin-key':state.adminKey}:{};const res=await fetch('/api/game-notes',{headers,cache:'no-store'}),data=await res.json().catch(()=>({}));if(res.status===401){showStatus('管理キーを入力するとGAME NOTESを読み込めます。',true);$('#book').innerHTML='<div class="empty">GAME NOTESへの認証が必要です。</div>';return}if(!res.ok){showStatus(`読み込みに失敗しました: ${data.error||res.status}`);return}state.games=data.games||[];state.notes=data.notes||[];state.facets=data.facets||[];showStatus('');renderGames()}
  $('#game').addEventListener('change',onGame);$('#notes').addEventListener('change',e=>{if(!e.target.matches('input[type="checkbox"]'))return;e.target.checked?state.selected.add(e.target.value):state.selected.delete(e.target.value);$('#selected-count').textContent=state.selected.size;state.page=0;render()});$('#latest10').addEventListener('click',()=>{const ns=state.notes.filter(n=>n.gameId===gameId()).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')));state.selected=new Set(ns.slice(-10).map(n=>n.id));renderNoteList(ns);state.page=0;render()});$('#select-all').addEventListener('click',()=>{const ns=state.notes.filter(n=>n.gameId===gameId());state.selected=new Set(ns.map(n=>n.id));renderNoteList(ns);state.page=0;render()});$('#clear-all').addEventListener('click',()=>{const ns=state.notes.filter(n=>n.gameId===gameId());state.selected.clear();renderNoteList(ns);state.page=0;render()});$('#generate').addEventListener('click',()=>{state.page=0;render()});$('#print').addEventListener('click',()=>{renderPrint();window.print()});['book-title','kicker','intro','ending'].forEach(id=>$('#'+id).addEventListener('input',()=>{clearTimeout(state._t);state._t=setTimeout(render,180)}));$('#auth-btn').addEventListener('click',()=>{state.adminKey=$('#admin-key').value.trim();if(state.adminKey)sessionStorage.setItem('harfway-admin-key',state.adminKey);load()});document.addEventListener('keydown',e=>{if(/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName||''))return;if(e.key==='ArrowLeft')flip(state.page-1,'prev');if(e.key==='ArrowRight')flip(state.page+1,'next')});
  load();
})();
</script>
</body>
</html>
