  function buildMarkup(pages){
    const source=pages.map((html,i)=>`<div class="hw-minibook__source" data-page="${i+1}" hidden>${html}</div>`).join('');
    return `<div class="hw-minibook" data-hw-minibook>\n  <div class="hw-minibook__toolbar">\n    <button type="button" data-hw-view="single" aria-pressed="true">1ページ</button>\n    <button type="button" data-hw-view="spread" aria-pressed="false">見開き</button>\n    <button type="button" data-hw-fullscreen>全画面で読む</button>\n  </div>\n  <div class="hw-minibook__reader">\n    <div class="hw-minibook__book"></div>\n    <div class="hw-minibook__nav"><button type="button" data-hw-prev>← 前</button><div class="hw-minibook__progress"></div><button type="button" data-hw-next>次 →</button></div>\n    <div class="hw-minibook__help">長文はページ内スクロール · 1ページ時は左右ドラッグ / ← → でめくる</div>\n  </div>\n  <div hidden>${source}</div>\n</div>`;
  }
  function buildHtmlCss(pages){return `${exportCss()}\n${buildMarkup(pages)}`}
  function buildAll(pages){return `${buildHtmlCss(pages)}\n<script>${exportJs().replace(/<\\/script/gi,'<\\/script')}<\\/script>`}

  async function copyText(text){
    try{await navigator.clipboard.writeText(text);return true}catch{}
    const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();const ok=document.execCommand('copy');ta.remove();return ok;
  }
  async function preparePages(){
    const doc=await getReadyDoc();if(!doc)throw new Error('MINI BOOKの読み込みが完了していません');
    doc.querySelector('#refresh')?.click();await sleep(180);
    const result=publicPageHtml(doc);if(!result.pages.length)throw new Error('公開できるページがありません');
    return result;
  }
  async function copyBook(mode){
    const btn=mode==='html'?copyHtmlBtn:copyAllBtn;btn.disabled=true;status.textContent='本を生成しています…';
    try{
      const {pages,skipped}=await preparePages();
      const text=mode==='html'?buildHtmlCss(pages):buildAll(pages);
      if(/<h[1-6](\s|>)/i.test(text))throw new Error('Hタグが残っているため書き出しを停止しました');
      const ok=await copyText(text);if(!ok)throw new Error('クリップボードへコピーできませんでした');
      status.textContent=`${mode==='html'?'HTML+CSS':'一括HTML'}をコピーしました：${pages.length}ページ${skipped?` / private media ${skipped}ページは除外`:''}。`;
    }catch(err){status.textContent='失敗: '+(err?.message||err)}finally{btn.disabled=false}
  }
  copyHtmlBtn.addEventListener('click',()=>copyBook('html'));
  copyAllBtn.addEventListener('click',()=>copyBook('all'));
  copyJsBtn.addEventListener('click',async()=>{
    copyJsBtn.disabled=true;status.textContent='JSをコピーしています…';
    try{const ok=await copyText(exportJs());if(!ok)throw new Error('クリップボードへコピーできませんでした');status.textContent='JSだけコピーしました。共通JSとして1回読み込めば、ページ内の複数MINI BOOKを初期化できます。'}catch(err){status.textContent='失敗: '+(err?.message||err)}finally{copyJsBtn.disabled=false}
  });
})();
</script>
