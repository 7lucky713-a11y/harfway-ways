---
const title = 'MINI BOOK / WORDPRESS EXPORT V3';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title}</title>
  <style is:global>
    *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0d110f;color:#eef4ef;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}
    .bar{height:58px;display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid #2d3831;background:#111612}.bar b{font-size:12px;letter-spacing:.08em}.bar small{color:#87938a;font-size:10px}.bar .spacer{flex:1}.bar button,.bar a{border:1px solid #414f46;background:#171d19;color:#eef4ef;border-radius:8px;padding:9px 12px;font-size:11px;font-weight:850;text-decoration:none;cursor:pointer}.bar button.primary{background:#dff238;border-color:#dff238;color:#111610}.status{max-width:500px;color:#9ba79e;font-size:10px;line-height:1.45;text-align:right}.frame{width:100%;height:calc(100% - 58px);border:0;background:#0d110f}
    @media(max-width:900px){.bar{height:auto;min-height:58px;flex-wrap:wrap}.status{order:4;width:100%;max-width:none;text-align:left}.frame{height:calc(100% - 106px)}}
  </style>
</head>
<body>
  <div class="bar">
    <div><b>WORDPRESS EXPORT V3</b><br><small>HTML+CSS / JS分離 · 1ページ / 見開き / ページ内スクロール / Hタグなし</small></div>
    <div class="spacer"></div>
    <a href="/game-notes/minibook/" target="_blank" rel="noopener">MINI BOOKを別タブ</a>
    <button class="primary" id="copy-html">HTML+CSSをコピー</button>
    <button id="copy-js">JSだけコピー</button>
    <button id="copy-all">一括HTMLをコピー</button>
    <div class="status" id="status">本を編集してからHTML+CSSをコピーしてください。JSは共通コードです。</div>
  </div>
  <iframe class="frame" id="book-frame" src="/game-notes/minibook/" title="MINI BOOK"></iframe>
<script is:inline>
(()=>{
  const frame=document.getElementById('book-frame');
  const status=document.getElementById('status');
  const copyHtmlBtn=document.getElementById('copy-html');
  const copyJsBtn=document.getElementById('copy-js');
  const copyAllBtn=document.getElementById('copy-all');
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));

  function innerDocument(){
    try{
      const shell=frame.contentDocument;
      const inner=shell?.querySelector('#minibook-frame');
      return inner?.contentDocument||null;
    }catch{return null}
  }
  async function getReadyDoc(){
    for(let i=0;i<50;i++){
      const doc=innerDocument();
      if(doc?.querySelector('#print-stack')) return doc;
      await sleep(100);
    }
    return null;
  }

  const classMap={
    'book-page':'hw-mb-page','page-head':'hw-mb-page-head','page-title':'hw-mb-page-title','page-body':'hw-mb-page-body','page-foot':'hw-mb-page-foot',
    'cover-body':'hw-mb-cover-body','cover-kicker':'hw-mb-cover-kicker','cover-title':'hw-mb-cover-title','cover-sub':'hw-mb-cover-sub',
    'intro-body':'hw-mb-intro-body','run-main':'hw-mb-run-main','run-title':'hw-mb-run-title','run-quote':'hw-mb-run-quote','run-body':'hw-mb-run-body',
    'cont-mark':'hw-mb-cont-mark','run-cont':'hw-mb-run-cont','tags':'hw-mb-tags','tag':'hw-mb-tag','after-list':'hw-mb-after-list',
    'colophon-body':'hw-mb-colophon-body','media-page':'hw-mb-media-page','media-frame':'hw-mb-media-frame'
  };
  function replaceHeadingTags(root){
    root.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(old=>{
      const next=document.createElement('div');
      [...old.attributes].forEach(a=>next.setAttribute(a.name,a.value));
      next.innerHTML=old.innerHTML;
      old.replaceWith(next);
    });
  }
  function namespaceClasses(root){
    root.querySelectorAll('[class]').forEach(el=>{
      el.className=[...el.classList].map(n=>classMap[n]||n).filter(Boolean).join(' ');
    });
  }
  function publicPageHtml(doc){
    const nodes=[...doc.querySelectorAll('#print-stack .print-page')];
    const pages=[];let skipped=0;
    for(const node of nodes){
      if(node.querySelector('.blank-page')) continue;
      const clone=node.cloneNode(true);
      const privateMedia=[...clone.querySelectorAll('img[src*="/api/game-notes-media"],video[src*="/api/game-notes-media"]')];
      if(privateMedia.length){skipped++;continue}
      clone.querySelectorAll('img,video').forEach(el=>{
        const src=el.getAttribute('src');
        if(src){try{el.setAttribute('src',new URL(src,location.origin).href)}catch{}}
        if(el.tagName==='VIDEO'){el.setAttribute('controls','');el.setAttribute('playsinline','');el.removeAttribute('preload')}
      });
      replaceHeadingTags(clone);
      namespaceClasses(clone);
      const article=clone.querySelector('.hw-mb-page');
      if(article) pages.push(article.outerHTML);
    }
    return {pages,skipped};
  }

  function exportCss(){return `<style>
.hw-minibook,.hw-minibook *{box-sizing:border-box}
.hw-minibook{--hw-mb-paper:#f2efe6;--hw-mb-ink:#171916;--hw-mb-muted:#6e716b;--hw-mb-line:#c9c3b5;--hw-mb-ui:#111713;position:relative;width:100%;margin:36px 0;color:var(--hw-mb-ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;line-height:1.5}
.hw-minibook__toolbar{width:min(1380px,100%);margin:0 auto 10px;display:flex;align-items:center;justify-content:flex-end;gap:8px;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
.hw-minibook__toolbar button{appearance:none;border:1px solid #3c4941!important;background:#111713!important;color:#eef4ef!important;border-radius:999px!important;padding:8px 12px!important;margin:0!important;font-size:11px!important;line-height:1.2!important;font-weight:850!important;cursor:pointer!important;text-transform:none!important;letter-spacing:0!important;box-shadow:none!important}
.hw-minibook__toolbar button[aria-pressed="true"]{background:#eef4ef!important;color:#111610!important;border-color:#eef4ef!important}
.hw-minibook__toolbar button:disabled{opacity:.35!important;cursor:not-allowed!important}
.hw-minibook__reader{width:min(680px,100%);margin:0 auto;transition:width .22s ease}
.hw-minibook--spread .hw-minibook__reader{width:min(1380px,100%)}
.hw-minibook__book{position:relative;display:grid;grid-template-columns:1fr;gap:0;margin:0 auto;filter:drop-shadow(0 18px 48px rgba(0,0,0,.18))}
.hw-minibook--spread .hw-minibook__book{grid-template-columns:1fr 1fr;max-width:1360px}
.hw-minibook__slot{position:relative;aspect-ratio:182/257;min-width:0;overflow:hidden;background:var(--hw-mb-paper);border:1px solid #c8c2b5;isolation:isolate}
.hw-minibook--spread .hw-minibook__slot--left{border-right:0;box-shadow:inset -14px 0 18px -18px rgba(0,0,0,.55)}
.hw-minibook--spread .hw-minibook__slot--right{border-left:1px solid #aaa497;box-shadow:inset 14px 0 18px -18px rgba(0,0,0,.55)}
.hw-minibook__slot--blank{background:#e8e3d8}
.hw-minibook__scroll{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;scrollbar-gutter:stable;scrollbar-width:thin;scrollbar-color:#9b9589 transparent;-webkit-overflow-scrolling:touch}
.hw-minibook__scroll::-webkit-scrollbar{width:7px}.hw-minibook__scroll::-webkit-scrollbar-thumb{background:#9b9589;border-radius:999px}.hw-minibook__scroll::-webkit-scrollbar-track{background:transparent}
.hw-minibook__scroll>.hw-mb-page{height:auto!important;min-height:100%!important}
.hw-minibook__curl-under,.hw-minibook__curl-current,.hw-minibook__curl-fold,.hw-minibook__curl-shadow{position:absolute;inset:0}.hw-minibook__curl-under{z-index:1}.hw-minibook__curl-current{z-index:4;overflow:hidden}.hw-minibook__curl-fold{z-index:6;width:1px;right:auto;pointer-events:none;overflow:visible;transform-style:preserve-3d}.hw-minibook__curl-shadow{z-index:3;width:24%;opacity:0;pointer-events:none;background:linear-gradient(90deg,transparent,rgba(0,0,0,.18),rgba(0,0,0,.03),transparent);filter:blur(5px)}
.hw-minibook__curl-fold:before{content:"";position:absolute;top:0;bottom:0;left:50%;width:100%;transform:translateX(-50%);background:linear-gradient(90deg,rgba(40,37,32,.26),rgba(239,235,224,.96) 16%,rgba(251,248,238,.98) 46%,rgba(212,205,191,.94) 80%,rgba(70,65,57,.16));box-shadow:0 0 16px rgba(0,0,0,.10)}
.hw-minibook .hw-mb-page{width:100%;padding:7.2% 8.8%;display:flex;flex-direction:column;background:var(--hw-mb-paper);margin:0;color:var(--hw-mb-ink);border:0}
.hw-minibook .hw-mb-page-head{display:flex;justify-content:space-between;gap:16px;padding-bottom:11px;border-bottom:1px solid var(--hw-mb-line);font:900 9px ui-monospace,monospace;letter-spacing:.13em;color:var(--hw-mb-muted)}
.hw-minibook .hw-mb-page-title{margin:30px 0 20px;font-size:clamp(29px,3.1vw,43px);font-weight:700;line-height:1.12;letter-spacing:-.045em;max-width:16ch;color:var(--hw-mb-ink)}
.hw-minibook .hw-mb-page-body{white-space:pre-wrap;font-size:15px;line-height:2;max-width:39em;overflow-wrap:anywhere}
.hw-minibook .hw-mb-page-foot{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:auto;padding-top:16px;border-top:1px solid var(--hw-mb-line);font:800 9px ui-monospace,monospace;color:#777a74;letter-spacing:.07em}
.hw-minibook .hw-mb-cover-body{display:flex;flex:1;flex-direction:column;justify-content:center}.hw-minibook .hw-mb-cover-kicker{font:900 10px ui-monospace,monospace;letter-spacing:.16em;color:var(--hw-mb-muted)}.hw-minibook .hw-mb-cover-title{margin:20px 0 18px;font-size:clamp(42px,4.8vw,66px);font-weight:700;line-height:.98;letter-spacing:-.062em;max-width:10ch;color:var(--hw-mb-ink)}.hw-minibook .hw-mb-cover-sub{max-width:31em;font-size:16px;line-height:1.9;color:var(--hw-mb-muted)}
.hw-minibook .hw-mb-intro-body{margin-top:28px}.hw-minibook .hw-mb-intro-body .hw-mb-page-body{font-size:18px;line-height:2.05}
.hw-minibook .hw-mb-run-main{min-height:0}.hw-minibook .hw-mb-run-title{margin:30px 0 20px;font-size:clamp(30px,3.2vw,44px);font-weight:700;line-height:1.12;letter-spacing:-.045em;max-width:15ch;color:var(--hw-mb-ink)}.hw-minibook .hw-mb-run-quote{margin:0;padding:17px 0;border-top:3px solid var(--hw-mb-ink);border-bottom:1px solid var(--hw-mb-line);font-size:clamp(20px,2vw,25px);line-height:1.65;font-weight:700}.hw-minibook .hw-mb-run-body{margin-top:22px;white-space:pre-wrap;font-size:15px;line-height:2;max-width:39em;overflow-wrap:anywhere}.hw-minibook .hw-mb-cont-mark{display:inline-block;margin-top:18px;border-top:1px solid var(--hw-mb-line);padding-top:11px;font:800 9px ui-monospace,monospace;letter-spacing:.15em;color:var(--hw-mb-muted)}.hw-minibook .hw-mb-run-cont .hw-mb-run-title{margin-top:16px;font-size:20px;color:var(--hw-mb-muted);letter-spacing:-.02em}.hw-minibook .hw-mb-run-cont .hw-mb-run-body{margin-top:28px}
.hw-minibook .hw-mb-tags{display:flex;gap:5px;flex-wrap:wrap}.hw-minibook .hw-mb-tag{border:1px solid #aaa497;border-radius:999px;padding:4px 7px;font:700 8px ui-monospace,monospace;color:#595e57}.hw-minibook .hw-mb-after-list{margin:28px 0 0;padding-left:1.1em;display:grid;gap:13px;font-size:16px;line-height:1.8;max-width:37em}.hw-minibook .hw-mb-colophon-body{margin-top:28px}
.hw-minibook .hw-mb-media-page{padding:6% 7%}.hw-minibook .hw-mb-media-frame{flex:1;min-height:0;margin:18px 0;display:grid;place-items:center;background:#e5e0d4;overflow:hidden}.hw-minibook .hw-mb-media-frame img,.hw-minibook .hw-mb-media-frame video{width:100%;height:100%;display:block;object-fit:contain}
.hw-minibook__nav{display:grid;grid-template-columns:88px 1fr 88px;gap:10px;align-items:center;margin-top:14px;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}.hw-minibook__nav button{appearance:none;border:1px solid #3d463f!important;background:#161b18!important;color:#eef4ef!important;border-radius:999px!important;padding:9px 11px!important;margin:0!important;font-size:11px!important;line-height:1.2!important;font-weight:850!important;cursor:pointer!important;text-transform:none!important;letter-spacing:0!important;box-shadow:none!important}.hw-minibook__nav button:disabled{opacity:.28!important;cursor:default!important}.hw-minibook__progress{text-align:center;color:#707a73;font:800 10px ui-monospace,monospace;letter-spacing:.08em}.hw-minibook__help{text-align:center;margin-top:7px;color:#858e87;font-size:10px;font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
.hw-minibook:fullscreen,.hw-minibook.hw-minibook--fullscreen{margin:0!important;padding:16px!important;position:fixed!important;inset:0!important;z-index:2147483000!important;width:100vw!important;height:100vh!important;max-width:none!important;background:#0d110f!important;overflow:auto!important;display:flex!important;flex-direction:column!important;justify-content:center!important}
.hw-minibook:fullscreen .hw-minibook__reader,.hw-minibook.hw-minibook--fullscreen .hw-minibook__reader{width:min(86vw,calc(78vh * 182 / 257),860px)}
.hw-minibook--spread:fullscreen .hw-minibook__reader,.hw-minibook--spread.hw-minibook--fullscreen .hw-minibook__reader{width:min(94vw,calc(78vh * 364 / 257),1500px)}
.hw-minibook:fullscreen .hw-minibook__toolbar,.hw-minibook.hw-minibook--fullscreen .hw-minibook__toolbar{width:min(94vw,1500px)}
@media(max-width:760px){.hw-minibook{margin:22px 0}.hw-minibook--spread .hw-minibook__reader{width:min(680px,100%)}.hw-minibook--spread .hw-minibook__book{grid-template-columns:1fr}.hw-minibook--spread .hw-minibook__slot--left{display:none}.hw-minibook .hw-mb-page{padding:7.2% 8.8%}.hw-minibook .hw-mb-cover-title{font-size:38px}.hw-minibook .hw-mb-page-title,.hw-minibook .hw-mb-run-title{margin-top:22px;font-size:27px}.hw-minibook .hw-mb-run-cont .hw-mb-run-title{font-size:16px}.hw-minibook .hw-mb-run-quote{font-size:16px;padding:12px 0}.hw-minibook .hw-mb-page-body,.hw-minibook .hw-mb-run-body{font-size:11px;line-height:1.72}.hw-minibook .hw-mb-intro-body .hw-mb-page-body{font-size:13px;line-height:1.85}.hw-minibook__nav{grid-template-columns:70px 1fr 70px}.hw-minibook:fullscreen,.hw-minibook.hw-minibook--fullscreen{padding:8px!important}.hw-minibook:fullscreen .hw-minibook__reader,.hw-minibook.hw-minibook--fullscreen .hw-minibook__reader,.hw-minibook--spread:fullscreen .hw-minibook__reader,.hw-minibook--spread.hw-minibook--fullscreen .hw-minibook__reader{width:min(96vw,calc(82vh * 182 / 257))}}
</style>`}

  function exportJs(){return `(function(){
function initMiniBook(root){
if(!root||root.dataset.hwMiniBookReady==='1')return;root.dataset.hwMiniBookReady='1';
var pages=[].slice.call(root.querySelectorAll('.hw-minibook__source'));var book=root.querySelector('.hw-minibook__book'),progress=root.querySelector('.hw-minibook__progress'),prev=root.querySelector('[data-hw-prev]'),next=root.querySelector('[data-hw-next]'),singleBtn=root.querySelector('[data-hw-view="single"]'),spreadBtn=root.querySelector('[data-hw-view="spread"]'),fullBtn=root.querySelector('[data-hw-fullscreen]');if(!pages.length||!book||!progress||!prev||!next||!singleBtn||!spreadBtn||!fullBtn)return;var index=0,mode='single',anim=false,drag=null,fallback=false;
function page(i){return pages[i]?pages[i].innerHTML:''}function scrollPage(i,extra){return '<div class="hw-minibook__scroll" data-hw-scroll '+(extra||'')+'>'+page(i)+'</div>'}function blank(){return '<div class="hw-minibook__slot hw-minibook__slot--left hw-minibook__slot--blank"></div>'}
function isNarrow(){return window.matchMedia('(max-width:760px)').matches}function spreadStart(i){if(i<=0)return 0;return i%2===0?i-1:i}
function setMode(nextMode){if(nextMode==='spread'&&isNarrow())nextMode='single';mode=nextMode;index=mode==='spread'?spreadStart(index):index;root.classList.toggle('hw-minibook--spread',mode==='spread');singleBtn.setAttribute('aria-pressed',String(mode==='single'));spreadBtn.setAttribute('aria-pressed',String(mode==='spread'));spreadBtn.disabled=isNarrow();render()}
function chrome(){var shown;if(mode==='spread'){shown=index===0?'1':Math.min(index+1,pages.length)+'–'+Math.min(index+2,pages.length);progress.textContent='B5 · PAGE '+shown+' / '+pages.length}else progress.textContent='B5 · PAGE '+(index+1)+' / '+pages.length;prev.disabled=index<=0;next.disabled=mode==='spread'?(index===0?pages.length<=1:index+2>=pages.length):index>=pages.length-1}
function renderSingle(){book.innerHTML='<div class="hw-minibook__slot hw-minibook__slot--right" data-hw-single>'+scrollPage(index)+'</div>'}function renderSpread(){if(index===0){book.innerHTML=blank()+'<div class="hw-minibook__slot hw-minibook__slot--right">'+scrollPage(0)+'</div>';return}var left=index,right=index+1;book.innerHTML='<div class="hw-minibook__slot hw-minibook__slot--left">'+scrollPage(left)+'</div><div class="hw-minibook__slot hw-minibook__slot--right">'+(right<pages.length?scrollPage(right):'')+'</div>'}
function render(){if(mode==='spread'&&isNarrow()){mode='single';root.classList.remove('hw-minibook--spread');singleBtn.setAttribute('aria-pressed','true');spreadBtn.setAttribute('aria-pressed','false')}if(mode==='spread')renderSpread();else renderSingle();chrome();book.querySelectorAll('[data-hw-scroll]').forEach(function(el){el.scrollTop=0})}
function ease(t){return .5-Math.cos(Math.PI*Math.max(0,Math.min(1,t)))/2}function apply(slot,p,dir){var cur=slot.querySelector('.hw-minibook__curl-current'),fold=slot.querySelector('.hw-minibook__curl-fold'),shadow=slot.querySelector('.hw-minibook__curl-shadow');if(!cur||!fold||!shadow)return;var wave=Math.sin(Math.PI*p),w=4+17*wave,a=(dir==='next'?-1:1)*(8+70*wave),x;if(dir==='next'){x=(1-p)*100;cur.style.clipPath='inset(0 '+(p*100)+'% 0 0)'}else{x=p*100;cur.style.clipPath='inset(0 0 0 '+(p*100)+'%)'}fold.style.left=x+'%';shadow.style.left=x+'%';fold.style.width=w+'%';fold.style.transform='translateX(-50%) perspective(900px) rotateY('+a+'deg)';fold.style.opacity=Math.min(1,.22+wave*1.15);shadow.style.opacity=.04+wave*.34}
function prepSingle(target,dir){var slot=book.querySelector('[data-hw-single]');if(!slot)return null;slot.innerHTML='<div class="hw-minibook__curl-under">'+scrollPage(target)+'</div><div class="hw-minibook__curl-current">'+scrollPage(index)+'</div><div class="hw-minibook__curl-shadow"></div><div class="hw-minibook__curl-fold"></div>';apply(slot,0,dir);return slot}function tween(slot,from,to,dir,ms,done){var start=performance.now(),d=to-from;function tick(now){var r=Math.min(1,(now-start)/ms);apply(slot,from+d*ease(r),dir);if(r<1)requestAnimationFrame(tick);else done()}requestAnimationFrame(tick)}function turnSingle(target,dir){if(anim||target<0||target>=pages.length||target===index)return;anim=true;var slot=prepSingle(target,dir);if(!slot){index=target;anim=false;render();return}tween(slot,0,1,dir,620,function(){index=target;anim=false;render()})}
function nextIndex(){if(mode==='single')return Math.min(pages.length-1,index+1);return index===0?1:Math.min(pages.length-1,index+2)}function prevIndex(){if(mode==='single')return Math.max(0,index-1);return index<=1?0:Math.max(1,index-2)}function navigate(dir){var target=dir==='next'?nextIndex():prevIndex();if(target===index)return;if(mode==='single')turnSingle(target,dir);else{index=target;render()}}
prev.addEventListener('click',function(){navigate('prev')});next.addEventListener('click',function(){navigate('next')});singleBtn.addEventListener('click',function(){setMode('single')});spreadBtn.addEventListener('click',function(){setMode('spread')});
book.addEventListener('pointerdown',function(e){if(mode!=='single'||anim||e.target.closest('.hw-minibook__scroll')&&e.pointerType==='mouse'&&e.button!==0)return;var slot=book.querySelector('[data-hw-single]');if(!slot)return;drag={id:e.pointerId,start:e.clientX,w:slot.getBoundingClientRect().width,active:false,dir:null,target:null,p:0};slot.setPointerCapture&&slot.setPointerCapture(e.pointerId)});book.addEventListener('pointermove',function(e){if(!drag||drag.id!==e.pointerId||anim)return;var dx=e.clientX-drag.start;if(!drag.active){if(Math.abs(dx)<9)return;drag.dir=dx<0?'next':'prev';drag.target=drag.dir==='next'?index+1:index-1;if(drag.target<0||drag.target>=pages.length){drag=null;return}drag.active=true;prepSingle(drag.target,drag.dir)}var slot=book.querySelector('[data-hw-single]');if(!slot)return;drag.p=Math.max(0,Math.min(1,(drag.dir==='next'?-dx:dx)/(drag.w||1)));apply(slot,drag.p,drag.dir);e.preventDefault()});book.addEventListener('pointerup',function(e){if(!drag||drag.id!==e.pointerId)return;if(!drag.active){drag=null;return}var d=drag,slot=book.querySelector('[data-hw-single]');drag=null;anim=true;var commit=d.p>.2;tween(slot,d.p,commit?1:0,d.dir,260+Math.round(360*Math.abs((commit?1:0)-d.p)),function(){if(commit)index=d.target;anim=false;render()})});
function updateFullLabel(){var active=document.fullscreenElement===root||fallback;fullBtn.textContent=active?'全画面を閉じる':'全画面で読む'}function closeFallback(){if(!fallback)return;fallback=false;root.classList.remove('hw-minibook--fullscreen');document.body.style.overflow='';updateFullLabel()}
fullBtn.addEventListener('click',async function(){if(document.fullscreenElement===root){try{await document.exitFullscreen()}catch(e){}return}if(fallback){closeFallback();return}if(root.requestFullscreen){try{await root.requestFullscreen();return}catch(e){}}fallback=true;root.classList.add('hw-minibook--fullscreen');document.body.style.overflow='hidden';updateFullLabel()});document.addEventListener('fullscreenchange',updateFullLabel);document.addEventListener('keydown',function(e){if(e.key==='Escape'&&fallback){closeFallback();return}if(e.target&&/INPUT|TEXTAREA|SELECT/.test(e.target.tagName))return;if(e.key==='ArrowLeft')navigate('prev');if(e.key==='ArrowRight')navigate('next')});window.addEventListener('resize',function(){spreadBtn.disabled=isNarrow();if(isNarrow()&&mode==='spread')setMode('single')});setMode('single');updateFullLabel();
}
function initAllMiniBooks(){document.querySelectorAll('.hw-minibook').forEach(initMiniBook)}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initAllMiniBooks);else initAllMiniBooks();
