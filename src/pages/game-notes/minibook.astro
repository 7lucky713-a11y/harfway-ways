---
const title = 'MINI BOOK GENERATOR';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>{title}</title>
  <style is:global>
    :root{--bg:#0d110f;--panel:#151a17;--line:#2d3831;--line2:#414f46;--text:#eef4ef;--muted:#8e9a91;--accent:#dff238;--ink:#111610}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}.app{min-height:100vh}.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 20px;border-bottom:1px solid var(--line);background:#0d110ff2;backdrop-filter:blur(12px)}.top a{color:var(--muted);text-decoration:none;font-size:12px;font-weight:800}.top small{color:#68756c}.top b{font-size:12px;letter-spacing:.12em}.layout{display:grid;grid-template-columns:minmax(320px,410px) minmax(0,1fr);min-height:calc(100vh - 57px)}.tools{border-right:1px solid var(--line);padding:22px;overflow:auto}.preview{padding:24px;overflow:auto;display:grid;align-items:start}.eyebrow{font:800 10px ui-monospace,monospace;letter-spacing:.14em;color:var(--accent);margin-bottom:7px}.tools h1{margin:0 0 7px;font-size:29px;letter-spacing:-.04em}.tools>p{margin:0 0 20px;color:var(--muted);font-size:13px;line-height:1.75}.group{padding:14px 0;border-top:1px solid var(--line)}.group:first-of-type{border-top:0}.group label,.group-title{display:block;margin-bottom:8px;font-size:11px;font-weight:850;color:#b1bcb3}.group input,.group select,.group textarea{width:100%;border:1px solid var(--line2);background:#101511;color:var(--text);border-radius:8px;padding:10px 11px;font-size:14px;outline:none}.group textarea{min-height:80px;line-height:1.6;resize:vertical}.row{display:flex;gap:8px}.row>*{flex:1}.btn{border:1px solid var(--line2);background:#161c18;color:var(--text);border-radius:8px;padding:10px 11px;font-size:12px;font-weight:850;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--ink)}.btn:disabled{opacity:.4;cursor:not-allowed}.note-actions{display:flex;gap:7px;margin-bottom:8px}.note-list{display:grid;gap:6px;max-height:300px;overflow:auto;padding-right:2px}.note-item{display:grid;grid-template-columns:auto 1fr;gap:8px;padding:9px;border:1px solid var(--line);border-radius:8px;background:#111612}.note-item input{width:auto;margin-top:3px}.note-item b{display:block;font-size:12px;line-height:1.4}.note-item small{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.45}.status{display:none;margin-bottom:13px;padding:11px;border:1px solid #745151;background:#261818;border-radius:8px;color:#e6baba;font-size:12px;line-height:1.6}.status.on{display:block}.status .auth-row{display:flex;gap:8px;margin-top:8px}.status input{flex:1;border:1px solid #684747;background:#120d0d;color:#fff;border-radius:7px;padding:9px}.html-output{display:none;margin-top:12px}.html-output.on{display:block}.html-output textarea{min-height:180px;font:11px/1.45 ui-monospace,monospace}.count{color:var(--accent);font-weight:900}.empty{min-height:65vh;display:grid;place-items:center;border:1px dashed var(--line2);border-radius:16px;color:var(--muted);text-align:center;padding:28px}.hint{margin-top:8px;color:#6d796f;font-size:10px;line-height:1.6}

    .hwmb-reader{--paper:#f2efe6;--paper2:#e9e4d7;--book-ink:#171916;--book-muted:#6e716b;--book-line:#c9c3b5;--book-accent:#161b17;width:min(760px,100%);margin:0 auto;color:var(--book-ink);font-family:"Hiragino Mincho ProN","Yu Mincho",serif;touch-action:pan-y}.hwmb-reader *{box-sizing:border-box}.hwmb-shell{position:relative;perspective:1600px}.hwmb-page{position:relative;min-height:min(78vh,820px);background:var(--paper);border:1px solid #c8c2b5;box-shadow:0 22px 65px #0008;overflow:hidden;transform-origin:left center;backface-visibility:hidden}.hwmb-page.is-flipping-next{animation:hwmbFlipNext .38s ease-in both}.hwmb-page.is-flipping-prev{animation:hwmbFlipPrev .34s ease-out both}@keyframes hwmbFlipNext{0%{transform:rotateY(0);opacity:1}60%{opacity:.78}100%{transform:rotateY(-88deg);opacity:.15}}@keyframes hwmbFlipPrev{0%{transform:rotateY(-72deg);opacity:.2}100%{transform:rotateY(0);opacity:1}}.hwmb-corner{position:absolute;top:0;bottom:0;width:14%;z-index:4;border:0;background:transparent;cursor:pointer}.hwmb-corner.prev{left:0}.hwmb-corner.next{right:0}.hwmb-corner:focus-visible{outline:2px solid #111;outline-offset:-5px}.hwmb-cover,.hwmb-intro,.hwmb-run,.hwmb-after,.hwmb-colophon{min-height:min(78vh,820px);padding:clamp(36px,6vw,66px);display:flex;flex-direction:column}.hwmb-cover{justify-content:space-between;background:linear-gradient(145deg,#e8e3d7,#f6f3eb)}.hwmb-kicker{font:900 10px/1.4 ui-monospace,monospace;letter-spacing:.17em;text-transform:uppercase}.hwmb-cover h1{margin:18px 0 14px;font-size:clamp(42px,8vw,78px);line-height:.98;letter-spacing:-.065em;max-width:9ch}.hwmb-cover p{max-width:31em;margin:0;font-size:16px;line-height:1.9;color:var(--book-muted)}.hwmb-cover-foot{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;font:800 10px/1.5 ui-monospace,monospace;letter-spacing:.1em}.hwmb-intro{justify-content:center}.hwmb-intro small,.hwmb-after small,.hwmb-colophon small{font:900 10px ui-monospace,monospace;letter-spacing:.14em;color:var(--book-muted)}.hwmb-intro p{max-width:34em;margin:20px 0 0;font-size:19px;line-height:2.05}.hwmb-run{justify-content:space-between}.hwmb-run-top{display:flex;justify-content:space-between;gap:16px;font:900 10px ui-monospace,monospace;letter-spacing:.13em}.hwmb-run-date{color:var(--book-muted);letter-spacing:.04em}.hwmb-run h2{margin:38px 0 22px;font-size:clamp(30px,5vw,48px);line-height:1.12;letter-spacing:-.045em;max-width:14ch}.hwmb-quote{margin:0;padding:18px 0;border-top:3px solid var(--book-accent);border-bottom:1px solid var(--book-line);font-size:clamp(20px,3vw,27px);line-height:1.65;font-weight:700}.hwmb-body{margin-top:24px;white-space:pre-wrap;font-size:15px;line-height:2;max-width:39em}.hwmb-footer{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-top:30px}.hwmb-tags{display:flex;gap:5px;flex-wrap:wrap}.hwmb-tag{border:1px solid #aaa497;border-radius:999px;padding:4px 7px;font:700 8px ui-monospace,monospace;color:#595e57}.hwmb-pageno{font:800 9px ui-monospace,monospace;color:#777a74}.hwmb-after{justify-content:center;background:var(--book-accent);color:#f2f3ed}.hwmb-after small{color:#aeb7b0}.hwmb-after h2{margin:10px 0 26px;font-size:38px;letter-spacing:-.045em}.hwmb-after ul{margin:0;padding-left:1.15em;display:grid;gap:12px;max-width:38em;font-size:16px;line-height:1.75}.hwmb-colophon{justify-content:space-between;background:var(--paper2)}.hwmb-colophon h2{font-size:34px;margin:12px 0 20px;letter-spacing:-.04em}.hwmb-colophon p{max-width:34em;font-size:16px;line-height:1.9}.hwmb-reader-nav{display:grid;grid-template-columns:88px 1fr 88px;gap:10px;align-items:center;margin-top:14px}.hwmb-reader-nav button{border:1px solid #3c4941;background:#111713;color:#e9efea;border-radius:999px;padding:9px 11px;font-size:11px;font-weight:850;cursor:pointer}.hwmb-reader-nav button:disabled{opacity:.28;cursor:default}.hwmb-progress{text-align:center;color:#a5b0a7;font:800 10px ui-monospace,monospace;letter-spacing:.09em}.hwmb-dots{display:flex;justify-content:center;gap:4px;margin-top:9px;flex-wrap:wrap}.hwmb-dot{width:5px;height:5px;border-radius:99px;background:#3c4941}.hwmb-dot.on{background:#dff238}.hwmb-reader-help{text-align:center;margin-top:8px;color:#69766d;font-size:10px}.hwmb-page:hover .hwmb-edge{opacity:1}.hwmb-edge{position:absolute;top:50%;transform:translateY(-50%);z-index:3;opacity:.15;font:900 18px ui-monospace,monospace;pointer-events:none;transition:.2s}.hwmb-edge.left{left:14px}.hwmb-edge.right{right:14px}
    @media(max-width:900px){.layout{grid-template-columns:1fr}.tools{border-right:0;border-bottom:1px solid var(--line)}.preview{padding:12px}.note-list{max-height:260px}.hwmb-page,.hwmb-cover,.hwmb-intro,.hwmb-run,.hwmb-after,.hwmb-colophon{min-height:70svh}.hwmb-reader-nav{grid-template-columns:76px 1fr 76px}.hwmb-corner{width:20%}}
    @media(max-width:560px){.tools{padding:17px}.preview{padding:7px}.hwmb-page{border-radius:0}.hwmb-cover,.hwmb-intro,.hwmb-run,.hwmb-after,.hwmb-colophon{padding:30px 24px;min-height:72svh}.hwmb-cover h1{font-size:46px}.hwmb-run h2{margin-top:28px;font-size:32px}.hwmb-quote{font-size:20px}.hwmb-body{font-size:14px;line-height:1.9}.hwmb-reader-help{font-size:9px}}
    @media(prefers-reduced-motion:reduce){.hwmb-page.is-flipping-next,.hwmb-page.is-flipping-prev{animation:none}}
  </style>
</head>
<body>
<div class="app">
  <header class="top"><div><a href="/game-notes/">← GAME NOTES</a> <small>/ MINI BOOK</small></div><b>MINI BOOK / PAGE READER</b></header>
  <div class="layout">
    <aside class="tools">
      <div class="eyebrow">GAME NOTES → GAME FRAGMENTS</div>
      <h1>MINI BOOK</h1>
      <p>プレイ記録を「記事」に整えすぎず、小冊子のページとして並べます。PCは左右クリック・← →、スマホは左右スワイプでページをめくれます。</p>
      <div class="status" id="status"><span id="status-text"></span><div class="auth-row" id="auth-row"><input id="admin-key" type="password" placeholder="HARF-WAY管理キー" /><button class="btn" id="auth-btn">再接続</button></div></div>
      <div class="group"><label>GAME</label><select id="game"></select></div>
      <div class="group">
        <div class="group-title">RECORDS <span class="count" id="selected-count">0</span></div>
        <div class="note-actions"><button class="btn" id="latest10">最新10件</button><button class="btn" id="select-all">すべて</button><button class="btn" id="clear-all">解除</button></div>
        <div class="note-list" id="notes"></div>
      </div>
      <div class="group"><label>本文</label><select id="density"><option value="raw" selected>GAME NOTES原文を全文表示</option></select><div class="hint">本文は省略・要約せず、そのまま紙面に載せます。</div></div>
      <div class="group"><label>BOOK TITLE</label><input id="book-title" /></div>
      <div class="group"><label>KICKER</label><input id="kicker" value="GAME FRAGMENTS / PLAY NOTES" /></div>
      <div class="group"><label>INTRO</label><textarea id="intro"></textarea></div>
      <div class="group"><label>ENDING NOTE</label><textarea id="ending"></textarea></div>
      <div class="group">
        <div class="row"><button class="btn primary" id="generate">BOOKを更新</button><button class="btn" id="copy">WordPress HTMLをコピー</button></div>
        <div class="row" style="margin-top:8px"><button class="btn" id="toggle-html">HTMLを表示</button></div>
        <div class="html-output" id="html-output"><textarea id="html" readonly></textarea></div>
      </div>
    </aside>
    <main class="preview"><div id="book"><div class="empty">GAME NOTESを読み込み中…</div></div></main>
  </div>
</div>
<script is:inline>
(() => {
  const state={games:[],notes:[],facets:[],selected:new Set(),adminKey:sessionStorage.getItem('harfway_game_notes_key')||'',pages:[],page:0,exportHtml:'',touchX:null};
  const $=s=>document.querySelector(s);
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const plain=v=>String(v??'').replace(/\s+/g,' ').trim();
  const fmtDate=v=>{try{return new Intl.DateTimeFormat('ja-JP',{year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(v))}catch{return''}};
  const gameById=id=>state.games.find(g=>g.id===id);
  const facetById=id=>state.facets.find(f=>f.id===id);
  const currentGameId=()=>$('#game').value;
  const gameNotes=()=>state.notes.filter(n=>n.gameId===currentGameId()).sort((a,b)=>String(a.createdAt||a.updatedAt||'').localeCompare(String(b.createdAt||b.updatedAt||'')));
  const chosenNotes=()=>gameNotes().filter(n=>state.selected.has(n.id));

  function showStatus(message,auth=false){$('#status-text').textContent=message;$('#status').classList.toggle('on',Boolean(message));$('#auth-row').style.display=auth?'flex':'none'}
  async function load(){
    showStatus('GAME NOTESを読み込んでいます…');
    const headers=state.adminKey?{'x-admin-key':state.adminKey}:{};
    const res=await fetch('/api/game-notes',{headers,cache:'no-store'});const data=await res.json().catch(()=>({}));
    if(res.status===401){showStatus('管理キーを入力するとGAME NOTESを読み込めます。',true);$('#book').innerHTML='<div class="empty">GAME NOTESへの認証が必要です。</div>';return}
    if(!res.ok){showStatus(`読み込みに失敗しました: ${data.error||res.status}`);return}
    state.games=data.games||[];state.notes=data.notes||[];state.facets=data.facets||[];showStatus('');renderGames();
  }
  function renderGames(){const sel=$('#game');sel.innerHTML=state.games.map(g=>`<option value="${esc(g.id)}">${esc(g.name)}</option>`).join('');const mt=state.games.find(g=>/モンスタートレイン/i.test(g.name));if(mt)sel.value=mt.id;onGameChange()}
  function onGameChange(){state.selected.clear();const list=gameNotes();list.slice(-Math.min(10,list.length)).forEach(n=>state.selected.add(n.id));const g=gameById(currentGameId());const count=state.selected.size||list.length;$('#book-title').value=g?`${g.name} / ${count||10} RUNS`:'PLAY NOTES';$('#intro').value=g?`${g.name}を遊びながら残したメモ。迷ったこと、試したこと、分からなかったことを、あとから整えすぎずに眺め直すための小さな記録。`:'';$('#ending').value='まだ結論は出ていない。次のプレイで、また見え方が変わるかもしれない。';renderNoteList();generate()}
  function renderNoteList(){const list=gameNotes();$('#notes').innerHTML=list.length?list.map((n,i)=>`<label class="note-item"><input type="checkbox" data-note="${esc(n.id)}" ${state.selected.has(n.id)?'checked':''}><span><b>${esc(n.title||`記録 ${i+1}`)}</b><small>${esc(fmtDate(n.createdAt||n.updatedAt))} · ${esc(plain(n.body).slice(0,58))}${plain(n.body).length>58?'…':''}</small></span></label>`).join(''):'<div class="empty" style="min-height:110px">このゲームの記録はまだありません。</div>';$('#selected-count').textContent=state.selected.size}
  function runNumber(note,index){const m=String(note.title||'').match(/(?:第\s*)?(\d+)\s*(?:回|run)/i);return m?Number(m[1]):index+1}
  function sentences(body){return String(body||'').replace(/\r/g,'').split(/(?<=[。！？!?])|\n+/).map(plain).filter(s=>s.length>=5)}
  function scoreSentence(s){let n=Math.min(4,s.length/38);if(/[！？!?]/.test(s))n+=2;if(/強|弱|勝|負|死|難|面白|笑|最強|わから|分から|気づ|重要|相性|ボコ|クリア|撃破|終わ/.test(s))n+=2;if(/かも|だろう|気が|思う|っぽい/.test(s))n+=1;return n}
  function quoteOf(note){const ss=sentences(note.body);return ss.sort((a,b)=>scoreSentence(b)-scoreSentence(a))[0]||plain(note.body).slice(0,100)}
  function bodyOf(note){return String(note.body||'').trim()}
  function tagsOf(note){const out=[];for(const [id,values] of Object.entries(note.facets||{})){const name=facetById(id)?.name||'';for(const value of values||[]){if(!value||['なし'].includes(value))continue;out.push(name?`${name}: ${value}`:value)}}return [...new Set(out)].slice(0,6)}
  function lateInsights(notes){const pool=notes.slice(Math.max(0,Math.floor(notes.length*.45))).flatMap(n=>sentences(n.body));const scored=pool.map(s=>[s,scoreSentence(s)+( /役割|相乗|回転率|中途半端|コア|デバフ|タンク|後列|カード/.test(s)?2:0)]).sort((a,b)=>b[1]-a[1]);const out=[];for(const [s] of scored){if(out.some(x=>x.includes(s.slice(0,12))||s.includes(x.slice(0,12))))continue;out.push(s);if(out.length>=4)break}return out}
  function pageFrame(inner,index,total,type=''){return `<section class="hwmb-page ${type}" data-page-index="${index}"><button class="hwmb-corner prev" type="button" aria-label="前のページ"></button><span class="hwmb-edge left">‹</span>${inner}<span class="hwmb-edge right">›</span><button class="hwmb-corner next" type="button" aria-label="次のページ"></button></section>`}
  function buildPages(){
    const notes=chosenNotes();const g=gameById(currentGameId());const title=$('#book-title').value.trim()||(g?.name||'PLAY NOTES');const kicker=$('#kicker').value.trim();const intro=$('#intro').value.trim();const ending=$('#ending').value.trim();const raw=[];
    raw.push({type:'cover',html:`<div class="hwmb-cover"><div><div class="hwmb-kicker">${esc(kicker)}</div><h1>${esc(title)}</h1><p>${esc(g?.name||'')}</p></div><div class="hwmb-cover-foot"><span>HARF-WAY</span><span>${notes.length} FRAGMENTS</span></div></div>`});
    if(intro)raw.push({type:'intro',html:`<div class="hwmb-intro"><small>BEFORE READING</small><p>${esc(intro)}</p></div>`});
    notes.forEach((n,i)=>{const run=runNumber(n,i);const quote=quoteOf(n);const body=bodyOf(n);const tags=tagsOf(n);raw.push({type:'run',html:`<article class="hwmb-run"><div><div class="hwmb-run-top"><span>RUN ${String(run).padStart(2,'0')}</span><span class="hwmb-run-date">${esc(fmtDate(n.createdAt||n.updatedAt))}</span></div><h2>${esc(n.title||`RUN ${run}`)}</h2><p class="hwmb-quote">${esc(quote)}</p><div class="hwmb-body">${esc(body)}</div></div><div class="hwmb-footer"><div class="hwmb-tags">${tags.map(t=>`<span class="hwmb-tag">${esc(t)}</span>`).join('')}</div><span class="hwmb-pageno">${String(i+1).padStart(2,'0')}</span></div></article>`})});
    const insights=lateInsights(notes);if(insights.length)raw.push({type:'after',html:`<div class="hwmb-after"><small>AFTER THESE RUNS</small><h2>いま見えていること</h2><ul>${insights.map(s=>`<li>${esc(s)}</li>`).join('')}</ul></div>`});
    raw.push({type:'colophon',html:`<div class="hwmb-colophon"><div><small>CONTINUE</small><h2>まだ途中。</h2><p>${esc(ending)}</p></div><div class="hwmb-cover-foot"><span>GAME NOTES</span><span>HARF-WAY</span></div></div>`});
    state.pages=raw;state.page=Math.min(state.page,raw.length-1);return {raw,title};
  }
  function renderReader(direction=''){const {raw}=buildPages();if(!raw.length){$('#book').innerHTML='<div class="empty">記録を選択してください。</div>';return}const item=raw[state.page];const idx=state.page;const total=raw.length;$('#book').innerHTML=`<div class="hwmb-reader"><div class="hwmb-shell">${pageFrame(item.html,idx,total,item.type)}</div><div class="hwmb-reader-nav"><button type="button" data-nav="prev" ${idx===0?'disabled':''}>← 前</button><div class="hwmb-progress">PAGE ${idx+1} / ${total}</div><button type="button" data-nav="next" ${idx===total-1?'disabled':''}>次 →</button></div><div class="hwmb-dots">${raw.map((_,i)=>`<span class="hwmb-dot ${i===idx?'on':''}"></span>`).join('')}</div><div class="hwmb-reader-help">左右クリック / ← → / スワイプでめくる</div></div>`;bindReader();makeExport()}
  function flipTo(next,dir){if(next<0||next>=state.pages.length||next===state.page)return;const page=$('.hwmb-page');if(!page){state.page=next;renderReader();return}const cls=dir==='prev'?'is-flipping-prev':'is-flipping-next';page.classList.add(cls);const ms=dir==='prev'?170:260;setTimeout(()=>{state.page=next;renderReader(dir)},ms)}
  function bindReader(){const prev=()=>flipTo(state.page-1,'prev');const next=()=>flipTo(state.page+1,'next');$('[data-nav="prev"]')?.addEventListener('click',prev);$('[data-nav="next"]')?.addEventListener('click',next);$('.hwmb-corner.prev')?.addEventListener('click',prev);$('.hwmb-corner.next')?.addEventListener('click',next);const reader=$('.hwmb-reader');if(reader){reader.addEventListener('touchstart',e=>{state.touchX=e.changedTouches[0]?.clientX??null},{passive:true});reader.addEventListener('touchend',e=>{if(state.touchX==null)return;const dx=(e.changedTouches[0]?.clientX??state.touchX)-state.touchX;state.touchX=null;if(Math.abs(dx)<45)return;dx<0?next():prev()},{passive:true})}}
  function exportCss(){return `.hwmb-wp{--p:#f2efe6;--i:#171916;--m:#6e716b;--l:#c9c3b5;--a:#161b17;max-width:760px;margin:28px auto;color:var(--i);font-family:"Hiragino Mincho ProN","Yu Mincho",serif}.hwmb-wp *{box-sizing:border-box}.hwmb-wp-page{display:none;position:relative;min-height:680px;padding:58px;background:var(--p);border:1px solid #c8c2b5;box-shadow:0 18px 55px #0003}.hwmb-wp-page.on{display:block}.hwmb-wp .hwmb-cover,.hwmb-wp .hwmb-intro,.hwmb-wp .hwmb-run,.hwmb-wp .hwmb-after,.hwmb-wp .hwmb-colophon{min-height:560px;display:flex;flex-direction:column}.hwmb-wp .hwmb-cover,.hwmb-wp .hwmb-run,.hwmb-wp .hwmb-colophon{justify-content:space-between}.hwmb-wp .hwmb-intro,.hwmb-wp .hwmb-after{justify-content:center}.hwmb-wp .hwmb-kicker,.hwmb-wp small,.hwmb-wp .hwmb-run-top,.hwmb-wp .hwmb-cover-foot{font:800 10px ui-monospace,monospace;letter-spacing:.12em}.hwmb-wp h1{font-size:64px;line-height:.98;letter-spacing:-.06em;max-width:9ch;margin:18px 0}.hwmb-wp .hwmb-intro p{font-size:19px;line-height:2}.hwmb-wp .hwmb-run-top,.hwmb-wp .hwmb-cover-foot,.hwmb-wp .hwmb-footer{display:flex;justify-content:space-between;gap:12px}.hwmb-wp .hwmb-run h2{font-size:38px;line-height:1.15;letter-spacing:-.04em;margin:34px 0 20px}.hwmb-wp .hwmb-quote{border-top:3px solid var(--a);border-bottom:1px solid var(--l);padding:16px 0;font-size:23px;line-height:1.65;font-weight:700}.hwmb-wp .hwmb-body{white-space:pre-wrap;font-size:15px;line-height:2}.hwmb-wp .hwmb-tags{display:flex;gap:5px;flex-wrap:wrap}.hwmb-wp .hwmb-tag{border:1px solid #aaa497;border-radius:99px;padding:4px 7px;font:700 8px ui-monospace,monospace}.hwmb-wp .hwmb-after{background:var(--a);color:#f3f3ee;margin:-58px;padding:58px}.hwmb-wp-nav{display:grid;grid-template-columns:90px 1fr 90px;align-items:center;gap:10px;margin-top:12px}.hwmb-wp-nav button{border:1px solid #333;background:#111;color:#fff;border-radius:99px;padding:9px}.hwmb-wp-nav span{text-align:center;font:800 10px ui-monospace,monospace}@media(max-width:600px){.hwmb-wp-page{min-height:70svh;padding:30px 24px}.hwmb-wp h1{font-size:45px}.hwmb-wp .hwmb-run h2{font-size:31px}.hwmb-wp .hwmb-quote{font-size:20px}.hwmb-wp .hwmb-after{margin:-30px -24px;padding:30px 24px;min-height:70svh}}`}
  function makeExport(){if(!state.pages.length)return;const pages=state.pages.map((p,i)=>`<section class="hwmb-wp-page ${i===0?'on':''}" data-hwmb-page="${i}">${p.html}</section>`).join('');const script=`<script>(()=>{document.querySelectorAll('[data-hwmb]').forEach(r=>{let i=0;const ps=[...r.querySelectorAll('[data-hwmb-page]')],n=r.querySelector('[data-hwmb-count]');function s(x){i=Math.max(0,Math.min(ps.length-1,x));ps.forEach((p,j)=>p.classList.toggle('on',j===i));if(n)n.textContent=(i+1)+' / '+ps.length}r.querySelector('[data-hwmb-prev]')?.addEventListener('click',()=>s(i-1));r.querySelector('[data-hwmb-next]')?.addEventListener('click',()=>s(i+1));let x=null;r.addEventListener('touchstart',e=>x=e.changedTouches[0].clientX,{passive:true});r.addEventListener('touchend',e=>{if(x==null)return;let d=e.changedTouches[0].clientX-x;x=null;if(Math.abs(d)>45)s(i+(d<0?1:-1))},{passive:true});s(0)})})();<\/script>`;state.exportHtml=`<style>${exportCss()}</style><div class="hwmb-wp" data-hwmb>${pages}<div class="hwmb-wp-nav"><button type="button" data-hwmb-prev>← 前</button><span data-hwmb-count>1 / ${state.pages.length}</span><button type="button" data-hwmb-next>次 →</button></div></div>${script}`;$('#html').value=state.exportHtml}
  function generate(){state.page=0;renderReader()}

  $('#game').addEventListener('change',onGameChange);$('#density').addEventListener('change',generate);$('#generate').addEventListener('click',generate);['book-title','kicker','intro','ending'].forEach(id=>$('#'+id).addEventListener('input',()=>{clearTimeout(state._t);state._t=setTimeout(()=>renderReader(),180)}));
  $('#notes').addEventListener('change',e=>{const id=e.target?.dataset?.note;if(!id)return;e.target.checked?state.selected.add(id):state.selected.delete(id);$('#selected-count').textContent=state.selected.size;generate()});
  $('#latest10').addEventListener('click',()=>{state.selected.clear();const list=gameNotes();list.slice(-10).forEach(n=>state.selected.add(n.id));renderNoteList();generate()});$('#select-all').addEventListener('click',()=>{gameNotes().forEach(n=>state.selected.add(n.id));renderNoteList();generate()});$('#clear-all').addEventListener('click',()=>{state.selected.clear();renderNoteList();generate()});
  $('#copy').addEventListener('click',async()=>{makeExport();try{await navigator.clipboard.writeText(state.exportHtml);const b=$('#copy');const old=b.textContent;b.textContent='コピーしました';setTimeout(()=>b.textContent=old,1400)}catch{$('#html-output').classList.add('on')}});$('#toggle-html').addEventListener('click',()=>$('#html-output').classList.toggle('on'));
  $('#auth-btn').addEventListener('click',()=>{state.adminKey=$('#admin-key').value.trim();if(state.adminKey)sessionStorage.setItem('harfway_game_notes_key',state.adminKey);load()});
  document.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName))return;if(e.key==='ArrowLeft')flipTo(state.page-1,'prev');if(e.key==='ArrowRight')flipTo(state.page+1,'next')});
  load();
})();
</script>
</body>
</html>
