---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
const raw = await readFile(resolve(process.cwd(), 'snapshot/index.html'), 'utf8');
const source = raw
  .replaceAll('https://harfway-playback.vercel.app/api/games', '/api/games-live')
  .replace(/const API\s*=\s*['"]\/api\/games['"]\s*;/g, "const API='/api/games-live';");
if (/const API\s*=\s*['"]\/api\/games['"]\s*;/.test(source)) {
  throw new Error('Legacy /api/games binding remains in WAYS frontend');
}
const head = source.match(/<head>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = source.match(/<body>([\s\S]*?)<\/body>/i)?.[1] ?? source;
---
<!doctype html>
<html lang="ja">
  <head><Fragment set:html={head} /></head>
  <body><Fragment set:html={body} /><script is:inline src="/ways-random.js"></script><script is:inline src="/ga4-service.js"></script><script is:inline src="/ways-analytics.js"></script><script is:inline src="/ways-deeplink.js"></script><script is:inline src="/ways-ads.js"></script></body>
</html>
<!-- WAYS live games API + random-only discovery + custom analytics + GA4 bridge + Steam deep links + ads -->