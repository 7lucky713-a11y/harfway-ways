<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY Archive Salvager</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#11110f;color:#f5f2eb}*{box-sizing:border-box}body{margin:0}.top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:12px;padding:18px 22px;background:#161614;border-bottom:1px solid #33322e}.brand{font-size:11px;letter-spacing:.16em;color:#a4a198;white-space:nowrap}.url{display:flex;gap:8px;flex:1}.toplink{border:1px solid #48463f;background:#25241f;color:#fff;padding:10px 12px;border-radius:8px;text-decoration:none;font-size:11px;font-weight:700;white-space:nowrap}input,button,textarea{font:inherit}input,textarea{width:100%;border:1px solid #3c3a35;background:#181816;color:#f5f2eb;padding:10px 12px;border-radius:8px}.btn{border:1px solid #48463f;background:#25241f;color:#fff;padding:10px 14px;border-radius:8px;cursor:pointer}.btn.primary{background:#f0ede5;color:#111;border-color:#f0ede5;font-weight:700}.btn.mini{padding:7px 9px;font-size:11px}.btn:disabled{opacity:.45;cursor:not-allowed}main{display:grid;grid-template-columns:260px minmax(560px,1fr) 390px;min-height:calc(100vh - 72px)}.pane{overflow:auto;border-right:1px solid #302f2a}.pane:last-child{border:0}.pad{padding:18px}.label{font-size:10px;letter-spacing:.14em;color:#8b8880;text-transform:uppercase;margin:0 0 10px}.stat{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #292823}.queue{margin-top:20px}.queue-item{width:100%;text-align:left;padding:11px;border:1px solid #302f2a;background:#171715;color:#c8c4b9;border-radius:8px;margin-bottom:8px;font-size:12px;cursor:pointer}.queue-item:hover{border-color:#605d54;background:#1d1d1a}.queue-item.active{border-color:#d8d1c2;background:#26241f;color:#fff}.syncbox{margin-top:13px;padding:10px;border:1px dashed #403d36;border-radius:8px;font-size:10px;color:#969187;line-height:1.55}.syncbox .btn{width:100%;margin-top:7px}.article{max-width:920px;margin:0 auto}.article h1{font-size:30px;line-height:1.34;margin:0 0 10px;letter-spacing:-.02em}.meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12px;color:#8f8b82;margin-bottom:10px}.meta a{color:#bbb}.sourcebadge{display:inline-flex;max-width:100%;padding:5px 8px;border:1px solid #37352f;border-radius:999px;background:#181816;color:#aaa59a;font-size:10px;line-height:1.3;overflow-wrap:anywhere;margin-bottom:16px}.body{max-width:760px;font-size:16px;line-height:2;color:#ddd8ce;letter-spacing:.01em}.body p{margin:0 0 1.55em}.body p:last-child{margin-bottom:0}.thumbs{display:flex;gap:9px;overflow:auto;margin:0 0 22px;padding:2px 0 4px}.thumbs img{flex:0 0 auto;width:132px;height:82px;object-fit:cover;border-radius:7px;border:1px solid #36342f;background:#1b1a18}.candidate{display:block;border:1px solid #37352f;background:#181816;border-radius:10px;padding:12px;margin:0 0 10px}.candidate.hint{border-color:#5d5648}.candidate.unresolved{border-color:#756444;background:#1d1a14}.ctop{display:flex;align-items:flex-start;gap:9px}.ctop input{width:auto;margin-top:4px}.title{font-weight:700}.sub{font-size:11px;color:#949087;margin-top:3px}.score{margin-left:auto;border:1px solid #4d4a43;border-radius:99px;padding:3px 7px;font-size:10px;color:#bbb7ad}.excerpt{border-top:1px solid #2c2a26;margin-top:9px;padding-top:9px;font-size:12px;line-height:1.55;color:#aaa69c}.notice{font-size:12px;line-height:1.6;background:#20201c;border:1px solid #39372f;border-radius:8px;padding:11px;margin-bottom:14px;color:#beb9ae}.empty{padding:44px 14px;text-align:center;color:#77736b}.actions{position:sticky;bottom:0;padding:30px 0 0;background:linear-gradient(transparent,#11110f 30%);display:flex;gap:8px}.manual{display:flex;gap:8px;margin-bottom:13px}.manual input{min-width:0}.match-source{font-size:10px;color:#8a867c;margin-top:5px}.ok{color:#c9f7be}.warn{color:#f4d99a}.hintbox{margin-bottom:13px;border:1px dashed #4b473f;border-radius:8px;padding:10px;font-size:11px;color:#aaa59a;line-height:1.55}.hintchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.chip{border:1px solid #403d36;border-radius:99px;padding:4px 8px;color:#c9c4b9;background:#1b1a18}.editbadge{display:inline-block;margin-left:8px;font-size:10px;padding:3px 6px;border:1px solid #625d51;border-radius:99px;color:#d6d0c4}.new-actions{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #3b3327}.new-actions a{font-size:11px;color:#c9b47f}@media(max-width:1120px){main{grid-template-columns:220px 1fr}.right{grid-column:1/-1;border-top:1px solid #302f2a}.middle{border-right:0}}@media(max-width:720px){.top,.url{flex-direction:column;align-items:stretch}.toplink{text-align:center}main{display:block}.pane{border-right:0;border-bottom:1px solid #302f2a}.article h1{font-size:24px}.body{font-size:15px}.thumbs img{width:112px;height:70px}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / ARCHIVE SALVAGER v0.8</div><form id="loadForm" class="url"><input id="articleUrl" type="url" placeholder="https://harf-way.com/..." required><button id="loadBtn" class="btn primary">記事を読み込む</button></form><a class="toplink" href="/salvage/library/">保存一覧 ↗</a><button id="authBtn" class="btn mini" type="button">管理キー</button></header>
<main>
<section class="pane"><div class="pad"><div class="label">Progress</div><div class="stat"><span>処理済み</span><strong id="doneCount">0</strong></div><div class="stat"><span>下書き</span><strong id="draftCount">0</strong></div><div class="stat"><span>Core games</span><strong id="gameCount">—</strong></div><div id="syncBox" class="syncbox" style="display:none">このブラウザに旧保存データがあります。Coreへ永続化できます。<button id="syncLocal" class="btn mini" type="button">ローカル保存をCoreへ同期</button></div><div class="queue"><div class="label">Saved / クリックで再編集</div><div id="queue"></div></div></div></section>
<section class="pane middle"><div class="pad article" id="articlePane"><div class="empty">過去記事URLを入力するか、左の保存済み記事を選んでください。</div></div></section>
<section class="pane right"><div class="pad"><div class="label">Shared Content Core / Link Candidates</div><div id="coreStatus" class="notice">Shared Content Coreを読み込んでいます…</div><div id="hintBox" class="hintbox" style="display:none"></div><div class="manual"><input id="manualQuery" placeholder="ゲーム名で候補を検索"><button id="manualBtn" class="btn" type="button">検索</button></div><div id="candidates"><div class="empty">記事を読み込んでください。</div></div><div class="actions"><button id="saveDraft" class="btn" disabled>下書き保存</button><button id="saveNext" class="btn primary" disabled>保存して次へ →</button></div></div></section>
</main>
<script>
const $=s=>document.querySelector(s);const LOCAL_KEY='harfway-archive-salvager-v06',ADMIN_KEY='hw_salvager_admin_key';const state={games:[],article:null,candidates:[],coreOk:false,remoteItems:[],editingUrl:'',runtime:{environment:'unknown',writeMode:'unknown',authRequired:false}};
const esc=(v='')=>String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));const norm=(v='')=>String(v).normalize('NFKC').toLowerCase().replace(/[\s:：・!！?？'"“”‘’()（）\[\]【】_\-～~]+/g,'');
const admin=()=>sessionStorage.getItem(ADMIN_KEY)||'';function askAdmin(){const v=window.prompt('WAYSと同じ管理キーを入力してください',admin());if(v&&v.trim()){sessionStorage.setItem(ADMIN_KEY,v.trim());return true}return false}
async function authFetch(url,opt={},retry=true){const headers={...(opt.headers||{})};if(admin())headers['X-Admin-Key']=admin();const r=await fetch(url,{...opt,headers});if(r.status===401&&state.runtime.authRequired&&retry){sessionStorage.removeItem(ADMIN_KEY);if(askAdmin())return authFetch(url,opt,false)}return r}
function db(){try{return JSON.parse(localStorage.getItem(LOCAL_KEY)||'{"items":[]}')}catch{return {items:[]}}}function put(v){localStorage.setItem(LOCAL_KEY,JSON.stringify(v))}
function allSaved(){const local=db().items||[],map=new Map(),remote=new Set();for(const x of state.remoteItems||[]){map.set(x.url,{...x,_origin:'db'});remote.add(x.url)}for(const x of local)map.set(x.url,{...map.get(x.url),...x,_origin:remote.has(x.url)?'db':'local'});return [...map.values()].sort((a,b)=>String(b.savedAt||b.updated_at||'').localeCompare(String(a.savedAt||a.updated_at||'')))}
function stats(){const items=allSaved();$('#doneCount').textContent=items.filter(x=>['done','reviewed','published'].includes(x.status)).length;$('#draftCount').textContent=items.filter(x=>x.status==='draft').length;$('#gameCount').textContent=state.games.length||'—';const localCount=(db().items||[]).filter(x=>x.article).length;$('#syncBox').style.display=localCount?'block':'none';$('#queue').innerHTML=items.slice(0,40).map(x=>`<button class="queue-item ${state.editingUrl===x.url?'active':''}" data-url="${esc(x.url)}"><strong>${esc(x.title||x.url)}</strong><br><small>${Number(x.game_count??x.links?.length??0)} games · ${esc(x.status||'saved')} ${x._origin==='db'?'· Core DB':'· local'}</small></button>`).join('')||'<div class="empty">まだありません</div>';document.querySelectorAll('.queue-item').forEach(el=>el.addEventListener('click',()=>openSaved(el.dataset.url)))}
function score(title,text){const a=norm(title),b=norm(text);if(!a||!b)return 0;if(b.includes(a))return a.length>=4?82:45;const p=String(title).toLowerCase().split(/[\s:：・_\-]+/).filter(x=>x.length>2);if(!p.length)return 0;return Math.min(72,Math.round(p.filter(x=>String(text).toLowerCase().includes(x)).length/p.length*72))}
function titleScore(gameTitle,articleTitle){const a=norm(gameTitle),b=norm(articleTitle);if(!a||!b)return 0;if(a===b)return 100;if(a.length>=4&&(b.includes(a)||a.includes(b)))return 98;return 0}
function strongHintSource(source=''){const s=String(source).toLowerCase();return /(page-title|steam|store|slug|url)/.test(s)&&!/(heading|related|body)/.test(s)}
function hintScore(game,hints){let best=0,source='';for(const h of hints||[]){const a=norm(game.title),b=norm(h.name);if(!a||!b)continue;const strong=strongHintSource(h.source);let s=0;if(a===b)s=strong?100:(a.length>=4?88:55);else if(a.length>=4&&(a.includes(b)||b.includes(a)))s=strong?96:72;else{const gp=String(game.title).toLowerCase().split(/[\s:：・_\-]+/).filter(x=>x.length>2);s=Math.min(strong?90:68,Math.round(gp.filter(x=>String(h.name).toLowerCase().includes(x)).length/Math.max(1,gp.length)*(strong?90:68)))}if(s>best){best=s;source=h.source||'name-hint'}}return {score:best,source}}
function excerpt(text,title){const raw=String(text||''),plain=raw.toLowerCase().indexOf(String(title||'').toLowerCase());return plain>=0?raw.slice(Math.max(0,plain-100),plain+String(title).length+180).replace(/\s+/g,' ').trim():''}
function unresolvedCandidates(article){const hints=article?.nameHints||[],matched=new Set(state.games.map(g=>norm(g.title)));return hints.filter(h=>h.name&&!matched.has(norm(h.name))).slice(0,12).map((h,i)=>({id:`unresolved:${i}:${norm(h.name)}`,title:h.name,storeUrl:h.url||'',category:'DB未登録',_score:100,_excerpt:'',_source:h.source||'article hint',_unresolved:true}))}
async function loadRuntime(){try{const r=await fetch('/api/archive-status',{cache:'no-store'});const j=await r.json();if(j.ok)state.runtime=j}catch{}}
async function loadCore(){try{const r=await fetch('/api/core/games?limit=500',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok||!Array.isArray(j.games))throw new Error(j.error||'core_unavailable');state.games=j.games;state.coreOk=true;$('#coreStatus').innerHTML=`<span class="ok">● Core接続OK</span><br>${j.games.length}作品を照合中 / 保存先: ${esc(state.runtime.writeMode||'unknown')}`}catch(e){state.games=[];state.coreOk=false;$('#coreStatus').innerHTML=`<span class="warn">● Coreを読み込めません</span><br>${esc(e.message)}`}stats()}
async function loadRemoteItems(){try{const r=await authFetch('/api/archive-items?limit=500',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'archive_items_failed');if(Array.isArray(j.items))state.remoteItems=j.items}catch(e){if(state.runtime.authRequired)$('#coreStatus').innerHTML=`<span class="warn">● 保存一覧は認証が必要です</span><br>${esc(e.message)}`}stats()}
function bodyHtml(text=''){const parts=String(text||'').split(/\n{2,}/).map(x=>x.trim()).filter(Boolean);return parts.length?parts.map(x=>`<p>${esc(x)}</p>`).join(''):'<p>本文を取得できませんでした。</p>'}
function renderArticle(a){const seen=new Set(),imgs=(a.images||[]).filter(x=>x?.url&&!seen.has(x.url)&&seen.add(x.url)).slice(0,8);const source=a.contentSource?`<div class="sourcebadge">本文ソース: ${esc(a.contentSource)}</div>`:'';$('#articlePane').innerHTML=`<h1>${esc(a.title||'Untitled')}${state.editingUrl?'<span class="editbadge">再編集中</span>':''}</h1><div class="meta"><span>${esc(a.date||'')}</span><span>·</span><a href="${esc(a.url)}" target="_blank" rel="noreferrer">元記事を開く ↗</a><span>·</span><span>${(a.images||[]).length} images</span></div>${source}${imgs.length?`<div class="thumbs">${imgs.map(x=>`<img src="${esc(x.url)}" alt="${esc(x.alt||'')}">`).join('')}</div>`:''}<div class="body">${bodyHtml(a.text)}</div>`;renderHints(a)}
function renderHints(a){const hints=a?.nameHints||[];if(!hints.length){$('#hintBox').style.display='none';return}$('#hintBox').style.display='block';$('#hintBox').innerHTML=`記事構造から拾った名前候補 <strong>${hints.length}</strong>件<div class="hintchips">${hints.slice(0,16).map(h=>`<span class="chip">${esc(h.name)}</span>`).join('')}</div>`}
function setCandidates(list,selectedIds=[]){state.candidates=list;renderCandidates(selectedIds)}
function renderCandidates(selectedIds=[]){const set=new Set(selectedIds);if(!state.candidates.length){$('#candidates').innerHTML='<div class="empty">一致候補がありません。上の検索欄から手動で探せます。</div>'}else{$('#candidates').innerHTML=state.candidates.map((g,i)=>g._unresolved?`<div class="candidate unresolved"><div class="ctop"><div><div class="title">${esc(g.title)}</div><div class="sub">DB未登録候補</div><div class="match-source">${esc(g._source)}</div></div><span class="score">NEW</span></div><div class="new-actions"><button class="btn mini primary register-game" data-i="${i}" type="button">ゲームDBへ登録</button>${g.storeUrl?`<a href="${esc(g.storeUrl)}" target="_blank" rel="noreferrer">取得したSTORE PAGE ↗</a>`:''}</div></div>`:`<label class="candidate ${g._source?.includes('hint')||g._source?.includes('heading')||g._source?.includes('store')?'hint':''}"><div class="ctop"><input type="checkbox" data-i="${i}" ${g._auto||set.has(g.id)?'checked':''}><div><div class="title">${esc(g.title)}</div><div class="sub">${esc(g.category||'')} · ${esc(g.id)}</div><div class="match-source">${esc(g._source||'article match')}</div></div><span class="score">${g._score}%</span></div>${g._excerpt?`<div class="excerpt">…${esc(g._excerpt)}…</div>`:''}</label>`).join('')}document.querySelectorAll('.register-game').forEach(el=>el.addEventListener('click',()=>registerGame(Number(el.dataset.i),el)));$('#saveDraft').disabled=!state.article;$('#saveNext').disabled=!state.article}
function autoMatch(selectedIds=[]){const a=state.article;if(!a)return;const hints=a.nameHints||[];const matched=state.games.map(g=>{const ts=titleScore(g.title,a.title),bs=score(g.title,a.text),hs=hintScore(g,hints),best=Math.max(ts,bs,hs.score);let source='article body mention';if(ts>=bs&&ts>=hs.score&&ts)source='article title';else if(hs.score>=bs&&hs.score)source=`name hint / ${hs.source}`;return {...g,_score:best,_auto:best===100,_excerpt:excerpt(a.text,g.title),_source:source}}).filter(g=>g._score>=60).sort((a,b)=>b._score-a._score).slice(0,50);setCandidates([...matched,...unresolvedCandidates(a)],selectedIds)}
function manualSearch(){const q=norm($('#manualQuery').value);if(!q)return autoMatch();const current=new Map(state.candidates.filter(x=>!x._unresolved).map(x=>[x.id,x]));for(const g of state.games){if(norm(g.title).includes(q)||q.includes(norm(g.title)))current.set(g.id,{...g,_score:95,_auto:false,_excerpt:state.article?excerpt(state.article.text,g.title):'',_source:'manual search'})}setCandidates([...current.values()].sort((a,b)=>b._score-a._score).slice(0,60))}
function selected(){return [...document.querySelectorAll('#candidates input[type=checkbox]:checked')].map(el=>{const g=state.candidates[Number(el.dataset.i)];return {gameId:g.id,title:g.title,score:g._score,excerpt:g._excerpt,source:g._source}})}
async function registerGame(index,button){const g=state.candidates[index];if(!g||!g._unresolved||!state.article)return;button.disabled=true;button.textContent='登録中…';try{const r=await authFetch('/api/archive-create-game',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title:g.title,storeUrl:g.storeUrl||'',articleUrl:state.article.url})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'create_failed');const newGame={id:j.game.id,title:j.game.title,storeUrl:j.game.store_url||g.storeUrl||'',articleUrl:j.game.article_url||state.article.url,category:j.game.category||'',status:j.game.status||'active',sourceOfTruth:j.game.source_of_truth||'archive-salvager',_score:100,_auto:true,_excerpt:excerpt(state.article.text,j.game.title),_source:j.created?'created from article':'existing match'};state.games=[newGame,...state.games.filter(x=>x.id!==newGame.id)];const ids=[...selected().map(x=>x.gameId),newGame.id];autoMatch(ids);await persist('draft');$('#coreStatus').innerHTML=`<span class="ok">● ゲーム登録＋記事リンクOK</span><br>${esc(newGame.title)} をCoreへ登録しました。`;stats()}catch(e){button.disabled=false;button.textContent='ゲームDBへ登録';$('#coreStatus').innerHTML=`<span class="warn">● 登録できません</span><br>${esc(e.message)}`}}
async function saveToCore(article,links,status){const r=await authFetch('/api/archive-save',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({article,links,status})}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'save_failed');return j}
async function persist(status){if(!state.article)return false;const links=selected();if(!links.length){$('#coreStatus').innerHTML='<span class="warn">● ゲームを選択してください</span><br>記事をCoreへ保存するには、右側で紐付けるゲームを1件以上チェックしてください。';return false}const d=db(),item={url:state.article.url,title:state.article.title,date:state.article.date,status,links,article:state.article,savedAt:new Date().toISOString(),coreVersion:'0.8'};const i=d.items.findIndex(x=>x.url===item.url);if(i>=0)d.items[i]=item;else d.items.push(item);put(d);stats();try{const j=await saveToCore(state.article,links,status);await loadRemoteItems();$('#coreStatus').innerHTML=`<span class="ok">● Core保存OK</span><br>${esc(state.article.title)} / ${esc(j.writeMode||state.runtime.writeMode)}`;return true}catch(e){$('#coreStatus').innerHTML=`<span class="warn">● ブラウザには保存済み / Core保存失敗</span><br>${esc(e.message)}`;return false}}
async function syncLocal(){const items=(db().items||[]).filter(x=>x.article&&Array.isArray(x.links)&&x.links.length);if(!items.length){$('#coreStatus').innerHTML='<span class="warn">● 同期対象なし</span><br>ゲーム紐付け済みのローカル記事がありません。';return}const btn=$('#syncLocal');btn.disabled=true;let ok=0;try{for(const x of items){await saveToCore(x.article,x.links||[],x.status||'draft');ok++}await loadRemoteItems();$('#coreStatus').innerHTML=`<span class="ok">● ローカル同期OK</span><br>${ok}件をCoreへ保存しました。`}catch(e){$('#coreStatus').innerHTML=`<span class="warn">● 同期途中で停止</span><br>${ok}/${items.length}件完了 · ${esc(e.message)}`}finally{btn.disabled=false;stats()}}
async function openSaved(url){const remote=(state.remoteItems||[]).find(x=>x.url===url),local=(db().items||[]).find(x=>x.url===url);if(!remote&&local?.article){state.article=local.article;state.editingUrl=url;$('#articleUrl').value=url;renderArticle(state.article);autoMatch((local.links||[]).map(x=>x.gameId));stats();return}try{const r=await authFetch('/api/archive-items?url='+encodeURIComponent(url),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok||!j.item)throw new Error('saved_item_not_found');const x=j.item;state.article={url:x.url,title:x.title,date:x.published_at||'',text:x.body_text||'',featuredImage:x.featured_image_url||'',images:(x.assets||[]).map(a=>({url:a.sourceUrl||a.source_url,alt:a.altText||a.alt_text||'',featured:a.assetType==='featured_image'||a.asset_type==='featured_image'})),nameHints:x.metadata?.nameHints||[],storeLinks:x.metadata?.storeLinks||[],contentSource:x.metadata?.contentSource||'Core DB'};state.editingUrl=url;$('#articleUrl').value=url;renderArticle(state.article);autoMatch((x.games||[]).map(g=>g.gameId||g.game_id));stats()}catch(e){$('#coreStatus').innerHTML=`<span class="warn">● 再編集読込失敗</span><br>${esc(e.message)}`}}
async function loadArticle(url){if(!url)return;$('#loadBtn').disabled=true;$('#loadBtn').textContent='読み込み中…';$('#articlePane').innerHTML='<div class="empty">記事を取得しています…</div>';$('#candidates').innerHTML='<div class="empty">Coreと照合しています…</div>';try{const r=await fetch('/api/archive-fetch?url='+encodeURIComponent(url)),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'fetch_failed');state.article=j.article;state.editingUrl='';renderArticle(state.article);autoMatch()}catch(e){state.article=null;$('#articlePane').innerHTML=`<div class="empty">取得できませんでした。<br>${esc(e.message)}</div>`;$('#candidates').innerHTML='<div class="empty">—</div>'}finally{$('#loadBtn').disabled=false;$('#loadBtn').textContent='記事を読み込む'}}
$('#loadForm').addEventListener('submit',e=>{e.preventDefault();loadArticle($('#articleUrl').value.trim())});$('#manualBtn').addEventListener('click',manualSearch);$('#manualQuery').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();manualSearch()}});$('#saveDraft').addEventListener('click',()=>persist('draft'));$('#saveNext').addEventListener('click',async()=>{const ok=await persist('done');if(!ok)return;state.article=null;state.candidates=[];state.editingUrl='';$('#articleUrl').value='';$('#manualQuery').value='';$('#articlePane').innerHTML='<div class="empty">Coreへ保存しました。次の記事URLを入力してください。</div>';$('#candidates').innerHTML='<div class="empty">次の記事を待っています。</div>';$('#saveDraft').disabled=true;$('#saveNext').disabled=true;$('#articleUrl').focus()});$('#authBtn').onclick=async()=>{if(askAdmin())await loadRemoteItems()};$('#syncLocal').onclick=syncLocal;
async function init(){await loadRuntime();await Promise.all([loadCore(),loadRemoteItems()]);stats();const initial=new URLSearchParams(location.search).get('url');if(initial){$('#articleUrl').value=initial;const saved=allSaved().find(x=>x.url===initial);if(saved)await openSaved(initial);else await loadArticle(initial)}}init();
</script>
</body></html>