<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HARF-WAY Archive Salvager</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#11110f;color:#f5f2eb}*{box-sizing:border-box}body{margin:0}.top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:18px;padding:18px 22px;background:#161614;border-bottom:1px solid #33322e}.brand{font-size:11px;letter-spacing:.16em;color:#a4a198;white-space:nowrap}.url{display:flex;gap:8px;flex:1}input,button,textarea{font:inherit}input,textarea{width:100%;border:1px solid #3c3a35;background:#181816;color:#f5f2eb;padding:10px 12px;border-radius:8px}.btn{border:1px solid #48463f;background:#25241f;color:#fff;padding:10px 14px;border-radius:8px;cursor:pointer}.btn.primary{background:#f0ede5;color:#111;border-color:#f0ede5;font-weight:700}.btn:disabled{opacity:.45;cursor:not-allowed}main{display:grid;grid-template-columns:285px minmax(380px,1fr) 410px;min-height:calc(100vh - 72px)}.pane{overflow:auto;border-right:1px solid #302f2a}.pane:last-child{border:0}.pad{padding:18px}.label{font-size:10px;letter-spacing:.14em;color:#8b8880;text-transform:uppercase;margin:0 0 10px}.stat{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #292823}.queue{margin-top:20px}.queue-item{width:100%;text-align:left;padding:11px;border:1px solid #302f2a;background:#171715;color:#c8c4b9;border-radius:8px;margin-bottom:8px;font-size:12px;cursor:pointer}.queue-item:hover{border-color:#605d54;background:#1d1d1a}.queue-item.active{border-color:#d8d1c2;background:#26241f;color:#fff}.article h1{font-size:28px;line-height:1.25;margin:0 0 8px}.meta{font-size:12px;color:#8f8b82;margin-bottom:16px}.body{white-space:pre-wrap;line-height:1.85;color:#d8d4ca}.thumbs{display:flex;gap:8px;overflow:auto;margin:0 0 18px}.thumbs img{width:110px;height:72px;object-fit:cover;border-radius:7px;border:1px solid #36342f}.candidate{display:block;border:1px solid #37352f;background:#181816;border-radius:10px;padding:12px;margin:0 0 10px}.candidate.hint{border-color:#5d5648}.ctop{display:flex;align-items:flex-start;gap:9px}.ctop input{width:auto;margin-top:4px}.title{font-weight:700}.sub{font-size:11px;color:#949087;margin-top:3px}.score{margin-left:auto;border:1px solid #4d4a43;border-radius:99px;padding:3px 7px;font-size:10px;color:#bbb7ad}.excerpt{border-top:1px solid #2c2a26;margin-top:9px;padding-top:9px;font-size:12px;line-height:1.55;color:#aaa69c}.notice{font-size:12px;line-height:1.6;background:#20201c;border:1px solid #39372f;border-radius:8px;padding:11px;margin-bottom:14px;color:#beb9ae}.empty{padding:44px 14px;text-align:center;color:#77736b}.actions{position:sticky;bottom:0;padding:30px 0 0;background:linear-gradient(transparent,#11110f 30%);display:flex;gap:8px}.manual{display:flex;gap:8px;margin-bottom:13px}.manual input{min-width:0}.match-source{font-size:10px;color:#8a867c;margin-top:5px}.ok{color:#c9f7be}.warn{color:#f4d99a}.hintbox{margin-bottom:13px;border:1px dashed #4b473f;border-radius:8px;padding:10px;font-size:11px;color:#aaa59a;line-height:1.55}.hintchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.chip{border:1px solid #403d36;border-radius:99px;padding:4px 8px;color:#c9c4b9;background:#1b1a18}.editbadge{display:inline-block;margin-left:8px;font-size:10px;padding:3px 6px;border:1px solid #625d51;border-radius:99px;color:#d6d0c4}@media(max-width:1000px){main{grid-template-columns:220px 1fr}.right{grid-column:1/-1;border-top:1px solid #302f2a}.middle{border-right:0}}@media(max-width:720px){.top,.url{flex-direction:column;align-items:stretch}main{display:block}.pane{border-right:0;border-bottom:1px solid #302f2a}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / ARCHIVE SALVAGER v0.4</div><form id="loadForm" class="url"><input id="articleUrl" type="url" placeholder="https://harf-way.com/..." required><button id="loadBtn" class="btn primary">記事を読み込む</button></form></header>
<main>
<section class="pane"><div class="pad"><div class="label">Progress</div><div class="stat"><span>処理済み</span><strong id="doneCount">0</strong></div><div class="stat"><span>下書き</span><strong id="draftCount">0</strong></div><div class="stat"><span>Core games</span><strong id="gameCount">—</strong></div><div class="queue"><div class="label">Saved / クリックで再編集</div><div id="queue"></div></div></div></section>
<section class="pane middle"><div class="pad article" id="articlePane"><div class="empty">過去記事URLを入力するか、左の保存済み記事を選んでください。</div></div></section>
<section class="pane right"><div class="pad"><div class="label">Shared Content Core / Link Candidates</div><div id="coreStatus" class="notice">Shared Content Coreを読み込んでいます…</div><div id="hintBox" class="hintbox" style="display:none"></div><div class="manual"><input id="manualQuery" placeholder="ゲーム名で候補を検索"><button id="manualBtn" class="btn" type="button">検索</button></div><div id="candidates"><div class="empty">記事を読み込んでください。</div></div><div class="actions"><button id="saveDraft" class="btn" disabled>下書き保存</button><button id="saveNext" class="btn primary" disabled>保存して次へ →</button></div></div></section>
</main>
<script>
const $=s=>document.querySelector(s);const key='harfway-archive-salvager-v04';const state={games:[],article:null,candidates:[],coreOk:false,remoteItems:[],editingUrl:''};
const esc=(v='')=>String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const norm=(v='')=>String(v).normalize('NFKC').toLowerCase().replace(/[\s:：・!！?？'"“”‘’()（）\[\]【】_\-～~]+/g,'');
function db(){try{return JSON.parse(localStorage.getItem(key)||'{"items":[]}')}catch{return {items:[]}}}function put(v){localStorage.setItem(key,JSON.stringify(v))}
function allSaved(){const local=db().items||[];const map=new Map();for(const x of state.remoteItems||[])map.set(x.url,{...x,_origin:'db'});for(const x of local)map.set(x.url,{...map.get(x.url),...x,_origin:'local'});return [...map.values()].sort((a,b)=>String(b.savedAt||b.updated_at||'').localeCompare(String(a.savedAt||a.updated_at||'')))}
function stats(){const d=db();$('#doneCount').textContent=d.items.filter(x=>x.status==='done').length;$('#draftCount').textContent=d.items.filter(x=>x.status==='draft').length;$('#gameCount').textContent=state.games.length||'—';const items=allSaved();$('#queue').innerHTML=items.slice(0,40).map((x,i)=>`<button class="queue-item ${state.editingUrl===x.url?'active':''}" data-url="${esc(x.url)}"><strong>${esc(x.title||x.url)}</strong><br><small>${Number(x.game_count??x.links?.length??0)} games · ${esc(x.status||'saved')} ${x._origin==='db'?'· DB':''}</small></button>`).join('')||'<div class="empty">まだありません</div>';document.querySelectorAll('.queue-item').forEach(el=>el.addEventListener('click',()=>openSaved(el.dataset.url)))}
function score(title,text){const a=norm(title),b=norm(text);if(!a||!b)return 0;if(b.includes(a))return 100;const p=String(title).toLowerCase().split(/[\s:：・_\-]+/).filter(x=>x.length>2);if(!p.length)return 0;return Math.round(p.filter(x=>String(text).toLowerCase().includes(x)).length/p.length*80)}
function hintScore(game,hints){let best=0,source='';for(const h of hints||[]){const a=norm(game.title),b=norm(h.name);if(!a||!b)continue;let s=0;if(a===b)s=100;else if(a.includes(b)||b.includes(a))s=96;else{const gp=String(game.title).toLowerCase().split(/[\s:：・_\-]+/).filter(x=>x.length>2);s=Math.round(gp.filter(x=>String(h.name).toLowerCase().includes(x)).length/Math.max(1,gp.length)*90)}if(s>best){best=s;source=h.source||'name-hint'}}return {score:best,source}}
function excerpt(text,title){const raw=String(text||''),plain=raw.toLowerCase().indexOf(String(title||'').toLowerCase());return plain>=0?raw.slice(Math.max(0,plain-100),plain+String(title).length+180).replace(/\s+/g,' ').trim():''}
async function loadCore(){try{const r=await fetch('/api/core/games?limit=500',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok||!Array.isArray(j.games))throw new Error(j.error||'core_unavailable');state.games=j.games;state.coreOk=true;$('#coreStatus').innerHTML=`<span class="ok">● Core接続OK</span><br>${j.games.length}作品を照合対象として読み込みました。見出し・ゲームストアリンク・本文から候補を出します。`}catch(e){state.games=[];state.coreOk=false;$('#coreStatus').innerHTML=`<span class="warn">● Coreを読み込めません</span><br>${esc(e.message)}`;}stats()}
async function loadRemoteItems(){try{const r=await fetch('/api/archive-items',{cache:'no-store'}),j=await r.json();if(j.ok&&Array.isArray(j.items))state.remoteItems=j.items}catch{}stats()}
function renderArticle(a){const imgs=(a.images||[]).slice(0,12);$('#articlePane').innerHTML=`<h1>${esc(a.title||'Untitled')}${state.editingUrl?'<span class="editbadge">再編集中</span>':''}</h1><div class="meta">${esc(a.date||'')} · <a style="color:#bbb" href="${esc(a.url)}" target="_blank" rel="noreferrer">元記事を開く ↗</a> · ${(a.images||[]).length} images</div>${imgs.length?`<div class="thumbs">${imgs.map(x=>`<img src="${esc(x.url)}" alt="${esc(x.alt||'')}">`).join('')}</div>`:''}<div class="body">${esc(a.text||'本文を取得できませんでした。')}</div>`;renderHints(a)}
function renderHints(a){const hints=a?.nameHints||[];if(!hints.length){$('#hintBox').style.display='none';return}$('#hintBox').style.display='block';$('#hintBox').innerHTML=`記事構造から拾った名前候補 <strong>${hints.length}</strong>件<div class="hintchips">${hints.slice(0,16).map(h=>`<span class="chip">${esc(h.name)}</span>`).join('')}</div>`}
function setCandidates(list,selectedIds=[]){state.candidates=list;renderCandidates(selectedIds)}
function renderCandidates(selectedIds=[]){const set=new Set(selectedIds);if(!state.candidates.length){$('#candidates').innerHTML='<div class="empty">一致候補がありません。上の検索欄から手動で探せます。</div>'}else{$('#candidates').innerHTML=state.candidates.map((g,i)=>`<label class="candidate ${g._source?.includes('hint')||g._source?.includes('heading')||g._source?.includes('store')?'hint':''}"><div class="ctop"><input type="checkbox" data-i="${i}" ${g._score===100||set.has(g.id)?'checked':''}><div><div class="title">${esc(g.title)}</div><div class="sub">${esc(g.category||'')} · ${esc(g.id)}</div><div class="match-source">${esc(g._source||'article match')}</div></div><span class="score">${g._score}%</span></div>${g._excerpt?`<div class="excerpt">…${esc(g._excerpt)}…</div>`:''}</label>`).join('')}$('#saveDraft').disabled=!state.article;$('#saveNext').disabled=!state.article}
function autoMatch(selectedIds=[]){const a=state.article;if(!a)return;const hints=a.nameHints||[];const list=state.games.map(g=>{const textScore=score(g.title,a.text);const hs=hintScore(g,hints);const best=Math.max(textScore,hs.score);return {...g,_score:best,_excerpt:excerpt(a.text,g.title),_source:hs.score>=textScore&&hs.score?`name hint / ${hs.source}`:'article title match'}}).filter(g=>g._score>=60).sort((a,b)=>b._score-a._score).slice(0,60);setCandidates(list,selectedIds)}
function manualSearch(){const q=norm($('#manualQuery').value);if(!q)return autoMatch();const current=new Map(state.candidates.map(x=>[x.id,x]));for(const g of state.games){if(norm(g.title).includes(q)||q.includes(norm(g.title))){current.set(g.id,{...g,_score:95,_excerpt:state.article?excerpt(state.article.text,g.title):'',_source:'manual search'})}}setCandidates([...current.values()].sort((a,b)=>b._score-a._score).slice(0,60))}
function selected(){return [...document.querySelectorAll('#candidates input[type=checkbox]:checked')].map(el=>{const g=state.candidates[Number(el.dataset.i)];return {gameId:g.id,title:g.title,score:g._score,excerpt:g._excerpt,source:g._source}})}
async function persist(status){if(!state.article)return false;const links=selected();const d=db(),item={url:state.article.url,title:state.article.title,date:state.article.date,status,links,article:state.article,savedAt:new Date().toISOString(),coreVersion:'0.4'};const i=d.items.findIndex(x=>x.url===item.url);if(i>=0)d.items[i]=item;else d.items.push(item);put(d);stats();try{const r=await fetch('/api/archive-save',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({article:state.article,links,status})});const j=await r.json();if(r.ok&&j.ok){await loadRemoteItems();$('#coreStatus').innerHTML=`<span class="ok">● Preview DB保存OK</span><br>${links.length}作品・${state.article.images?.length||0}画像を保存しました。保存済み一覧から再編集できます。`;return true}if(j.error==='preview_database_not_configured'){$('#coreStatus').innerHTML='<span class="warn">● ブラウザ保存のみ</span><br>Preview DB未接続のためローカル保存しました。再編集は左の一覧から可能です。';return true}throw new Error(j.error||'save_failed')}catch(e){$('#coreStatus').innerHTML=`<span class="warn">● DB保存失敗 / ローカル保存済み</span><br>${esc(e.message)}`;return true}}
async function loadArticle(url,preselected=[]){if(!url)return;$('#articleUrl').value=url;$('#loadBtn').disabled=true;$('#loadBtn').textContent='読み込み中…';$('#articlePane').innerHTML='<div class="empty">記事を取得しています…</div>';$('#candidates').innerHTML='<div class="empty">Coreと照合しています…</div>';try{const r=await fetch('/api/archive-fetch?url='+encodeURIComponent(url)),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'fetch_failed');state.article=j.article;state.editingUrl=state.article.url;renderArticle(state.article);autoMatch(preselected);stats()}catch(e){state.article=null;$('#articlePane').innerHTML=`<div class="empty">取得できませんでした。<br>${esc(e.message)}</div>`;$('#candidates').innerHTML='<div class="empty">—</div>'}finally{$('#loadBtn').disabled=false;$('#loadBtn').textContent='記事を読み込む'}}
async function openSaved(url){const local=db().items.find(x=>x.url===url);if(local?.article){state.article=local.article;state.editingUrl=url;renderArticle(state.article);autoMatch((local.links||[]).map(x=>x.gameId));$('#articleUrl').value=url;stats();return}try{const r=await fetch('/api/archive-items?url='+encodeURIComponent(url),{cache:'no-store'}),j=await r.json();if(j.ok&&j.item){const x=j.item;state.article={url:x.url,title:x.title,date:x.published_at||'',text:x.body_text||'',featuredImage:x.featured_image_url||'',images:(x.assets||[]).map(a=>({url:a.sourceUrl||a.source_url,alt:a.altText||'',featured:a.assetType==='featured_image'})),nameHints:[]};state.editingUrl=url;renderArticle(state.article);autoMatch((x.games||[]).map(g=>g.gameId));$('#articleUrl').value=url;stats();return}}catch{}await loadArticle(url)}
$('#loadForm').addEventListener('submit',async e=>{e.preventDefault();state.editingUrl='';await loadArticle($('#articleUrl').value.trim())});
$('#manualBtn').addEventListener('click',manualSearch);$('#manualQuery').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();manualSearch()}});$('#saveDraft').addEventListener('click',()=>persist('draft'));$('#saveNext').addEventListener('click',async()=>{await persist('done');state.article=null;state.candidates=[];state.editingUrl='';$('#articleUrl').value='';$('#manualQuery').value='';$('#hintBox').style.display='none';$('#articlePane').innerHTML='<div class="empty">保存しました。左の一覧からいつでも再編集できます。</div>';$('#candidates').innerHTML='<div class="empty">次の記事を待っています。</div>';$('#saveDraft').disabled=true;$('#saveNext').disabled=true;$('#articleUrl').focus();stats()});loadCore();loadRemoteItems();stats();
</script>
</body></html>