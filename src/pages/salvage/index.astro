<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HARF-WAY Archive Salvager</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#11110f;color:#f5f2eb}*{box-sizing:border-box}body{margin:0}.top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:18px;padding:18px 22px;background:#161614;border-bottom:1px solid #33322e}.brand{font-size:11px;letter-spacing:.16em;color:#a4a198;white-space:nowrap}.url{display:flex;gap:8px;flex:1}input,button,textarea{font:inherit}input,textarea{width:100%;border:1px solid #3c3a35;background:#181816;color:#f5f2eb;padding:10px 12px;border-radius:8px}.btn{border:1px solid #48463f;background:#25241f;color:#fff;padding:10px 14px;border-radius:8px;cursor:pointer}.btn.primary{background:#f0ede5;color:#111;border-color:#f0ede5;font-weight:700}.btn:disabled{opacity:.45;cursor:not-allowed}main{display:grid;grid-template-columns:260px minmax(380px,1fr) 410px;min-height:calc(100vh - 72px)}.pane{overflow:auto;border-right:1px solid #302f2a}.pane:last-child{border:0}.pad{padding:18px}.label{font-size:10px;letter-spacing:.14em;color:#8b8880;text-transform:uppercase;margin:0 0 10px}.stat{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #292823}.queue{margin-top:20px}.queue-item{padding:10px;border:1px solid #302f2a;border-radius:8px;margin-bottom:8px;font-size:12px;color:#c8c4b9}.article h1{font-size:28px;line-height:1.25;margin:0 0 8px}.meta{font-size:12px;color:#8f8b82;margin-bottom:18px}.body{white-space:pre-wrap;line-height:1.85;color:#d8d4ca}.candidate{display:block;border:1px solid #37352f;background:#181816;border-radius:10px;padding:12px;margin:0 0 10px}.ctop{display:flex;align-items:flex-start;gap:9px}.ctop input{width:auto;margin-top:4px}.title{font-weight:700}.sub{font-size:11px;color:#949087;margin-top:3px}.score{margin-left:auto;border:1px solid #4d4a43;border-radius:99px;padding:3px 7px;font-size:10px;color:#bbb7ad}.excerpt{border-top:1px solid #2c2a26;margin-top:9px;padding-top:9px;font-size:12px;line-height:1.55;color:#aaa69c}.notice{font-size:12px;line-height:1.6;background:#20201c;border:1px solid #39372f;border-radius:8px;padding:11px;margin-bottom:14px;color:#beb9ae}.empty{padding:44px 14px;text-align:center;color:#77736b}.actions{position:sticky;bottom:0;padding:30px 0 0;background:linear-gradient(transparent,#11110f 30%);display:flex;gap:8px}.manual{display:flex;gap:8px;margin-bottom:13px}.manual input{min-width:0}.match-source{font-size:10px;color:#8a867c;margin-top:5px}.ok{color:#c9f7be}.warn{color:#f4d99a}.danger{color:#ffb3a7}.asset-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:0 0 18px}.asset-strip img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:8px;border:1px solid #333}.asset-more{display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;border:1px dashed #444;border-radius:8px;color:#888;font-size:12px}.save-state{margin-top:10px;font-size:11px;color:#9d998f;min-height:17px}@media(max-width:1000px){main{grid-template-columns:220px 1fr}.right{grid-column:1/-1;border-top:1px solid #302f2a}.middle{border-right:0}}@media(max-width:720px){.top,.url{flex-direction:column;align-items:stretch}main{display:block}.pane{border-right:0;border-bottom:1px solid #302f2a}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / ARCHIVE SALVAGER v0.3</div><form id="loadForm" class="url"><input id="articleUrl" type="url" placeholder="https://harf-way.com/..." required><button id="loadBtn" class="btn primary">記事を読み込む</button></form></header>
<main>
<section class="pane"><div class="pad"><div class="label">Progress</div><div class="stat"><span>処理済み</span><strong id="doneCount">0</strong></div><div class="stat"><span>下書き</span><strong id="draftCount">0</strong></div><div class="stat"><span>Core games</span><strong id="gameCount">—</strong></div><div class="queue"><div class="label">Recent</div><div id="queue"></div></div></div></section>
<section class="pane middle"><div class="pad article" id="articlePane"><div class="empty">過去記事URLを入力すると本文・画像を読み込みます。</div></div></section>
<section class="pane right"><div class="pad"><div class="label">Shared Content Core / Link Candidates</div><div id="coreStatus" class="notice">Shared Content Coreを読み込んでいます…</div><div class="manual"><input id="manualQuery" placeholder="ゲーム名で候補を検索"><button id="manualBtn" class="btn" type="button">検索</button></div><div id="candidates"><div class="empty">記事を読み込んでください。</div></div><div class="actions"><button id="saveDraft" class="btn" disabled>Preview下書き保存</button><button id="saveNext" class="btn primary" disabled>保存して次へ →</button></div><div id="saveState" class="save-state"></div></div></section>
</main>
<script>
const $=s=>document.querySelector(s);const key='harfway-archive-salvager-v03';const state={games:[],article:null,candidates:[],coreOk:false,saving:false};
const esc=(v='')=>String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const norm=(v='')=>String(v).normalize('NFKC').toLowerCase().replace(/[\s:：・!！?？'"“”‘’()（）\[\]【】_\-～~]+/g,'');
function db(){try{return JSON.parse(localStorage.getItem(key)||'{"items":[]}')}catch{return {items:[]}}}function put(v){localStorage.setItem(key,JSON.stringify(v))}
function stats(){const d=db();$('#doneCount').textContent=d.items.filter(x=>x.status==='done').length;$('#draftCount').textContent=d.items.filter(x=>x.status==='draft').length;$('#gameCount').textContent=state.games.length||'—';$('#queue').innerHTML=d.items.slice(-8).reverse().map(x=>`<div class="queue-item">${esc(x.title||x.url)}<br><small>${x.links?.length||0} games · ${esc(x.status)}</small></div>`).join('')||'<div class="empty">まだありません</div>'}
function score(title,text){const a=norm(title),b=norm(text);if(!a||!b)return 0;if(b.includes(a))return 100;const p=String(title).toLowerCase().split(/[\s:：・_\-]+/).filter(x=>x.length>2);if(!p.length)return 0;return Math.round(p.filter(x=>String(text).toLowerCase().includes(x)).length/p.length*80)}
function excerpt(text,title){const raw=String(text||''),plain=raw.toLowerCase().indexOf(String(title||'').toLowerCase());return plain>=0?raw.slice(Math.max(0,plain-100),plain+String(title).length+180).replace(/\s+/g,' ').trim():''}
async function loadCore(){try{const r=await fetch('/api/core/games?limit=500',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok||!Array.isArray(j.games))throw new Error(j.error||'core_unavailable');state.games=j.games;state.coreOk=true;$('#coreStatus').innerHTML=`<span class="ok">● Core接続OK</span><br>${j.games.length}作品を照合対象として読み込みました。DB保存はPreview専用接続だけ許可されます。`}catch(e){state.games=[];state.coreOk=false;$('#coreStatus').innerHTML=`<span class="warn">● Coreを読み込めません</span><br>${esc(e.message)}`;}stats()}
function renderArticle(a){const imgs=Array.isArray(a.images)?a.images:[];const thumbs=imgs.slice(0,7).map(x=>`<img src="${esc(x.url)}" alt="${esc(x.alt||'')}">`).join('');const more=imgs.length>7?`<div class="asset-more">+${imgs.length-7}</div>`:'';$('#articlePane').innerHTML=`<h1>${esc(a.title||'Untitled')}</h1><div class="meta">${esc(a.date||'')} · ${imgs.length} images · <a style="color:#bbb" href="${esc(a.url)}" target="_blank" rel="noreferrer">元記事を開く ↗</a></div>${imgs.length?`<div class="asset-strip">${thumbs}${more}</div>`:''}<div class="body">${esc(a.text||'本文を取得できませんでした。')}</div>`}
function setCandidates(list){state.candidates=list;renderCandidates()}
function renderCandidates(){if(!state.candidates.length){$('#candidates').innerHTML='<div class="empty">一致候補がありません。上の検索欄から手動で探せます。</div>'}else{$('#candidates').innerHTML=state.candidates.map((g,i)=>`<label class="candidate"><div class="ctop"><input type="checkbox" data-i="${i}" ${g._score===100?'checked':''}><div><div class="title">${esc(g.title)}</div><div class="sub">${esc(g.category||'')} · ${esc(g.id)}</div><div class="match-source">${esc(g._source||'article match')}</div></div><span class="score">${g._score}%</span></div>${g._excerpt?`<div class="excerpt">…${esc(g._excerpt)}…</div>`:''}</label>`).join('')}$('#saveDraft').disabled=!state.article||state.saving;$('#saveNext').disabled=!state.article||state.saving}
function autoMatch(){const a=state.article;if(!a)return;setCandidates(state.games.map(g=>({...g,_score:score(g.title,a.text),_excerpt:excerpt(a.text,g.title),_source:'article title match'})).filter(g=>g._score>=60).sort((a,b)=>b._score-a._score).slice(0,40))}
function manualSearch(){const q=norm($('#manualQuery').value);if(!q)return autoMatch();const current=new Map(state.candidates.map(x=>[x.id,x]));for(const g of state.games){if(norm(g.title).includes(q)||q.includes(norm(g.title))){current.set(g.id,{...g,_score:95,_excerpt:state.article?excerpt(state.article.text,g.title):'',_source:'manual search'})}}setCandidates([...current.values()].sort((a,b)=>b._score-a._score).slice(0,50))}
function selected(){return [...document.querySelectorAll('#candidates input[type=checkbox]:checked')].map(el=>{const g=state.candidates[Number(el.dataset.i)];return {gameId:g.id,title:g.title,score:g._score,excerpt:g._excerpt,source:g._source}})}
function saveLocal(status){if(!state.article)return;const d=db(),item={url:state.article.url,title:state.article.title,date:state.article.date,status,links:selected(),savedAt:new Date().toISOString(),coreVersion:'0.3'};const i=d.items.findIndex(x=>x.url===item.url);if(i>=0)d.items[i]=item;else d.items.push(item);put(d);stats()}
async function saveRemote(status){if(!state.article||state.saving)return false;state.saving=true;renderCandidates();$('#saveState').textContent='Preview DBへ保存中…';try{const r=await fetch('/api/archive-save',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({article:state.article,links:selected(),status})});const j=await r.json().catch(()=>({}));if(!r.ok||!j.ok){if(j.error==='preview_database_not_configured'){$('#saveState').innerHTML='<span class="warn">Preview専用DBが未接続です。ブラウザ下書きだけ保存しました。</span>';return false}throw new Error(j.error||`save_${r.status}`)}$('#saveState').innerHTML=`<span class="ok">Preview DB保存OK</span> · ${j.content?.games?.length||0} games · ${j.content?.assets?.length||0} assets`;return true}catch(e){$('#saveState').innerHTML=`<span class="danger">DB保存失敗: ${esc(e.message)}</span>`;return false}finally{state.saving=false;renderCandidates()}}
async function save(status){saveLocal(status);return saveRemote(status)}
function clearForNext(){state.article=null;state.candidates=[];$('#articleUrl').value='';$('#manualQuery').value='';$('#articlePane').innerHTML='<div class="empty">保存しました。次の記事URLを入力してください。</div>';$('#candidates').innerHTML='<div class="empty">次の記事を待っています。</div>';$('#saveDraft').disabled=true;$('#saveNext').disabled=true;$('#articleUrl').focus()}
$('#loadForm').addEventListener('submit',async e=>{e.preventDefault();const url=$('#articleUrl').value.trim();if(!url)return;$('#loadBtn').disabled=true;$('#loadBtn').textContent='読み込み中…';$('#saveState').textContent='';$('#articlePane').innerHTML='<div class="empty">記事と画像を取得しています…</div>';$('#candidates').innerHTML='<div class="empty">Coreと照合しています…</div>';try{const r=await fetch('/api/archive-fetch?url='+encodeURIComponent(url)),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'fetch_failed');state.article=j.article;renderArticle(state.article);autoMatch()}catch(e){state.article=null;$('#articlePane').innerHTML=`<div class="empty">取得できませんでした。<br>${esc(e.message)}</div>`;$('#candidates').innerHTML='<div class="empty">—</div>'}finally{$('#loadBtn').disabled=false;$('#loadBtn').textContent='記事を読み込む'}});
$('#manualBtn').addEventListener('click',manualSearch);$('#manualQuery').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();manualSearch()}});$('#saveDraft').addEventListener('click',()=>save('draft'));$('#saveNext').addEventListener('click',async()=>{await save('done');clearForNext()});loadCore();stats();
</script>
</body></html>