<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HARF-WAY Archive Salvager</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#11110f;color:#f5f2eb}*{box-sizing:border-box}body{margin:0}.top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:18px;padding:18px 22px;background:#161614;border-bottom:1px solid #33322e}.brand{font-size:11px;letter-spacing:.16em;color:#a4a198;white-space:nowrap}.url{display:flex;gap:8px;flex:1}input,button{font:inherit}input{width:100%;border:1px solid #3c3a35;background:#181816;color:#f5f2eb;padding:10px 12px;border-radius:8px}.btn{border:1px solid #48463f;background:#25241f;color:#fff;padding:10px 14px;border-radius:8px;cursor:pointer}.btn.primary{background:#f0ede5;color:#111;border-color:#f0ede5;font-weight:700}.btn:disabled{opacity:.45;cursor:not-allowed}main{display:grid;grid-template-columns:285px minmax(400px,1fr) 440px;min-height:calc(100vh - 72px)}.pane{overflow:auto;border-right:1px solid #302f2a}.pane:last-child{border:0}.pad{padding:18px}.label{font-size:10px;letter-spacing:.14em;color:#8b8880;text-transform:uppercase;margin:0 0 10px}.stat{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #292823}.queue{margin-top:20px}.queue-item{width:100%;text-align:left;padding:11px;border:1px solid #302f2a;background:#171715;color:#c8c4b9;border-radius:8px;margin-bottom:8px;font-size:12px;cursor:pointer}.queue-item:hover{border-color:#605d54;background:#1d1d1a}.queue-item.active{border-color:#d8d1c2;background:#26241f;color:#fff}.article h1{font-size:28px;line-height:1.25;margin:0 0 8px}.meta{font-size:12px;color:#8f8b82;margin-bottom:16px}.body{white-space:pre-wrap;line-height:1.85;color:#d8d4ca}.thumbs{display:flex;gap:8px;overflow:auto;margin:0 0 18px}.thumbs img{width:110px;height:72px;object-fit:cover;border-radius:7px;border:1px solid #36342f}.notice{font-size:12px;line-height:1.6;background:#20201c;border:1px solid #39372f;border-radius:8px;padding:11px;margin-bottom:14px;color:#beb9ae}.ok{color:#c9f7be}.warn{color:#f4d99a}.empty{padding:34px 14px;text-align:center;color:#77736b}.manual{display:flex;gap:8px;margin-bottom:14px}.manual input{min-width:0}.hintbox{margin-bottom:14px;border:1px dashed #4b473f;border-radius:8px;padding:10px;font-size:11px;color:#aaa59a;line-height:1.55}.hintchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.chip{border:1px solid #403d36;border-radius:99px;padding:4px 8px;color:#c9c4b9;background:#1b1a18}.section-title{font-size:11px;font-weight:800;margin:18px 0 8px;color:#d7d2c8}.candidate{display:block;border:1px solid #37352f;background:#181816;border-radius:10px;padding:12px;margin:0 0 10px}.candidate.new{border-color:#756642;background:#1c1a14}.ctop{display:flex;align-items:flex-start;gap:9px}.ctop input{width:auto;margin-top:4px}.title{font-weight:700}.sub{font-size:11px;color:#949087;margin-top:3px}.source{font-size:10px;color:#8a867c;margin-top:5px}.score{margin-left:auto;border:1px solid #4d4a43;border-radius:99px;padding:3px 7px;font-size:10px;color:#bbb7ad;white-space:nowrap}.new .score{border-color:#806f48;color:#e6c985}.store{display:inline-block;margin-top:8px;font-size:11px;color:#ddd3b5}.excerpt{border-top:1px solid #2c2a26;margin-top:9px;padding-top:9px;font-size:12px;line-height:1.55;color:#aaa69c}.actions{position:sticky;bottom:0;padding:30px 0 0;background:linear-gradient(transparent,#11110f 30%);display:flex;gap:8px}.editbadge{display:inline-block;margin-left:8px;font-size:10px;padding:3px 6px;border:1px solid #625d51;border-radius:99px;color:#d6d0c4}@media(max-width:1050px){main{grid-template-columns:230px 1fr}.right{grid-column:1/-1;border-top:1px solid #302f2a}.middle{border-right:0}}@media(max-width:720px){.top,.url{flex-direction:column;align-items:stretch}main{display:block}.pane{border-right:0;border-bottom:1px solid #302f2a}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / ARCHIVE SALVAGER v0.5</div><form id="loadForm" class="url"><input id="articleUrl" type="url" placeholder="https://harf-way.com/..." required><button id="loadBtn" class="btn primary">記事を読み込む</button></form></header>
<main>
<section class="pane"><div class="pad"><div class="label">Progress</div><div class="stat"><span>処理済み</span><strong id="doneCount">0</strong></div><div class="stat"><span>下書き</span><strong id="draftCount">0</strong></div><div class="stat"><span>Core games</span><strong id="gameCount">—</strong></div><div class="queue"><div class="label">Saved / クリックで再編集</div><div id="queue"></div></div></div></section>
<section class="pane middle"><div class="pad article" id="articlePane"><div class="empty">過去記事URLを入力するか、左の保存済み記事を選んでください。</div></div></section>
<section class="pane right"><div class="pad"><div class="label">Game Link Candidates</div><div id="coreStatus" class="notice">Shared Content Coreを読み込んでいます…</div><div id="hintBox" class="hintbox" style="display:none"></div><div class="manual"><input id="manualQuery" placeholder="ゲーム名で既存DBを検索"><button id="manualBtn" class="btn" type="button">検索</button></div><div id="candidatePane"><div class="empty">記事を読み込んでください。</div></div><div class="actions"><button id="saveDraft" class="btn" disabled>下書き保存</button><button id="saveNext" class="btn primary" disabled>保存して次へ →</button></div></div></section>
</main>
<script>
const $=s=>document.querySelector(s);const key='harfway-archive-salvager-v04';
const state={games:[],article:null,existing:[],unresolved:[],remoteItems:[],editingUrl:'',savedExisting:[],savedUnresolved:[]};
const esc=(v='')=>String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const norm=(v='')=>String(v).normalize('NFKC').toLowerCase().replace(/[\s:：・!！?？'"“”‘’()（）\[\]【】_\-–—～~]+/g,'');
function localDb(){try{return JSON.parse(localStorage.getItem(key)||'{"items":[]}')}catch{return {items:[]}}}function putLocal(v){localStorage.setItem(key,JSON.stringify(v))}
function allSaved(){const map=new Map();for(const x of state.remoteItems||[])map.set(x.url,{...x,_origin:'db'});for(const x of localDb().items||[])map.set(x.url,{...map.get(x.url),...x,_origin:'local'});return [...map.values()].sort((a,b)=>String(b.savedAt||b.updated_at||'').localeCompare(String(a.savedAt||a.updated_at||'')))}
function stats(){const d=localDb();$('#doneCount').textContent=d.items.filter(x=>x.status==='done').length;$('#draftCount').textContent=d.items.filter(x=>x.status==='draft').length;$('#gameCount').textContent=state.games.length||'—';const items=allSaved();$('#queue').innerHTML=items.slice(0,50).map(x=>`<button class="queue-item ${state.editingUrl===x.url?'active':''}" data-url="${esc(x.url)}"><strong>${esc(x.title||x.url)}</strong><br><small>${Number(x.game_count??x.links?.length??0)} linked · ${Number(x.unresolved?.length??x.metadata?.unresolvedGames?.length??0)} pending · ${esc(x.status||'saved')}</small></button>`).join('')||'<div class="empty">まだありません</div>';document.querySelectorAll('.queue-item').forEach(el=>el.addEventListener('click',()=>openSaved(el.dataset.url)))}
function textScore(title,text){const a=norm(title),b=norm(text);if(!a||!b)return 0;if(b.includes(a))return 100;const p=String(title).toLowerCase().split(/[\s:：・_\-–—]+/).filter(x=>x.length>2);return p.length?Math.round(p.filter(x=>String(text).toLowerCase().includes(x)).length/p.length*80):0}
function hintScore(game,hints){let best=0,source='';for(const h of hints||[]){const a=norm(game.title),b=norm(h.name);if(!a||!b)continue;let s=0;if(a===b)s=100;else if(a.includes(b)||b.includes(a))s=Math.min(98,Number(h.confidence||96));else{const gp=String(game.title).toLowerCase().split(/[\s:：・_\-–—]+/).filter(x=>x.length>2);s=Math.round(gp.filter(x=>String(h.name).toLowerCase().includes(x)).length/Math.max(1,gp.length)*90)}if(s>best){best=s;source=h.source||'name-hint'}}return {score:best,source}}
function excerpt(text,title){const raw=String(text||''),i=raw.toLowerCase().indexOf(String(title||'').toLowerCase());return i>=0?raw.slice(Math.max(0,i-100),i+String(title).length+180).replace(/\s+/g,' ').trim():''}
function sourceLabel(s=''){return ({'page-title-short':'記事タイトル','page-title':'記事タイトル','page-slug':'記事URL','store-link-text':'ストアリンク','steam-slug':'Steam URL','itch-slug':'itch.io URL','script-game-title':'記事内ゲームデータ'}[s]||s)}
function findStoreForHint(h,hints){if(h.url)return h.url;const n=norm(h.name);const exact=(hints||[]).find(x=>x.url&&(norm(x.name)===n||norm(x.name).includes(n)||n.includes(norm(x.name))));if(exact)return exact.url;const stores=(hints||[]).filter(x=>x.url);return stores.length===1?stores[0].url:''}
function buildCandidates(selectedExisting=[],selectedNew=[]){const a=state.article;if(!a)return;const hints=a.nameHints||[];const haystack=[a.title,a.text,a.url].join('\n');state.existing=state.games.map(g=>{const t=textScore(g.title,haystack),h=hintScore(g,hints),best=Math.max(t,h.score);return {...g,_score:best,_source:h.score>=t&&h.score?sourceLabel(h.source):'本文一致',_excerpt:excerpt(a.text,g.title)}}).filter(g=>g._score>=60).sort((a,b)=>b._score-a._score).slice(0,60);
  const matchedHints=new Set();for(const g of state.existing){for(const h of hints){const a1=norm(g.title),b1=norm(h.name);if(a1&&b1&&(a1===b1||a1.includes(b1)||b1.includes(a1)))matchedHints.add(h)}}
  const unresolved=[];for(const h of hints.slice().sort((a,b)=>Number(b.confidence||0)-Number(a.confidence||0))){if(matchedHints.has(h)||Number(h.confidence||0)<82)continue;const n=norm(h.name);if(!n)continue;if(unresolved.some(x=>{const m=norm(x.name);return m===n||m.includes(n)||n.includes(m)}))continue;unresolved.push({name:h.name,url:findStoreForHint(h,hints),source:h.source,confidence:Number(h.confidence||0)});if(unresolved.length>=12)break}state.unresolved=unresolved;renderCandidates(selectedExisting,selectedNew)}
function renderHints(){const hints=state.article?.nameHints||[];if(!hints.length){$('#hintBox').style.display='none';return}$('#hintBox').style.display='block';$('#hintBox').innerHTML=`記事から拾った名前候補 <strong>${hints.length}</strong>件<div class="hintchips">${hints.slice(0,12).map(h=>`<span class="chip">${esc(h.name)}</span>`).join('')}</div>`}
function renderCandidates(selectedExisting=[],selectedNew=[]){const exSet=new Set(selectedExisting),newSet=new Set(selectedNew.map(norm));let html='';if(state.existing.length){html+='<div class="section-title">既存DBと一致</div>'+state.existing.map((g,i)=>`<label class="candidate"><div class="ctop"><input class="existing-check" type="checkbox" data-i="${i}" ${g._score===100||exSet.has(g.id)?'checked':''}><div><div class="title">${esc(g.title)}</div><div class="sub">${esc(g.category||'')} · ${esc(g.id)}</div><div class="source">${esc(g._source)}</div>${g.storeUrl?`<a class="store" href="${esc(g.storeUrl)}" target="_blank" rel="noreferrer">STORE PAGE ↗</a>`:''}</div><span class="score">${g._score}%</span></div>${g._excerpt?`<div class="excerpt">…${esc(g._excerpt)}…</div>`:''}</label>`).join('')}
if(state.unresolved.length){html+='<div class="section-title">DB未登録候補</div>'+state.unresolved.map((g,i)=>`<label class="candidate new"><div class="ctop"><input class="new-check" type="checkbox" data-i="${i}" ${newSet.has(norm(g.name))||(!selectedNew.length&&g.confidence>=96&&i===0)?'checked':''}><div><div class="title">${esc(g.name)}</div><div class="sub">DB未登録 · 保存して後でゲーム化</div><div class="source">${esc(sourceLabel(g.source))}</div>${g.url?`<a class="store" href="${esc(g.url)}" target="_blank" rel="noreferrer">取得したSTORE PAGE ↗</a>`:''}</div><span class="score">${g.confidence}%</span></div></label>`).join('')}
if(!html)html='<div class="empty">ゲーム候補を拾えませんでした。上の検索欄から既存DBを検索できます。</div>';$('#candidatePane').innerHTML=html;$('#saveDraft').disabled=!state.article;$('#saveNext').disabled=!state.article}
function selectedExisting(){return [...document.querySelectorAll('.existing-check:checked')].map(el=>{const g=state.existing[Number(el.dataset.i)];return {gameId:g.id,title:g.title,score:g._score,excerpt:g._excerpt,source:g._source}})}
function selectedUnresolved(){return [...document.querySelectorAll('.new-check:checked')].map(el=>state.unresolved[Number(el.dataset.i)]).filter(Boolean)}
async function loadCore(){try{const r=await fetch('/api/core/games?limit=500',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok||!Array.isArray(j.games))throw new Error(j.error||'core_unavailable');state.games=j.games;$('#coreStatus').innerHTML=`<span class="ok">● Core接続OK</span><br>${j.games.length}作品と照合。未登録作品は記事タイトル・URL・ストアリンクから別枠で拾います。`}catch(e){state.games=[];$('#coreStatus').innerHTML=`<span class="warn">● Coreを読み込めません</span><br>${esc(e.message)}`;}stats()}
async function loadRemote(){try{const r=await fetch('/api/archive-items',{cache:'no-store'}),j=await r.json();if(j.ok&&Array.isArray(j.items))state.remoteItems=j.items}catch{}stats()}
function renderArticle(){const a=state.article,imgs=(a?.images||[]).slice(0,12);$('#articlePane').innerHTML=`<h1>${esc(a?.title||'Untitled')}${state.editingUrl?'<span class="editbadge">再編集中</span>':''}</h1><div class="meta">${esc(a?.date||'')} · <a style="color:#bbb" href="${esc(a?.url||'')}" target="_blank" rel="noreferrer">元記事を開く ↗</a> · ${(a?.images||[]).length} images</div>${imgs.length?`<div class="thumbs">${imgs.map(x=>`<img src="${esc(x.url)}" alt="${esc(x.alt||'')}">`).join('')}</div>`:''}<div class="body">${esc(a?.text||'本文を取得できませんでした。')}</div>`;renderHints()}
async function fetchArticle(url,selectedExisting=[],selectedNew=[]){$('#loadBtn').disabled=true;$('#loadBtn').textContent='読み込み中…';try{const r=await fetch('/api/archive-fetch?url='+encodeURIComponent(url)),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||'fetch_failed');state.article=j.article;$('#articleUrl').value=j.article.url;renderArticle();buildCandidates(selectedExisting,selectedNew);return true}catch(e){$('#articlePane').innerHTML=`<div class="empty">取得できませんでした。<br>${esc(e.message)}</div>`;return false}finally{$('#loadBtn').disabled=false;$('#loadBtn').textContent='記事を読み込む'}}
async function openSaved(url){state.editingUrl=url;stats();const local=(localDb().items||[]).find(x=>x.url===url);if(local?.article){state.article=local.article;state.savedExisting=(local.links||[]).map(x=>x.gameId);state.savedUnresolved=(local.unresolved||[]).map(x=>x.name);$('#articleUrl').value=url;renderArticle();buildCandidates(state.savedExisting,state.savedUnresolved);return}try{const r=await fetch('/api/archive-items?url='+encodeURIComponent(url),{cache:'no-store'}),j=await r.json(),x=j.item;if(x){const md=x.metadata||{};state.article={url:x.url,title:x.title,date:x.published_at||'',text:x.body_text||'',featuredImage:x.featured_image_url||'',images:(x.assets||[]).map(a=>({url:a.sourceUrl||a.source_url,alt:a.altText||a.alt_text||'',featured:a.assetType==='featured_image'})),nameHints:md.nameHints||[],storeLinks:md.storeLinks||[]};state.savedExisting=(x.games||[]).map(g=>g.gameId);state.savedUnresolved=(md.unresolvedGames||[]).map(g=>g.name);$('#articleUrl').value=url;renderArticle();buildCandidates(state.savedExisting,state.savedUnresolved)}}catch(e){$('#coreStatus').innerHTML=`<span class="warn">● 再編集読み込み失敗</span><br>${esc(e.message)}`}}
async function persist(status){if(!state.article)return;const links=selectedExisting(),unresolved=selectedUnresolved(),d=localDb(),item={url:state.article.url,title:state.article.title,date:state.article.date,status,links,unresolved,article:state.article,savedAt:new Date().toISOString(),coreVersion:'0.5'};const i=d.items.findIndex(x=>x.url===item.url);if(i>=0)d.items[i]=item;else d.items.push(item);putLocal(d);state.editingUrl=item.url;stats();try{const r=await fetch('/api/archive-save',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({article:state.article,links,unresolved,status})}),j=await r.json();if(r.ok&&j.ok){$('#coreStatus').innerHTML=`<span class="ok">● Preview DB保存OK</span><br>${links.length}既存作品 + ${unresolved.length}未登録候補を保存しました。`;await loadRemote()}else if(j.error==='preview_database_not_configured'){$('#coreStatus').innerHTML=`<span class="warn">● ブラウザ保存OK</span><br>${links.length}既存作品 + ${unresolved.length}未登録候補。Preview DBは安全ロック中です。`}else throw new Error(j.error||'save_failed')}catch(e){$('#coreStatus').innerHTML=`<span class="warn">● ブラウザ保存OK / DB保存失敗</span><br>${esc(e.message)}`}}
function manualSearch(){const q=norm($('#manualQuery').value);if(!q)return buildCandidates(state.savedExisting,state.savedUnresolved);const hits=state.games.filter(g=>norm(g.title).includes(q)||q.includes(norm(g.title))).slice(0,30);for(const g of hits){if(!state.existing.some(x=>x.id===g.id))state.existing.unshift({...g,_score:95,_source:'手動検索',_excerpt:''})}renderCandidates(state.savedExisting,state.savedUnresolved)}
$('#loadForm').addEventListener('submit',async e=>{e.preventDefault();state.editingUrl='';state.savedExisting=[];state.savedUnresolved=[];await fetchArticle($('#articleUrl').value.trim())});$('#manualBtn').addEventListener('click',manualSearch);$('#manualQuery').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();manualSearch()}});$('#saveDraft').addEventListener('click',()=>persist('draft'));$('#saveNext').addEventListener('click',async()=>{await persist('done');state.article=null;state.existing=[];state.unresolved=[];state.editingUrl='';state.savedExisting=[];state.savedUnresolved=[];$('#articleUrl').value='';$('#manualQuery').value='';$('#articlePane').innerHTML='<div class="empty">保存しました。次の記事URLを入力してください。</div>';$('#candidatePane').innerHTML='<div class="empty">次の記事を待っています。</div>';$('#hintBox').style.display='none';$('#saveDraft').disabled=true;$('#saveNext').disabled=true;stats();$('#articleUrl').focus()});
loadCore();loadRemote();stats();
</script>
</body></html>
