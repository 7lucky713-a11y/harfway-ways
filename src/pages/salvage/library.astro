<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY Archive Library</title>
<style>
:root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif;background:#10110f;color:#f3f1e9;--line:#34352f;--muted:#94958d;--panel:#171815;--accent:#eff0df}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 10% -20%,#2b2d1f,transparent 34%),#10110f}.wrap{width:min(1260px,calc(100% - 32px));margin:auto;padding:32px 0 80px}.head{display:flex;gap:24px;justify-content:space-between;align-items:end;border-bottom:1px solid var(--line);padding-bottom:22px}.ey{font:800 10px/1.2 ui-monospace,monospace;letter-spacing:.16em;color:#aaa98e}.head h1{font-size:clamp(42px,7vw,82px);line-height:.85;letter-spacing:-.06em;margin:12px 0}.head p{margin:0;color:var(--muted);font-size:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 13px;border:1px solid var(--line);border-radius:9px;background:#1d1e1a;color:#fff;text-decoration:none;font-weight:750;font-size:12px;cursor:pointer}.btn.primary{background:#f0eee4;color:#111;border-color:#f0eee4}.mode{margin:16px 0;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:#151611;color:#bbbbae;font:11px/1.5 ui-monospace,monospace}.mode.warn{border-color:#665932;color:#e8d69b;background:#1c1a12}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.stat{padding:16px;border:1px solid var(--line);background:var(--panel);border-radius:12px}.stat small{color:var(--muted);font-size:10px}.stat b{display:block;font-size:30px;margin-top:6px}.tools{display:grid;grid-template-columns:minmax(240px,1fr) auto;gap:9px;margin:20px 0}.tools input{width:100%;height:42px;border:1px solid var(--line);border-radius:9px;background:#151613;color:#fff;padding:0 12px;font:inherit}.filters{display:flex;border:1px solid var(--line);border-radius:9px;overflow:hidden}.filters button{border:0;border-right:1px solid var(--line);background:#171814;color:#999;padding:0 13px;font-weight:700;cursor:pointer}.filters button:last-child{border:0}.filters button.on{background:#eeece1;color:#111}.list{display:grid;gap:9px}.item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;padding:16px;border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,#181916,#141512)}.item.local{border-color:#5c5334}.title{font-size:19px;font-weight:850;line-height:1.3}.meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:7px;color:var(--muted);font-size:10px}.pill{display:inline-block;border:1px solid #45473e;border-radius:999px;padding:3px 7px;color:#c9c8bb}.pill.local{border-color:#6f6239;color:#e4ce89}.pill.core{border-color:#3c6548;color:#a9e5b9}.games{margin-top:9px;display:flex;gap:6px;flex-wrap:wrap}.game{font-size:10px;border:1px solid #3d4038;border-radius:999px;padding:4px 7px;background:#1b1d18;color:#d1d0c4}.links{display:flex;align-items:center;gap:7px;flex-wrap:wrap;justify-content:flex-end}.empty{padding:60px 20px;text-align:center;border:1px dashed var(--line);color:var(--muted);border-radius:12px}.login{position:fixed;inset:0;background:#000c;display:none;place-items:center;padding:20px;z-index:20}.login.on{display:grid}.box{width:min(460px,100%);padding:22px;border:1px solid var(--line);border-radius:14px;background:#171815}.box h2{margin:8px 0 16px;font-size:28px}.box input{width:100%;height:44px;border:1px solid var(--line);border-radius:9px;background:#0f100e;color:#fff;padding:0 12px}.box .row{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.error{color:#ffc0c0;font-size:11px;margin-top:9px}@media(max-width:800px){.head{display:block}.actions{margin-top:14px}.stats{grid-template-columns:1fr 1fr}.tools{grid-template-columns:1fr}.filters{overflow:auto}.item{grid-template-columns:1fr}.links{justify-content:flex-start}}
</style>
</head>
<body>
<main class="wrap">
<header class="head"><div><div class="ey">HARF-WAY / SHARED CONTENT CORE</div><h1>ARCHIVE<br>LIBRARY</h1><p>Archive Salvagerで回収した過去記事を確認する。Previewではローカル保存も表示します。</p></div><div class="actions"><a class="btn" href="/db-master/">DB MASTER ↗</a><a class="btn primary" href="/salvage/">＋ サルベージする</a></div></header>
<div id="mode" class="mode">接続状態を確認しています…</div>
<section class="stats" id="stats"></section>
<section class="tools"><input id="q" placeholder="記事名 / URL / ゲーム名で検索"><div class="filters" id="filters"></div></section>
<section id="list" class="list"><div class="empty">保存記事を読み込み中…</div></section>
</main>
<div class="login" id="login"><div class="box"><div class="ey">PRIVATE ARCHIVE</div><h2>管理キー</h2><p>本番のShared Content Coreを確認するため、WAYSと同じ管理キーを入力してください。</p><input id="key" type="password" autocomplete="current-password"><div id="loginError" class="error"></div><div class="row"><button id="cancel" class="btn">閉じる</button><button id="go" class="btn primary">開く</button></div></div></div>
<script>
const $=s=>document.querySelector(s);const KEY='hw_salvager_admin_key';const LOCAL_KEY='harfway-archive-salvager-v06';let items=[],filter='ALL',status={};
const esc=(v='')=>String(v).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const admin=()=>sessionStorage.getItem(KEY)||'';
function localItems(){try{const raw=JSON.parse(localStorage.getItem(LOCAL_KEY)||'{"items":[]}');return (raw.items||[]).map(x=>({id:`local:${x.url}`,title:x.title||x.article?.title||x.url,url:x.url||x.article?.url||'',published_at:x.date||x.article?.date||null,status:x.status==='done'?'reviewed':(x.status||'draft'),game_count:Array.isArray(x.links)?x.links.length:0,asset_count:Array.isArray(x.article?.images)?x.article.images.length:0,games:(x.links||[]).map(g=>({title:g.title||g.gameId||'',gameId:g.gameId||''})),updated_at:x.savedAt||null,_origin:'local'})).filter(x=>x.url)}catch{return []}}
async function api(url,opt={}){const headers={...(opt.headers||{})};if(admin())headers['X-Admin-Key']=admin();const r=await fetch(url,{cache:'no-store',...opt,headers});const j=await r.json().catch(()=>({}));if(r.status===401){sessionStorage.removeItem(KEY);showLogin(j.error||'admin_key_required');throw new Error('AUTH')}if(!r.ok||j.ok===false)throw new Error(j.error||`HTTP ${r.status}`);return j}
function showLogin(message=''){if(message&&message!=='admin_key_required')$('#loginError').textContent='管理キーを確認してください。';$('#login').classList.add('on');setTimeout(()=>$('#key').focus(),30)}
function gameNames(x){return Array.isArray(x.games)?x.games.map(g=>g.title||g.name||g.game_title||g.gameId||g.game_id).filter(Boolean):[]}
function mergeItems(remote,local){const map=new Map();for(const x of local)map.set(x.url,x);for(const x of remote)map.set(x.url,{...x,_origin:'core'});return [...map.values()].sort((a,b)=>String(b.updated_at||'').localeCompare(String(a.updated_at||'')))}
function render(){const q=$('#q').value.trim().toLowerCase();const visible=items.filter(x=>(filter==='ALL'||filter==='LOCAL'&&x._origin==='local'||filter==='CORE'&&x._origin==='core'||x.status===filter)&&(!q||[x.title,x.url,...gameNames(x)].join(' ').toLowerCase().includes(q)));const reviewed=items.filter(x=>x.status==='reviewed'||x.status==='published').length,draft=items.filter(x=>x.status==='draft').length,games=items.reduce((n,x)=>n+Number(x.game_count||0),0);$('#stats').innerHTML=[['SAVED',items.length],['REVIEWED',reviewed],['DRAFT',draft],['GAME LINKS',games]].map(([a,b])=>`<div class="stat"><small>${a}</small><b>${b}</b></div>`).join('');const origins=[...new Set(items.map(x=>x._origin).filter(Boolean))];const fs=['ALL',...(origins.includes('local')?['LOCAL']:[]),...(origins.includes('core')?['CORE']:[]),...new Set(items.map(x=>x.status).filter(Boolean))];$('#filters').innerHTML=fs.map(x=>`<button data-f="${esc(x)}" class="${x===filter?'on':''}">${esc(x)}</button>`).join('');$('#list').innerHTML=visible.length?visible.map(x=>{const names=gameNames(x),origin=x._origin==='local'?'LOCAL':'CORE';return `<article class="item ${x._origin==='local'?'local':''}"><div><div class="title">${esc(x.title||'Untitled')}</div><div class="meta"><span class="pill ${x._origin==='local'?'local':'core'}">${origin}</span><span class="pill">${esc(x.status||'saved')}</span><span>${Number(x.game_count||0)} games</span><span>${Number(x.asset_count||0)} images</span><span>更新 ${esc(x.updated_at?new Date(x.updated_at).toLocaleString('ja-JP'):'—')}</span></div>${names.length?`<div class="games">${names.slice(0,8).map(n=>`<span class="game">${esc(n)}</span>`).join('')}</div>`:''}</div><div class="links"><a class="btn" href="${esc(x.url)}" target="_blank" rel="noreferrer">元記事 ↗</a><a class="btn primary" href="/salvage/?url=${encodeURIComponent(x.url)}">再編集</a></div></article>`}).join(''):'<div class="empty">該当する保存記事はありません。</div>'}
async function load(){const local=localItems();try{status=await fetch('/api/archive-status',{cache:'no-store'}).then(r=>r.json());if(status.authRequired&&!admin()){items=mergeItems([],local);$('#mode').textContent=`${status.environment||'unknown'} / 管理キー入力前 / LOCAL ${local.length}件`;render();showLogin();return}let remote=[];try{const j=await api('/api/archive-items?limit=500');remote=j.items||[]}catch(e){if(e.message==='AUTH')return}items=mergeItems(remote,local);const localOnly=items.filter(x=>x._origin==='local').length;$('#mode').classList.toggle('warn',localOnly>0);$('#mode').textContent=status.databaseConfigured?`${status.environment||'unknown'} / ${status.writeMode||'unknown'} / CORE ${remote.length}件 / LOCAL未同期 ${localOnly}件`:`${status.environment||'unknown'} / Preview DB未接続 / LOCAL ${local.length}件を表示中（本番DBには未保存）`;render()}catch(e){items=mergeItems([],local);$('#mode').classList.add('warn');$('#mode').textContent=`LOCAL ${local.length}件を表示中 / API確認失敗`;render()}}
$('#filters').onclick=e=>{const b=e.target.closest('[data-f]');if(b){filter=b.dataset.f;render()}};$('#q').oninput=render;$('#cancel').onclick=()=>$('#login').classList.remove('on');$('#go').onclick=async()=>{const v=$('#key').value.trim();if(!v)return;sessionStorage.setItem(KEY,v);$('#loginError').textContent='';$('#login').classList.remove('on');await load()};$('#key').onkeydown=e=>{if(e.key==='Enter')$('#go').click()};load();
</script>
</body></html>
