<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY Steam Link Editor</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#11110f;color:#f5f2eb}*{box-sizing:border-box}body{margin:0;background:#11110f;color:#f5f2eb}header{display:flex;gap:10px;align-items:center;padding:16px 20px;background:#171715;border-bottom:1px solid #302f2a}.brand{font-size:11px;letter-spacing:.15em;color:#aaa59a;margin-right:auto}a{color:#d8d1c2;text-decoration:none}.btn{border:1px solid #48463f;background:#25241f;color:#fff;padding:9px 12px;border-radius:8px;cursor:pointer;font:inherit}.btn.primary{background:#f0ede5;color:#111;border-color:#f0ede5;font-weight:700}.btn.danger{border-color:#67443d;color:#f0b4a6}.btn:disabled{opacity:.45}main{max-width:980px;margin:0 auto;padding:28px 20px 80px}.intro h1{font-size:30px;margin:0 0 8px}.intro p{color:#a8a399;line-height:1.7}.search{display:flex;gap:8px;margin:20px 0 16px}.search input,.editor input{width:100%;border:1px solid #3c3a35;background:#181816;color:#f5f2eb;padding:11px 12px;border-radius:8px;font:inherit}.status{padding:11px 12px;border:1px solid #39372f;background:#20201c;border-radius:8px;color:#bbb5aa;font-size:12px;line-height:1.6;margin-bottom:16px}.ok{color:#c9f7be}.warn{color:#f4d99a}.results{display:grid;gap:10px}.card{border:1px solid #34322d;background:#181816;border-radius:10px;padding:14px}.card.new{border-color:#756444;background:#1d1a14}.title{font-size:16px;font-weight:700}.meta,.help,.current{font-size:11px;color:#8f8b82;line-height:1.6;margin-top:5px;overflow-wrap:anywhere}.resolved{display:inline-block;margin-top:8px;padding:4px 7px;border:1px solid #4b473f;border-radius:99px;font-size:10px;color:#c9b47f}.editor{display:none;margin-top:22px;border:1px solid #514b40;background:#191814;border-radius:12px;padding:18px}.editor.active{display:block}.edit-title{font-size:21px;font-weight:700}.label{display:block;font-size:10px;letter-spacing:.12em;color:#8b8880;text-transform:uppercase;margin:16px 0 7px}.edit-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}.empty{padding:38px 12px;text-align:center;color:#77736b}@media(max-width:640px){header{flex-wrap:wrap}.brand{width:100%}.search{flex-direction:column}}
</style>
</head>
<body>
<header><div class="brand">HARF-WAY / STEAM LINK EDITOR v0.9.1</div><a class="btn" href="/salvage/">Salvagerへ戻る</a><button id="authBtn" class="btn" type="button">管理キー</button></header>
<main>
<section class="intro"><h1>Steamリンクを手動修正</h1><p>ゲーム名・Steam URL・App IDで検索できます。Steam URLがまだDBに無い場合は、Steamから作品名を取得して新規登録候補を表示します。</p></section>
<form id="searchForm" class="search"><input id="query" placeholder="ゲーム名 / Steam URL / App IDで検索" autocomplete="off"><button class="btn primary">検索</button></form>
<div id="status" class="status">ゲーム名、Steam URL、またはApp IDを入力してください。</div>
<div id="results" class="results"></div>
<section id="editor" class="editor"><div id="editTitle" class="edit-title"></div><div id="current" class="current"></div><label class="label" for="storeUrl">Steam URL</label><input id="storeUrl" type="url" placeholder="https://store.steampowered.com/app/123456/Game_Name/"><div class="help">Steamの /app/数字/ 形式を入力してください。空欄で保存するとSteamリンクを解除します。</div><div class="edit-actions"><button id="saveBtn" class="btn primary" type="button">Steamリンクを保存</button><button id="clearBtn" class="btn danger" type="button">リンクを解除</button><button id="cancelBtn" class="btn" type="button">閉じる</button></div></section>
</main>
<script>
const $=s=>document.querySelector(s),ADMIN_KEY='hw_salvager_admin_key';let selectedGame=null,runtime={authRequired:false},lastSteam=null;
const esc=v=>String(v||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[m]));
const admin=()=>sessionStorage.getItem(ADMIN_KEY)||'';
function askAdmin(){const v=prompt('WAYSと同じ管理キーを入力してください',admin());if(v&&v.trim()){sessionStorage.setItem(ADMIN_KEY,v.trim());return true}return false}
async function authFetch(url,opt={},retry=true){const h={...(opt.headers||{})};if(admin())h['X-Admin-Key']=admin();const r=await fetch(url,{...opt,headers:h});if(r.status===401&&runtime.authRequired&&retry){sessionStorage.removeItem(ADMIN_KEY);if(askAdmin())return authFetch(url,opt,false)}return r}
function setStatus(v){$('#status').innerHTML=v}
function appId(v=''){const s=String(v).trim();if(/^\d+$/.test(s))return s;try{return new URL(s).pathname.match(/\/app\/(\d+)/)?.[1]||''}catch{return ''}}
async function coreSearch(q){const r=await fetch('/api/core/games?q='+encodeURIComponent(q)+'&limit=50&t='+Date.now(),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'search_failed');return j.games||[]}
async function resolveSteam(q){const r=await fetch('/api/steam-resolve?url='+encodeURIComponent(q)+'&t='+Date.now(),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'steam_lookup_failed');return j}
function renderGames(games,suggested=''){setStatus(`<span class="ok">● ${games.length}件見つかりました</span>`);$('#results').innerHTML=games.map((g,i)=>`<div class="card"><div class="title">${esc(g.title)}</div><div class="meta">ID: ${esc(g.id)}<br>現在: ${esc(g.storeUrl||'未登録')}</div>${suggested&&suggested!==g.storeUrl?`<div class="resolved">入力候補: ${esc(suggested)}</div>`:''}<br><button class="btn editGame" data-i="${i}">編集する</button></div>`).join('')||'<div class="empty">一致するゲームがありません。</div>';document.querySelectorAll('.editGame').forEach(b=>b.onclick=()=>openEditor(games[+b.dataset.i],suggested))}
function renderNew(meta){lastSteam=meta;setStatus(`<span class="warn">● Core DBには未登録です</span><br>Steamでは「${esc(meta.name)}」として取得できました。`);$('#results').innerHTML=`<div class="card new"><div class="title">${esc(meta.name)}</div><div class="meta">Steam App ID: ${esc(meta.appId)}<br>${esc(meta.storeUrl)}</div><div class="resolved">DB未登録</div><br><button id="registerSteam" class="btn primary">このSteam作品をゲームDBへ登録</button></div>`;$('#registerSteam').onclick=registerSteam}
async function searchGames(q){setStatus('検索しています…');$('#results').innerHTML='';lastSteam=null;try{const id=appId(q);if(id){let games=await coreSearch(id);const meta=await resolveSteam(q);if(!games.length)games=await coreSearch(meta.storeUrl);if(!games.length)games=await coreSearch(meta.name);return games.length?renderGames(games,meta.storeUrl):renderNew(meta)}renderGames(await coreSearch(q))}catch(e){setStatus(`<span class="warn">● 検索失敗</span><br>${esc(e.message)}`)}}
async function registerSteam(){if(!lastSteam)return;const b=$('#registerSteam');b.disabled=true;b.textContent='登録中…';try{const r=await authFetch('/api/archive-create-game',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title:lastSteam.name,storeUrl:lastSteam.storeUrl,articleUrl:''})}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'create_failed');const g={id:j.game.id,title:j.game.title,storeUrl:j.game.store_url||lastSteam.storeUrl,previewOnly:!!j.previewOnly};$('#results').innerHTML='';setStatus(j.simulated?`<span class="ok">● Preview仮登録OK</span><br>${esc(g.title)} / 本番DBにはまだ反映していません。`:`<span class="ok">● ゲームDBへ登録しました</span><br>${esc(g.title)}`);openEditor(g,lastSteam.storeUrl)}catch(e){b.disabled=false;b.textContent='このSteam作品をゲームDBへ登録';setStatus(`<span class="warn">● 登録できません</span><br>${esc(e.message)}`)}}
function openEditor(g,suggested=''){selectedGame=g;$('#editTitle').textContent=g.title;$('#current').textContent='現在: '+(g.storeUrl||'Steamリンク未登録')+(g.previewOnly?' / Preview仮登録':'');$('#storeUrl').value=suggested||g.storeUrl||'';$('#editor').classList.add('active');$('#storeUrl').focus()}
function closeEditor(){selectedGame=null;$('#editor').classList.remove('active')}
async function saveStore(url){if(!selectedGame)return;const b=$('#saveBtn');b.disabled=true;setStatus('保存しています…');try{const r=await authFetch('/api/archive-update-store',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({gameId:selectedGame.id,storeUrl:url})}),j=await r.json();if(!r.ok||!j.ok)throw Error((j.message||j.error||'update_failed')+(j.existingGame?.title?' / 既存: '+j.existingGame.title:''));selectedGame={...selectedGame,storeUrl:j.game?.store_url||'',previewOnly:selectedGame.previewOnly||!!j.previewOnly};$('#current').textContent='現在: '+(selectedGame.storeUrl||'Steamリンク未登録')+(selectedGame.previewOnly?' / Preview仮変更':'');$('#storeUrl').value=selectedGame.storeUrl||'';setStatus(j.simulated?`<span class="ok">● Preview仮変更OK</span><br>${esc(selectedGame.title)} → ${esc(selectedGame.storeUrl||'Steamリンク解除')} / 本番DBには未反映です。`:`<span class="ok">● 更新しました</span><br>${esc(selectedGame.title)} → ${esc(selectedGame.storeUrl||'Steamリンク解除')}`)}catch(e){setStatus(`<span class="warn">● 更新できません</span><br>${esc(e.message)}`)}finally{b.disabled=false}}
async function openById(id,url=''){try{const r=await fetch('/api/core/games?id='+encodeURIComponent(id)+'&t='+Date.now(),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.games?.[0])throw Error('game_not_found');openEditor(j.games[0],url);setStatus(`<span class="ok">● 対象ゲームを開きました</span><br>${esc(j.games[0].title)}`)}catch(e){setStatus(`<span class="warn">● ゲームを開けません</span><br>${esc(e.message)}`)}}
$('#searchForm').onsubmit=e=>{e.preventDefault();const q=$('#query').value.trim();if(q)searchGames(q)};$('#saveBtn').onclick=()=>saveStore($('#storeUrl').value.trim());$('#clearBtn').onclick=()=>selectedGame&&confirm(`${selectedGame.title} のSteamリンクを解除しますか？`)&&saveStore('');$('#cancelBtn').onclick=closeEditor;$('#authBtn').onclick=askAdmin;
(async()=>{try{const r=await fetch('/api/archive-status',{cache:'no-store'}),j=await r.json();if(j.ok)runtime=j}catch{}const p=new URLSearchParams(location.search),id=p.get('id'),url=p.get('url'),q=p.get('q');if(id)openById(id,url||'');else if(q){$('#query').value=q;searchGames(q)}})();
</script>
</body></html>