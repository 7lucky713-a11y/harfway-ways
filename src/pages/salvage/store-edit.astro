<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY GAME LINKS</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#11110f;color:#f5f2eb}*{box-sizing:border-box}body{margin:0;background:#11110f;color:#f5f2eb}header{display:flex;gap:10px;align-items:center;padding:16px 20px;background:#171715;border-bottom:1px solid #302f2a}.brand{font-size:11px;letter-spacing:.15em;color:#aaa59a;margin-right:auto}a{color:#d8d1c2;text-decoration:none}.btn{border:1px solid #48463f;background:#25241f;color:#fff;padding:9px 12px;border-radius:8px;cursor:pointer;font:inherit}.btn.primary{background:#f0ede5;color:#111;border-color:#f0ede5;font-weight:700}.btn.danger{border-color:#67443d;color:#f0b4a6}.btn:disabled{opacity:.45}main{max-width:1080px;margin:0 auto;padding:28px 20px 80px}.intro h1{font-size:30px;margin:0 0 8px}.intro p{color:#a8a399;line-height:1.7}.search{display:flex;gap:8px;margin:20px 0 16px}.search input,.newgame input,.link-row input,.link-row select{width:100%;border:1px solid #3c3a35;background:#181816;color:#f5f2eb;padding:11px 12px;border-radius:8px;font:inherit}.status{padding:11px 12px;border:1px solid #39372f;background:#20201c;border-radius:8px;color:#bbb5aa;font-size:12px;line-height:1.6;margin-bottom:16px}.ok{color:#c9f7be}.warn{color:#f4d99a}.results{display:grid;gap:10px}.card{border:1px solid #34322d;background:#181816;border-radius:10px;padding:14px}.card.new{border-color:#756444;background:#1d1a14}.title{font-size:16px;font-weight:700}.meta,.help,.current{font-size:11px;color:#8f8b82;line-height:1.6;margin-top:5px;overflow-wrap:anywhere}.resolved{display:inline-block;margin-top:8px;padding:4px 7px;border:1px solid #4b473f;border-radius:99px;font-size:10px;color:#c9b47f}.editor{display:none;margin-top:22px;border:1px solid #514b40;background:#191814;border-radius:12px;padding:18px}.editor.active{display:block}.edit-title{font-size:21px;font-weight:700}.label{display:block;font-size:10px;letter-spacing:.12em;color:#8b8880;text-transform:uppercase;margin:16px 0 7px}.link-list{display:grid;gap:8px;margin-top:10px}.link-row{display:grid;grid-template-columns:150px minmax(0,1fr) 72px 72px;gap:8px;align-items:center;padding:9px;border:1px solid #302f2a;border-radius:9px;background:#151513}.primary-choice{display:flex;align-items:center;justify-content:center;gap:4px;font-size:10px;color:#aaa59a}.primary-choice input{width:auto}.link-row .remove{padding:9px 7px}.edit-actions{display:flex;gap:8px;margin-top:14px;flex-wrap:wrap}.empty{padding:38px 12px;text-align:center;color:#77736b}.newgame{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:10px}.platforms{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}.platforms span{font-size:10px;border:1px solid #39372f;border-radius:99px;padding:4px 7px;color:#9f9a8f}@media(max-width:720px){header{flex-wrap:wrap}.brand{width:100%}.search,.newgame{grid-template-columns:1fr;display:grid}.link-row{grid-template-columns:1fr}.primary-choice{justify-content:flex-start}}
</style>
</head>
<body>
<header><div class="brand">HARF-WAY / GAME LINKS v1.0 PREVIEW</div><a class="btn" href="/salvage/">Salvagerへ戻る</a><button id="authBtn" class="btn" type="button">管理キー</button></header>
<main>
<section class="intro"><h1>作品リンクを管理</h1><p>ゲーム名・Steam URL・App ID・その他のストアURLで検索できます。Steam以外も同じ作品に複数登録でき、メインリンクを1本選べます。</p><div class="platforms"><span>Steam</span><span>Nintendo</span><span>PlayStation</span><span>Xbox</span><span>itch.io</span><span>DLsite</span><span>BOOTH</span><span>App Store</span><span>Google Play</span><span>Epic</span><span>GOG</span><span>unityroom</span><span>ノベコレ</span><span>ふりーむ！</span><span>公式サイト</span></div></section>
<form id="searchForm" class="search"><input id="query" placeholder="ゲーム名 / ストアURL / Steam App IDで検索" autocomplete="off"><button class="btn primary">検索</button></form>
<div id="status" class="status">ゲーム名または作品ページURLを入力してください。</div>
<div id="results" class="results"></div>
<section id="editor" class="editor"><div id="editTitle" class="edit-title"></div><div id="current" class="current"></div><div class="label">Game Links</div><div id="linkList" class="link-list"></div><div class="edit-actions"><button id="addLink" class="btn" type="button">＋ リンクを追加</button><button id="saveBtn" class="btn primary" type="button">作品リンクを保存</button><button id="cancelBtn" class="btn" type="button">閉じる</button></div><div class="help">「メイン」にしたURLは、既存機能との互換用メインストアURLとしても保存されます。</div></section>
</main>
<script>
const $=s=>document.querySelector(s),ADMIN_KEY='hw_salvager_admin_key';let selectedGame=null,runtime={authRequired:false},pendingUrl='';
const LABELS={steam:'Steam',nintendo:'Nintendo eShop',playstation:'PlayStation',xbox:'Xbox',itch:'itch.io',dlsite:'DLsite',booth:'BOOTH',google_play:'Google Play',app_store:'App Store',epic:'Epic Games Store',gog:'GOG',gamejolt:'Game Jolt',unityroom:'unityroom',novelgame:'ノベルゲームコレクション',freem:'ふりーむ！',official:'公式サイト',web:'その他'};
const SERVICES=Object.keys(LABELS);
const esc=v=>String(v||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const admin=()=>sessionStorage.getItem(ADMIN_KEY)||'';
function askAdmin(){const v=prompt('WAYSと同じ管理キーを入力してください',admin());if(v&&v.trim()){sessionStorage.setItem(ADMIN_KEY,v.trim());return true}return false}
async function authFetch(url,opt={},retry=true){const h={...(opt.headers||{})};if(admin())h['X-Admin-Key']=admin();const r=await fetch(url,{...opt,headers:h});if(r.status===401&&runtime.authRequired&&retry){sessionStorage.removeItem(ADMIN_KEY);if(askAdmin())return authFetch(url,opt,false)}return r}
function setStatus(v){$('#status').innerHTML=v}
function steamAppId(v=''){const s=String(v).trim();if(/^\d+$/.test(s))return s;try{return new URL(s).pathname.match(/\/app\/(\d+)/)?.[1]||''}catch{return ''}}
function serviceForUrl(v=''){try{const u=new URL(v),h=u.hostname.toLowerCase();if(h==='store.steampowered.com')return'steam';if(/nintendo\./.test(h))return'nintendo';if(h.endsWith('playstation.com'))return'playstation';if(h.endsWith('xbox.com')||h.endsWith('microsoft.com'))return'xbox';if(h.endsWith('.itch.io')||h==='itch.io')return'itch';if(h.endsWith('dlsite.com'))return'dlsite';if(h.endsWith('booth.pm'))return'booth';if(h==='play.google.com')return'google_play';if(h==='apps.apple.com')return'app_store';if(h.endsWith('epicgames.com'))return'epic';if(h.endsWith('gog.com'))return'gog';if(h.endsWith('gamejolt.com'))return'gamejolt';if(h.endsWith('unityroom.com'))return'unityroom';if(h.endsWith('novelgame.jp'))return'novelgame';if(h.endsWith('freem.ne.jp'))return'freem';return'web'}catch{return'web'}}
function isUrl(v=''){try{const u=new URL(v);return /^https?:$/.test(u.protocol)}catch{return false}}
async function coreSearch(q){const r=await fetch('/api/core/games?q='+encodeURIComponent(q)+'&limit=50&t='+Date.now(),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'search_failed');return j.games||[]}
async function getGame(id){const r=await fetch('/api/core/games?id='+encodeURIComponent(id)+'&t='+Date.now(),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.games?.[0])throw Error('game_not_found');return j.games[0]}
async function resolveSteam(q){const r=await fetch('/api/steam-resolve?url='+encodeURIComponent(q)+'&t='+Date.now(),{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'steam_lookup_failed');return j}
function refsForGame(g){const refs=(g.refs||[]).map(r=>({service:r.service,url:r.externalUrl||r.external_url||'',primary:!!r.metadata?.primary,name:r.metadata?.name||''})).filter(x=>x.url&&SERVICES.includes(x.service));if(g.storeUrl&&!refs.some(x=>x.url===g.storeUrl))refs.unshift({service:serviceForUrl(g.storeUrl),url:g.storeUrl,primary:true,name:''});if(refs.length&&!refs.some(x=>x.primary))refs[0].primary=true;return refs}
function options(selected='web'){return SERVICES.map(s=>`<option value="${s}" ${s===selected?'selected':''}>${esc(LABELS[s])}</option>`).join('')}
function addLinkRow(link={service:'web',url:'',primary:false}){const row=document.createElement('div');row.className='link-row';row.innerHTML=`<select class="link-service">${options(link.service||serviceForUrl(link.url))}</select><input class="link-url" type="url" value="${esc(link.url||'')}" placeholder="https://..."><label class="primary-choice"><input class="link-primary" type="radio" name="primaryLink" ${link.primary?'checked':''}>メイン</label><button class="btn danger remove" type="button">削除</button>`;row.querySelector('.remove').onclick=()=>row.remove();row.querySelector('.link-url').addEventListener('change',e=>{const s=serviceForUrl(e.target.value);if(s!=='web')row.querySelector('.link-service').value=s});$('#linkList').appendChild(row)}
function readLinks(){const rows=[...document.querySelectorAll('.link-row')];return rows.map(row=>({service:row.querySelector('.link-service').value,url:row.querySelector('.link-url').value.trim(),primary:row.querySelector('.link-primary').checked})).filter(x=>x.url)}
function renderGames(games,suggested=''){setStatus(`<span class="ok">● ${games.length}件見つかりました</span>`);$('#results').innerHTML=games.map((g,i)=>`<div class="card"><div class="title">${esc(g.title)}</div><div class="meta">ID: ${esc(g.id)}<br>メイン: ${esc(g.storeUrl||'未登録')}<br>登録リンク: ${(g.refs||[]).length}件</div>${suggested&&!refsForGame(g).some(x=>x.url===suggested)?`<div class="resolved">追加候補: ${esc(suggested)}</div>`:''}<br><button class="btn editGame" data-i="${i}">リンクを編集</button></div>`).join('')||'<div class="empty">一致するゲームがありません。</div>';document.querySelectorAll('.editGame').forEach(b=>b.onclick=()=>openEditor(games[+b.dataset.i],suggested?[suggested]:[]))}
function renderUnknownLink(url,steamMeta=null){pendingUrl=url;const service=serviceForUrl(url);const title=steamMeta?.name||'';setStatus(`<span class="warn">● Core DBには未登録です</span><br>${esc(LABELS[service]||'作品リンク')}を検出しました。`);$('#results').innerHTML=`<div class="card new"><div class="title">${esc(title||'新しいゲームとして登録')}</div><div class="meta">${esc(LABELS[service]||service)}<br>${esc(url)}</div><div class="resolved">DB未登録</div><div class="newgame"><input id="newGameTitle" value="${esc(title)}" placeholder="作品名を入力"><button id="registerGame" class="btn primary" type="button">ゲームDBへ登録</button></div></div>`;$('#registerGame').onclick=registerUnknown}
async function searchGames(q){setStatus('検索しています…');$('#results').innerHTML='';pendingUrl='';try{if(isUrl(q)){let games=await coreSearch(q);if(games.length)return renderGames(games,q);if(serviceForUrl(q)==='steam'){const meta=await resolveSteam(q);games=await coreSearch(meta.name);if(games.length)return renderGames(games,meta.storeUrl);return renderUnknownLink(meta.storeUrl,meta)}return renderUnknownLink(q)}const sid=steamAppId(q);if(sid){let games=await coreSearch(sid);if(games.length)return renderGames(games);const meta=await resolveSteam(`https://store.steampowered.com/app/${sid}/`);games=await coreSearch(meta.name);return games.length?renderGames(games,meta.storeUrl):renderUnknownLink(meta.storeUrl,meta)}renderGames(await coreSearch(q))}catch(e){setStatus(`<span class="warn">● 検索失敗</span><br>${esc(e.message)}`)}}
async function registerUnknown(){const title=$('#newGameTitle')?.value.trim(),b=$('#registerGame');if(!title||!pendingUrl){setStatus('<span class="warn">● 作品名を入力してください</span>');return}b.disabled=true;b.textContent='登録中…';try{const links=[{service:serviceForUrl(pendingUrl),url:pendingUrl,primary:true,source:'game-links-editor'}];const r=await authFetch('/api/archive-create-game',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title,links,primaryUrl:pendingUrl,articleUrl:''})}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'create_failed');const g={id:j.game.id,title:j.game.title,storeUrl:j.game.store_url||pendingUrl,refs:(j.links||links).map(x=>({service:x.service,externalUrl:x.url,metadata:{primary:!!x.primary}})),previewOnly:!!j.previewOnly};setStatus(j.simulated?`<span class="ok">● Preview仮登録OK</span><br>${esc(g.title)} / 本番DBには未反映です。`:`<span class="ok">● ゲームDBへ登録しました</span><br>${esc(g.title)}`);$('#results').innerHTML='';openEditor(g)}catch(e){b.disabled=false;b.textContent='ゲームDBへ登録';setStatus(`<span class="warn">● 登録できません</span><br>${esc(e.message)}`)}}
function openEditor(g,suggested=[]){selectedGame=g;$('#editTitle').textContent=g.title;$('#current').textContent=`ID: ${g.id}${g.previewOnly?' / Preview仮登録':''}`;$('#linkList').innerHTML='';const refs=refsForGame(g);for(const u of suggested){if(u&&!refs.some(x=>x.url===u))refs.push({service:serviceForUrl(u),url:u,primary:!refs.length})}if(!refs.length)addLinkRow({service:'web',url:'',primary:true});else refs.forEach(addLinkRow);$('#editor').classList.add('active');$('#editor').scrollIntoView({behavior:'smooth',block:'center'})}
function closeEditor(){selectedGame=null;$('#editor').classList.remove('active')}
async function saveLinks(){if(!selectedGame)return;const links=readLinks();if(links.length&&!links.some(x=>x.primary))links[0].primary=true;const primaryUrl=links.find(x=>x.primary)?.url||'';const b=$('#saveBtn');b.disabled=true;setStatus('保存しています…');try{const r=await authFetch('/api/archive-update-links',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({gameId:selectedGame.id,links,primaryUrl})}),j=await r.json();if(!r.ok||!j.ok)throw Error((j.message||j.error||'update_failed')+(j.existingGame?.title?' / 既存: '+j.existingGame.title:''));selectedGame={...selectedGame,storeUrl:j.game?.store_url||primaryUrl,refs:(j.links||links).map(x=>({service:x.service,externalUrl:x.external_url||x.url,metadata:x.metadata||{primary:!!x.primary}})),previewOnly:selectedGame.previewOnly||!!j.previewOnly};openEditor(selectedGame);setStatus(j.simulated?`<span class="ok">● Preview仮保存OK</span><br>${esc(selectedGame.title)} / 本番DBには未反映です。`:`<span class="ok">● 作品リンクを更新しました</span><br>${esc(selectedGame.title)} / ${links.length}件`)}catch(e){setStatus(`<span class="warn">● 更新できません</span><br>${esc(e.message)}`)}finally{b.disabled=false}}
async function openById(id,url=''){try{const g=await getGame(id);openEditor(g,url?[url]:[]);setStatus(`<span class="ok">● 対象ゲームを開きました</span><br>${esc(g.title)}`)}catch(e){setStatus(`<span class="warn">● ゲームを開けません</span><br>${esc(e.message)}`)}}
$('#searchForm').onsubmit=e=>{e.preventDefault();const q=$('#query').value.trim();if(q)searchGames(q)};$('#addLink').onclick=()=>addLinkRow({service:'web',url:'',primary:!document.querySelector('.link-primary:checked')});$('#saveBtn').onclick=saveLinks;$('#cancelBtn').onclick=closeEditor;$('#authBtn').onclick=askAdmin;
(async()=>{try{const r=await fetch('/api/archive-status',{cache:'no-store'}),j=await r.json();if(j.ok)runtime=j}catch{}const p=new URLSearchParams(location.search),id=p.get('id'),url=p.get('url'),q=p.get('q');if(id)openById(id,url||'');else if(q){$('#query').value=q;searchGames(q)}})();
</script>
</body></html>
