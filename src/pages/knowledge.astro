<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow">
<title>HARF-WAY Collective Knowledge</title>
<style>
:root{--bg:#090a0c;--panel:#111318;--panel2:#0c0e12;--line:#2a3038;--text:#f4f4ef;--muted:#8f98a5;--lime:#efff35;--green:#75ee9a;--red:#ff7777;--amber:#ffcc69;--blue:#77baff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Noto Sans JP",sans-serif}.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 20px;border-bottom:1px solid var(--line);background:rgba(9,10,12,.96);backdrop-filter:blur(14px)}.brand{font-weight:950;letter-spacing:.08em}.brand small{font-size:9px;color:var(--muted)}.back{border:1px solid #343b45;border-radius:9px;padding:9px 11px;background:#15181e;color:#fff;text-decoration:none;font-weight:900;font-size:11px}.wrap{max-width:1460px;margin:auto;padding:28px 22px 80px}.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:34px;align-items:end;margin-bottom:24px}.ey{color:var(--lime);font-size:10px;font-weight:950;letter-spacing:.15em}.hero h1{font-size:clamp(52px,8vw,104px);line-height:.82;letter-spacing:-.07em;margin:10px 0 0}.hero p{margin:0;color:var(--muted);line-height:1.75;max-width:650px}.statusline{margin-top:10px;font:10px/1.5 ui-monospace,monospace;color:var(--muted)}.statusline.ok{color:var(--green)}.statusline.bad{color:var(--red)}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:20px 0}.kpi{border:1px solid var(--line);border-radius:14px;background:var(--panel);padding:15px}.kpi small{display:block;color:var(--muted);font-size:9px;letter-spacing:.09em}.kpi b{display:block;font-size:30px;margin-top:7px}.protocol{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}.step{border:1px solid #4d571f;border-radius:12px;padding:14px;background:#12150b}.step strong{font-size:9px;color:var(--lime);letter-spacing:.12em}.step b{display:block;font-size:15px;margin-top:7px}.step span{display:block;color:#9ea58c;font-size:9px;line-height:1.55;margin-top:5px}.layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(330px,.55fr);gap:16px}.panel{border:1px solid var(--line);border-radius:16px;background:var(--panel);padding:16px}.panel h2{margin:0 0 13px;font-size:11px;letter-spacing:.11em}.filters{display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:7px;margin-bottom:12px}input,select,textarea{width:100%;border:1px solid #343b45;border-radius:9px;background:#0c0e12;color:#fff;padding:10px 11px;font:inherit;font-size:11px;outline:none}textarea{min-height:130px;resize:vertical}input:focus,select:focus,textarea:focus{border-color:var(--lime)}.entries{display:grid;gap:8px}.entry{border:1px solid #303640;background:var(--panel2);border-radius:13px;padding:14px}.entrytop{display:flex;gap:8px;align-items:flex-start;justify-content:space-between}.entry h3{font-size:14px;margin:0;line-height:1.45}.chips{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}.chip{font:800 8px/1 ui-monospace,monospace;padding:5px 6px;border:1px solid #3a424c;border-radius:999px;color:var(--muted)}.chip.verified{color:var(--green);border-color:#376749}.chip.known{color:var(--blue);border-color:#3c5771}.chip.verify{color:var(--amber);border-color:#68582f}.chip.deprecated{color:var(--red);border-color:#724040}.entry p{color:#aab0b8;font-size:10px;line-height:1.7;margin:11px 0 0;white-space:pre-wrap}.meta{margin-top:10px;font:8px/1.5 ui-monospace,monospace;color:#686f79}.form{display:grid;gap:8px}.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.btn{border:1px solid var(--lime);border-radius:9px;background:var(--lime);color:#08090a;padding:11px 13px;font-weight:950;font-size:10px;cursor:pointer}.btn:disabled{opacity:.45;cursor:not-allowed}.msg{border:1px solid #343b45;border-radius:10px;background:#0c0e12;padding:11px;color:var(--muted);font:9px/1.6 ui-monospace,monospace}.note{font-size:9px;line-height:1.6;color:var(--muted);margin-top:10px}.empty{padding:24px;text-align:center;color:var(--muted);font-size:10px;border:1px dashed #343b45;border-radius:12px}@media(max-width:900px){.hero,.layout{grid-template-columns:1fr}.kpis{grid-template-columns:repeat(3,1fr)}.protocol{grid-template-columns:1fr 1fr}.filters{grid-template-columns:1fr 1fr}}@media(max-width:560px){.wrap{padding:22px 13px 60px}.top{padding:12px 13px}.hero h1{font-size:56px}.kpis{grid-template-columns:1fr 1fr}.protocol,.filters,.row2{grid-template-columns:1fr}}
</style>
</head>
<body>
<header class="top"><div class="brand">HARF-WAY / COLLECTIVE KNOWLEDGE <small>Preview v0.1</small></div><a class="back" href="/control-center">← CONTROL CENTER</a></header>
<main class="wrap">
<section class="hero"><div><div class="ey">SHARED MEMORY FOR EVERY CHAT</div><h1>LEARN.<br>MERGE.</h1></div><div><p>各Chatで得た事実・判断・失敗・再利用パターンを、次のChatが使える知識へ変換する共有層です。会話ログをそのまま貯めず、確認度を付けて育てます。</p><div id="status" class="statusline">KNOWLEDGE APIを読み込み中…</div></div></section>
<section class="kpis"><div class="kpi"><small>TOTAL</small><b id="kTotal">—</b></div><div class="kpi"><small>VERIFIED</small><b id="kVerified">—</b></div><div class="kpi"><small>KNOWN</small><b id="kKnown">—</b></div><div class="kpi"><small>VERIFY</small><b id="kVerify">—</b></div><div class="kpi"><small>DEPRECATED</small><b id="kDeprecated">—</b></div></section>
<section class="protocol"><div class="step"><strong>01 READ</strong><b>共有知識を読む</b><span>Chat開始時に現在地とルールを取得。</span></div><div class="step"><strong>02 WORK</strong><b>実環境で確認する</b><span>GitHub / Production / DBを正本として照合。</span></div><div class="step"><strong>03 LEARN</strong><b>学びを抽出する</b><span>事実・判断・失敗・パターンだけを残す。</span></div><div class="step"><strong>04 PROMOTE</strong><b>知識を昇格する</b><span>VERIFY → KNOWN → VERIFIED。古い情報はDEPRECATED。</span></div></section>
<div class="layout">
<section class="panel"><h2>COLLECTIVE STATE</h2><div class="filters"><input id="search" placeholder="キーワード検索"><select id="project"><option value="ALL">ALL PROJECTS</option></select><select id="kind"><option value="ALL">ALL KINDS</option></select><select id="confidence"><option value="ALL">ALL CONFIDENCE</option><option>VERIFIED</option><option>KNOWN</option><option>VERIFY</option><option>DEPRECATED</option></select></div><div id="entries" class="entries"><div class="empty">読み込み中…</div></div></section>
<aside class="panel"><h2>LEARN / REGISTER</h2><div class="form"><input id="title" placeholder="知識のタイトル"><textarea id="body" placeholder="次のChatが再利用できる形で記述"></textarea><div class="row2"><input id="formProject" placeholder="PROJECT（例 WAYS）" value="GLOBAL"><select id="formKind"><option>FACT</option><option>DECISION</option><option>PATTERN</option><option>FAILURE</option><option>TODO</option><option>ARCHITECTURE</option><option>OPERATION</option></select></div><div class="row2"><select id="formConfidence"><option>VERIFY</option><option>KNOWN</option><option>VERIFIED</option><option>DEPRECATED</option></select><input id="tags" placeholder="tags, comma, separated"></div><button id="save" class="btn">SAVE TO KNOWLEDGE</button><div id="saveMsg" class="msg">PreviewではProduction DBへ書き込みません。Preview用DBが接続されている場合のみ保存できます。</div></div><p class="note">秘密値・APIキー・パスワード・トークンは集合知へ保存しません。内部の詳細な正本はprivate GitHub側に維持し、この画面には共有可能な知識だけを出します。</p></aside>
</div>
</main>
<script>
const $=s=>document.querySelector(s);let all=[];
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function confClass(v){return String(v||'').toLowerCase()}
function render(){const q=$('#search').value.trim().toLowerCase(),p=$('#project').value,k=$('#kind').value,c=$('#confidence').value;const items=all.filter(x=>(p==='ALL'||x.project===p)&&(k==='ALL'||x.kind===k)&&(c==='ALL'||x.confidence===c)&&(!q||[x.title,x.body,x.project,x.kind,x.confidence,...(x.tags||[])].join(' ').toLowerCase().includes(q)));$('#entries').innerHTML=items.length?items.map(x=>`<article class="entry"><div class="entrytop"><h3>${esc(x.title)}</h3><span class="chip ${confClass(x.confidence)}">${esc(x.confidence)}</span></div><div class="chips"><span class="chip">${esc(x.project)}</span><span class="chip">${esc(x.kind)}</span>${(x.tags||[]).map(t=>`<span class="chip">#${esc(t)}</span>`).join('')}</div><p>${esc(x.body)}</p><div class="meta">${esc(x.source||'')} / updated ${esc(x.updatedAt||'—')}</div></article>`).join(''):'<div class="empty">条件に合う知識がありません。</div>'}
function setOptions(id,values){const el=$(id),first=el.options[0].outerHTML;el.innerHTML=first+[...new Set(values)].sort().map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join('')}
async function load(){try{const r=await fetch('/api/knowledge',{cache:'no-store'}),j=await r.json();if(!r.ok||!j.ok)throw new Error(j.error||`HTTP ${r.status}`);all=j.items||[];const s=j.summary||{};$('#kTotal').textContent=s.total??all.length;$('#kVerified').textContent=s.verified??0;$('#kKnown').textContent=s.known??0;$('#kVerify').textContent=s.verify??0;$('#kDeprecated').textContent=s.deprecated??0;setOptions('#project',s.projects||all.map(x=>x.project));setOptions('#kind',s.kinds||all.map(x=>x.kind));$('#status').textContent=`${String(j.environment||'').toUpperCase()} / ${j.storage} / ${all.length} entries`;$('#status').className='statusline ok';render()}catch(e){$('#status').textContent='KNOWLEDGE API ERROR: '+e.message;$('#status').className='statusline bad';$('#entries').innerHTML='<div class="empty">読み込みに失敗しました。</div>'}}
['#search','#project','#kind','#confidence'].forEach(id=>$(id).addEventListener(id==='#search'?'input':'change',render));
$('#save').onclick=async()=>{const btn=$('#save'),msg=$('#saveMsg');const payload={title:$('#title').value.trim(),body:$('#body').value.trim(),project:$('#formProject').value.trim()||'GLOBAL',kind:$('#formKind').value,confidence:$('#formConfidence').value,tags:$('#tags').value.split(',').map(x=>x.trim()).filter(Boolean)};if(!payload.title||!payload.body){msg.textContent='タイトルと本文を入力してください。';return}btn.disabled=true;msg.textContent='保存中…';try{const r=await fetch('/api/knowledge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)}),j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||`HTTP ${r.status}`);msg.textContent=`保存しました: ${j.item?.title||payload.title}`;$('#title').value='';$('#body').value='';$('#tags').value='';await load()}catch(e){msg.textContent=e.message==='preview_database_not_configured'?'Preview用DBが未接続です。API/UIの確認は可能ですが、Productionへは書き込みません。':'保存失敗: '+e.message}finally{btn.disabled=false}};
load();
</script>
</body>
</html>
