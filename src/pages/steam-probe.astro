---
export const prerender = true;
import { getSteamPrices, steamAppIdFromUrl } from '../../api/_steam-sale-core.js';

const editorUrl = process.env.WAYS_EDITOR_URL || 'https://harfway-playback-editor.vercel.app';
const key = String(process.env.WAYS_EDITOR_ADMIN_KEY || '').trim();
console.log(`[steam-build-probe] editor_key_present=${Boolean(key)}`);

if (key) {
  try {
    const r = await fetch(`${editorUrl}/api/proxy?target=state`, {
      headers:{accept:'application/json','x-showcase-admin-key':key},
      cache:'no-store'
    });
    const j = await r.json().catch(()=>({}));
    const games = Array.isArray(j?.state?.games) ? j.state.games : [];
    const appids = [...new Set(games.filter(g=>g?.status==='published').map(g=>steamAppIdFromUrl(g?.storeUrl||g?.store_url)).filter(Boolean))].slice(0,8);
    const prices = await getSteamPrices(appids, true);
    const ok = appids.filter(id=>prices.get(id)?.ok).length;
    const errors = appids.map(id=>prices.get(id)).filter(x=>x?.ok===false).map(x=>`${x.appid}:${x.error}`);
    console.log(`[steam-build-probe] editor_status=${r.status} games=${games.length} sample_appids=${appids.length} price_ok=${ok} errors=${errors.join(',')}`);
  } catch (e) {
    console.log(`[steam-build-probe] public_path_error=${e?.message || e}`);
  }
}
---
<!doctype html><html><body>probe</body></html>
