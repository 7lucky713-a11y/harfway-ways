<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="referrer" content="same-origin" />
  <title>PRIVATE CLIPS</title>
  <style>
    *{box-sizing:border-box}:root{--bg:#101310;--panel:#171c18;--panel2:#1c221d;--line:#303830;--ink:#edf1eb;--muted:#929d94;--accent:#dfe98f;--danger:#e5a0a0}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",Meiryo,sans-serif}button,input,textarea{font:inherit;color:inherit}button{cursor:pointer}.app{min-height:100vh;display:grid;grid-template-columns:220px minmax(0,1fr)}aside{position:sticky;top:0;height:100vh;padding:18px 14px;background:#151916;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:7px}.brand{display:flex;align-items:center;gap:10px;margin-bottom:20px}.brand>b{width:42px;height:42px;border-radius:10px;background:var(--accent);color:#11150f;display:grid;place-items:center;font-weight:950}.brand span{font-size:12px;font-weight:900}.brand small{display:block;margin-top:2px;color:#7f8b82;font:700 7px ui-monospace,SFMono-Regular,Menlo,monospace}.nav{border:0;background:transparent;text-align:left;padding:10px;border-radius:8px;color:var(--muted);font-size:10px;font-weight:850}.nav.on,.nav:hover{background:#232a24;color:#fff}.nav em{float:right;color:var(--accent);font-style:normal}.rule{margin-top:auto;border-left:3px solid var(--accent);background:var(--panel2);padding:10px;color:#9ba59d;font-size:9px;line-height:1.65}main{min-width:0}.top{height:82px;position:sticky;top:0;z-index:5;background:#101310eb;backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding:0 30px;display:flex;align-items:center;justify-content:space-between}.top small,.eyebrow{color:var(--accent);font:900 8px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em}.top h1{font-size:22px;margin:4px 0 0}.ghost,.primary,.danger{border-radius:8px;padding:10px 12px;font-size:10px;font-weight:900}.ghost{border:1px solid #39433b;background:var(--panel)}.primary{border:0;background:var(--accent);color:#11150f}.danger{border:1px solid #704a4a;background:transparent;color:var(--danger)}.view{display:none;padding:34px 36px 70px}.view.show{display:block}.lead{max-width:760px;margin-bottom:14px;color:#98a29a;font-size:11px;line-height:1.65}.capture{max-width:820px;border:1px solid var(--line);background:var(--panel);border-radius:15px;padding:16px;display:grid;gap:10px}.capture input[type=text],.capture textarea,.search{width:100%;border:1px solid var(--line);background:#111512;border-radius:9px;outline:0}.capture input[type=text]{padding:12px;font-size:15px;font-weight:800}.capture textarea{min-height:145px;padding:12px;resize:vertical;font-size:14px;line-height:1.7}.row{display:flex;gap:8px;align-items:center}.tag-input{display:flex;gap:8px;flex:1}.tag-input input{flex:1}.tag-add{border:1px solid var(--line);background:#242b25;border-radius:8px;padding:0 12px;font-size:9px;font-weight:900}.tokens{display:flex;gap:6px;flex-wrap:wrap}.token,.tag{border:1px solid #465246;background:#202721;border-radius:999px;padding:6px 8px;font-size:9px}.token button{border:0;background:transparent;color:#b5c0b6;margin-left:5px;padding:0}.file{border:1px solid var(--line);background:#242b25;border-radius:8px;padding:10px 12px;font-size:9px;font-weight:850}.file input{display:none}.image-preview{display:flex;gap:10px;align-items:center;color:#8e9990;font-size:9px}.image-preview img{width:110px;height:76px;object-fit:cover;border-radius:9px;border:1px solid var(--line)}.actions{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:4px}.actions-right{display:flex;gap:8px}.hint{color:#78837a;font-size:9px}.section{max-width:920px;margin-top:30px}.section-head,.library-head{display:flex;align-items:end;justify-content:space-between;gap:15px}.section-head h2{font-size:13px;margin:0 0 8px}.library-head h2,.dig h2{font-size:30px;margin:6px 0}.search{width:300px;padding:10px}.list{margin-top:12px}.clip{border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:14px;margin-bottom:9px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px}.clip h3{font-size:15px;margin:0 0 7px}.clip p{font-size:11px;line-height:1.7;color:#cbd2cc;white-space:pre-wrap;margin:0 0 10px}.clip-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.clip time{font:800 8px ui-monospace,SFMono-Regular,Menlo,monospace;color:#748078}.clip-thumb{width:110px;height:78px;border:1px solid var(--line);border-radius:9px;background:#111512;display:grid;place-items:center;overflow:hidden;color:#667168;font-size:8px}.clip-thumb img{width:100%;height:100%;object-fit:cover}.clip-tools{display:flex;gap:6px;margin-top:10px}.mini{border:1px solid var(--line);background:#222923;border-radius:7px;padding:7px 9px;font-size:8px;font-weight:850}.tag{color:#d7dfd7}.tag:hover{border-color:#6a7a69;color:#fff}.dig{max-width:720px}.dig>p{font-size:11px;color:#8f9991}.random-card{border:1px solid #3c463d;background:var(--panel);border-radius:15px;padding:22px;margin:18px 0 12px}.random-card h3{font-size:22px;margin:8px 0}.random-card p{font-size:14px;line-height:1.8;white-space:pre-wrap}.empty{border:1px dashed var(--line);border-radius:11px;padding:28px;text-align:center;color:#77827a;font-size:10px}.lock{position:fixed;inset:0;background:#0d100ee8;display:none;place-items:center;z-index:20}.lock.on{display:grid}.lock-card{width:min(420px,calc(100vw - 30px));border:1px solid var(--line);background:#161a17;border-radius:15px;padding:22px}.lock-card h2{margin:5px 0 8px}.lock-card p{color:#98a29a;font-size:10px;line-height:1.6}.lock-card form{display:flex;gap:8px}.lock-card input{flex:1;background:#0f1310;border:1px solid var(--line);border-radius:8px;padding:10px}.toast{position:fixed;right:18px;bottom:18px;background:var(--accent);color:#11150f;padding:10px 12px;border-radius:8px;font-size:10px;font-weight:900;opacity:0;transform:translateY(5px);transition:.18s;z-index:30}.toast.on{opacity:1;transform:none}.toast.bad{background:#e5a0a0}.hidden{display:none!important}@media(max-width:760px){.app{display:block}aside{height:auto;position:static;display:grid;grid-template-columns:repeat(3,1fr)}.brand,.rule{display:none}.nav{text-align:center}.top{height:auto;padding:14px}.top .ghost{display:none}.view{padding:22px 14px 55px}.section-head,.library-head{display:block}.search{width:100%;margin-top:12px}.clip{grid-template-columns:1fr}.clip-thumb{width:100%;height:180px}.row{align-items:stretch;flex-direction:column}.tag-input{width:100%}.actions{align-items:flex-start;flex-direction:column}.actions-right{width:100%}.actions-right button{flex:1}}
  </style>
</head>
<body>
  <div class="app"><aside><div class="brand"><b>CL</b><span>PRIVATE CLIPS<small>ROUGH KNOWLEDGE POCKET</small></span></div><button class="nav on" data-view="capture">＋ 入れる</button><button class="nav" data-view="library">CLIPS <em id="count">0</em></button><button class="nav" data-view="dig">掘り返す</button><div class="rule">整えすぎない。タイトルを付けて、必要ならタグと画像。あとで探せれば十分。</div></aside><main><header class="top"><div><small id="eyebrow">CAPTURE</small><h1 id="title">いま何を残す？</h1></div><button class="ghost" id="top-random">↻ 1件掘り返す</button></header><section class="view show" id="capture"><p class="lead">タイトルだけでも保存OK。本文・タグ・画像は必要なときだけ足す。</p><div class="capture"><input id="clip-id" type="hidden" /><input id="created-at" type="hidden" /><input id="clip-title" type="text" maxlength="280" placeholder="タイトル" /><textarea id="clip-body" maxlength="30000" placeholder="一言メモ、気づき、覚えておきたいこと。空でもOK。"></textarea><div class="row"><div class="tag-input"><input id="tag-input" type="text" maxlength="80" placeholder="タグを1件ずつ追加" /><button class="tag-add" id="tag-add" type="button">追加</button></div><label class="file">＋ 画像<input id="image-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /></label></div><div class="tokens" id="tokens"></div><div class="image-preview hidden" id="image-preview"></div><div class="actions"><span class="hint">URL・分類・理解度・学習ステータスはなし</span><div class="actions-right"><button class="ghost hidden" id="cancel-edit" type="button">編集をやめる</button><button class="primary" id="save" type="button">保存</button></div></div></div><div class="section"><div class="section-head"><h2>最近入れたもの</h2><button class="mini" data-go="library">全部見る →</button></div><div class="list" id="recent"></div></div></section><section class="view" id="library"><div class="library-head"><div><small class="eyebrow">EVERYTHING YOU DROPPED</small><h2>CLIPS</h2></div><input class="search" id="search" placeholder="タイトル・本文・タグから検索" /></div><div class="list" id="library-list"></div></section><section class="view" id="dig"><div class="dig"><small class="eyebrow">REDISCOVER</small><h2>今日の掘り返し</h2><p>忘れていた断片を1件だけ出す。</p><article class="random-card" id="random"></article><button class="primary" id="shuffle">↻ もう1件</button></div></section></main></div><div class="lock" id="lock"><div class="lock-card"><small class="eyebrow">PRIVATE WORKSPACE</small><h2>UNLOCK</h2><p>本文と画像はHARF-WAY管理キーで保護されています。</p><form id="unlock"><input id="key" type="password" autocomplete="current-password" placeholder="HARF-WAY 管理キー" /><button class="primary">開く</button></form></div></div><div class="toast" id="toast"></div>
  <script is:inline>
  (()=>{const state={clips:[],tags:[],newFile:null,newFileUrl:'',existingImage:null,imageRemoved:false,objectUrls:new Map(),view:'capture'};const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const fmt=v=>{try{return new Intl.DateTimeFormat('ja-JP',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(v)).replace('/','.')}catch{return''}};const key=()=>sessionStorage.getItem('harfway_private_clips_key')||sessionStorage.getItem('harfway_game_notes_key')||'';const headers=(json=false)=>({...key()?{'x-admin-key':key()}:{},...(json?{'content-type':'application/json'}:{})});function toast(message,bad=false){const t=$('#toast');t.textContent=message;t.classList.toggle('bad',bad);t.classList.add('on');clearTimeout(t._x);t._x=setTimeout(()=>t.classList.remove('on'),1600)}async function api(options={}){const r=await fetch('/api/private-clips',{...options,headers:{...headers(Boolean(options.body)),...(options.headers||{})},cache:'no-store'});const d=await r.json().catch(()=>({}));if(r.status===401){$('#lock').classList.add('on');throw Object.assign(new Error(d.error||'unauthorized'),{status:401})}if(!r.ok)throw new Error(d.error||`http_${r.status}`);return d}async function mediaApi(url,options={}){const r=await fetch(url,{...options,headers:{...headers(Boolean(options.body)&&!(options.body instanceof Blob)),...(options.headers||{})},cache:'no-store'});const d=options.raw?null:await r.json().catch(()=>({}));if(r.status===401){$('#lock').classList.add('on');throw Object.assign(new Error(d?.error||'unauthorized'),{status:401})}if(!r.ok)throw new Error(d?.error||`http_${r.status}`);return options.raw?r:d}function tagsHtml(tags=[]){return tags.map(t=>`<button class="tag" data-tag="${esc(t)}">#${esc(t)}</button>`).join('')}function imageShell(c){return c.image?.key?`<div class="clip-thumb" data-image-key="${esc(c.image.key)}">IMAGE</div>`:''}function card(c){return `<article class="clip" data-id="${esc(c.id)}"><div><h3>${esc(c.title)}</h3>${c.body?`<p>${esc(c.body)}</p>`:''}<div class="clip-meta"><time>${esc(fmt(c.updatedAt||c.createdAt))}</time>${tagsHtml(c.tags)}</div><div class="clip-tools"><button class="mini" data-edit="${esc(c.id)}">編集</button><button class="mini" data-delete="${esc(c.id)}">しまう</button></div></div>${imageShell(c)}</article>`}async function loadImage(el){const k=el.dataset.imageKey;if(!k||state.objectUrls.has(k)){if(k&&state.objectUrls.has(k))el.innerHTML=`<img alt="" src="${state.objectUrls.get(k)}">`;return}try{const r=await mediaApi(`/api/private-clips-media?action=file&key=${encodeURIComponent(k)}`,{raw:true});const u=URL.createObjectURL(await r.blob());state.objectUrls.set(k,u);el.innerHTML=`<img alt="" src="${u}">`}catch{el.textContent='IMAGE'}}function hydrateImages(root=document){root.querySelectorAll('[data-image-key]').forEach(loadImage)}function filtered(){const q=$('#search').value.trim().toLocaleLowerCase('ja');if(!q)return state.clips;return state.clips.filter(c=>[c.title,c.body,...(c.tags||[])].join(' ').toLocaleLowerCase('ja').includes(q))}function renderRecent(){const a=state.clips.slice(0,6);$('#recent').innerHTML=a.length?a.map(card).join(''):'<div class="empty">まだCLIPはありません。</div>';hydrateImages($('#recent'));$('#count').textContent=state.clips.length}function renderLibrary(){const a=filtered();$('#library-list').innerHTML=a.length?a.map(card).join(''):'<div class="empty">見つかりません。</div>';hydrateImages($('#library-list'))}function renderTokens(){$('#tokens').innerHTML=state.tags.map((t,i)=>`<span class="token">#${esc(t)}<button data-remove-tag="${i}" type="button">×</button></span>`).join('')}function addTag(){const input=$('#tag-input'),v=input.value.trim();if(!v)return;const exists=state.tags.some(x=>x.toLocaleLowerCase('ja')===v.toLocaleLowerCase('ja'));if(!exists&&state.tags.length<24)state.tags.push(v.slice(0,80));input.value='';renderTokens()}function renderImagePreview(){const root=$('#image-preview');if(state.newFile&&state.newFileUrl){root.classList.remove('hidden');root.innerHTML=`<img src="${state.newFileUrl}" alt=""><span>${esc(state.newFile.name)}<br><button class="mini" type="button" id="remove-image">画像を外す</button></span>`;$('#remove-image').onclick=removeImage;return}if(state.existingImage&&!state.imageRemoved){root.classList.remove('hidden');root.innerHTML=`<div class="clip-thumb" data-image-key="${esc(state.existingImage.key)}">IMAGE</div><span>${esc(state.existingImage.name||'保存済み画像')}<br><button class="mini" type="button" id="remove-image">画像を外す</button></span>`;$('#remove-image').onclick=removeImage;hydrateImages(root);return}root.classList.add('hidden');root.innerHTML=''}function removeImage(){if(state.newFileUrl)URL.revokeObjectURL(state.newFileUrl);state.newFile=null;state.newFileUrl='';$('#image-file').value='';if(state.existingImage)state.imageRemoved=true;renderImagePreview()}function resetForm(){if(state.newFileUrl)URL.revokeObjectURL(state.newFileUrl);state.tags=[];state.newFile=null;state.newFileUrl='';state.existingImage=null;state.imageRemoved=false;$('#clip-id').value='';$('#created-at').value='';$('#clip-title').value='';$('#clip-body').value='';$('#tag-input').value='';$('#image-file').value='';$('#cancel-edit').classList.add('hidden');$('#save').textContent='保存';renderTokens();renderImagePreview()}function editClip(id){const c=state.clips.find(x=>x.id===id);if(!c)return;state.tags=[...(c.tags||[])];state.existingImage=c.image||null;state.imageRemoved=false;$('#clip-id').value=c.id;$('#created-at').value=c.createdAt||'';$('#clip-title').value=c.title||'';$('#clip-body').value=c.body||'';$('#cancel-edit').classList.remove('hidden');$('#save').textContent='更新';renderTokens();renderImagePreview();show('capture');$('#clip-title').focus()}async function uploadImage(file){if(!file)return null;if(file.size>8*1024*1024)throw new Error('image_too_large');const start=await mediaApi('/api/private-clips-media?action=start',{method:'POST',body:JSON.stringify({fileName:file.name,contentType:file.type,size:file.size})});const chunk=start.chunkBytes||2500000,parts=Math.ceil(file.size/chunk);for(let i=0;i<parts;i++){const piece=file.slice(i*chunk,Math.min(file.size,(i+1)*chunk));await mediaApi('/api/private-clips-media',{method:'PUT',body:piece,headers:{'x-upload-id':start.uploadId,'x-part-number':String(i+1),'x-content-type':file.type,'x-file-size':String(file.size)}})}const done=await mediaApi('/api/private-clips-media?action=complete',{method:'POST',body:JSON.stringify({uploadId:start.uploadId,fileName:file.name,contentType:file.type,size:file.size,parts})});return done.media}async function deleteImage(image){if(!image?.key)return;await mediaApi('/api/private-clips-media',{method:'DELETE',body:JSON.stringify({key:image.key})}).catch(()=>undefined);const u=state.objectUrls.get(image.key);if(u){URL.revokeObjectURL(u);state.objectUrls.delete(image.key)}}async function save(){const title=$('#clip-title').value.trim();if(!title)return toast('タイトルを入れてください',true);const id=$('#clip-id').value;const old=state.clips.find(x=>x.id===id);let uploaded=null;$('#save').disabled=true;try{if(state.newFile)uploaded=await uploadImage(state.newFile);const image=uploaded||(state.imageRemoved?null:state.existingImage);await api({method:id?'PATCH':'POST',body:JSON.stringify({id:id||undefined,title,body:$('#clip-body').value.trim(),tags:state.tags,image,createdAt:$('#created-at').value||undefined})});if(old?.image?.key&&(uploaded||state.imageRemoved)&&old.image.key!==image?.key)await deleteImage(old.image);await load(false);resetForm();toast(id?'更新しました':'保存しました')}catch(e){if(uploaded)await deleteImage(uploaded);if(e.status!==401)toast(`保存失敗: ${e.message}`,true)}finally{$('#save').disabled=false}}async function archiveClip(id){const c=state.clips.find(x=>x.id===id);if(!c||!confirm(`「${c.title}」をしまいますか？`))return;try{await api({method:'DELETE',body:JSON.stringify({id})});if(c.image)await deleteImage(c.image);await load(false);toast('しまいました')}catch(e){if(e.status!==401)toast(`削除失敗: ${e.message}`,true)}}function random(){const c=state.clips[Math.floor(Math.random()*state.clips.length)];const root=$('#random');if(!c){root.innerHTML='<div class="empty">まだCLIPはありません。</div>';return}root.innerHTML=`<time>${esc(fmt(c.updatedAt||c.createdAt))}</time><h3>${esc(c.title)}</h3>${c.body?`<p>${esc(c.body)}</p>`:''}<div class="clip-meta">${tagsHtml(c.tags)}</div>${c.image?.key?`<div class="clip-thumb" style="width:100%;height:260px;margin-top:16px" data-image-key="${esc(c.image.key)}">IMAGE</div>`:''}`;hydrateImages(root)}function show(v){state.view=v;$$('.view').forEach(x=>x.classList.toggle('show',x.id===v));$$('.nav').forEach(x=>x.classList.toggle('on',x.dataset.view===v));const m={capture:['CAPTURE','いま何を残す？'],library:['LIBRARY','溜めたものを見る'],dig:['REDISCOVER','忘れていたものを拾う']}[v];$('#eyebrow').textContent=m[0];$('#title').textContent=m[1];if(v==='library')renderLibrary();if(v==='dig')random()}async function load(select=true){const d=await api();state.clips=d.clips||[];$('#lock').classList.remove('on');renderRecent();renderLibrary();if(select&&state.view==='dig')random()}$$('.nav').forEach(b=>b.onclick=()=>show(b.dataset.view));$$('[data-go]').forEach(b=>b.onclick=()=>show(b.dataset.go));$('#top-random').onclick=()=>{show('dig');random()};$('#shuffle').onclick=random;$('#search').oninput=renderLibrary;$('#tag-add').onclick=addTag;$('#tag-input').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();addTag()}});$('#tokens').onclick=e=>{const b=e.target.closest('[data-remove-tag]');if(!b)return;state.tags.splice(Number(b.dataset.removeTag),1);renderTokens()};$('#image-file').onchange=e=>{const f=e.target.files?.[0];if(!f)return;if(!/^image\/(jpeg|png|webp|gif)$/.test(f.type))return toast('対応画像を選んでください',true);if(f.size>8*1024*1024)return toast('画像は8MBまでです',true);if(state.newFileUrl)URL.revokeObjectURL(state.newFileUrl);state.newFile=f;state.newFileUrl=URL.createObjectURL(f);renderImagePreview()};$('#save').onclick=save;$('#cancel-edit').onclick=resetForm;document.body.addEventListener('click',e=>{const edit=e.target.closest('[data-edit]');if(edit)return editClip(edit.dataset.edit);const del=e.target.closest('[data-delete]');if(del)return archiveClip(del.dataset.delete);const tag=e.target.closest('[data-tag]');if(tag){$('#search').value=tag.dataset.tag;show('library');renderLibrary()}});$('#unlock').addEventListener('submit',e=>{e.preventDefault();const v=$('#key').value.trim();if(!v)return;sessionStorage.setItem('harfway_private_clips_key',v);load().then(()=>{$('#key').value=''}).catch(()=>{})});renderTokens();renderImagePreview();load().catch(e=>{if(e.status!==401)toast(`読み込み失敗: ${e.message}`,true)});})();
  </script>
</body>
</html>
