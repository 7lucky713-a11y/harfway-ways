{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ads-portal",
      "destination": "/api/ads-portal-proxy?path=/"
    },
    {
      "source": "/ads-portal/",
      "destination": "/api/ads-portal-proxy?path=/"
    },
    {
      "source": "/_next/static/:path*",
      "destination": "/api/ads-portal-proxy?path=/_next/static/:path*"
    },
    {
      "source": "/api/neon-auth-proxy/:path*",
      "destination": "/api/neon-auth-proxy?path=:path*"
    }
  ]
}
