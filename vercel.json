{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/share/:id",
      "destination": "/api/ways-share?id=:id&mode=share"
    },
    {
      "source": "/embed/:id",
      "destination": "/api/ways-share?id=:id&mode=embed"
    },
    {
      "source": "/x-player/:id",
      "destination": "/api/ways-share?id=:id&mode=xplayer"
    },
    {
      "source": "/ads-portal",
      "destination": "/api/ads-portal-proxy?path=/"
    },
    {
      "source": "/ads-portal/",
      "destination": "/api/ads-portal-proxy?path=/"
    },
    {
      "source": "/_next/static/:path*",
      "destination": "/api/ads-portal-proxy?path=/_next/static/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-harfway-cron",
      "schedule": "0 0,12 * * 1"
    },
    {
      "path": "/api/ways-core-sync",
      "schedule": "*/15 * * * *"
    }
  ]
}
